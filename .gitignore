# Derlenmiş program dosyaları (go build / tr derle çıktıları); yorumlayıcı bin/ altına derlenir
bin/
*.exe
*.exe~
*.test
*.out

# Örnek programların çalışırken ürettiği dosyalar
examples/agirliklar.trt
examples/xor_agirliklari.trt
# Koşu klasörleri (eğitimin ayarları, günlüğü, ağırlıkları ve kontrol noktaları; examples/10)
runs/

# Kullanıcının verisi, ağırlıkları, parçalayıcısı ve gizli değerleri depoya girmez
*.trt
*.npy
tokenizer*.json
.env
.env.*
*.pem
