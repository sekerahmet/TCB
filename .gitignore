# Derlenmiş program dosyaları (go build / tr derle çıktıları); yorumlayıcı bin/ altına derlenir
bin/
*.exe
# Linux ve macOS'ta kökte `go build ./cmd/tr` uzantısız `tr` yazar (2026-10-29: bir dal 16 MB'lık ikiliyi commit'ledi)
/tr
*.exe~
*.test
*.out
# Python'un derlenmiş önbelleği (tools/gpu, tools/bench/py)
__pycache__/

# Koşu klasörleri (eğitimin ayarları, günlüğü, ağırlıkları ve kontrol noktaları; examples/tr/40_kontrol_noktasi.tr)
runs/

# Kullanıcının verisi, ağırlıkları, parçalayıcısı ve gizli değerleri depoya girmez
*.trt
*.npy
tokenizer*.json
.env
.env.*
*.pem
# ... bilerek depoda tutulan test fikstürleri dışında
!tests/data/**
!**/testdata/**

# Kişisel deneme klasörü (examples/tr/01_merhaba.tr buraya kopyalanıp değiştirilir)
scratch/

# Go araç çıktıları
coverage.*
*.prof

# Editör / işletim sistemi
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Claude oturum kopyaları (git worktree) ve yerel ayarlar; proje kancaları (settings.json) izlenir
.claude/*
!.claude/settings.json
/.codegraph/
.tr-dizin/
