{
  // TR dosyalarını VS Code içinden çalıştırmak için görevler.
  // Ctrl+Shift+B  → açık .tr dosyasını çalıştırır (varsayılan görev)
  // Ctrl+Shift+P → "Tasks: Run Task" → diğer görevler (derle, denetle, hata ayıkla)
  // Çalıştırma görevleri yorumlayıcıyı DERLEMEZ, bin/tr.exe'yi olduğu gibi kullanır. Go
  // kodunu değiştirdiyseniz önce "TR: yorumlayıcıyı derle" görevini elle çalıştırın. Otomatik
  // derleme bilerek yoktur: bin/tr.exe başka bir yerde açıkken (ör. süren bir hata ayıklama
  // oturumu) Windows dosyayı kilitler ve derleme her çalıştırmada başarısız olurdu.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TR: yorumlayıcıyı derle",
      "type": "process",
      "command": "go",
      "args": ["build", "-o", "bin/tr.exe", "./cmd/tr"],
      "options": {
        "cwd": "${workspaceFolder}",
        // 2020 sonrası x86-64 işlemciler (AVX2/FMA); eski işlemcilerde "v1" yazın.
        "env": { "GOAMD64": "v3" }
      },
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "TR: Bu dosyayı çalıştır",
      "type": "process",
      "command": "${workspaceFolder}/bin/tr.exe",
      "args": ["${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": []
    },
    {
      "label": "TR: Bu dosyayı denetle (çalıştırmadan)",
      "type": "process",
      "command": "${workspaceFolder}/bin/tr.exe",
      "args": ["kontrol", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "TR: Hata ayıklayıcıda aç (terminal)",
      "type": "process",
      "command": "${workspaceFolder}/bin/tr.exe",
      "args": ["hata_ayıkla", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": true },
      "problemMatcher": []
    }
  ]
}
