# TR 4
# 17 — Testler: kodun yanına test yazmak.
# Ne öğretir: `test "ad" { ... }` blokları, doğrula(koşul, [mesaj]) ve eşit_olmalı(beklenen, gerçek)
# ile denetim, hatanın fırlatıldığını sınamak.
# Önceki örnekten: fonksiyonlar, yapılar, listeler, hata yönetimi (08–15).
# Dosya adı *_test.tr ile biter: `tr test` bir klasörde yalnızca bu adlı dosyaları bulur.
# Çalıştırma (proje kökünden):
#   tr test examples/tr/17_testler_test.tr   → testleri çalıştırır, özet yazar
#   tr examples/tr/17_testler_test.tr        → dosyayı normal çalıştırır; test blokları atlanır
# Bir test kalırsa `tr test` 1 ile çıkar; CI'da kapı olarak kullanılabilir.

# --- Sınanacak kod ---
TR_func topla(a: TR_Int, b: TR_Int) -> TR_Int {
    TR_return a + b
}

TR_func ortalama_al(liste: TR_List[TR_Int]) -> TR_Float {
    TR_if liste.TR_length == 0 { TR_throw "boş listenin ortalaması alınamaz" }
    TR_return TR_sum(liste) / liste.TR_length
}

TR_struct Sepet {
    ürünler = []

    TR_func ekle(ad: TR_String, fiyat: TR_Int) {
        TR_self.ürünler.TR_append({"ad": ad, "fiyat": fiyat})
    }

    TR_func tutar() -> TR_Int {
        TR_return TR_sum(TR_self.ürünler.TR_map((x) => x["fiyat"]))
    }
}

# Bu satır her iki kipte de çalışır: testlerden önce dosyanın kendisi çalışır.
TR_print("Test blokları yalnızca şu komutla çalışır: tr test examples/tr/17_testler_test.tr")

# --- Testler ---
TR_test "toplama" {
    TR_assert_equal(4, topla(2, 2))
    TR_assert_equal(0, topla(-1, 1))
}

TR_test "ortalama" {
    TR_assert_equal(2.5, ortalama_al([1, 2, 3, 4]))
    TR_assert(ortalama_al([10]) == 10, "tek elemanın ortalaması kendisidir")
}

TR_test "boş listede hata fırlatılır" {
    TR_var mesaj = ""
    TR_try { ortalama_al([]) } TR_catch h { mesaj = h }
    TR_assert(mesaj.TR_contains("boş liste"), "beklenen hata gelmedi: \(mesaj)")
}

TR_test "sepet tutarı" {
    TR_var s = Sepet() # her test yeni bir kapsamda çalışır
    s.ekle("kalem", 15)
    s.ekle("defter", 40)
    TR_assert_equal(2, s.ürünler.TR_length)
    TR_assert_equal(55, s.tutar())
}

# --- Kendin dene ---
# 1. topla için negatif sayıları sınayan bir test daha ekle.
# 2. Bir testi bilerek yanlış yaz (eşit_olmalı(5, topla(2, 2))) ve `tr test` çıktısında nasıl kaldığını gör.
