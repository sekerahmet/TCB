//! tr kodlu 3 dil=tr
// 17 — Testler: kodun yanına test yazmak.
// Ne öğretir: `test "ad" { ... }` blokları, doğrula(koşul, [mesaj]) ve eşit_mi(beklenen, gerçek)
// ile denetim, hatanın fırlatıldığını sınamak.
// Önceki örnekten: fonksiyonlar, yapılar, listeler, hata yönetimi (08–15).
// Dosya adı *_test.tr ile biter: `tr test` bir klasörde yalnızca bu adlı dosyaları bulur.
// Çalıştırma (proje kökünden):
//   tr test examples/tr/17_testler_test.tr   → testleri çalıştırır, özet yazar
//   tr examples/tr/17_testler_test.tr        → dosyayı normal çalıştırır; test blokları atlanır
// Bir test kalırsa `tr test` 1 ile çıkar; CI'da kapı olarak kullanılabilir.

// --- Sınanacak kod ---
TR_kw_func topla(a, b) {
    TR_kw_return a + b
}

TR_kw_func ortalama_al(liste) {
    TR_kw_if liste.TR_mem_length == 0 { TR_kw_throw "boş listenin ortalaması alınamaz" }
    TR_kw_return TR_fn_sum(liste) / liste.TR_mem_length
}

TR_kw_struct Sepet {
    ürünler = []

    TR_kw_func TR_mem_append(ad, fiyat) {
        TR_kw_self.ürünler.TR_mem_append({"ad": ad, "fiyat": fiyat})
    }

    TR_kw_func tutar() {
        TR_kw_return TR_fn_sum(TR_kw_self.ürünler.TR_mem_map { TR_ctx_it["fiyat"] })
    }
}

// Bu satır her iki kipte de çalışır: testlerden önce dosyanın kendisi çalışır.
TR_fn_print("Test blokları yalnızca şu komutla çalışır: tr test examples/tr/17_testler_test.tr")

// --- Testler ---
TR_ctx_test "toplama" {
    TR_fn_assert_equal(4, topla(2, 2))
    TR_fn_assert_equal(0, topla(-1, 1))
}

TR_ctx_test "ortalama" {
    TR_fn_assert_equal(2.5, ortalama_al([1, 2, 3, 4]))
    TR_fn_assert(ortalama_al([10]) == 10, "tek elemanın ortalaması kendisidir")
}

TR_ctx_test "boş listede hata fırlatılır" {
    TR_kw_var mesaj = ""
    TR_kw_try { ortalama_al([]) } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("boş liste"), "beklenen hata gelmedi: {mesaj}")
}

TR_ctx_test "sepet tutarı" {
    TR_kw_var s = Sepet() // her test yeni bir kapsamda çalışır
    s.TR_mem_append("kalem", 15)
    s.TR_mem_append("defter", 40)
    TR_fn_assert_equal(2, s.ürünler.TR_mem_length)
    TR_fn_assert_equal(55, s.tutar())
}

// --- Kendin dene ---
// 1. topla için negatif sayıları sınayan bir test daha ekle.
// 2. Bir testi bilerek yanlış yaz (eşit_mi(5, topla(2, 2))) ve `tr test` çıktısında nasıl kaldığını gör.
