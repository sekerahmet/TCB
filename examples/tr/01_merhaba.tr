# TR 4
# 01 — Merhaba: ilk TR programı.
# Ne öğretir: yazdır ile ekrana yazmak, metin sabiti, birden çok değer, satır sonu ve yorum.
# Önceki örnekten: — (ilk örnek).
# Çalıştırma (proje kökünden): tr examples/tr/01_merhaba.tr
# Kendi denemeleriniz için bu dosyayı scratch/ klasörüne kopyalayıp değiştirebilirsiniz
# (scratch/ depoya girmez).

# # ile başlayan satır yorumdur: program onu çalıştırmaz, okuyana not düşer.
TR_print("Merhaba, dünya!")
TR_print("Bu ikinci satır.")

# Virgülle ayrılan değerler aynı satıra, aralarına birer boşluk konarak yazılır.
TR_print("Üç", "değer", "yan yana")
TR_print(2026) # sayı da yazdırılır; tırnak yalnızca metin içindir

# Metnin içindeki \n satır sonu demektir.
TR_print("Birinci satır\nİkinci satır")

