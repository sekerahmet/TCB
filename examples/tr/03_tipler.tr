// 02 — Değişkenler ve tipler: değer saklamak ve her değerin bir tipi olduğunu görmek.
// Öğrettikleri: değişken ve sabit, temel tipler (Tam, Ondalık, Metin, Mantık, yok), tip()
// ile tip sormak, tam()/ondalık()/metin() dönüşümleri, işleçler, ?? ile yok güvenliği.
// Önceki örnek: 01 (merhaba). Sonraki: 03 (koşullar ve döngüler).
// Çalıştırma (proje kökünden): tr examples/tr/02_degiskenler_ve_tipler.tr

değişken yaş = 30 // Tam: ondalık noktası olmayan sayı
değişken boy = 1.75 // Ondalık
değişken ad = "Ayşe" // Metin
değişken öğrenci_mi = doğru // Mantık
yazdır(tip(yaş), tip(boy), tip(ad), tip(öğrenci_mi))

sabit SÜRÜM = "1.0" // sabit yeniden atanamaz
yazdır("sürüm {SÜRÜM}")

// Dönüşümler ve işleçler
yazdır(tam("42") + 1, ondalık("2.5") * 2, metin(7) + "8")
yazdır(7 / 2, 7 % 2, 2 ** 10) // bölme, kalan, kuvvet
yazdır(yaş >= 18 ve öğrenci_mi, değil öğrenci_mi, yaş < 18 veya boy > 1.7)

// yok: değerin olmadığını söyler; ?? soldaki yoksa sağdakini alır
değişken kullanıcı = yok
değişken görünen_ad = kullanıcı ?? "Misafir"
yazdır("Merhaba, {görünen_ad}!")

// Metin içine ifade yerleştirmek: {...}
yazdır("{ad} {yaş} yaşında; gelecek yıl {yaş + 1}")
