# TR 4
# 03 — Tipler: her değerin bir tipi vardır.
# Ne öğretir: Tam, Ondalık, Metin, Mantık, yok; tip(); tam()/ondalık()/metin() dönüşümleri;
# işleçler ve karşılaştırma; yok olabilen değer için ??.
# Önceki örnekten: değişken, sabit ve atama (02).
# Çalıştırma (proje kökünden): tr examples/tr/03_tipler.tr

TR_var yaş = 30 # Tam: ondalık noktası olmayan sayı
TR_var boy = 1.75 # Ondalık: noktalı sayı
TR_var ad = "Ayşe" # Metin
TR_var öğrenci_mi = TR_true # Mantık: doğru ya da yanlış
TR_print(TR_Type(yaş), TR_Type(boy), TR_Type(ad), TR_Type(öğrenci_mi))

# Dönüşümler: metin sayıya, sayı metne, ondalık tama çevrilir.
TR_print(TR_Int("42") + 1, TR_Float("2.5") * 2, TR_String(7) + "8")
TR_print(TR_Int(3.9), TR_round(3.14159, 2)) # tam() noktadan sonrasını atar

# Hesap işleçleri. / her zaman ondalık verir; % kalandır; ** kuvvettir.
TR_print(7 + 2, 7 - 2, 7 * 2, 7 / 2, 7 % 2, 2 ** 10)

# Karşılaştırma Mantık verir; ve, veya, değil mantıkları birleştirir.
TR_print(yaş >= 18, yaş == 30, yaş != 30)
TR_print(yaş >= 18 TR_and öğrenci_mi, TR_not öğrenci_mi, yaş < 18 TR_or boy > 1.7)

# yok "değer yok" demektir (kendi tipi Yok). ?? soldaki yoksa sağdakini alır.
TR_var kullanıcı = TR_none
TR_print(TR_Type(kullanıcı), kullanıcı ?? "Misafir")

# --- Kendin dene ---
# 1. tip(2 ** 10) ve tip(2 ** 0.5) ne yazar? Önce tahmin et, sonra çalıştır.
# 2. "12" + 1 ile tam("12") + 1 sonuçlarını karşılaştır: biri metin birleştirir, öbürü sayı toplar.
