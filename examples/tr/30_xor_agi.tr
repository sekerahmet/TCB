// 30 — Küçük sinir ağı: iki katmanlı bir ağ XOR'u öğrenir.
// Ne öğretir: gizli katman ve doğrusal olmayan etkinleştirme (tanh, sigmoid), ağırlıkları
// türev izleyen tensörler olarak kurmak, çok katmanlı ağda eğitim döngüsü.
// Önceki örnekten: eğitim döngüsü (28); XOR tek doğrusal katmanla çözülemez, gizli katman bunu mümkün kılar.
// Çalıştırma (proje kökünden): tr examples/tr/30_xor_agi.tr

// Gizli katman tanh, çıkış sigmoid; ağırlıklar tensördür, AdamW ile eğitilir.
değişken X_veri = tensör([[0, 0], [0, 1], [1, 0], [1, 1]])
değişken Y_hedef = tensör([[0], [1], [1], [0]])
değişken W1 = tensör(rastgele_normal([2, 8], tohum: 42) * 0.5, türev_izle: doğru)
değişken b1 = tensör(sıfırlar([8]), türev_izle: doğru)
değişken W2 = tensör(rastgele_normal([8, 1], tohum: 7) * 0.5, türev_izle: doğru)
değişken b2 = tensör(sıfırlar([1]), türev_izle: doğru)
fonksiyon ağ(X) {
    sonuç sigmoid(tanh(X @ W1 + b1) @ W2 + b2)
}
değişken op = AdamW([W1, b1, W2, b2], öğrenme_oranı: 0.05, ağırlık_çürümesi: 0)
değişken ilk_kayıp = 0.0
döngü adım içinde 0..800 {
    op.sıfırla()
    değişken kayıp = ortalama((ağ(X_veri) - Y_hedef) ** 2)
    eğer adım == 0 { ilk_kayıp = kayıp.değer }
    geri_yayılım(kayıp)
    op.adım()
}
değişken son_kayıp = türevsiz { ortalama((ağ(X_veri) - Y_hedef) ** 2) }.değer
yazdır("ilk kayıp {yuvarla(ilk_kayıp, 4)} → son kayıp {yuvarla(son_kayıp, 6)}")
yazdır("XOR tahminleri (beklenen 0, 1, 1, 0): {[yuvarla(t[0], 2) döngü t içinde türevsiz { ağ(X_veri) }.değer]}")
