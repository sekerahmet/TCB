// 35 — Transformer: elle yazılmış küçük bir transformer.
// Ne öğretir: gömme ve konum gömmesi, çok bakışlı nedensel dikkat (şekillendir ve
// birleşik dikkat(...)), katman normu, gelu ile ileri besleme, çapraz_entropi kaybı.
// Önceki örnekten: tensörler ve türev (23–28), çok katmanlı ağ (30), katmanlar (31): katman_normu, gelu, çapraz_entropi.
// Görev: 0..V-1 arasında döngüsel ilerleyen dizilerde bir sonraki parçayı tahmin etmek.
// Çalıştırma (proje kökünden): tr examples/tr/35_transformer.tr

değişken V = 8 // sözlük boyutu
değişken T = 8 // bağlam uzunluğu
değişken D = 16 // gizli boyut
değişken H = 2 // dikkat bakışı (İngilizce head)
değişken Dh = 8 // bakış boyutu (D / H)
değişken B = 4 // toplu iş boyutu

// Öğrenilen parametre: küçük rastgele değerlerle başlar, gradyanı izlenir.
değişken parametre_tohumu = 1
fonksiyon parametre(şekil, ölçek) {
    parametre_tohumu += 1 // her parametreye farklı ama sabit bir tohum: sonuç tekrar üretilebilir
    sonuç tensör(türevsiz(rastgele_normal(şekil, tohum: parametre_tohumu) * ölçek), türev_izle: doğru)
}

değişken E = parametre([V, D], 0.1) // parça gömme tablosu
değişken P = parametre([T, D], 0.1) // konum gömme tablosu
değişken Wq = parametre([D, D], 0.2)
değişken Wk = parametre([D, D], 0.2)
değişken Wv = parametre([D, D], 0.2)
değişken Wo = parametre([D, D], 0.2)
değişken W1 = parametre([D, 4 * D], 0.2)
değişken W2 = parametre([4 * D, D], 0.1)
değişken g1 = tensör(birler([D]), türev_izle: doğru)
değişken s1 = tensör(sıfırlar([D]), türev_izle: doğru)
değişken g2 = tensör(birler([D]), türev_izle: doğru)
değişken s2 = tensör(sıfırlar([D]), türev_izle: doğru)
değişken Wu = parametre([D, V], 0.2)

değişken konumlar = aralık(T)

fonksiyon başlara_ayır(x) {
    // [B, T, D] -> [B, T, H, Dh]: dikkat bu düzeni okur, eksen sıralamaya gerek yok
    sonuç x.şekillendir([B, T, H, Dh])
}

fonksiyon ileri(girdiler) {
    değişken x = gömme(E, girdiler) + gömme(P, konumlar) // [B, T, D]
    değişken q = başlara_ayır(x @ Wq)
    değişken k = başlara_ayır(x @ Wk)
    değişken v = başlara_ayır(x @ Wv)
    // Nedensel dikkat: her konum yalnızca kendisine ve öncekilere bakar. Elle yazılmış
    // karşılığı softmax((q @ k.devrik()) / karekök(Dh) + maske, eksen: -1) @ v'dir (maske
    // gelecekteki konumlarda çok büyük bir eksi sayı); dikkat(...) aynı sonucu T×T puan
    // matrisini tutmadan, tek adımda hesaplar.
    değişken y = dikkat(q, k, v, nedensel: doğru).şekillendir([B, T, D])
    değişken h = katman_normu(x + y @ Wo, g1, s1)
    değişken m = gelu(h @ W1) @ W2
    değişken çıkış = katman_normu(h + m, g2, s2)
    sonuç çıkış @ Wu // [B, T, V]
}

// Basit, tekrar üretilebilir sözde rastgele sayılar
değişken tohum = 12345
fonksiyon rastgele_tam(n) {
    tohum = (tohum * 1103515245 + 12345) % 2147483648
    sonuç tohum % n
}

fonksiyon toplu_iş_üret() {
    değişken girdiler = []
    değişken hedefler = []
    döngü b içinde 0..B {
        değişken baş = rastgele_tam(V)
        değişken g = []
        döngü t içinde 0..T {
            g.ekle((baş + t) % V)
            hedefler.ekle((baş + t + 1) % V)
        }
        girdiler.ekle(g)
    }
    sonuç [girdiler, hedefler]
}

değişken ağırlıklar = [E, P, Wq, Wk, Wv, Wo, W1, W2, g1, s1, g2, s2, Wu]
değişken iyileştirici = AdamW(ağırlıklar, öğrenme_oranı: 0.01, ağırlık_çürümesi: 0.0)

döngü adım içinde 0..300 {
    değişken veri = toplu_iş_üret()
    iyileştirici.sıfırla()
    değişken kayıp = çapraz_entropi(ileri(veri[0]), veri[1])
    geri_yayılım(kayıp)
    iyileştirici.adım()
    eğer adım % 50 == 0 {
        yazdır("adım {adım}: kayıp = {yuvarla(kayıp.değer, 4)}")
    }
}

// Öğrendi mi? Bir diziyi verip tahminleri yazdır.
değişken deneme = toplu_iş_üret()
değişken tahmin = türevsiz { ileri(deneme[0]) }
değişken olasılıklar = tahmin[0] // ilk dizinin [T, V] çıktısı
değişken tahminler = argmax(olasılıklar, eksen: -1).değer // her konumda en büyük olasılığın indeksi
yazdır("girdi  : {deneme[0][0]}")
yazdır("tahmin : {tahminler}")

// dikkat'in iki ek ayarı: pencere: her sorguyu son w konumla sınırlar (yerel dikkat);
// maske: 0/1 tensörüyle hangi konumlara bakılacağını siz seçersiniz (nedensel: yanlış ile birlikte).
değişken sorgu = rastgele_normal([6, 4], tohum: 2)
yazdır("pencere:", dikkat(sorgu, sorgu, sorgu, pencere: 2).şekil)
değişken sorgu2 = rastgele_normal([3, 4], tohum: 1)
değişken bakılacaklar = tensör([[1, 1, 0], [1, 1, 0], [1, 1, 1]])
yazdır("maske:", dikkat(sorgu2, sorgu2, sorgu2, nedensel: yanlış, maske: bakılacaklar).şekil)

// --- Kendin dene ---
// 1. D'yi 16'dan 32'ye çıkar (Dh'yi de güncelle): kayıp daha hızlı mı düşüyor?
// 2. Eğitim adımını 300'den 60'a indir ve son tahminlerin bozulduğunu gör.
