// 06 — Yapılar ve metotlar: ilişkili verileri ve onlara bağlı işleri bir arada tutmak.
// Öğrettikleri: yapı tanımı, alanlar ve varsayılan değerler, metot, kendi, nesne oluşturma
// (konumlu ve adlı), alan güncellemek.
// Önceki örnek: 05. Sonraki: 07 (hata yönetimi).
// Çalıştırma (proje kökünden): tr examples/tr/06_yapilar_ve_metotlar.tr

yapı Geliştirici {
    ad: Metin
    deneyim: Tam = 1 // varsayılan değer

    fonksiyon tanıt() {
        sonuç "{kendi.ad} ({kendi.deneyim} yıl)"
    }

    fonksiyon deneyim_ekle(yıl) {
        kendi.deneyim += yıl
    }
}

değişken dev = Geliştirici("Ahmet", 5)
dev.deneyim += 1 // alan doğrudan güncellenir
yazdır(dev.tanıt())
yazdır(Geliştirici(ad: "Zeynep").tanıt()) // adlı argüman, deneyim varsayılan
dev.deneyim_ekle(4)
yazdır(dev.tanıt())

// Yapılar listede de tutulur
yapı Nokta {
    x: Ondalık
    y: Ondalık

    fonksiyon uzaklık() {
        sonuç karekök(kendi.x ** 2 + kendi.y ** 2)
    }
}
değişken noktalar = [Nokta(3.0, 4.0), Nokta(6.0, 8.0)]
yazdır(noktalar.haritala { o.uzaklık() })
