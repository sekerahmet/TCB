//! tr kodlu 3 dil=tr
// Hata 18 — Sonsuz özyineleme.
// İleti kodu: H2422
// Ne olur: Kendini durmadan çağıran fonksiyon iç içe çağrı sınırını aşar ve program durur.
// Neden: Fonksiyonun durduran bir koşulu yok.
// Düzeltilmiş hâli:
//     fonksiyon say(n) {
//         eğer n >= 10 { sonuç n }
//         sonuç say(n + 1)
//     }
// Çalıştırma (proje kökünden): tr examples/tr/hatalar/18_sonsuz_ozyineleme.tr   (çıkış kodu 1)

TR_kw_func say(n) {
    TR_kw_return say(n + 1)
}
TR_fn_print(say(0))
