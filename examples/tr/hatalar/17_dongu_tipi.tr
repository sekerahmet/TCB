//! tr kodlu 3 dil=tr
// Hata 17 — Gezilemeyen değer.
// İleti kodu: H2443
// Ne olur: Gezilemeyen bir değer üzerinde döngü kurulursa çalışma anında hata alınır.
// Neden: 5 bir sayıdır; döngü bir liste, aralık, sözlük ya da metin ister.
// Düzeltilmiş hâli:
//     döngü x içinde 0..5 {
//         yazdır(x)
//     }
// Çalıştırma (proje kökünden): tr examples/tr/hatalar/17_dongu_tipi.tr   (çıkış kodu 1)

TR_kw_for x TR_kw_in 5 {
    TR_fn_print(x)
}
