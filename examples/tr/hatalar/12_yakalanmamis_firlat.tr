# TR 4
# Hata 12 — Yakalanmayan fırlat.
# İleti kodu: H2441
# Ne olur: fırlat ile üretilen hata hiçbir yakala bloğuna ulaşmazsa program durur ve hata iletisi yazılır.
# Neden: Hatayı karşılayan bir dene/yakala yok.
# Düzeltilmiş hâli:
#     dene {
#         yazdır(yaş_denetle(-3))
#     } yakala h {
#         yazdır("yakalandı: {h}")
#     }
# Çalıştırma (proje kökünden): tr examples/tr/hatalar/12_yakalanmamis_firlat.tr   (çıkış kodu 1)

TR_func yaş_denetle(yaş: TR_Int) -> TR_Int {
    TR_if yaş < 0 { TR_throw "yaş negatif olamaz" }
    TR_return yaş
}
TR_print(yaş_denetle(-3))
