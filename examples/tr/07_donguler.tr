# TR 4
# 07 — Döngüler: bir işi yinelemek.
# Ne öğretir: döngü ... içinde ile aralık gezmek (1..=5 sonu dahil, 1..5 sonu hariç), çık, devam,
# iken, döngü koşul { }, döngü { }, iç içe döngü.
# Önceki örnekten: koşullar (05), metne değer yerleştirme (04), += (02).
# Çalıştırma (proje kökünden): tr examples/tr/07_donguler.tr

# döngü i içinde aralık: i sırayla aralığın her değerini alır.
TR_for i TR_in 1..=5 {
    TR_print("tur \(i)")
}
TR_print("sonu hariç:")
TR_for i TR_in 1..5 {
    TR_print(i)
}

# Birikim: döngü boyunca bir değişkeni güncelleyerek toplamak.
TR_var birikmiş = 0
TR_for i TR_in 1..=100 {
    birikmiş += i
}
TR_print("1'den 100'e toplam: \(birikmiş)")

# devam bu turu atlar, çık döngüyü bitirir.
TR_var ara_toplam = 0
TR_for i TR_in 1..=10 {
    TR_if i == 4 { TR_continue } # 4'ü atla
    TR_if i > 8 { TR_break } # 8'den sonra dur
    ara_toplam += i
}
TR_print("1..8 (4 hariç) toplamı: \(ara_toplam)")

# iken: koşul doğru olduğu sürece sürer. Kaç tur süreceği baştan belli değilse kullanılır.
TR_var n = 1
TR_for n < 100 {
    n = n * 3
}
TR_print("3'ün 100'ü aşan ilk kuvveti: \(n)")

# İç içe döngü: dıştaki her tur için içtekinin tamamı çalışır.
TR_for satır TR_in 1..=3 {
    TR_for sütun TR_in 1..=3 {
        TR_print("\(satır) x \(sütun) = \(satır * sütun)")
    }
}

# Döngünün üç yazımı daha: döngü koşul { }, iken ile aynı işi yapar; döngü { } koşulsuzdur ve çık ile biter.
TR_var m = 1
TR_for m < 50 {
    m = m * 2
}
TR_print("2'nin 50'yi aşan ilk kuvveti: \(m)")
TR_var tur = 0
TR_for {
    tur += 1
    TR_if tur * tur > 50 { TR_break }
}
TR_print("karesi 50'yi aşan ilk sayı: \(tur)")

# --- Kendin dene ---
# 1. 1'den 20'ye kadar yalnızca çift sayıların toplamını bul.
# 2. iken ile 1000'i ilk aşan 2 kuvvetini bul.
