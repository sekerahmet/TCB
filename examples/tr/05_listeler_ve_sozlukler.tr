// 05 — Listeler ve sözlükler: değer topluluklarını tutmak ve işlemek.
// Öğrettikleri: liste ve sözlük kurmak, indeksle okumak/yazmak, ekle, uzunluk, anahtarlar
// ve değerler, zincirleme metotlar (filtrele, haritala, sırala ...), boru hattı (|>).
// Önceki örnek: 04. Sonraki: 06 (yapılar ve metotlar).
// Çalıştırma (proje kökünden): tr examples/tr/05_listeler_ve_sozlukler.tr

// Liste
değişken meyveler = ["elma", "armut", "kiraz"]
meyveler.ekle("muz")
yazdır(meyveler, meyveler.uzunluk, meyveler[0], meyveler[-1])
meyveler[1] = "erik"
yazdır(meyveler)

// Sözlük: anahtar -> değer
değişken fiyatlar = {"elma": 12, "muz": 30}
fiyatlar["kiraz"] = 45
yazdır(fiyatlar["muz"], fiyatlar.uzunluk, fiyatlar.anahtarlar(), fiyatlar.değerler())
döngü anahtar içinde fiyatlar.anahtarlar() {
    yazdır("{anahtar}: {fiyatlar[anahtar]}")
}

// Zincirleme metotlar
değişken ham = [5, 2, 8, 2, 1, 9, 5, 4]
yazdır(ham.benzersiz().filtrele { o > 2 }.sırala().ters_çevir())
yazdır("ilk: {ham.ilk}, son: {ham.son}, toplam: {toplam(ham)}, ortalama: {ortalama(ham)}")
yazdır("  merhaba yeni nesil tr dili  ".kırp().büyük_harf().böl(" ").birleştir(" - "))

// Boru hattı: soldaki değer sağdaki fonksiyona girer
değişken çift_kareler = ham.filtrele((x) => x % 2 == 0).haritala { o * o }
yazdır("çift kareler: {çift_kareler}, toplamı {çift_kareler |> toplam}")

// Çoklu atama ve takas
değişken a, b = 10, 20
a, b = b, a
yazdır("a = {a}, b = {b}")
