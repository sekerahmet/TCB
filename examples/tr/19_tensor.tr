// 12 — Tensörler ve otomatik türev: model eğitiminin yapı taşları.
// Öğrettikleri: tensör oluşturma ve şekil, @ (matris çarpımı), yayınlama, relu/softmax,
// otomatik türev (geri_yayılım, .gradyan), türevsiz, AdamW ile küçük bir doğrusal regresyon,
// maks_indeks ve tensör_kaydet/tensör_yükle. Sıradaki örnek (13) bunlarla bir sinir ağı kurar.
// Ayrıntılar: docs/guide/04_yapay_zeka_ve_veri.md §4.C, docs/spec/15_tensorler.md §15.
// Çalıştırma (proje kökünden): tr examples/tr/12_tensor_ve_turev.tr
// Ağırlık dosyası geçici klasöre yazılır (program bitince silinir, depoda iz kalmaz).

yazdır("=== 1. Tensör, @ ve yayınlama ===")
değişken A = tensör([[1.0, 2.0], [3.0, 4.0]])
değişken W = tensör([[0.5, -0.5], [1.0, 2.0]]) // matris: 2 boyutlu tensör
yazdır("A.şekil = {A.şekil}")
yazdır("A @ W =", A @ W)
yazdır("A + [10, 20] (her satıra eklenir) =", A + tensör([10.0, 20.0]))
yazdır("relu(A @ W - 4) =", relu(A @ W - 4))
yazdır("softmax([2, 1, 0.1]) =", softmax(tensör([2.0, 1.0, 0.1])))

yazdır("\n=== 2. Otomatik türev ===")
// y = x² + 2x + 1 → dy/dx = 2x + 2; x = 3 için 8
değişken x = tensör(3.0, türev_izle: doğru)
değişken y = x * x + 2 * x + 1
geri_yayılım(y)
yazdır("y = {y.değer}, dy/dx = {x.gradyan.değer} (beklenen 8.0)")

// türevsiz { ... } hesap çizgesi kurmadan çalışır (çıkarım için)
değişken z = türevsiz { x * 10 }
yazdır("türevsiz sonuç: {z.değer}")

yazdır("\n=== 3. AdamW ile doğrusal regresyon: y = 2x - 1 ===")
değişken X = tensör([[0], [1], [2], [3]])
değişken Y = tensör([[-1], [1], [3], [5]])
değişken w = tensör([[0.0]], türev_izle: doğru)
değişken b = tensör([0.0], türev_izle: doğru)
değişken iyileştirici = AdamW([w, b], öğrenme_oranı: 0.1, ağırlık_çürümesi: 0)

döngü adım içinde 0..300 {
    iyileştirici.sıfırla() // gradyanlar birikir: her adımda sıfırla
    değişken fark = X @ w + b - Y
    değişken kayıp = ortalama(fark ** 2)
    geri_yayılım(kayıp)
    iyileştirici.adım()
    eğer adım % 50 == 0 {
        yazdır("adım {adım}: kayıp = {yuvarla(kayıp.değer, 5)}")
    }
}
yazdır("w = {yuvarla(w.değer[0][0], 3)}, b = {yuvarla(b.değer[0], 3)} (beklenen 2, -1)")
yazdır("x = 10 için tahmin: {yuvarla(türevsiz { tensör([[10]]) @ w + b }.değer[0][0], 2)}")

yazdır("\n=== 4. maks_indeks: en olası sınıf ===")
değişken çıktılar = tensör([[0.1, 2.5, 0.3], [1.7, 0.2, 0.9]])
değişken sınıflar = maks_indeks(çıktılar, eksen: -1)
değişken adlar = ["kedi", "köpek", "kuş"]
yazdır("sınıf indeksleri: {sınıflar.değer} → {[adlar[i] döngü i içinde sınıflar.değer]}")

yazdır("\n=== 5. tensör_kaydet / tensör_yükle ===")
değişken ağırlık_dosyası = yol(geçici_klasör(), "agirliklar.trt")
tensör_kaydet(ağırlık_dosyası, {"w": w, "b": b})
değişken yüklenen = tensör_yükle(ağırlık_dosyası)
yazdır("yüklenen w = {yuvarla(yüklenen["w"].değer[0][0], 3)}, b = {yuvarla(yüklenen["b"].değer[0], 3)}")
