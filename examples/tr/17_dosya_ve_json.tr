// 11 — Dosya ve JSON: veriyi diske yazıp geri okumak.
// Öğrettikleri: geçici_klasör, yol, dosya_yaz/dosya_oku, dosya_satırları, .var_mı,
// json_metin ile değeri metne, json_çöz ile metni değere çevirmek.
// Önceki örnek: 10. Sonraki: 12 (tensörler ve otomatik türev).
// Çalıştırma (proje kökünden): tr examples/tr/11_dosya_ve_json.tr
// Dosyalar geçici klasöre yazılır (program bitince silinir, depoda iz kalmaz).

değişken klasör = geçici_klasör()

// Metin dosyası
değişken not_yolu = yol(klasör, "notlar.txt")
dosya_yaz(not_yolu, "birinci satır\nikinci satır\nüçüncü satır\n")
yazdır("var mı: {not_yolu.var_mı}")
yazdır("satır sayısı: {dosya_oku(not_yolu).kırp().böl("\n").uzunluk}")
döngü satır içinde dosya_satırları(not_yolu) {
    yazdır("satır: {satır}")
}

// JSON: sözlük -> metin -> dosya -> metin -> sözlük
değişken ayar = {"ad": "deneme", "adım": 100, "oranlar": [0.1, 0.01], "açık": doğru}
değişken ayar_yolu = yol(klasör, "ayar.json")
dosya_yaz(ayar_yolu, json_metin(ayar))
değişken okunan = json_çöz(dosya_oku(ayar_yolu))
yazdır("adım: {okunan["adım"]}, oranlar: {okunan["oranlar"]}, açık: {okunan["açık"]}")
yazdır("aynı mı: {okunan == ayar}")
