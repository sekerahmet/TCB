// 09 — Fonksiyonlar: işi adlandırıp yeniden kullanmak.
// Ne öğretir: fonksiyon ve sonuç, tip bildirimi, varsayılan değer, adlı argüman, kendini
// çağıran (özyinelemeli) fonksiyon.
// Önceki örnekten: koşullar (06), döngüler (08), metne değer yerleştirme (05).
// Çalıştırma (proje kökünden): tr examples/tr/09_fonksiyonlar.tr

// fonksiyon ad(parametreler) { ... sonuç değer }: sonuç değeri çağırana geri verir.
fonksiyon topla(a, b) {
    sonuç a + b
}
yazdır(topla(2, 3))
yazdır(topla(topla(1, 2), 4)) // sonuç başka bir çağrıya girdi olabilir

// Parametrelere ve sonuca tip yazılabilir; yanlış tipte değer verilirse hata alınır.
fonksiyon alan(en: Ondalık, boy: Ondalık) -> Ondalık {
    sonuç en * boy
}
yazdır(alan(2.5, 4.0))

// Varsayılan değer: argüman verilmezse o kullanılır.
// Adlı argüman: parametre adıyla verilir, sıra önemsizdir.
fonksiyon selam(ad, ek = "!") {
    sonuç "Selam {ad}{ek}"
}
yazdır(selam("Ayşe"))
yazdır(selam("Ali", "?"))
yazdır(selam(ek: "...", ad: "Veli"))

// sonuç fonksiyonu hemen bitirir; koşulla birlikte erken çıkış yapılabilir.
fonksiyon mutlak_değer(x) {
    eğer x < 0 { sonuç -x }
    sonuç x
}
yazdır(mutlak_değer(-7), mutlak_değer(7))

// Fonksiyon kendini çağırabilir (özyineleme); mutlaka duran bir koşulu olmalıdır.
fonksiyon faktöriyel(n) {
    eğer n <= 1 { sonuç 1 }
    sonuç n * faktöriyel(n - 1)
}
yazdır("5! = {faktöriyel(5)}, 10! = {faktöriyel(10)}")

// Fonksiyonun içindeki değişkenler dışarıdan görünmez.
fonksiyon say_ve_yaz(sınır) {
    değişken birikmiş = 0
    döngü i içinde 1..=sınır { birikmiş += i }
    yazdır("1..{sınır} toplamı {birikmiş}")
}
say_ve_yaz(10)

// --- Kendin dene ---
// 1. Bir sayının karesini veren kare(x) fonksiyonunu yaz ve kare(kare(2)) değerini bul.
// 2. n'inci Fibonacci sayısını özyinelemeyle hesapla (fib(1) = 1, fib(2) = 1).
