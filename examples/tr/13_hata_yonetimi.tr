// 07 — Hata yönetimi: beklenmedik durumda programı düzgün yönetmek.
// Öğrettikleri: dene/yakala, fırlat ile kendi hatanı üretmek, ertele ile her durumda
// çalışacak temizlik (ters sırayla).
// Önceki örnek: 06. Sonraki: 08 (testler).
// Çalıştırma (proje kökünden): tr examples/tr/07_hata_yonetimi.tr

// Hata oluşunca yakala bloğu çalışır, program sürer
dene {
    değişken x = 10 / 0
    yazdır("buraya gelinmez")
} yakala hata {
    yazdır("yakalandı: {hata}")
}

// fırlat: kendi hatanı üret
fonksiyon yaş_denetle(yaş) {
    eğer yaş < 0 { fırlat "yaş negatif olamaz" }
    sonuç yaş
}
dene { yaş_denetle(-3) } yakala h { yazdır("yakalandı: {h}") }
yazdır("geçerli yaş: {yaş_denetle(30)}")

// ertele: fonksiyondan çıkarken, hata olsa da olmasa da, ters sırayla çalışır
fonksiyon dosya_işlemi() {
    ertele yazdır("  [ertele 1] bağlantı kapatıldı")
    ertele yazdır("  [ertele 2] önbellek temizlendi") // önce bu çalışır
    yazdır("  [işlem] veri işleniyor...")
    sonuç "başarılı"
}
yazdır("dönüş: {dosya_işlemi()}")

fonksiyon başarısız_işlem() {
    ertele yazdır("  [ertele] hata olsa da temizlik yapıldı")
    fırlat "işlem başarısız"
}
dene { başarısız_işlem() } yakala h { yazdır("yakalandı: {h}") }
