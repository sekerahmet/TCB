// 03 — Koşullar ve döngüler: karar vermek ve işi yinelemek.
// Öğrettikleri: eğer/değilse, eşle (aralık kalıplarıyla), döngü ... içinde, aralıklar
// (1..=10 sonu dahil, 1..10 hariç), çık/devam, iken, liste üreteci.
// Önceki örnek: 02. Sonraki: 04 (fonksiyonlar).
// Çalıştırma (proje kökünden): tr examples/tr/03_kosullar_ve_donguler.tr

değişken sıcaklık = 31
eğer sıcaklık > 30 {
    yazdır("sıcak")
} değilse eğer sıcaklık > 15 {
    yazdır("ılık")
} değilse {
    yazdır("soğuk")
}

// eşle: değeri kalıplarla karşılaştırır, ilk uyan kolu çalıştırır
fonksiyon not_durumu(puan) {
    eşle puan {
        90..=100 => "pekiyi"
        70..90 => "iyi"
        50..70 => "geçer"
        varsayılan => "kaldı"
    }
}
döngü p içinde [95, 78, 55, 42] {
    yazdır("puan {p} -> {not_durumu(p)}")
}

// döngü + çık/devam
değişken ara_toplam = 0
döngü i içinde 1..=10 {
    eğer i == 4 { devam } // bu turu atla
    eğer i > 8 { çık } // döngüden çık
    ara_toplam += i
}
yazdır("1..8 (4 hariç) toplamı: {ara_toplam}")

// iken: koşul doğru olduğu sürece
değişken n = 1
iken n < 100 { n = n * 3 }
yazdır("3'ün 100'ü aşan ilk kuvveti: {n}")

// liste üreteci: döngü ve koşulu tek ifadede toplar
yazdır("çift kareler: {[x * x döngü x içinde 1..=10 eğer x % 2 == 0]}")
