# TR 4
# 14 — Yapılar ve metotlar: ilişkili verileri ve onlara bağlı işleri bir arada tutmak.
# Ne öğretir: yapı tanımı, alanlar ve varsayılan değerler, metot, kendi, nesne oluşturma
# (konumlu ve adlı), alan güncellemek, kurucu, YapıTanımı ve Nesne, nesnenin metni, durumlu tip
# ve arayüz.
# Önceki örnekten: fonksiyonlar (08), listeler (09), sözlükler (11).
# Çalıştırma (proje kökünden): tr examples/tr/14_yapilar_ve_metotlar.tr

# yapı, kendi alanları olan yeni bir tip tanımlar. Sözlükten farkı: alanları ve tipleri baştan bellidir.
TR_struct Geliştirici {
    ad: TR_String
    deneyim: TR_Int = 1 # varsayılan değer

    # Yapının içindeki fonksiyon metottur; kendi, üzerinde çalışılan nesnedir.
    TR_func tanıt() -> TR_String {
        TR_return "\(TR_self.ad) (\(TR_self.deneyim) yıl)"
    }

    TR_func deneyim_ekle(yıl: TR_Int) {
        TR_self.deneyim += yıl
    }
}

TR_var dev = Geliştirici("Ahmet", 5) # alanlar tanım sırasıyla verilir
dev.deneyim += 1 # alan doğrudan güncellenir
TR_print(dev.tanıt())
TR_print(Geliştirici(ad: "Zeynep").tanıt()) # adlı argüman; deneyim varsayılan kalır
dev.deneyim_ekle(4)
TR_print(dev.tanıt())

# Yapılar listede de tutulur.
TR_struct Nokta {
    x: TR_Float
    y: TR_Float

    TR_func uzaklık() -> TR_Float {
        TR_return TR_sqrt(TR_self.x ** 2 + TR_self.y ** 2)
    }
}
TR_var noktalar = [Nokta(3.0, 4.0), Nokta(6.0, 8.0)]
TR_print(noktalar.TR_map((x) => x.uzaklık()))

# kurucu adlı metot nesne oluşturulurken çağrılır; alanları hesaplayarak başlatabilir.
TR_struct Hesap {
    bakiye: TR_Int

    TR_func TR_init(ilk: TR_Int) {
        TR_self.bakiye = ilk * 2
    }
}
TR_print(Hesap(5).bakiye)

# Yapının kendisi YapıTanımı tipindedir; nesnenin tipi yapının kendisidir: tip bildiriminde
# yapının adı yazılır. Nesne genel bir tiptir, tip yerine yazılmaz (3.11).
TR_var hesap: Hesap = Hesap(1)
TR_print(TR_Type(Hesap) == TR_StructType, TR_Type(hesap) == Hesap, TR_Type(hesap) == TR_Object)

# Nesnenin metni kurma yazımıdır: programa kopyalanınca aynı değeri kurar.
TR_print(Nokta(3.0, 4.0))

# durumlu, değeri birkaç durumdan biri olan bir tip tanımlar; durum kendi alanlarını taşır.
# Alanlar eşle ile okunur: desen alanları sırayla adlara bağlar.
TR_enum Cevap {
    Bekliyor
    Tamam(değer: TR_String)
    Hata(kod: TR_Int, ileti: TR_String)
}
TR_func anlat(c: Cevap) -> TR_String {
    TR_return TR_match c {
        Cevap.Bekliyor => "bekliyor"
        Cevap.Tamam(d) => "tamam: \(d)"
        Cevap.Hata(k, i) => "hata \(k): \(i)"
    }
}
TR_print(anlat(Cevap.Tamam("42")), anlat(Cevap.Hata(404, "yok")), Cevap.Bekliyor)

# arayüz, gövdesiz metot imzalarıdır; metotları taşıyan her yapı onu karşılar (ayrıca bildirilmez).
TR_interface Ölçen {
    TR_func ölç() -> TR_Float
}
TR_func toplam(ölçenler: TR_List[Ölçen]) -> TR_Float {
    TR_var t = 0.0
    TR_for ö TR_in ölçenler { t += ö.ölç() }
    TR_return t
}
TR_struct Kare {
    a: TR_Float
    TR_func ölç() -> TR_Float { TR_return TR_self.a * TR_self.a }
}
TR_print(toplam([Kare(2.0), Kare(3.0)]), Ölçen)

# --- Kendin dene ---
# 1. Dikdörtgen yapısı yaz (en, boy) ve alan() ile çevre() metotlarını ekle.
# 2. Geliştirici nesnelerinden oluşan bir liste kur ve deneyimi en yüksek olanın adını bul.
