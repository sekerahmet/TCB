//! tr kodlu 3 dil=tr
// 40 — Kontrol noktası: uzun eğitimi kaldığı yerden sürdürmek.
// Ne öğretir: KontrolNoktası, tut: (kaç nokta saklanır), her eğitimi bir koşu klasörüne yazmak; kontrol_noktası ile eğitimin bütün durumunu (model,
// iyileştirici, örnekleyici, günlük, kendi sayaçlarınız) düzenli kaydetmek; Ctrl+C ile durdurup aynı
// komutla kaldığı yerden sürdürmek. Sürdürülen eğitim kesintisizle bit düzeyinde aynı sonucu verir.
// Önceki örnekten: veri ile eğitim (39): komut_satırı, ilerleme, veri kümesi.
// Ayrıntılar: docs/guide/09_uzun_egitim.md, docs/spec/20_kontrol_noktasi.md §20.
//
// Çalıştırma (proje kökünden): tr examples/tr/40_kontrol_noktasi.tr
//   Eğitim sürerken Ctrl+C'ye basın: o adım biter, nokta kaydedilir, program durur.
//   Aynı komutu yeniden çalıştırın: "Kaldığı yerden devam: adım ..." yazar ve oradan sürer.
//   Eğitimi uzatmak için: tr examples/tr/40_kontrol_noktasi.tr --adım 1000
//   Baştan başlamak için koşu klasörünü silin ya da başka bir klasör verin: --koşu runs/deneme2
// Bulut not defterinde koşu klasörünü yerel diskte tutup ara ara Drive'a kopyalayın (kılavuz §9).

TR_kw_var ayar = TR_fn_command_line({TR_mem_step: 200, koşu: "runs/kontrol_noktasi_ornegi", her_dakika: 5.0, TR_mem_lr: 0.01},
    TR_arg_description: "Küçük bir dil modelini kontrol noktasıyla eğitir; kesilirse aynı komutla sürer",
    TR_arg_descriptions: {TR_mem_step: "toplam eğitim adımı", koşu: "koşu klasörü (ayarlar, günlük, ağırlıklar, kontrol noktaları)",
        her_dakika: "kontrol noktası aralığı (dakika)"})
TR_kw_const KOŞU = ayar.koşu

// --- Veri ve model (examples/tr/39_veri_ile_egitim.tr'deki küçük model) ---
TR_kw_var p = TR_fn_load_tokenizer("../../tests/data/tokenizer.json")
TR_kw_var V = p.TR_mem_vocab_size
TR_kw_var ö = TR_fn_dataset("../../tests/data/text").TR_mem_sampler(TR_arg_batch_size: 8, TR_arg_context: 32, TR_arg_seed: 1)
TR_kw_var parametre_tohumu = 0
TR_kw_func parametre(şekil, ölçek) {
    parametre_tohumu += 1
    TR_kw_return TR_fn_tensor(TR_fn_no_grad(TR_fn_randn(şekil, TR_arg_seed: parametre_tohumu) * ölçek), TR_arg_requires_grad: TR_kw_true)
}
TR_kw_var model = {E: parametre([V, 32], 0.1), W1: parametre([32, 64], 0.1), W2: parametre([64, V], 0.1)}
TR_kw_func ileri(giriş) {
    TR_kw_return TR_fn_gelu(TR_fn_embedding(model.E, giriş) @ model.W1) @ model.W2
}
TR_kw_var op = TR_fn_AdamW(TR_fn_parameters(model), TR_arg_lr: ayar.TR_mem_lr, TR_arg_weight_decay: 0.0)

// --- Koşu klasörü: ayarlar, günlük ve kontrol noktası ---
TR_fn_make_dir(KOŞU)
TR_fn_write_file(TR_fn_path(KOŞU, "config.json"), TR_fn_json_string(ayar))
TR_kw_var g = TR_fn_logger(TR_fn_path(KOŞU, "metrics.jsonl"))
TR_kw_var izlenen = {en_iyi_kayıp: 99.0}
// Sözlükteki her şey kaydedilir; klasörde bir nokta varsa burada yüklenir.
TR_kw_var kn = TR_fn_checkpoint(KOŞU, {model: model, op: op, ö: ö, g: g, izlenen: izlenen}, TR_arg_every_minutes: ayar.her_dakika, TR_arg_keep: 3)
TR_fn_print(TR_fn_type(kn) == TR_type_Checkpoint)

// --- Eğitim: döngü kaldığı adımdan başlar ---
TR_kw_if kn.TR_mem_resume_step < ayar.TR_mem_step {
    TR_kw_var ç = TR_fn_progress(ayar.TR_mem_step, TR_arg_log: g)
    TR_kw_for adım TR_kw_in kn.TR_mem_resume_step..ayar.TR_mem_step {
        TR_kw_var giriş, hedef = ö.TR_mem_next()
        op.TR_mem_zero_grad()
        TR_kw_var kayıp = TR_fn_cross_entropy(ileri(giriş), hedef)
        TR_fn_backward(kayıp)
        op.TR_mem_step()
        TR_kw_if kayıp.TR_mem_tolist < izlenen.en_iyi_kayıp { izlenen.en_iyi_kayıp = kayıp.TR_mem_tolist }
        ç.TR_mem_update({TR_mem_loss: kayıp}, TR_arg_step: adım + 1)
        kn.TR_mem_update(adım + 1) // her_dakika dolunca ve Ctrl+C gelince burada kaydeder
    }
    TR_fn_print("son nokta:", kn.TR_mem_save())
} TR_kw_else {
    TR_fn_print("Eğitim zaten {kn.TR_mem_resume_step}. adımda bitmiş; uzatmak için --adım ile daha büyük bir sayı verin")
}

// --- Sonuçlar koşu klasörüne ---
TR_fn_save_tensors(TR_fn_path(KOŞU, "model.trt"), TR_fn_parameters(model, TR_arg_named: TR_kw_true))
TR_kw_var son_adım = TR_kw_if kn.TR_mem_resume_step < ayar.TR_mem_step { ayar.TR_mem_step } TR_kw_else { kn.TR_mem_resume_step }
TR_fn_write_file(TR_fn_path(KOŞU, "results.json"), TR_fn_json_string({TR_mem_step: son_adım, en_iyi_kayıp: izlenen.en_iyi_kayıp}))
TR_fn_print("en iyi kayıp: {TR_fn_round(izlenen.en_iyi_kayıp, 3)}; koşu klasörü: {TR_fn_path(KOŞU).TR_mem_absolute}")

// --- Kendin dene ---
// 1. --adım 100 ile çalıştır, sonra --adım 200 ile tekrar çalıştır: eğitim 100'den mi başlıyor?
// 2. izlenen sözlüğüne kendi sayacını ekle ve devamdan sonra da korunduğunu gör.
