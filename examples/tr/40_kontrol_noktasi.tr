# TR 4
# 40 — Kontrol noktası: uzun eğitimi kaldığı yerden sürdürmek.
# Ne öğretir: KontrolNoktası, tut: (kaç nokta saklanır), her eğitimi bir koşu klasörüne yazmak; kontrol_noktası ile eğitimin bütün durumunu (model,
# iyileştirici, örnekleyici, günlük, kendi sayaçlarınız) düzenli kaydetmek; Ctrl+C ile durdurup aynı
# komutla kaldığı yerden sürdürmek. Sürdürülen eğitim kesintisizle bit düzeyinde aynı sonucu verir.
# Önceki örnekten: veri ile eğitim (39): komut_satırı, ilerleme, veri kümesi.
# Ayrıntılar: docs/guide/09_uzun_egitim.md, docs/spec/20_kontrol_noktasi.md §20.
#
# Çalıştırma (proje kökünden): tr examples/tr/40_kontrol_noktasi.tr
#   Eğitim sürerken Ctrl+C'ye basın: o adım biter, nokta kaydedilir, program durur.
#   Aynı komutu yeniden çalıştırın: "Kaldığı yerden devam: adım ..." yazar ve oradan sürer.
#   Eğitimi uzatmak için: tr examples/tr/40_kontrol_noktasi.tr --adım 1000
#   Baştan başlamak için koşu klasörünü silin ya da başka bir klasör verin: --koşu runs/deneme2
# Bulut not defterinde koşu klasörünü yerel diskte tutup ara ara Drive'a kopyalayın (kılavuz §9).

TR_var ayar = TR_command_line({"step": 200, "koşu": "runs/kontrol_noktasi_ornegi", "her_dakika": 5.0, "lr": 0.01},
    TR_description: "Küçük bir dil modelini kontrol noktasıyla eğitir; kesilirse aynı komutla sürer",
    TR_descriptions: {"step": "toplam eğitim adımı", "koşu": "koşu klasörü (ayarlar, günlük, ağırlıklar, kontrol noktaları)",
        "her_dakika": "kontrol noktası aralığı (dakika)"})
TR_const KOŞU = ayar["koşu"]

# --- Veri ve model (examples/tr/39_veri_ile_egitim.tr'deki küçük model) ---
TR_var p = TR_load_tokenizer("../../tests/data/tokenizer.json")
TR_var V = p.TR_vocab_size
TR_var ö = TR_Dataset("../../tests/data/text").TR_sampler(TR_batch_size: 8, TR_context: 32, TR_seed: 1)
TR_var parametre_tohumu = 0
TR_func parametre(şekil, ölçek) {
    parametre_tohumu += 1
    TR_return TR_Tensor(TR_no_grad(TR_randn(şekil, TR_seed: parametre_tohumu) * ölçek), TR_requires_grad: TR_true)
}
TR_var model = {"E": parametre([V, 32], 0.1), "W1": parametre([32, 64], 0.1), "W2": parametre([64, V], 0.1)}
TR_func ileri(giriş) {
    TR_return TR_gelu(TR_embedding_lookup(model["E"], giriş) @ model["W1"]) @ model["W2"]
}
TR_var op = TR_AdamW(TR_parameters(model), TR_lr: ayar["lr"], TR_weight_decay: 0.0)

# --- Koşu klasörü: ayarlar, günlük ve kontrol noktası ---
TR_make_dir(KOŞU)
TR_write_file(TR_Path(KOŞU, "config.json"), TR_json_string(ayar))
TR_var g = TR_Logger(TR_Path(KOŞU, "metrics.jsonl"))
TR_var izlenen = {"en_iyi_kayıp": 99.0}
# Sözlükteki her şey kaydedilir; klasörde bir nokta varsa burada yüklenir.
TR_var kn = TR_Checkpoint(KOŞU, {"model": model, "op": op, "ö": ö, "g": g, "izlenen": izlenen}, TR_every_minutes: ayar["her_dakika"], TR_keep: 3)
TR_print(TR_Type(kn) == TR_Checkpoint)

# --- Eğitim: döngü kaldığı adımdan başlar ---
TR_if kn.TR_resume_step < ayar["step"] {
    TR_var ç = TR_Progress(ayar["step"], TR_log: g)
    TR_for adım TR_in kn.TR_resume_step..ayar["step"] {
        TR_var giriş, hedef = ö.TR_next()
        op.TR_zero_grad()
        TR_var kayıp = TR_cross_entropy(ileri(giriş), hedef)
        TR_backward(kayıp)
        op.TR_step()
        TR_if kayıp.TR_tolist < izlenen["en_iyi_kayıp"] { izlenen["en_iyi_kayıp"] = kayıp.TR_tolist }
        ç.TR_update({"loss": kayıp}, TR_step: adım + 1)
        kn.TR_update(adım + 1) # her_dakika dolunca ve Ctrl+C gelince burada kaydeder
    }
    TR_print("son nokta:", kn.TR_save())
} TR_else {
    TR_print("Eğitim zaten \(kn.TR_resume_step). adımda bitmiş; uzatmak için --adım ile daha büyük bir sayı verin")
}

# --- Sonuçlar koşu klasörüne ---
TR_save_tensors(TR_Path(KOŞU, "model.trt"), TR_parameters(model, TR_named: TR_true))
TR_var son_adım = TR_if kn.TR_resume_step < ayar["step"] { ayar["step"] } TR_else { kn.TR_resume_step }
TR_write_file(TR_Path(KOŞU, "results.json"), TR_json_string({"step": son_adım, "en_iyi_kayıp": izlenen["en_iyi_kayıp"]}))
TR_print("en iyi kayıp: \(TR_round(izlenen["en_iyi_kayıp"], 3)); koşu klasörü: \(TR_Path(KOŞU).TR_absolute)")

# --- Kendin dene ---
# 1. --adım 100 ile çalıştır, sonra --adım 200 ile tekrar çalıştır: eğitim 100'den mi başlıyor?
# 2. izlenen sözlüğüne kendi sayacını ekle ve devamdan sonra da korunduğunu gör.
