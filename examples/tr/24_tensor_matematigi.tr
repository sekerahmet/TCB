# TR 4
# 24 — Tensör matematiği: işlemleri bir tensörün her elemanına uygulamak.
# Ne öğretir: exp, log, sin gibi matematik fonksiyonlarının tensörde eleman bazlı çalışması,
# silu ve log_softmax, toplam/ortalama ile eksen boyunca indirgeme ve boyutu_koru.
# Önceki örnekten: tensörler (23), matematik (13).
# Çalıştırma (proje kökünden): trlang examples/tr/24_tensor_matematigi.tr
# Ayrıntılar: docs/spec/15_tensorler.md §15.

# 13'te sayılara uyguladığımız fonksiyonlar tensörde her elemana ayrı ayrı uygulanır.
# Sonuç yeni bir tensördür; .değer onu TR listesine çevirir.
TR_var x = TR_Tensor([0.0, 1.0, 2.0])
TR_print("exp:", TR_exp(x).TR_tolist)
TR_print("log:", TR_log(x + 1).TR_tolist)
TR_print("sin:", TR_sin(x).TR_tolist, "cos:", TR_cos(x).TR_tolist)
TR_print("tan:", TR_tan(TR_Tensor([0.0, 1.0])).TR_tolist)
TR_print("asin:", TR_asin(TR_Tensor([0.0, 0.5])).TR_tolist, "acos:", TR_acos(TR_Tensor([1.0, -1.0])).TR_tolist)
TR_print("atan:", TR_atan(TR_Tensor([0.0, 1.0])).TR_tolist)
TR_print("atan2:", TR_atan2(TR_Tensor([1.0, -1.0]), TR_Tensor([0.0])).TR_tolist) # yayınlama: (y, x) çiftleri
TR_print("sinh/cosh:", TR_sinh(TR_Tensor([0.0, 1.0])).TR_tolist, TR_cosh(TR_Tensor([0.0, 1.0])).TR_tolist)
TR_print("log2/log10:", TR_log2(TR_Tensor([1.0, 1024.0])).TR_tolist, TR_log10(TR_Tensor([1.0, 100.0])).TR_tolist)
TR_print("küçük sayıda hassas log ve üstel:", TR_log1p(TR_Tensor([0.0, 1.0])).TR_tolist, TR_expm1(TR_Tensor([0.0, 1.0])).TR_tolist)

# Etkinleştirme fonksiyonları: silu x · sigmoid(x) hesaplar; log_softmax softmax'ın logaritmasını
# sayısal olarak kararlı biçimde verir.
TR_print("silu:", TR_silu(TR_Tensor([-1.0, 0.0, 2.0])).TR_tolist)
TR_print("log_softmax:", TR_log_softmax(TR_Tensor([1.0, 2.0, 3.0])).TR_tolist)

# Eksen boyunca indirgeme: eksen: -1 son eksen demektir.
# boyutu_koru: doğru indirgenen ekseni 1 uzunlukta tutar; sonuç girdiye yayınlanabilir.
TR_var m = TR_Tensor([[1.0, 2.0], [3.0, 4.0]])
TR_print(TR_sum(m, TR_dim: -1).TR_shape, TR_sum(m, TR_dim: -1, TR_keepdim: TR_true).TR_shape)
TR_print(TR_sum(m, TR_dim: 0).TR_tolist, TR_mean(m, TR_dim: -1).TR_tolist)

# öğe öğe en büyük ve en küçük iki tensörü (ya da tensörle sayıyı) karşılaştırır; hepsi yakın
# ondalık tensörleri bir payla karşılaştırır: yuvarlama farkı eşitliği bozmaz.
TR_var a = TR_Tensor([1.0, 5.0, -2.0])
TR_var b = TR_Tensor([3.0, 2.0, -2.0])
TR_print(TR_maximum(a, b).TR_tolist, TR_minimum(a, 0.0).TR_tolist)
TR_print(TR_all_close(a, a + 0.0000001), TR_all_close(a, b, TR_rtol: 0.1, TR_atol: 3.0))

# --- Kendin dene ---
# 1. tensör([[1.0, 2.0], [3.0, 4.0]]) için softmax'ı satır boyunca hesapla ve her satırın toplamının 1 olduğunu göster.
# 2. m - ortalama(m, eksen: -1, boyutu_koru: doğru) ile satır ortalamasını çıkar (yayınlama).
