# TR 4
# 44 — Eğitimin kararlılığı: NaN'i ve kayıp sıçramasını yakalamak, son kontrol noktasına dönmek.
# Ne öğretir: sonlu_mu (sayı ve tensörde), gradyan_kırp(..., sonlu_değilse_hata:), kn.geri_dön(),
# ö.atla(n) ve kitaplığın sıçrama bekçisi (aktar "tr/training": SıçramaBekçisi, TAMAM, SONLU_DEĞİL, SIÇRAMA).
# Uzun bir eğitim bir gün bozuk bir gradyanla NaN'e düşer ya da kaybı birden sıçrar; bu örnek bunu
# bilerek bir kez yapar ve eğitimin son sağlam noktadan, sorunlu toplu işleri atlayarak sürdüğünü gösterir.
# Önceki örnekten: kontrol noktası (40), hazır kitaplık (41).
# Ayrıntılar: docs/spec/15_tensorler.md §15.36, docs/spec/20_kontrol_noktasi.md §20.14–20.15.
#
# Çalıştırma (proje kökünden): tr examples/tr/44_egitim_kararliligi.tr

TR_import "tr/training"

# --- sonlu_mu: NaN ve sonsuz "sonlu değil"dir ---
TR_print(TR_is_finite(2.5), TR_is_finite(TR_Float("nan")), TR_is_finite(TR_Float("inf")))
TR_print(TR_is_finite(TR_Tensor([1.0, TR_Float("nan"), -TR_Float("inf")])).TR_tolist) # eleman bazlı: [1.0, 0.0, 0.0]

# --- Küçük model ve veri (40. örnekteki model) ---
TR_var p = TR_load_tokenizer("../../tests/data/tokenizer.json")
TR_var V = p.TR_vocab_size
TR_var ö = TR_Dataset("../../tests/data/text").TR_sampler(TR_batch_size: 8, TR_context: 32, TR_seed: 1)
TR_var parametre_tohumu = 0
TR_func parametre(şekil: TR_List[TR_Int], ölçek: TR_Float) -> TR_Tensor {
    parametre_tohumu += 1
    TR_return TR_Tensor(TR_no_grad(TR_randn(şekil, TR_seed: parametre_tohumu) * ölçek), TR_requires_grad: TR_true)
}
TR_var model = {"E": parametre([V, 32], 0.1), "W1": parametre([32, 64], 0.1), "W2": parametre([64, V], 0.1)}
TR_func ileri(giriş: TR_Tensor[TR_Int]) -> TR_Tensor {
    TR_return TR_gelu(TR_embedding_lookup(model["E"], giriş) @ model["W1"]) @ model["W2"]
}
TR_var op = TR_AdamW(TR_parameters(model), TR_lr: 0.01, TR_weight_decay: 0.0)

# --- gradyan_kırp: normu hep verir; sonlu_değilse_hata ile bozuk gradyanda hata da verebilir ---
TR_var ilk_giriş, ilk_hedef = ö.TR_next()
TR_backward(TR_cross_entropy(ileri(ilk_giriş), ilk_hedef) * TR_Float("nan"))
TR_try {
    TR_clip_grad(TR_parameters(model), TR_max: 1.0, TR_error_if_nonfinite: TR_true)
} TR_catch h {
    TR_print("gradyan bozuk, adım atılmadı")
}
op.TR_zero_grad() # bozuk gradyanlar silinir, model değişmedi

# --- Eğitim: her 10 adımda bir kontrol noktası, bekçi her adımı izler ---
# Koşu klasörü her çalıştırmada silinir: örnek her seferinde baştan başlar.
TR_const KOŞU = TR_Path("runs/kararlilik_ornegi")
TR_if KOŞU.TR_exists { TR_remove(KOŞU, TR_recursive: TR_true) }
TR_var kn = TR_Checkpoint(KOŞU, {"model": model, "op": op, "ö": ö}, TR_every_minutes: 0)
TR_var bekçi = TR_SpikeGuard(TR_history_limit: 20, TR_threshold: 6.0)
TR_const TOPLAM = 60
TR_var bozulacak_adım = 35 # bu adımda kayıp bilerek bir kez NaN olur
TR_var adım = 0
TR_for adım < TOPLAM {
    TR_var giriş, hedef = ö.TR_next()
    op.TR_zero_grad()
    TR_var kayıp = TR_cross_entropy(ileri(giriş), hedef)
    TR_if adım == bozulacak_adım {
        kayıp = kayıp * TR_Float("nan")
        bozulacak_adım = -1
    }
    TR_backward(kayıp)
    TR_var norm = TR_clip_grad(TR_parameters(model), TR_max: 1.0)
    TR_var karar = bekçi.TR_observe(kayıp.TR_tolist, norm.TR_tolist)
    TR_if karar != TR_OK {
        # Bozuk ya da sıçrayan adım uygulanmaz: son sağlam noktaya dönülür, sorunlu toplu işler atlanır.
        TR_print("adım \(adım + 1): \(karar)")
        adım = kn.TR_rollback()
        TR_print("  \(adım). adıma dönüldü, \(ö.TR_skip(3)) toplu iş atlandı")
        TR_continue
    }
    op.TR_step()
    adım += 1
    TR_if adım % 10 == 0 {
        kn.TR_update(adım)
        TR_print("adım \(adım): kayıp \(TR_round(kayıp.TR_tolist, 3))")
    }
}
TR_print("model sağlam mı:", TR_is_finite(TR_sum(model["W2"]).TR_tolist), "| sıçrama sayısı:", bekçi.TR_spike_count)

# --- Kendin dene ---
# 1. bozulacak_adım'ı 5 yap: henüz kontrol noktası yokken geri_dön ne der?
# 2. eşik'i 2.0'a indir: bekçi olağan gürültüyü de sıçrama sayar mı?
# 3. Bekçiyi op.adım()'dan sonra çağır: NaN artık modele girer; geri_dön onu yine kurtarır mı?
