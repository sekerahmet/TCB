// 04 — Fonksiyonlar: işi adlandırıp yeniden kullanmak.
// Öğrettikleri: fonksiyon ve sonuç, tip bildirimi, varsayılan değer, adlı argüman, birden
// çok sonuç, ok fonksiyonu, kendini çağıran (özyinelemeli) fonksiyon, sondaki blok.
// Önceki örnek: 03. Sonraki: 05 (listeler ve sözlükler).
// Çalıştırma (proje kökünden): tr examples/tr/04_fonksiyonlar.tr

fonksiyon topla(a: Tam, b: Tam) -> Tam {
    sonuç a + b
}
yazdır(topla(2, 3))

// varsayılan değer ve adlı argüman
fonksiyon selam(ad, ek = "!") {
    sonuç "Selam {ad}{ek}"
}
yazdır(selam("Ayşe"), selam(ek: "?", ad: "Ali"))

// birden çok sonuç liste olarak döner; çoklu atamayla açılır
fonksiyon bölüm_ve_kalan(a, b) {
    sonuç [a / b, a % b]
}
değişken bölüm, kalan = bölüm_ve_kalan(17, 5)
yazdır("17 / 5 = {bölüm}, kalan {kalan}")

// kendini çağıran fonksiyon
fonksiyon faktöriyel(n) {
    eğer n <= 1 { sonuç 1 }
    sonuç n * faktöriyel(n - 1)
}
yazdır("5! = {faktöriyel(5)}, 10! = {faktöriyel(10)}")

// fonksiyon bir değerdir: ok fonksiyonu, parametre olarak geçirilir
değişken iki_katı = (x) => x * 2
fonksiyon uygula(f, değer) {
    sonuç f(değer)
}
yazdır(uygula(iki_katı, 21))

// sondaki blok: son parametre fonksiyonsa süslü parantezle yazılır; o = sıradaki eleman
yazdır([1, 2, 3, 4].haritala { o * 10 })
