// 28 — Hazır katmanlarla GPT: dilin kitaplığındaki katmanlar ve iyileştiricilerle küçük bir dil modeli.
// Ne öğretir: `aktar "tr/katman"` ile GPT kurmak, gizli ağırlıkları Muon'a öbürlerini AdamW'ye vermek
// (MuonVeAdamW), ısınma–sabit–azalma öğrenme oranı planı, kontrol noktasıyla sürdürmek, metin üretmek.
// Önceki örnekten: kontrol noktası (27) ve transformer (24): 24'te elle yazılanın kitaplık karşılığı.
// Kitaplığın kodu: lib/katman.tr ve lib/iyilestirici.tr (kopyalayıp değiştirebilirsiniz).
// Ayrıntılar: docs/guide/10_hazir_katmanlarla_gpt.md, lib/README.md.
//
// Çalıştırma (proje kökünden): tr examples/tr/28_gpt.tr
//   Ayarlar komut satırından: tr examples/tr/28_gpt.tr --adım 300 --boyut 64 --koşu runs/gpt2
//   Yarıda kesilirse (Ctrl+C) aynı komut kaldığı yerden sürer; baştan başlamak için koşu
//   klasörünü silin ya da başka bir --koşu verin.
// GPU'da: model kurulmadan önce varsayılan cihazı seçin (aşağıdaki satırın yorumunu kaldırın)
// ve ayarları büyütün, ör. --boyut 512 --katman 8 --baş 8 --bağlam 512 --toplu 64.
// varsayılan_cihaz("gpu")

aktar "tr/katman"
aktar "tr/iyilestirici"

değişken ayar = komut_satırı({adım: 100, toplu: 8, bağlam: 32, boyut: 32, katman: 2, baş: 4,
        muon_oranı: 0.02, adamw_oranı: 0.01, normuon: yanlış, koşu: "runs/gpt_ornegi"},
    açıklama: "Hazır katmanlarla küçük bir GPT'yi Muon + AdamW ile eğitir",
    açıklamalar: {adım: "toplam eğitim adımı", koşu: "koşu klasörü (ayarlar, günlük, kontrol noktaları)",
        normuon: "gizli ağırlıklar için Muon yerine NorMuon"})

// --- Veri: depodaki sentetik metin ve parçalayıcısı (kendi veriniz için examples/tr/26_veri_ile_egitim.tr) ---
değişken p = parçalayıcı_yükle("../../tests/data/tokenizer.json")
değişken ö = veri_kümesi("../../tests/data/text").örnekleyici(toplu: ayar.toplu, bağlam: ayar.bağlam, tohum: 1)

// --- Model ve iyileştirici ---
değişken model = GPT(p.dağarcık_boyutu, bağlam: ayar.bağlam, boyut: ayar.boyut, katman: ayar.katman,
    baş: ayar.baş, paylaşımlı: doğru, tohum: 1)
değişken op = MuonVeAdamW(model, muon_oranı: ayar.muon_oranı, adamw_oranı: ayar.adamw_oranı, normuon: ayar.normuon)
yazdır("model: {parametreler(model).uzunluk} ağırlık tensörü; Muon'da {op.muon.ağırlıklar.uzunluk}, AdamW'de {op.diğer.uzunluk}")

// --- Koşu klasörü ve kontrol noktası: model, AdamW'nin ve Muon'un durumu, okuyucu, günlük ---
klasör_oluştur(ayar.koşu)
dosya_yaz(yol(ayar.koşu, "config.json"), json_metin(ayar))
değişken g = günlük(yol(ayar.koşu, "metrics.jsonl"))
değişken kn = kontrol_noktası(ayar.koşu, {model: model, adamw: op.adamw, muon: op.muon.durum, ö: ö, g: g}, her_dakika: 5)

// --- Eğitim: ilk %10 ısınma, son %30 azalma ---
eğer kn.kaldığı_adım < ayar.adım {
    değişken ç = ilerleme(ayar.adım, günlük: g)
    döngü adım içinde kn.kaldığı_adım..ayar.adım {
        op.çarpan_ayarla(oran_planı(adım, ayar.adım, ısınma: tam(ayar.adım / 10), azalma: 0.3))
        değişken giriş, hedef = ö.sonraki()
        op.sıfırla()
        değişken kayıp = model.kayıp(giriş, hedef)
        geri_yayılım(kayıp)
        op.adım()
        ç.güncelle({kayıp: kayıp}, adım: adım + 1)
        kn.güncelle(adım + 1)
    }
    kn.kaydet()
}

// --- Doğrulama kaybı ve metin üretimi ---
değişken doğrulama = veri_kümesi("../../tests/data/text").sıralı(toplu: ayar.toplu, bağlam: ayar.bağlam)
değişken toplam_kayıp = 0.0
değişken sayı = 0
türevsiz {
    döngü {
        değişken iş = doğrulama.sonraki()
        eğer iş == yok veya sayı == 10 { çık }
        toplam_kayıp += model.kayıp(iş[0], iş[1]).değer
        sayı += 1
    }
}
yazdır("doğrulama kaybı ({sayı} toplu iş): {yuvarla(toplam_kayıp / sayı, 3)}")
değişken üretilen = model.üret(p.kodla("Bugün"), 12, sıcaklık: 0.8, en_iyi_k: 20, tohum: 1)
yazdır("model şunu yazdı: {p.çöz(üretilen)}")

// --- Kendin dene ---
// 1. --katman 4 --boyut 64 ile çalıştır: doğrulama kaybı nasıl değişiyor?
// 2. üret'in sıcaklık değerini 0.2 ve 1.5 yap ve metnin değişimine bak.
