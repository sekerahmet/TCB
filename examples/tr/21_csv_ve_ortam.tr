# TR 4
# 21 — CSV, ortam değişkenleri ve zaman: dış dünyadan veri almak.
# Ne öğretir: csv_çöz ve csv_oku ile tablo okumak, ortam_değişkeni ile ortamdan ayar almak,
# zaman_ms ile zaman damgası almak, tekdüze_ns ile süre ölçmek.
# Önceki örnekten: dosya ve JSON (19), yollar (20), listeler (09), yok ve ?? (03).
# Çalıştırma (proje kökünden): trlang examples/tr/21_csv_ve_ortam.tr
# CSV dosyası geçici klasöre yazılır (program bitince silinir).

# csv_çöz CSV metnini satır listelerine çevirir (dosya okumaz). Hücre hep Metin'dir ("007" gibi baştaki
# sıfırlı numara bozulmaz); sayı gerekirse Tam(hücre) ile çevrilir.
TR_var tablo = TR_parse_csv("ad,yaş,numara\nAli,30,007\nAyşe,25,008")
TR_print(tablo[0], tablo[1])
TR_print(TR_Int(tablo[1][1]) + 1, TR_Type(tablo[1][1]), TR_Type(tablo[1][2]))

# csv_oku aynı işi dosya için yapar.
TR_var dosya = TR_Path(TR_temp_dir(), "tablo.csv")
TR_write_file(dosya, "ürün,adet\nelma,3\nmuz,5")
TR_var satırlar = TR_read_csv(dosya)
TR_print("satır sayısı:", satırlar.TR_length)
TR_for satır TR_in satırlar {
    TR_print(satır)
}
# İlk satır başlıktır; veri satırlarının adedini Tam'a çevirip toplarız.
TR_print("toplam adet:", TR_sum([TR_Int(satır[1]) TR_for satır TR_in satırlar[1..satırlar.TR_length]]))

# ortam_değişkeni tanımsızsa yok verir; varsayılan için ?? yazılır.
TR_print(TR_env("TR_ORNEK_OLMAYAN_DEGISKEN") ?? "varsayılan değer")

# zaman_ms duvar saatidir (1970'ten beri geçen milisaniye): kayıt ve zaman damgası içindir,
# saat düzeltilince geri gidebilir.
TR_print("zaman damgası 2020'den sonra mı:", TR_time_ms() > 1_577_836_800_000)

# Süre tekdüze_ns ile ölçülür: tekdüze saat geri gitmez; iki ölçümün farkı nanosaniye süredir.
TR_var baş = TR_monotonic_ns()
TR_sleep(0.05)
TR_print("en az 50 ms geçti mi:", TR_monotonic_ns() - baş >= 50_000_000)

# --- Kendin dene ---
# 1. Kendi CSV metnini çöz ve yaş sütununun ortalamasını hesapla.
# 2. Bir döngünün kaç ms sürdüğünü tekdüze_ns ile ölç (1 ms = 1 000 000 ns).
