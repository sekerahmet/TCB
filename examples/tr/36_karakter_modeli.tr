# TR 4
# 36 — Karakter modeli: gerçek metinle eğitilen küçük bir dil modeli (~100 bin parametre).
# Ne öğretir: metinden karakter sözlüğü kurmak, katman listesiyle derin (2 katmanlı) model, parametre
# sayımı, argmax ile açgözlü metin üretimi. Aynı modelin başka dildeki hız kıyası: tools/bench/README.md.
# Önceki örnekten: transformer (35), sözlükler (11), dosya okuma (19).
# Veri: TR'nin kendi Türkçe belgeleri. Model bir sonraki karakteri tahmin etmeyi öğrenir.
# Çalıştırma (proje kökünden): tr examples/tr/36_karakter_modeli.tr

TR_const ADIM = 300
# Eğitim metni: kullanım kılavuzunun ve dil tanımının bölümleri, sırasıyla.
TR_const BELGELER = [
    "docs/guide/01_baslangic.md", "docs/guide/02_anahtar_kelimeler.md",
    "docs/guide/03_zincirleme_metotlar.md", "docs/guide/04_yapay_zeka_ve_veri.md",
    "docs/guide/05_hata_ayiklayici.md", "docs/guide/06_vscode_kisayollari.md",
    "docs/guide/07_testler.md", "docs/guide/08_bicimlendirme.md",
    "docs/spec/01_program.md", "docs/spec/02_sozcuk_yapisi.md", "docs/spec/03_tipler.md",
    "docs/spec/04_operatorler.md", "docs/spec/05_deyimler.md", "docs/spec/06_fonksiyonlar.md",
    "docs/spec/07_yapilar.md", "docs/spec/08_hata_yonetimi.md", "docs/spec/09_ertele.md",
    "docs/spec/10_eszamanlilik.md", "docs/spec/11_moduller.md", "docs/spec/12_testler.md",
    "docs/spec/13_yerlesikler.md", "docs/spec/15_tensorler.md",
    "docs/spec/16_veri_parcalayici.md", "docs/spec/17_kodlar.md"
]
TR_var metin_verisi = ""
TR_for belge_yolu TR_in BELGELER {
    metin_verisi += TR_read_file("../../" + belge_yolu)
}

# --- Karakter sözlüğü ---
TR_var harfler = []
TR_var harf_no = {}
TR_var veri = []
TR_for h TR_in metin_verisi {
    TR_if TR_not harf_no.TR_contains(h) {
        harf_no[h] = harfler.TR_length
        harfler.TR_append(h)
    }
    veri.TR_append(harf_no[h])
}

TR_var V = harfler.TR_length # sözlük boyutu
TR_var T = 64 # bağlam uzunluğu
TR_var D = 64 # gizli boyut
TR_var H = 4 # dikkat bakışı
TR_var Dh = 16 # bakış boyutu
TR_var B = 16 # toplu iş boyutu
TR_const KATMAN = 2

# --- Parametreler ---
TR_var parametre_tohumu = 1
TR_var ağırlıklar = []
TR_func parametre(şekil, ölçek) {
    parametre_tohumu += 1
    TR_var p = TR_Tensor(TR_no_grad(TR_randn(şekil, TR_seed: parametre_tohumu) * ölçek), TR_requires_grad: TR_true)
    ağırlıklar.TR_append(p)
    TR_return p
}
TR_func sabit_parametre(şekil, değer) {
    TR_var p = TR_Tensor(TR_ones(şekil) * değer, TR_requires_grad: TR_true)
    ağırlıklar.TR_append(p)
    TR_return p
}

TR_var E = parametre([V, D], 0.1)
TR_var P = parametre([T, D], 0.1)
TR_var katmanlar = []
TR_for k TR_in 0..KATMAN {
    katmanlar.TR_append({
        "Wq": parametre([D, D], 0.1), "Wk": parametre([D, D], 0.1), "Wv": parametre([D, D], 0.1),
        "Wo": parametre([D, D], 0.1), "W1": parametre([D, 4 * D], 0.1), "W2": parametre([4 * D, D], 0.05),
        "g1": sabit_parametre([D], 1.0), "s1": sabit_parametre([D], 0.0),
        "g2": sabit_parametre([D], 1.0), "s2": sabit_parametre([D], 0.0)
    })
}
TR_var gs = sabit_parametre([D], 1.0)
TR_var ss = sabit_parametre([D], 0.0)
TR_var Wu = parametre([D, V], 0.1)

TR_var toplam_parametre = 0
TR_for p TR_in ağırlıklar { toplam_parametre += p.TR_shape.TR_reduce(1, (acc, x) => acc * x) } # şeklin boyutlarının çarpımı
TR_print("veri: \(veri.TR_length) karakter, sözlük: \(V) karakter, parametre: \(toplam_parametre)")

# --- Model ---
TR_var konumlar = TR_List(0..T)

TR_func ileri(girdiler, b) {
    TR_var x = TR_embedding_lookup(E, girdiler) + TR_embedding_lookup(P, konumlar)
    TR_for L TR_in katmanlar {
        # Ön normalizasyonlu blok: dikkat, ardından ileri besleme
        TR_var a = TR_layer_norm(x, L["g1"], L["s1"])
        TR_var q = (a @ L["Wq"]).TR_reshape([b, T, H, Dh])
        TR_var k = (a @ L["Wk"]).TR_reshape([b, T, H, Dh])
        TR_var v = (a @ L["Wv"]).TR_reshape([b, T, H, Dh])
        # Nedensel dikkat, ölçek 1/√Dh = 0.25 (softmax(q·kᵀ·0.25 + nedensel maske) · v ile aynı)
        TR_var y = TR_attention(q, k, v).TR_reshape([b, T, D])
        x = x + y @ L["Wo"]
        TR_var m = TR_layer_norm(x, L["g2"], L["s2"])
        x = x + TR_gelu(m @ L["W1"]) @ L["W2"]
    }
    TR_return TR_layer_norm(x, gs, ss) @ Wu
}

# --- Veri örnekleme (tekrar üretilebilir) ---
TR_var tohum = 12345
TR_func rastgele_tam(n) {
    tohum = (tohum * 1103515245 + 12345) % 2147483648
    TR_return tohum % n
}
TR_func toplu_iş() {
    TR_var girdiler = []
    TR_var hedefler = []
    TR_for b TR_in 0..B {
        TR_var baş = rastgele_tam(veri.TR_length - T - 1)
        TR_var satır = []
        TR_for t TR_in 0..T {
            satır.TR_append(veri[baş + t])
            hedefler.TR_append(veri[baş + t + 1])
        }
        girdiler.TR_append(satır)
    }
    TR_return [girdiler, hedefler]
}

# --- Eğitim ---
TR_var iyileştirici = TR_AdamW(ağırlıklar, TR_lr: 0.003, TR_weight_decay: 0.0)
TR_for adım TR_in 0..ADIM {
    TR_var tb = toplu_iş()
    iyileştirici.TR_zero_grad()
    TR_var kayıp = TR_cross_entropy(ileri(tb[0], B), tb[1])
    TR_backward(kayıp)
    iyileştirici.TR_step()
    TR_if adım % 50 == 0 TR_or adım == ADIM - 1 {
        TR_print("adım \(adım): kayıp = \(TR_round(kayıp.TR_tolist, 4))")
    }
}

# --- Metin üretimi (her adımda en olası karakter) ---
TR_var bağlam = []
TR_for t TR_in 0..T { bağlam.TR_append(veri[t]) }
TR_var üretilen = ""
TR_no_grad {
    TR_for n TR_in 0..120 {
        TR_var en_iyi = TR_argmax(ileri([bağlam], 1), TR_dim: -1).TR_tolist[0][T - 1]
        üretilen = üretilen + harfler[en_iyi]
        bağlam = bağlam[1..T] + [en_iyi] # pencereyi bir kaydır
    }
}
TR_print("model şunu yazdı: \(üretilen)")

# --- Kendin dene ---
# 1. ADIM'ı 300'den 600'e çıkar: üretilen metin nasıl değişiyor?
# 2. BELGELER listesinden birkaç dosya çıkar ve kayıpla üretilen metne etkisine bak.
