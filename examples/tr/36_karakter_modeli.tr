// 36 — Karakter modeli: gerçek metinle eğitilen küçük bir dil modeli (~100 bin parametre).
// Ne öğretir: metinden karakter sözlüğü kurmak, katman listesiyle derin (2 katmanlı) model, parametre
// sayımı, maks_indeks ile açgözlü metin üretimi. Aynı modelin başka dildeki hız kıyası: tools/bench/README.md.
// Önceki örnekten: transformer (35), sözlükler (11), dosya okuma (19).
// Veri: TR'nin kendi Türkçe belgeleri. Model bir sonraki karakteri tahmin etmeyi öğrenir.
// Çalıştırma (proje kökünden): tr examples/tr/36_karakter_modeli.tr

değişken ADIM = 300
// Eğitim metni: kullanım kılavuzunun ve dil tanımının bölümleri, sırasıyla.
değişken BELGELER = [
    "docs/guide/01_baslangic.md", "docs/guide/02_anahtar_kelimeler.md",
    "docs/guide/03_zincirleme_metotlar.md", "docs/guide/04_yapay_zeka_ve_veri.md",
    "docs/guide/05_hata_ayiklayici.md", "docs/guide/06_vscode_kisayollari.md",
    "docs/guide/07_testler.md", "docs/guide/08_bicimlendirme.md",
    "docs/spec/01_program.md", "docs/spec/02_sozcuk_yapisi.md", "docs/spec/03_tipler.md",
    "docs/spec/04_operatorler.md", "docs/spec/05_deyimler.md", "docs/spec/06_fonksiyonlar.md",
    "docs/spec/07_yapilar.md", "docs/spec/08_hata_yonetimi.md", "docs/spec/09_ertele.md",
    "docs/spec/10_eszamanlilik.md", "docs/spec/11_moduller.md", "docs/spec/12_testler.md",
    "docs/spec/13_yerlesikler.md", "docs/spec/14_sinirlamalar.md", "docs/spec/15_tensorler.md",
    "docs/spec/16_veri_parcalayici.md", "docs/spec/17_kodlar.md"
]
değişken metin_verisi = ""
döngü belge_yolu içinde BELGELER {
    metin_verisi += dosya_oku("../../" + belge_yolu)
}

// --- Karakter sözlüğü ---
değişken harfler = []
değişken harf_no = {}
değişken veri = []
döngü h içinde metin_verisi {
    eğer harf_no[h] == yok {
        harf_no[h] = harfler.uzunluk
        harfler.ekle(h)
    }
    veri.ekle(harf_no[h])
}

değişken V = harfler.uzunluk // sözlük boyutu
değişken T = 64 // bağlam uzunluğu
değişken D = 64 // gizli boyut
değişken H = 4 // dikkat bakışı
değişken Dh = 16 // bakış boyutu
değişken B = 16 // toplu iş boyutu
değişken KATMAN = 2

// --- Parametreler ---
değişken parametre_tohumu = 1
değişken ağırlıklar = []
fonksiyon parametre(şekil, ölçek) {
    parametre_tohumu += 1
    değişken p = tensör(türevsiz(rastgele_normal(şekil, tohum: parametre_tohumu) * ölçek), türev_izle: doğru)
    ağırlıklar.ekle(p)
    sonuç p
}
fonksiyon sabit_parametre(şekil, değer) {
    değişken p = tensör(birler(şekil) * değer, türev_izle: doğru)
    ağırlıklar.ekle(p)
    sonuç p
}

değişken E = parametre([V, D], 0.1)
değişken P = parametre([T, D], 0.1)
değişken katmanlar = []
döngü k içinde 0..KATMAN {
    katmanlar.ekle({
        "Wq": parametre([D, D], 0.1), "Wk": parametre([D, D], 0.1), "Wv": parametre([D, D], 0.1),
        "Wo": parametre([D, D], 0.1), "W1": parametre([D, 4 * D], 0.1), "W2": parametre([4 * D, D], 0.05),
        "g1": sabit_parametre([D], 1.0), "s1": sabit_parametre([D], 0.0),
        "g2": sabit_parametre([D], 1.0), "s2": sabit_parametre([D], 0.0)
    })
}
değişken gs = sabit_parametre([D], 1.0)
değişken ss = sabit_parametre([D], 0.0)
değişken Wu = parametre([D, V], 0.1)

değişken toplam_parametre = 0
döngü p içinde ağırlıklar {
    değişken n = 1
    döngü boyut içinde p.şekil { n = n * boyut }
    toplam_parametre += n
}
yazdır("veri: {veri.uzunluk} karakter, sözlük: {V} karakter, parametre: {toplam_parametre}")

// --- Model ---
değişken konumlar = aralık(T)

fonksiyon ileri(girdiler, b) {
    değişken x = gömme(E, girdiler) + gömme(P, konumlar)
    döngü L içinde katmanlar {
        // Ön normalizasyonlu blok: dikkat, ardından ileri besleme
        değişken a = katman_normu(x, L["g1"], L["s1"])
        değişken q = (a @ L["Wq"]).şekillendir([b, T, H, Dh]).eksenleri_sırala([0, 2, 1, 3])
        değişken k = (a @ L["Wk"]).şekillendir([b, T, H, Dh]).eksenleri_sırala([0, 2, 1, 3])
        değişken v = (a @ L["Wv"]).şekillendir([b, T, H, Dh]).eksenleri_sırala([0, 2, 1, 3])
        // Nedensel dikkat, ölçek 1/√Dh = 0.25 (softmax(q·kᵀ·0.25 + nedensel maske) · v ile aynı)
        değişken y = dikkat(q, k, v).eksenleri_sırala([0, 2, 1, 3]).şekillendir([b, T, D])
        x = x + y @ L["Wo"]
        değişken m = katman_normu(x, L["g2"], L["s2"])
        x = x + gelu(m @ L["W1"]) @ L["W2"]
    }
    sonuç katman_normu(x, gs, ss) @ Wu
}

// --- Veri örnekleme (tekrar üretilebilir) ---
değişken tohum = 12345
fonksiyon rastgele_tam(n) {
    tohum = (tohum * 1103515245 + 12345) % 2147483648
    sonuç tohum % n
}
fonksiyon toplu_iş() {
    değişken girdiler = []
    değişken hedefler = []
    döngü b içinde 0..B {
        değişken baş = rastgele_tam(veri.uzunluk - T - 1)
        değişken satır = []
        döngü t içinde 0..T {
            satır.ekle(veri[baş + t])
            hedefler.ekle(veri[baş + t + 1])
        }
        girdiler.ekle(satır)
    }
    sonuç [girdiler, hedefler]
}

// --- Eğitim ---
değişken iyileştirici = AdamW(ağırlıklar, öğrenme_oranı: 0.003, ağırlık_çürümesi: 0.0)
döngü adım içinde 0..ADIM {
    değişken tb = toplu_iş()
    iyileştirici.sıfırla()
    değişken kayıp = çapraz_entropi(ileri(tb[0], B), tb[1])
    geri_yayılım(kayıp)
    iyileştirici.adım()
    eğer adım % 50 == 0 veya adım == ADIM - 1 {
        yazdır("adım {adım}: kayıp = {yuvarla(kayıp.değer, 4)}")
    }
}

// --- Metin üretimi (her adımda en olası karakter) ---
değişken bağlam = []
döngü t içinde 0..T { bağlam.ekle(veri[t]) }
değişken üretilen = ""
türevsiz {
    döngü n içinde 0..120 {
        değişken en_iyi = maks_indeks(ileri([bağlam], 1), eksen: -1).değer[0][T - 1]
        üretilen = üretilen + harfler[en_iyi]
        değişken yeni = []
        döngü t içinde 1..T { yeni.ekle(bağlam[t]) }
        yeni.ekle(en_iyi)
        bağlam = yeni
    }
}
yazdır("model şunu yazdı: {üretilen}")

// --- Kendin dene ---
// 1. ADIM'ı 300'den 600'e çıkar: üretilen metin nasıl değişiyor?
// 2. BELGELER listesinden birkaç dosya çıkar ve kayıpla üretilen metne etkisine bak.
