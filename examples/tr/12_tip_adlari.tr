//! tr kodlu 3 dil=tr
// 12 — Tip adları: değerlerin tipini sormak ve bildirmek.
// Ne öğretir: tip() ve tip adlarının (Mantık, Yok, Liste, Sözlük, Aralık, Fonksiyon,
// YerleşikFonksiyon, Herhangi, Tip) ifadede değer olması, ad: Tip ile tip bildirmek.
// Önceki örnekten: tipler (03), listeler (09), ok fonksiyonları (10), sözlükler (11).
// Çalıştırma (proje kökünden): tr examples/tr/12_tip_adlari.tr

// tip(değer) tipi verir; tip adları da ifadede değerdir, == ile karşılaştırılır.
TR_kw_var liste = [1, "iki", 3.0]
TR_fn_print(TR_fn_type(liste) == TR_type_List, TR_fn_type(liste))
TR_kw_var sözlük = {"ad": "Ali"}
TR_fn_print(TR_fn_type(sözlük) == TR_type_Dict, sözlük["ad"])
TR_fn_print(TR_fn_type(TR_kw_true) == TR_type_Bool, TR_fn_type(TR_kw_none) == TR_type_None)

// Aralık a..b (b hariç) ya da a..=b (b dahil) yazımının tipidir; aralık(n) ise bir Liste verir.
TR_fn_print(TR_fn_type(1..5) == TR_type_Range, TR_fn_type(TR_fn_range(5)) == TR_type_List, TR_fn_range(5))

// Fonksiyonlar birinci sınıf değerdir: ok fonksiyonu ve fonksiyon Fonksiyon,
// dilin kendi fonksiyonları YerleşikFonksiyon tipindedir.
TR_kw_var kare = x => x * x
TR_fn_print(TR_fn_type(kare) == TR_type_Function, TR_fn_type(TR_fn_print) == TR_type_BuiltinFunction, kare(7))

// Tip bildirimi: ad: Tip. Tip denetleyicisi yanlış atamayı program çalışmadan yakalar.
TR_kw_var hazır: TR_type_Bool = TR_kw_true
TR_kw_var boş: TR_type_None = TR_kw_none
TR_kw_var sayılar: TR_type_List = [1, 2, 3]
TR_fn_print(hazır, boş, sayılar)

// Herhangi: her değer verilebilir, tipi bilinmeyen değerler için kullanılır.
TR_kw_func kimlik(x: TR_type_Any) {
    TR_kw_return x
}
TR_fn_print(kimlik(5), kimlik("beş"), kimlik([1, 2]))

// tip() sonucunun kendi tipi de Tip'tir ve bir değişkende saklanabilir.
TR_kw_var t: TR_type_Type = TR_fn_type(42)
TR_fn_print(t == TR_type_Int, t, TR_fn_type(t))

// --- Kendin dene ---
// 1. tip(tip(1)) == Tip değerini yazdır.
// 2. Bir listedeki değerleri tip(x) == Tam ile süzerek yalnızca tam sayıları bırak.
