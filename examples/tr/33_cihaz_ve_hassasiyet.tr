//! tr kodlu 3 dil=tr
// 33 — Cihaz ve hassasiyet: tensörlerin nerede ve hangi sayı türüyle yaşadığı.
// Ne öğretir: cihazlar(), varsayılan_cihaz(), .cihaz ve .cihaza(), tür: / .tür / .türe(), karışık_hassasiyet, hesap_türü(),
// 16 bitlik parametrede ana_kopya.
// Önceki örnekten: tensörler (23), iyileştiriciler (29), ağırlıkları kaydetmek (32).
// Çalıştırma (proje kökünden): tr examples/tr/33_cihaz_ve_hassasiyet.tr
// Bu örnek her makinede CPU'da çalışır; GPU varsa "gpu" cihazı da seçilebilir.

// cihazlar() bu makinedeki cihaz adlarını verir; ilk eleman her zaman "cpu"dur.
TR_fn_print("ilk cihaz:", TR_fn_devices()[0], "| gpu var mı:", TR_fn_devices().TR_mem_contains("gpu"))

// varsayılan_cihaz() geçerli cihazı söyler; argümanla ("cpu", "gpu", "gpu:1") bundan sonra kurulan
// bütün tensörlerin cihazını seçer. GPU'da eğitim için model kurulmadan önce çağrılır.
TR_fn_print(TR_fn_default_device())
TR_fn_default_device("cpu")
TR_kw_var t = TR_fn_tensor([1.0, 2.0])
TR_fn_print(t.TR_mem_device, t.TR_mem_to_device("cpu").TR_mem_device) // cihaza tensörü başka cihaza taşır

// Sayı türü: "float32" (varsayılan), "bf16" ya da "fp16". Kurarken tür: ile seçilir, .tür ile okunur,
// .türe(...) ile çevrilir (gradyan kaynak tensöre akar).
TR_fn_print(t.TR_mem_dtype, TR_fn_zeros([2, 2], TR_arg_dtype: "fp16").TR_mem_dtype, t.TR_mem_to_dtype("bf16").TR_mem_dtype)

// karışık_hassasiyet(tür) { ... }: blokta @ girdileri bu türe çevrilir, hesap daha hızlı ve hafızada daha ucuz olur;
// ağırlıkların türü değişmez. Bloğun son ifadesi sonuç olur.
TR_kw_var y = TR_fn_mixed_precision("bf16") { TR_fn_tensor([[1.0, 2.0]]) @ TR_fn_tensor([[3.0], [4.0]]) }
TR_fn_print(y.TR_mem_tolist)
// hesap_türü() etkin bloğun hesap türünü verir (blok dışında "float32"). Çıktısını yalnızca
// çarpımlar okuyan bir normu doğrudan o türde yazmak için: rms_normu(x, w, tür: hesap_türü()).
TR_fn_print(TR_fn_compute_dtype(), TR_fn_mixed_precision("bf16") { TR_fn_compute_dtype() })

// 16 bitlik parametreyi AdamW ile eğitirken ana_kopya: doğru (varsayılan) float32 bir ana kopya tutar;
// güncelleme orada yapılıp parametreye yuvarlanır, böylece küçük adımlar kaybolmaz.
TR_kw_var w = TR_fn_tensor([1.0], TR_arg_requires_grad: TR_kw_true, TR_arg_dtype: "bf16")
TR_kw_var op = TR_fn_AdamW([w], TR_arg_master_weights: TR_kw_true)
TR_fn_backward(TR_fn_sum(w * w))
op.TR_mem_step()
TR_fn_print(w.TR_mem_dtype, TR_fn_round(w.TR_mem_tolist[0], 2))

// --- Kendin dene ---
// 1. Bir tensörü "fp16"ya çevir ve geri float32'ye al: değerde ne kaybolur?
// 2. cihazlar() sonucunu döngüyle gez ve her birini yazdır.
