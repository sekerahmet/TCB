# TR 4
# 48 — Eğitim koşusu: kayıt işlerini kitaplığa bırakmak, uzun koşudan önce prova yapmak.
# Ne öğretir: aktar "tr/egitim" ile Koşu: koşu klasörü, config.json, metrics.jsonl, ilerleme çubuğu ve kontrol
# noktası tek satırda; koşu.adım_bitti(adım, ölçüler), koşu.değerlendirildi(adım, ölçüler), koşu.bitir(model)
# (ağırlıklar her şeyden önce yazılır); prova: doğru ile aynı eğitimin PROVA_ADIMI adımlık denemesi. Döngü sizde kalır.
# Önceki örnekten: kontrol noktası (40): orada elle kurulan klasör, günlük ve çubuk burada Koşu'nun işidir;
# eğitimin kararlılığı (44): aynı kitaplık modülü.
# Ayrıntılar: lib/README.md (tr/egitim), docs/spec/20_kontrol_noktasi.md §20.
#
# Çalıştırma (proje kökünden): tr examples/tr/48_egitim_kosusu.tr

TR_import "tr/egitim"

# Koşu klasörü her çalıştırmada silinir: örnek her seferinde baştan başlar.
TR_const KOŞU = TR_Path("runs/kosu_ornegi")
TR_if KOŞU.TR_exists { TR_remove(KOŞU, TR_recursive: TR_true) }
TR_var ayar = {"step": 60, "lr": 0.01}

# --- Veri ve model (40. örnekteki küçük model) ---
TR_var p = TR_load_tokenizer("../../tests/data/tokenizer.json")
TR_var V = p.TR_vocab_size
TR_var doğrulama_girişi, doğrulama_hedefi = TR_Dataset("../../tests/data/text").TR_sampler(TR_batch_size: 8, TR_context: 32, TR_seed: 2).TR_next()

# eğit bir koşuyu baştan sona sürer; prova doğruysa aynı eğitim kısa bir denemedir.
TR_func eğit(prova) {
    TR_var ö = TR_Dataset("../../tests/data/text").TR_sampler(TR_batch_size: 8, TR_context: 32, TR_seed: 1)
    TR_var parametre_tohumu = 0
    TR_func parametre(şekil, ölçek) {
        parametre_tohumu += 1
        TR_return TR_Tensor(TR_no_grad(TR_randn(şekil, TR_seed: parametre_tohumu) * ölçek), TR_requires_grad: TR_true)
    }
    TR_var model = {"E": parametre([V, 32], 0.1), "W1": parametre([32, 64], 0.1), "W2": parametre([64, V], 0.1)}
    TR_func ileri(giriş) {
        TR_return TR_gelu(TR_embedding_lookup(model["E"], giriş) @ model["W1"]) @ model["W2"]
    }
    TR_var op = TR_AdamW(TR_parameters(model), TR_lr: ayar["lr"], TR_weight_decay: 0.0)
    # Sözlükteki her şey kontrol noktasına girer; klasörde bir nokta varsa burada yüklenir.
    TR_var koşu = TR_Run(KOŞU, ayar, {"model": model, "op": op, "ö": ö}, TR_num_steps: ayar["step"], TR_dry_run: prova)
    TR_for adım TR_in koşu.TR_resume_step..koşu.TR_last_step {
        TR_var giriş, hedef = ö.TR_next()
        op.TR_zero_grad()
        TR_var kayıp = TR_cross_entropy(ileri(giriş), hedef)
        TR_backward(kayıp)
        op.TR_step()
        # Kaybı okumak (GPU'da) beklemek demektir: ölçüler her adımda değil, 10 adımda bir verilir.
        koşu.TR_step_done(adım + 1, TR_if (adım + 1) % 10 == 0 { {"loss": kayıp.TR_tolist} } TR_else { TR_none })
        TR_if (adım + 1) % 30 == 0 {
            TR_var dk = TR_cross_entropy(ileri(doğrulama_girişi), doğrulama_hedefi).TR_tolist
            koşu.TR_evaluated(adım + 1, {"doğrulama_kaybı": dk})
            TR_print("adım \(adım + 1): doğrulama kaybı \(TR_round(dk, 3))")
        }
    }
    koşu.TR_finish(model)
    TR_return koşu
}

# --- Önce prova: geçici bir klasörde PROVA_ADIMI adım; koşu klasörüne dokunmaz ---
TR_print("prova \(TR_DRY_RUN_STEPS) adım sürer")
eğit(TR_true)
TR_print("prova koşu klasörünü açtı mı:", KOŞU.TR_exists)

# --- Asıl koşu ---
TR_var koşu = eğit(TR_false)
TR_for ad TR_in ["config.json", "metrics.jsonl", "model.trt"] {
    TR_print(ad, TR_Path(KOŞU, ad).TR_exists)
}
TR_print("ağırlıklar:", TR_load_tensors(TR_Path(KOŞU, "model.trt"))["W2"].TR_shape)

# --- Aynı koşu yeniden: bitmiş eğitim kaldığı adımdan (sondan) sürer, döngü bir şey yapmaz ---
TR_print("kaldığı adım:", eğit(TR_false).TR_resume_step)

# --- Kendin dene ---
# 1. ayar["step"]'i 1 yap: prova kaç adım sürer?
# 2. koşu.bitir(model) satırını silip örneği çalıştır: prova neyi söyler?
# 3. Asıl koşuyu 30. adımda Ctrl+C ile kes (önce silme satırını kaldır), sonra yeniden çalıştır: nereden sürer?
