# TR 4
# 41 — Hazır katmanlarla GPT: dilin kitaplığındaki katmanlar ve iyileştiricilerle küçük bir dil modeli.
# Ne öğretir: `aktar "tr/katman"` ile GPT kurmak, gizli ağırlıkları Muon'a öbürlerini AdamW'ye vermek
# (MuonVeAdamW), ısınma–sabit–azalma öğrenme oranı planı, kontrol noktasıyla sürdürmek, metin üretmek.
# Önceki örnekten: kontrol noktası (40) ve transformer (35): 35'te elle yazılanın kitaplık karşılığı.
# Kitaplığın kodu: lib/katman.tr ve lib/iyilestirici.tr (kopyalayıp değiştirebilirsiniz).
# Ayrıntılar: docs/guide/10_hazir_katmanlarla_gpt.md, lib/README.md.
#
# Çalıştırma (proje kökünden): tr examples/tr/41_gpt.tr
#   Ayarlar komut satırından: tr examples/tr/41_gpt.tr --step 300 --embed_dim 64 --koşu runs/gpt2
#   Yarıda kesilirse (Ctrl+C) aynı komut kaldığı yerden sürer; baştan başlamak için koşu
#   klasörünü silin ya da başka bir --koşu verin.
# GPU'da: model kurulmadan önce varsayılan cihazı seçin (aşağıdaki satırın yorumunu kaldırın)
# ve ayarları büyütün, ör. --embed_dim 512 --katman 8 --num_heads 8 --bağlam 512 --toplu 64.
# varsayılan_cihaz("gpu")

TR_import "tr/katman"
TR_import "tr/iyilestirici"

TR_var ayar = TR_command_line({"step": 100, "toplu": 8, "bağlam": 32, "embed_dim": 32, "katman": 2, "num_heads": 4,
    "muon_oranı": 0.02, "adamw_oranı": 0.01, "normuon": TR_false, "koşu": "runs/gpt_ornegi"},
    TR_description: "Hazır katmanlarla küçük bir GPT'yi Muon + AdamW ile eğitir",
    TR_descriptions: {"step": "toplam eğitim adımı", "koşu": "koşu klasörü (ayarlar, günlük, kontrol noktaları)",
        "normuon": "gizli ağırlıklar için Muon yerine NorMuon"})

# --- Veri: depodaki sentetik metin ve parçalayıcısı (kendi veriniz için examples/tr/39_veri_ile_egitim.tr) ---
TR_var p = TR_load_tokenizer("../../tests/data/tokenizer.json")
TR_var ö = TR_Dataset("../../tests/data/text").TR_sampler(TR_batch_size: ayar["toplu"], TR_context: ayar["bağlam"], TR_seed: 1)

# --- Model ve iyileştirici ---
TR_var model = TR_GPT(p.TR_vocab_size, TR_context: ayar["bağlam"], TR_embed_dim: ayar["embed_dim"], TR_num_layers: ayar["katman"],
    TR_num_heads: ayar["num_heads"], TR_tied: TR_true, TR_seed: 1)
TR_var op = TR_MuonAndAdamW(model, TR_muon_lr: ayar["muon_oranı"], TR_adamw_lr: ayar["adamw_oranı"], TR_normuon: ayar["normuon"])
TR_print("model: \(TR_parameters(model).TR_length) ağırlık tensörü; Muon'da \(op.TR_muon.TR_parameters.TR_length), AdamW'de \(op.TR_other.TR_length)")

# --- Koşu klasörü ve kontrol noktası: model, AdamW'nin ve Muon'un durumu, okuyucu, günlük ---
TR_make_dir(ayar["koşu"])
TR_write_file(TR_Path(ayar["koşu"], "config.json"), TR_json_string(ayar))
TR_var g = TR_Logger(TR_Path(ayar["koşu"], "metrics.jsonl"))
TR_var kn = TR_Checkpoint(ayar["koşu"], {"model": model, "adamw": op.TR_adamw, "muon": op.TR_muon.TR_state, "ö": ö, "g": g}, TR_every_minutes: 5)

# --- Eğitim: ilk %10 ısınma, son %30 azalma ---
TR_if kn.TR_resume_step < ayar["step"] {
    TR_var ç = TR_Progress(ayar["step"], TR_log: g)
    TR_for adım TR_in kn.TR_resume_step..ayar["step"] {
        op.TR_set_multiplier(TR_lr_schedule(adım, ayar["step"], TR_warmup: TR_Int(ayar["step"] // 10), TR_decay_fraction: 0.3))
        TR_var giriş, hedef = ö.TR_next()
        op.TR_zero_grad()
        TR_var kayıp = model.TR_loss(giriş, hedef)
        TR_backward(kayıp)
        op.TR_step()
        ç.TR_update({"loss": kayıp}, TR_step: adım + 1)
        kn.TR_update(adım + 1)
    }
    kn.TR_save()
}

# --- Doğrulama kaybı ve metin üretimi ---
TR_var doğrulama = TR_Dataset("../../tests/data/text").TR_sequential(TR_batch_size: ayar["toplu"], TR_context: ayar["bağlam"])
TR_var toplam_kayıp = 0.0
TR_var sayı = 0
TR_no_grad {
    TR_for iş TR_in doğrulama {
        TR_if sayı == 10 { TR_break }
        toplam_kayıp += model.TR_loss(iş[0], iş[1]).TR_tolist
        sayı += 1
    }
}
TR_print("doğrulama kaybı (\(sayı) toplu iş): \(TR_round(toplam_kayıp / sayı, 3))")
TR_var üretilen = model.TR_generate(p.TR_encode("Bugün"), 12, TR_temperature: 0.8, TR_top_k: 20, TR_seed: 1)
TR_print("model şunu yazdı: \(p.TR_decode(üretilen))")

# --- Kendin dene ---
# 1. --katman 4 --embed_dim 64 ile çalıştır: doğrulama kaybı nasıl değişiyor?
# 2. üret'in sıcaklık değerini 0.2 ve 1.5 yap ve metnin değişimine bak.
