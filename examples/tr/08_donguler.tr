// 08 — Döngüler: bir işi yinelemek.
// Ne öğretir: döngü ... içinde ile aralık gezmek (1..=5 sonu dahil, 1..5 sonu hariç), çık, devam,
// iken, iç içe döngü.
// Önceki örnekten: koşullar (06), metne değer yerleştirme (05), += (02).
// Çalıştırma (proje kökünden): tr examples/tr/08_donguler.tr

// döngü i içinde aralık: i sırayla aralığın her değerini alır.
döngü i içinde 1..=5 {
    yazdır("tur {i}")
}
yazdır("sonu hariç:")
döngü i içinde 1..5 {
    yazdır(i)
}

// Birikim: döngü boyunca bir değişkeni güncelleyerek toplamak.
değişken birikmiş = 0
döngü i içinde 1..=100 {
    birikmiş += i
}
yazdır("1'den 100'e toplam: {birikmiş}")

// devam bu turu atlar, çık döngüyü bitirir.
değişken ara_toplam = 0
döngü i içinde 1..=10 {
    eğer i == 4 { devam } // 4'ü atla
    eğer i > 8 { çık } // 8'den sonra dur
    ara_toplam += i
}
yazdır("1..8 (4 hariç) toplamı: {ara_toplam}")

// iken: koşul doğru olduğu sürece sürer. Kaç tur süreceği baştan belli değilse kullanılır.
değişken n = 1
iken n < 100 {
    n = n * 3
}
yazdır("3'ün 100'ü aşan ilk kuvveti: {n}")

// İç içe döngü: dıştaki her tur için içtekinin tamamı çalışır.
döngü satır içinde 1..=3 {
    döngü sütun içinde 1..=3 {
        yazdır("{satır} x {sütun} = {satır * sütun}")
    }
}

// --- Kendin dene ---
// 1. 1'den 20'ye kadar yalnızca çift sayıların toplamını bul.
// 2. iken ile 1000'i ilk aşan 2 kuvvetini bul.
