# TR 4
# 19 — Dosya ve JSON: veriyi diske yazıp geri okumak.
# Ne öğretir: geçici_klasör, yol, dosya_yaz/dosya_oku, dosya_satırları, .var_mı, json_metin ile
# değeri metne, json_çöz ile metni değere çevirmek.
# Önceki örnekten: metin (04), sözlükler (11), hata yönetimi (15).
# Çalıştırma (proje kökünden): tr examples/tr/19_dosya_ve_json.tr
# Dosyalar geçici klasöre yazılır (program bitince silinir, depoda iz kalmaz).

TR_var klasör = TR_temp_dir()

# Metin dosyası
TR_var not_yolu = TR_Path(klasör, "notlar.txt")
TR_write_file(not_yolu, "birinci satır\nikinci satır\nüçüncü satır\n")
TR_print("var mı: \(not_yolu.TR_exists)")
TR_var satır_sayısı = 0
TR_for satır TR_in TR_read_lines(not_yolu) {
    TR_print("satır: \(satır)")
    satır_sayısı += 1
}
TR_print("satır sayısı: \(satır_sayısı)")

# JSON: sözlük -> metin -> dosya -> metin -> JSON değeri; asıl değere tip çağrısıyla geçilir (Tam(...))
TR_var ayar = {"ad": "deneme", "adım": 100, "oranlar": [0.1, 0.01], "açık": TR_true}
TR_var ayar_yolu = TR_Path(klasör, "ayar.json")
TR_write_file(ayar_yolu, TR_json_string(ayar))
TR_var okunan = TR_json_parse(TR_read_file(ayar_yolu))
TR_print("adım: \(TR_Int(okunan["adım"]) + 1), oranlar: \(okunan["oranlar"]), açık: \(TR_Bool(okunan["açık"]))")
TR_print("aynı mı: \(okunan == TR_JSON(ayar))")

# --- Kendin dene ---
# 1. Kendi ayar sözlüğünü kaydet, bir değerini değiştirip yeniden yaz ve oku.
# 2. Üç satırlık dosyadaki satırların uzunluklarını döngüyle yazdır.
