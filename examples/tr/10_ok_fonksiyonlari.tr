# TR 4
# 10 — Ok fonksiyonları ve zincirleme: fonksiyonu değer olarak kullanmak.
# Ne öğretir: (x) => ifade ok fonksiyonu, fonksiyonu parametre olarak geçirmek, sondaki blok ve o,
# filtrele/haritala/indirge.
# Önceki örnekten: fonksiyonlar (08) ve listeler (09).
# Çalıştırma (proje kökünden): tr examples/tr/10_ok_fonksiyonlari.tr

# Ok fonksiyonu adsız, tek ifadelik bir fonksiyondur; bir değişkende saklanabilir.
TR_var iki_katı = (x: TR_Int) => x * 2
TR_print(iki_katı(21))

# Fonksiyon bir değerdir: başka fonksiyona parametre olarak verilir.
TR_func uygula(f: (TR_Int) -> TR_Int, değer: TR_Int) -> TR_Int {
    TR_return f(değer)
}
TR_print(uygula(iki_katı, 8))
TR_print(uygula((x) => x + 1, 8))

# Listelerin metotları fonksiyon alır: haritala her elemanı dönüştürür,
# filtrele koşulu sağlayanları bırakır, indirge hepsini tek değere toplar.
TR_var sayılar = [1, 2, 3, 4, 5, 6]
TR_print(sayılar.TR_map((x) => x * x))
TR_print(sayılar.TR_filter((x) => x % 2 == 0))
TR_print(sayılar.TR_reduce(0, (t, x) => t + x))

# Son parametre fonksiyonsa süslü parantezle yazılabilir (sondaki blok).
# Blokta sıradaki eleman o adıyla gelir; indirge'de önceki sonuç birikim'dir.
TR_print(sayılar.TR_map((x) => x * 10))
TR_print(sayılar.TR_filter((x) => x > 3))
TR_print(sayılar.TR_reduce(1, (acc, x) => acc * x))

# Metotlar zincirlenir: her adımın sonucu bir sonrakinin girdisi olur.
TR_var ham = [5, 2, 8, 2, 1, 9, 5, 4]
TR_print(ham.TR_unique().TR_filter((x) => x > 2).TR_sort().TR_reverse())

# Listenin toplamı: TR_sum(liste).
TR_var çift_kareler = ham.TR_filter((x) => x % 2 == 0).TR_map((x) => x * x)
TR_print("çift kareler: \(çift_kareler), toplamı \(TR_sum(çift_kareler))")

# --- Kendin dene ---
# 1. Bir kelime listesinden yalnızca 4 harften uzun olanları büyük harfe çevir.
# 2. 1'den 10'a kadar sayıların çarpımını (10!) indirge ile bul.
