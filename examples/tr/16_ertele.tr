# TR 4
# 16 — Ertele: temizliği her durumda yapmak.
# Ne öğretir: ertele ile bir işi bloktan çıkarken (hata olsa da olmasa da) ters sırayla çalıştırmak.
# Önceki örnekten: fonksiyonlar (08), hata yönetimi (15).
# Çalıştırma (proje kökünden): trlang examples/tr/16_ertele.tr

# ertele hemen çalışmaz; içinde yazıldığı blok (burada fonksiyonun gövdesi) bitince çalışır.
# Birden çoksa sonuncu önce çalışır.
# Açılan her şeyin (dosya, bağlantı) kapatılması bu sayede unutulmaz.
TR_func dosya_işlemi() -> TR_String {
    TR_defer { TR_print("  [ertele 1] bağlantı kapatıldı") }
    TR_defer { TR_print("  [ertele 2] önbellek temizlendi") } # önce bu çalışır
    TR_print("  [işlem] veri işleniyor...")
    TR_return "başarılı"
}
TR_print("dönüş: \(dosya_işlemi())")

# Hata çıksa da ertelenen işler çalışır.
TR_func başarısız_işlem() {
    TR_defer { TR_print("  [ertele] hata olsa da temizlik yapıldı") }
    TR_throw "işlem başarısız"
}
TR_try { başarısız_işlem() } TR_catch h { TR_print("yakalandı: \(h)") }

# Döngünün gövdesi de bir bloktur: her turun ertelenen işi o turun sonunda çalışır.
TR_for n TR_in 1..=3 {
    TR_defer { TR_print("  tur \(n) bitti") }
    TR_print("tur \(n) başladı")
}

# --- Kendin dene ---
# 1. Üç ertele yaz ve hangi sırayla çalıştıklarını gözle.
# 2. Hata fırlatan bir fonksiyona ertele ekle ve hatayı dışarıda yakala: temizlik hata iletisinden önce mi sonra mı?
