//! tr kodlu 1
// 36 — Character model: a small language model trained on real text (~100 thousand parameters).
// What it teaches: building a character vocabulary from text, a deep (2-layer) model with a list of layers, counting
// parameters, greedy text generation with argmax. The same model in another language for a speed comparison: tools/bench/README.md.
// Builds on: the transformer (35), dicts (12), reading files (19).
// Data: TR's own Turkish documents. The model learns to predict the next character.
// Run (from the project root): tr examples/en/36_char_model.tr

A030 STEPS = 300
// Training text: the sections of the user guide and the language definition, in order.
A030 DOCUMENTS = [
    "docs/guide/01_baslangic.md", "docs/guide/02_anahtar_kelimeler.md",
    "docs/guide/03_zincirleme_metotlar.md", "docs/guide/04_yapay_zeka_ve_veri.md",
    "docs/guide/05_hata_ayiklayici.md", "docs/guide/06_vscode_kisayollari.md",
    "docs/guide/07_testler.md", "docs/guide/08_bicimlendirme.md",
    "docs/spec/01_program.md", "docs/spec/02_sozcuk_yapisi.md", "docs/spec/03_tipler.md",
    "docs/spec/04_operatorler.md", "docs/spec/05_deyimler.md", "docs/spec/06_fonksiyonlar.md",
    "docs/spec/07_yapilar.md", "docs/spec/08_hata_yonetimi.md", "docs/spec/09_ertele.md",
    "docs/spec/10_eszamanlilik.md", "docs/spec/11_moduller.md", "docs/spec/12_testler.md",
    "docs/spec/13_yerlesikler.md", "docs/spec/14_sinirlamalar.md", "docs/spec/15_tensorler.md",
    "docs/spec/16_veri_parcalayici.md", "docs/spec/17_kodlar.md"
]
A030 text_data = ""
A010 document_path A011 DOCUMENTS {
    text_data += G110("../../" + document_path)
}

// --- Character vocabulary ---
A030 chars = []
A030 char_id = {}
A030 data = []
A010 c A011 text_data {
    A001 char_id[c] == A042 {
        char_id[c] = chars.Y001
        chars.Y004(c)
    }
    data.Y004(char_id[c])
}

A030 V = chars.Y001 // vocabulary size
A030 T = 64 // context length
A030 D = 64 // hidden size
A030 H = 4 // attention heads
A030 Dh = 16 // head size
A030 B = 16 // batch size
A030 LAYERS = 2

// --- Parameters ---
A030 param_seed = 1
A030 weights = []
A020 param(shape, scale) {
    param_seed += 1
    A030 p = T100(T301(T103(shape, T903: param_seed) * scale), T900: A040)
    weights.Y004(p)
    A021 p
}
A020 constant_param(shape, value) {
    A030 p = T100(T102(shape) * value, T900: A040)
    weights.Y004(p)
    A021 p
}

A030 E = param([V, D], 0.1)
A030 P = param([T, D], 0.1)
A030 layers = []
A010 k A011 0..LAYERS {
    layers.Y004({
        "Wq": param([D, D], 0.1), "Wk": param([D, D], 0.1), "Wv": param([D, D], 0.1),
        "Wo": param([D, D], 0.1), "W1": param([D, 4 * D], 0.1), "W2": param([4 * D, D], 0.05),
        "g1": constant_param([D], 1.0), "s1": constant_param([D], 0.0),
        "g2": constant_param([D], 1.0), "s2": constant_param([D], 0.0)
    })
}
A030 gs = constant_param([D], 1.0)
A030 ss = constant_param([D], 0.0)
A030 Wu = param([D, V], 0.1)

A030 total_params = 0
A010 p A011 weights {
    A030 n = 1
    A010 dim A011 p.Y400 { n = n * dim }
    total_params += n
}
G100("data: {data.Y001} characters, vocabulary: {V} characters, parameters: {total_params}")

// --- Model ---
A030 positions = G305(T)

A020 forward(inputs, b) {
    A030 x = T500(E, inputs) + T500(P, positions)
    A010 L A011 layers {
        // Pre-normalization block: attention, then feed-forward
        A030 a = T501(x, L["g1"], L["s1"])
        A030 q = (a @ L["Wq"]).Y410([b, T, H, Dh]).Y412([0, 2, 1, 3])
        A030 k = (a @ L["Wk"]).Y410([b, T, H, Dh]).Y412([0, 2, 1, 3])
        A030 v = (a @ L["Wv"]).Y410([b, T, H, Dh]).Y412([0, 2, 1, 3])
        // Causal attention, scale 1/√Dh = 0.25 (same as softmax(q·kᵀ·0.25 + causal mask) · v)
        A030 y = T503(q, k, v).Y412([0, 2, 1, 3]).Y410([b, T, D])
        x = x + y @ L["Wo"]
        A030 m = T501(x, L["g2"], L["s2"])
        x = x + T203(m @ L["W1"]) @ L["W2"]
    }
    A021 T501(x, gs, ss) @ Wu
}

// --- Data sampling (reproducible) ---
A030 seed = 12345
A020 random_int(n) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    A021 seed % n
}
A020 make_batch() {
    A030 inputs = []
    A030 targets = []
    A010 b A011 0..B {
        A030 start = random_int(data.Y001 - T - 1)
        A030 row = []
        A010 t A011 0..T {
            row.Y004(data[start + t])
            targets.Y004(data[start + t + 1])
        }
        inputs.Y004(row)
    }
    A021 [inputs, targets]
}

// --- Training ---
A030 optimizer = T400(weights, T910: 0.003, T911: 0.0)
A010 step A011 0..STEPS {
    A030 batch = make_batch()
    optimizer.Y501()
    A030 loss = T510(forward(batch[0], B), batch[1])
    T300(loss)
    optimizer.Y500()
    A001 step % 50 == 0 A044 step == STEPS - 1 {
        G100("step {step}: loss = {G405(loss.Y404, 4)}")
    }
}

// --- Text generation (the most likely character at every step) ---
A030 context = []
A010 t A011 0..T { context.Y004(data[t]) }
A030 generated = ""
T301 {
    A010 n A011 0..120 {
        A030 best = T230(forward([context], 1), T902: -1).Y404[0][T - 1]
        generated = generated + chars[best]
        A030 next_context = []
        A010 t A011 1..T { next_context.Y004(context[t]) }
        next_context.Y004(best)
        context = next_context
    }
}
G100("the model wrote: {generated}")

// --- Try it yourself ---
// 1. Raise STEPS from 300 to 600: how does the generated text change?
// 2. Remove a few files from DOCUMENTS and see their effect on the loss and the generated text.
