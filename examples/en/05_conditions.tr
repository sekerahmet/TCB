//! tr kodlu 1
// 03 — Conditions and loops: making decisions and repeating work.
// What it teaches: if/else, match (with range patterns), for ... in, ranges
// (1..=10 includes the end, 1..10 excludes it), break/continue, while, list comprehensions.
// Previous example: 02. Next: 04 (functions).
// Run (from the project root): tr examples/en/03_conditions_and_loops.tr

A030 temperature = 31
A001 temperature > 30 {
    G100("hot")
} A002 A001 temperature > 15 {
    G100("mild")
} A002 {
    G100("cold")
}

// match: compares the value with patterns and runs the first arm that fits
A020 grade_for(score) {
    A003 score {
        90..=100 => "excellent"
        70..90 => "good"
        50..70 => "pass"
        A004 => "fail"
    }
}
A010 s A011 [95, 78, 55, 42] {
    G100("score {s} -> {grade_for(s)}")
}

// for + break/continue
A030 partial_sum = 0
A010 i A011 1..=10 {
    A001 i == 4 { A014 } // skip this turn
    A001 i > 8 { A013 } // leave the loop
    partial_sum += i
}
G100("sum of 1..8 (without 4): {partial_sum}")

// while: as long as the condition holds
A030 n = 1
A012 n < 100 { n = n * 3 }
G100("first power of 3 above 100: {n}")

// list comprehension: gathers the loop and the condition in one expression
G100("even squares: {[x * x A010 x A011 1..=10 A001 x % 2 == 0]}")
