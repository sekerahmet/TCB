//! tr kodlu 3 dil=en
// 40 — Checkpoints: resuming a long training where you left off.
// What it teaches: Checkpoint, keep: (how many checkpoints are kept), writing every training to a run folder; saving the whole state of the training with checkpoint
// (model, optimizer, sampler, log, your own counters) at regular intervals; stopping with Ctrl+C and resuming with the same
// command. A resumed training gives a bit-for-bit identical result to one that was never interrupted.
// Builds on: training with data (39): command_line, progress, dataset.
// Details: docs/guide/09_uzun_egitim.md, docs/spec/20_kontrol_noktasi.md §20.
//
// Run (from the project root): tr examples/en/40_checkpoints.tr
//   Press Ctrl+C while it trains: that step finishes, a checkpoint is saved, the program stops.
//   Run the same command again: it prints "Resuming from: step ..." and goes on from there.
//   To lengthen the training: tr examples/en/40_checkpoints.tr --step 1000
//   To start over delete the run folder or give another one: --run runs/trial2
// In a cloud notebook keep the run folder on the local disk and copy it to Drive now and then (guide §9).

TR_kw_var config = TR_fn_command_line({TR_mem_step: 200, run: "runs/checkpoint_example", every_minutes: 5.0, TR_mem_lr: 0.01},
    TR_arg_description: "Trains a small language model with checkpoints; if interrupted the same command resumes",
    TR_arg_descriptions: {TR_mem_step: "total training steps", run: "run folder (settings, log, weights, checkpoints)",
        every_minutes: "checkpoint interval (minutes)"})
TR_kw_const RUN = config.run

// --- Data and model (the small model of examples/en/39_training_with_data.tr) ---
TR_kw_var p = TR_fn_load_tokenizer("../../tests/data/tokenizer.json")
TR_kw_var V = p.TR_mem_vocab_size
TR_kw_var sampler = TR_fn_dataset("../../tests/data/text").TR_mem_sampler(TR_arg_batch_size: 8, TR_arg_context: 32, TR_arg_seed: 1)
TR_kw_var param_seed = 0
TR_kw_func param(shape, scale) {
    param_seed += 1
    TR_kw_return TR_fn_tensor(TR_fn_no_grad(TR_fn_randn(shape, TR_arg_seed: param_seed) * scale), TR_arg_requires_grad: TR_kw_true)
}
TR_kw_var model = {E: param([V, 32], 0.1), W1: param([32, 64], 0.1), W2: param([64, V], 0.1)}
TR_kw_func forward(tokens) {
    TR_kw_return TR_fn_gelu(TR_fn_embedding(model.E, tokens) @ model.W1) @ model.W2
}
TR_kw_var opt = TR_fn_AdamW(TR_fn_parameters(model), TR_arg_lr: config.TR_mem_lr, TR_arg_weight_decay: 0.0)

// --- Run folder: settings, log and checkpoint ---
TR_fn_make_dir(RUN)
TR_fn_write_file(TR_fn_path(RUN, "config.json"), TR_fn_json_string(config))
TR_kw_var run_log = TR_fn_logger(TR_fn_path(RUN, "metrics.jsonl"))
TR_kw_var tracked = {best_loss: 99.0}
// Everything in the dict is saved; if the folder holds a checkpoint it is loaded here.
TR_kw_var ckpt = TR_fn_checkpoint(RUN, {model: model, opt: opt, reader: sampler, run_log: run_log, tracked: tracked}, TR_arg_every_minutes: config.every_minutes, TR_arg_keep: 3)
TR_fn_print(TR_fn_type(ckpt) == TR_type_Checkpoint)

// --- Training: the loop starts from the step where it stopped ---
TR_kw_if ckpt.TR_mem_resume_step < config.TR_mem_step {
    TR_kw_var bar = TR_fn_progress(config.TR_mem_step, TR_arg_log: run_log)
    TR_kw_for step TR_kw_in ckpt.TR_mem_resume_step..config.TR_mem_step {
        TR_kw_var tokens, target = sampler.TR_mem_next()
        opt.TR_mem_zero_grad()
        TR_kw_var loss = TR_fn_cross_entropy(forward(tokens), target)
        TR_fn_backward(loss)
        opt.TR_mem_step()
        TR_kw_if loss.TR_mem_tolist < tracked.best_loss { tracked.best_loss = loss.TR_mem_tolist }
        bar.TR_mem_update({loss: loss}, TR_arg_step: step + 1)
        ckpt.TR_mem_update(step + 1) // saves here when every_minutes is up and when Ctrl+C arrives
    }
    TR_fn_print("last checkpoint:", ckpt.TR_mem_save())
} TR_kw_else {
    TR_fn_print("Training already finished at step {ckpt.TR_mem_resume_step}; to lengthen it give a larger number with --step")
}

// --- Results into the run folder ---
TR_fn_save_tensors(TR_fn_path(RUN, "model.trt"), TR_fn_parameters(model, TR_arg_named: TR_kw_true))
TR_kw_var last_step = TR_kw_if ckpt.TR_mem_resume_step < config.TR_mem_step { config.TR_mem_step } TR_kw_else { ckpt.TR_mem_resume_step }
TR_fn_write_file(TR_fn_path(RUN, "results.json"), TR_fn_json_string({TR_mem_step: last_step, best_loss: tracked.best_loss}))
TR_fn_print("best loss: {TR_fn_round(tracked.best_loss, 3)}; run folder: {TR_fn_path(RUN).TR_mem_absolute}")

// --- Try it yourself ---
// 1. Run with --step 100, then run again with --step 200: does the training start from 100?
// 2. Add your own counter to the tracked dict and see that it is kept after resuming.
