//! tr kodlu 3 dil=en
// 35 — Transformer: a small transformer written by hand.
// What it teaches: embedding and position embedding, multi-head causal attention (reshape and the
// fused attention(...)), layer norm, a feed-forward step with gelu, the cross_entropy loss.
// Builds on: tensors and autodiff (23–28), a multi-layer network (30), layers (31): layer_norm, gelu, cross_entropy.
// Task: predict the next token in sequences that cycle through 0..V-1.
// Run (from the project root): tr examples/en/35_transformer.tr

TR_kw_var V = 8 // vocabulary size
TR_kw_var T = 8 // context length
TR_kw_var D = 16 // hidden size
TR_kw_var H = 2 // attention heads
TR_kw_var Dh = 8 // head size (D / H)
TR_kw_var B = 4 // batch size

// A learned parameter: starts with small random values, its gradient is tracked.
TR_kw_var param_seed = 1
TR_kw_func param(shape, scale) {
    param_seed += 1 // a different but fixed seed per parameter: the result is reproducible
    TR_kw_return TR_fn_tensor(TR_fn_no_grad(TR_fn_randn(shape, TR_arg_seed: param_seed) * scale), TR_arg_requires_grad: TR_kw_true)
}

TR_kw_var E = param([V, D], 0.1) // token embedding table
TR_kw_var P = param([T, D], 0.1) // position embedding table
TR_kw_var Wq = param([D, D], 0.2)
TR_kw_var Wk = param([D, D], 0.2)
TR_kw_var Wv = param([D, D], 0.2)
TR_kw_var Wo = param([D, D], 0.2)
TR_kw_var W1 = param([D, 4 * D], 0.2)
TR_kw_var W2 = param([4 * D, D], 0.1)
TR_kw_var g1 = TR_fn_tensor(TR_fn_ones([D]), TR_arg_requires_grad: TR_kw_true)
TR_kw_var s1 = TR_fn_tensor(TR_fn_zeros([D]), TR_arg_requires_grad: TR_kw_true)
TR_kw_var g2 = TR_fn_tensor(TR_fn_ones([D]), TR_arg_requires_grad: TR_kw_true)
TR_kw_var s2 = TR_fn_tensor(TR_fn_zeros([D]), TR_arg_requires_grad: TR_kw_true)
TR_kw_var Wu = param([D, V], 0.2)

TR_kw_var positions = TR_fn_range(T)

TR_kw_func split_heads(x) {
    // [B, T, D] -> [B, T, H, Dh]: attention reads this layout, no permute needed
    TR_kw_return x.TR_mem_reshape([B, T, H, Dh])
}

TR_kw_func forward(inputs) {
    TR_kw_var x = TR_fn_embedding(E, inputs) + TR_fn_embedding(P, positions) // [B, T, D]
    TR_kw_var q = split_heads(x @ Wq)
    TR_kw_var k = split_heads(x @ Wk)
    TR_kw_var v = split_heads(x @ Wv)
    // Causal attention: every position looks only at itself and the ones before it. The
    // hand-written equivalent is softmax((q @ k.transpose()) / sqrt(Dh) + mask, dim: -1) @ v (the
    // mask is a very large negative number at future positions); attention(...) computes the
    // same result in one step without keeping the T×T score matrix.
    TR_kw_var y = TR_fn_attention(q, k, v, TR_arg_causal: TR_kw_true).TR_mem_reshape([B, T, D])
    TR_kw_var h = TR_fn_layer_norm(x + y @ Wo, g1, s1)
    TR_kw_var m = TR_fn_gelu(h @ W1) @ W2
    TR_kw_var out = TR_fn_layer_norm(h + m, g2, s2)
    TR_kw_return out @ Wu // [B, T, V]
}

// Simple, reproducible pseudo-random numbers
TR_kw_var seed = 12345
TR_kw_func random_int(n) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    TR_kw_return seed % n
}

TR_kw_func make_batch() {
    TR_kw_var inputs = []
    TR_kw_var targets = []
    TR_kw_for b TR_kw_in 0..B {
        TR_kw_var start = random_int(V)
        TR_kw_var g = []
        TR_kw_for t TR_kw_in 0..T {
            g.TR_mem_append((start + t) % V)
            targets.TR_mem_append((start + t + 1) % V)
        }
        inputs.TR_mem_append(g)
    }
    TR_kw_return [inputs, targets]
}

TR_kw_var weights = [E, P, Wq, Wk, Wv, Wo, W1, W2, g1, s1, g2, s2, Wu]
TR_kw_var optimizer = TR_fn_AdamW(weights, TR_arg_lr: 0.01, TR_arg_weight_decay: 0.0)

TR_kw_for step TR_kw_in 0..300 {
    TR_kw_var data = make_batch()
    optimizer.TR_mem_zero_grad()
    TR_kw_var loss = TR_fn_cross_entropy(forward(data[0]), data[1])
    TR_fn_backward(loss)
    optimizer.TR_mem_step()
    TR_kw_if step % 50 == 0 {
        TR_fn_print("step {step}: loss = {TR_fn_round(loss.TR_mem_tolist, 4)}")
    }
}

// Did it learn? Give it a sequence and print the predictions.
TR_kw_var probe = make_batch()
TR_kw_var prediction = TR_fn_no_grad { forward(probe[0]) }
TR_kw_var scores = prediction[0] // the [T, V] output of the first sequence
TR_kw_var predictions = TR_fn_argmax(scores, TR_arg_dim: -1).TR_mem_tolist // index of the largest score at every position
TR_fn_print("input     : {probe[0][0]}")
TR_fn_print("prediction: {predictions}")

// Two extra settings of attention: window: limits every query to the last w positions (local attention);
// mask: a 0/1 tensor lets you choose which positions are looked at (together with causal: false).
TR_kw_var queries = TR_fn_randn([6, 4], TR_arg_seed: 2)
TR_fn_print("window:", TR_fn_attention(queries, queries, queries, TR_arg_window: 2).TR_mem_shape)
TR_kw_var queries2 = TR_fn_randn([3, 4], TR_arg_seed: 1)
TR_kw_var visible = TR_fn_tensor([[1, 1, 0], [1, 1, 0], [1, 1, 1]])
TR_fn_print("mask:", TR_fn_attention(queries2, queries2, queries2, TR_arg_causal: TR_kw_false, TR_arg_mask: visible).TR_mem_shape)

// --- Try it yourself ---
// 1. Raise D from 16 to 32 (update Dh too): does the loss fall faster?
// 2. Cut the training steps from 300 to 60 and watch the final predictions get worse.
