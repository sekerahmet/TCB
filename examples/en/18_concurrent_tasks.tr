//! tr kodlu 1
// 10 — Concurrent tasks: running jobs at the same time.
// What it teaches: starting background work with async, waiting for all of it to
// finish with wait_all(). The result is the same whatever the order.
// Previous example: 09. Next: 11 (files and JSON).
// Run (from the project root): tr examples/en/10_concurrent_tasks.tr

A030 sum_of_squares = 0
A010 i A011 1..=100 {
    A080 { sum_of_squares += i * i }
}
G501() // wait for every started task to finish
G100("sum of the squares of 1..100: {sum_of_squares}")

// Waiting tasks make progress together: 4 tasks wait 0.05 s all at once
A030 finished = 0
A010 i A011 0..4 {
    A080 {
        G500(0.05)
        finished += 1
    }
}
G501()
G100("number of finished tasks: {finished}")
