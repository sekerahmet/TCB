//! tr kodlu 3 dil=en
// 09 — Lists: keeping many values in order.
// What it teaches: building a list, reading and writing by index (a negative index counts from the end), append,
// length, walking with a loop (with the position too), sort, reverse, sum/mean, list comprehensions, join, get, multiple assignment and swap.
// Builds on: loops (07), functions (08), text (04).
// Run (from the project root): tr examples/en/09_lists.tr

// A list is written in square brackets; its elements can be of different types.
TR_kw_var fruits = ["apple", "pear", "cherry"]
TR_fn_print(fruits, fruits.TR_mem_length)

// The index starts at 0; -1 is the last element.
TR_fn_print(fruits[0], fruits[2], fruits[-1])
fruits[1] = "plum" // change an element
fruits.TR_mem_append("banana") // add to the end
TR_fn_print(fruits)

// A list is walked with a loop.
TR_kw_for fruit TR_kw_in fruits {
    TR_fn_print("- {fruit}")
}

// Ready-made operations for number lists.
TR_kw_var numbers = [5, 2, 8, 2, 1, 9, 5, 4]
TR_fn_print("sorted:", numbers.TR_mem_sort(), "reversed:", numbers.TR_mem_sort().TR_mem_reverse())
TR_fn_print("first: {numbers.TR_mem_first}, last: {numbers.TR_mem_last}, unique: {numbers.TR_mem_unique()}")
TR_fn_print("sum: {TR_fn_sum(numbers)}, mean: {TR_fn_mean(numbers)}, largest: {TR_fn_max(numbers)}")

// List comprehension: builds a new list from a loop; if filters elements out.
TR_fn_print("squares: {[x * x TR_kw_for x TR_kw_in 1..=6]}")
TR_fn_print("even squares: {[x * x TR_kw_for x TR_kw_in 1..=10 TR_kw_if x % 2 == 0]}")

// A function can give several values as a list; multiple assignment unpacks it.
TR_kw_func quotient_and_remainder(a, b) {
    TR_kw_return [a / b, a % b]
}
TR_kw_var quotient, remainder = quotient_and_remainder(17, 5)
TR_fn_print("17 / 5 = {quotient}, remainder {remainder}")

// With multiple assignment two variables trade places (swap).
TR_kw_var a, b = 10, 20
a, b = b, a
TR_fn_print("a = {a}, b = {b}")

// join puts a separator between the elements and makes one text.
TR_fn_print(["a", "b", "c"].TR_mem_join(", "))

// l[i] fails out of range; get gives none instead, and ?? falls back to a default.
TR_fn_print(numbers.TR_mem_get(1), numbers.TR_mem_get(99) ?? 0, "ab".TR_mem_get(-1))

// for position, item in list: walks an element together with its position (from 0).
TR_kw_for position, item TR_kw_in fruits {
    TR_fn_print("{position}. {item}")
}

// --- Try it yourself ---
// 1. Build a list of grades; print the highest, the lowest and the mean.
// 2. Produce the list of numbers divisible by 3 between 1..=30 with a comprehension.
