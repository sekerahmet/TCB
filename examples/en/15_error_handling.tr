//! tr kodlu 3 dil=en
// 15 — Error handling: managing the program properly when something unexpected happens.
// What it teaches: catching an error with try/catch, raising your own with throw,
// deciding where an error is handled, the error variable in a catch without a name.
// Builds on: functions (08), conditions (05); in 06 int("abc") would fail, here it is handled.
// Run (from the project root): tr examples/en/15_error_handling.tr

// When an error occurs the program stops. An error in the try block goes to catch and the program goes on.
TR_kw_try {
    TR_kw_var x = 10 / 0
    TR_fn_print("never reached")
} TR_kw_catch error {
    TR_fn_print("caught: {error}")
}

// throw: raise your own error. The function refuses input that breaks the rule.
TR_kw_func check_age(age) {
    TR_kw_if age < 0 { TR_kw_throw "age cannot be negative" }
    TR_kw_return age
}
TR_kw_try { check_age(-3) } TR_kw_catch e { TR_fn_print("caught: {e}") }
TR_fn_print("valid age: {check_age(30)}")

// An error climbs up the call chain; the first catch deals with it.
TR_kw_func to_number(word) {
    TR_kw_return TR_fn_int(word)
}
TR_kw_func safe_convert(word, fallback) {
    TR_kw_try {
        TR_kw_return to_number(word)
    } TR_kw_catch e {
        TR_fn_print("  '{word}' is not a number, using {fallback}")
        TR_kw_return fallback
    }
}
TR_fn_print(safe_convert("42", 0))
TR_fn_print(safe_convert("abc", 0))

// If catch is given no name the error message comes in the variable named error.
TR_kw_try {
    TR_kw_throw "it blew up"
} TR_kw_catch {
    TR_fn_print("caught: {TR_ctx_error}")
}

// --- Try it yourself ---
// 1. Write a function that wants the mean of an empty list; throw an error when it is empty and catch it.
// 2. Convert every text in a list to a number; skip the ones that cannot be converted.
