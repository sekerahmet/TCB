//! tr kodlu 3 dil=en
// 12 — Type names: asking for the type of a value and declaring types.
// What it teaches: type() and type names as values in an expression (Bool, None, List, Dict, Range, Function,
// BuiltinFunction, Any, Type), declaring a type with name: Type.
// Builds on: types (03), lists (09), arrow functions (10), dicts (11).
// Run (from the project root): tr examples/en/12_type_names.tr

// type(value) gives the type; type names are values in an expression too, compared with ==.
TR_kw_var items = [1, "two", 3.0]
TR_fn_print(TR_fn_type(items) == TR_type_List, TR_fn_type(items))
TR_kw_var record = {"name": "Ali"}
TR_fn_print(TR_fn_type(record) == TR_type_Dict, record["name"])
TR_fn_print(TR_fn_type(TR_kw_true) == TR_type_Bool, TR_fn_type(TR_kw_none) == TR_type_None)

// A range is the type of a..b (end excluded) or a..=b (end included); range(n) gives a List.
TR_fn_print(TR_fn_type(1..5) == TR_type_Range, TR_fn_type(TR_fn_range(5)) == TR_type_List, TR_fn_range(5))

// Functions are first-class values: an arrow function and a func are a Function,
// the language's own functions are of the type BuiltinFunction.
TR_kw_var square = x => x * x
TR_fn_print(TR_fn_type(square) == TR_type_Function, TR_fn_type(TR_fn_print) == TR_type_BuiltinFunction, square(7))

// Type declaration: name: Type. The type checker catches a wrong assignment before the program runs.
TR_kw_var ready: TR_type_Bool = TR_kw_true
TR_kw_var empty: TR_type_None = TR_kw_none
TR_kw_var numbers: TR_type_List = [1, 2, 3]
TR_fn_print(ready, empty, numbers)

// Any: every value may be given; it is for values whose type is not known.
TR_kw_func identity(x: TR_type_Any) {
    TR_kw_return x
}
TR_fn_print(identity(5), identity("five"), identity([1, 2]))

// The type of type() results is Type too, and it can be kept in a variable.
TR_kw_var t: TR_type_Type = TR_fn_type(42)
TR_fn_print(t == TR_type_Int, t, TR_fn_type(t))

// --- Try it yourself ---
// 1. Print the value of type(type(1)) == Type.
// 2. Filter the values of a list with type(x) == Int to keep only the integers.
