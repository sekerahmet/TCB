//! tr kodlu 3 dil=en
// 26 — Automatic differentiation: having the computer compute the gradient.
// What it teaches: tracking a tensor with requires_grad: true, backward(result), .grad,
// gradients accumulating (and needing to be reset), no_grad { ... } for computing without tracking.
// Builds on: tensors (23).
// Run (from the project root): tr examples/en/26_autodiff.tr
// Details: docs/spec/15_tensorler.md §15.

// Model training asks for the derivative (gradient) of a loss value with respect to the weights.
// TR tracks the chain of operations and computes all derivatives at once with backward.

// y = x² + 2x + 1  →  dy/dx = 2x + 2; 8 for x = 3.
TR_kw_var x = TR_fn_tensor(3.0, TR_arg_requires_grad: TR_kw_true) // requires_grad: the gradient of this tensor is wanted
TR_kw_var y = x * x + 2 * x + 1
TR_fn_backward(y)
TR_fn_print("y = {y.TR_mem_tolist}, dy/dx = {x.TR_mem_grad.TR_mem_tolist} (expected 8.0)")

// Several inputs: each gets its own gradient. f(a, b) = a * b + b²
TR_kw_var a = TR_fn_tensor(2.0, TR_arg_requires_grad: TR_kw_true)
TR_kw_var b = TR_fn_tensor(5.0, TR_arg_requires_grad: TR_kw_true)
TR_kw_var f = a * b + b * b
TR_fn_backward(f)
TR_fn_print("df/da = {a.TR_mem_grad.TR_mem_tolist} (expected 5.0), df/db = {b.TR_mem_grad.TR_mem_tolist} (expected 12.0)")

// Gradients accumulate: every backward call adds to the gradient. That is why in training the gradients
// are reset before each step (the optimizer's .zero_grad() method in the next example).
TR_kw_var c = TR_fn_tensor(1.0, TR_arg_requires_grad: TR_kw_true)
TR_fn_backward(c * 3)
TR_fn_backward(c * 3)
TR_fn_print("after two calls dc = {c.TR_mem_grad.TR_mem_tolist} (3 + 3)")

// no_grad { ... } computes without tracking the operations: saves memory and time while predicting.
TR_kw_var z = TR_fn_no_grad { x * 10 }
TR_fn_print("no_grad result: {z.TR_mem_tolist}")

// --- Try it yourself ---
// 1. Have the derivative of y = x³ at x = 2 computed and compare it with your own result (3x² = 12).
// 2. Try backward(z): why does a tensor built inside no_grad give no gradient?
