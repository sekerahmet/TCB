//! tr kodlu 3 dil=en
// Error 12 — Uncaught throw.
// Message code: H2441
// What happens: If an error raised with throw reaches no catch block the program stops and the error message is written.
// Why: There is no try/catch to receive the error.
// Fixed version:
//     try {
//         print(check_age(-3))
//     } catch e {
//         print("caught: {e}")
//     }
// Run (from the project root): tr examples/en/errors/12_uncaught_throw.tr   (exit code 1)

TR_kw_func check_age(age) {
    TR_kw_if age < 0 { TR_kw_throw "age cannot be negative" }
    TR_kw_return age
}
TR_fn_print(check_age(-3))
