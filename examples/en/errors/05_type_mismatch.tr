//! tr kodlu 2 dil=en
// Error 05 — Type mismatch.
// Message code: H1001
// What happens: The type checker catches, before the program runs, that a value of another type was assigned to a variable with a declared type.
// Why: age was declared as Int but a String was assigned.
// Fixed version:
//     var age: Int = 30
// Run (from the project root): tr examples/en/errors/05_type_mismatch.tr   (exit code 1)

A030 age: A200 = "thirty"
G100(age)
