//! tr kodlu 3 dil=en
// Error 11 — Division by zero.
// Message code: H2470
// What happens: If the divisor is zero an error is raised at run time.
// Why: A number cannot be divided by zero.
// Fixed version:
//     if count != 0 { print(100 / count) } // or handle the error with try/catch
// Run (from the project root): tr examples/en/errors/11_division_by_zero.tr   (exit code 1)

TR_kw_var count = 0
TR_fn_print(100 / count)
