//! tr kodlu 3 dil=en
// Error 01 — Unclosed block.
// Message code: H0156
// What happens: The program does not run at all; the message says that no '}' was found to close the opened '{'.
// Why: Every '{' must be closed by a '}'; forgetting the closing brace of an if, loop or function block is a common mistake.
// Fixed version:
//     if 1 < 2 {
//         print("closed")
//     }
// Run (from the project root): tr examples/en/errors/01_syntax_unclosed_block.tr   (exit code 1)

TR_kw_if 1 < 2 {
    TR_fn_print("left open")
