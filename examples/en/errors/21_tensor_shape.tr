//! tr kodlu 3 dil=en
// Error 21 — Tensor shape mismatch.
// Message code: H6126
// What happens: If two tensors whose shapes do not fit enter a matrix product an error is raised at run time; the message shows the shapes.
// Why: [1, 2] @ [1, 2]: the last axis of the left (2) must equal the second-to-last axis of the right (1).
// Fixed version:
//     print(a @ a.transpose()) // [1, 2] @ [2, 1] is valid
// Run (from the project root): tr examples/en/errors/21_tensor_shape.tr   (exit code 1)

TR_kw_var a = TR_fn_tensor([[1.0, 2.0]])
TR_fn_print(a @ a)
