//! tr kodlu 3 dil=en
// Error 15 — Conversion error.
// Message code: H2429
// What happens: If a text that cannot become a number is converted with int(), an error is raised at run time.
// Why: "abc" is not the spelling of an integer.
// Fixed version:
//     try {
//         print(int("abc"))
//     } catch e {
//         print("not a number: {e}")
//     }
// Run (from the project root): tr examples/en/errors/15_conversion_error.tr   (exit code 1)

TR_fn_print(TR_fn_int("abc"))
