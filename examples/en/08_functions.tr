//! tr kodlu 1
// 04 — Functions: naming work and reusing it.
// What it teaches: func and return, type annotations, default values, named arguments, several
// results, arrow functions, a function that calls itself (recursion), trailing blocks.
// Previous example: 03. Next: 05 (lists and dicts).
// Run (from the project root): tr examples/en/04_functions.tr

A020 add(a: A200, b: A200) -> A200 {
    A021 a + b
}
G100(add(2, 3))

// default value and named argument
A020 greet(name, suffix = "!") {
    A021 "Hi {name}{suffix}"
}
G100(greet("Ayse"), greet(suffix: "?", name: "Ali"))

// several results come back as a list; multiple assignment unpacks it
A020 quotient_and_remainder(a, b) {
    A021 [a / b, a % b]
}
A030 quotient, remainder = quotient_and_remainder(17, 5)
G100("17 / 5 = {quotient}, remainder {remainder}")

// a function that calls itself
A020 factorial(n) {
    A001 n <= 1 { A021 1 }
    A021 n * factorial(n - 1)
}
G100("5! = {factorial(5)}, 10! = {factorial(10)}")

// a function is a value: arrow function, passed as a parameter
A030 double = (x) => x * 2
A020 apply(f, value) {
    A021 f(value)
}
G100(apply(double, 21))

// trailing block: when the last parameter is a function it is written in braces; it = current element
G100([1, 2, 3, 4].Y201 { A104 * 10 })
