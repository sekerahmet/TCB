//! tr kodlu 3 dil=en
// 08 — Functions: naming work and reusing it.
// What it teaches: func and return, type annotations, default values, named arguments, a function
// that calls itself (recursion).
// Builds on: conditions (05), loops (07), interpolation (04).
// Run (from the project root): tr examples/en/08_functions.tr

// func name(parameters) { ... return value }: return hands the value back to the caller.
TR_kw_func add(a, b) {
    TR_kw_return a + b
}
TR_fn_print(add(2, 3))
TR_fn_print(add(add(1, 2), 4)) // a result can be the input of another call

// Parameters and the result can carry types; a value of the wrong type is an error.
TR_kw_func area(width: TR_type_Float, depth: TR_type_Float) -> TR_type_Float {
    TR_kw_return width * depth
}
TR_fn_print(area(2.5, 4.0))

// Default value: used when the argument is not given.
// Named argument: given with the parameter name, the order does not matter.
TR_kw_func greet(who, suffix = "!") {
    TR_kw_return "Hi {who}{suffix}"
}
TR_fn_print(greet("Ayse"))
TR_fn_print(greet("Ali", "?"))
TR_fn_print(greet(suffix: "...", who: "Veli"))

// return ends the function at once; together with a condition it gives an early exit.
TR_kw_func absolute(x) {
    TR_kw_if x < 0 { TR_kw_return -x }
    TR_kw_return x
}
TR_fn_print(absolute(-7), absolute(7))

// A function can call itself (recursion); it must have a condition that stops it.
TR_kw_func factorial(n) {
    TR_kw_if n <= 1 { TR_kw_return 1 }
    TR_kw_return n * factorial(n - 1)
}
TR_fn_print("5! = {factorial(5)}, 10! = {factorial(10)}")

// Variables inside a function are not visible outside.
TR_kw_func count_and_print(limit) {
    TR_kw_var running = 0
    TR_kw_for i TR_kw_in 1..=limit { running += i }
    TR_fn_print("sum of 1..{limit} is {running}")
}
count_and_print(10)

// --- Try it yourself ---
// 1. Write square(x) that gives the square of a number and find square(square(2)).
// 2. Compute the n-th Fibonacci number with recursion (fib(1) = 1, fib(2) = 1).
