//! tr kodlu 3 dil=en
// 14 — Structs and methods: keeping related data and the work tied to it together.
// What it teaches: struct definitions, fields and default values, methods, self, creating
// objects (positional and named), updating fields, init, StructType and Object.
// Builds on: functions (08), lists (09), dicts (11).
// Run (from the project root): tr examples/en/14_structs_and_methods.tr

// A struct defines a new type with its own fields. Unlike a dict its fields and types are known up front.
TR_kw_struct Developer {
    full_name: TR_type_String
    experience: TR_type_Int = 1 // default value

    // A function inside a struct is a method; self is the object being worked on.
    TR_kw_func introduce() {
        TR_kw_return "{TR_kw_self.full_name} ({TR_kw_self.experience} yr)"
    }

    TR_kw_func add_experience(years) {
        TR_kw_self.experience += years
    }
}

TR_kw_var dev = Developer("Ahmet", 5) // fields are given in definition order
dev.experience += 1 // a field is updated directly
TR_fn_print(dev.introduce())
TR_fn_print(Developer(full_name: "Zeynep").introduce()) // named argument; experience stays the default
dev.add_experience(4)
TR_fn_print(dev.introduce())

// Structs also live in lists.
TR_kw_struct Point {
    x: TR_type_Float
    y: TR_type_Float

    TR_kw_func distance() {
        TR_kw_return TR_fn_sqrt(TR_kw_self.x ** 2 + TR_kw_self.y ** 2)
    }
}
TR_kw_var points = [Point(3.0, 4.0), Point(6.0, 8.0)]
TR_fn_print(points.TR_mem_map { TR_ctx_it.distance() })

// A method named init is called when an object is created; it can start the fields from a calculation.
TR_kw_struct Account {
    balance

    TR_kw_func TR_ctx_init(first) {
        TR_kw_self.balance = first * 2
    }
}
TR_fn_print(Account(5).balance)

// The struct itself is of the type StructType; the type of an object is the struct itself.
// Object is the general name of every value made from a struct (used in type declarations).
TR_kw_var account: TR_type_Object = Account(1)
TR_fn_print(TR_fn_type(Account) == TR_type_StructType, TR_fn_type(account) == Account)

// --- Try it yourself ---
// 1. Write a Rectangle struct (width, depth) and add area() and perimeter() methods.
// 2. Build a list of Developer objects and find the name of the one with the most experience.
