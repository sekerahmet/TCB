//! tr kodlu 3 dil=en
// 22 — Concurrent tasks: running jobs at the same time.
// What it teaches: starting background work with async, waiting for all of it to finish with wait_all().
// The result is the same whatever the order.
// Builds on: loops (07), functions (08).
// Run (from the project root): tr examples/en/22_concurrent_tasks.tr

TR_kw_var sum_of_squares = 0
TR_kw_for i TR_kw_in 1..=100 {
    TR_kw_async { sum_of_squares += i * i }
}
TR_fn_wait_all() // wait for every started task to finish
TR_fn_print("sum of the squares of 1..100: {sum_of_squares}")

// Waiting tasks make progress together: 4 tasks wait 0.05 s all at once
TR_kw_var finished = 0
TR_kw_for i TR_kw_in 0..4 {
    TR_kw_async {
        TR_fn_sleep(0.05)
        finished += 1
    }
}
TR_fn_wait_all()
TR_fn_print("number of finished tasks: {finished}")

// --- Try it yourself ---
// 1. Change the sleep(0.05) time to 0.2: does the total time grow with the number of tasks or with a single task's time?
// 2. Compute the sum of 1..=1000 by splitting it into pieces over 10 concurrent tasks.
