//! tr kodlu 3 dil=en
// 11 — Dicts: keeping values under keys.
// What it teaches: building a dict, reading/writing by key, a missing key (none), keys() and
// values(), contains, a list of dicts.
// Builds on: lists (09), arrow functions (10), none and ?? (03).
// Run (from the project root): tr examples/en/11_dicts.tr

// A dict is written in braces: "key": value pairs.
TR_kw_var prices = {"apple": 12, "banana": 30}
TR_fn_print(prices, prices.TR_mem_length)

// It is read and written by key; a missing key is added.
TR_fn_print(prices["banana"])
prices["cherry"] = 45
prices["apple"] = 15
TR_fn_print(prices)

// A missing key gives none; ?? falls back to a default.
TR_fn_print(prices["pear"], prices["pear"] ?? 0)
TR_fn_print(prices.TR_mem_contains("banana"), prices.TR_mem_contains("pear"))

// Keys and values are taken as lists.
TR_fn_print(prices.TR_mem_keys(), prices.TR_mem_values())
TR_kw_for product TR_kw_in prices.TR_mem_keys() {
    TR_fn_print("{product}: {prices[product]} TL")
}
TR_fn_print("total: {TR_fn_sum(prices.TR_mem_values())} TL")

// The value of a dict can be a list or another dict.
TR_kw_var student = {"name": "Ayse", "grades": [70, 85, 90], "address": {"city": "Ankara"}}
TR_fn_print("{student["name"]} {student["address"]["city"]}, mean {TR_fn_round(TR_fn_mean(student["grades"]), 1)}")

// A list of dicts works like a table.
TR_kw_var orders = [
    {"customer": "Ayse", "amount": 450},
    {"customer": "Mehmet", "amount": 280},
    {"customer": "Elif", "amount": 35}
]
TR_fn_print(orders.TR_mem_filter { TR_ctx_it["amount"] > 100 }.TR_mem_map { TR_ctx_it["customer"] })
TR_fn_print("total amount: {orders.TR_mem_map { TR_ctx_it["amount"] } |> TR_fn_sum}")

// --- Try it yourself ---
// 1. Count how many times each letter occurs in a text, in a dict.
// 2. Add a new order to the orders list and find the largest amount.
