//! tr kodlu 1
// 19 — Files and JSON: writing data to disk and reading it back.
// What it teaches: temp_dir, path, write_file/read_file, read_lines, .exists, json_string to turn a value
// into text, json_parse to turn text into a value.
// Builds on: text (05), dicts (12), error handling (15).
// Run (from the project root): tr examples/en/19_files_and_json.tr
// Files are written to a temporary folder (deleted when the program ends, no trace in the repo).

A030 folder = G126()

// Text file
A030 note_path = G120(folder, "notes.txt")
G111(note_path, "first line\nsecond line\nthird line\n")
G100("exists: {note_path.Y315}")
G100("line count: {G110(note_path).Y102().Y103("\n").Y001}")
A010 line A011 G112(note_path) {
    G100("line: {line}")
}

// JSON: dict -> text -> file -> text -> dict
A030 config = {"name": "trial", "steps": 100, "rates": [0.1, 0.01], "open": A040}
A030 config_path = G120(folder, "config.json")
G111(config_path, G601(config))
A030 loaded = G600(G110(config_path))
G100("steps: {loaded["steps"]}, rates: {loaded["rates"]}, open: {loaded["open"]}")
G100("same: {loaded == config}")

// --- Try it yourself ---
// 1. Save your own config dict, change one value, write it again and read it.
// 2. Print the length of each line of the three-line file with a loop.
