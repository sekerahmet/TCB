//! tr kodlu 3 dil=en
// 24 — Tensor math: applying operations to every element of a tensor.
// What it teaches: math functions like exp, log, sin working element by element on tensors,
// silu and log_softmax, reducing along an axis with sum/mean and keepdim.
// Builds on: tensors (23), math (13).
// Run (from the project root): tr examples/en/24_tensor_math.tr
// Details: docs/spec/15_tensorler.md §15.

// The functions we applied to numbers in 13 are applied to every element of a tensor separately.
// The result is a new tensor; .tolist turns it into a TR list.
TR_kw_var x = TR_fn_tensor([0.0, 1.0, 2.0])
TR_fn_print("exp:", TR_fn_exp(x).TR_mem_tolist)
TR_fn_print("log:", TR_fn_log(x + 1).TR_mem_tolist)
TR_fn_print("sin:", TR_fn_sin(x).TR_mem_tolist, "cos:", TR_fn_cos(x).TR_mem_tolist)
TR_fn_print("tan:", TR_fn_tan(TR_fn_tensor([0.0, 1.0])).TR_mem_tolist)
TR_fn_print("asin:", TR_fn_asin(TR_fn_tensor([0.0, 0.5])).TR_mem_tolist, "acos:", TR_fn_acos(TR_fn_tensor([1.0, -1.0])).TR_mem_tolist)
TR_fn_print("atan:", TR_fn_atan(TR_fn_tensor([0.0, 1.0])).TR_mem_tolist)
TR_fn_print("atan2:", TR_fn_atan2(TR_fn_tensor([1.0, -1.0]), TR_fn_tensor([0.0])).TR_mem_tolist) // broadcasting: (y, x) pairs
TR_fn_print("sinh/cosh:", TR_fn_sinh(TR_fn_tensor([0.0, 1.0])).TR_mem_tolist, TR_fn_cosh(TR_fn_tensor([0.0, 1.0])).TR_mem_tolist)
TR_fn_print("log2/log10:", TR_fn_log2(TR_fn_tensor([1.0, 1024.0])).TR_mem_tolist, TR_fn_log10(TR_fn_tensor([1.0, 100.0])).TR_mem_tolist)
TR_fn_print("small-number log and exp:", TR_fn_log1p(TR_fn_tensor([0.0, 1.0])).TR_mem_tolist, TR_fn_expm1(TR_fn_tensor([0.0, 1.0])).TR_mem_tolist)

// Activation functions: silu computes x · sigmoid(x); log_softmax gives the logarithm of softmax
// in a numerically stable way.
TR_fn_print("silu:", TR_fn_silu(TR_fn_tensor([-1.0, 0.0, 2.0])).TR_mem_tolist)
TR_fn_print("log_softmax:", TR_fn_log_softmax(TR_fn_tensor([1.0, 2.0, 3.0])).TR_mem_tolist)

// Reducing along an axis: dim: -1 means the last axis.
// keepdim: true keeps the reduced axis with length 1; the result can be broadcast against the input.
TR_kw_var m = TR_fn_tensor([[1, 2], [3, 4]])
TR_fn_print(TR_fn_sum(m, TR_arg_dim: -1).TR_mem_shape, TR_fn_sum(m, TR_arg_dim: -1, TR_arg_keepdim: TR_kw_true).TR_mem_shape)
TR_fn_print(TR_fn_sum(m, TR_arg_dim: 0).TR_mem_tolist, TR_fn_mean(m, TR_arg_dim: -1).TR_mem_tolist)

// --- Try it yourself ---
// 1. Compute softmax along the rows of tensor([[1.0, 2.0], [3.0, 4.0]]) and show that every row sums to 1.
// 2. Subtract the row mean with m - mean(m, dim: -1, keepdim: true) (broadcasting).
