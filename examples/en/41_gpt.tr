//! tr kodlu 3 dil=en
// 41 — GPT with ready-made layers: a small language model built from the layers and optimizers of the language library.
// What it teaches: building a GPT with `import "tr/katman"`, giving the hidden weights to Muon and the rest to AdamW
// (MuonVeAdamW), a warm-up–constant–decay learning-rate schedule, resuming with a checkpoint, generating text.
// Builds on: checkpoints (40) and the transformer (35): the library counterpart of what 35 wrote by hand.
// The library's own names (GPT, MuonVeAdamW, oran_planı, boyut, katman ...) are not translated yet
// (docs/spec/17_kodlar.md, 17.2): they stay in Turkish in every spelling.
// Library code: lib/katman.tr and lib/iyilestirici.tr (you can copy and change it).
// Details: docs/guide/10_hazir_katmanlarla_gpt.md, lib/README.md.
//
// Run (from the project root): tr examples/en/41_gpt.tr
//   Settings come from the command line: tr examples/en/41_gpt.tr --step 300 --width 64 --run runs/gpt2
//   If it is interrupted (Ctrl+C) the same command goes on where it left off; to start over delete
//   the run folder or give another --run.
// On a GPU: pick the default device before the model is built (uncomment the line below)
// and scale the settings up, e.g. --width 512 --layers 8 --heads 8 --context 512 --batch 64.
// default_device("gpu")

TR_kw_import "tr/katman"
TR_kw_import "tr/iyilestirici"

TR_kw_var config = TR_fn_command_line({TR_mem_step: 100, batch: 8, context: 32, width: 32, layers: 2, heads: 4,
    muon_rate: 0.02, adamw_rate: 0.01, normuon: TR_kw_false, run: "runs/gpt_example"},
    TR_arg_description: "Trains a small GPT built from ready-made layers with Muon + AdamW",
    TR_arg_descriptions: {TR_mem_step: "total training steps", run: "run folder (settings, log, checkpoints)",
        normuon: "NorMuon instead of Muon for the hidden weights"})

// --- Data: the synthetic text in the repository and its tokenizer (for your own data see examples/en/39_training_with_data.tr) ---
TR_kw_var p = TR_fn_load_tokenizer("../../tests/data/tokenizer.json")
TR_kw_var sampler = TR_fn_dataset("../../tests/data/text").TR_mem_sampler(TR_arg_batch_size: config.batch, TR_arg_context: config.context, TR_arg_seed: 1)

// --- Model and optimizer ---
TR_kw_var model = GPT(p.TR_mem_vocab_size, bağlam: config.context, boyut: config.width, katman: config.layers,
    bakış_sayısı: config.heads, paylaşımlı: TR_kw_true, tohum: 1)
TR_kw_var opt = MuonVeAdamW(model, muon_oranı: config.muon_rate, adamw_oranı: config.adamw_rate, normuon: config.normuon)
TR_fn_print("model: {TR_fn_parameters(model).TR_mem_length} weight tensors; {opt.muon.ağırlıklar.TR_mem_length} in Muon, {opt.diğer.TR_mem_length} in AdamW")

// --- Run folder and checkpoint: model, the state of AdamW and Muon, the reader, the log ---
TR_fn_make_dir(config.run)
TR_fn_write_file(TR_fn_path(config.run, "config.json"), TR_fn_json_string(config))
TR_kw_var run_log = TR_fn_logger(TR_fn_path(config.run, "metrics.jsonl"))
TR_kw_var ckpt = TR_fn_checkpoint(config.run, {model: model, adamw: opt.adamw, muon: opt.muon.TR_mem_state, reader: sampler, run_log: run_log}, TR_arg_every_minutes: 5)

// --- Training: 10% warm-up first, 30% decay at the end ---
TR_kw_if ckpt.TR_mem_resume_step < config.TR_mem_step {
    TR_kw_var bar = TR_fn_progress(config.TR_mem_step, TR_arg_log: run_log)
    TR_kw_for step TR_kw_in ckpt.TR_mem_resume_step..config.TR_mem_step {
        opt.çarpan_ayarla(oran_planı(step, config.TR_mem_step, ısınma: TR_fn_int(config.TR_mem_step / 10), azalma: 0.3))
        TR_kw_var tokens, target = sampler.TR_mem_next()
        opt.TR_mem_zero_grad()
        TR_kw_var loss = model.kayıp(tokens, target)
        TR_fn_backward(loss)
        opt.TR_mem_step()
        bar.TR_mem_update({loss: loss}, TR_arg_step: step + 1)
        ckpt.TR_mem_update(step + 1)
    }
    ckpt.TR_mem_save()
}

// --- Validation loss and text generation ---
TR_kw_var validation = TR_fn_dataset("../../tests/data/text").TR_mem_sequential(TR_arg_batch_size: config.batch, TR_arg_context: config.context)
TR_kw_var total_loss = 0.0
TR_kw_var count = 0
TR_fn_no_grad {
    TR_kw_for job TR_kw_in validation {
        TR_kw_if count == 10 { TR_kw_break }
        total_loss += model.kayıp(job[0], job[1]).TR_mem_tolist
        count += 1
    }
}
TR_fn_print("validation loss ({count} batches): {TR_fn_round(total_loss / count, 3)}")
TR_kw_var generated = model.üret(p.TR_mem_encode("Bugün"), 12, sıcaklık: 0.8, en_iyi_k: 20, tohum: 1)
TR_fn_print("the model wrote: {p.TR_mem_decode(generated)}")

// --- Try it yourself ---
// 1. Run with --layers 4 --width 64: how does the validation loss change?
// 2. Set the temperature of generate to 0.2 and to 1.5 and watch how the text changes.
