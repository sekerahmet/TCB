//! tr kodlu 1
// 07 — Error handling: managing the program properly when something unexpected happens.
// What it teaches: try/catch, throw to raise your own error, defer for cleanup that
// runs in every case (in reverse order).
// Previous example: 06. Next: 08 (tests).
// Run (from the project root): tr examples/en/07_error_handling.tr

// When an error occurs the catch block runs and the program goes on
A060 {
    A030 x = 10 / 0
    G100("never reached")
} A061 error {
    G100("caught: {error}")
}

// throw: raise your own error
A020 check_age(age) {
    A001 age < 0 { A062 "age cannot be negative" }
    A021 age
}
A060 { check_age(-3) } A061 e { G100("caught: {e}") }
G100("valid age: {check_age(30)}")

// defer: runs when leaving the function, error or not, in reverse order
A020 file_operation() {
    A081 G100("  [defer 1] connection closed")
    A081 G100("  [defer 2] cache cleared") // this one runs first
    G100("  [work] processing data...")
    A021 "success"
}
G100("returned: {file_operation()}")

A020 failing_operation() {
    A081 G100("  [defer] cleaned up even though it failed")
    A062 "operation failed"
}
A060 { failing_operation() } A061 e { G100("caught: {e}") }
