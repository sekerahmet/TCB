//! tr kodlu 1
// 07 — Loops: repeating work.
// What it teaches: for ... in over a range (1..=5 includes the end, 1..5 excludes it), break, continue,
// while, nested loops.
// Builds on: conditions (05), interpolation (04), += (02).
// Run (from the project root): tr examples/en/07_loops.tr

// for i in range: i takes every value of the range in turn.
A010 i A011 1..=5 {
    G100("round {i}")
}
G100("end excluded:")
A010 i A011 1..5 {
    G100(i)
}

// Accumulating: updating a variable while the loop runs.
A030 running = 0
A010 i A011 1..=100 {
    running += i
}
G100("sum from 1 to 100: {running}")

// continue skips this round, break ends the loop.
A030 partial_sum = 0
A010 i A011 1..=10 {
    A001 i == 4 { A014 } // skip 4
    A001 i > 8 { A013 } // stop after 8
    partial_sum += i
}
G100("sum of 1..8 (without 4): {partial_sum}")

// while: goes on as long as the condition is true. Used when the number of rounds is not known up front.
A030 n = 1
A012 n < 100 {
    n = n * 3
}
G100("first power of 3 above 100: {n}")

// Nested loop: for every round of the outer one the inner one runs completely.
A010 row A011 1..=3 {
    A010 col A011 1..=3 {
        G100("{row} x {col} = {row * col}")
    }
}

// --- Try it yourself ---
// 1. Find the sum of only the even numbers from 1 to 20.
// 2. With while, find the first power of 2 above 1000.
