//! tr kodlu 1
// 24 — Transformer: a small transformer written by hand.
// What it teaches: embedding and position embedding, multi-head causal attention (reshape, permute and the
// fused attention(...)), layer norm, a feed-forward step with gelu, the cross_entropy loss.
// Builds on: tensors and autodiff (19–21), a multi-layer network (22).
// Task: predict the next token in sequences that cycle through 0..V-1.
// Run (from the project root): tr examples/en/24_transformer.tr

A030 V = 8 // vocabulary size
A030 T = 8 // context length
A030 D = 16 // hidden size
A030 H = 2 // attention heads
A030 Dh = 8 // head size (D / H)
A030 B = 4 // batch size

// A learned parameter: starts with small random values, its gradient is tracked.
A030 param_seed = 1
A020 param(shape, scale) {
    param_seed += 1 // a different but fixed seed per parameter: the result is reproducible
    A021 T100(T301(T103(shape, T903: param_seed) * scale), T900: A040)
}

A030 E = param([V, D], 0.1) // token embedding table
A030 P = param([T, D], 0.1) // position embedding table
A030 Wq = param([D, D], 0.2)
A030 Wk = param([D, D], 0.2)
A030 Wv = param([D, D], 0.2)
A030 Wo = param([D, D], 0.2)
A030 W1 = param([D, 4 * D], 0.2)
A030 W2 = param([4 * D, D], 0.1)
A030 g1 = T100(T102([D]), T900: A040)
A030 s1 = T100(T101([D]), T900: A040)
A030 g2 = T100(T102([D]), T900: A040)
A030 s2 = T100(T101([D]), T900: A040)
A030 Wu = param([D, V], 0.2)

A030 positions = G305(T)

A020 split_heads(x) {
    // [B, T, D] -> [B, H, T, Dh]
    A021 x.Y410([B, T, H, Dh]).Y412([0, 2, 1, 3])
}

A020 forward(inputs) {
    A030 x = T500(E, inputs) + T500(P, positions) // [B, T, D]
    A030 q = split_heads(x @ Wq)
    A030 k = split_heads(x @ Wk)
    A030 v = split_heads(x @ Wv)
    // Causal attention: every position looks only at itself and the ones before it. The
    // hand-written equivalent is softmax((q @ k.transpose()) / sqrt(Dh) + mask, dim: -1) @ v (the
    // mask is a very large negative number at future positions); attention(...) computes the
    // same result in one step without keeping the T×T score matrix.
    A030 y = T503(q, k, v, T950: A040).Y412([0, 2, 1, 3]).Y410([B, T, D])
    A030 h = T501(x + y @ Wo, g1, s1)
    A030 m = T203(h @ W1) @ W2
    A030 out = T501(h + m, g2, s2)
    A021 out @ Wu // [B, T, V]
}

// Simple, reproducible pseudo-random numbers
A030 seed = 12345
A020 random_int(n) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    A021 seed % n
}

A020 make_batch() {
    A030 inputs = []
    A030 targets = []
    A010 b A011 0..B {
        A030 start = random_int(V)
        A030 g = []
        A010 t A011 0..T {
            g.Y004((start + t) % V)
            targets.Y004((start + t + 1) % V)
        }
        inputs.Y004(g)
    }
    A021 [inputs, targets]
}

A030 weights = [E, P, Wq, Wk, Wv, Wo, W1, W2, g1, s1, g2, s2, Wu]
A030 optimizer = T400(weights, T910: 0.01, T911: 0.0)

A010 step A011 0..300 {
    A030 data = make_batch()
    optimizer.Y501()
    A030 loss = T510(forward(data[0]), data[1])
    T300(loss)
    optimizer.Y500()
    A001 step % 50 == 0 {
        G100("step {step}: loss = {G405(loss.Y404, 4)}")
    }
}

// Did it learn? Give it a sequence and print the predictions.
A030 sample = make_batch()
A030 prediction = T301 { forward(sample[0]) }
A030 scores = prediction.Y404[0] // the [T, V] output of the first sequence
A030 predictions = []
A010 row A011 scores {
    A030 best = 0
    A010 j A011 0..V {
        A001 row[j] > row[best] { best = j }
    }
    predictions.Y004(best)
}
G100("input     : {sample[0][0]}")
G100("prediction: {predictions}")

// --- Try it yourself ---
// 1. Raise D from 16 to 32 (update Dh too): does the loss fall faster?
// 2. Cut the training steps from 300 to 60 and watch the final predictions get worse.
