//! tr kodlu 3 dil=en
// 45 — Record and replay: record a small, often repeated GPU step once and replay it in one go.
// What it teaches: replay(f) (a CUDA Graph on the GPU), write_slice(target, source, axis:, start:) to write
// into a cache at a position, passing the changing values (position, id) as tensor arguments.
// In generation every token does the same small work; the main cost is often launching hundreds of
// kernels one by one. replay records the work on the second call, then skips the interpreter and replays it.
// Builds on: the ready-made GPT (41); GPT.üret (the library is written in Turkish) uses the same path on the GPU by itself.
// Details: docs/spec/15_tensorler.md §15.45, §15.8, lib/README.md (Üretim).
//
// Run (from the project root): tr examples/en/45_replay.tr
// On the GPU: uncomment the line below; on the CPU replay calls f directly and the result is the same.
// default_device("gpu")

TR_kw_var table = TR_fn_randn([6, 4], TR_arg_seed: 1) // a 6-token vocabulary, 4-dimensional embeddings
TR_kw_var cache = TR_fn_zeros([5, 4]) // a "cache" of 5 positions

// One step: picks the token's embedding, writes it at its position in the cache, returns the cache's sum.
// Everything that changes is a tensor: it is not fixed in the recording, every replay reads it again.
TR_kw_func step(id, position) {
    TR_kw_var e = TR_fn_embedding(table, id) // [1, 4]
    TR_fn_write_slice(cache, e, TR_arg_dim: 0, TR_arg_start: position)
    TR_kw_return TR_fn_sum(cache, TR_arg_dim: 0)
}

TR_kw_var replayed = TR_fn_replay(step)
TR_fn_no_grad {
    TR_kw_for position, id TR_kw_in [3, 1, 4, 1, 5] {
        TR_kw_var s = replayed(TR_fn_tensor([id * 1.0]), TR_fn_tensor(position * 1.0))
        TR_fn_print("position {position}, token {id}: sum {TR_fn_round(TR_fn_sum(s).TR_mem_tolist, 4)}")
    }
}
TR_fn_print("cache:", cache.TR_mem_shape)

// --- Try it yourself ---
// 1. Change the token ids in the list: which rows of the cache change?
// 2. Make the cache 3 positions long: what does write_slice say at position 3 and beyond? (Catch it with try/catch first.)
