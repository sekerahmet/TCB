//! tr kodlu 2 dil=en
// 16 — Defer: doing the cleanup in every case.
// What it teaches: defer runs a job when leaving the function (error or not), in reverse order.
// Builds on: functions (08), error handling (15).
// Run (from the project root): tr examples/en/16_defer.tr

// A defer statement does not run at once; it runs when the function ends. With several, the last runs first.
// Closing everything that was opened (files, connections) is not forgotten this way.
A020 file_operation() {
    A081 G100("  [defer 1] connection closed")
    A081 G100("  [defer 2] cache cleared") // this one runs first
    G100("  [work] processing data...")
    A021 "success"
}
G100("returned: {file_operation()}")

// Deferred jobs run even when an error occurs.
A020 failing_operation() {
    A081 G100("  [defer] cleaned up even though it failed")
    A062 "operation failed"
}
A060 { failing_operation() } A061 e { G100("caught: {e}") }

// With a function call in a loop, defer runs for every round.
A020 round_trip(n) {
    A081 G100("  round {n} finished")
    G100("round {n} started")
}
A010 n A011 1..=3 { round_trip(n) }

// --- Try it yourself ---
// 1. Write three defers and watch in which order they run.
// 2. Add a defer to a function that throws and catch the error outside: does the cleanup come before or after the error message?
