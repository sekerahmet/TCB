//! tr kodlu 3 dil=en
// 46 — Ready model and generation: loading a model in Hugging Face format and generating text.
// What it teaches: building and loading a model with hazır_model(folder, ağırlık_türü:), generating tokens with
// model.üret(start, count, sıcaklık:, en_iyi_k:, tohum:, eos:, önbellek_çeşidi:), making generation reproducible.
// Builds on: GPT and the library (41), the tokenizer (39), sampling (34).
// Run (from the project root): tr examples/en/46_ready_model_and_generation.tr
// Details: docs/guide/10_hazir_katmanlarla_gpt.md, docs/spec/15_tensorler.md §15.47, §15.45, lib/README.md (tr/hazir).
//
// Model: tests/data/hf_tiny, a small Llama with RANDOM weights, 18 KB (config.json + model.safetensors);
// it does not produce meaningful text, so the example prints token ids, not text. The same code works with a real
// model (for instance a downloaded SmolLM2-135M folder): only PATH changes. No network is needed.
// The library's own names (hazır_model, üret, ağırlık_türü ...) are not translated yet and stay in Turkish.

TR_kw_import "tr/hazir"

TR_kw_const PATH = "../../tests/data/hf_tiny"

// hazır_model builds the model (a GPT) from config.json in the folder and loads model.safetensors.
// The tokenizer is opened separately; the embedding table of this model matches the vocabulary of tests/data/tokenizer.json.
TR_kw_var model = hazır_model(PATH)
TR_kw_var tok = TR_fn_load_tokenizer("../../tests/data/tokenizer.json")
TR_kw_var param_count = 0
TR_kw_for w TR_kw_in TR_fn_parameters(model) { param_count += w.TR_mem_shape.TR_mem_reduce(1) { TR_ctx_acc * TR_ctx_it } } // product of the shape's dimensions
TR_fn_print("context:", model.ayar.bağlam, "| vocabulary:", tok.TR_mem_vocab_size, "| parameters:", param_count)

// üret(start, count): appends count tokens after the start ids and gives the whole list.
// sıcaklık: 0 picks the most likely token at every step (greedy); the same input always gives the same result.
TR_kw_var start = tok.TR_mem_encode("Bugün hava")
TR_fn_print("start:", start)
TR_kw_var greedy = model.üret(start, 6, sıcaklık: 0)
TR_fn_print("greedy:", greedy)

// sıcaklık and en_iyi_k adjust the randomness (example 34); if tohum: is given the result repeats.
TR_kw_var draw_1 = model.üret(start, 6, sıcaklık: 0.8, en_iyi_k: 5, tohum: 3)
TR_kw_var draw_2 = model.üret(start, 6, sıcaklık: 0.8, en_iyi_k: 5, tohum: 3)
TR_fn_print("sampling:", draw_1, "| same seed same result:", draw_1 == draw_2)

// eos: is a token id; when that token is produced it stays in the list and generation stops before count is reached.
TR_kw_var first_generated = greedy[start.TR_mem_length]
TR_fn_print("with eos:", model.üret(start, 6, sıcaklık: 0, eos: first_generated))

// önbellek_çeşidi: üret works with a KV cache (the start is processed once, then only the new token).
// "sabit" (default) is allocated once and written in place, "büyüyen" grows at every step, none recomputes the
// whole sequence at every step. All three give the same tokens.
TR_kw_var growing = model.üret(start, 6, sıcaklık: 0, önbellek_çeşidi: "büyüyen")
TR_kw_var uncached = model.üret(start, 6, sıcaklık: 0, önbellek_çeşidi: TR_kw_none)
TR_fn_print("the three cache kinds agree:", greedy == growing TR_kw_and growing == uncached)

// ağırlık_türü: the type of the matrix weights. Hugging Face models are mostly stored in bf16;
// "bf16" keeps the weights in half the memory (norms and calculation stay float32).
TR_kw_var smaller = hazır_model(PATH, ağırlık_türü: "bf16")
TR_fn_print("types:", TR_fn_parameters(model)[0].TR_mem_dtype, "and", TR_fn_parameters(smaller)[0].TR_mem_dtype)

// --- Try it yourself ---
// 1. Make the start tok.encode("Istanbul") and see how greedy generation changes.
// 2. Change tohum: 3 to 4: does the sampling result change? With ağırlık_türü: "bf16" is the greedy result still the same?
