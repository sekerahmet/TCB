//! tr kodlu 1
// 09 — Modules: splitting code into files and importing them.
// What it teaches: import to use the names in another .tr file, as to give an alias
// (avoids name clashes). Imported file: helpers/geometry.tr.
// Previous example: 08 (tests). Next: 10 (concurrent tasks).
// Run (from the project root): tr examples/en/09_modules.tr

A070 "helpers/geometry" // the .tr extension is optional; names are used directly
G100("area of a circle with r = 2: {G405(circle_area(2), 3)}")

A070 "helpers/geometry" A100 geo // with an alias: geo.name
G100("geo.PI = {geo.PI}")
G100("area of a circle with r = 1: {G405(geo.circle_area(1), 3)}")
