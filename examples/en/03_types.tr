//! tr kodlu 3 dil=en
// 03 — Types: every value has a type.
// What it teaches: Int, Float, String, Bool, none; type(); the int()/float()/str() conversions;
// operators and comparison; ?? for a value that may be none.
// Builds on: var, const and assignment (02).
// Run (from the project root): tr examples/en/03_types.tr

TR_kw_var age = 30 // Int: a number without a decimal point
TR_kw_var height = 1.75 // Float: a number with a point
TR_kw_var city = "Ayse" // String
TR_kw_var is_student = TR_kw_true // Bool: true or false
TR_fn_print(TR_fn_type(age), TR_fn_type(height), TR_fn_type(city), TR_fn_type(is_student))

// Conversions: text to number, number to text, float to int.
TR_fn_print(TR_fn_int("42") + 1, TR_fn_float("2.5") * 2, TR_fn_str(7) + "8")
TR_fn_print(TR_fn_int(3.9), TR_fn_round(3.14159, 2)) // int() drops what follows the point

// Arithmetic operators. / always gives a float; % is the remainder; ** is the power.
TR_fn_print(7 + 2, 7 - 2, 7 * 2, 7 / 2, 7 % 2, 2 ** 10)

// Comparison gives a Bool; and, or, not combine conditions.
TR_fn_print(age >= 18, age == 30, age != 30)
TR_fn_print(age >= 18 TR_kw_and is_student, TR_kw_not is_student, age < 18 TR_kw_or height > 1.7)

// none means "no value" (its own type, None). ?? takes the right side when the left is none.
TR_kw_var user = TR_kw_none
TR_fn_print(TR_fn_type(user), user ?? "Guest")

// --- Try it yourself ---
// 1. What do type(2 ** 10) and type(2 ** 0.5) print? Guess first, then run it.
// 2. Compare the results of "12" + 1 and int("12") + 1: one joins text, the other adds numbers.
