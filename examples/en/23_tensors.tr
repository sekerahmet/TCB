//! tr kodlu 3 dil=en
// 23 — Tensors: the number arrays of artificial intelligence.
// What it teaches: creating tensors, the Tensor type, shape, transpose, slice, concat, @ (matrix product), broadcasting, relu/softmax, reading with .tolist.
// Builds on: lists (09) and function calls (08); a tensor is built from nested lists.
// Run (from the project root): tr examples/en/23_tensors.tr
// Details: docs/guide/04_yapay_zeka_ve_veri.md §4.C, docs/spec/15_tensorler.md §15.

// A tensor is an n-dimensional array of numbers: one-dimensional (vector), two-dimensional (matrix) ...
TR_kw_var v = TR_fn_tensor([1.0, 2.0, 3.0])
TR_kw_var A = TR_fn_tensor([[1.0, 2.0], [3.0, 4.0]])
TR_kw_var W = TR_fn_tensor([[0.5, -0.5], [1.0, 2.0]]) // a matrix: a 2-dimensional tensor
TR_fn_print("v.shape = {v.TR_mem_shape}, A.shape = {A.TR_mem_shape}")
TR_fn_print("A.tolist = {A.TR_mem_tolist}") // .tolist turns the tensor into a plain TR list

// Ready-made tensor builders.
TR_fn_print(TR_fn_zeros([2, 3]))
TR_fn_print(TR_fn_ones([3]))
TR_fn_print(TR_fn_eye(3))

// Element-wise operations work on same-shaped tensors one element at a time.
TR_fn_print("A + A =", A + A)
TR_fn_print("A * W =", A * W)

// @ is the matrix product (rows × columns).
TR_fn_print("A @ W =", A @ W)

// Broadcasting: a smaller tensor is stretched to the shape of the bigger one by itself.
TR_fn_print("A + [10, 20] (added to every row) =", A + TR_fn_tensor([10.0, 20.0]))
TR_fn_print("A * 2 =", A * 2)

// Activation functions: relu zeroes the negatives, softmax gives probabilities that sum to 1.
TR_fn_print("relu(A @ W - 4) =", TR_fn_relu(A @ W - 4))
TR_fn_print("softmax([2, 1, 0.1]) =", TR_fn_softmax(TR_fn_tensor([2.0, 1.0, 0.1])))
TR_fn_print("sum:", TR_fn_sum(A), "mean:", TR_fn_mean(A))

// Type declaration: Tensor. The shape is a property of a tensor (number type and device in 33).
TR_kw_var t: TR_type_Tensor = TR_fn_tensor([[1, 2, 3], [4, 5, 6]])
TR_fn_print(TR_fn_type(t) == TR_type_Tensor, t.TR_mem_shape)

// transpose swaps the last two axes; permute puts the axes in the given order;
// slice(axis, start, end) cuts a range; concat joins a list of tensors end to end along an axis.
TR_fn_print(t.TR_mem_transpose().TR_mem_tolist)
TR_fn_print(TR_fn_zeros([2, 3, 4]).TR_mem_permute([2, 0, 1]).TR_mem_shape)
TR_fn_print(t.TR_mem_slice(1, 0, 2).TR_mem_tolist)
TR_fn_print(TR_fn_concat([TR_fn_ones([2, 1]), TR_fn_zeros([2, 2])], TR_arg_dim: -1).TR_mem_shape)

// --- Try it yourself ---
// 1. Build a 3x3 matrix and multiply it by eye(3): what is the result?
// 2. Compare the relu and sigmoid results for tensor([-2.0, 0.0, 3.0]).
