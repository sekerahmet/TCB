//! tr kodlu 3 dil=en
// 13 — Math: built-ins that calculate with numbers.
// What it teaches: min/max/abs/sign, rounding (floor, ceil, clamp), statistics (median, std), pi and
// trigonometry, exponential and logarithm functions.
// Builds on: lists (09), function calls (08), named arguments (08).
// Run (from the project root): tr examples/en/13_math.tr

// Smallest, largest, absolute value and sign. min/max take a list or several numbers.
TR_fn_print(TR_fn_min([3, 1, 2]), TR_fn_max([3, 1, 2]), TR_fn_min(4, 2.5), TR_fn_max(4, 2.5))
TR_fn_print(TR_fn_abs(-5), TR_fn_abs(-2.5), TR_fn_sign(-4), TR_fn_sign(0.0), TR_fn_sign(9))

// floor rounds down, ceil rounds up; clamp keeps a value between two limits (named arguments).
TR_fn_print(TR_fn_floor(3.7), TR_fn_ceil(3.2), TR_fn_floor(-2.5), TR_fn_ceil(-2.5))
TR_fn_print(TR_fn_clamp(15, TR_arg_max: 10), TR_fn_clamp(-3.5, TR_arg_min: 0.0), TR_fn_clamp(5, TR_arg_min: 0, TR_arg_max: 3))

// Statistics: mean, median and the (population) standard deviation.
TR_kw_var marks = [2, 4, 4, 4, 5, 5, 7, 9]
TR_fn_print(TR_fn_mean(marks), TR_fn_median(marks), TR_fn_std(marks))
TR_fn_print(TR_fn_median([3, 1, 4, 2]), TR_fn_sqrt(16))

// pi is a constant (not called). Trigonometry works in radians: 180 degrees is pi radians.
TR_fn_print(TR_fn_round(TR_const_pi, 4), TR_fn_round(TR_fn_sin(TR_const_pi / 2), 4), TR_fn_round(TR_fn_cos(TR_const_pi), 4), TR_fn_round(TR_fn_tan(TR_const_pi / 4), 4))
TR_fn_print(TR_fn_round(TR_fn_asin(1.0), 4), TR_fn_round(TR_fn_acos(0.0), 4), TR_fn_round(TR_fn_atan(1.0), 4))
TR_fn_print(TR_fn_round(TR_fn_atan2(1.0, -1.0), 4)) // the angle of the point (x, y) = (-1, 1)

// Exponential and logarithm: exp is e^x, log the natural logarithm; log2 and log10 other bases.
TR_fn_print(TR_fn_round(TR_fn_exp(1.0), 4), TR_fn_log(1.0), TR_fn_log2(8), TR_fn_log10(1000))
// log1p and expm1 are precise for small numbers: log(1 + x), e^x - 1.
TR_fn_print(TR_fn_log1p(0.000001), TR_fn_expm1(0.000001))
// Hyperbolic sine and cosine.
TR_fn_print(TR_fn_round(TR_fn_sinh(1.0), 4), TR_fn_cosh(0.0))

// --- Try it yourself ---
// 1. Compare the mean, median and standard deviation of a list: which is affected least by an outlier?
// 2. Find the angle from the legs of a triangle (3 and 4) with atan2 and turn it into degrees (with 180 / pi).
