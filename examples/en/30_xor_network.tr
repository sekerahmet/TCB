//! tr kodlu 3 dil=en
// 30 — A small neural network: a two-layer network learns XOR.
// What it teaches: a hidden layer and non-linear activation (tanh, sigmoid), building the weights as
// gradient-tracking tensors, the training loop in a multi-layer network.
// Builds on: the training loop (28); XOR cannot be solved with a single linear layer, the hidden layer makes it possible.
// Run (from the project root): tr examples/en/30_xor_network.tr

// The hidden layer is tanh, the output sigmoid; the weights are tensors trained with AdamW.
TR_kw_var x_data = TR_fn_tensor([[0, 0], [0, 1], [1, 0], [1, 1]])
TR_kw_var y_target = TR_fn_tensor([[0], [1], [1], [0]])
TR_kw_var W1 = TR_fn_tensor(TR_fn_randn([2, 8], TR_arg_seed: 42) * 0.5, TR_arg_requires_grad: TR_kw_true)
TR_kw_var b1 = TR_fn_tensor(TR_fn_zeros([8]), TR_arg_requires_grad: TR_kw_true)
TR_kw_var W2 = TR_fn_tensor(TR_fn_randn([8, 1], TR_arg_seed: 7) * 0.5, TR_arg_requires_grad: TR_kw_true)
TR_kw_var b2 = TR_fn_tensor(TR_fn_zeros([1]), TR_arg_requires_grad: TR_kw_true)
TR_kw_func net(X) {
    TR_kw_return TR_fn_sigmoid(TR_fn_tanh(X @ W1 + b1) @ W2 + b2)
}
TR_kw_var opt = TR_fn_AdamW([W1, b1, W2, b2], TR_arg_lr: 0.05, TR_arg_weight_decay: 0)
TR_kw_var first_loss = 0.0
TR_kw_for step TR_kw_in 0..800 {
    opt.TR_mem_zero_grad()
    TR_kw_var loss = TR_fn_mean((net(x_data) - y_target) ** 2)
    TR_kw_if step == 0 { first_loss = loss.TR_mem_tolist }
    TR_fn_backward(loss)
    opt.TR_mem_step()
}
TR_kw_var last_loss = TR_fn_no_grad { TR_fn_mean((net(x_data) - y_target) ** 2) }.TR_mem_tolist
TR_fn_print("first loss {TR_fn_round(first_loss, 4)} → last loss {TR_fn_round(last_loss, 6)}")

TR_fn_print("XOR predictions (expected 0, 1, 1, 0): {[TR_fn_round(t[0], 2) TR_kw_for t TR_kw_in TR_fn_no_grad { net(x_data) }.TR_mem_tolist]}")

// --- Try it yourself ---
// 1. Cut the hidden layer from 8 to 2 neurons: does the network still learn?
// 2. Print the predictions without rounding and see how close they get to 0/1.
