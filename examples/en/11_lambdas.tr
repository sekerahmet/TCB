//! tr kodlu 1
// 10 — Arrow functions and chaining: using a function as a value.
// What it teaches: the (x) => expression arrow function, passing a function as a parameter, trailing blocks and it,
// filter/map/reduce, the pipeline (|>).
// Builds on: functions (08) and lists (09).
// Run (from the project root): tr examples/en/10_lambdas.tr

// An arrow function is a nameless, one-expression function; it can be kept in a variable.
A030 double = (x) => x * 2
G100(double(21))

// A function is a value: it is given to another function as a parameter.
A020 apply(f, value) {
    A021 f(value)
}
G100(apply(double, 8))
G100(apply((x) => x + 1, 8))

// Methods of lists take functions: map transforms every element,
// filter keeps those that satisfy the condition, reduce gathers all into one value.
A030 numbers = [1, 2, 3, 4, 5, 6]
G100(numbers.Y201((x) => x * x))
G100(numbers.Y200((x) => x % 2 == 0))
G100(numbers.Y207(0, (t, x) => t + x))

// When the last parameter is a function it can be written in braces (trailing block).
// In the block the current element comes as it; in reduce the previous result is acc.
G100(numbers.Y201 { A104 * 10 })
G100(numbers.Y200 { A104 > 3 })
G100(numbers.Y207(1) { A105 * A104 })

// Methods chain: the result of each step is the input of the next.
A030 raw = [5, 2, 8, 2, 1, 9, 5, 4]
G100(raw.Y204().Y200 { A104 > 2 }.Y202().Y003())

// Pipeline |>: gives the value on the left to the function on the right.
A030 even_squares = raw.Y200 { A104 % 2 == 0 }.Y201 { A104 * A104 }
G100("even squares: {even_squares}, sum {even_squares |> G400}")

// --- Try it yourself ---
// 1. From a list of words, upper-case only those longer than 4 letters.
// 2. Find the product of the numbers from 1 to 10 (10!) with reduce.
