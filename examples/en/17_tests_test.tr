//! tr kodlu 3 dil=en
// 17 — Tests: writing tests next to the code.
// What it teaches: `test "name" { ... }` blocks, checking with assert(condition, [message]) and assert_equal(expected, actual),
// testing that an error is thrown.
// Builds on: functions, structs, lists, error handling (08–15).
// The file name ends in *_test.tr: `tr test` finds only files with that name in a folder.
// Run (from the project root):
//   tr test examples/en/17_tests_test.tr   → runs the tests, prints a summary
//   tr examples/en/17_tests_test.tr        → runs the file normally; the test blocks are skipped
// If a test fails `tr test` exits with 1; it can be used as a gate in CI.

// --- Code under test ---
TR_kw_func add(a, b) {
    TR_kw_return a + b
}

TR_kw_func average_of(items) {
    TR_kw_if items.TR_mem_length == 0 { TR_kw_throw "cannot take the average of an empty list" }
    TR_kw_return TR_fn_sum(items) / items.TR_mem_length
}

TR_kw_struct Cart {
    products = []

    TR_kw_func TR_mem_append(name, price) {
        TR_kw_self.products.TR_mem_append({"name": name, "price": price})
    }

    TR_kw_func total() {
        TR_kw_return TR_fn_sum(TR_kw_self.products.TR_mem_map { TR_ctx_it["price"] })
    }
}

// This line runs in both modes: the file itself runs before the tests.
TR_fn_print("Test blocks only run with this command: tr test examples/en/17_tests_test.tr")

// --- Tests ---
TR_ctx_test "addition" {
    TR_fn_assert_equal(4, add(2, 2))
    TR_fn_assert_equal(0, add(-1, 1))
}

TR_ctx_test "average" {
    TR_fn_assert_equal(2.5, average_of([1, 2, 3, 4]))
    TR_fn_assert(average_of([10]) == 10, "the average of one element is itself")
}

TR_ctx_test "an error is thrown for an empty list" {
    TR_kw_var message = ""
    TR_kw_try { average_of([]) } TR_kw_catch e { message = e }
    TR_fn_assert(message.TR_mem_contains("empty list"), "the expected error did not come: {message}")
}

TR_ctx_test "cart total" {
    TR_kw_var c = Cart() // every test runs in a new scope
    c.TR_mem_append("pencil", 15)
    c.TR_mem_append("notebook", 40)
    TR_fn_assert_equal(2, c.products.TR_mem_length)
    TR_fn_assert_equal(55, c.total())
}

// --- Try it yourself ---
// 1. Add one more test for add that checks negative numbers.
// 2. Write a test wrong on purpose (assert_equal(5, add(2, 2))) and see how it fails in the `tr test` output.
