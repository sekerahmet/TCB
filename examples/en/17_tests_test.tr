//! tr kodlu 2 dil=en
// 17 — Tests: writing tests next to the code.
// What it teaches: `test "name" { ... }` blocks, checking with assert(condition, [message]) and assert_equal(expected, actual),
// testing that an error is thrown.
// Builds on: functions, structs, lists, error handling (08–15).
// The file name ends in *_test.tr: `tr test` finds only files with that name in a folder.
// Run (from the project root):
//   tr test examples/en/17_tests_test.tr   → runs the tests, prints a summary
//   tr examples/en/17_tests_test.tr        → runs the file normally; the test blocks are skipped
// If a test fails `tr test` exits with 1; it can be used as a gate in CI.

// --- Code under test ---
A020 add(a, b) {
    A021 a + b
}

A020 average_of(items) {
    A001 items.Y001 == 0 { A062 "cannot take the average of an empty list" }
    A021 G400(items) / items.Y001
}

A050 Cart {
    products = []

    A020 Y004(name, price) {
        A051.products.Y004({"name": name, "price": price})
    }

    A020 total() {
        A021 G400(A051.products.Y201 { A104["price"] })
    }
}

// This line runs in both modes: the file itself runs before the tests.
G100("Test blocks only run with this command: tr test examples/en/17_tests_test.tr")

// --- Tests ---
A101 "addition" {
    G701(4, add(2, 2))
    G701(0, add(-1, 1))
}

A101 "average" {
    G701(2.5, average_of([1, 2, 3, 4]))
    G700(average_of([10]) == 10, "the average of one element is itself")
}

A101 "an error is thrown for an empty list" {
    A030 message = ""
    A060 { average_of([]) } A061 e { message = e }
    G700(message.Y002("empty list"), "the expected error did not come: {message}")
}

A101 "cart total" {
    A030 c = Cart() // every test runs in a new scope
    c.Y004("pencil", 15)
    c.Y004("notebook", 40)
    G701(2, c.products.Y001)
    G701(55, c.total())
}

// --- Try it yourself ---
// 1. Add one more test for add that checks negative numbers.
// 2. Write a test wrong on purpose (assert_equal(5, add(2, 2))) and see how it fails in the `tr test` output.
