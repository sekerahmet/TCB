//! tr kodlu 3 dil=en
// 34 — Sampling: choosing from the output of a model.
// What it teaches: choosing an index from a logit distribution with sample, adjusting the randomness with temperature: and
// top_k:, making the result reproducible with seed:.
// Builds on: softmax (23), selecting and sorting (25), loops (07).
// Run (from the project root): tr examples/en/34_sampling.tr

// A language model produces a score (logit) for every word at each step. Taking the most likely (argmax) always gives
// the same text; sample picks an index from the scores with probability.
TR_kw_var logit = TR_fn_tensor([1.0, 3.0, 0.5])
TR_fn_print("probabilities:", TR_fn_softmax(logit).TR_mem_tolist)

// temperature: divides the logits. 0 always picks the most likely; a small value pulls toward the most likely, a large one spreads.
TR_fn_print("temperature 0 ->", TR_fn_sample(logit, TR_arg_temperature: 0).TR_mem_tolist)

// seed: the same seed gives the same result (reproducibility).
TR_fn_print(TR_fn_sample(logit, TR_arg_seed: 7).TR_mem_tolist, TR_fn_sample(logit, TR_arg_seed: 7).TR_mem_tolist)

// top_k: limits the choice to the k most likely classes; 1 leaves only the most likely.
TR_fn_print("top_k 1 ->", TR_fn_sample(logit, TR_arg_top_k: 1).TR_mem_tolist)
TR_fn_print(TR_fn_sample(logit, TR_arg_temperature: 0.8, TR_arg_top_k: 2, TR_arg_seed: 7).TR_mem_tolist)

// A batch of samples: change the seed, take 8 samples and count how often each class comes.
TR_kw_var counts = [0, 0, 0]
TR_kw_for trial TR_kw_in 1..=8 { // at a high temperature the distribution spreads
    TR_kw_var chosen = TR_fn_sample(logit, TR_arg_temperature: 3.0, TR_arg_seed: trial).TR_mem_tolist
    counts[chosen] += 1
}
TR_fn_print("class counts in 8 samples (temperature 3):", counts)

// --- Try it yourself ---
// 1. Take 8 samples with temperature: 5.0: how does the distribution change?
// 2. Check with top_k: 2 that the least likely class is never chosen.
