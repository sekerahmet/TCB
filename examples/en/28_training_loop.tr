//! tr kodlu 2 dil=en
// 28 — The training loop: a model learning from data.
// What it teaches: giving the weights fixed starting values, the AdamW optimizer, the loop
// prediction → loss → backward → step, zero_grad, reading the learned values.
// Builds on: tensors (23), automatic differentiation (26), loops (07).
// Run (from the project root): tr examples/en/28_training_loop.tr

// Task: find the line y = 2x - 1 from points. Model: y_pred = x @ w + b.
A030 X = T100([[0], [1], [2], [3]])
A030 Y = T100([[-1], [1], [3], [5]])
A030 w = T100([[0.0]], T900: A040) // the slope to be learned
A030 b = T100([0.0], T900: A040) // the offset to be learned

// The optimizer looks at the gradient and updates the weights in the direction that lowers the loss.
// lr (learning rate) is the size of the step: too large and it diverges, too small and it learns slowly.
A030 optimizer = T400([w, b], T910: 0.1, T911: 0)

A010 step A011 0..300 {
    optimizer.Y501() // 1) gradients accumulate, reset first
    A030 diff = X @ w + b - Y // 2) prediction and error
    A030 loss = G410(diff ** 2) // 3) loss: mean squared error
    T300(loss) // 4) compute the gradients
    optimizer.Y500() // 5) update the weights
    A001 step % 50 == 0 {
        G100("step {step}: loss = {G405(loss.Y404, 5)}")
    }
}
G100("w = {G405(w.Y404[0][0], 3)}, b = {G405(b.Y404[0], 3)} (expected 2, -1)")

// A trained model is used without tracking.
G100("prediction for x = 10: {G405(T301 { T100([[10]]) @ w + b }.Y404[0][0], 2)}")

// --- Try it yourself ---
// 1. Set lr to 0.001 and to 1.0: how does the loss change?
// 2. Replace Y with the values of the line 3x + 2 and watch w and b approach 3 and 2.
