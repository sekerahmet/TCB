// 08 — Veri ile eğitim: parçalayıcı ve veri yükleyiciyle uçtan uca küçük bir dil modeli.
// Öğrettikleri: tokenizer.json yükleyip metni kodlamak/çözmek, .npy veri dosyalarından
// örnekleyiciyle rastgele toplu işler almak, sıralı okuyucuyla doğrulamak, üretilen
// parçaları metne çevirmek. Ayrıntılar: docs/guide/04_yapay_zeka_ve_veri.md §4.D, docs/spec/16_veri_parcalayici.md §16.
//
// Varsayılan olarak depodaki sentetik test verisini (tests/data) kullanır. Kendi
// verinizle çalıştırmak için aşağıdaki üç yolu kendi dosyalarınıza çevirin, ör.:
//     değişken PARÇALAYICI_YOLU = "D:/veri/tokenizer.json"
//     değişken VERİ_YOLU = "D:/veri/train"          // .npy veri dosyalarının klasörü
//     değişken DOĞRULAMA_YOLU = "D:/veri/valid"
// Veri dosyaları standart .npy biçiminde parça kimliği dosyalarıdır (tek boyutlu uint16/uint32/int32 diziler); meta.json
// varsa veri dosyalarının parça sayıları oradan okunur. Veri yavaş bir sürücüdeyse (ağ ya da bulut)
// yerel önbellek kullanın: veri_kümesi(VERİ_YOLU, önbellek: "onbellek/veri", kota_gb: 20)
// Göreli yollar önce çalışma klasörüne, sonra bu dosyanın klasörüne göre çözülür.
// Çalıştırma (proje kökünden): tr examples/08_veri_ile_egitim.tr
// Ayarlar komut satırından değişir (docs/guide/04_yapay_zeka_ve_veri.md §4.E):
//     tr examples/08_veri_ile_egitim.tr --adım 500 --günlük_dosyası kayit/egitim.jsonl
//     tr examples/08_veri_ile_egitim.tr --yardım

değişken PARÇALAYICI_YOLU = "../tests/data/parcalayici.json"
değişken VERİ_YOLU = "../tests/data/text"
değişken DOĞRULAMA_YOLU = "../tests/data/text"

değişken ayar = komut_satırı({adım: 150, toplu: 8, bağlam: 32, öğrenme_oranı: 0.01, günlük_dosyası: yok},
    açıklama: "Sentetik metin verisiyle küçük bir dil modelini eğitir",
    açıklamalar: {adım: "eğitim adımı sayısı", toplu: "toplu iş başına satır", bağlam: "satır başına parça",
        günlük_dosyası: "her adımın kaybının yazılacağı .jsonl dosyası"})
değişken ADIM = ayar.adım
değişken TOPLU = ayar.toplu
değişken BAĞLAM = ayar.bağlam
değişken D = 32 // gömme boyutu
değişken GİZLİ = 64 // ara katman boyutu

// --- Parçalayıcı ---
değişken p = parçalayıcı_yükle(PARÇALAYICI_YOLU)
yazdır(p)
değişken cümle = "Bugün hava çok güzel."
değişken kimlikler = p.kodla(cümle)
yazdır("\"{cümle}\" → {kimlikler.uzunluk} parça: {kimlikler}")
yazdır("geri çözülen: {p.çöz(kimlikler)}")
değişken V = p.dağarcık_boyutu

// --- Veri ---
değişken küme = veri_kümesi(VERİ_YOLU)
yazdır(küme)
değişken ö = küme.örnekleyici(toplu: TOPLU, bağlam: BAĞLAM, tohum: 1)

// --- Model: gömme → ara katman → dağarcık üzerinde dağılım (bir sonraki parça yalnızca
// şimdiki parçaya bakılarak tahmin edilir; dikkatli bir model için examples/06_transformer.tr) ---
değişken ağırlıklar = []
değişken parametre_tohumu = 0
fonksiyon parametre(şekil, ölçek) {
    parametre_tohumu += 1
    değişken w = tensör(türevsiz(rastgele_normal(şekil, tohum: parametre_tohumu) * ölçek), türev_izle: doğru)
    ağırlıklar.ekle(w)
    sonuç w
}
değişken E = parametre([V, D], 0.1)
değişken W1 = parametre([D, GİZLİ], 0.1)
değişken W2 = parametre([GİZLİ, V], 0.1)

fonksiyon ileri(giriş) {
    sonuç gelu(gömme(E, giriş) @ W1) @ W2
}

// --- Eğitim ---
değişken iyileştirici = AdamW(ağırlıklar, öğrenme_oranı: ayar.öğrenme_oranı, ağırlık_çürümesi: 0.0)
// İlerleme çubuğu (standart hataya): adım, kayıp, adım hızı ve kalan süre. Günlük dosyası
// verildiyse her adımın kaybı oraya da yazılır.
değişken g = eğer ayar.günlük_dosyası != yok { günlük(ayar.günlük_dosyası) } değilse { yok }
değişken ç = ilerleme(ADIM, günlük: g)
değişken son_kayıp = 0.0
döngü adım içinde 0..ADIM {
    değişken giriş, hedef = ö.sonraki()
    iyileştirici.sıfırla()
    değişken kayıp = çapraz_entropi(ileri(giriş), hedef)
    geri_yayılım(kayıp)
    iyileştirici.adım()
    ç.güncelle({kayıp: kayıp})
    son_kayıp = kayıp.değer
}
yazdır("eğitim bitti: son kayıp = {yuvarla(son_kayıp, 3)}")
yazdır(ö)

// --- Doğrulama: tüm doğrulama verisi sırayla, bir kez ---
değişken doğrulama = veri_kümesi(DOĞRULAMA_YOLU).sıralı(toplu: TOPLU, bağlam: BAĞLAM)
değişken toplam_kayıp = 0.0
değişken toplu_sayısı = 0
türevsiz {
    döngü {
        değişken iş = doğrulama.sonraki()
        eğer iş == yok { çık }
        toplam_kayıp += çapraz_entropi(ileri(iş[0]), iş[1]).değer
        toplu_sayısı += 1
    }
}
yazdır("doğrulama: {toplu_sayısı} toplu iş, ortalama kayıp = {yuvarla(toplam_kayıp / toplu_sayısı, 3)}")

// --- Metin üretimi: her adımda en olası parça ---
değişken üretilen = p.kodla("Bugün")
türevsiz {
    döngü n içinde 0..12 {
        üretilen.ekle(maks_indeks(ileri([üretilen]), eksen: -1).değer[0].son)
    }
}
yazdır("model şunu yazdı: {p.çöz(üretilen)}")
