// tr/iyilestirici — Muon ve NorMuon iyileştiricileri, parametre grupları ve öğrenme oranı planı.
//
// Kullanım:   aktar "tr/iyilestirici"
//             değişken op = MuonVeAdamW(model)            // gizli 2B ağırlıklar Muon, öbürleri AdamW
//             op.sıfırla(); geri_yayılım(kayıp); op.adım()
// Bu iyileştiriciler TR ile yazılmıştır: parametreyi türev izlemeden, yerinde güncellerler
// (`türevsiz { p[0..p.şekil[0]] -= ... }`, dil tanımı 15.3 ve 15.7). Kendi yönteminizi denemek için bu
// dosyayı kopyalayıp değiştirin.
//
// Ağırlık düzeni: katmanlar `x @ W` yazar, W [giriş, çıkış] şeklindedir; bir "nöron" W'nin bir
// sütunudur (ağırlığı [çıkış, giriş] tutan düzende bir satır).
//
// Kontrol noktası: iyileştiricinin durum tensörleri (`op.muon.durum`) türev izleyen tensörler
// olarak kurulur (hiç gradyan almazlar); `kontrol_noktası` bugün yalnızca türev izleyen
// tensörleri model olarak sakladığından durum böylece kaydedilip geri yüklenebilir:
//     kontrol_noktası(koşu, {model: model, adamw: op.adamw, muon: op.muon.durum, ...})

// Newton–Schulz katsayıları (Muon'un yaygın kullanılan beşinci derece yinelemesi). Tam dik
// matrise yakınsamaz; tekil değerleri yaklaşık [0.7, 1.2] aralığına toplar, bu da güncelleme
// için yeterlidir ve 5 adımda biter.
sabit NS_A = 3.4445
sabit NS_B = -4.7750
sabit NS_C = 2.0315

// dikleştir: G'nin (2 boyutlu) yaklaşık dik eşini verir: G = U S Vᵀ ise ≈ U Vᵀ. Önce Frobenius
// normuna bölünür (tekil değerler ≤ 1), sonra X ← a·X + (b·A + c·A²)·X, A = X·Xᵀ yinelenir.
// Uzun matris (satır > sütun) devrik alınarak işlenir: A küçük kare matris olur.
fonksiyon dikleştir(G, adım_sayısı = 5) {
    değişken devrik = G.şekil[0] > G.şekil[1]
    değişken X = eğer devrik { G.devrik() } değilse { G }
    X = X / (karekök(toplam(X * X)) + 0.0000001)
    döngü i içinde 0..adım_sayısı {
        değişken A = X @ X.devrik()
        X = NS_A * X + (NS_B * A + NS_C * (A @ A)) @ X
    }
    eğer devrik { sonuç X.devrik() }
    sonuç X
}

// durum_tensörü p ile aynı şekilde ve cihazda, sıfırla başlayan bir durum tensörü kurar
// (türev izler ki kontrol noktası saklayabilsin; gradyan almaz, yalnızca türevsiz güncellenir).
fonksiyon durum_tensörü(şekil, cihaz) {
    sonuç tensör(sıfırlar(şekil).cihaza(cihaz), türev_izle: doğru)
}

// gradyanları_sıfırla ağırlıkların biriken gradyanlarını yerinde sıfırlar.
fonksiyon gradyanları_sıfırla(ağırlıklar) {
    türevsiz {
        döngü p içinde ağırlıklar {
            değişken g = p.gradyan
            eğer g != yok { g[0..g.şekil[0]] = 0.0 }
        }
    }
}

// yalnızca_2b ağırlıkların hepsinin 2 boyutlu olduğunu denetler.
fonksiyon yalnızca_2b(ad, ağırlıklar) {
    döngü i, p içinde ağırlıklar {
        doğrula(p.şekil.uzunluk == 2, "{ad} yalnızca 2 boyutlu ağırlıklar içindir; {i}. ağırlığın şekli {p.şekil} (gömme, çıkış, norm ve sapma ağırlıklarını AdamW'ye verin: parametre_grupları)")
    }
}

// Muon (MomentUm Orthogonalized by Newton-Schulz). Kaynak: K. Jordan ve diğ., "Muon: An
// optimizer for hidden layers in neural networks", 2024, kellerjordan.github.io/posts/muon.
// Her adımda, her W [giriş, çıkış] için:
//   m ← β·m + (1 − β)·g                      (momentum; varsayılan β = 0.95)
//   u ← β·m + (1 − β)·g  (nesterov) ya da m
//   W ← W·(1 − η·λ) − η · √max(1, çıkış / giriş) · dikleştir(u)
// Ölçek düzeltmesi √max(1, çıkış/giriş), [çıkış, giriş] düzenindeki √max(1, satır/sütun)'un bu düzendeki
// karşılığıdır. Yalnızca gizli katmanların 2 boyutlu ağırlıkları içindir; varsayılan öğrenme
// oranı 0.02'dir (güncellemenin büyüklüğü AdamW'ninkinden farklıdır, oranlar ayrı ayarlanır).
yapı Muon {
    ağırlıklar
    öğrenme_oranı = 0.02
    momentum = 0.95
    nesterov = doğru
    ağırlık_çürümesi = 0.0
    ns_adımı = 5
    ölçekler
    durum
    fonksiyon kurucu(ağırlıklar, öğrenme_oranı = 0.02, momentum = 0.95, nesterov = doğru, ağırlık_çürümesi = 0.0, ns_adımı = 5) {
        yalnızca_2b("Muon", ağırlıklar)
        kendi.ağırlıklar = ağırlıklar
        kendi.öğrenme_oranı = öğrenme_oranı
        kendi.momentum = momentum
        kendi.nesterov = nesterov
        kendi.ağırlık_çürümesi = ağırlık_çürümesi
        kendi.ns_adımı = ns_adımı
        kendi.ölçekler = [karekök(maks(1.0, p.şekil[1] / p.şekil[0])) döngü p içinde ağırlıklar]
        kendi.durum = {momentum: [durum_tensörü(p.şekil, p.cihaz) döngü p içinde ağırlıklar]}
    }
    fonksiyon adım() {
        değişken b = kendi.momentum
        türevsiz {
            döngü i, p içinde kendi.ağırlıklar {
                değişken g = p.gradyan
                eğer g == yok { devam }
                değişken m = kendi.durum.momentum[i]
                m[0..m.şekil[0]] = b * m + (1 - b) * g
                değişken u = eğer kendi.nesterov { b * m + (1 - b) * g } değilse { m }
                eğer kendi.ağırlık_çürümesi > 0 { p[0..p.şekil[0]] = p * (1 - kendi.öğrenme_oranı * kendi.ağırlık_çürümesi) }
                p[0..p.şekil[0]] -= (kendi.öğrenme_oranı * kendi.ölçekler[i]) * dikleştir(u, kendi.ns_adımı)
            }
        }
    }
    fonksiyon sıfırla() { gradyanları_sıfırla(kendi.ağırlıklar) }
}

// NorMuon: Muon + nöron başına uyarlanır ikinci moment normalleştirmesi. Kaynak: Z. Li, L. Liu,
// C. Liang, W. Chen, T. Zhao, "NorMuon: Making Muon more efficient and scalable", 2025,
// arXiv:2510.05491 (Algoritma 1). Her W [giriş, çıkış] (m = giriş, n = çıkış) için:
//   M ← β1·M + (1 − β1)·g
//   O ← dikleştir(M)
//   v ← β2·v + (1 − β2)·ortalama(O², her nöron için)     (v [1, çıkış]: nöron başına bir sayı)
//   Ô ← O / (√v + ε)
//   η̂ ← 0.2 · η · √(m·n) / ‖Ô‖_F                         (güncellemenin RMS'i AdamW'ninkine yakın)
//   W ← W − η·λ·W − η̂·Ô
// Makaledeki gibi momentum Nesterov'suzdur ve sapma düzeltmesi yoktur. Varsayımlar (makalede
// sayı verilmeyenler): ε = 1e-8; varsayılan öğrenme oranı 0.003 bu kitaplığın seçimidir (oran
// AdamW ölçeğindedir: makalede 124M'lik modelde 3.6e-4, 1.1B'de 4e-4 kullanılmış).
yapı NorMuon {
    ağırlıklar
    öğrenme_oranı = 0.003
    beta1 = 0.95
    beta2 = 0.95
    epsilon = 0.00000001
    ağırlık_çürümesi = 0.0
    ns_adımı = 5
    durum
    fonksiyon kurucu(ağırlıklar, öğrenme_oranı = 0.003, beta1 = 0.95, beta2 = 0.95, epsilon = 0.00000001, ağırlık_çürümesi = 0.0, ns_adımı = 5) {
        yalnızca_2b("NorMuon", ağırlıklar)
        kendi.ağırlıklar = ağırlıklar
        kendi.öğrenme_oranı = öğrenme_oranı
        kendi.beta1 = beta1
        kendi.beta2 = beta2
        kendi.epsilon = epsilon
        kendi.ağırlık_çürümesi = ağırlık_çürümesi
        kendi.ns_adımı = ns_adımı
        kendi.durum = {
            momentum: [durum_tensörü(p.şekil, p.cihaz) döngü p içinde ağırlıklar],
            ikinci_moment: [durum_tensörü([1, p.şekil[1]], p.cihaz) döngü p içinde ağırlıklar]
        }
    }
    fonksiyon adım() {
        değişken oran = kendi.öğrenme_oranı
        türevsiz {
            döngü i, p içinde kendi.ağırlıklar {
                değişken g = p.gradyan
                eğer g == yok { devam }
                değişken M = kendi.durum.momentum[i]
                değişken v = kendi.durum.ikinci_moment[i]
                M[0..M.şekil[0]] = kendi.beta1 * M + (1 - kendi.beta1) * g
                değişken O = dikleştir(M, kendi.ns_adımı)
                v[0..1] = kendi.beta2 * v + (1 - kendi.beta2) * ortalama(O * O, eksen: 0, boyutu_koru: doğru)
                değişken N = O / (karekök(v) + kendi.epsilon)
                değişken adım_oranı = 0.2 * oran * karekök(p.şekil[0] * p.şekil[1]) / karekök(toplam(N * N))
                eğer kendi.ağırlık_çürümesi > 0 { p[0..p.şekil[0]] = p * (1 - oran * kendi.ağırlık_çürümesi) }
                p[0..p.şekil[0]] -= adım_oranı * N
            }
        }
    }
    fonksiyon sıfırla() { gradyanları_sıfırla(kendi.ağırlıklar) }
}

// parametre_grupları modelin parametrelerini ikiye ayırır: {gizli: [...], diğer: [...]}.
// gizli: 2 boyutlu ağırlıklar (Muon/NorMuon'a); diğer: 2 boyutlu olmayanlar (norm ağırlıkları,
// sapmalar) ve adı `ayrı`daki bir alanla başlayanlar (gömme tablosu, çıkış katmanı: AdamW'ye).
// Adlar parametreler(model, adlarıyla: doğru) adlarıdır ("gömme.tablo", "çıkış.ağırlık").
fonksiyon parametre_grupları(model, ayrı = ["gömme", "çıkış"]) {
    değişken gizli = []
    değişken diğer = []
    döngü ad, p içinde parametreler(model, adlarıyla: doğru) {
        eğer p.şekil.uzunluk == 2 ve değil ayrı.içerir(ad.böl(".")[0]) { gizli.ekle(p) } değilse { diğer.ekle(p) }
    }
    sonuç {gizli: gizli, diğer: diğer}
}

// MuonVeAdamW: gizli 2B ağırlıklar Muon (ya da normuon: doğru ile NorMuon), öbürleri AdamW ile.
// oran_çarpanı (planın çarpanı, oran_planı; pozitif) iki grubun öğrenme oranını birlikte
// ölçekler: her adımda Muon'un ve AdamW'nin oranı (op.adamw.öğrenme_oranı, dil tanımı 15.39)
// taban oranla çarpanın çarpımına ayarlanır.
yapı MuonVeAdamW {
    muon
    adamw
    muon_oranı
    adamw_oranı
    oran_çarpanı = 1.0
    fonksiyon kurucu(model, muon_oranı = yok, adamw_oranı = 0.003, ağırlık_çürümesi = 0.0, normuon = yanlış, ayrı = ["gömme", "çıkış"], beta2 = 0.95) {
        değişken gruplar = parametre_grupları(model, ayrı: ayrı)
        eğer muon_oranı == yok { muon_oranı = eğer normuon { 0.003 } değilse { 0.02 } }
        kendi.muon_oranı = muon_oranı
        kendi.adamw_oranı = adamw_oranı
        kendi.muon = eğer normuon {
            NorMuon(gruplar.gizli, öğrenme_oranı: muon_oranı, ağırlık_çürümesi: ağırlık_çürümesi)
        } değilse {
            Muon(gruplar.gizli, öğrenme_oranı: muon_oranı, ağırlık_çürümesi: ağırlık_çürümesi)
        }
        kendi.adamw = AdamW(gruplar.diğer, öğrenme_oranı: adamw_oranı, ağırlık_çürümesi: 0.0, beta1: 0.9, beta2: beta2)
    }
    fonksiyon çarpan_ayarla(çarpan) {
        doğrula(çarpan > 0, "MuonVeAdamW: oran çarpanı pozitif olmalı, {çarpan} verildi")
        kendi.oran_çarpanı = çarpan
    }
    fonksiyon adım() {
        değişken c = kendi.oran_çarpanı
        kendi.muon.öğrenme_oranı = kendi.muon_oranı * c
        kendi.adamw.öğrenme_oranı = kendi.adamw_oranı * c
        kendi.muon.adım()
        kendi.adamw.adım()
    }
    fonksiyon sıfırla() {
        kendi.muon.sıfırla()
        kendi.adamw.sıfırla()
    }
}

// oran_planı: "ısınma, sabit, azalma" (WSD) öğrenme oranı çarpanı, adım 0'dan sayılır.
// İlk `ısınma` adımda 0'dan 1'e doğrusal artar, sonra 1'de kalır, son `azalma` oranındaki
// adımlarda (0.2: son %20) doğrusal olarak en_az'a iner.
fonksiyon oran_planı(adım, toplam, ısınma = 0, azalma = 0.2, en_az = 0.0) {
    eğer adım < ısınma { sonuç 1.0 * (adım + 1) / ısınma }
    değişken azalma_adımı = tam(toplam * azalma)
    değişken baş = toplam - azalma_adımı
    eğer adım < baş veya azalma_adımı == 0 { sonuç 1.0 }
    sonuç en_az + (1.0 - en_az) * (toplam - adım) / azalma_adımı
}
