{
  "name": "tr-dili-vscode",
  "displayName": "TR (.tr) Programlama ve Yapay Zeka Dili",
  "description": "TR (.tr) dili için sözdizimi renklendirme (Syntax Highlighting), kod şablonları (Snippets), çalıştırma ve hata ayıklama komutları.",
  "version": "1.3.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tr",
    "onCommand:tr.calistir",
    "onCommand:tr.denetle",
    "onCommand:tr.hataAyikla",
    "onCommand:tr.gorselHataAyikla",
    "onTaskType:tr",
    "onDebugResolve:tr",
    "onDebugInitialConfigurations",
    "onDebugDynamicConfigurations:tr",
    "onCommand:tr.hataAyiklaBaslat",
    "onCommand:tr.tabloGoster"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Güvenilmeyen çalışma alanlarında yalnızca renklendirme ve şablonlar çalışır; .tr dosyaları çalıştırılmaz.",
      "restrictedConfigurations": [
        "tr.yorumlayiciYolu"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "tr",
        "aliases": [
          "TR Dili",
          "TR",
          "tr"
        ],
        "extensions": [
          ".tr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tr",
        "scopeName": "source.tr",
        "path": "./syntaxes/tr.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tr",
        "path": "./snippets/tr.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "tr.calistir",
        "title": "Dosyayı Çalıştır",
        "category": "TR",
        "icon": "$(play)"
      },
      {
        "command": "tr.hataAyiklaBaslat",
        "title": "Hata Ayıkla (VS Code)",
        "category": "TR",
        "icon": "$(debug-alt)"
      },
      {
        "command": "tr.denetle",
        "title": "Dosyayı Denetle",
        "category": "TR",
        "icon": "$(check)"
      },
      {
        "command": "tr.hataAyikla",
        "title": "Terminal Hata Ayıklayıcısında Aç",
        "category": "TR",
        "icon": "$(terminal)"
      },
      {
        "command": "tr.gorselHataAyikla",
        "title": "Görsel Hata Ayıklayıcı (Tarayıcı)",
        "category": "TR",
        "icon": "$(browser)"
      },
      {
        "command": "tr.tabloGoster",
        "title": "Tablo Görünümü (ALV)",
        "category": "TR",
        "icon": "$(table)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tr.calistir",
          "when": "editorLangId == tr && !inDebugMode",
          "group": "navigation@1"
        },
        {
          "command": "tr.hataAyiklaBaslat",
          "when": "editorLangId == tr && !inDebugMode",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "tr.calistir",
          "when": "editorLangId == tr",
          "group": "1_tr@1"
        },
        {
          "command": "tr.hataAyiklaBaslat",
          "when": "editorLangId == tr",
          "group": "1_tr@1"
        },
        {
          "command": "tr.denetle",
          "when": "editorLangId == tr",
          "group": "1_tr@2"
        },
        {
          "command": "tr.hataAyikla",
          "when": "editorLangId == tr",
          "group": "1_tr@3"
        },
        {
          "command": "tr.gorselHataAyikla",
          "when": "editorLangId == tr",
          "group": "1_tr@4"
        }
      ],
      "commandPalette": [
        {
          "command": "tr.calistir",
          "when": "editorLangId == tr"
        },
        {
          "command": "tr.denetle",
          "when": "editorLangId == tr"
        },
        {
          "command": "tr.hataAyikla",
          "when": "editorLangId == tr"
        },
        {
          "command": "tr.gorselHataAyikla",
          "when": "editorLangId == tr"
        },
        {
          "command": "tr.hataAyiklaBaslat",
          "when": "editorLangId == tr"
        },
        {
          "command": "tr.tabloGoster",
          "when": "debugType == 'tr' && inDebugMode"
        }
      ],
      "debug/variables/context": [
        {
          "command": "tr.tabloGoster",
          "when": "debugType == 'tr'",
          "group": "navigation"
        }
      ],
      "debug/watch/context": [
        {
          "command": "tr.tabloGoster",
          "when": "debugType == 'tr'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "TR Dili",
      "properties": {
        "tr.yorumlayiciYolu": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "TR yorumlayıcısının (`tr.exe`) yolu. Göreli yollar çalışma alanı klasörüne göre çözülür. Boş bırakılırsa sırasıyla çalışma alanı klasöründeki `tr.exe`, dosyanın dizininden yukarı doğru bulunan ilk `tr.exe` ve PATH üzerindeki `tr` kullanılır."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "tr",
        "required": [
          "komut"
        ],
        "properties": {
          "komut": {
            "type": "string",
            "enum": [
              "tr.calistir",
              "tr.denetle",
              "tr.hataAyikla",
              "tr.gorselHataAyikla"
            ],
            "description": "Çalıştırılacak TR komutu."
          },
          "dosya": {
            "type": "string",
            "description": "Çalıştırılacak .tr dosyasının tam yolu. Boş bırakılırsa etkin düzenleyicideki dosya kullanılır."
          }
        }
      }
    ],
    "configurationDefaults": {
      "[tr]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": true
      }
    },
    "debuggers": [
      {
        "type": "tr",
        "label": "TR Dili",
        "languages": [
          "tr"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Hata ayıklanacak .tr dosyası",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "true ise program ilk satırda durur",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "Programın çalışma klasörü (göreli dosya yolları buna göre çözülür)",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tr",
            "request": "launch",
            "name": "TR: Hata Ayıkla",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "TR: Hata Ayıkla",
            "description": "Açık .tr dosyasında VS Code hata ayıklayıcısını başlatır",
            "body": {
              "type": "tr",
              "request": "launch",
              "name": "TR: Hata Ayıkla",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "tr"
      }
    ]
  }
}
