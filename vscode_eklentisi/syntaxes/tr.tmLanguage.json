{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TR Dili",
  "scopeName": "source.tr",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tr",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.tr",
          "match": "#.*$"
        },
        {
          "name": "comment.block.tr",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tr",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tr",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.tr",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.tr" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.tr" } },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.tr",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tr",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tr",
          "match": "\\b(eğer|eger|değilse|degilse|eşle|esle|varsayılan|varsayilan|döngü|dongu|içinde|icinde|iken|çık|cik|kır|kir|devam|sonuç|sonuc|döndür|dondur|dene|yakala|fırlat|firlat|aktar|eşzamanlı|eszamanli|ertele|kesme_noktası|kesme_noktasi)\\b"
        },
        {
          "name": "storage.type.tr",
          "match": "\\b(değişken|degisken|sabit|fonksiyon|işlev|islev|yapı|yapi|sınıf|sinif)\\b"
        },
        {
          "name": "variable.language.self.tr",
          "match": "\\b(kendi)\\b"
        },
        {
          "name": "constant.language.boolean.tr",
          "match": "\\b(doğru|dogru|yanlış|yanlis|yok|ve|veya|değil|degil)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.tr",
          "match": "\\b(Tam|Ondalık|Ondalik|Metin|Mantık|Mantik|Liste|Sözlük|Sozluk|Matris|Tensör|Tensor|SinirAğı|Herhangi)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.tr",
          "match": "\\b(yazdır|yazdir|yaz|girdi|oku|uzunluk|boy|tip|tur|tam|ondalık|ondalik|metin|filtrele|haritala|indirge|sırala|sirala|ekle|aralık|aralik|toplam|min|maks|mutlak|karekök|karekok|yuvarla|bekle|bekle_hepsi|zaman_ms|dosya_oku|dosya_yaz|web_al|web_gönder|web_gonder|json_çöz|json_coz|json_yap)\\b"
        },
        {
          "name": "support.function.ai.tr",
          "match": "\\b(matris|sıfırlar|sifirlar|birler|birim_matris|rastgele_matris|devrik|tensör|tensor|geri_yayılım|geri_yayilim|relu|sigmoid|tanh|softmax|kayıp_mse|kayip_mse|sinir_ağı|sinir_agi|model_yükle|model_yukle|ortalama|standart_sapma|medyan|normalize_et|nokta_çarpım|nokta_carpim|kosinüs_benzerliği|kosinus_benzerligi|öklid_uzaklığı|oklid_uzakligi|json_çöz|json_coz|json_metin|csv_oku|tablo_oku|yz_sor|python_çalıştır|python_calistir|web_al|web_gönder|web_gonder)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tr",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.tr",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tr",
          "match": "(\\bve\\b|\\bveya\\b|\\bdeğil\\b|\\|>=?|\\?\\?|\\?\\.|=>|:=|\\.\\.=|\\.\\.|\\*\\*|@|==|!=|<=|>=|\\+=|-=|\\*=|/=|[+\\-*/%<>!=])"
        }
      ]
    }
  }
}
