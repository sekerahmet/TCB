{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TR Dili",
  "scopeName": "source.tr",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#import" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#pronoun" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tr",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.tr",
          "match": "#.*$"
        },
        {
          "name": "comment.block.tr",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tr",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.tr" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.tr" } },
          "patterns": [
            { "include": "#string-content" }
          ]
        },
        {
          "name": "string.quoted.single.tr",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.tr" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.tr" } },
          "patterns": [
            { "include": "#string-content" }
          ]
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "constant.character.escape.brace.tr",
          "match": "\\\\[{}]"
        },
        {
          "name": "constant.character.escape.tr",
          "match": "\\\\."
        },
        { "include": "#interpolation" }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.tr",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.tr" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.tr" } },
      "contentName": "meta.embedded.expression.tr",
      "patterns": [
        { "include": "#nested-braces" },
        { "include": "$self" }
      ]
    },
    "nested-braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.tr" } },
      "endCaptures": { "0": { "name": "punctuation.section.braces.end.tr" } },
      "patterns": [
        { "include": "#nested-braces" },
        { "include": "$self" }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(aktar)\\b\\s*(\"[^\"]*\"|'[^']*'|[^\\W\\d][\\w.]*)\\s+(olarak|as)\\b\\s*([^\\W\\d]\\w*)?",
          "captures": {
            "1": { "name": "keyword.control.import.tr" },
            "2": { "name": "string.other.module.tr" },
            "3": { "name": "keyword.control.import.as.tr" },
            "4": { "name": "entity.name.namespace.tr" }
          }
        },
        {
          "name": "keyword.control.import.tr",
          "match": "\\b(aktar)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fonksiyon|işlev|islev)\\s+([^\\W\\d]\\w*)",
          "captures": {
            "1": { "name": "storage.type.function.tr" },
            "2": { "name": "entity.name.function.tr" }
          }
        },
        {
          "match": "\\b(yapı|yapi|sınıf|sinif)\\s+([^\\W\\d]\\w*)",
          "captures": {
            "1": { "name": "storage.type.struct.tr" },
            "2": { "name": "entity.name.type.tr" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tr",
          "match": "\\b(eğer|eger|değilse|degilse|eşle|esle|varsayılan|varsayilan|döngü|dongu|içinde|icinde|iken|çık|cik|kır|kir|devam|sonuç|sonuc|döndür|dondur|dene|yakala|fırlat|firlat|eşzamanlı|eszamanli|ertele)\\b"
        },
        {
          "name": "keyword.other.debugger.tr",
          "match": "\\b(kesme_noktası|kesme_noktasi|dur_noktası|dur_noktasi|durdurma_noktası|durdurma_noktasi)\\b"
        },
        {
          "name": "storage.type.tr",
          "match": "\\b(değişken|degisken|sabit|fonksiyon|işlev|islev|yapı|yapi|sınıf|sinif)\\b"
        },
        {
          "name": "variable.language.self.tr",
          "match": "\\b(kendi)\\b"
        },
        {
          "name": "constant.language.boolean.tr",
          "match": "\\b(doğru|dogru|yanlış|yanlis)\\b"
        },
        {
          "name": "constant.language.null.tr",
          "match": "\\b(yok)\\b"
        },
        {
          "name": "keyword.operator.logical.tr",
          "match": "\\b(ve|veya|değil|degil)\\b"
        }
      ]
    },
    "pronoun": {
      "comment": "Sondaki blok (o-lambda) parametresi: liste.filtrele { o > 2 }",
      "patterns": [
        {
          "name": "variable.language.pronoun.tr",
          "match": "(?<![\\w.])o(?!\\w)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.tr",
          "match": "\\b(Tam|Tamsayı|Tamsayi|Ondalık|Ondalik|Sayı|Sayi|Metin|Yazı|Yazi|Mantık|Mantik|Mantıksal|Mantiksal|Liste|Dizi|Sözlük|Sozluk|Harita|Matris|Tensör|Tensor|SinirAğı|Fonksiyon|Yok|Boş|Bos|Herhangi)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.tr",
          "match": "\\b(yazdır|yazdir|yaz|girdi|oku|uzunluk|boy|tip|tur|tam|ondalık|ondalik|metin|filtrele|haritala|donustur|indirge|ozetle|sırala|sirala|ekle|aralık|aralik|toplam|min|en_küçük|maks|en_büyük|mutlak|karekök|karekok|yuvarla|bekle_hepsi|bekle|uyut|zaman_ms|dosya_oku|dosya_yaz|json_çöz|json_coz|json_metin|json_yaz)\\b"
        },
        {
          "name": "support.function.ai.tr",
          "match": "\\b(matris|sıfırlar|sifirlar|birler|birim_matris|rastgele_matris|devrik|tensör|tensor|geri_yayılım|geri_yayilim|relu|sigmoid|tanh|softmax|kayıp_mse|kayip_mse|sinir_ağı|sinir_agi|model_yükle|model_yukle|ortalama|standart_sapma|std_sapma|medyan|ortanca|normalize_et|nokta_çarpım|nokta_carpim|kosinüs_benzerliği|kosinus_benzerligi|öklid_uzaklığı|oklid_uzakligi|yz_sor|rastgele_normal|gelu|log_softmax|üstel|ustel|log|gömme|gomme|çapraz_entropi|capraz_entropi|katman_normu|rms_normu|türevsiz|turevsiz|AdamW|SGD)\\b"
        },
        {
          "name": "support.function.data.tr",
          "match": "\\b(csv_oku|tablo_oku|tablo_sorgula|veritabanı_aç|veritabani_ac|veritabanı|veritabani)\\b"
        },
        {
          "name": "support.function.web.tr",
          "match": "\\b(web_al|http_al|web_gönder|web_gonder|web_sunucusu|web_sunucu)\\b"
        },
        {
          "name": "support.function.gui.tr",
          "match": "\\b(arayüz_oluştur|arayuz_olustur|pencere_oluştur|pencere_olustur)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tr",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.tr",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.tr",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.pipe.tr",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.null-coalescing.tr",
          "match": "\\?\\?"
        },
        {
          "name": "punctuation.accessor.optional.tr",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.arrow.tr",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.tr",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.tr",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.tr",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.assignment.tr",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.arithmetic.tr",
          "match": "\\*\\*|@|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.ternary.tr",
          "match": "\\?"
        }
      ]
    }
  }
}
