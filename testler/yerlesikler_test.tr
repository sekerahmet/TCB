// DIL_TANIMI.md §13 — Yerleşik fonksiyonlar ve metotlar (seçki)

test "13.1 genel yerleşikler" {
    eşit_mi(3, uzunluk([1, 2, 3]))
    eşit_mi(6, toplam([1, 2, 3]))
    eşit_mi(1, min([3, 1, 2]))
    eşit_mi(3, maks([3, 1, 2]))
    eşit_mi(5, mutlak(-5))
    eşit_mi(3.0, karekök(9))
    eşit_mi([0, 1, 2], aralık(0, 3))
}

test "13.1 min ve maks türü korur, Tam'ları tam karşılaştırır, sayı olmayanda hata verir" {
    eşit_mi(2.0, maks([2.0, 1.5]))
    eşit_mi("Ondalık", tip(maks([2.0, 1.5])))
    eşit_mi("Tam", tip(min([1, 2.5])))
    eşit_mi(9007199254740993, maks([9007199254740993, 1]))
    doğrula(maks([9007199254740993, 9007199254740992]) != 9007199254740992)
    eşit_mi("Tam", tip(maks(9223372036854775807, 1)))
    eşit_mi(-7, min(3, -7, 0.5))
    eşit_mi(yok, maks([]))
    değişken hatalar = []
    dene { maks([1, "a", 5]) } yakala h { hatalar.ekle(h) }
    dene { min("abc") } yakala h { hatalar.ekle(h) }
    dene { toplam([1, "a", 2]) } yakala h { hatalar.ekle(h) }
    eşit_mi(3, uzunluk(hatalar), metin(hatalar))
    doğrula(hatalar[0].içerir("maks(): listenin 2. elemanı Tam ya da Ondalık olmalıdır, Metin (\"a\") verildi"), hatalar[0])
    doğrula(hatalar[1].içerir("min() 1. argüman olarak Tam ya da Ondalık bekler"), hatalar[1])
    // Negatif basamak onlar, yüzler basamağına yuvarlar
    eşit_mi(1200, yuvarla(1234, -2))
    eşit_mi(1240, yuvarla(1235.0, -1))
    eşit_mi(4, yuvarla(3.6))
}

test "13.1 yerleşiklerin argüman hataları tek biçimdedir" {
    değişken m = ""
    dene { aralık("a") } yakala h { m = h }
    doğrula(m.biter("aralık() 1. argüman olarak Tam bekler, Metin (\"a\") verildi"), m)
    dene { aralık(1, 2.5) } yakala h { m = h }
    doğrula(m.biter("aralık() 2. argüman olarak Tam bekler, Ondalık (2.5) verildi"), m)
    dene { uzunluk(5) } yakala h { m = h }
    doğrula(m.biter("uzunluk() 1. argüman olarak Metin, Liste ya da Sözlük bekler, Tam (5) verildi"), m)
    dene { filtrele([1], 3) } yakala h { m = h }
    doğrula(m.biter("filtrele() 2. argüman olarak Fonksiyon bekler, Tam (3) verildi"), m)
    dene { toplam() } yakala h { m = h }
    doğrula(m.biter("toplam() 1 argüman bekler, 0 verildi (kullanım: toplam(liste))"), m)
    dene { yuvarla(1.25, "x") } yakala h { m = h }
    doğrula(m.biter("yuvarla() 2. argüman olarak Tam bekler, Metin (\"x\") verildi"), m)
}

test "13.1 dosya_oku ve dosya_yaz hataları Türkçedir; göreli yol önce çalışma klasöründe, sonra programın klasöründe aranır" {
    // Programın klasöründeki dosya, program başka bir klasörden çalıştırılsa da bulunur
    doğrula(dosya_oku("veri/parcalayici.json").içerir("model"))
    değişken m = ""
    dene { dosya_oku("veri/olmayan_dosya.txt") } yakala h { m = h }
    doğrula(m.içerir("dosya_oku(): \"veri/olmayan_dosya.txt\" okunamadı: böyle bir dosya ya da klasör yok"), m)
    doğrula(m.içerir("bakılan yerler: "), m)
    doğrula(değil m.içerir("system cannot"), m)
    dene { dosya_oku("veri") } yakala h { m = h }
    doğrula(m.içerir("bu bir klasör, dosya değil"), m)
    dene { dosya_yaz("olmayan_klasör_tr/a.txt", "x") } yakala h { m = h }
    doğrula(m.biter("dosya_yaz(): \"olmayan_klasör_tr/a.txt\" yazılamadı: \"olmayan_klasör_tr\" klasörü yok"), m)
    dene { dosya_oku(5) } yakala h { m = h }
    doğrula(m.biter("dosya_oku() 1. argüman olarak Metin (dosya yolu) bekler, Tam (5) verildi"), m)
}

test "13.2 metin metotları" {
    eşit_mi("İSTANBUL", "istanbul".büyük_harf())
    eşit_mi("ılık", "ILIK".küçük_harf())
    eşit_mi("a", "  a ".kırp())
    eşit_mi(["a", "b"], "a,b".böl(","))
    eşit_mi("axc", "abc".değiştir("b", "x"))
    doğrula("abc".içerir("b") ve "abc".başlar("a") ve "abc".biter("c"))
    eşit_mi("cba", "abc".ters_çevir())
}

test "13.3 liste metotları" {
    değişken l = [3, 1, 2, 2]
    eşit_mi([1, 2, 2, 3], l.sırala())
    eşit_mi([3, 1, 2], l.benzersiz())
    eşit_mi("3-1-2-2", l.birleştir("-"))
    eşit_mi(3, l.ilk)
    eşit_mi(2, l.son)
    eşit_mi(2.0, l.ortalama())
    doğrula(l.içerir(1))
}

test "13.3 sırala sayıları tam, metinleri karakter sırasıyla dizer; karışık tip hatadır" {
    eşit_mi([9007199254740992, 9007199254740993], [9007199254740993, 9007199254740992].sırala())
    eşit_mi([-1, 0.5, 2, 2.5], sırala([2.5, 2, -1, 0.5]))
    eşit_mi(["a", "b", "ç"], ["ç", "b", "a"].sırala())
    değişken hatalar = []
    dene { sırala([2, "10", 10]) } yakala h { hatalar.ekle(h) }
    dene { [10, 2, "10"].sırala() } yakala h { hatalar.ekle(h) }
    dene { [doğru, yanlış].sırala() } yakala h { hatalar.ekle(h) }
    eşit_mi(3, uzunluk(hatalar), metin(hatalar))
    döngü h içinde hatalar { doğrula(h.içerir("yalnızca sayılardan ya da yalnızca metinlerden"), h) }
}

test "13.4 sözlük metotları" {
    değişken d = {"a": 1, "b": 2}
    eşit_mi(["a", "b"], d.anahtarlar())
    eşit_mi([1, 2], d.değerler())
    doğrula(d.içerir("a"))
}
