// docs/dil/04_operatorler.md §4 — Operatörler

test "4.1 öncelik: çarpma toplamadan, ** tekli eksiden sıkı bağlanır" {
    eşit_mi(7, 1 + 2 * 3)
    eşit_mi(9, (1 + 2) * 3)
    eşit_mi(-4, -2 ** 2)
    eşit_mi(512, 2 ** 3 ** 2)
}

test "4.1 öncelik: değil karşılaştırmadan gevşek, ve'den sıkı bağlanır" {
    eşit_mi(doğru, değil 1 == 2)
    eşit_mi(yanlış, değil doğru ve doğru)
    eşit_mi(doğru, yanlış veya doğru ve doğru)
}

test "4.1 öncelik: aralık toplamadan gevşek, ?? veya'dan gevşek bağlanır" {
    eşit_mi(4, [x döngü x içinde 1..2 + 3].uzunluk)
    eşit_mi(yanlış, yanlış veya yok ?? 5)
}

test "4.2 aritmetik: tam bölme tam çıkarsa Tam, değilse Ondalık" {
    eşit_mi(2, 6 / 3)
    eşit_mi("Tam", tip(6 / 3))
    eşit_mi(3.5, 7 / 2)
    eşit_mi(1, 7 % 3)
    eşit_mi(1.5, 5.5 % 2)
    eşit_mi(3.5, 1 + 2.5)
}

test "4.2 sıfıra bölme hata verir" {
    değişken mesaj = ""
    dene { değişken z = 1 / 0 } yakala h { mesaj = h }
    doğrula(mesaj.içerir("Sıfıra bölme"), mesaj)
}

test "4.3 üs alma sağdan birleşir, negatif üs Ondalık verir" {
    eşit_mi(1024, 2 ** 10)
    eşit_mi(0.5, 2 ** -1)
}

test "4.4 karşılaştırma sayılar arasında yapılır" {
    doğrula(1 < 2 ve 2 <= 2 ve 3 > 2.5 ve 3 >= 3)
}

test "4.5 eşitlik: sayılar tipten bağımsız, diğerleri tip + içerik" {
    doğrula(1 == 1.0)
    doğrula("1" != 1)
    doğrula([1, "a"] == [1, "a"])
    doğrula({"a": 1} == {"a": 1})
    doğrula(yok == yok)
    doğrula(yok != yanlış)
    // 0 boyutlu tensör değerine eşit sayıya eşittir; eksenli tensör sayıya eşit değildir.
    doğrula(tensör(7.0) == 7 ve 7 == tensör(7.0))
    doğrula(tensör([[1, 2]])[0][1] == 2.0)
    doğrula(toplam(tensör([1, 2, 3, 4])) == 10)
    doğrula(tensör([7.0]) != 7)
}

test "4.5 fonksiyonlar kimlikle karşılaştırılır" {
    değişken f = x => x
    değişken g = f
    doğrula(f == g)
    doğrula((x => x) != (x => x * 2))
    fonksiyon yap(n) { sonuç fonksiyon() { sonuç n } }
    doğrula(yap(1) != yap(2))
    doğrula(yazdır == yazdır)
    doğrula(yazdır != tip)
    yapı Kutu {
        d = 0
        fonksiyon al() { sonuç kendi.d }
    }
    değişken k = Kutu(1)
    doğrula(k.al == k.al)
    doğrula(k.al != Kutu(1).al)
    doğrula(Kutu == Kutu)
    doğrula(1..3 == 1..3 ve 1..3 != 1..=3)
}

test "4.6 ve/veya kısa devre yapar ve Mantık döndürür" {
    değişken cagrildi = yanlış
    fonksiyon yan_etki() {
        cagrildi = doğru
        sonuç doğru
    }
    eşit_mi(yanlış, yanlış ve yan_etki())
    eşit_mi(doğru, doğru veya yan_etki())
    doğrula(değil cagrildi)
    eşit_mi(doğru, 1 && "a")
    eşit_mi(doğru, !yanlış)
}

test "4.7 ?? yalnızca yok ise sağ tarafı verir" {
    eşit_mi(5, yok ?? 5)
    eşit_mi(0, 0 ?? 5)
    eşit_mi(yanlış, yanlış ?? 5)
}

test "4.8 ?. yok üzerinde hata yerine yok verir" {
    değişken kişi = yok
    eşit_mi(yok, kişi?.ad)
    değişken mesaj = ""
    dene { kişi.ad } yakala h { mesaj = h }
    doğrula(mesaj.içerir("?."), mesaj)
}

test "4.9 |> soldaki değeri sağdaki çağrının ilk argümanı yapar; metotlar '.' ile zincirlenir" {
    eşit_mi(6, [1, 2, 3] |> toplam)
    eşit_mi(2.0, [1, 2, 3] |> ortalama)
    fonksiyon katları(l, k) { sonuç l.filtrele { o % k == 0 } }
    eşit_mi([2, 4], [1, 2, 3, 4] |> katları(2))
    eşit_mi(12, [1, 2, 3].haritala { o * 2 } |> toplam)
    değişken m = ""
    dene { [1, 2, 3] |> filtrele { o > 1 } } yakala h { m = h }
    doğrula(m.içerir("'filtrele(...)' TR'de bir fonksiyon değil; 'liste.filtrele(...)' yazın"), m)
}

test "4.10 metin + herhangi bir değer metin birleştirir; liste + liste birleştirir" {
    eşit_mi("a1", "a" + 1)
    eşit_mi("1a", 1 + "a")
    eşit_mi([1, 2], [1] + [2])
}

test "4.11 @ matris çarpımıdır" {
    değişken m = tensör([[1, 2], [3, 4]]) @ tensör([[1], [1]])
    eşit_mi([2, 1], m.şekil)
    eşit_mi(7.0, m[1][0])
}
