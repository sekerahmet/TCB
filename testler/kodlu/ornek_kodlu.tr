//! tr kodlu 1
// Kodlu biçimde saklanmış bir modül (docs/dil/17_kodlar.md, 17.1-17.4): dilin sözcükleri
// kodlarla yazılır, kullanıcının adları, metinler, sayılar ve yorumlar olduğu gibi kalır.
// Türkçe gösterimi: tr göster testler/kodlu/ornek_kodlu.tr
A020 kareler(liste) {
    A021 liste.Y201 { A104 * A104 }
}

A050 Sayac {
    Y001 = 0
    A020 Y004(x) {
        A051.Y001 += x
    }
}

// Gölgelenen yerleşik kullanıcının adıdır: bu kapsamdaki 'toplam' kod değil.
A020 golge() {
    A030 toplam = 5
    A021 toplam
}

// Kod olmayan her ad kullanıcının adıdır, Türkçenin bir anahtar kelimesiyle aynı olsa bile.
A030 eğer = 7

A020 bilgi() {
    A021 "toplam: {G400(T100([1, 2, 3]), T902: 0).Y404}, eğer: {eğer}, ham: " + `{G400}`
}

A020 yakalanan() {
    A060 {
        A062 "x"
    } A061 {
        A021 A103
    }
}
