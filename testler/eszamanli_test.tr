// DIL_TANIMI.md §10 — Eşzamanlılık ve yorumlayıcı kilidi

test "10.1 eşzamanlı blok ve çağrı biçimi; bekle_hepsi hepsini bekler" {
    değişken sonuçlar = []
    eşzamanlı { sonuçlar.ekle("blok") }
    fonksiyon iş(x) { sonuçlar.ekle(x) }
    eşzamanlı iş("çağrı")
    bekle_hepsi()
    eşit_mi(2, uzunluk(sonuçlar))
    doğrula(sonuçlar.içerir("blok") ve sonuçlar.içerir("çağrı"))
}

test "10.2 yorumlayıcı kilidi: paylaşılan sayaç bozulmaz" {
    değişken toplam = 0
    döngü i içinde 1..=200 {
        eşzamanlı { toplam += i }
    }
    bekle_hepsi()
    eşit_mi(20100, toplam)
}

test "10.3 bekle(sn) kilidi bırakır; görevler iç içe ilerler" {
    değişken başla = zaman_ms()
    döngü i içinde 1..=4 {
        eşzamanlı { bekle(0.2) }
    }
    bekle_hepsi()
    değişken süre = zaman_ms() - başla
    doğrula(süre < 700, "4 × 0.2 sn bekleme sıralı çalıştı: {süre} ms")
}

test "10.4 görev değişkenleri döngü turuna aittir" {
    değişken görülen = []
    döngü i içinde 1..=3 {
        eşzamanlı { görülen.ekle(i) }
    }
    bekle_hepsi()
    eşit_mi([1, 2, 3], görülen.sırala())
}
