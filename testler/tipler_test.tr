// DIL_TANIMI.md §3 — Tipler ve değerler

test "3.1 Tam: 64 bit, taşma hata verir" {
    eşit_mi(9223372036854775807, 9223372036854775806 + 1)
    değişken mesaj = ""
    dene { değişken z = 9223372036854775807 + 1 } yakala h { mesaj = h }
    doğrula(mesaj.içerir("taşma"), mesaj)
}

test "3.2 Ondalık: 64 bit kayan noktalı" {
    eşit_mi(0.75, 3 / 4)
    eşit_mi("1.0", metin(1.0))
}

test "3.3 Metin: karakter (rune) bazında uzunluk ve indeks" {
    eşit_mi(5, uzunluk("şeker"))
    eşit_mi("ş", "şeker"[0])
    eşit_mi("r", "şeker"[-1])
    eşit_mi("ek", "şeker"[1..3])
    eşit_mi(yok, "abc"[10])
}

test "3.4 Mantık: doğru ve yanlış" {
    eşit_mi("Mantık", tip(doğru))
    doğrula(doğru != yanlış)
}

test "3.5 yok: boş değer" {
    eşit_mi("Yok", tip(yok))
    fonksiyon hicbir_sey() {}
    eşit_mi(yok, hicbir_sey())
}

test "3.6 Liste: sıralı, karışık tipli, sınır dışı indeks yok döner" {
    değişken l = [1, "iki", 3.0]
    eşit_mi(3, uzunluk(l))
    eşit_mi(1, l[0])
    eşit_mi(3.0, l[-1])
    eşit_mi(yok, l[5])
    eşit_mi([1, "iki"], l[0..2])
}

test "3.6 Liste: değerler başvuruyla paylaşılır" {
    değişken a = [1]
    değişken b = a
    b.ekle(2)
    eşit_mi([1, 2], a)
}

test "3.7 Sözlük: eklenme sırasını korur, çıplak ad anahtarı metindir" {
    değişken d = {ad: "Ali", "yaş": 30, 1: "bir"}
    eşit_mi(["ad", "yaş", 1], d.anahtarlar())
    eşit_mi("Ali", d["ad"])
    eşit_mi("Ali", d.ad)
    eşit_mi("bir", d[1])
    eşit_mi(yok, d["yok_olan"])
    d["yeni"] = doğru
    eşit_mi(4, uzunluk(d))
}

test "3.8 Aralık: a..b (b hariç), a..=b (b dahil)" {
    eşit_mi("Aralık", tip(1..3))
    değişken t = 0
    döngü i içinde 1..4 { t += i }
    eşit_mi(6, t)
    t = 0
    döngü i içinde 1..=4 { t += i }
    eşit_mi(10, t)
}

test "3.9 fonksiyonlar birinci sınıf değerlerdir" {
    değişken f = fonksiyon(x) { sonuç x + 1 }
    değişken l = [f]
    eşit_mi(2, l[0](1))
    eşit_mi("Fonksiyon", tip(f))
}

test "3.10 doğruluk: yanlış, yok, 0, 0.0, boş metin/liste/sözlük yanlış sayılır" {
    değişken yanlislar = [yanlış, yok, 0, 0.0, "", [], {}]
    döngü d içinde yanlislar { doğrula(değil d, "yanlış sayılmalıydı: {d}") }
    değişken dogrular = [doğru, 1, -1, 0.1, "a", [0], {"a": 0}, 1..2]
    döngü d içinde dogrular { doğrula(d, "doğru sayılmalıydı: {d}") }
}

test "3.11 tip(x) değerin tip adını verir" {
    eşit_mi(["Tam", "Ondalık", "Metin", "Mantık", "Yok", "Liste", "Sözlük"],
        [tip(1), tip(1.5), tip("a"), tip(doğru), tip(yok), tip([]), tip({})])
}

test "3.12 dönüşümler: tam, ondalık, metin" {
    eşit_mi(43, tam("42") + 1)
    eşit_mi(3, tam(3.9))
    eşit_mi(1.5, ondalık("1.5"))
    eşit_mi("12a", metin(12) + "a")
    değişken mesaj = ""
    dene { tam("abc") } yakala h { mesaj = h }
    doğrula(mesaj.içerir("çevrilemedi"), mesaj)
}

test "3.13 tip açıklamaları tip denetleyicisince denetlenir" {
    değişken yaş: Tam = 25
    fonksiyon iki_kat(x: Tam): Tam { sonuç x * 2 }
    eşit_mi(50, iki_kat(yaş))
}
