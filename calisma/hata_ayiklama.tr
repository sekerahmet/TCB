// Hata ayıklama alıştırması — F5 ile başlatın.
// 1. 21. satırın soluna tıklayıp kesme noktası koyun, sonra F5'e basın.
// 2. Variables panelinde 'siparisler' değişkenini açın; sağ tık → "TR: Tablo Görünümü".
// 3. F10 ile satır satır ilerleyin, F11 ile 'kdv_ekle' fonksiyonunun içine girin.
// 4. 'oran' değişkenine çift tıklayıp 0.20 yazın: sonuç anında değişir.

değişken oran = 0.18
değişken siparisler = [
    {"müşteri": "Ayşe", "ürün": "Laptop", "tutar": 45000},
    {"müşteri": "Mehmet", "ürün": "Telefon", "tutar": 28000},
    {"müşteri": "Elif", "ürün": "Kulaklık", "tutar": 3500}
]

fonksiyon kdv_ekle(tutar) {
    değişken kdv = tutar * oran
    sonuç tutar + kdv
}

değişken genel_toplam = 0
döngü s içinde siparisler {
    değişken kdvli = kdv_ekle(s["tutar"])
    genel_toplam += kdvli
    yazdır("{s["müşteri"]}: {kdvli} TL")
}

yazdır("Genel toplam: {genel_toplam} TL")
