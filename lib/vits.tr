# TR 4
# tr/vits: yayımlanmış bir VITS modelini açar ve metinden ses üretir: Hugging Face klasörü (`VitsModel`, MMS-TTS) ya da Piper sesi (`.onnx` ve `.onnx.json`).
#
# Mimari Hugging Face'in `modeling_vits.py`'sidir, yalnız çıkarım yolu: metin kodlayıcı (göreli konumlu dikkat),
# olasılıklı süre öngörücünün ters yönü (spline akışları), öncülün süreyle yayılması, akışın ters yönü ve
# HiFi-GAN çözücü. Tek cümle, tek konuşmacı. Hesap float32'dedir.
# Ağırlık normu (`weight_g`, `weight_v`) yüklemede birleşir. Çıkarımda kullanılmayan tensörler adıyla atlanır:
# arka kodlayıcı, süre öngörücünün arka akışları ve ters yönde atılan akış. Dosyada kalan başka ad hatadır.
#
# Yükleme ağırlıkları hesabın biçimine bir kez katlar; eski biçimdeki ağırlıklar tutulmaz ve yol tektir.
# Katlananlar: kodlayıcıda q ölçeği, birleşik q, k, v ve ileri beslemenin pencere matrisi; süre öngörücüde
# √süzgeç bölmesi ve kanal çevirmesi; öncül akışta giriş ve çıkış evrişimleri, sabit sapmalar ve uçların dolgu
# düzeltmesi. Çözücü katlanmaz: leaky_relu dalsızdır (`_gev_abs`) ve aşama sonundaki bölme katsayılara girer.

TR_import "tr/audio"
TR_import "tr/phonemes"

TR_const _AYAR = "config.json"
TR_const _AĞIRLIK = "model.safetensors"
TR_const _SÖZLÜK = "vocab.json"
TR_const _PARÇALAYICI = "tokenizer_config.json"
TR_const _EN_KÜÇÜK = 0.001 # spline'ın en küçük genişliği, yüksekliği ve türevi
TR_const _GEVŞEK_EĞİM = 0.01 # çözücünün son etkinleşmesi: PyTorch'un leaky_relu varsayılanı

# Python'un `str.lower()`'ının basit eşlemeden ayrıldığı tek Türkçe harf: model bu kimliklerle eğitildi.
TR_const _KÜÇÜK_HARF = {"İ": "i\u{307}"}

# Dosyanın tensörleri: alınmayan ve atlanmayan ad sonda hatadır.
TR_struct _Alıcı {
    tensörler: TR_Dict[TR_String, TR_Tensor]
    alınan: TR_Dict[TR_String, TR_Bool]
    dosyadaki: TR_Dict[TR_String, TR_String] = {} # çevrilmiş ad → dosyadaki ad (Piper); iletiler dosyanın adını söyler
    TR_func _var(ad: TR_String) -> TR_Bool { TR_return TR_self.tensörler.TR_contains(ad) }
    TR_func _dosya_adı(ad: TR_String) -> TR_String { TR_return TR_if TR_self.dosyadaki.TR_contains(ad) { TR_self.dosyadaki[ad] } TR_else { ad } }
    # _al tensörü denetler ve float32 olarak verir.
    TR_func _al(ad: TR_String, şekil: TR_List[TR_Int]) -> TR_Tensor {
        TR_if TR_not TR_self._var(ad) { TR_throw TR_Message("H7553", ad) }
        TR_var t = TR_self.tensörler[ad]
        TR_if TR_not ["float32", "fp16", "bf16"].TR_contains(t.TR_dtype) { TR_throw TR_Message("H7554", TR_self._dosya_adı(ad), t.TR_dtype) }
        TR_if t.TR_shape != şekil { TR_throw TR_Message("H7555", TR_self._dosya_adı(ad), t.TR_shape, şekil) }
        TR_self.alınan[ad] = TR_true
        TR_return t.TR_to_dtype("float32")
    }
    # _evrişim bir evrişimin ağırlığını verir; normlu ağırlık `g · v / ‖v‖` olarak birleşir (PyTorch `weight_norm`, eksen 0).
    TR_func _evrişim(ad: TR_String, şekil: TR_List[TR_Int]) -> TR_Tensor {
        TR_if TR_not TR_self._var("\(ad).weight_v") { TR_return TR_self._al("\(ad).weight", şekil) }
        TR_var v = TR_self._al("\(ad).weight_v", şekil)
        TR_var g = TR_self._al("\(ad).weight_g", [şekil[0], 1, 1])
        TR_var norm = TR_sqrt(TR_sum(TR_sum(v * v, TR_dim: 2, TR_keepdim: TR_true), TR_dim: 1, TR_keepdim: TR_true))
        TR_return v * (g / norm)
    }
    # _atla çıkarımda kullanılmayan tensörleri adıyla bırakır.
    TR_func _atla(önekler: TR_List[TR_String]) {
        TR_for ad, _ TR_in TR_self.tensörler {
            TR_for ö TR_in önekler {
                TR_if ad.TR_starts_with(ö) { TR_self.alınan[ad] = TR_true }
            }
        }
    }
    TR_func _bitir() {
        TR_for ad, _ TR_in TR_self.tensörler {
            TR_if TR_not TR_self.alınan.TR_contains(ad) { TR_throw TR_Message("H7556", TR_self._dosya_adı(ad)) }
        }
    }
}

# Bir evrişim: ağırlık [çıkış, giriş // grup, çekirdek], sapma ya da yok. Ters evrişim (`ConvTranspose1d`,
# `ara` adım) çok fazlıdır: `_ters_kur`'a bakın.
TR_struct _Evrişim {
    ağırlık: TR_Tensor
    sapma: TR_Tensor?
    dolgu: TR_Int
    genişleme: TR_Int
    grup: TR_Int
    ara: TR_Int
    kuyruk: TR_Int = 0
    TR_func _ileri(x: TR_Tensor) -> TR_Tensor {
        TR_if TR_self.ara > 1 { TR_return TR_self._büyüt(x) }
        TR_return TR_conv1d(x, TR_self.ağırlık, TR_self.sapma, TR_padding: TR_self.dolgu, TR_dilation: TR_self.genişleme, TR_num_groups: TR_self.grup)
    }
    # _ters_kur evrişimi `ConvTranspose1d`'in ağırlığından (w [giriş, çıkış, K], adım s, dolgu p = (K − s) // 2)
    # çok fazlı kurar. Çıkışın n. öğesi n + p = q·s + r yazılınca y[n] = Σ_m x[q − m]·w[r + m·s]'dir: her r fazı
    # x üstünde M = ⌈K / s⌉ boylu sıradan bir evrişimdir. Fazlar her çıkış kanalının altında [çıkış, s] sırasıyla
    # durur: ağırlık[o·s + r, i, m'] = w[i, o, r + (M − 1 − m')·s] (w sona sıfırla M·s'ye uzatılır); böylece
    # `_büyüt`'teki iç içe dizme her kanalın içinde kalır. Araya sıfır koyan yolun s − 1 sıfır çarpımı yoktur.
    TR_func _ters_kur(w: TR_Tensor, sapma: TR_Tensor, s: TR_Int) {
        TR_var giriş = w.TR_shape[0]
        TR_var çıkış = w.TR_shape[1]
        TR_var k = w.TR_shape[2]
        TR_var m = (k + s - 1) // s
        TR_var ters = TR_Tensor[TR_Int]([m - 1 - i TR_for i TR_in 0..m])
        # [giriş, çıkış, M, s] → [M, çıkış, s, giriş]; M ters sırayla; → [çıkış, s, giriş, M].
        TR_var fazlar = _dolgu(w, 0, m * s - k).TR_reshape([giriş, çıkış, m, s]).TR_permute([2, 1, 3, 0])[ters].TR_permute([1, 2, 3, 0])
        TR_self.ağırlık = TR_Tensor(fazlar).TR_reshape([çıkış * s, giriş, m])
        TR_self.sapma = TR_Tensor(TR_concat([sapma TR_for _ TR_in 0..s], TR_dim: 0).TR_reshape([s, çıkış]).TR_transpose()).TR_reshape([çıkış * s])
        TR_self.dolgu = (k - s) // 2
        TR_self.kuyruk = m * s - k + TR_self.dolgu
        TR_self.genişleme = 1
        TR_self.grup = 1
        TR_self.ara = s
    }
    # _büyüt ters evrişimdir: fazlar iç içe dizilir, baştan dolgu, sondan kuyruk kadar öğe atılır; boy (L − 1)·s + K − 2p.
    TR_func _büyüt(x: TR_Tensor) -> TR_Tensor {
        TR_var s = TR_self.ara
        TR_var m = TR_self.ağırlık.TR_shape[2]
        TR_var z = TR_conv1d(x, TR_self.ağırlık, TR_self.sapma, TR_padding: m - 1)
        TR_var çıkış = z.TR_shape[1] // s
        TR_var n = z.TR_shape[2]
        TR_var iç_içe = z.TR_reshape([çıkış, s, n]).TR_permute([0, 2, 1]).TR_reshape([1, çıkış, n * s])
        TR_return iç_içe.TR_slice(2, TR_self.dolgu, n * s - TR_self.kuyruk)
    }
}

# _gev_abs dalsız `leaky_relu`'dur: a = (1 + eğim)/2, b = (1 − eğim)/2 için x·a + |x|·b. İki çarpım ayrı
# yuvarlanır: tanımdan farkı x'in ölçeğindedir, en çok 2⁻²²·max(1, |eğim|)·|x| (kural testi). Aşama sonundaki
# `/ N` bölmesi katsayılara katlanır.
TR_func _gev_abs_düz(x: TR_Tensor, a: TR_Float, b: TR_Float) -> TR_Tensor { TR_return x * a + TR_abs(x) * b }
TR_var _gev_abs = TR_fuse(_gev_abs_düz)

# _dolgu son eksenin iki ucuna sıfır ekler.
TR_func _dolgu(x: TR_Tensor, sol: TR_Int, sağ: TR_Int) -> TR_Tensor {
    TR_var parçalar: TR_List[TR_Tensor] = []
    TR_var baş = [x.TR_shape[i] TR_for i TR_in 0..x.TR_shape.TR_length - 1]
    TR_if sol > 0 { parçalar.TR_append(TR_zeros(baş + [sol])) }
    parçalar.TR_append(x)
    TR_if sağ > 0 { parçalar.TR_append(TR_zeros(baş + [sağ])) }
    TR_return TR_concat(parçalar, TR_dim: -1)
}

# _kenar_sapma_katla genişlemeli evrişime giren sabit bir girdinin katkısını kurar: iç sapma ve iki ucun dolgu
# düzeltmesi (uçtan uzaklığa göre p konum). `_kenar_ekle` bunları her boyda uygular.
TR_func _kenar_sapma_katla(ağırlık: TR_Tensor, sapma: TR_Tensor, sabit: TR_Tensor, g: TR_Int, p: TR_Int) -> (TR_Tensor, TR_Tensor, TR_Tensor) {
    TR_var çıkış = ağırlık.TR_shape[0]
    TR_var giriş = ağırlık.TR_shape[1]
    TR_var k = ağırlık.TR_shape[2]
    TR_var katkılar: TR_List[TR_Tensor] = []
    TR_var iç = sapma
    TR_var s = sabit.TR_reshape([giriş, 1])
    TR_for m TR_in 0..k {
        TR_var katkı = (TR_Tensor(ağırlık.TR_slice(2, m, m + 1).TR_reshape([çıkış, giriş])) @ s).TR_reshape([çıkış])
        katkılar.TR_append(katkı)
        iç = iç + katkı
    }
    TR_if p == 0 {
        TR_var boş = TR_zeros([1, çıkış, 0])
        TR_return iç, boş, boş
    }
    TR_var sol: TR_List[TR_Tensor] = []
    TR_var sağ: TR_List[TR_Tensor] = []
    TR_for konum TR_in 0..p {
        TR_var sol_toplam = TR_zeros([çıkış])
        TR_var sağ_toplam = TR_zeros([çıkış])
        TR_for m TR_in 0..k {
            TR_if konum - p + m * g < 0 { sol_toplam = sol_toplam - katkılar[m] }
            TR_if konum - 2 * p + m * g >= 0 { sağ_toplam = sağ_toplam - katkılar[m] }
        }
        sol.TR_append(sol_toplam.TR_reshape([1, çıkış, 1]))
        sağ.TR_append(sağ_toplam.TR_reshape([1, çıkış, 1]))
    }
    TR_return iç, TR_concat(sol, TR_dim: 2), TR_concat(sağ, TR_dim: 2)
}

# _kenar_ekle evrişimin çıktısına iki ucun dolgu düzeltmesini ekler. Boy p'den kısaysa her uçtan boy kadarı
# eklenir; iki uç örtüşse de ayrı dokunuşları düşürür, düzeltmeler toplanır.
TR_func _kenar_ekle(h: TR_Tensor, sol: TR_Tensor, sağ: TR_Tensor, p: TR_Int) -> TR_Tensor {
    TR_if p == 0 { TR_return h }
    TR_var t = h.TR_shape[2]
    TR_var n = TR_min(p, t)
    TR_write_slice(h, h.TR_slice(2, 0, n) + sol.TR_slice(2, 0, n), TR_dim: 2, TR_start: 0)
    TR_write_slice(h, h.TR_slice(2, t - n, t) + sağ.TR_slice(2, p - n, p), TR_dim: 2, TR_start: t - n)
    TR_return h
}

# _göreli_ind göreli konumlu dikkatin seçim indeksleridir: puanda [boy, 2p + 2] → [boy, boy] (pencere dışı sıfır
# sütun), olasılıkta [boy, boy + 1] → [boy, 2p + 1]. Cümle başına bir kez kurulur, bütün katmanlara verilir.
TR_func _göreli_ind(boy: TR_Int, p: TR_Int) -> (TR_Tensor[TR_Int], TR_Tensor[TR_Int]) {
    TR_var genişlik = 2 * p + 1
    TR_var sıra = TR_Tensor(0..boy)
    TR_var satır = sıra.TR_reshape([boy, 1])
    TR_var fark = sıra.TR_reshape([1, boy]) - satır + p
    TR_var kutu = TR_where((fark >= 0) & (fark < genişlik), fark, genişlik)
    TR_var puan = (satır * (genişlik + 1) + kutu).TR_reshape([boy * boy])
    TR_var konum = satır + TR_Tensor(0..genişlik).TR_reshape([1, genişlik]) - p
    TR_var güvenli = TR_where((konum >= 0) & (konum < boy), konum, boy)
    TR_var olasılık = (satır * (boy + 1) + güvenli).TR_reshape([boy * genişlik])
    TR_return puan, olasılık
}

# _pencere_katla [boy, kanal] girdiyi k'lık komşuluk pencerelerine açar ([boy, k·kanal]): sıfır dolgulu evrişim
# tek matris çarpımı olur.
TR_func _pencere_katla(x: TR_Tensor, sol: TR_Tensor, sağ: TR_Tensor, k: TR_Int) -> TR_Tensor {
    TR_if k == 1 { TR_return x }
    TR_var boy = x.TR_shape[0]
    TR_if k == 3 {
        TR_var d = TR_concat([sol, x, sağ], TR_dim: 0)
        TR_return TR_concat([d.TR_slice(0, 0, boy), d.TR_slice(0, 1, boy + 1), d.TR_slice(0, 2, boy + 2)], TR_dim: 1)
    }
    TR_var parçalar: TR_List[TR_Tensor] = []
    TR_if sol.TR_shape[0] > 0 { parçalar.TR_append(sol) }
    parçalar.TR_append(x)
    TR_if sağ.TR_shape[0] > 0 { parçalar.TR_append(sağ) }
    TR_var d = TR_concat(parçalar, TR_dim: 0)
    TR_return TR_concat([d.TR_slice(0, j, boy + j) TR_for j TR_in 0..k], TR_dim: 1)
}

# Kodlayıcı katmanı (`VitsEncoderLayer`): göreli konumlu dikkat ve evrişimli ileri besleme, ikisinden sonra
# norm. Ağırlıklar [giriş, çıkış] matrisidir; q ölçeği ağırlığa ve sapmaya katlıdır.
TR_struct _Katman {
    üçlü: TR_Tensor
    üçlü_sapma: TR_Tensor
    çıkış: TR_Tensor
    çıkış_sapma: TR_Tensor
    göreli_k: TR_Tensor
    göreli_v: TR_Tensor
    norm1: TR_List[TR_Tensor]
    ileri1: TR_Tensor
    ileri1_sapma: TR_Tensor
    ileri2: TR_Tensor
    ileri2_sapma: TR_Tensor
    norm2: TR_List[TR_Tensor]
    sol: TR_Tensor
    sağ: TR_Tensor
    sol_ara: TR_Tensor
    sağ_ara: TR_Tensor
    çekirdek: TR_Int
    eps: TR_Float
    pencere: TR_Int
    bakış: TR_Int
    # _ileri [boy, boyut] girdiyi katmandan geçirir; indeksler `_göreli_ind`'dendir.
    TR_func _ileri(x: TR_Tensor, puan_sırası: TR_Tensor[TR_Int], olasılık_sırası: TR_Tensor[TR_Int]) -> TR_Tensor {
        TR_var boy = x.TR_shape[0]
        TR_var boyut = x.TR_shape[1]
        TR_var h = TR_self.bakış
        TR_var d = boyut // h
        TR_var genişlik = 2 * TR_self.pencere + 1
        TR_var üç = x @ TR_self.üçlü + TR_self.üçlü_sapma
        TR_var q = üç.TR_slice(1, 0, boyut).TR_reshape([boy, h, d]).TR_permute([1, 0, 2])
        TR_var k = üç.TR_slice(1, boyut, 2 * boyut).TR_reshape([boy, h, d]).TR_permute([1, 0, 2])
        TR_var v = üç.TR_slice(1, 2 * boyut, 3 * boyut).TR_reshape([boy, h, d]).TR_permute([1, 0, 2])
        TR_var göreli = (q @ TR_self.göreli_k).TR_reshape([h, boy * (genişlik + 1)]).TR_transpose()[puan_sırası].TR_transpose().TR_reshape([h, boy, boy])
        TR_var olasılık = TR_softmax(q @ k.TR_transpose() + göreli, TR_dim: -1)
        TR_var dolu = TR_concat([olasılık, TR_zeros([h, boy, 1])], TR_dim: 2).TR_reshape([h, boy * (boy + 1)])
        TR_var olasılık_göreli = dolu.TR_transpose()[olasılık_sırası].TR_transpose().TR_reshape([h, boy, genişlik])
        TR_var dikkat = (olasılık @ v + olasılık_göreli @ TR_self.göreli_v).TR_permute([1, 0, 2]).TR_reshape([boy, boyut]) @ TR_self.çıkış + TR_self.çıkış_sapma
        TR_var y = TR_layer_norm(x + dikkat, TR_weight: TR_self.norm1[0], TR_bias: TR_self.norm1[1], TR_eps: TR_self.eps)
        TR_var c = TR_relu(_pencere_katla(y, TR_self.sol, TR_self.sağ, TR_self.çekirdek) @ TR_self.ileri1 + TR_self.ileri1_sapma)
        TR_var f = _pencere_katla(c, TR_self.sol_ara, TR_self.sağ_ara, TR_self.çekirdek) @ TR_self.ileri2 + TR_self.ileri2_sapma
        TR_return TR_layer_norm(y + f, TR_weight: TR_self.norm2[0], TR_bias: TR_self.norm2[1], TR_eps: TR_self.eps)
    }
}

# Genişlemeli, derinliğine ayrılmış evrişim (`VitsDilatedDepthSeparableConv`); koşul girdiye eklenir. Girdi
# [boy, kanal]'dır, noktasal evrişimler matris çarpımıdır.
TR_struct _AyrıkEvrişim {
    genişlemeli: TR_List[TR_Tensor]
    genişlemeli_sapma: TR_List[TR_Tensor]
    dolgular: TR_List[TR_Int]
    genişlemeler: TR_List[TR_Int]
    noktasal: TR_List[TR_Tensor]
    noktasal_sapma: TR_List[TR_Tensor]
    normlar1: TR_List[TR_List[TR_Tensor]]
    normlar2: TR_List[TR_List[TR_Tensor]]
    TR_func _ileri(girdi: TR_Tensor, koşul: TR_Tensor?) -> TR_Tensor {
        TR_var x = girdi
        TR_if koşul != TR_none { x = x + koşul }
        TR_var boy = x.TR_shape[0]
        TR_var kanal = x.TR_shape[1]
        TR_for i TR_in 0..TR_self.genişlemeli.TR_length {
            TR_var n1 = TR_self.normlar1[i]
            TR_var n2 = TR_self.normlar2[i]
            TR_var h = TR_conv1d(x.TR_transpose().TR_reshape([1, kanal, boy]), TR_self.genişlemeli[i], TR_self.genişlemeli_sapma[i],
                TR_padding: TR_self.dolgular[i], TR_dilation: TR_self.genişlemeler[i], TR_num_groups: kanal).TR_reshape([kanal, boy]).TR_transpose()
            h = TR_gelu(TR_layer_norm(h, TR_weight: n1[0], TR_bias: n1[1], TR_eps: 0.00001), TR_approximate: TR_false)
            h = TR_layer_norm(h @ TR_self.noktasal[i] + TR_self.noktasal_sapma[i], TR_weight: n2[0], TR_bias: n2[1], TR_eps: 0.00001)
            x = x + TR_gelu(h, TR_approximate: TR_false)
        }
        TR_return x
    }
}

# Spline akışı (`VitsConvFlow`), yalnız ters yön: ikinci yarı ilk yarının verdiği parçalı rasyonel ikinci
# dereceden fonksiyonun tersinden geçer. Genişlik ve yükseklik izdüşümünün √süzgeç bölmesi ağırlığa katlıdır.
TR_struct _SplineAkışı {
    ön: TR_Tensor
    ön_sapma: TR_Tensor
    ayrık: _AyrıkEvrişim
    izdüşüm: TR_Tensor
    izdüşüm_sapma: TR_Tensor
    kutu: TR_Int
    sınır: TR_Float
}

# _seç her satırdan `sıra`'nın gösterdiği öğeyi alır: `TR_gather` yerine tek-sıcak seçim (15.21a motorda yok).
# Seçim çarpımla değil `TR_where`'le yapılır: seçilmeyen öğedeki sonsuz ya da NaN toplama girmez.
TR_func _seç(t: TR_Tensor, tek_sıcak: TR_Tensor[TR_Bool]) -> TR_Tensor {
    TR_var n = tek_sıcak.TR_shape[1]
    TR_return TR_sum(TR_where(tek_sıcak, t.TR_slice(1, 0, n), 0.0), TR_dim: -1)
}

# _yığılı softmax'lı genişlikleri [−sınır, sınır]'da yığılı kenarlara çevirir; uçlar tam sınırdır.
TR_func _yığılı(ham: TR_Tensor, sınır: TR_Float) -> TR_Tensor {
    TR_var b = ham.TR_shape[1]
    TR_var w = _EN_KÜÇÜK + (1.0 - _EN_KÜÇÜK * b) * TR_softmax(ham, TR_dim: -1)
    TR_var y = 2.0 * sınır * TR_cumsum(w, TR_dim: -1) - sınır
    TR_var satır = ham.TR_shape[0]
    TR_return TR_concat([TR_zeros([satır, 1]) - sınır, y.TR_slice(1, 0, b - 1), TR_zeros([satır, 1]) + sınır], TR_dim: -1)
}

# _yumuşak PyTorch'un `softplus`'udur: 20'nin üstünde doğrudan x.
TR_func _yumuşak(x: TR_Tensor) -> TR_Tensor { TR_return TR_where(x > 20.0, x, TR_log1p(TR_exp(TR_clamp(x, TR_max: 20.0)))) }

# _spline_ters `_unconstrained_rational_quadratic_spline`'ın ters yönüdür. Aralık dışı öğe kendisidir;
# aralık içindekiler hesaplanır, seçim `TR_where`'ledir (aralık dışı öğenin hesabı NaN verebilir).
TR_func _spline_ters(x: TR_Tensor, ham_w: TR_Tensor, ham_h: TR_Tensor, ham_d: TR_Tensor, sınır: TR_Float) -> TR_Tensor {
    TR_var satır = x.TR_shape[0]
    TR_var b = ham_w.TR_shape[1]
    TR_var içeride = (x >= -sınır) & (x <= sınır)
    TR_var sabit = TR_log(TR_exp(1.0 - _EN_KÜÇÜK) - 1.0)
    TR_var uç = TR_zeros([satır, 1]) + sabit
    TR_var türev = _EN_KÜÇÜK + _yumuşak(TR_concat([uç, ham_d, uç], TR_dim: -1))
    TR_var yw = _yığılı(ham_w, sınır)
    TR_var yh = _yığılı(ham_h, sınır)
    TR_var genişlik = yw.TR_slice(1, 1, b + 1) - yw.TR_slice(1, 0, b)
    TR_var yükseklik = yh.TR_slice(1, 1, b + 1) - yh.TR_slice(1, 0, b)
    TR_var kenar = TR_concat([yh.TR_slice(1, 0, b), yh.TR_slice(1, b, b + 1) + 0.000001], TR_dim: -1)
    TR_var kutu = TR_sum(TR_where(x.TR_reshape([satır, 1]) >= kenar, 1, 0), TR_dim: -1) - 1
    kutu = TR_clamp(kutu, TR_min: 0, TR_max: b - 1)
    TR_var sıra = TR_Tensor[TR_Int]([i TR_for i TR_in 0..b]).TR_reshape([1, b])
    TR_var tek = kutu.TR_reshape([satır, 1]) == sıra
    TR_var g_w = _seç(yw, tek)
    TR_var g_bw = _seç(genişlik, tek)
    TR_var g_h = _seç(yh, tek)
    TR_var delta = yükseklik / genişlik
    TR_var g_delta = _seç(delta, tek)
    TR_var g_d = _seç(türev, tek)
    TR_var g_d1 = _seç(türev.TR_slice(1, 1, b + 1), tek)
    TR_var g_bh = _seç(yükseklik, tek)
    TR_var ara1 = g_d + g_d1 - 2.0 * g_delta
    TR_var ara2 = x - g_h
    TR_var ara3 = ara2 * ara1
    TR_var a = g_bh * (g_delta - g_d) + ara3
    TR_var bb = g_bh * g_d - ara3
    TR_var c = -g_delta * ara2
    TR_var kök = (2.0 * c) / (-bb - TR_sqrt(bb * bb - 4.0 * a * c))
    TR_return TR_where(içeride, kök * g_bw + g_w, x)
}

# Olasılıklı süre öngörücü (`VitsStochasticDurationPredictor`), ters yön: gürültü akışlardan geçip log süre
# olur. Akışlar arasındaki kanal çevirmesi iki yarının takasıdır; son öteleme yalnız kanal 0'dadır.
TR_struct _SüreÖngörücü {
    ön: TR_Tensor
    ön_sapma: TR_Tensor
    ayrık: _AyrıkEvrişim
    izdüşüm: TR_Tensor
    izdüşüm_sapma: TR_Tensor
    akışlar: TR_List[_SplineAkışı] # ters yönde koşanlar, koşma sırasıyla
    öteleme: TR_Float
    ölçek: TR_Float
    # _ters [boy, boyut] gizli diziden ve [1, 2, boy] gürültüden log süreyi ([boy]) verir.
    TR_func _ters(gizli: TR_Tensor, gürültü: TR_Tensor) -> TR_Tensor {
        TR_var boy = gizli.TR_shape[0]
        TR_var koşul = TR_self.ayrık._ileri(gizli @ TR_self.ön + TR_self.ön_sapma, TR_none) @ TR_self.izdüşüm + TR_self.izdüşüm_sapma
        TR_var z0 = gürültü.TR_slice(1, 0, 1).TR_reshape([boy])
        TR_var z1 = gürültü.TR_slice(1, 1, 2).TR_reshape([boy])
        TR_for akış TR_in TR_self.akışlar {
            TR_var b = akış.kutu
            TR_var ham = akış.ayrık._ileri(z1.TR_reshape([boy, 1]) * akış.ön + akış.ön_sapma, koşul) @ akış.izdüşüm + akış.izdüşüm_sapma
            TR_var yeni = _spline_ters(z0, ham.TR_slice(1, 0, b), ham.TR_slice(1, b, 2 * b), ham.TR_slice(1, 2 * b, 3 * b - 1), akış.sınır)
            z0 = z1
            z1 = yeni
        }
        TR_return (z1 - TR_self.öteleme) * TR_self.ölçek
    }
}

# Artık bağlaşım katmanı (`VitsResidualCouplingLayer`, yalnız ortalama), ters yön. Giriş evrişimi WaveNet'in ilk
# evrişimine, çıkış evrişimi artık ve atlama evrişimlerine katlıdır; çift sıradaki akışın kanal çevirmesi
# ağırlıklardadır (`TR_Vits._öncül`).
TR_struct _Bağlaşım {
    ön: TR_Tensor
    girişler: TR_List[TR_Tensor]
    sapmalar: TR_List[TR_Tensor]
    sollar: TR_List[TR_Tensor]
    sağlar: TR_List[TR_Tensor]
    dolgular: TR_List[TR_Int]
    genişlemeler: TR_List[TR_Int]
    artıklar: TR_List[TR_Tensor]
    son_sapma: TR_Tensor
    kanal: TR_Int
    # _ters iki yarıdan (u, v) yeni ikinci yarıyı verir: u − ortalama(v).
    TR_func _ters(u: TR_Tensor, v: TR_Tensor) -> TR_Tensor {
        TR_var t = v.TR_shape[2]
        TR_var c = TR_self.kanal
        TR_var yarım = v.TR_shape[1]
        TR_var n = TR_self.girişler.TR_length
        TR_var x = v
        TR_var atlama = TR_self.son_sapma
        TR_for i TR_in 0..n {
            TR_var h = TR_conv1d(x, TR_self.girişler[i], TR_self.sapmalar[i], TR_padding: TR_self.dolgular[i], TR_dilation: TR_self.genişlemeler[i])
            h = _kenar_ekle(h, TR_self.sollar[i], TR_self.sağlar[i], TR_self.dolgular[i])
            TR_var e = TR_tanh(h.TR_slice(1, 0, c)) * TR_sigmoid(h.TR_slice(1, c, 2 * c))
            TR_var r = TR_self.artıklar[i] @ e.TR_reshape([c, t])
            TR_if i == n - 1 { TR_return u - (atlama + r.TR_reshape([1, yarım, t])) }
            TR_var önceki = TR_if i == 0 { TR_self.ön @ v.TR_reshape([yarım, t]) } TR_else { x.TR_reshape([c, t]) }
            x = (önceki + r.TR_slice(0, 0, c)).TR_reshape([1, c, t])
            atlama = atlama + r.TR_slice(0, c, c + yarım).TR_reshape([1, yarım, t])
        }
        TR_return u - atlama
    }
}

# HiFi-GAN'ın artık bloğu (`HifiGanResidualBlock`). Tip 1'de her genişlemede iki evrişim var:
# x = x + c2(g(c1(g(x)))); Tip 2'de (Piper'ın `ResBlock2`'si) `ikinciler` boştur: x = x + c1(g(x)). g leaky_relu'dur
# (`_gev_abs`): eğimi çözücünündür, katsayıları `_adım`'a verilir.
TR_struct _ArtıkBlok {
    birinciler: TR_List[_Evrişim]
    ikinciler: TR_List[_Evrişim]
    # _adım bloğun üretimdeki adımıdır: `h` aşamanın girdisi, `gh_a` onun etkinleşmesi (bloklar paylaşır); a ve
    # b `_gev_abs`'ın katsayılarıdır.
    TR_func _adım(h: TR_Tensor, gh_a: TR_Tensor, a: TR_Float, b: TR_Float) -> TR_Tensor {
        TR_var x = h
        TR_for i TR_in 0..TR_self.birinciler.TR_length {
            TR_var y = TR_self.birinciler[i]._ileri(TR_if i == 0 { gh_a } TR_else { _gev_abs(x, a, b) })
            TR_if TR_self.ikinciler.TR_length > 0 { y = TR_self.ikinciler[i]._ileri(_gev_abs(y, a, b)) }
            x = x + y
        }
        TR_return x
    }
}

# HiFi-GAN çözücü (`VitsHifiGan`): her aşamada ters evrişimle büyür, artık blokların ortalamasından geçer.
TR_struct _Çözücü {
    ön: _Evrişim
    büyütücüler: TR_List[_Evrişim]
    bloklar: TR_List[TR_List[_ArtıkBlok]]
    son: _Evrişim
    eğim: TR_Float
    # _aşama i. aşamayı koşar: büyütme, blokların toplamı ve sonraki etkinleşme (eğimi `se`); `/ N` katsayılardadır.
    TR_func _aşama(i: TR_Int, gh: TR_Tensor, a: TR_Float, b: TR_Float, se: TR_Float) -> TR_Tensor {
        TR_var h = TR_self.büyütücüler[i]._büyüt(gh)
        TR_var gh_a = _gev_abs(h, a, b)
        TR_var aşama = TR_self.bloklar[i]
        TR_var toplam = aşama[0]._adım(h, gh_a, a, b)
        TR_for j TR_in 1..aşama.TR_length { toplam = toplam + aşama[j]._adım(h, gh_a, a, b) }
        TR_var n = 2.0 * TR_Float(aşama.TR_length)
        TR_return _gev_abs(toplam, (1.0 + se) / n, (1.0 - se) / n)
    }
    # _ileri gizli sesi ([1, akış, T]) dalgaya ([örnek]) çevirir. Son etkinleşme her zaman `_GEVŞEK_EĞİM`'ledir, büyütücü yoksa da.
    TR_func _ileri(z: TR_Tensor) -> TR_Tensor {
        TR_var n = TR_self.büyütücüler.TR_length
        TR_var ilk = TR_if n == 0 { _GEVŞEK_EĞİM } TR_else { TR_self.eğim }
        TR_var gh = _gev_abs(TR_self.ön._ileri(z), (1.0 + ilk) * 0.5, (1.0 - ilk) * 0.5)
        TR_var a = (1.0 + TR_self.eğim) * 0.5
        TR_var b = (1.0 - TR_self.eğim) * 0.5
        TR_for i TR_in 0..n {
            TR_var se = TR_if i < n - 1 { TR_self.eğim } TR_else { _GEVŞEK_EĞİM }
            gh = TR_self._aşama(i, gh, a, b, se)
        }
        TR_var dalga = TR_tanh(TR_self.son._ileri(gh))
        TR_return dalga.TR_reshape([dalga.TR_shape[2]])
    }
}

# Karakter parçalayıcı (`VitsTokenizer`): `normalize`, `add_blank`; uroman ve fonem yok.
# Sözlükte bulunan sözcük olduğu gibi kalır, bulunmayan karakter Python'un `str.lower()`'ıyla küçülür:
# `_KÜÇÜK_HARF` tablosu onun basit eşlemeden ayrıldığı yerdir. Sözlükte olmayan karakter atılır.
TR_struct _Parçalayıcı {
    sözlük: TR_Dict[TR_String, TR_Int]
    sözcükler: TR_List[TR_List[TR_String]] # sözlük sırasıyla, karakterlerine ayrılmış
    boşluk_ekle: TR_Bool
    normalle: TR_Bool
    # _küçült `normalize_text`'tir.
    TR_func _küçült(harfler: TR_List[TR_String]) -> TR_List[TR_String] {
        TR_var çıkış: TR_List[TR_String] = []
        TR_var i = 0
        TR_var n = harfler.TR_length
        TR_for i < n {
            TR_var bulundu = TR_false
            TR_for s TR_in TR_self.sözcükler {
                TR_var m = s.TR_length
                TR_if TR_not bulundu TR_and m > 0 TR_and i + m <= n TR_and harfler[i..i + m] == s {
                    çıkış = çıkış + s
                    i = i + m
                    bulundu = TR_true
                }
            }
            TR_if TR_not bulundu {
                TR_var c = harfler[i]
                TR_if _KÜÇÜK_HARF.TR_contains(c) { çıkış = çıkış + [k TR_for k TR_in _KÜÇÜK_HARF[c]] } TR_else { çıkış.TR_append(c.TR_lower()) }
                i = i + 1
            }
        }
        TR_return çıkış
    }
    TR_func _parçala(metin: TR_String) -> TR_List[TR_Int] {
        TR_var harfler = [c TR_for c TR_in metin]
        TR_if TR_self.normalle { harfler = TR_self._küçült(harfler) }
        TR_var kalan = [c TR_for c TR_in harfler TR_if TR_self.sözlük.TR_contains(c)].TR_join("").TR_strip()
        TR_var kimlikler: TR_List[TR_Int] = []
        TR_for c TR_in kalan {
            TR_if TR_self.boşluk_ekle { kimlikler.TR_append(0) }
            kimlikler.TR_append(TR_self.sözlük[c])
        }
        TR_if TR_self.boşluk_ekle { kimlikler.TR_append(0) }
        TR_return kimlikler
    }
}

# _tepe_normla dalgayı tepesi 1 olacak biçimde böler ve [-1, 1]'e kırpar; tepesi 1e-8'den küçük dalga sıfırdır.
TR_func _tepe_normla(d: TR_Tensor) -> TR_Tensor {
    TR_var tepe = TR_max(TR_abs(d)).TR_tolist
    TR_if tepe < 1e-8 { TR_return TR_zeros(d.TR_shape) }
    TR_return TR_clamp(d / tepe, TR_min: -1.0, TR_max: 1.0)
}

# Bir üretimin bütün ara değerleri: kıyas ve test içindir.
TR_struct _Çıktı {
    parçalar: TR_List[TR_Int]
    gizli: TR_Tensor # [L, boyut]
    önce_ortalama: TR_Tensor # [L, akış]
    önce_log: TR_Tensor
    log_süre: TR_Tensor # [L]
    süreler: TR_List[TR_Int]
    önce_örnek: TR_Tensor # [akış, T]
    gizli_ses: TR_Tensor # akıştan sonra, [akış, T]
    dalga: TR_Tensor # [örnek]
}

# Açılmış VITS modeli.
TR_struct TR_Vits {
    _parçalayıcı: _Parçalayıcı
    _gömme: TR_Tensor
    _katmanlar: TR_List[_Katman]
    _izdüşüm: TR_Tensor
    _izdüşüm_sapma: TR_Tensor
    _süre: _SüreÖngörücü
    _akışlar: TR_List[_Bağlaşım] # ters yönde koşma sırasıyla
    _ters_yarım: TR_Tensor[TR_Int]
    _çözücü: _Çözücü
    _boyut: TR_Int
    _akış_boyu: TR_Int
    _hız: TR_Float
    _gürültü: TR_Float
    _süre_gürültüsü: TR_Float
    _örnek_hızı: TR_Int
    _fonemler: TR_Dict[TR_String, TR_List[TR_Int]] # Piper'ın fonem kimlikleri; MMS'te boş
    _piper: TR_Bool
    _ad: TR_String # sesin dosyası ya da klasörü, iletiler için
    # ses_dili sesin dilidir: Piper'da `.onnx.json`'un `language.family`'si ("tr", "en"), MMS'te "" (bilinmiyor).
    TR_voice_language: TR_String = ""
    # _kodla parça kimliklerini [boy, boyut] gizli diziye çevirir (metin kodlayıcı).
    TR_func _kodla(parçalar: TR_List[TR_Int]) -> TR_Tensor {
        TR_var x = TR_embedding_lookup(TR_self._gömme, TR_Tensor[TR_Int](parçalar))
        TR_var boy = parçalar.TR_length
        TR_if TR_self._katmanlar.TR_length == 0 TR_or boy == 0 { TR_return x }
        TR_var puan, olasılık = _göreli_ind(boy, TR_self._katmanlar[0].pencere)
        TR_for katman TR_in TR_self._katmanlar { x = katman._ileri(x, puan, olasılık) }
        TR_return x
    }
    # _yay öncülü sürelerle yayar: her parça süresi kadar çerçeve; gürültü verilmezse sabit tohumdan çekilir.
    # Süre toplamı 0'sa öncül tek çerçeve gürültüdür.
    TR_func _yay(ortalama: TR_Tensor, log_s: TR_Tensor, süreler: TR_List[TR_Int], önce_gürültüsü: TR_Tensor?) -> TR_Tensor {
        TR_var f = TR_self._akış_boyu
        TR_var sıra: TR_List[TR_Int] = []
        TR_for j TR_in 0..süreler.TR_length {
            TR_for _ TR_in 0..süreler[j] { sıra.TR_append(j) }
        }
        TR_var g = TR_if önce_gürültüsü != TR_none { önce_gürültüsü } TR_else { TR_randn([f, TR_max(sıra.TR_length, 1)], TR_seed: 1) }
        TR_if sıra.TR_length == 0 { TR_return g * TR_self._gürültü }
        TR_var birleşik = TR_concat([ortalama, TR_exp(log_s) * TR_self._gürültü], TR_dim: 1)[TR_Tensor[TR_Int](sıra)].TR_transpose()
        TR_return birleşik.TR_slice(0, 0, f) + g * birleşik.TR_slice(0, f, 2 * f)
    }
    # _öncül öncül akışı ters yönde koşar ([akış, T] → [1, akış, T]); tek sayıda akıştan sonra iki yarı çevrilir.
    TR_func _öncül(önce: TR_Tensor) -> TR_Tensor {
        TR_var f = önce.TR_shape[0]
        TR_var t = önce.TR_shape[1]
        TR_var yarım = f // 2
        TR_var u = TR_Tensor(önce.TR_slice(0, 0, yarım).TR_reshape([1, yarım, t]))
        TR_var v = TR_Tensor(önce.TR_slice(0, yarım, f).TR_reshape([1, yarım, t]))
        TR_for akış TR_in TR_self._akışlar {
            TR_var yeni = akış._ters(u, v)
            u = v
            v = yeni
        }
        TR_if TR_self._akışlar.TR_length % 2 == 1 {
            u = u.TR_reshape([yarım, t])[TR_self._ters_yarım].TR_reshape([1, yarım, t])
            v = v.TR_reshape([yarım, t])[TR_self._ters_yarım].TR_reshape([1, yarım, t])
        }
        TR_return TR_concat([u, v], TR_dim: 1)
    }
    # _üret parçalardan sesi ve bütün ara değerleri üretir. İki gürültü dışarıdan verilir; `verilen` süreler
    # verilirse öngörülen süre yerine kullanılır.
    TR_func _üret(parçalar: TR_List[TR_Int], süre_gürültüsü: TR_Tensor, önce_gürültüsü: TR_Tensor?, verilen: TR_List[TR_Int]?) -> _Çıktı {
        TR_var f = TR_self._akış_boyu
        TR_var x = TR_self._kodla(parçalar)
        TR_var istat = x @ TR_self._izdüşüm + TR_self._izdüşüm_sapma
        TR_var ortalama = istat.TR_slice(1, 0, f)
        TR_var log_s = istat.TR_slice(1, f, 2 * f)
        TR_var log_süre = TR_self._süre._ters(x, süre_gürültüsü * TR_self._süre_gürültüsü)
        TR_var süreler = TR_if verilen != TR_none { verilen } TR_else { TR_Tensor[TR_Int](TR_ceil(TR_exp(log_süre) * (1.0 / TR_self._hız))).TR_tolist }
        TR_var önce = TR_self._yay(ortalama, log_s, süreler, önce_gürültüsü)
        TR_var z = TR_self._öncül(önce)
        TR_return _Çıktı(parçalar: parçalar, gizli: x, önce_ortalama: ortalama, önce_log: log_s, log_süre: log_süre, süreler: süreler,
            önce_örnek: önce, gizli_ses: z.TR_reshape([f, önce.TR_shape[1]]), dalga: TR_self._çözücü._ileri(z))
    }
    # _üret_dalga `_üret`'in yoludur ama ara değerleri tutmaz: üretim bunu çağırır, tamponlar hemen geri döner.
    TR_func _üret_dalga(parçalar: TR_List[TR_Int], süre_gürültüsü: TR_Tensor, önce_gürültüsü: TR_Tensor?) -> TR_Tensor {
        TR_var f = TR_self._akış_boyu
        TR_var x = TR_self._kodla(parçalar)
        TR_var istat = x @ TR_self._izdüşüm + TR_self._izdüşüm_sapma
        TR_var log_süre = TR_self._süre._ters(x, süre_gürültüsü * TR_self._süre_gürültüsü)
        TR_var süreler = TR_Tensor[TR_Int](TR_ceil(TR_exp(log_süre) * (1.0 / TR_self._hız))).TR_tolist
        TR_var önce = TR_self._yay(istat.TR_slice(1, 0, f), istat.TR_slice(1, f, 2 * f), süreler, önce_gürültüsü)
        TR_return TR_self._çözücü._ileri(TR_self._öncül(önce))
    }
    # sese_çevir metni sese çevirir. Gürültü sabit tohumdan gelir: aynı metin aynı sesi verir.
    # Piper sesi metni sesin dilinin çeviricisiyle (`tr/phonemes`) cümle cümle fonemlere, onları kimliklere çevirip konuşur.
    TR_func TR_synthesize(metin: TR_String) -> TR_Sound {
        TR_if TR_self._piper {
            TR_return TR_self._konuş([TR_self._kimlikler(c) TR_for c TR_in TR_phonemize(metin, TR_language: TR_self.TR_voice_language)])
        }
        TR_var parçalar = TR_self._parçalayıcı._parçala(metin)
        TR_var dalga = TR_self._üret_dalga(parçalar, TR_randn([1, 2, parçalar.TR_length], TR_seed: 0), TR_none)
        TR_return TR_Sound(TR_samples: dalga.TR_reshape([1, dalga.TR_shape[0]]), TR_sample_rate: TR_self._örnek_hızı)
    }
    # _kimlik Piper sözlüğündeki bir fonemin kimlikleridir; sözlükte olmayan fonem hatadır.
    TR_func _kimlik(fonem: TR_String) -> TR_List[TR_Int] {
        TR_if TR_not TR_self._fonemler.TR_contains(fonem) { TR_throw TR_Message("H7567", fonem, TR_self._ad) }
        TR_return TR_self._fonemler[fonem]
    }
    # _kimlikler Piper sesinin fonem dizisini kimliklere çevirir: `^`, `_`, her fonemden sonra `_`, sonda `$`
    # (piper-tts 1.8.0 `phoneme_ids.py`). Piper sözlükte olmayan fonemi atlayıp uyarır; TR onu hata sayar (H7567).
    TR_func _kimlikler(fonemler: TR_String) -> TR_List[TR_Int] {
        TR_var dolgu = TR_self._kimlik("_")
        TR_var k = TR_self._kimlik("^") + dolgu
        TR_for f TR_in fonemler { k = k + TR_self._kimlik(f) + dolgu }
        TR_return k + TR_self._kimlik("$")
    }
    # _konuş Piper sesinin iç girişidir: her cümlenin fonem kimlikleri ayrı üretilir, dalga tepesi 1'e normlanıp
    # [-1, 1]'e kırpılır ve cümleler arka arkaya eklenir (piper-tts 1.8.0 `voice.py`, `normalize_audio`; tepesi
    # 1e-8'den küçük dalga sıfırdır). Boş cümle atlanır. Gürültü sabit tohumdan gelir: aynı kimlikler aynı sesi verir.
    TR_func _konuş(cümleler: TR_List[TR_List[TR_Int]]) -> TR_Sound {
        TR_var dolu = [k TR_for k TR_in cümleler TR_if k.TR_length > 0]
        TR_if dolu.TR_length == 0 {
            TR_return TR_Sound(TR_samples: TR_zeros([1, 0]), TR_sample_rate: TR_self._örnek_hızı)
        }
        TR_if dolu.TR_length == 1 {
            TR_var k = dolu[0]
            TR_var d = _tepe_normla(TR_self._üret_dalga(k, TR_randn([1, 2, k.TR_length], TR_seed: 0), TR_none))
            TR_return TR_Sound(TR_samples: d.TR_reshape([1, d.TR_shape[0]]), TR_sample_rate: TR_self._örnek_hızı)
        }
        TR_var parçalar = [_tepe_normla(TR_self._üret_dalga(k, TR_randn([1, 2, k.TR_length], TR_seed: 0), TR_none)) TR_for k TR_in dolu]
        TR_var hepsi = TR_concat(parçalar, TR_dim: 0)
        TR_return TR_Sound(TR_samples: hepsi.TR_reshape([1, hepsi.TR_shape[0]]), TR_sample_rate: TR_self._örnek_hızı)
    }
}

# _alan ayar dosyasının (config.json ya da Piper'ın `.onnx.json`'u) zorunlu alanını verir.
TR_func _alan(ayar: TR_JSON, alan: TR_String, dosya: TR_String = _AYAR) -> TR_JSON {
    TR_var v = ayar.TR_get(alan)
    TR_if v == TR_none TR_or TR_Type(v) == TR_NoneType { TR_throw TR_Message("H7551", dosya, alan) }
    TR_return v
}

TR_func _sayı(ayar: TR_JSON, alan: TR_String, dosya: TR_String = _AYAR) -> TR_Int {
    TR_var n = TR_Int(_alan(ayar, alan, dosya))
    TR_if n <= 0 { TR_throw TR_Message("H7557", alan, n, "positive") }
    TR_return n
}

TR_func _ondalık(ayar: TR_JSON, alan: TR_String, dosya: TR_String = _AYAR) -> TR_Float { TR_return TR_Float(_alan(ayar, alan, dosya)) }

TR_func _sayılar(ayar: TR_JSON, alan: TR_String) -> TR_List[TR_Int] { TR_return [TR_Int(e) TR_for e TR_in _alan(ayar, alan)] }

# _desteklenen bu kitaplığın kurmadığı bir ayarı hatasız geçirmez: yanlış ses üretirdi.
TR_func _desteklenen(ayar: TR_JSON) {
    TR_if TR_Int(_alan(ayar, "num_speakers")) != 1 { TR_throw TR_Message("H7557", "num_speakers", _alan(ayar, "num_speakers"), "other") }
    TR_if TR_not TR_Bool(_alan(ayar, "use_stochastic_duration_prediction")) { TR_throw TR_Message("H7557", "use_stochastic_duration_prediction", TR_false, "other") }
    TR_if TR_String(_alan(ayar, "hidden_act")) != "relu" { TR_throw TR_Message("H7557", "hidden_act", _alan(ayar, "hidden_act"), "other") }
    TR_if TR_not TR_Bool(_alan(ayar, "use_bias")) { TR_throw TR_Message("H7557", "use_bias", TR_false, "other") }
    TR_if _sayı(ayar, "depth_separable_channels") != 2 { TR_throw TR_Message("H7557", "depth_separable_channels", _alan(ayar, "depth_separable_channels"), "other") }
    TR_if _sayı(ayar, "hidden_size") % _sayı(ayar, "num_attention_heads") != 0 { TR_throw TR_Message("H7557", "num_attention_heads", _alan(ayar, "num_attention_heads"), "heads") }
}

TR_func _evrişim(a: _Alıcı, ad: TR_String, çıkış: TR_Int, giriş: TR_Int, çekirdek: TR_Int, dolgu: TR_Int = 0, genişleme: TR_Int = 1, grup: TR_Int = 1, sapmalı: TR_Bool = TR_true) -> _Evrişim {
    TR_var sapma: TR_Tensor? = TR_none
    TR_if sapmalı { sapma = a._al("\(ad).bias", [çıkış]) }
    TR_return _Evrişim(ağırlık: a._evrişim(ad, [çıkış, giriş // grup, çekirdek]), sapma: sapma, dolgu: dolgu, genişleme: genişleme, grup: grup, ara: 1)
}

TR_func _norm(a: _Alıcı, ad: TR_String, boyut: TR_Int) -> TR_List[TR_Tensor] { TR_return [a._al("\(ad).weight", [boyut]), a._al("\(ad).bias", [boyut])] }

# _katman kodlayıcı katmanını okur ve katlanmış biçimde kurar.
TR_func _katman(a: _Alıcı, ad: TR_String, ayar: TR_JSON) -> _Katman {
    TR_var h = _sayı(ayar, "hidden_size")
    TR_var bakış = _sayı(ayar, "num_attention_heads")
    TR_var pencere = _sayı(ayar, "window_size")
    TR_var ara = _sayı(ayar, "ffn_dim")
    TR_var k = _sayı(ayar, "ffn_kernel_size")
    TR_var d = "\(ad).attention"
    TR_var boyut = h // bakış
    TR_var ölçek = 1.0 / TR_sqrt(TR_Float(boyut))
    TR_var q = a._al("\(d).q_proj.weight", [h, h]).TR_transpose() * ölçek
    TR_var üçlü = TR_concat([q, a._al("\(d).k_proj.weight", [h, h]).TR_transpose(), a._al("\(d).v_proj.weight", [h, h]).TR_transpose()], TR_dim: 1)
    TR_var sapmalar = [a._al("\(d).q_proj.bias", [h]) * ölçek, a._al("\(d).k_proj.bias", [h]), a._al("\(d).v_proj.bias", [h])]
    TR_var göreli_k = a._al("\(d).emb_rel_k", [1, 2 * pencere + 1, boyut]).TR_reshape([2 * pencere + 1, boyut])
    TR_var i1 = "\(ad).feed_forward.conv_1"
    TR_var i2 = "\(ad).feed_forward.conv_2"
    TR_return _Katman(üçlü: üçlü, üçlü_sapma: TR_concat(sapmalar, TR_dim: 0).TR_reshape([1, 3 * h]),
        çıkış: a._al("\(d).out_proj.weight", [h, h]).TR_transpose(), çıkış_sapma: a._al("\(d).out_proj.bias", [h]).TR_reshape([1, h]),
        göreli_k: TR_Tensor(TR_concat([göreli_k, TR_zeros([1, boyut])], TR_dim: 0).TR_transpose()),
        göreli_v: a._al("\(d).emb_rel_v", [1, 2 * pencere + 1, boyut]).TR_reshape([2 * pencere + 1, boyut]),
        norm1: _norm(a, "\(ad).layer_norm", h),
        ileri1: TR_Tensor(a._evrişim(i1, [ara, h, k]).TR_permute([2, 1, 0]).TR_reshape([k * h, ara])), ileri1_sapma: a._al("\(i1).bias", [ara]).TR_reshape([1, ara]),
        ileri2: TR_Tensor(a._evrişim(i2, [h, ara, k]).TR_permute([2, 1, 0]).TR_reshape([k * ara, h])), ileri2_sapma: a._al("\(i2).bias", [h]).TR_reshape([1, h]),
        norm2: _norm(a, "\(ad).final_layer_norm", h),
        sol: TR_zeros([(k - 1) // 2, h]), sağ: TR_zeros([k // 2, h]), sol_ara: TR_zeros([(k - 1) // 2, ara]), sağ_ara: TR_zeros([k // 2, ara]),
        çekirdek: k, eps: _ondalık(ayar, "layer_norm_eps"), pencere: pencere, bakış: bakış)
}

# _ayrık ayrık evrişimi okur; noktasal evrişimleri matris olarak kurar.
TR_func _ayrık(a: _Alıcı, ad: TR_String, ayar: TR_JSON) -> _AyrıkEvrişim {
    TR_var h = _sayı(ayar, "hidden_size")
    TR_var k = _sayı(ayar, "duration_predictor_kernel_size")
    TR_var n = _sayı(ayar, "depth_separable_num_layers")
    TR_var genişlemeli: TR_List[TR_Tensor] = []
    TR_var genişlemeli_sapma: TR_List[TR_Tensor] = []
    TR_var dolgular: TR_List[TR_Int] = []
    TR_var genişlemeler: TR_List[TR_Int] = []
    TR_var noktasal: TR_List[TR_Tensor] = []
    TR_var noktasal_sapma: TR_List[TR_Tensor] = []
    TR_var n1: TR_List[TR_List[TR_Tensor]] = []
    TR_var n2: TR_List[TR_List[TR_Tensor]] = []
    TR_for i TR_in 0..n {
        TR_var g = k ** i
        TR_var ge = "\(ad).convs_dilated.\(i)"
        TR_var no = "\(ad).convs_pointwise.\(i)"
        genişlemeli.TR_append(a._evrişim(ge, [h, 1, k]))
        genişlemeli_sapma.TR_append(a._al("\(ge).bias", [h]))
        dolgular.TR_append((k * g - g) // 2)
        genişlemeler.TR_append(g)
        noktasal.TR_append(TR_Tensor(a._evrişim(no, [h, h, 1]).TR_reshape([h, h]).TR_transpose()))
        noktasal_sapma.TR_append(a._al("\(no).bias", [h]).TR_reshape([1, h]))
        n1.TR_append(_norm(a, "\(ad).norms_1.\(i)", h))
        n2.TR_append(_norm(a, "\(ad).norms_2.\(i)", h))
    }
    TR_return _AyrıkEvrişim(genişlemeli: genişlemeli, genişlemeli_sapma: genişlemeli_sapma, dolgular: dolgular, genişlemeler: genişlemeler,
        noktasal: noktasal, noktasal_sapma: noktasal_sapma, normlar1: n1, normlar2: n2)
}

# _süre süre öngörücüyü kurar. Ters yön `flows[1]`'i atar (özgündeki "işe yaramaz akış"): ağırlığı adıyla atlanır.
TR_func _süre(a: _Alıcı, ayar: TR_JSON) -> _SüreÖngörücü {
    TR_var h = _sayı(ayar, "hidden_size")
    TR_var b = _sayı(ayar, "duration_predictor_flow_bins")
    TR_var n = _sayı(ayar, "duration_predictor_num_flows")
    TR_var ön = "duration_predictor"
    TR_var çıkış = 3 * b - 1
    TR_var bölen = 1.0 / TR_sqrt(TR_Float(h))
    TR_var akışlar: TR_List[_SplineAkışı] = []
    TR_var i = n
    TR_for i >= 2 {
        TR_var f = "\(ön).flows.\(i)"
        TR_var iw = TR_Tensor(a._evrişim("\(f).conv_proj", [çıkış, h, 1]).TR_reshape([çıkış, h]).TR_transpose())
        TR_var ib = a._al("\(f).conv_proj.bias", [çıkış]).TR_reshape([1, çıkış])
        akışlar.TR_append(_SplineAkışı(ön: a._evrişim("\(f).conv_pre", [h, 1, 1]).TR_reshape([1, h]), ön_sapma: a._al("\(f).conv_pre.bias", [h]).TR_reshape([1, h]),
            ayrık: _ayrık(a, "\(f).conv_dds", ayar),
            izdüşüm: TR_concat([iw.TR_slice(1, 0, 2 * b) * bölen, iw.TR_slice(1, 2 * b, çıkış)], TR_dim: 1),
            izdüşüm_sapma: TR_concat([ib.TR_slice(1, 0, 2 * b) * bölen, ib.TR_slice(1, 2 * b, çıkış)], TR_dim: 1),
            kutu: b, sınır: _ondalık(ayar, "duration_predictor_tail_bound")))
        i = i - 1
    }
    a._atla(["\(ön).flows.1.", "\(ön).post_"])
    TR_var öteleme = a._al("\(ön).flows.0.translate", [2, 1]).TR_reshape([2]).TR_tolist
    TR_var ölçek = TR_exp(-a._al("\(ön).flows.0.log_scale", [2, 1]).TR_reshape([2])).TR_tolist
    TR_return _SüreÖngörücü(ön: TR_Tensor(a._evrişim("\(ön).conv_pre", [h, h, 1]).TR_reshape([h, h]).TR_transpose()),
        ön_sapma: a._al("\(ön).conv_pre.bias", [h]).TR_reshape([1, h]), ayrık: _ayrık(a, "\(ön).conv_dds", ayar),
        izdüşüm: TR_Tensor(a._evrişim("\(ön).conv_proj", [h, h, 1]).TR_reshape([h, h]).TR_transpose()),
        izdüşüm_sapma: a._al("\(ön).conv_proj.bias", [h]).TR_reshape([1, h]), akışlar: akışlar, öteleme: öteleme[0], ölçek: ölçek[0])
}

# _bağlaşım bir öncül akışı okur ve katlanmış biçimde kurar; çift sıradaki akışın kanal çevirmesi ağırlıklara girer.
TR_func _bağlaşım(a: _Alıcı, ad: TR_String, ayar: TR_JSON, sıra: TR_Int, ters_yarım: TR_Tensor[TR_Int]) -> _Bağlaşım {
    TR_var h = _sayı(ayar, "hidden_size")
    TR_var yarım = _sayı(ayar, "flow_size") // 2
    TR_var k = _sayı(ayar, "wavenet_kernel_size")
    TR_var oran = _sayı(ayar, "wavenet_dilation_rate")
    TR_var n = _sayı(ayar, "prior_encoder_num_wavenet_layers")
    TR_var ön = a._evrişim("\(ad).conv_pre", [h, yarım, 1]).TR_reshape([h, yarım])
    TR_var son = a._evrişim("\(ad).conv_post", [yarım, h, 1]).TR_reshape([yarım, h])
    TR_var son_sapma = a._al("\(ad).conv_post.bias", [yarım])
    TR_if sıra % 2 == 0 {
        ön = TR_Tensor(ön.TR_transpose()[ters_yarım].TR_transpose())
        son = TR_Tensor(son[ters_yarım])
        son_sapma = son_sapma[ters_yarım]
    }
    TR_var wn = "\(ad).wavenet"
    TR_var girişler: TR_List[TR_Tensor] = []
    TR_var sapmalar: TR_List[TR_Tensor] = []
    TR_var sollar: TR_List[TR_Tensor] = []
    TR_var sağlar: TR_List[TR_Tensor] = []
    TR_var dolgular: TR_List[TR_Int] = []
    TR_var genişlemeler: TR_List[TR_Int] = []
    TR_var artıklar: TR_List[TR_Tensor] = []
    TR_var sabit = a._al("\(ad).conv_pre.bias", [h])
    TR_for i TR_in 0..n {
        TR_var g = oran ** i
        TR_var p = (k * g - g) // 2
        TR_var giriş = a._evrişim("\(wn).in_layers.\(i)", [2 * h, h, k])
        TR_var iç, sol, sağ = _kenar_sapma_katla(giriş, a._al("\(wn).in_layers.\(i).bias", [2 * h]), sabit, g, p)
        TR_if i == 0 { giriş = TR_concat([(TR_Tensor(giriş.TR_slice(2, m, m + 1).TR_reshape([2 * h, h])) @ ön).TR_reshape([2 * h, yarım, 1]) TR_for m TR_in 0..k], TR_dim: 2) }
        girişler.TR_append(giriş); sapmalar.TR_append(iç); sollar.TR_append(sol); sağlar.TR_append(sağ)
        dolgular.TR_append(p); genişlemeler.TR_append(g)
        TR_var çıkış = TR_if i < n - 1 { 2 * h } TR_else { h }
        TR_var r = a._evrişim("\(wn).res_skip_layers.\(i)", [çıkış, h, 1]).TR_reshape([çıkış, h])
        TR_var r_sapma = a._al("\(wn).res_skip_layers.\(i).bias", [çıkış])
        TR_if i < n - 1 {
            artıklar.TR_append(TR_concat([r.TR_slice(0, 0, h), son @ r.TR_slice(0, h, 2 * h)], TR_dim: 0))
            son_sapma = son_sapma + (son @ r_sapma.TR_slice(0, h, 2 * h).TR_reshape([h, 1])).TR_reshape([yarım])
            sabit = sabit + r_sapma.TR_slice(0, 0, h)
        } TR_else {
            artıklar.TR_append(son @ r)
            son_sapma = son_sapma + (son @ r_sapma.TR_reshape([h, 1])).TR_reshape([yarım])
        }
    }
    TR_return _Bağlaşım(ön: ön, girişler: girişler, sapmalar: sapmalar, sollar: sollar, sağlar: sağlar, dolgular: dolgular,
        genişlemeler: genişlemeler, artıklar: artıklar, son_sapma: son_sapma.TR_reshape([1, yarım, 1]), kanal: h)
}

# _ters_evrişim `ConvTranspose1d`'i [giriş, çıkış, K] ağırlığıyla okur ve çok fazlı kurar (`_Evrişim._ters_kur`).
TR_func _ters_evrişim(a: _Alıcı, ad: TR_String, giriş: TR_Int, çıkış: TR_Int, k: TR_Int, adım: TR_Int) -> _Evrişim {
    TR_var w = a._evrişim(ad, [giriş, çıkış, k])
    TR_var e = _Evrişim(ağırlık: w, sapma: TR_none, dolgu: 0, genişleme: 1, grup: 1, ara: 1)
    e._ters_kur(w, a._al("\(ad).bias", [çıkış]), adım)
    TR_return e
}

TR_func _çözücü(a: _Alıcı, ayar: TR_JSON) -> _Çözücü {
    TR_var ilk = _sayı(ayar, "upsample_initial_channel")
    TR_var oranlar = _sayılar(ayar, "upsample_rates")
    TR_var çekirdekler = _sayılar(ayar, "upsample_kernel_sizes")
    TR_var blok_çekirdekleri = _sayılar(ayar, "resblock_kernel_sizes")
    TR_var genişlemeler = [[TR_Int(e) TR_for e TR_in l] TR_for l TR_in _alan(ayar, "resblock_dilation_sizes")]
    TR_var eğim = _ondalık(ayar, "leaky_relu_slope")
    TR_var büyütücüler: TR_List[_Evrişim] = []
    TR_var bloklar: TR_List[TR_List[_ArtıkBlok]] = []
    TR_var kanal = ilk
    TR_var sıra = 0
    TR_for i TR_in 0..oranlar.TR_length {
        TR_var yeni = ilk // (2 ** (i + 1))
        büyütücüler.TR_append(_ters_evrişim(a, "decoder.upsampler.\(i)", kanal, yeni, çekirdekler[i], oranlar[i]))
        TR_var aşama: TR_List[_ArtıkBlok] = []
        TR_for j TR_in 0..blok_çekirdekleri.TR_length {
            TR_var k = blok_çekirdekleri[j]
            TR_var r = "decoder.resblocks.\(sıra)"
            TR_var g = genişlemeler[j]
            TR_if a._var("\(r).convs.0.weight") {
                # Tip 2: her genişlemede tek evrişim (`convs`).
                TR_var tekler = [_evrişim(a, "\(r).convs.\(m)", yeni, yeni, k, dolgu: (k * g[m] - g[m]) // 2, genişleme: g[m]) TR_for m TR_in 0..g.TR_length]
                aşama.TR_append(_ArtıkBlok(birinciler: tekler, ikinciler: []))
            } TR_else {
                TR_var birinciler = [_evrişim(a, "\(r).convs1.\(m)", yeni, yeni, k, dolgu: (k * g[m] - g[m]) // 2, genişleme: g[m]) TR_for m TR_in 0..g.TR_length]
                TR_var ikinciler = [_evrişim(a, "\(r).convs2.\(m)", yeni, yeni, k, dolgu: (k - 1) // 2) TR_for m TR_in 0..g.TR_length]
                aşama.TR_append(_ArtıkBlok(birinciler: birinciler, ikinciler: ikinciler))
            }
            sıra = sıra + 1
        }
        bloklar.TR_append(aşama)
        kanal = yeni
    }
    TR_return _Çözücü(ön: _evrişim(a, "decoder.conv_pre", ilk, _sayı(ayar, "flow_size"), 7, dolgu: 3), büyütücüler: büyütücüler, bloklar: bloklar,
        son: _evrişim(a, "decoder.conv_post", 1, kanal, 7, dolgu: 3, sapmalı: TR_false), eğim: eğim)
}

TR_func _parçalayıcı(yol: TR_String) -> _Parçalayıcı {
    TR_var ayar = TR_json_parse(TR_read_file(_dosya(yol, _PARÇALAYICI)))
    TR_if TR_Bool(ayar.TR_get("phonemize") ?? TR_JSON(TR_false)) { TR_throw TR_Message("H7557", "phonemize", TR_true, "other") }
    TR_if TR_Bool(ayar.TR_get("is_uroman") ?? TR_JSON(TR_false)) { TR_throw TR_Message("H7557", "is_uroman", TR_true, "other") }
    TR_var sözlük: TR_Dict[TR_String, TR_Int] = {}
    TR_var sözcükler: TR_List[TR_List[TR_String]] = []
    TR_for k, v TR_in TR_json_parse(TR_read_file(_dosya(yol, _SÖZLÜK))) {
        sözlük[k] = TR_Int(v)
        sözcükler.TR_append([c TR_for c TR_in k])
    }
    TR_return _Parçalayıcı(sözlük: sözlük, sözcükler: sözcükler, boşluk_ekle: TR_Bool(ayar.TR_get("add_blank") ?? TR_JSON(TR_true)), normalle: TR_Bool(ayar.TR_get("normalize") ?? TR_JSON(TR_true)))
}

TR_func _dosya(yol: TR_String, ad: TR_String) -> TR_Path {
    TR_var p = TR_Path(TR_Path(yol), ad)
    TR_if TR_not p.TR_exists { TR_throw TR_Message("H7550", yol, ad) }
    TR_return p
}

# hazır_vits bir VITS sesi açar. Yol bir `.onnx` dosyasıysa Piper sesidir (yanında aynı adlı `.onnx.json`);
# değilse Hugging Face klasörüdür: config.json, model.safetensors, vocab.json, tokenizer_config.json.
TR_func TR_pretrained_vits(yol: TR_String) -> TR_Vits {
    TR_if yol.TR_lower().TR_ends_with(".onnx") { TR_return _piper(yol) }
    TR_var ayar = TR_json_parse(TR_read_file(_dosya(yol, _AYAR)))
    TR_var mimari = TR_String(_alan(ayar, "model_type"))
    TR_if mimari != "vits" { TR_throw TR_Message("H7552", yol, mimari) }
    _desteklenen(ayar)
    TR_var a = _Alıcı(tensörler: TR_load_tensors(TR_String(_dosya(yol, _AĞIRLIK))), alınan: {})
    a._atla(["posterior_encoder."])
    TR_return _kur(a, ayar, _parçalayıcı(yol), yol, "", {}, TR_false)
}

# _kur adları Hugging Face'inkiler olan tensörlerden ve ayardan modeli kurar; iki biçim de buradan geçer.
TR_func _kur(a: _Alıcı, ayar: TR_JSON, parçalayıcı: _Parçalayıcı, ad: TR_String, dil: TR_String, fonemler: TR_Dict[TR_String, TR_List[TR_Int]], piper: TR_Bool) -> TR_Vits {
    # Çift WaveNet çekirdeğinde ilk katmanın (k − 1)·g'si tektir: akış katlanamaz (eski yol da koşmuyordu).
    TR_if _sayı(ayar, "wavenet_kernel_size") % 2 == 0 { TR_throw TR_Message("H7557", "wavenet_kernel_size", _alan(ayar, "wavenet_kernel_size"), "kernel") }
    TR_var h = _sayı(ayar, "hidden_size")
    TR_var f = _sayı(ayar, "flow_size")
    TR_var yarım = f // 2
    TR_var ters_yarım = TR_Tensor[TR_Int]([yarım - 1 - j TR_for j TR_in 0..yarım])
    TR_var katmanlar = [_katman(a, "text_encoder.encoder.layers.\(i)", ayar) TR_for i TR_in 0.._sayı(ayar, "num_hidden_layers")]
    TR_var akışlar: TR_List[_Bağlaşım] = []
    TR_var i = _sayı(ayar, "prior_encoder_num_flows") - 1
    TR_for i >= 0 {
        akışlar.TR_append(_bağlaşım(a, "flow.flows.\(i)", ayar, akışlar.TR_length, ters_yarım))
        i = i - 1
    }
    TR_var gömme = a._al("text_encoder.embed_tokens.weight", [_sayı(ayar, "vocab_size"), h]) * TR_sqrt(TR_Float(h))
    TR_var izdüşüm = TR_Tensor(a._evrişim("text_encoder.project", [2 * f, h, 1]).TR_reshape([2 * f, h]).TR_transpose())
    TR_var izdüşüm_sapma = a._al("text_encoder.project.bias", [2 * f]).TR_reshape([1, 2 * f])
    TR_var süre = _süre(a, ayar)
    TR_var çözücü = _çözücü(a, ayar)
    a._bitir()
    TR_var model = TR_Vits(_parçalayıcı: parçalayıcı, _gömme: gömme, _katmanlar: katmanlar, _izdüşüm: izdüşüm, _izdüşüm_sapma: izdüşüm_sapma,
        _süre: süre, _akışlar: akışlar, _ters_yarım: ters_yarım, _çözücü: çözücü, _boyut: h, _akış_boyu: f,
        _hız: _ondalık(ayar, "speaking_rate"), _gürültü: _ondalık(ayar, "noise_scale"),
        _süre_gürültüsü: _ondalık(ayar, "noise_scale_duration"), _örnek_hızı: _sayı(ayar, "sampling_rate"),
        _fonemler: fonemler, _piper: piper, _ad: ad)
    model.TR_voice_language = dil
    TR_return model
}

# Piper sesi. Ses tek dosyadır: `.onnx` (ağırlıklar, Piper'ın dışa vericisinin adlarıyla) ve yanında `.onnx.json`
# (örnek hızı, ölçekler, fonem kimlikleri, dil). Ağ özgün VITS'tir ve yukarıdaki kurulumla aynıdır: adlar
# Hugging Face'inkilere çevrilir, mimari ağırlık şekillerinden ve Piper'ın ön ayarından çıkar. Piper'ın kodu
# (GPL-3) kopyalanmadı; davranış piper-tts 1.8.0'dan okundu ve testlerde ölçülür.

TR_const _PIPER_EĞİM = 0.1 # HiFi-GAN'ın gevşek eğimi (`LRELU_SLOPE`)
TR_const _PIPER_SINIR = 5.0 # süre akışlarının spline sınırı (`tail_bound`)
TR_const _PIPER_EPS = 0.00001 # katman normunun eps'i
# Piper'ın HiFi-GAN ön ayarlarının blok başına genişlemeleri (piper-tts 1.8.0 `train/vits/config.py`); tip ağırlık
# adından anlaşılır: tip 1 `convs1`/`convs2`, tip 2 `convs`. Genişleme dosyadan okunmaz (düğümler okunmaz).
TR_const _PIPER_GENİŞLEMELER = {"1": [[1, 3, 5], [1, 3, 5], [1, 3, 5]], "2": [[1, 2], [2, 6], [3, 12]]}
TR_const _PIPER_DİKKAT = {"conv_q": "q_proj", "conv_k": "k_proj", "conv_v": "v_proj", "conv_o": "out_proj"}
TR_const _PIPER_AYRIK = {"convs_sep": "convs_dilated", "convs_1x1": "convs_pointwise", "norms_1": "norms_1", "norms_2": "norms_2"}
TR_const _PIPER_AKIŞ = {"pre": "conv_pre", "convs": "conv_dds", "proj": "conv_proj", "post": "conv_post", "enc": "wavenet"}

# _kalan p'nin i'den sonraki parçalarını noktayla birleştirir.
TR_func _kalan(p: TR_List[TR_String], i: TR_Int) -> TR_String { TR_return p[i..p.TR_length].TR_join(".") }

# _norm_adı LayerNorm'un `gamma`/`beta`'sını `weight`/`bias` yapar.
TR_func _norm_adı(ad: TR_String) -> TR_String {
    TR_if ad == "gamma" { TR_return "weight" }
    TR_if ad == "beta" { TR_return "bias" }
    TR_return ad
}

# _ayrık_adı ayrık evrişimin (`DDSConv`) alt adını çevirir: `convs_sep.0.weight` → `convs_dilated.0.weight`.
TR_func _ayrık_adı(p: TR_List[TR_String], i: TR_Int) -> TR_String? {
    TR_if p.TR_length != i + 3 TR_or TR_not _PIPER_AYRIK.TR_contains(p[i]) { TR_return TR_none }
    TR_return "\(_PIPER_AYRIK[p[i]]).\(p[i + 1]).\(_norm_adı(p[i + 2]))"
}

# _piper_adı Piper'ın (özgün VITS'in) ağırlık adının Hugging Face'teki adını ve yükleme işlemini verir: [ad, işlem].
# İşlem "" (olduğu gibi), "doğrusal" ([h, h, 1] evrişim → [h, h]), "eksi_log" (dışa vericinin katladığı
# `exp(-logs)` → `logs`) ya da "eksi" (`-logs` → `logs`). Çizgenin sabitleri (adı `/`, `onnx::` ya da rakamla başlayan,
# ya da `:` taşıyan) boş liste verir.
# Tanınmayan ağırlık adı olduğu gibi kalır: kurulumun sonunda H7556'dır.
TR_func _piper_adı(ad: TR_String) -> TR_List[TR_String] {
    TR_if ad == "sid" { TR_return ["text_encoder.embed_tokens.weight", ""] }
    # Öteleme ölçeğinin iki dışa verilişi: torch 2.0 `Exp`'i katlar (initializer `exp(-logs)`, gerçek seslerde);
    # torch 2.6 `Exp` düğümünü bırakır, girdisi adsız `-logs`'tur (A1'in adlamasıyla `/dp/flows.0/Exp:0`).
    TR_if ad == "/dp/flows.0/Exp_output_0" { TR_return ["duration_predictor.flows.0.log_scale", "eksi_log"] }
    TR_if ad == "/dp/flows.0/Exp:0" { TR_return ["duration_predictor.flows.0.log_scale", "eksi"] }
    TR_var y = ad.TR_split("/")
    # Adsız WaveNet evrişimi: onu kullanan düğümün adı ve girdi sırası (15.47), `/flow/flows.<2k>/enc/<katman>.<j>/Conv:1`.
    TR_if y.TR_length == 6 TR_and y[1] == "flow" TR_and y[2].TR_starts_with("flows.") TR_and y[3] == "enc" TR_and y[5] == "Conv:1" {
        TR_return ["flow.flows.\(TR_Int(y[2][6..y[2].TR_length]) // 2).wavenet.\(y[4]).weight", ""]
    }
    # Kullanılan adsız sabit düğümün adını ve `:sıra`'yı alır (A1); ağırlık adında `:` geçmez.
    TR_if ad.TR_starts_with("/") TR_or ad.TR_starts_with("onnx::") TR_or ad.TR_contains(":") TR_or (ad.TR_length > 0 TR_and "0123456789".TR_contains(ad[0])) { TR_return [] }
    TR_var p = ad.TR_split(".")
    TR_var n = p.TR_length
    TR_if p[0] == "enc_p" TR_and n >= 3 TR_and p[1] == "proj" { TR_return ["text_encoder.project.\(_kalan(p, 2))", ""] }
    TR_if p[0] == "enc_p" TR_and n >= 5 TR_and p[1] == "encoder" {
        TR_var k = "text_encoder.encoder.layers.\(p[3])"
        TR_if p[2] == "attn_layers" TR_and _PIPER_DİKKAT.TR_contains(p[4]) TR_and n == 6 {
            TR_return ["\(k).attention.\(_PIPER_DİKKAT[p[4]]).\(p[5])", TR_if p[5] == "weight" { "doğrusal" } TR_else { "" }]
        }
        TR_if p[2] == "attn_layers" { TR_return ["\(k).attention.\(_kalan(p, 4))", ""] }
        TR_if p[2] == "norm_layers_1" TR_and n == 5 { TR_return ["\(k).layer_norm.\(_norm_adı(p[4]))", ""] }
        TR_if p[2] == "norm_layers_2" TR_and n == 5 { TR_return ["\(k).final_layer_norm.\(_norm_adı(p[4]))", ""] }
        TR_if p[2] == "ffn_layers" { TR_return ["\(k).feed_forward.\(_kalan(p, 4))", ""] }
    }
    TR_if p[0] == "dp" TR_and n >= 3 {
        TR_var d = "duration_predictor"
        TR_if p[1] == "flows" TR_and n >= 4 {
            TR_if p[2] == "0" TR_and n == 4 TR_and p[3] == "m" { TR_return ["\(d).flows.0.translate", ""] }
            # Piper'ın akış listesinde spline akışları tek sıralardadır (aralarda `Flip`): 2k − 1 → k.
            TR_var s = "\(d).flows.\((TR_Int(p[2]) + 1) // 2)"
            TR_if p[3] == "convs" {
                TR_var alt = _ayrık_adı(p, 4)
                TR_if alt != TR_none { TR_return ["\(s).conv_dds.\(alt)", ""] }
            } TR_else TR_if _PIPER_AKIŞ.TR_contains(p[3]) { TR_return ["\(s).\(_PIPER_AKIŞ[p[3]]).\(_kalan(p, 4))", ""] }
        }
        TR_if p[1] == "convs" {
            TR_var alt = _ayrık_adı(p, 2)
            TR_if alt != TR_none { TR_return ["\(d).conv_dds.\(alt)", ""] }
        }
        TR_if p[1] == "pre" TR_or p[1] == "proj" { TR_return ["\(d).\(_PIPER_AKIŞ[p[1]]).\(_kalan(p, 2))", ""] }
    }
    TR_if p[0] == "flow" TR_and n >= 5 TR_and p[1] == "flows" TR_and _PIPER_AKIŞ.TR_contains(p[3]) {
        # Akış listesinde bağlaşımlar çift sıralardadır (aralarda `Flip`): 2k → k.
        TR_return ["flow.flows.\(TR_Int(p[2]) // 2).\(_PIPER_AKIŞ[p[3]]).\(_kalan(p, 4))", ""]
    }
    TR_if p[0] == "dec" TR_and n >= 3 {
        TR_return ["decoder.\(TR_if p[1] == "ups" { "upsampler" } TR_else { p[1] }).\(_kalan(p, 2))", ""]
    }
    TR_return [ad, ""]
}

# _piper_alıcı dosyanın tensörlerini Hugging Face adlarıyla verir; çizgenin sabitleri atılır, iletiler dosyadaki adı söyler.
TR_func _piper_alıcı(dosya: TR_Dict[TR_String, TR_Tensor]) -> _Alıcı {
    TR_var çıkış: TR_Dict[TR_String, TR_Tensor] = {}
    TR_var adlar: TR_Dict[TR_String, TR_String] = {}
    TR_for ad, t TR_in dosya {
        TR_var y = _piper_adı(ad)
        TR_if y.TR_length == 0 { TR_continue }
        TR_var x = t
        TR_if y[1] == "doğrusal" { x = x.TR_reshape([x.TR_shape[0], x.TR_shape[1]]) }
        TR_if y[1] == "eksi_log" { x = -TR_log(x) }
        TR_if y[1] == "eksi" { x = -x }
        çıkış[y[0]] = x
        adlar[y[0]] = ad
    }
    TR_return _Alıcı(tensörler: çıkış, alınan: {}, dosyadaki: adlar)
}

# _şekil bir ağırlığın şeklidir; ağırlık yoksa H7553.
TR_func _şekil(t: TR_Dict[TR_String, TR_Tensor], ad: TR_String) -> TR_List[TR_Int] {
    TR_if TR_not t.TR_contains(ad) { TR_throw TR_Message("H7553", ad) }
    TR_return t[ad].TR_shape
}

# _say `<ön><i><son>` adlı ağırlıkları 0'dan sayar.
TR_func _say(t: TR_Dict[TR_String, TR_Tensor], ön: TR_String, son: TR_String, baş: TR_Int = 0) -> TR_Int {
    TR_var i = baş
    TR_for t.TR_contains("\(ön)\(i)\(son)") { i = i + 1 }
    TR_return i - baş
}

# _piper_ayarı Hugging Face'in config.json'unun kurulumun okuduğu alanlarını ağırlık şekillerinden, Piper'ın ön
# ayarından ve `.onnx.json`'dan kurar.
TR_func _piper_ayarı(t: TR_Dict[TR_String, TR_Tensor], ses: TR_JSON, dosya: TR_String) -> TR_JSON {
    TR_var n = TR_Int(ses.TR_get("num_speakers") ?? TR_JSON(1))
    TR_if n != 1 { TR_throw TR_Message("H7557", "num_speakers", n, "other") }
    TR_var gömme = _şekil(t, "text_encoder.embed_tokens.weight")
    TR_var h = gömme[1]
    TR_var göreli = _şekil(t, "text_encoder.encoder.layers.0.attention.emb_rel_k")
    TR_var ileri = _şekil(t, "text_encoder.encoder.layers.0.feed_forward.conv_1.weight")
    # Süre akışları ters yönde 2..n'dir; 1. akış dışa verilmez (ters yönde atılır).
    TR_var akış = 1 + _say(t, "duration_predictor.flows.", ".conv_pre.weight", baş: 2)
    TR_var büyütme = _say(t, "decoder.upsampler.", ".weight")
    TR_var çekirdekler = [_şekil(t, "decoder.upsampler.\(i).weight")[2] TR_for i TR_in 0..büyütme]
    TR_var tip = TR_if t.TR_contains("decoder.resblocks.0.convs.0.weight") { "2" } TR_else { "1" }
    TR_var blok_adı = TR_if tip == "2" { "convs" } TR_else { "convs1" }
    TR_var bloklar = _say(t, "decoder.resblocks.", ".\(blok_adı).0.weight") // TR_max(büyütme, 1)
    TR_var genişlemeler = _PIPER_GENİŞLEMELER[tip]
    TR_if bloklar != genişlemeler.TR_length { TR_throw TR_Message("H7557", "resblock_kernel_sizes", bloklar, "other") }
    TR_var çıkarım = _alan(ses, "inference", dosya)
    TR_return TR_JSON({
        "vocab_size": gömme[0], "hidden_size": h, "num_attention_heads": h // göreli[2], "window_size": (göreli[1] - 1) // 2,
        "num_hidden_layers": _say(t, "text_encoder.encoder.layers.", ".attention.q_proj.weight"),
        "ffn_dim": ileri[0], "ffn_kernel_size": ileri[2], "layer_norm_eps": _PIPER_EPS,
        "flow_size": _şekil(t, "text_encoder.project.weight")[0] // 2,
        "duration_predictor_kernel_size": _şekil(t, "duration_predictor.conv_dds.convs_dilated.0.weight")[2],
        "depth_separable_num_layers": _say(t, "duration_predictor.conv_dds.convs_dilated.", ".weight"),
        "duration_predictor_num_flows": akış, "duration_predictor_tail_bound": _PIPER_SINIR,
        "duration_predictor_flow_bins": (_şekil(t, "duration_predictor.flows.\(akış).conv_proj.weight")[0] + 1) // 3,
        "wavenet_kernel_size": _şekil(t, "flow.flows.0.wavenet.in_layers.0.weight")[2], "wavenet_dilation_rate": 1,
        "prior_encoder_num_wavenet_layers": _say(t, "flow.flows.0.wavenet.in_layers.", ".weight"),
        "prior_encoder_num_flows": _say(t, "flow.flows.", ".conv_pre.weight"),
        "upsample_initial_channel": _şekil(t, "decoder.conv_pre.weight")[0], "upsample_kernel_sizes": çekirdekler,
        "upsample_rates": [k // 2 TR_for k TR_in çekirdekler], "leaky_relu_slope": _PIPER_EĞİM,
        "resblock_kernel_sizes": [_şekil(t, "decoder.resblocks.\(j).\(blok_adı).0.weight")[2] TR_for j TR_in 0..bloklar],
        "resblock_dilation_sizes": genişlemeler,
        "speaking_rate": 1.0 / _ondalık(çıkarım, "length_scale", dosya), "noise_scale": _ondalık(çıkarım, "noise_scale", dosya),
        "noise_scale_duration": _ondalık(çıkarım, "noise_w", dosya), "sampling_rate": _sayı(_alan(ses, "audio", dosya), "sample_rate", dosya)})
}

# _piper Piper sesini açar.
TR_func _piper(yol: TR_String) -> TR_Vits {
    TR_var ayar_yolu = "\(yol).json"
    TR_if TR_not TR_Path(ayar_yolu).TR_exists { TR_throw TR_Message("H7558", yol, ayar_yolu) }
    TR_var ses = TR_json_parse(TR_read_file(TR_Path(ayar_yolu)))
    TR_var a = _piper_alıcı(TR_load_tensors(yol))
    TR_var fonemler: TR_Dict[TR_String, TR_List[TR_Int]] = {}
    TR_for f, k TR_in _alan(ses, "phoneme_id_map", ayar_yolu) { fonemler[f] = [TR_Int(e) TR_for e TR_in k] }
    TR_var dil = ses.TR_get("language") ?? TR_JSON({})
    TR_var boş = _Parçalayıcı(sözlük: {}, sözcükler: [], boşluk_ekle: TR_false, normalle: TR_false)
    TR_return _kur(a, _piper_ayarı(a.tensörler, ses, ayar_yolu), boş, yol, TR_String(dil.TR_get("family") ?? TR_JSON("")), fonemler, TR_true)
}
