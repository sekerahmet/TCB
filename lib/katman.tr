// tr/katman — transformer katmanları ve yalnızca kod çözücülü GPT.
//
// Kullanım:   aktar "tr/katman"                (adlar doğrudan gelir: GPT, Doğrusal, ...)
//             aktar "tr/katman" olarak k       (k.GPT(...), k.Doğrusal(...))
// Her katman sıradan bir yapıdır: ağırlıklar alanlarındadır, ileri hesap `ileri` metodudur,
// `parametreler(model)` bütün ağırlıkları bulur. Bu dosyayı kopyalayıp değiştirebilirsiniz.
//
// Şekiller: girdiler [toplu, uzunluk, boyut] (kısaca [B, T, D]); çarpım `x @ W` biçimindedir,
// bu yüzden Doğrusal'ın ağırlığı [giriş, çıkış] şeklindedir.
// Başlatma: bütün ağırlık matrisleri N(0, 0.02) ile başlar (`std`); artık yola yazan çıkış
// katmanları (dikkatin `çıkış_katmanı`, ileri beslemenin `aşağı`sı) 0.02 / √(2 · katman sayısı) ile
// küçültülür, böylece derin modelde artık yolun varyansı katman sayısıyla büyümez. Norm
// ağırlıkları 1, sapmalar 0 ile başlar. Her ağırlığın kendi sabit tohumu vardır: aynı `tohum`
// aynı modeli verir.

// ağırlık_başlat şekli verilen, N(0, std) ile başlayan, türev izleyen bir ağırlık kurar; tür
// verilirse ağırlık o türde tutulur (ör. "bf16": hazır modellerin saklandığı tür).
fonksiyon ağırlık_başlat(şekil, std, tohum, tür = "float32") {
    sonuç tensör(türevsiz((rastgele_normal(şekil, tohum: tohum) * std).türe(tür)), türev_izle: doğru)
}

// Doğrusal: y = x @ ağırlık (+ sapma). ağırlık [giriş, çıkış], sapma [çıkış] ya da yok. tür
// ağırlığın türüdür (sapma float32): float32 x ile 16 bitlik ağırlığın çarpımı float32'dir (15.3),
// GPU'da ağırlık açılmadan okunur (çıkarımda okunan bayt yarıya iner).
// Sapma çarpımın türünde eklenir: karışık_hassasiyet("bf16") bloğunda çıktı bf16 kalır (float32
// sapma toplamı float32'ye yükseltmez). PyTorch'un autocast'i (F.linear sapmayı da bf16 işler) ve
// Flax'ın Dense'i (dtype sapmayı da kapsar) böyledir; sapmanın gradyanı float32 birikir (15.3).
// Hedef modelde float32 ara sonuçları ve geri dönüşümleri kaldırır (221 → 203 ms/adım).
yapı Doğrusal {
    ağırlık
    sapma
    fonksiyon kurucu(giriş, çıkış, sapmalı = yanlış, std = 0.02, tohum = 1, tür = "float32") {
        kendi.ağırlık = ağırlık_başlat([giriş, çıkış], std, tohum, tür: tür)
        kendi.sapma = eğer sapmalı { tensör(sıfırlar([çıkış]), türev_izle: doğru) } değilse { yok }
    }
    fonksiyon ileri(x) {
        eğer kendi.sapma == yok { sonuç x @ kendi.ağırlık }
        değişken y = x @ kendi.ağırlık
        sonuç y + kendi.sapma.türe(y.tür)
    }
}

// GömmeKatmanı: parça kimliklerini [dağarcık, boyut] tablosunun satırlarına çevirir
// (`gömme` yerleşiğiyle): [B, T] → [B, T, boyut]. tür tablonun türüdür; float32 olmayan tablonun
// satırları hesap türüne çevrilir (karışık hassasiyet dışında float32: etkinleşmeler 32 bit kalır).
yapı GömmeKatmanı {
    tablo
    fonksiyon kurucu(dağarcık, boyut, std = 0.02, tohum = 1, tür = "float32") {
        kendi.tablo = ağırlık_başlat([dağarcık, boyut], std, tohum, tür: tür)
    }
    fonksiyon ileri(kimlikler) {
        değişken e = gömme(kendi.tablo, kimlikler)
        eğer kendi.tablo.tür == "float32" { sonuç e }
        sonuç e.türe(hesap_türü())
    }
}

// RMSNormKatmanı: son eksende karelerin ortalamasının köküne böler, öğrenilen ağırlıkla
// çarpar (`rms_normu` yerleşiği). Ağırlık 1 ile başlar. Hesap float32'dir; çıktı girdinin
// türündedir, çıktı_türü verilirse o türde yazılır. Çıktısını yalnızca çarpımlar okuyorsa
// çağıran çıktı_türü: hesap_türü() verir: karışık hassasiyette normun float32 çıktısı ve onu
// çarpım için bf16'ya çeviren ayrı dönüşüm kalkar (PyTorch'ta torch.compile normu dönüşümle
// kaynaştırır; Flax'ta RMSNorm(dtype=...)). Hedef modelde 167 → 163 ms/adım, kayıplar aynı.
yapı RMSNormKatmanı {
    ağırlık
    epsilon = 0.00001
    fonksiyon kurucu(boyut, epsilon = 0.00001) {
        kendi.ağırlık = tensör(birler([boyut]), türev_izle: doğru)
        kendi.epsilon = epsilon
    }
    fonksiyon ileri(x, çıktı_türü = yok) {
        eğer çıktı_türü == yok { sonuç rms_normu(x, kendi.ağırlık, epsilon: kendi.epsilon) }
        sonuç rms_normu(x, kendi.ağırlık, epsilon: kendi.epsilon, tür: çıktı_türü)
    }
}

// Döner konum gömmesi (RoPE): bakış vektörünün iki yarısı (a, b) her konumda konuma bağlı bir
// açıyla döndürülür; sorgu ile anahtarın iç çarpımı böylece yalnızca aradaki uzaklığa bağlı
// olur. döner_konum_tablosu [kosinüs, sinüs] verir, ikisi de [bağlam, bakış_boyutu / 2].
// Frekanslar taban^(-2i / bakış_boyutu). Tablolar türev izlemez (öğrenilmez).
fonksiyon döner_konum_tablosu(bağlam, bakış_boyutu, taban = 10000.0) {
    değişken yarım = bakış_boyutu / 2
    değişken frekanslar = [taban ** (-2.0 * i / bakış_boyutu) döngü i içinde 0..yarım]
    değişken konumlar = tensör([[t] döngü t içinde 0..bağlam]) // [bağlam, 1]
    değişken açılar = konumlar @ tensör([frekanslar]) // [bağlam, yarım]
    sonuç [cos(açılar), sin(açılar)]
}

// döner_konum_hesapla x'i ([..., T, bakış, bakış_boyutu]; dikkat'in düzeni) tablonun ilk T satırıyla
// döndürür (bütün bakışlar aynı açıyla); sonuç
// x'in türündedir. Tablolar float32'dir: karışık hassasiyette bf16 x ile çarpım float32'ye
// yükselir, sonucu okuyan `dikkat` onu yine bf16'ya çevirirdi. Dönüşüm burada, kaynaşık
// geçişin sonunda yapılır: değer aynıdır (bir kez yuvarlanır), float32 sonuç ve ayrı dönüşüm
// kalkar. döner_konum_uygula aynı hesabın kaynaşmış biçimidir (kaynaştır, dil tanımı 15.44):
// zincir tek geçişte hesaplanır, ara sonuçlar belleğe yazılmaz; sonuç aynıdır.
fonksiyon döner_konum_hesapla(x, cos_tablosu, sin_tablosu) {
    değişken T = x.şekil[-3]
    değişken a, b = x.böl(2, eksen: -1)
    değişken c = cos_tablosu[0..T].şekillendir([T, 1, cos_tablosu.şekil[-1]])
    değişken s = sin_tablosu[0..T].şekillendir([T, 1, sin_tablosu.şekil[-1]])
    sonuç bitiştir([a * c - b * s, a * s + b * c], eksen: -1).türe(x.tür)
}
değişken döner_konum_uygula = kaynaştır(döner_konum_hesapla)

// NedenselDikkat: döner konumlu, nedensel çok bakışlı dikkat. Her konum yalnızca kendisine ve
// öncekilere bakar. kv_bakış_sayısı < bakış_sayısı gruplu sorgu dikkatidir (GQA): anahtar ve değer bakışları
// ardışık bakış gruplarınca paylaşılır, anahtar/değer katmanları küçülür. Hesap birleşik
// `dikkat` yerleşiğindedir (T×T puan matrisi tutulmaz).
// Seçenekler (varsayılanlar eski davranıştır):
//   pencere: w > 0 ise yerel dikkat; her konum yalnızca son w konuma (kendisi dahil) bakar
//            (`dikkat(..., pencere: w)`); 0 tam nedensel. Pencere katmanın özelliğidir:
//            yerel/genel katman düzeni, her bloğa kendi penceresi verilerek kurulur.
//   qk_normu: q ve k'ya bakış boyutunda RMS normu (q_norm, k_norm; döner konumdan ÖNCE).
//   birleşik_kv: anahtar ve değer tek `kv_katmanı` ([boyut, 2·kv_boyut], [K | V]) olur ve
//            `.böl(2)` ile ayrılır; Muon K ve V'yi birlikte dikleştirir. Aksi hâlde
//            anahtar_katmanı ve değer_katmanı ayrıdır (kv_katmanı yok'tur; birleşikte tersi).
//   epsilon: qk normlarının epsilon'u.
//   bakış_boyutu: bir bakışın boyutu; yok ise boyut / bakış_sayısı. Verilirse gizli boyuttan bağımsızdır
//            (Hugging Face `head_dim`; Qwen3-0.6B: gizli 1024, 16 bakış × 128): sorgu katmanı
//            [boyut, bakış_sayısı · bakış_boyutu], çıkış katmanı [bakış_sayısı · bakış_boyutu, boyut] olur. Döner konum
//            başı iki yarıya böldüğünden çift olmalıdır.
yapı NedenselDikkat {
    bakış_sayısı
    kv_bakış_sayısı
    bakış_boyutu
    pencere
    sorgu_katmanı
    anahtar_katmanı
    değer_katmanı
    kv_katmanı
    q_norm
    k_norm
    çıkış_katmanı
    fonksiyon kurucu(boyut, bakış_sayısı, kv_bakış_sayısı = yok, sapmalı = yanlış, std = 0.02, çıkış_std = 0.02, tohum = 1, pencere = 0, qk_normu = yanlış, birleşik_kv = yanlış, epsilon = 0.00001, bakış_boyutu = yok, ağırlık_türü = "float32") {
        eğer kv_bakış_sayısı == yok { kv_bakış_sayısı = bakış_sayısı }
        eğer bakış_boyutu == yok {
            doğrula(boyut % bakış_sayısı == 0, "boyut ({boyut}) bakış sayısına ({bakış_sayısı}) bölünmeli")
            bakış_boyutu = boyut / bakış_sayısı
        }
        doğrula(bakış_boyutu > 0 ve bakış_boyutu % 2 == 0, "bakış_boyutu ({bakış_boyutu}) pozitif ve çift olmalı (döner konum başı iki yarıya böler)")
        doğrula(bakış_sayısı % kv_bakış_sayısı == 0, "bakış sayısı ({bakış_sayısı}) kv_bakış_sayısı ({kv_bakış_sayısı}) ile bölünmeli")
        doğrula(pencere >= 0, "pencere negatif olamaz, {pencere} verildi")
        kendi.bakış_sayısı = bakış_sayısı
        kendi.kv_bakış_sayısı = kv_bakış_sayısı
        kendi.bakış_boyutu = bakış_boyutu
        kendi.pencere = pencere
        değişken kv_boyut = kv_bakış_sayısı * bakış_boyutu
        kendi.sorgu_katmanı = Doğrusal(boyut, bakış_sayısı * bakış_boyutu, sapmalı: sapmalı, std: std, tohum: tohum, tür: ağırlık_türü)
        eğer birleşik_kv {
            kendi.anahtar_katmanı = yok
            kendi.değer_katmanı = yok
            kendi.kv_katmanı = Doğrusal(boyut, 2 * kv_boyut, sapmalı: sapmalı, std: std, tohum: tohum + 1, tür: ağırlık_türü)
        } değilse {
            kendi.anahtar_katmanı = Doğrusal(boyut, kv_boyut, sapmalı: sapmalı, std: std, tohum: tohum + 1, tür: ağırlık_türü)
            kendi.değer_katmanı = Doğrusal(boyut, kv_boyut, sapmalı: sapmalı, std: std, tohum: tohum + 2, tür: ağırlık_türü)
            kendi.kv_katmanı = yok
        }
        kendi.q_norm = eğer qk_normu { RMSNormKatmanı(kendi.bakış_boyutu, epsilon: epsilon) } değilse { yok }
        kendi.k_norm = eğer qk_normu { RMSNormKatmanı(kendi.bakış_boyutu, epsilon: epsilon) } değilse { yok }
        kendi.çıkış_katmanı = Doğrusal(bakış_sayısı * bakış_boyutu, boyut, sapmalı: sapmalı, std: çıkış_std, tohum: tohum + 3, tür: ağırlık_türü)
    }
    // x [B, T, D]; cos_tablosu/sin_tablosu döner_konum_tablosu'ndan (önbellekli çağrıda konumdan başlayan
    // satırlar). önbellek verilirse (KVÖnbellek) yeni anahtar ve değerler katman no'ya eklenir ve
    // sorgular önbellekteki bütün konumlara bakar (dikkat'te nedensellik sondan hizalıdır, 15.24).
    fonksiyon ileri(x, cos_tablosu, sin_tablosu, önbellek = yok, no = 0) {
        değişken B = x.şekil[0]
        değişken T = x.şekil[1]
        değişken k_ham = yok
        değişken v_ham = yok
        eğer kendi.kv_katmanı != yok {
            değişken kv = kendi.kv_katmanı.ileri(x).böl(2, eksen: -1) // [K | V]
            k_ham = kv[0]
            v_ham = kv[1]
        } değilse {
            k_ham = kendi.anahtar_katmanı.ileri(x)
            v_ham = kendi.değer_katmanı.ileri(x)
        }
        // [B, T, bakış · bakış_boyutu] → [B, T, bakış, bakış_boyutu]: dikkat'in düzeni (dil tanımı 15.24),
        // bakışlar şekillendirmeyle ayrılır, kopya yoktur.
        değişken q = kendi.sorgu_katmanı.ileri(x).şekillendir([B, T, kendi.bakış_sayısı, kendi.bakış_boyutu])
        değişken k = k_ham.şekillendir([B, T, kendi.kv_bakış_sayısı, kendi.bakış_boyutu])
        değişken v = v_ham.şekillendir([B, T, kendi.kv_bakış_sayısı, kendi.bakış_boyutu])
        eğer kendi.q_norm != yok {
            q = kendi.q_norm.ileri(q)
            k = kendi.k_norm.ileri(k)
        }
        q = döner_konum_uygula(q, cos_tablosu, sin_tablosu)
        k = döner_konum_uygula(k, cos_tablosu, sin_tablosu)
        değişken y = yok
        eğer önbellek != yok ve önbellek.adım_konumu != yok {
            // Cihaz adımı (GPT.tek_adım): konum cihazdadır, sorgu bütün tampona maskeyle bakar.
            değişken kv = önbellek.ekle(no, k, v)
            y = dikkat(q, kv[0], kv[1], nedensel: yanlış, maske: önbellek.maske(kendi.pencere))
        } değilse {
            eğer önbellek != yok {
                değişken kv = önbellek.ekle(no, k, v)
                k = kv[0]
                v = kv[1]
            }
            y = dikkat(q, k, v, nedensel: doğru, pencere: kendi.pencere) // [B, T, bakış, bakış_boyutu]
        }
        sonuç kendi.çıkış_katmanı.ileri(y.şekillendir([B, T, kendi.bakış_sayısı * kendi.bakış_boyutu]))
    }
}

// swiglu_ara_boyutu: SwiGLU'nun ara boyutu için yaygın seçim, 8/3 · boyut, 32'nin katına
// yukarı yuvarlanır (üç matrisli ileri besleme, 4 · boyut'luk iki matrisliyle aynı büyüklükte).
fonksiyon swiglu_ara_boyutu(boyut) {
    sonuç tam(tavan(8.0 * boyut / 3.0 / 32.0)) * 32
}

// swiglu_kapısı: SwiGLU'nun kapısı silu(g) · u; birleşik [G | U] çıktısında g ve u yarılardır.
// İkisi de kaynaşmıştır (tek geçiş).
fonksiyon swiglu_kapısı(g, u) { sonuç silu(g) * u }
fonksiyon swiglu_birleşik_kapısı(gu) {
    değişken g, u = gu.böl(2, eksen: -1)
    sonuç silu(g) * u
}
değişken swiglu_kapı = kaynaştır(swiglu_kapısı)
değişken swiglu_birleşik_kapı = kaynaştır(swiglu_birleşik_kapısı)

// SwiGLU: kapılı ileri besleme. aşağı(silu(kapı(x)) * yukarı(x)).
// birleşik: doğru ise kapı ve yukarı tek `kapı_yukarı` katmanıdır ([boyut, 2·ara], [G | U]) ve
// `.böl(2)` ile ayrılır (Muon ikisini birlikte dikleştirir); kapı ve yukarı o zaman yok'tur.
// sapmalı: bütün katmanların sapması (birleşikte kapı_yukarı'nın sapması [2·ara]).
yapı SwiGLU {
    kapı
    yukarı
    kapı_yukarı
    aşağı
    fonksiyon kurucu(boyut, ara_boyut = yok, sapmalı = yanlış, std = 0.02, çıkış_std = 0.02, tohum = 1, birleşik = yanlış, ağırlık_türü = "float32") {
        eğer ara_boyut == yok { ara_boyut = swiglu_ara_boyutu(boyut) }
        eğer birleşik {
            kendi.kapı = yok
            kendi.yukarı = yok
            kendi.kapı_yukarı = Doğrusal(boyut, 2 * ara_boyut, sapmalı: sapmalı, std: std, tohum: tohum, tür: ağırlık_türü)
        } değilse {
            kendi.kapı = Doğrusal(boyut, ara_boyut, sapmalı: sapmalı, std: std, tohum: tohum, tür: ağırlık_türü)
            kendi.yukarı = Doğrusal(boyut, ara_boyut, sapmalı: sapmalı, std: std, tohum: tohum + 1, tür: ağırlık_türü)
            kendi.kapı_yukarı = yok
        }
        kendi.aşağı = Doğrusal(ara_boyut, boyut, sapmalı: sapmalı, std: çıkış_std, tohum: tohum + 2, tür: ağırlık_türü)
    }
    fonksiyon ileri(x) {
        eğer kendi.kapı_yukarı != yok {
            sonuç kendi.aşağı.ileri(swiglu_birleşik_kapı(kendi.kapı_yukarı.ileri(x)))
        }
        sonuç kendi.aşağı.ileri(swiglu_kapı(kendi.kapı.ileri(x), kendi.yukarı.ileri(x)))
    }
}

// ple_gelu PLE'nin etkinleştirmesidir: tam (erf tabanlı) GELU, hedef modelin F.gelu'su gibi.
fonksiyon ple_gelu(x) { sonuç gelu(x, yaklaşık: yanlış) }

// ple_karışımı PLE bloğunun eleman bazlı zinciridir: GELU(kapı) ⊙ (bağlam + ölçek · satır) / √2
// (ölçek = √P); ple_karış onun kaynaşmış biçimidir. Sonuç kapının türündedir (karışık
// hassasiyette bf16): float32 tablo satırı zinciri float32'ye yükseltir, sonucu yalnızca
// izdüşüm çarpımı okur; dönüşüm kaynaşık geçişin sonunda yapılır (bkz. döner_konum_hesapla).
fonksiyon ple_karışımı(kapı, bağlam, satır, ölçek) {
    sonuç (ple_gelu(kapı) * ((bağlam + ölçek * satır) / karekök(2.0))).türe(kapı.tür)
}
değişken ple_karış = kaynaştır(ple_karışımı)

// PLEBağlamı: katman başına kelime gömmesinin (PLE, Gemma 3n) modele ortak bağlam yarısı.
// Gömme çıktısı x [B, T, D] tek matrisle [B, T, katman · P]'ye çevrilir, √D'ye bölünür,
// katman başına P'lik parçalara bölünür ve her parça ortak bir RMS normundan geçer:
//   bağlam_i = RMSNorm_P((x @ W_ctx) / √D)_i
// `ileri(x)` katman sayısı kadar [B, T, P] tensörlük bir liste verir; i. eleman i. bloğun
// PLEBloğu.ileri'sine girer. ağırlık_türü W_ctx'in türüdür (GPT'den iletilir).
yapı PLEBağlamı {
    boyut
    katman
    ple_boyutu
    ctx_katmanı
    norm
    fonksiyon kurucu(boyut, katman, ple_boyutu, epsilon = 0.00001, std = 0.02, tohum = 1, ağırlık_türü = "float32") {
        kendi.boyut = boyut
        kendi.katman = katman
        kendi.ple_boyutu = ple_boyutu
        kendi.ctx_katmanı = Doğrusal(boyut, katman * ple_boyutu, std: std, tohum: tohum, tür: ağırlık_türü)
        kendi.norm = RMSNormKatmanı(ple_boyutu, epsilon: epsilon)
    }
    fonksiyon ileri(x) {
        değişken h = kendi.ctx_katmanı.ileri(x) / karekök(kendi.boyut)
        sonuç [kendi.norm.ileri(parça) döngü parça içinde h.böl(kendi.katman, eksen: -1)]
    }
}

// PLEBloğu: bir katmanın PLE yarısı (blok sonunda çalışır). Katmanın kendi tablosu
// ([dağarcık, P], N(0, std)) kelime kimliğiyle okunur ve ortak bağlamla karışır:
//   e = (bağlam_i + √P · tablo_i[kelime]) / √2
//   H ← H + RMSNorm_D(W_p · (GELU(W_g · H) ⊙ e))
// W_g (kapı) [D, P], W_p (izdüşüm) [P, D]; izdüşüm artık yola yazar, çıkış_std ile başlar.
// ağırlık_türü tablonun ve iki matrisin türüdür (GPT'den iletilir).
yapı PLEBloğu {
    ple_boyutu
    tablo
    kapı
    izdüşüm
    norm
    fonksiyon kurucu(boyut, dağarcık, ple_boyutu, epsilon = 0.00001, std = 0.02, çıkış_std = 0.02, tohum = 1, ağırlık_türü = "float32") {
        kendi.ple_boyutu = ple_boyutu
        kendi.tablo = ağırlık_başlat([dağarcık, ple_boyutu], std, tohum, ağırlık_türü)
        kendi.kapı = Doğrusal(boyut, ple_boyutu, std: std, tohum: tohum + 1, tür: ağırlık_türü)
        kendi.izdüşüm = Doğrusal(ple_boyutu, boyut, std: çıkış_std, tohum: tohum + 2, tür: ağırlık_türü)
        kendi.norm = RMSNormKatmanı(boyut, epsilon: epsilon)
    }
    // h [B, T, D]; kimlikler [B, T]; bağlam bu katmanın PLEBağlamı çıktısı [B, T, P].
    fonksiyon ileri(h, kimlikler, bağlam) {
        değişken karışım = ple_karış(kendi.kapı.ileri(h), bağlam, gömme(kendi.tablo, kimlikler), karekök(kendi.ple_boyutu))
        sonuç h + kendi.norm.ileri(kendi.izdüşüm.ileri(karışım))
    }
}

// TransformerBloğu (ön-norm): x + dikkat(norm(x)), ardından x + ileri_besleme(norm(x)); ple_boyutu
// verilirse blok sonunda PLEBloğu'nun katkısı eklenir.
// Seçenekler (varsayılanlar eski davranıştır):
//   epsilon: blok içindeki bütün RMS normlarının (norm1, norm2, qk normları, PLE normu) epsilon'u.
//   pencere, qk_normu, birleşik_kv: NedenselDikkat'e iletilir (katman başına farklı pencere).
//   sapmalı: dikkat katmanlarının sapması; ileri_sapmalı: SwiGLU'nun sapması.
//   birleşik_kapı: SwiGLU'da [G | U] tek matris.
//   ple_boyutu (P) ve dağarcık: PLE için ikisi de verilmeli; yoksa blokta PLE yoktur (ple = yok).
// ileri(x, cos_tablosu, sin_tablosu, kimlikler, bağlam): kimlikler ve bağlam yalnızca PLE varken kullanılır.
yapı TransformerBloğu {
    norm1
    dikkat
    norm2
    ileri_besleme
    ple
    fonksiyon kurucu(boyut, bakış_sayısı, kv_bakış_sayısı = yok, ara_boyut = yok, std = 0.02, çıkış_std = 0.02, tohum = 1, epsilon = 0.00001, pencere = 0, qk_normu = yanlış, birleşik_kv = yanlış, sapmalı = yanlış, ileri_sapmalı = yanlış, birleşik_kapı = yanlış, ple_boyutu = yok, dağarcık = yok, bakış_boyutu = yok, ağırlık_türü = "float32") {
        kendi.norm1 = RMSNormKatmanı(boyut, epsilon: epsilon)
        kendi.dikkat = NedenselDikkat(boyut, bakış_sayısı, kv_bakış_sayısı: kv_bakış_sayısı, sapmalı: sapmalı, std: std, çıkış_std: çıkış_std, tohum: tohum, pencere: pencere, qk_normu: qk_normu, birleşik_kv: birleşik_kv, epsilon: epsilon, bakış_boyutu: bakış_boyutu, ağırlık_türü: ağırlık_türü)
        kendi.norm2 = RMSNormKatmanı(boyut, epsilon: epsilon)
        kendi.ileri_besleme = SwiGLU(boyut, ara_boyut: ara_boyut, sapmalı: ileri_sapmalı, std: std, çıkış_std: çıkış_std, tohum: tohum + 10, birleşik: birleşik_kapı, ağırlık_türü: ağırlık_türü)
        eğer ple_boyutu != yok {
            doğrula(dağarcık != yok, "TransformerBloğu: ple_boyutu için dağarcık da verilmeli")
            kendi.ple = PLEBloğu(boyut, dağarcık, ple_boyutu, epsilon: epsilon, std: std, çıkış_std: çıkış_std, tohum: tohum + 20, ağırlık_türü: ağırlık_türü)
        } değilse {
            kendi.ple = yok
        }
    }
    fonksiyon ileri(x, cos_tablosu, sin_tablosu, kimlikler = yok, bağlam = yok, önbellek = yok, no = 0) {
        // Norm çıktılarını yalnızca dikkatin ve ileri beslemenin ilk çarpımları okur.
        değişken h = x + kendi.dikkat.ileri(kendi.norm1.ileri(x, çıktı_türü: hesap_türü()), cos_tablosu, sin_tablosu, önbellek: önbellek, no: no)
        h = h + kendi.ileri_besleme.ileri(kendi.norm2.ileri(h, çıktı_türü: hesap_türü()))
        eğer kendi.ple != yok { sonuç kendi.ple.ileri(h, kimlikler, bağlam) }
        sonuç h
    }
}

// katman_pencereleri "YYGYGYYG" gibi bir düzen metninden katman başına pencere listesi kurar:
// G (genel) katman 0 (tam nedensel); Y (yerel) katmanlar `pencereler`i sırayla (döngüyle) alır.
// katman_pencereleri("YYGYGYYG", [32, 64]) → [32, 64, 0, 32, 0, 64, 32, 0]
fonksiyon katman_pencereleri(düzen, pencereler) {
    değişken liste = []
    değişken y = 0
    döngü harf içinde düzen {
        doğrula(harf == "Y" veya harf == "G", "katman düzeni yalnızca Y ve G içerir, {harf} bulundu")
        eğer harf == "G" {
            liste.ekle(0)
        } değilse {
            liste.ekle(pencereler[y % pencereler.uzunluk])
            y += 1
        }
    }
    sonuç liste
}

// KVÖnbellek: üretimde (çıkarımda) katmanların döner konumlu anahtar ve değerlerini tutar; her
// yeni parçada yalnızca o parça hesaplanır, öncekilerin anahtarları önbellekten okunur. Önbellek
// türev izlemez (çıkarım içindir). İki çeşidi vardır (transformers DynamicCache ve StaticCache gibi):
//   "sabit"   : her katman için [B, en_çok, kv_bakış, bakış_boyutu] tampon ilk yazmada bir kez
//               ayrılır; yeni anahtarlar zaman ekseninde yerine yazılır (gpt-fast, FlashAttention
//               kv önbelleği gibi), dikkat tamponun dolu kısmını görünüm olarak okur.
//   "büyüyen" : her adımda yeni anahtarlar bitiştir ile eklenir; bellek yalnızca kullanılan kadar.
// Düzen [B, T, kv_bakış, bakış_boyutu]: dikkat'in beklediği düzen (FlashAttention'ın kv önbelleği
// gibi), GQA'da kv bakışları çoğaltılmaz. konum önbellekteki parça sayısıdır (sonraki parçanın konumu).
// kırp(n) son parçaları geri alır (ör. reddedilen taslak); sabitte yazılı veri kalır ama okunmaz.
// Cihaz adımı (yalnızca sabit; GPT.tek_adım, tekrar_oynat ile kaydedilen üretim adımı):
// cihaz_adımı(konum) ile konum cihazdaki bir tensör olur ([1]); ekle yeni anahtarları o konuma
// yazar (yerine_yaz) ve bütün tamponu verir, maske(pencere) bakılacak konumları seçer (0/1:
// konum ve öncesi, pencere varsa son pencere kadarı). Kaydedilen adım konakta durum
// değiştirmez: konum sayacını çağıran ilerletir. Sabit boylu tampon ve cihazdaki konum
// transformers'ın sabit önbelleğiyle (cache_position) aynı yoldur.
yapı KVÖnbellek {
    çeşit
    en_çok
    konum
    anahtarlar
    değerler
    adım_konumu
    pozisyonlar
    maskeler
    fonksiyon kurucu(katman, çeşit = "sabit", en_çok = 0) {
        doğrula(çeşit == "sabit" veya çeşit == "büyüyen", "önbellek çeşidi \"sabit\" ya da \"büyüyen\" olmalı, {çeşit} verildi")
        doğrula(çeşit != "sabit" veya en_çok > 0, "sabit önbellek en_çok > 0 ister")
        kendi.çeşit = çeşit
        kendi.en_çok = en_çok
        kendi.konum = 0
        kendi.anahtarlar = [yok döngü _ içinde 0..katman]
        kendi.değerler = [yok döngü _ içinde 0..katman]
        kendi.adım_konumu = yok
        kendi.pozisyonlar = yok
        kendi.maskeler = {}
    }
    // cihaz_adımı: sonraki ekle'ler konumu (cihazdaki [1] tensörü; yok: konak konumu) kullanır.
    fonksiyon cihaz_adımı(konum) {
        doğrula(konum == yok veya kendi.çeşit == "sabit", "cihaz adımı yalnızca sabit önbellekte")
        kendi.adım_konumu = konum
        kendi.maskeler = {}
    }
    // maske: cihaz adımında bakılacak konumlar ([en_çok], 0/1); pencere başına adımda bir kez
    // kurulur, aynı pencereli katmanlar paylaşır.
    fonksiyon maske(pencere = 0) {
        değişken anahtar = "{pencere}"
        eğer değil kendi.maskeler.içerir(anahtar) {
            değişken m = kendi.pozisyonlar <= kendi.adım_konumu
            eğer pencere > 0 { m = m * (kendi.pozisyonlar > kendi.adım_konumu - pencere) }
            kendi.maskeler[anahtar] = m
        }
        sonuç kendi.maskeler[anahtar]
    }
    // ekle: katman no'nun yeni anahtar ve değerlerini ([B, T, kv_bakış, bakış_boyutu]) konumdan
    // başlayarak ekler; o katmanın 0..konum+T anahtar ve değerlerini verir.
    fonksiyon ekle(no, k, v) {
        değişken son = kendi.konum + k.şekil[1]
        eğer kendi.çeşit == "sabit" ve kendi.adım_konumu == yok {
            doğrula(son <= kendi.en_çok, "sabit önbellek dolu: {son} konum, en çok {kendi.en_çok}")
            eğer kendi.anahtarlar[no] == yok ve kendi.pozisyonlar == yok {
                kendi.pozisyonlar = tensör([i * 1.0 döngü i içinde 0..kendi.en_çok]).cihaza(k.cihaz)
            }
        }
        sonuç [kendi.tampon_ekle(kendi.anahtarlar, no, k, son), kendi.tampon_ekle(kendi.değerler, no, v, son)]
    }
    // tampon_ekle: anahtar ya da değer tamponları listesinde (liste) katman no'nun tamponuna yeni
    // parçayı çeşide göre ekler ve katmanın görünür kısmını verir: büyüyen bitiştirir, cihaz adımında
    // yerine yazar, sabit tamponu ilk kullanımda ayırıp konumdan başlayarak dilime yazar.
    fonksiyon tampon_ekle(liste, no, yeni, son) {
        eğer kendi.çeşit == "büyüyen" {
            eğer liste[no] == yok {
                liste[no] = yeni
            } değilse {
                liste[no] = bitiştir([liste[no].dilim(1, 0, kendi.konum), yeni], eksen: 1)
            }
            sonuç liste[no]
        }
        eğer kendi.adım_konumu != yok {
            yerine_yaz(liste[no], yeni, eksen: 1, başlangıç: kendi.adım_konumu[0])
            sonuç liste[no]
        }
        eğer liste[no] == yok {
            liste[no] = sıfırlar([yeni.şekil[0], kendi.en_çok, yeni.şekil[2], yeni.şekil[3]], tür: yeni.tür).cihaza(yeni.cihaz)
        }
        liste[no].dilim(1, kendi.konum, son)[0..yeni.şekil[0]] = yeni
        sonuç liste[no].dilim(1, 0, son)
    }
    // ilerle: bir ileri hesabın T parçası bütün katmanlara yazıldıktan sonra konumu ilerletir.
    fonksiyon ilerle(T) { kendi.konum = kendi.konum + T }
    // kırp: önbelleği ilk n parçaya indirir (n ≤ konum).
    fonksiyon kırp(n) {
        doğrula(n >= 0 ve n <= kendi.konum, "kırp: 0 ile {kendi.konum} arasında olmalı, {n} verildi")
        kendi.konum = n
    }
}

// GPT: yalnızca kod çözücülü dil modeli. gömme → katman sayısı kadar blok → son norm →
// dağarcık üzerinde logit. paylaşımlı: doğru ise çıkış katmanı gömme tablosunu kullanır
// (logit = h @ tablo.devrik(); ayrı çıkış ağırlığı yoktur).
// Ayarlar: dağarcık (parça sayısı), bağlam (en uzun dizi), boyut, katman, bakış_sayısı, kv_bakış_sayısı (yok:
// bakış_sayısı ile aynı), ara_boyut (yok: swiglu_ara_boyutu), paylaşımlı, tohum.
// Blok seçenekleri (varsayılanlar eski modeli verir; ayrıntı TransformerBloğu'nda):
//   pencereler: katman başına pencere listesi (uzunluğu katman; 0 = genel, yok = hepsi genel);
//               yerel/genel düzen katman_pencereleri("YYGYGYYG", [32, 64]) ile kurulur.
//   qk_normu, birleşik_kv, birleşik_kapı, ileri_sapmalı, epsilon, bakış_boyutu: her bloğa iletilir
//               (bakış_boyutu döner konum tablolarının da boyudur; yok ise boyut / bakış_sayısı).
//   rope_tabanı: döner konumun frekans tabanı (Hugging Face rope_theta; Llama 2 10000, SmolLM2
//               100000, Qwen3 1000000).
//   ağırlık_türü: matris ağırlıklarının (gömme tablosu ve doğrusal katmanlar) türü; normlar float32
//               kalır, etkinleşmeler hesap türündedir (karışık hassasiyet dışında float32).
//               "bf16" hazır modellerin saklandığı türdür: çıkarımda GPU okunan baytı yarıya indirir.
//   ple_boyutu: verilirse her blokta PLE vardır; modelde ortak PLEBağlamı (`ple_bağlamı`) gömme
//               çıktısından katman başına bağlamı üretir ve i. bloğa i. parçayı verir.
// RGN-512 gibi bir model bu yapıyla tek çağrıdır:
//   GPT(40000, bağlam: 1024, boyut: 512, katman: 8, bakış_sayısı: 8, kv_bakış_sayısı: 4, ara_boyut: 672, paylaşımlı: doğru,
//       pencereler: katman_pencereleri("YYGYGYYG", [32, 64]), qk_normu: doğru, birleşik_kv: doğru,
//       birleşik_kapı: doğru, ileri_sapmalı: doğru, epsilon: 0.000001, ple_boyutu: 512)
// Neden GPT'ye seçenek, ayrı bir model yapısı değil: gömme → bloklar → norm → logit iskeleti,
// başlatma kuralı ve `üret` aynıdır; fark yalnızca blok ayarıdır, bir kopya ikinci bakım yükü olurdu.
yapı GPT {
    ayar
    gömme
    bloklar
    son_norm
    çıkış
    ple_bağlamı
    kos
    sin
    fonksiyon kurucu(dağarcık, bağlam = 256, boyut = 256, katman = 4, bakış_sayısı = 4, kv_bakış_sayısı = yok, ara_boyut = yok, paylaşımlı = yanlış, tohum = 1, pencereler = yok, qk_normu = yanlış, birleşik_kv = yanlış, birleşik_kapı = yanlış, ileri_sapmalı = yanlış, epsilon = 0.00001, ple_boyutu = yok, bakış_boyutu = yok, rope_tabanı = 10000.0, ağırlık_türü = "float32") {
        kendi.ayar = {dağarcık: dağarcık, bağlam: bağlam, boyut: boyut, katman: katman, bakış_sayısı: bakış_sayısı, bakış_boyutu: bakış_boyutu,
            kv_bakış_sayısı: kv_bakış_sayısı, ara_boyut: ara_boyut, paylaşımlı: paylaşımlı, tohum: tohum,
            pencereler: pencereler, qk_normu: qk_normu, birleşik_kv: birleşik_kv, birleşik_kapı: birleşik_kapı,
            ileri_sapmalı: ileri_sapmalı, epsilon: epsilon, ple_boyutu: ple_boyutu, rope_tabanı: rope_tabanı, ağırlık_türü: ağırlık_türü}
        eğer pencereler != yok {
            doğrula(pencereler.uzunluk == katman, "pencereler ({pencereler.uzunluk} eleman) katman sayısına ({katman}) eşit olmalı")
        }
        değişken std = 0.02
        değişken çıkış_std = std / karekök(2 * katman)
        kendi.gömme = GömmeKatmanı(dağarcık, boyut, std: std, tohum: tohum, tür: ağırlık_türü)
        kendi.bloklar = []
        döngü i içinde 0..katman {
            kendi.bloklar.ekle(TransformerBloğu(boyut, bakış_sayısı, kv_bakış_sayısı: kv_bakış_sayısı, ara_boyut: ara_boyut,
                std: std, çıkış_std: çıkış_std, tohum: tohum + 100 * (i + 1), epsilon: epsilon,
                pencere: eğer pencereler == yok { 0 } değilse { pencereler[i] }, qk_normu: qk_normu,
                birleşik_kv: birleşik_kv, birleşik_kapı: birleşik_kapı, ileri_sapmalı: ileri_sapmalı,
                ple_boyutu: ple_boyutu, dağarcık: dağarcık, bakış_boyutu: bakış_boyutu, ağırlık_türü: ağırlık_türü))
        }
        kendi.son_norm = RMSNormKatmanı(boyut, epsilon: epsilon)
        kendi.çıkış = eğer paylaşımlı { yok } değilse { Doğrusal(boyut, dağarcık, std: std, tohum: tohum + 1, tür: ağırlık_türü) }
        kendi.ple_bağlamı = eğer ple_boyutu == yok { yok } değilse { PLEBağlamı(boyut, katman, ple_boyutu, epsilon: epsilon, std: std, tohum: tohum + 2, ağırlık_türü: ağırlık_türü) }
        değişken tablolar = döner_konum_tablosu(bağlam, eğer bakış_boyutu == yok { boyut / bakış_sayısı } değilse { bakış_boyutu }, taban: rope_tabanı)
        kendi.kos = tablolar[0]
        kendi.sin = tablolar[1]
    }
    // gömülü: kimlikleri gömer; [x, bağlamlar] verir (bağlamlar: katman başına PLE bağlamı ya da yok).
    fonksiyon gömülü(kimlikler) {
        değişken x = kendi.gömme.ileri(kimlikler)
        sonuç [x, eğer kendi.ple_bağlamı == yok { yok } değilse { kendi.ple_bağlamı.ileri(x) }]
    }
    // blokları_işle: x'i bloklardan sırayla geçirir (gizli_durum ve tek_adım ortak gövdesi).
    fonksiyon blokları_işle(x, bağlamlar, cos_tablosu, sin_tablosu, kimlikler, önbellek) {
        döngü i, blok içinde kendi.bloklar {
            x = blok.ileri(x, cos_tablosu, sin_tablosu, kimlikler, eğer bağlamlar == yok { yok } değilse { bağlamlar[i] }, önbellek: önbellek, no: i)
        }
        sonuç x
    }
    // gizli_durum: kimlikler [B, T] → son normdan geçmiş gizli durum [B, T, boyut]; karışık
    // hassasiyette hesap türünde (çıkış çarpımı için).
    // önbellek verilirse (KVÖnbellek) kimlikler önbellekteki konumdan devam eder: döner konum
    // tabloları o konumdan dilimlenir, anahtar ve değerler önbelleğe eklenir, konum ilerler.
    fonksiyon gizli_durum(kimlikler, önbellek = yok) {
        değişken gb = kendi.gömülü(kimlikler)
        değişken x = gb[0]
        değişken cos_tablosu = kendi.kos
        değişken sin_tablosu = kendi.sin
        değişken T = x.şekil[1]
        eğer önbellek != yok {
            değişken baş = önbellek.konum
            doğrula(baş + T <= kendi.ayar.bağlam, "önbellekli ileri: {baş + T} konum bağlamı ({kendi.ayar.bağlam}) aşıyor")
            cos_tablosu = cos_tablosu.dilim(0, baş, baş + T)
            sin_tablosu = sin_tablosu.dilim(0, baş, baş + T)
        }
        x = kendi.blokları_işle(x, gb[1], cos_tablosu, sin_tablosu, kimlikler, önbellek)
        eğer önbellek != yok { önbellek.ilerle(T) }
        // Gizli durumu yalnızca çıkış çarpımı (ya da doğrusal_çapraz_entropi) okur.
        sonuç kendi.son_norm.ileri(x, çıktı_türü: hesap_türü())
    }
    // tek_adım: bir parçalık üretim adımı, konum cihazdadır: kimlik [1, 1] ve konum [1]
    // tensörleri → son konumun logiti [dağarcık]. Konakta hiçbir şey değiştirmez (önbelleğin
    // konum sayacını çağıran ilerletir); bu yüzden tekrar_oynat ile kaydedilip oynatılabilir
    // (dil tanımı 15.45). Önbellek sabit olmalı ve ilk parçalar gizli_durum ile işlenmiş olmalı.
    fonksiyon tek_adım(kimlik, konum, önbellek) {
        değişken gb = kendi.gömülü(kimlik)
        değişken cos_tablosu = gömme(kendi.kos, konum)
        değişken sin_tablosu = gömme(kendi.sin, konum)
        önbellek.cihaz_adımı(konum)
        değişken x = kendi.blokları_işle(gb[0], gb[1], cos_tablosu, sin_tablosu, kimlik, önbellek)
        önbellek.cihaz_adımı(yok)
        sonuç kendi.logit(kendi.son_norm.ileri(x, çıktı_türü: hesap_türü()))[0][0]
    }
    // kimlikler [B, T] (T ≤ bağlam) → logit [B, T, dağarcık]; önbellek: gizli_durum.
    fonksiyon ileri(kimlikler, önbellek = yok) {
        sonuç kendi.logit(kendi.gizli_durum(kimlikler, önbellek: önbellek))
    }
    // logit: gizli durumu ([B, T, boyut]) sözlüğe çevirir (paylaşımlı gömmede tablonun devriği).
    fonksiyon logit(x) {
        eğer kendi.çıkış == yok { sonuç x @ kendi.gömme.tablo.devrik() }
        sonuç kendi.çıkış.ileri(x)
    }
    // kayıp: bir sonraki parçayı tahmin etmenin ortalama çapraz entropisi. Çıkış sapmasızsa
    // (paylaşımlı gömme ya da sapmasız Doğrusal) logitler bütün olarak tutulmaz:
    // doğrusal_çapraz_entropi aynı kaybı dilim dilim hesaplar (dil tanımı 15.25).
    fonksiyon kayıp(kimlikler, hedef) {
        eğer kendi.çıkış == yok {
            sonuç doğrusal_çapraz_entropi(kendi.gizli_durum(kimlikler), kendi.gömme.tablo.devrik(), hedef)
        }
        eğer kendi.çıkış.sapma == yok {
            sonuç doğrusal_çapraz_entropi(kendi.gizli_durum(kimlikler), kendi.çıkış.ağırlık, hedef)
        }
        sonuç çapraz_entropi(kendi.ileri(kimlikler), hedef)
    }
    // önbellek_kur: bu modelin katman sayısında bir KVÖnbellek ("sabit" ya da "büyüyen"); sabit
    // önbellek en_çok konum tutar (verilmezse bağlam).
    fonksiyon önbellek_kur(çeşit = "sabit", en_çok = yok) {
        sonuç KVÖnbellek(kendi.bloklar.uzunluk, çeşit: çeşit, en_çok: eğer en_çok == yok { kendi.ayar.bağlam } değilse { en_çok })
    }
    // üret: başlangıç kimliklerinin (liste) ardına adet kadar parça örnekler ve bütün listeyi
    // verir. sıcaklık 0 en olasıyı seçer; tohum verilirse sonuç tekrarlanır. eos verilirse (bir
    // parça kimliği) o parça örneklenince eklenir ve üretim durur (adetten önce). Model
    // bağlamdan uzun diziyi görmez: son `bağlam` parça kullanılır. önbellek_çeşidi: "sabit"
    // (varsayılan) ya da "büyüyen" KV önbelleği; ilk adım başlangıcı bir kez işler, sonraki
    // adımlar yalnızca yeni parçayı. Dizi bağlamı doldurunca son `bağlam` parça yeniden işlenir
    // (konumlar kaydığı için önbellek baştan kurulur). önbellek_çeşidi: yok her parçada bütün diziyi
    // yeniden hesaplar. Sonuç önbellekli ve önbelleksiz aynıdır (float32 yuvarlama düzeyinde).
    // Yalnızca son konumun logiti hesaplanır (transformers generate'in logits_to_keep'i gibi).
    // çizge: doğru (varsayılan) ise GPU'da sabit önbellekle her adım tek_adım'dır ve
    // tekrar_oynat ile kaydedilip oynatılır (kernel başlatmalarının konak yükü kalkar); sonuç
    // kayıtsızla aynı parçalardır. Sabit önbellek en çok başlangıç + adet konum tutar.
    fonksiyon üret(başlangıç, adet, sıcaklık = 1.0, en_iyi_k = 0, tohum = yok, eos = yok, önbellek_çeşidi = "sabit", çizge = doğru) {
        değişken kimlikler = [k döngü k içinde başlangıç]
        değişken bağlam = kendi.ayar.bağlam
        değişken ö = yok
        değişken adım = yok
        değişken cihaz = kendi.gömme.tablo.cihaz
        değişken oynat = çizge ve önbellek_çeşidi == "sabit" ve cihaz != "cpu"
        türevsiz {
            döngü i içinde 0..adet {
                değişken x = yok
                değişken son = yok
                eğer önbellek_çeşidi == yok {
                    değişken bas = max(0, kimlikler.uzunluk - bağlam)
                    x = kendi.gizli_durum([kimlikler[bas..kimlikler.uzunluk]])
                } değilse eğer ö == yok veya ö.konum >= ö.en_çok {
                    // İlk adım ya da önbellek doldu: son `bağlam` parça baştan işlenir.
                    ö = kendi.önbellek_kur(çeşit: önbellek_çeşidi, en_çok: min(bağlam, kimlikler.uzunluk + adet - i))
                    adım = yok // yeni önbellek: yeni kayıt
                    değişken bas = max(0, kimlikler.uzunluk - bağlam)
                    x = kendi.gizli_durum([kimlikler[bas..kimlikler.uzunluk]], önbellek: ö)
                } değilse eğer oynat {
                    eğer adım == yok {
                        değişken öö = ö
                        adım = tekrar_oynat((kimlik, konum) => kendi.tek_adım(kimlik, konum, öö))
                    }
                    son = adım(tensör([[kimlikler[-1] * 1.0]]).cihaza(cihaz), tensör([ö.konum * 1.0]).cihaza(cihaz))
                    ö.ilerle(1)
                } değilse {
                    x = kendi.gizli_durum([[kimlikler[-1]]], önbellek: ö)
                }
                eğer son == yok {
                    değişken T = x.şekil[1]
                    son = kendi.logit(x.dilim(1, T - 1, T))[0][0]
                }
                değişken t = eğer tohum == yok { yok } değilse { tohum + i }
                değişken yeni = örnekle(son, sıcaklık: sıcaklık, en_iyi_k: en_iyi_k, tohum: t).değer
                kimlikler.ekle(yeni)
                eğer eos != yok ve yeni == eos { çık }
            }
        }
        sonuç kimlikler
    }
}
