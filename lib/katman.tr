// tr/katman — transformer katmanları ve yalnızca kod çözücülü GPT.
//
// Kullanım:   aktar "tr/katman"                (adlar doğrudan gelir: GPT, Doğrusal, ...)
//             aktar "tr/katman" olarak k       (k.GPT(...), k.Doğrusal(...))
// Her katman sıradan bir yapıdır: ağırlıklar alanlarındadır, ileri hesap `ileri` metodudur,
// `parametreler(model)` bütün ağırlıkları bulur. Bu dosyayı kopyalayıp değiştirebilirsiniz.
//
// Şekiller: girdiler [toplu, uzunluk, boyut] (kısaca [B, T, D]); çarpım `x @ W` biçimindedir,
// bu yüzden Doğrusal'ın ağırlığı [giriş, çıkış] şeklindedir.
// Başlatma: bütün ağırlık matrisleri N(0, 0.02) ile başlar (`std`); artık yola yazan çıkış
// katmanları (dikkatin `çıkış_katmanı`, ileri beslemenin `aşağı`sı) 0.02 / √(2 · katman sayısı) ile
// küçültülür, böylece derin modelde artık yolun varyansı katman sayısıyla büyümez. Norm
// ağırlıkları 1, sapmalar 0 ile başlar. Her ağırlığın kendi sabit tohumu vardır: aynı `tohum`
// aynı modeli verir.

// ağırlık_başlat şekli verilen, N(0, std) ile başlayan, türev izleyen bir ağırlık kurar.
fonksiyon ağırlık_başlat(şekil, std, tohum) {
    sonuç tensör(türevsiz(rastgele_normal(şekil, tohum: tohum) * std), türev_izle: doğru)
}

// Doğrusal: y = x @ ağırlık (+ sapma). ağırlık [giriş, çıkış], sapma [çıkış] ya da yok.
// Sapma çarpımın türünde eklenir: karışık_hassasiyet("bf16") bloğunda çıktı bf16 kalır (float32
// sapma toplamı float32'ye yükseltmez). PyTorch'un autocast'i (F.linear sapmayı da bf16 işler) ve
// Flax'ın Dense'i (dtype sapmayı da kapsar) böyledir; sapmanın gradyanı float32 birikir (15.12).
// Hedef modelde float32 ara sonuçları ve geri dönüşümleri kaldırır (221 → 203 ms/adım).
yapı Doğrusal {
    ağırlık
    sapma
    fonksiyon kurucu(giriş, çıkış, sapmalı = yanlış, std = 0.02, tohum = 1) {
        kendi.ağırlık = ağırlık_başlat([giriş, çıkış], std, tohum)
        kendi.sapma = eğer sapmalı { tensör(sıfırlar([çıkış]), türev_izle: doğru) } değilse { yok }
    }
    fonksiyon ileri(x) {
        eğer kendi.sapma == yok { sonuç x @ kendi.ağırlık }
        değişken y = x @ kendi.ağırlık
        sonuç y + kendi.sapma.türe(y.tür)
    }
}

// GömmeKatmanı: parça kimliklerini [dağarcık, boyut] tablosunun satırlarına çevirir
// (`gömme` yerleşiğiyle): [B, T] → [B, T, boyut].
yapı GömmeKatmanı {
    tablo
    fonksiyon kurucu(dağarcık, boyut, std = 0.02, tohum = 1) {
        kendi.tablo = ağırlık_başlat([dağarcık, boyut], std, tohum)
    }
    fonksiyon ileri(kimlikler) { sonuç gömme(kendi.tablo, kimlikler) }
}

// RMSNormKatmanı: son eksende karelerin ortalamasının köküne böler, öğrenilen ağırlıkla
// çarpar (`rms_normu` yerleşiği). Ağırlık 1 ile başlar. Hesap float32'dir; çıktı girdinin
// türündedir, çıktı_türü verilirse o türde yazılır. Çıktısını yalnızca çarpımlar okuyorsa
// çağıran çıktı_türü: hesap_türü() verir: karışık hassasiyette normun float32 çıktısı ve onu
// çarpım için bf16'ya çeviren ayrı dönüşüm kalkar (PyTorch'ta torch.compile normu dönüşümle
// kaynaştırır; Flax'ta RMSNorm(dtype=...)). Hedef modelde 167 → 163 ms/adım, kayıplar aynı.
yapı RMSNormKatmanı {
    ağırlık
    epsilon = 0.00001
    fonksiyon kurucu(boyut, epsilon = 0.00001) {
        kendi.ağırlık = tensör(birler([boyut]), türev_izle: doğru)
        kendi.epsilon = epsilon
    }
    fonksiyon ileri(x, çıktı_türü = yok) {
        eğer çıktı_türü == yok { sonuç rms_normu(x, kendi.ağırlık, epsilon: kendi.epsilon) }
        sonuç rms_normu(x, kendi.ağırlık, epsilon: kendi.epsilon, tür: çıktı_türü)
    }
}

// Döner konum gömmesi (RoPE): baş vektörünün iki yarısı (a, b) her konumda konuma bağlı bir
// açıyla döndürülür; sorgu ile anahtarın iç çarpımı böylece yalnızca aradaki uzaklığa bağlı
// olur. döner_konum_tablosu [kosinüs, sinüs] verir, ikisi de [bağlam, baş_boyutu / 2].
// Frekanslar taban^(-2i / baş_boyutu). Tablolar türev izlemez (öğrenilmez).
fonksiyon döner_konum_tablosu(bağlam, baş_boyutu, taban = 10000.0) {
    değişken yarım = baş_boyutu / 2
    değişken frekanslar = [taban ** (-2.0 * i / baş_boyutu) döngü i içinde 0..yarım]
    değişken konumlar = tensör([[t] döngü t içinde 0..bağlam]) // [bağlam, 1]
    değişken açılar = konumlar @ tensör([frekanslar]) // [bağlam, yarım]
    sonuç [kosinüs(açılar), sinüs(açılar)]
}

// döner_konum_hesapla x'i ([..., T, baş_boyutu]) tablonun ilk T satırıyla döndürür; sonuç
// x'in türündedir. Tablolar float32'dir: karışık hassasiyette bf16 x ile çarpım float32'ye
// yükselir, sonucu okuyan `dikkat` onu yine bf16'ya çevirirdi. Dönüşüm burada, kaynaşık
// geçişin sonunda yapılır: değer aynıdır (bir kez yuvarlanır), float32 sonuç ve ayrı dönüşüm
// kalkar. döner_konum_uygula aynı hesabın kaynaşmış biçimidir (kaynaştır, dil tanımı 15.45):
// zincir tek geçişte hesaplanır, ara sonuçlar belleğe yazılmaz; sonuç aynıdır.
fonksiyon döner_konum_hesapla(x, kos, sin) {
    değişken T = x.şekil[-2]
    değişken a, b = x.böl(2, eksen: -1)
    değişken c = kos[0..T]
    değişken s = sin[0..T]
    sonuç birleştir([a * c - b * s, a * s + b * c], eksen: -1).türe(x.tür)
}
değişken döner_konum_uygula = kaynaştır(döner_konum_hesapla)

// NedenselDikkat: döner konumlu, nedensel çok başlı dikkat. Her konum yalnızca kendisine ve
// öncekilere bakar. kv_baş < baş gruplu sorgu dikkatidir (GQA): anahtar ve değer başları
// ardışık baş gruplarınca paylaşılır, anahtar/değer katmanları küçülür. Hesap birleşik
// `dikkat` yerleşiğindedir (T×T puan matrisi tutulmaz).
// Seçenekler (varsayılanlar eski davranıştır):
//   pencere: w > 0 ise yerel dikkat; her konum yalnızca son w konuma (kendisi dahil) bakar
//            (`dikkat(..., pencere: w)`); 0 tam nedensel. Pencere katmanın özelliğidir:
//            yerel/genel katman düzeni, her bloğa kendi penceresi verilerek kurulur.
//   qk_normu: q ve k'ya baş boyutunda RMS normu (q_norm, k_norm; döner konumdan ÖNCE).
//   birleşik_kv: anahtar ve değer tek `kv_katmanı` ([boyut, 2·kv_boyut], [K | V]) olur ve
//            `.böl(2)` ile ayrılır; Muon K ve V'yi birlikte dikleştirir. Aksi hâlde
//            anahtar_katmanı ve değer_katmanı ayrıdır (kv_katmanı yok'tur; birleşikte tersi).
//   epsilon: qk normlarının epsilon'u.
//   baş_boyutu: bir başın boyutu; yok ise boyut / baş. Verilirse gizli boyuttan bağımsızdır
//            (Hugging Face `head_dim`; Qwen3-0.6B: gizli 1024, 16 baş × 128): sorgu katmanı
//            [boyut, baş · baş_boyutu], çıkış katmanı [baş · baş_boyutu, boyut] olur. Döner konum
//            başı iki yarıya böldüğünden çift olmalıdır.
yapı NedenselDikkat {
    baş
    kv_baş
    baş_boyutu
    pencere
    sorgu_katmanı
    anahtar_katmanı
    değer_katmanı
    kv_katmanı
    q_norm
    k_norm
    çıkış_katmanı
    fonksiyon kurucu(boyut, baş, kv_baş = yok, sapmalı = yanlış, std = 0.02, çıkış_std = 0.02, tohum = 1, pencere = 0, qk_normu = yanlış, birleşik_kv = yanlış, epsilon = 0.00001, baş_boyutu = yok) {
        eğer kv_baş == yok { kv_baş = baş }
        eğer baş_boyutu == yok {
            doğrula(boyut % baş == 0, "boyut ({boyut}) baş sayısına ({baş}) bölünmeli")
            baş_boyutu = boyut / baş
        }
        doğrula(baş_boyutu > 0 ve baş_boyutu % 2 == 0, "baş_boyutu ({baş_boyutu}) pozitif ve çift olmalı (döner konum başı iki yarıya böler)")
        doğrula(baş % kv_baş == 0, "baş sayısı ({baş}) kv_baş sayısına ({kv_baş}) bölünmeli")
        doğrula(pencere >= 0, "pencere negatif olamaz, {pencere} verildi")
        kendi.baş = baş
        kendi.kv_baş = kv_baş
        kendi.baş_boyutu = baş_boyutu
        kendi.pencere = pencere
        değişken kv_boyut = kv_baş * baş_boyutu
        kendi.sorgu_katmanı = Doğrusal(boyut, baş * baş_boyutu, sapmalı: sapmalı, std: std, tohum: tohum)
        eğer birleşik_kv {
            kendi.anahtar_katmanı = yok
            kendi.değer_katmanı = yok
            kendi.kv_katmanı = Doğrusal(boyut, 2 * kv_boyut, sapmalı: sapmalı, std: std, tohum: tohum + 1)
        } değilse {
            kendi.anahtar_katmanı = Doğrusal(boyut, kv_boyut, sapmalı: sapmalı, std: std, tohum: tohum + 1)
            kendi.değer_katmanı = Doğrusal(boyut, kv_boyut, sapmalı: sapmalı, std: std, tohum: tohum + 2)
            kendi.kv_katmanı = yok
        }
        kendi.q_norm = eğer qk_normu { RMSNormKatmanı(kendi.baş_boyutu, epsilon: epsilon) } değilse { yok }
        kendi.k_norm = eğer qk_normu { RMSNormKatmanı(kendi.baş_boyutu, epsilon: epsilon) } değilse { yok }
        kendi.çıkış_katmanı = Doğrusal(baş * baş_boyutu, boyut, sapmalı: sapmalı, std: çıkış_std, tohum: tohum + 3)
    }
    // x [B, T, D]; kos/sin döner_konum_tablosu'ndan.
    fonksiyon ileri(x, kos, sin) {
        değişken B = x.şekil[0]
        değişken T = x.şekil[1]
        değişken k_ham = yok
        değişken v_ham = yok
        eğer kendi.kv_katmanı != yok {
            değişken kv = kendi.kv_katmanı.ileri(x).böl(2, eksen: -1) // [K | V]
            k_ham = kv[0]
            v_ham = kv[1]
        } değilse {
            k_ham = kendi.anahtar_katmanı.ileri(x)
            v_ham = kendi.değer_katmanı.ileri(x)
        }
        // [B, T, baş · baş_boyutu] → [B, baş, T, baş_boyutu]
        değişken q = kendi.sorgu_katmanı.ileri(x).şekillendir([B, T, kendi.baş, kendi.baş_boyutu]).eksenleri_sırala([0, 2, 1, 3])
        değişken k = k_ham.şekillendir([B, T, kendi.kv_baş, kendi.baş_boyutu]).eksenleri_sırala([0, 2, 1, 3])
        değişken v = v_ham.şekillendir([B, T, kendi.kv_baş, kendi.baş_boyutu]).eksenleri_sırala([0, 2, 1, 3])
        eğer kendi.q_norm != yok {
            q = kendi.q_norm.ileri(q)
            k = kendi.k_norm.ileri(k)
        }
        q = döner_konum_uygula(q, kos, sin)
        k = döner_konum_uygula(k, kos, sin)
        değişken y = dikkat(q, k, v, nedensel: doğru, pencere: kendi.pencere) // [B, baş, T, baş_boyutu]
        sonuç kendi.çıkış_katmanı.ileri(y.eksenleri_sırala([0, 2, 1, 3]).şekillendir([B, T, kendi.baş * kendi.baş_boyutu]))
    }
}

// swiglu_ara_boyutu: SwiGLU'nun ara boyutu için yaygın seçim, 8/3 · boyut, 32'nin katına
// yukarı yuvarlanır (üç matrisli ileri besleme, 4 · boyut'luk iki matrisliyle aynı büyüklükte).
fonksiyon swiglu_ara_boyutu(boyut) {
    sonuç tam(tavan(8.0 * boyut / 3.0 / 32.0)) * 32
}

// swiglu_kapısı: SwiGLU'nun kapısı silu(g) · u; birleşik [G | U] çıktısında g ve u yarılardır.
// İkisi de kaynaşmıştır (tek geçiş).
fonksiyon swiglu_kapısı(g, u) { sonuç silu(g) * u }
fonksiyon swiglu_birleşik_kapısı(gu) {
    değişken g, u = gu.böl(2, eksen: -1)
    sonuç silu(g) * u
}
değişken swiglu_kapı = kaynaştır(swiglu_kapısı)
değişken swiglu_birleşik_kapı = kaynaştır(swiglu_birleşik_kapısı)

// SwiGLU: kapılı ileri besleme. aşağı(silu(kapı(x)) * yukarı(x)).
// birleşik: doğru ise kapı ve yukarı tek `kapı_yukarı` katmanıdır ([boyut, 2·ara], [G | U]) ve
// `.böl(2)` ile ayrılır (Muon ikisini birlikte dikleştirir); kapı ve yukarı o zaman yok'tur.
// sapmalı: bütün katmanların sapması (birleşikte kapı_yukarı'nın sapması [2·ara]).
yapı SwiGLU {
    kapı
    yukarı
    kapı_yukarı
    aşağı
    fonksiyon kurucu(boyut, ara_boyut = yok, sapmalı = yanlış, std = 0.02, çıkış_std = 0.02, tohum = 1, birleşik = yanlış) {
        eğer ara_boyut == yok { ara_boyut = swiglu_ara_boyutu(boyut) }
        eğer birleşik {
            kendi.kapı = yok
            kendi.yukarı = yok
            kendi.kapı_yukarı = Doğrusal(boyut, 2 * ara_boyut, sapmalı: sapmalı, std: std, tohum: tohum)
        } değilse {
            kendi.kapı = Doğrusal(boyut, ara_boyut, sapmalı: sapmalı, std: std, tohum: tohum)
            kendi.yukarı = Doğrusal(boyut, ara_boyut, sapmalı: sapmalı, std: std, tohum: tohum + 1)
            kendi.kapı_yukarı = yok
        }
        kendi.aşağı = Doğrusal(ara_boyut, boyut, sapmalı: sapmalı, std: çıkış_std, tohum: tohum + 2)
    }
    fonksiyon ileri(x) {
        eğer kendi.kapı_yukarı != yok {
            sonuç kendi.aşağı.ileri(swiglu_birleşik_kapı(kendi.kapı_yukarı.ileri(x)))
        }
        sonuç kendi.aşağı.ileri(swiglu_kapı(kendi.kapı.ileri(x), kendi.yukarı.ileri(x)))
    }
}

// ple_gelu PLE'nin etkinleştirmesidir: tam (erf tabanlı) GELU, hedef modelin F.gelu'su gibi.
fonksiyon ple_gelu(x) { sonuç gelu(x, yaklaşık: yanlış) }

// ple_karışımı PLE bloğunun eleman bazlı zinciridir: GELU(kapı) ⊙ (bağlam + ölçek · satır) / √2
// (ölçek = √P); ple_karış onun kaynaşmış biçimidir. Sonuç kapının türündedir (karışık
// hassasiyette bf16): float32 tablo satırı zinciri float32'ye yükseltir, sonucu yalnızca
// izdüşüm çarpımı okur; dönüşüm kaynaşık geçişin sonunda yapılır (bkz. döner_konum_hesapla).
fonksiyon ple_karışımı(kapı, bağlam, satır, ölçek) {
    sonuç (ple_gelu(kapı) * ((bağlam + ölçek * satır) / karekök(2.0))).türe(kapı.tür)
}
değişken ple_karış = kaynaştır(ple_karışımı)

// PLEBağlamı: katman başına kelime gömmesinin (PLE, Gemma 3n) modele ortak bağlam yarısı.
// Gömme çıktısı x [B, T, D] tek matrisle [B, T, katman · P]'ye çevrilir, √D'ye bölünür,
// katman başına P'lik parçalara bölünür ve her parça ortak bir RMS normundan geçer:
//   bağlam_i = RMSNorm_P((x @ W_ctx) / √D)_i
// `ileri(x)` katman sayısı kadar [B, T, P] tensörlük bir liste verir; i. eleman i. bloğun
// PLEBloğu.ileri'sine girer.
yapı PLEBağlamı {
    boyut
    katman
    ple_boyutu
    ctx_katmanı
    norm
    fonksiyon kurucu(boyut, katman, ple_boyutu, epsilon = 0.00001, std = 0.02, tohum = 1) {
        kendi.boyut = boyut
        kendi.katman = katman
        kendi.ple_boyutu = ple_boyutu
        kendi.ctx_katmanı = Doğrusal(boyut, katman * ple_boyutu, std: std, tohum: tohum)
        kendi.norm = RMSNormKatmanı(ple_boyutu, epsilon: epsilon)
    }
    fonksiyon ileri(x) {
        değişken h = kendi.ctx_katmanı.ileri(x) / karekök(kendi.boyut)
        sonuç [kendi.norm.ileri(parça) döngü parça içinde h.böl(kendi.katman, eksen: -1)]
    }
}

// PLEBloğu: bir katmanın PLE yarısı (blok sonunda çalışır). Katmanın kendi tablosu
// ([dağarcık, P], N(0, std)) kelime kimliğiyle okunur ve ortak bağlamla karışır:
//   e = (bağlam_i + √P · tablo_i[kelime]) / √2
//   H ← H + RMSNorm_D(W_p · (GELU(W_g · H) ⊙ e))
// W_g (kapı) [D, P], W_p (izdüşüm) [P, D]; izdüşüm artık yola yazar, çıkış_std ile başlar.
yapı PLEBloğu {
    ple_boyutu
    tablo
    kapı
    izdüşüm
    norm
    fonksiyon kurucu(boyut, dağarcık, ple_boyutu, epsilon = 0.00001, std = 0.02, çıkış_std = 0.02, tohum = 1) {
        kendi.ple_boyutu = ple_boyutu
        kendi.tablo = ağırlık_başlat([dağarcık, ple_boyutu], std, tohum)
        kendi.kapı = Doğrusal(boyut, ple_boyutu, std: std, tohum: tohum + 1)
        kendi.izdüşüm = Doğrusal(ple_boyutu, boyut, std: çıkış_std, tohum: tohum + 2)
        kendi.norm = RMSNormKatmanı(boyut, epsilon: epsilon)
    }
    // h [B, T, D]; kimlikler [B, T]; bağlam bu katmanın PLEBağlamı çıktısı [B, T, P].
    fonksiyon ileri(h, kimlikler, bağlam) {
        değişken karışım = ple_karış(kendi.kapı.ileri(h), bağlam, gömme(kendi.tablo, kimlikler), karekök(kendi.ple_boyutu))
        sonuç h + kendi.norm.ileri(kendi.izdüşüm.ileri(karışım))
    }
}

// TransformerBloğu (ön-norm): x + dikkat(norm(x)), ardından x + ileri_besleme(norm(x)); ple_boyutu
// verilirse blok sonunda PLEBloğu'nun katkısı eklenir.
// Seçenekler (varsayılanlar eski davranıştır):
//   epsilon: blok içindeki bütün RMS normlarının (norm1, norm2, qk normları, PLE normu) epsilon'u.
//   pencere, qk_normu, birleşik_kv: NedenselDikkat'e iletilir (katman başına farklı pencere).
//   sapmalı: dikkat katmanlarının sapması; ileri_sapmalı: SwiGLU'nun sapması.
//   birleşik_kapı: SwiGLU'da [G | U] tek matris.
//   ple_boyutu (P) ve dağarcık: PLE için ikisi de verilmeli; yoksa blokta PLE yoktur (ple = yok).
// ileri(x, kos, sin, kimlikler, bağlam): kimlikler ve bağlam yalnızca PLE varken kullanılır.
yapı TransformerBloğu {
    norm1
    dikkat
    norm2
    ileri_besleme
    ple
    fonksiyon kurucu(boyut, baş, kv_baş = yok, ara_boyut = yok, std = 0.02, çıkış_std = 0.02, tohum = 1, epsilon = 0.00001, pencere = 0, qk_normu = yanlış, birleşik_kv = yanlış, sapmalı = yanlış, ileri_sapmalı = yanlış, birleşik_kapı = yanlış, ple_boyutu = yok, dağarcık = yok, baş_boyutu = yok) {
        kendi.norm1 = RMSNormKatmanı(boyut, epsilon: epsilon)
        kendi.dikkat = NedenselDikkat(boyut, baş, kv_baş: kv_baş, sapmalı: sapmalı, std: std, çıkış_std: çıkış_std, tohum: tohum, pencere: pencere, qk_normu: qk_normu, birleşik_kv: birleşik_kv, epsilon: epsilon, baş_boyutu: baş_boyutu)
        kendi.norm2 = RMSNormKatmanı(boyut, epsilon: epsilon)
        kendi.ileri_besleme = SwiGLU(boyut, ara_boyut: ara_boyut, sapmalı: ileri_sapmalı, std: std, çıkış_std: çıkış_std, tohum: tohum + 10, birleşik: birleşik_kapı)
        eğer ple_boyutu != yok {
            doğrula(dağarcık != yok, "TransformerBloğu: ple_boyutu için dağarcık da verilmeli")
            kendi.ple = PLEBloğu(boyut, dağarcık, ple_boyutu, epsilon: epsilon, std: std, çıkış_std: çıkış_std, tohum: tohum + 20)
        } değilse {
            kendi.ple = yok
        }
    }
    fonksiyon ileri(x, kos, sin, kimlikler = yok, bağlam = yok) {
        // Norm çıktılarını yalnızca dikkatin ve ileri beslemenin ilk çarpımları okur.
        değişken h = x + kendi.dikkat.ileri(kendi.norm1.ileri(x, çıktı_türü: hesap_türü()), kos, sin)
        h = h + kendi.ileri_besleme.ileri(kendi.norm2.ileri(h, çıktı_türü: hesap_türü()))
        eğer kendi.ple != yok { sonuç kendi.ple.ileri(h, kimlikler, bağlam) }
        sonuç h
    }
}

// katman_pencereleri "YYGYGYYG" gibi bir düzen metninden katman başına pencere listesi kurar:
// G (genel) katman 0 (tam nedensel); Y (yerel) katmanlar `pencereler`i sırayla (döngüyle) alır.
// katman_pencereleri("YYGYGYYG", [32, 64]) → [32, 64, 0, 32, 0, 64, 32, 0]
fonksiyon katman_pencereleri(düzen, pencereler) {
    değişken liste = []
    değişken y = 0
    döngü harf içinde düzen {
        doğrula(harf == "Y" veya harf == "G", "katman düzeni yalnızca Y ve G içerir, {harf} bulundu")
        eğer harf == "G" {
            liste.ekle(0)
        } değilse {
            liste.ekle(pencereler[y % pencereler.uzunluk])
            y += 1
        }
    }
    sonuç liste
}

// GPT: yalnızca kod çözücülü dil modeli. gömme → katman sayısı kadar blok → son norm →
// dağarcık üzerinde logit. paylaşımlı: doğru ise çıkış katmanı gömme tablosunu kullanır
// (logit = h @ tablo.devrik(); ayrı çıkış ağırlığı yoktur).
// Ayarlar: dağarcık (parça sayısı), bağlam (en uzun dizi), boyut, katman, baş, kv_baş (yok:
// baş ile aynı), ara_boyut (yok: swiglu_ara_boyutu), paylaşımlı, tohum.
// Blok seçenekleri (varsayılanlar eski modeli verir; ayrıntı TransformerBloğu'nda):
//   pencereler: katman başına pencere listesi (uzunluğu katman; 0 = genel, yok = hepsi genel);
//               yerel/genel düzen katman_pencereleri("YYGYGYYG", [32, 64]) ile kurulur.
//   qk_normu, birleşik_kv, birleşik_kapı, ileri_sapmalı, epsilon, baş_boyutu: her bloğa iletilir
//               (baş_boyutu döner konum tablolarının da boyudur; yok ise boyut / baş).
//   ple_boyutu: verilirse her blokta PLE vardır; modelde ortak PLEBağlamı (`ple_bağlamı`) gömme
//               çıktısından katman başına bağlamı üretir ve i. bloğa i. parçayı verir.
// RGN-512 gibi bir model bu yapıyla tek çağrıdır:
//   GPT(40000, bağlam: 1024, boyut: 512, katman: 8, baş: 8, kv_baş: 4, ara_boyut: 672, paylaşımlı: doğru,
//       pencereler: katman_pencereleri("YYGYGYYG", [32, 64]), qk_normu: doğru, birleşik_kv: doğru,
//       birleşik_kapı: doğru, ileri_sapmalı: doğru, epsilon: 0.000001, ple_boyutu: 512)
// Neden GPT'ye seçenek, ayrı bir model yapısı değil: gömme → bloklar → norm → logit iskeleti,
// başlatma kuralı ve `üret` aynıdır; fark yalnızca blok ayarıdır, bir kopya ikinci bakım yükü olurdu.
yapı GPT {
    ayar
    gömme
    bloklar
    son_norm
    çıkış
    ple_bağlamı
    kos
    sin
    fonksiyon kurucu(dağarcık, bağlam = 256, boyut = 256, katman = 4, baş = 4, kv_baş = yok, ara_boyut = yok, paylaşımlı = yanlış, tohum = 1, pencereler = yok, qk_normu = yanlış, birleşik_kv = yanlış, birleşik_kapı = yanlış, ileri_sapmalı = yanlış, epsilon = 0.00001, ple_boyutu = yok, baş_boyutu = yok) {
        kendi.ayar = {dağarcık: dağarcık, bağlam: bağlam, boyut: boyut, katman: katman, baş: baş, baş_boyutu: baş_boyutu,
            kv_baş: kv_baş, ara_boyut: ara_boyut, paylaşımlı: paylaşımlı, tohum: tohum,
            pencereler: pencereler, qk_normu: qk_normu, birleşik_kv: birleşik_kv, birleşik_kapı: birleşik_kapı,
            ileri_sapmalı: ileri_sapmalı, epsilon: epsilon, ple_boyutu: ple_boyutu}
        eğer pencereler != yok {
            doğrula(pencereler.uzunluk == katman, "pencereler ({pencereler.uzunluk} eleman) katman sayısına ({katman}) eşit olmalı")
        }
        değişken std = 0.02
        değişken çıkış_std = std / karekök(2 * katman)
        kendi.gömme = GömmeKatmanı(dağarcık, boyut, std: std, tohum: tohum)
        kendi.bloklar = []
        döngü i içinde 0..katman {
            kendi.bloklar.ekle(TransformerBloğu(boyut, baş, kv_baş: kv_baş, ara_boyut: ara_boyut,
                std: std, çıkış_std: çıkış_std, tohum: tohum + 100 * (i + 1), epsilon: epsilon,
                pencere: eğer pencereler == yok { 0 } değilse { pencereler[i] }, qk_normu: qk_normu,
                birleşik_kv: birleşik_kv, birleşik_kapı: birleşik_kapı, ileri_sapmalı: ileri_sapmalı,
                ple_boyutu: ple_boyutu, dağarcık: dağarcık, baş_boyutu: baş_boyutu))
        }
        kendi.son_norm = RMSNormKatmanı(boyut, epsilon: epsilon)
        kendi.çıkış = eğer paylaşımlı { yok } değilse { Doğrusal(boyut, dağarcık, std: std, tohum: tohum + 1) }
        kendi.ple_bağlamı = eğer ple_boyutu == yok { yok } değilse { PLEBağlamı(boyut, katman, ple_boyutu, epsilon: epsilon, std: std, tohum: tohum + 2) }
        değişken tablolar = döner_konum_tablosu(bağlam, eğer baş_boyutu == yok { boyut / baş } değilse { baş_boyutu })
        kendi.kos = tablolar[0]
        kendi.sin = tablolar[1]
    }
    // gizli_durum: kimlikler [B, T] → son normdan geçmiş gizli durum [B, T, boyut]; karışık
    // hassasiyette hesap türünde (çıkış çarpımı için).
    fonksiyon gizli_durum(kimlikler) {
        değişken x = kendi.gömme.ileri(kimlikler)
        değişken bağlamlar = eğer kendi.ple_bağlamı == yok { yok } değilse { kendi.ple_bağlamı.ileri(x) }
        döngü i, blok içinde kendi.bloklar {
            x = blok.ileri(x, kendi.kos, kendi.sin, kimlikler, eğer bağlamlar == yok { yok } değilse { bağlamlar[i] })
        }
        // Gizli durumu yalnızca çıkış çarpımı (ya da doğrusal_çapraz_entropi) okur.
        sonuç kendi.son_norm.ileri(x, çıktı_türü: hesap_türü())
    }
    // kimlikler [B, T] (T ≤ bağlam) → logit [B, T, dağarcık]
    fonksiyon ileri(kimlikler) {
        değişken x = kendi.gizli_durum(kimlikler)
        eğer kendi.çıkış == yok { sonuç x @ kendi.gömme.tablo.devrik() }
        sonuç kendi.çıkış.ileri(x)
    }
    // kayıp: bir sonraki parçayı tahmin etmenin ortalama çapraz entropisi. Çıkış sapmasızsa
    // (paylaşımlı gömme ya da sapmasız Doğrusal) logitler bütün olarak tutulmaz:
    // doğrusal_çapraz_entropi aynı kaybı dilim dilim hesaplar (dil tanımı 15.43).
    fonksiyon kayıp(girdi, hedef) {
        eğer kendi.çıkış == yok {
            sonuç doğrusal_çapraz_entropi(kendi.gizli_durum(girdi), kendi.gömme.tablo.devrik(), hedef)
        }
        eğer kendi.çıkış.sapma == yok {
            sonuç doğrusal_çapraz_entropi(kendi.gizli_durum(girdi), kendi.çıkış.ağırlık, hedef)
        }
        sonuç çapraz_entropi(kendi.ileri(girdi), hedef)
    }
    // üret: başlangıç kimliklerinin (liste) ardına adet kadar parça örnekler ve bütün listeyi
    // verir. sıcaklık 0 en olasıyı seçer; tohum verilirse sonuç tekrarlanır. eos verilirse (bir
    // parça kimliği) o parça örneklenince eklenir ve üretim durur (adetten önce). Model
    // bağlamdan uzun diziyi görmez: son `bağlam` parça kullanılır. (Önbelleksizdir: her parçada
    // bütün diziyi yeniden hesaplar; örnek üretmek içindir.)
    fonksiyon üret(başlangıç, adet, sıcaklık = 1.0, en_iyi_k = 0, tohum = yok, eos = yok) {
        değişken kimlikler = [k döngü k içinde başlangıç]
        türevsiz {
            döngü i içinde 0..adet {
                değişken bas = maks(0, kimlikler.uzunluk - kendi.ayar.bağlam)
                değişken logit = kendi.ileri([kimlikler[bas..kimlikler.uzunluk]])
                değişken son = logit[0][-1]
                değişken t = eğer tohum == yok { yok } değilse { tohum + i }
                değişken yeni = örnekle(son, sıcaklık: sıcaklık, en_iyi_k: en_iyi_k, tohum: t).değer
                kimlikler.ekle(yeni)
                eğer eos != yok ve yeni == eos { çık }
            }
        }
        sonuç kimlikler
    }
}
