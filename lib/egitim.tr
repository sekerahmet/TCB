// tr/egitim — uzun eğitimin güvencesi: koşu düzeni (Koşu) ve kayıp ile gradyan normu sıçrama
// bekçisi (SıçramaBekçisi).
//
// Kullanım:   aktar "tr/egitim"
//             değişken bekçi = SıçramaBekçisi(pencere: 128, eşik: 6.0)
//             değişken karar = bekçi.gözle(kayıp.değer, norm.değer)   // TAMAM, SONLU_DEĞİL ya da SIÇRAMA
//
// Bekçi yalnızca karar verir; ne yapılacağını (adımı atlamak, son kontrol noktasına dönüp toplu
// işleri atlamak, durmak) eğitim döngüsü seçer (dil tanımı 15.36, 20.14, 20.15). Örnek:
//
//     eğer karar == SONLU_DEĞİL { op.sıfırla(); devam }          // adımı atla (GradScaler gibi)
//     eğer karar == SIÇRAMA { adım = kn.geri_dön(); ö.atla(200); devam }   // PaLM §5.1
//
// Yöntem: OLMo-core'un StabilityMonitor'ı gibi kayıp ve normun her biri son `pencere` sağlam
// değerin ortalamasıyla karşılaştırılır; ortalamanın `eşik` standart sapma üstündeki değer
// sıçramadır (OLMo-core: pencere 128, eşik 6). Sıçrama ve sonlu olmayan değer geçmişe girmez:
// geçmiş sağlam eğitimin ölçüsü kalır. Değişmeyen dizide (σ ≈ 0) sapma, ortalamanın %1'inden
// küçük alınmaz; OLMo-core bu durumda denetlemez, bekçi ise her ani artışı sıçrama sayar.
// Geçmiş tamamen sıfırsa (σ ve ortalama 0) karar verilmez: değer geçmişe girer, bekçi
// kilitlenmez. Ortalama ve sapma, penceredeki en büyük mutlak değere bölünmüş değerlerle
// hesaplanır: ölçekten bağımsızdır ve çok büyük sonlu değerlerde (1e155) taşmaz.
// Pencere dolmadan yalnızca sonlu olmayan değer yakalanır (eğitimin başı hızlı düşer).

sabit TAMAM = "tamam"
sabit SONLU_DEĞİL = "sonlu_değil"
sabit SIÇRAMA = "sıçrama"

// Değişmeyen dizide sapmanın ortalamaya göre en küçük oranı.
sabit EN_KÜÇÜK_GÖRELİ_SAPMA = 0.01

yapı SıçramaBekçisi {
    pencere
    eşik
    kayıplar
    normlar
    sıçrama_sayısı = 0
    fonksiyon kurucu(pencere = 128, eşik = 6.0) {
        eğer tip(pencere) != Tam veya pencere < 2 { fırlat "SıçramaBekçisi: pencere en az 2 olan bir Tam olmalıdır, {pencere} verildi" }
        eğer değil sonlu_mu(eşik) veya değil (eşik > 0) { fırlat "SıçramaBekçisi: eşik sonlu ve pozitif olmalıdır, {eşik} verildi" }
        kendi.pencere = pencere
        kendi.eşik = eşik
        kendi.kayıplar = []
        kendi.normlar = []
    }
    // gözle bir adımın kaybını ve gradyan normunu (sayı) değerlendirir; TAMAM, SONLU_DEĞİL ya da
    // SIÇRAMA verir. Yalnızca TAMAM olan değerler geçmişe girer.
    fonksiyon gözle(kayıp, norm) {
        eğer değil sonlu_mu(kayıp) veya değil sonlu_mu(norm) { sonuç SONLU_DEĞİL }
        eğer kendi.kayıplar.uzunluk >= kendi.pencere {
            eğer kendi.aşıyor(kendi.kayıplar, kayıp) veya kendi.aşıyor(kendi.normlar, norm) {
                kendi.sıçrama_sayısı += 1
                sonuç SIÇRAMA
            }
        }
        kendi.kayıplar = kendi.ekle(kendi.kayıplar, kayıp)
        kendi.normlar = kendi.ekle(kendi.normlar, norm)
        sonuç TAMAM
    }
    // geçmiş_uzunluğu geçmişteki sağlam adım sayısıdır (en çok pencere).
    fonksiyon geçmiş_uzunluğu() { sonuç kendi.kayıplar.uzunluk }
    fonksiyon aşıyor(geçmiş, değer) {
        değişken m = mutlak(değer)
        döngü x içinde geçmiş { m = maks(m, mutlak(x)) }
        eğer m == 0 { sonuç yanlış }
        değişken g = [x / m döngü x içinde geçmiş]
        değişken o = ortalama(g)
        değişken s = maks(standart_sapma(g), EN_KÜÇÜK_GÖRELİ_SAPMA * mutlak(o))
        eğer s == 0 { sonuç yanlış } // geçmiş tamamen sıfır: karar yok
        sonuç değer / m > o + kendi.eşik * s
    }
    fonksiyon ekle(geçmiş, değer) {
        geçmiş.ekle(değer)
        eğer geçmiş.uzunluk > kendi.pencere { sonuç geçmiş[1..geçmiş.uzunluk] }
        sonuç geçmiş
    }
}

// --- Koşu ---
//
// Koşu bir eğitimin kayıt işlerini üstlenir; döngü kullanıcıda kalır (Hugging Face Accelerate'in
// yolu: save_state/load_state, kullanıcının kendi döngüsü). Lightning ve Keras döngüyü kendileri
// sürer ve geri çağırma düzeni ister; TR'de özel adımlar (bekçinin geri dönüşü, birikim,
// kaynaştırma) döngüde açık kalsın diye yalnızca kayıt işleri toplanır.
//
//     değişken koşu = Koşu(ayar.koşu, ayar, {model: model, adamw: op.adamw, ö: ö}, adım_sayısı: ayar.adım, prova: ayar.prova)
//     döngü adım içinde koşu.kaldığı_adım..koşu.son_adım {
//         ... adım ...
//         koşu.adım_bitti(adım + 1, eğer günlük_adımı { {kayıp: kayıp} } değilse { yok })
//         eğer değerlendirme_adımı { koşu.değerlendirildi(adım + 1, {doğrulama_kaybı: dk}) }
//     }
//     koşu.bitir(model)
//
// Klasörde config.json (ayarlar, parametre sayısı, cihaz), metrics.jsonl (günlük; çubuğun ve
// değerlendirmelerin kayıtları), kontrol_noktalari/ (nesneler ve günlük) ve sonda model.trt durur.
// Aynı komut kaldığı adımdan sürer (dil tanımı 20). bitir ağırlıkları her şeyden önce yazar: sonrası
// bir hatayla bitse de eğitimin sonucu kaybolmaz.
//
// prova: doğru, aynı komutun uzun koşudan önceki denemesidir (Lightning fast_dev_run'ın karşılığı):
// koşu geçici bir klasörde PROVA_ADIMI adım sürer, kontrol noktası her adımda yazılır, bitir koşunun
// dosyalarının hepsinin yazıldığını denetler. Böylece uzun koşunun sonunda düşecek bir satır
// (ör. yalnızca son adımda çalışan bir değerlendirme ya da kayıt) önceden görülür.

sabit PROVA_ADIMI = 2

yapı Koşu {
    klasör
    prova
    günlük
    çubuk
    nokta
    kaldığı_adım
    son_adım
    fonksiyon kurucu(klasör, ayar, nesneler, adım_sayısı, her_dakika = 15.0, prova = yanlış) {
        eğer tip(adım_sayısı) != Tam veya adım_sayısı < 1 { fırlat "Koşu: adım_sayısı en az 1 olan bir Tam olmalıdır, {adım_sayısı} verildi" }
        kendi.prova = prova
        kendi.son_adım = eğer prova { min(adım_sayısı, PROVA_ADIMI) } değilse { adım_sayısı }
        kendi.klasör = eğer prova { yol(geçici_klasör(), "prova") } değilse { yol(klasör) }
        klasör_oluştur(kendi.klasör)
        değişken sayı = 0
        eğer nesneler.içerir("model") {
            döngü w içinde parametreler(nesneler["model"]) { sayı += w.şekil.indirge(1) { birikim * o } }
        }
        dosya_yaz(yol(kendi.klasör, "config.json"), json_metin({ayar: ayar, parametre_sayısı: sayı, cihaz: varsayılan_cihaz()}))
        kendi.günlük = günlük(yol(kendi.klasör, "metrics.jsonl"))
        değişken kayıtlılar = {}
        döngü ad, d içinde nesneler { kayıtlılar[ad] = d }
        kayıtlılar["günlük"] = kendi.günlük
        kendi.nokta = kontrol_noktası(kendi.klasör, kayıtlılar, her_dakika: eğer prova { 0 } değilse { her_dakika })
        kendi.kaldığı_adım = kendi.nokta.kaldığı_adım
        kendi.çubuk = ilerleme(kendi.son_adım, günlük: kendi.günlük)
        eğer kendi.kaldığı_adım > 0 { kendi.çubuk.güncelle(adım: kendi.kaldığı_adım) }
    }
    // adım_bitti eğitimin adım sınırıdır: ölçüler verilirse (sözlük; okumak GPU'yu bekletir, bu yüzden
    // her adımda değil) çubuk ve günlük güncellenir; kontrol noktası zamanı geldiyse kaydedilir.
    // Kayıt yapıldıysa doğru verir.
    fonksiyon adım_bitti(adım, ölçüler = yok) {
        eğer ölçüler != yok { kendi.çubuk.güncelle(ölçüler, adım: adım) }
        sonuç kendi.nokta.güncelle(adım)
    }
    // değerlendirildi bir değerlendirmenin ölçülerini (sözlük) adımıyla günlüğe yazar.
    fonksiyon değerlendirildi(adım, ölçüler) {
        değişken kayıt = {adım: adım}
        döngü ad, d içinde ölçüler { kayıt[ad] = d }
        kendi.günlük.ekle(kayıt)
    }
    // geri_dön son kontrol noktasına döner ve onun adımını verir (sıçrama bekçisinin kararıyla).
    fonksiyon geri_dön() { sonuç kendi.nokta.geri_dön() }
    // bitir önce modelin ağırlıklarını (model.trt) yazar, sonra son kontrol noktasını; provada koşunun
    // dosyalarının hepsinin yazıldığını denetler ve sonucu yazar.
    fonksiyon bitir(model) {
        tensör_kaydet(yol(kendi.klasör, "model.trt"), parametreler(model, adlarıyla: doğru))
        kendi.nokta.kaydet()
        eğer kendi.prova {
            döngü ad içinde ["config.json", "metrics.jsonl", "model.trt", "kontrol_noktalari"] {
                eğer değil yol(kendi.klasör, ad).var_mı { fırlat "Koşu provası: {ad} yazılmadı ({kendi.klasör.mutlak})" }
            }
            yazdır("Prova geçti: {kendi.son_adım} adım, bütün dosyalar yazıldı ({kendi.klasör.mutlak})")
        }
    }
}
