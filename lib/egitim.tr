//! tr kodlu 3 dil=tr
// tr/egitim — uzun eğitimin güvencesi: koşu düzeni (Koşu) ve kayıp ile gradyan normu sıçrama
// bekçisi (SıçramaBekçisi).
//
// Kullanım:   aktar "tr/egitim"
//             değişken bekçi = SıçramaBekçisi(pencere: 128, eşik: 6.0)
//             değişken karar = bekçi.gözle(kayıp.değer, norm.değer)   // TAMAM, SONLU_DEĞİL ya da SIÇRAMA
//
// Bekçi yalnızca karar verir; ne yapılacağını (adımı atlamak, son kontrol noktasına dönüp toplu
// işleri atlamak, durmak) eğitim döngüsü seçer (dil tanımı 15.36, 20.14, 20.15). Örnek:
//
//     eğer karar == SONLU_DEĞİL { op.sıfırla(); devam }          // adımı atla (GradScaler gibi)
//     eğer karar == SIÇRAMA { adım = kn.geri_dön(); ö.atla(200); devam }   // PaLM §5.1
//
// Yöntem: OLMo-core'un StabilityMonitor'ı gibi kayıp ve normun her biri son `pencere` sağlam
// değerin ortalamasıyla karşılaştırılır; ortalamanın `eşik` standart sapma üstündeki değer
// sıçramadır (OLMo-core: pencere 128, eşik 6). Sıçrama ve sonlu olmayan değer geçmişe girmez:
// geçmiş sağlam eğitimin ölçüsü kalır. Değişmeyen dizide (σ ≈ 0) sapma, ortalamanın %1'inden
// küçük alınmaz; OLMo-core bu durumda denetlemez, bekçi ise her ani artışı sıçrama sayar.
// Geçmiş tamamen sıfırsa (σ ve ortalama 0) karar verilmez: değer geçmişe girer, bekçi
// kilitlenmez. Ortalama ve sapma, penceredeki en büyük mutlak değere bölünmüş değerlerle
// hesaplanır: ölçekten bağımsızdır ve çok büyük sonlu değerlerde (1e155) taşmaz.
// Pencere dolmadan yalnızca sonlu olmayan değer yakalanır (eğitimin başı hızlı düşer).

TR_kw_const TAMAM = "tamam"
TR_kw_const SONLU_DEĞİL = "sonlu_değil"
TR_kw_const SIÇRAMA = "sıçrama"

// Değişmeyen dizide sapmanın ortalamaya göre en küçük oranı.
TR_kw_const EN_KÜÇÜK_GÖRELİ_SAPMA = 0.01

TR_kw_struct SıçramaBekçisi {
    pencere
    eşik
    kayıplar
    normlar
    sıçrama_sayısı = 0
    TR_kw_func TR_ctx_init(pencere = 128, eşik = 6.0) {
        TR_kw_if TR_fn_type(pencere) != TR_type_Int TR_kw_or pencere < 2 { TR_kw_throw "SıçramaBekçisi: pencere en az 2 olan bir Tam olmalıdır, {pencere} verildi" }
        TR_kw_if TR_kw_not TR_fn_is_finite(eşik) TR_kw_or TR_kw_not (eşik > 0) { TR_kw_throw "SıçramaBekçisi: eşik sonlu ve pozitif olmalıdır, {eşik} verildi" }
        TR_kw_self.pencere = pencere
        TR_kw_self.eşik = eşik
        TR_kw_self.kayıplar = []
        TR_kw_self.normlar = []
    }
    // gözle bir adımın kaybını ve gradyan normunu (sayı) değerlendirir; TAMAM, SONLU_DEĞİL ya da
    // SIÇRAMA verir. Yalnızca TAMAM olan değerler geçmişe girer.
    TR_kw_func gözle(kayıp, norm) {
        TR_kw_if TR_kw_not TR_fn_is_finite(kayıp) TR_kw_or TR_kw_not TR_fn_is_finite(norm) { TR_kw_return SONLU_DEĞİL }
        TR_kw_if TR_kw_self.kayıplar.TR_mem_length >= TR_kw_self.pencere {
            TR_kw_if TR_kw_self.aşıyor(TR_kw_self.kayıplar, kayıp) TR_kw_or TR_kw_self.aşıyor(TR_kw_self.normlar, norm) {
                TR_kw_self.sıçrama_sayısı += 1
                TR_kw_return SIÇRAMA
            }
        }
        TR_kw_self.kayıplar = TR_kw_self.TR_mem_append(TR_kw_self.kayıplar, kayıp)
        TR_kw_self.normlar = TR_kw_self.TR_mem_append(TR_kw_self.normlar, norm)
        TR_kw_return TAMAM
    }
    // geçmiş_uzunluğu geçmişteki sağlam adım sayısıdır (en çok pencere).
    TR_kw_func geçmiş_uzunluğu() { TR_kw_return TR_kw_self.kayıplar.TR_mem_length }
    TR_kw_func aşıyor(geçmiş, değer) {
        TR_kw_var m = TR_fn_abs(değer)
        TR_kw_for x TR_kw_in geçmiş { m = TR_fn_max(m, TR_fn_abs(x)) }
        TR_kw_if m == 0 { TR_kw_return TR_kw_false }
        TR_kw_var g = [x / m TR_kw_for x TR_kw_in geçmiş]
        TR_kw_var o = TR_fn_mean(g)
        TR_kw_var s = TR_fn_max(TR_fn_std(g), EN_KÜÇÜK_GÖRELİ_SAPMA * TR_fn_abs(o))
        TR_kw_if s == 0 { TR_kw_return TR_kw_false } // geçmiş tamamen sıfır: karar yok
        TR_kw_return değer / m > o + TR_kw_self.eşik * s
    }
    TR_kw_func TR_mem_append(geçmiş, değer) {
        geçmiş.TR_mem_append(değer)
        TR_kw_if geçmiş.TR_mem_length > TR_kw_self.pencere { TR_kw_return geçmiş[1..geçmiş.TR_mem_length] }
        TR_kw_return geçmiş
    }
}

// --- Koşu ---
//
// Koşu bir eğitimin kayıt işlerini üstlenir; döngü kullanıcıda kalır (Hugging Face Accelerate'in
// yolu: save_state/load_state, kullanıcının kendi döngüsü). Lightning ve Keras döngüyü kendileri
// sürer ve geri çağırma düzeni ister; TR'de özel adımlar (bekçinin geri dönüşü, birikim,
// kaynaştırma) döngüde açık kalsın diye yalnızca kayıt işleri toplanır.
//
//     değişken koşu = Koşu(ayar.koşu, ayar, {model: model, adamw: op.adamw, ö: ö}, adım_sayısı: ayar.adım, prova: ayar.prova)
//     döngü adım içinde koşu.kaldığı_adım..koşu.son_adım {
//         ... adım ...
//         koşu.adım_bitti(adım + 1, eğer günlük_adımı { {kayıp: kayıp} } değilse { yok })
//         eğer değerlendirme_adımı { koşu.değerlendirildi(adım + 1, {doğrulama_kaybı: dk}) }
//     }
//     koşu.bitir(model)
//
// Klasörde config.json (ayarlar, parametre sayısı, cihaz), metrics.jsonl (günlük; çubuğun ve
// değerlendirmelerin kayıtları), kontrol_noktalari/ (nesneler ve günlük) ve sonda model.trt durur.
// Aynı komut kaldığı adımdan sürer (dil tanımı 20). bitir ağırlıkları her şeyden önce yazar: sonrası
// bir hatayla bitse de eğitimin sonucu kaybolmaz.
//
// prova: doğru, aynı komutun uzun koşudan önceki denemesidir (Lightning fast_dev_run'ın karşılığı):
// koşu geçici bir klasörde PROVA_ADIMI adım sürer, kontrol noktası her adımda yazılır, bitir koşunun
// dosyalarının hepsinin yazıldığını denetler. Böylece uzun koşunun sonunda düşecek bir satır
// (ör. yalnızca son adımda çalışan bir değerlendirme ya da kayıt) önceden görülür.

TR_kw_const PROVA_ADIMI = 2

TR_kw_struct Koşu {
    klasör
    prova
    günlük
    çubuk
    nokta
    TR_mem_resume_step
    son_adım
    TR_kw_func TR_ctx_init(klasör, ayar, nesneler, adım_sayısı, her_dakika = 15.0, prova = TR_kw_false) {
        TR_kw_if TR_fn_type(adım_sayısı) != TR_type_Int TR_kw_or adım_sayısı < 1 { TR_kw_throw "Koşu: adım_sayısı en az 1 olan bir Tam olmalıdır, {adım_sayısı} verildi" }
        TR_kw_self.prova = prova
        TR_kw_self.son_adım = TR_kw_if prova { TR_fn_min(adım_sayısı, PROVA_ADIMI) } TR_kw_else { adım_sayısı }
        TR_kw_self.klasör = TR_kw_if prova { TR_fn_path(TR_fn_temp_dir(), "prova") } TR_kw_else { TR_fn_path(klasör) }
        TR_fn_make_dir(TR_kw_self.klasör)
        TR_kw_var sayı = 0
        TR_kw_if nesneler.TR_mem_contains("model") {
            TR_kw_for w TR_kw_in TR_fn_parameters(nesneler["model"]) { sayı += w.TR_mem_shape.TR_mem_reduce(1) { TR_ctx_acc * TR_ctx_it } }
        }
        TR_fn_write_file(TR_fn_path(TR_kw_self.klasör, "config.json"), TR_fn_json_string({ayar: ayar, parametre_sayısı: sayı, TR_mem_device: TR_fn_default_device()}))
        TR_kw_self.günlük = TR_fn_logger(TR_fn_path(TR_kw_self.klasör, "metrics.jsonl"))
        TR_kw_var kayıtlılar = {}
        TR_kw_for ad, d TR_kw_in nesneler { kayıtlılar[ad] = d }
        kayıtlılar["günlük"] = TR_kw_self.günlük
        TR_kw_self.nokta = TR_fn_checkpoint(TR_kw_self.klasör, kayıtlılar, TR_arg_every_minutes: TR_kw_if prova { 0 } TR_kw_else { her_dakika })
        TR_kw_self.TR_mem_resume_step = TR_kw_self.nokta.TR_mem_resume_step
        TR_kw_self.çubuk = TR_fn_progress(TR_kw_self.son_adım, TR_arg_log: TR_kw_self.günlük)
        TR_kw_if TR_kw_self.TR_mem_resume_step > 0 { TR_kw_self.çubuk.TR_mem_update(TR_arg_step: TR_kw_self.TR_mem_resume_step) }
    }
    // adım_bitti eğitimin adım sınırıdır: ölçüler verilirse (sözlük; okumak GPU'yu bekletir, bu yüzden
    // her adımda değil) çubuk ve günlük güncellenir; son adımda ölçü verilmese de çubuk kapanır.
    // Kontrol noktası zamanı geldiyse kaydedilir; kayıt yapıldıysa doğru verir.
    TR_kw_func adım_bitti(adım, ölçüler = TR_kw_none) {
        TR_kw_if ölçüler != TR_kw_none {
            TR_kw_self.çubuk.TR_mem_update(ölçüler, TR_arg_step: adım)
        } TR_kw_else TR_kw_if adım == TR_kw_self.son_adım {
            TR_kw_self.çubuk.TR_mem_update(TR_arg_step: adım)
        }
        TR_kw_return TR_kw_self.nokta.TR_mem_update(adım)
    }
    // değerlendirildi bir değerlendirmenin ölçülerini (sözlük) adımıyla günlüğe yazar.
    TR_kw_func değerlendirildi(adım, ölçüler) {
        TR_kw_var kayıt = {TR_mem_step: adım}
        TR_kw_for ad, d TR_kw_in ölçüler { kayıt[ad] = d }
        TR_kw_self.günlük.TR_mem_append(kayıt)
    }
    // geri_dön son kontrol noktasına döner ve onun adımını verir (sıçrama bekçisinin kararıyla).
    TR_kw_func TR_mem_rollback() { TR_kw_return TR_kw_self.nokta.TR_mem_rollback() }
    // bitir önce modelin ağırlıklarını (model.trt) yazar, sonra son kontrol noktasını; provada koşunun
    // dosyalarının hepsinin yazıldığını denetler ve sonucu yazar.
    TR_kw_func bitir(model) {
        TR_fn_save_tensors(TR_fn_path(TR_kw_self.klasör, "model.trt"), TR_fn_parameters(model, TR_arg_named: TR_kw_true))
        TR_kw_self.nokta.TR_mem_save()
        TR_kw_if TR_kw_self.prova {
            TR_kw_for ad TR_kw_in ["config.json", "metrics.jsonl", "model.trt", "kontrol_noktalari"] {
                TR_kw_if TR_kw_not TR_fn_path(TR_kw_self.klasör, ad).TR_mem_exists { TR_kw_throw "Koşu provası: {ad} yazılmadı ({TR_kw_self.klasör.TR_mem_absolute})" }
            }
            TR_fn_print("Prova geçti: {TR_kw_self.son_adım} adım, bütün dosyalar yazıldı")
        }
    }
}
