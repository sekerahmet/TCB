# TR 4
# tr/turkish: Türkçe sözcüğün sözlük biçimini bulur (dil tanımı 26).
#
# Kullanım:   aktar "tr/turkish"
#             yazdır(kök_bul("kitaplarımızdan"))   # kitap
#             değişken çözüm = sözcük_çözümle("gidiyorum")
#             yazdır(çözüm.kök, çözüm.ekler)       # git ["iyor", "um"]
#
# Yapım eki sözlükte duran sözcükten sökülmez (`öğretmen` kalır); sözlükte olmayan türemiş biçimde
# üretken yapım eki soyulur. Fiilin sözlük biçimi köktür (`git`), mastar eki yazılmaz.
#
# Veri. Sözcük listeleri Zemberek NLP'nin `master-dictionary.dict` dosyasından üretildi:
#   Kaynak: https://github.com/ahmetaa/zemberek-nlp, commit 6b90eac24bfb,
#           morphology/src/main/resources/tr/master-dictionary.dict
#   Telif:  Copyright 2018 Ahmet A. Akın, Mehmet D. Akın
#   Lisans: depo Apache-2.0'dır (http://www.apache.org/licenses/LICENSE-2.0). Veri sözlüğü için üst
#           depoda ayrı bir söz yok; Apache-2.0 sayıldı.
#   Değişiklik: dosya bu listelere çevrildi, biçim ve işaretler aşağıdaki gibi işlendi.
#
# Yeniden üretim. Noktalama girdileri ve `a`, `e` atılır; sözcük küçültülür, düzeltme işareti kalkar.
#   - `P:` işareti olmayan, `-mak`/`-mek` ile biten girdi fiildir, mastar eki atılır; öbürü _İSİMLER'dedir.
#   - `-î` ile biten girdinin düz yazımı bir adın çekimiyse (`kalbî`, `kalbi`) ve başka girdisi yoksa atılır.
#   - _ÜNLÜ_DÜŞENLER: `A:LastVowelDrop`. _İNCE_EK_ALANLAR: `A:InverseHarmony`.
#   - _YUMUŞAYAN_FİİLLER: `A:Voicing` taşıyan, `t` ile biten fiil kökü.
#   - _KORUNANLAR: `p`, `ç`, `t`, `k` ile biten, yumuşamayan ad. Aynı yazılışlı girdilerinden biri
#     `A:Voicing` taşıyorsa yumuşar; biri `A:NoVoicing` ya da `A:InverseHarmony` taşıyorsa yumuşamaz;
#     işaret yoksa çok heceli ya da `nk` ile biten sözcük yumuşar.
#   - _İKİZLEŞENLER: `A:Doubling`; `A:Voicing` da varsa son ünsüz yumuşayarak ikizleşir (`ret`, `redd`).
# Zemberek'te olmayan ekler: _EK_İSİMLER ve _EK_FİİLLER, _EK_YUMUŞAYAN_FİİLLER. Özel adlar yoktur.
#
# Kurallar Gemini'nin kök bulucusundan çevrildi: ad çekimi, ek eylem, fiilimsi ve fiil çekimi sağdan
# sola soyulur, her aday sözlükle sınanır, en iyi aday _önce ile seçilir.

# SözcükTürü: bulunan sözlük biçiminin türü. Sıfat ve zarf da ad sayılır: Zemberek'in fiil dışı girdileri.
TR_enum TR_WordKind {
    TR_Noun
    TR_Verb
    TR_UnknownKind
}

# SözcükÇözümü: sözcüğün sözlük biçimi, türü, sırasıyla ekleri ve sözlükte bulunup bulunmadığı.
TR_struct TR_WordAnalysis {
    TR_lemma: TR_String
    TR_word_kind: TR_WordKind
    TR_suffixes: TR_List[TR_String]
    TR_known: TR_Bool
}

TR_const _ÜNLÜLER = "aeıioöuü"
TR_const _KALIN_ÜNLÜLER = "aıou"
TR_const _DAR_ÜNLÜLER = "ıiuü"
TR_const _SERT_ÜNSÜZLER = "fstkçşhp"
TR_const _KENAR = " \t\n\r.,!?;:()[]{}\"'’‘«»“”„—–-…/\\@#$%^&*+=<>|~`"
TR_const _EN_UZUN_YAPIM = 2 # art arda soyulan yapım eki
TR_const _EN_ÇOK_İÇ_EK = 3 # fiil gövdesinden soyulan olumsuzluk, yeterlilik ve çatı eki

# Bir ek: yazımı, ünlü uyumu ("ae", "dar", "sabit") ve önündeki gövdenin kuralı.
TR_struct _Ek {
    yazım: TR_String
    uyum: TR_String
    kural: TR_String
}

# Gelecek zaman kalıbı: sözcük sonu, kip eki, kişi eki, yumuşamış mı.
TR_struct _Gelecek {
    yazım: TR_String
    kip: TR_String
    kişi: TR_String
    yumuşadı: TR_Bool
}

# Sağdan sola soyulmakta olan ad zinciri.
TR_struct _Zincir {
    gövde: TR_String
    iç_ek: TR_String = ""
    iç_uyum: TR_String = "sabit"
    ünlü_eki_aldı: TR_Bool = TR_false
    ekler_ters: TR_List[TR_String] = []
    olaylar: TR_List[TR_String] = []
}

# Köke bağlanmayı bekleyen fiil gövdesi.
TR_struct _Fiil {
    gövde: TR_String
    iç_ek: TR_String
    iç_uyum: TR_String
    ünlü_eki_aldı: TR_Bool
    y_öncesi: TR_Bool
    ekler: TR_List[TR_String]
    olaylar: TR_List[TR_String]
    yapım: TR_Int = 0
    iç: TR_Int = 0
}

# Bir çözüm adayı; öncelik ve ses olayları sıralama içindir, dışa çıkmaz.
TR_struct _Aday {
    çözüm: TR_WordAnalysis
    öncelik: TR_Int
    yapım: TR_Int
    olay: TR_Int
}

# İlk çağrıda bir kez kurulan tablolar (11.1: modülün en dışı kod koşturmaz).
TR_struct _Tablolar {
    isimler: TR_Dict[TR_String, TR_Bool]
    fiiller: TR_Dict[TR_String, TR_Bool]
    ünlü_düşenler: TR_Dict[TR_String, TR_Bool]
    korunanlar: TR_Dict[TR_String, TR_Bool]
    ince_ek_alanlar: TR_Dict[TR_String, TR_Bool]
    sert_fiiller: TR_Dict[TR_String, TR_Bool]
    yumuşak_fiiller: TR_Dict[TR_String, TR_String]
    ikizler: TR_Dict[TR_String, TR_String]
    çoğul: TR_List[_Ek]
    iyelik_3ç: TR_List[_Ek]
    iyelik_3t: TR_List[_Ek]
    iyelik_12: TR_List[_Ek]
    durum: TR_List[_Ek]
    zamir_n: TR_List[_Ek]
    ek_fiil: TR_List[_Ek]
    yapım: TR_List[_Ek]
    fiilimsi: TR_List[_Ek]
    kip: TR_List[_Ek]
    olumsuz: TR_List[_Ek]
    çatı: TR_List[_Ek]
    gelecek: TR_List[_Gelecek]
    yor_sonları: TR_List[TR_String]
    son_çiftler: TR_Dict[TR_String, TR_Bool]
    güvenli_ekler: TR_Dict[TR_String, TR_Bool]
    ki_önleri: TR_Dict[TR_String, TR_Bool]
}

TR_var _tablo: _Tablolar? = TR_none
TR_var _kurulum = 0
TR_var _bulucu: TR_Lemmatizer? = TR_none

# _küçült Türkçe küçük harfe çevirir, düzeltme işaretini kaldırır.
TR_func _küçült(yazı: TR_String) -> TR_String {
    TR_return yazı.TR_replace("I", "ı").TR_replace("İ", "i").TR_lower().TR_replace("â", "a").TR_replace("î", "i").TR_replace("û", "u").TR_replace("ô", "o")
}

# _kenar_temizle sözcüğün iki yanındaki boşluk ve noktalamayı kırpar.
TR_func _kenar_temizle(yazı: TR_String) -> TR_String {
    TR_var n = yazı.TR_length
    TR_var baş = 0
    TR_for baş < n TR_and _KENAR.TR_contains(yazı[baş]) { baş = baş + 1 }
    TR_var son = n
    TR_for son > baş TR_and _KENAR.TR_contains(yazı[son - 1]) { son = son - 1 }
    TR_return yazı[baş..son]
}

# _kesme_yeri son kesme işaretinin yeridir, işaret yoksa -1.
TR_func _kesme_yeri(sözcük: TR_String) -> TR_Int {
    TR_var yer = -1
    TR_for i TR_in 0..sözcük.TR_length {
        TR_if sözcük[i] == "'" TR_or sözcük[i] == "’" { yer = i }
    }
    TR_return yer
}

TR_func _ünlü_mü(harf: TR_String) -> TR_Bool { TR_return harf.TR_length == 1 TR_and _ÜNLÜLER.TR_contains(harf) }

TR_func _ünsüz_mü(harf: TR_String) -> TR_Bool { TR_return harf.TR_length == 1 TR_and "bcçdfgğhjklmnprsştvyzqxw".TR_contains(harf) }

TR_func _ünlü_sayısı(sözcük: TR_String) -> TR_Int {
    TR_var sayaç = 0
    TR_for h TR_in sözcük {
        TR_if _ünlü_mü(h) { sayaç = sayaç + 1 }
    }
    TR_return sayaç
}

# _son_ünlü sözcüğün son ünlüsüdür, ünlü yoksa boş.
TR_func _son_ünlü(sözcük: TR_String) -> TR_String {
    TR_var n = sözcük.TR_length
    TR_for i TR_in 0..n {
        TR_if _ünlü_mü(sözcük[n - 1 - i]) { TR_return sözcük[n - 1 - i] }
    }
    TR_return ""
}

TR_func _ilk_ünlü(sözcük: TR_String) -> TR_String {
    TR_for h TR_in sözcük {
        TR_if _ünlü_mü(h) { TR_return h }
    }
    TR_return ""
}

TR_func _son_harf(sözcük: TR_String) -> TR_String {
    TR_if sözcük.TR_length == 0 { TR_return "" }
    TR_return sözcük[sözcük.TR_length - 1]
}

TR_func _son_ünlü_harf_mi(sözcük: TR_String) -> TR_Bool { TR_return _ünlü_mü(_son_harf(sözcük)) }

TR_func _son_sert_mi(sözcük: TR_String) -> TR_Bool {
    TR_var h = _son_harf(sözcük)
    TR_return h != "" TR_and _SERT_ÜNSÜZLER.TR_contains(h)
}

# _geniş_uyum son ünlüden sonra gelecek a ya da e'dir; ince uyumlu sözcükte hep e.
TR_func _geniş_uyum(son: TR_String, ince: TR_Bool) -> TR_String {
    TR_if TR_not ince TR_and _KALIN_ÜNLÜLER.TR_contains(son) { TR_return "a" }
    TR_return "e"
}

# _dar_uyum son ünlüden sonra gelecek ı, i, u ya da ü'dür.
TR_func _dar_uyum(son: TR_String, ince: TR_Bool) -> TR_String {
    TR_if son == "a" TR_or son == "ı" { TR_return TR_if ince { "i" } TR_else { "ı" } }
    TR_if son == "e" TR_or son == "i" { TR_return "i" }
    TR_if son == "o" TR_or son == "u" { TR_return TR_if ince { "ü" } TR_else { "u" } }
    TR_if son == "ö" TR_or son == "ü" { TR_return "ü" }
    TR_return ""
}

# _uyumlu_mu gövdenin son ünlüsüyle ekin ilk ünlüsünün uyumunu sınar.
TR_func _uyumlu_mu(gövde: TR_String, ek: TR_String, uyum: TR_String, ince: TR_Bool = TR_false) -> TR_Bool {
    TR_if uyum == "sabit" { TR_return TR_true }
    TR_var g = _son_ünlü(gövde)
    TR_var e = _ilk_ünlü(ek)
    TR_if g == "" TR_or e == "" { TR_return TR_false }
    TR_if uyum == "ae" { TR_return e == _geniş_uyum(g, ince) }
    TR_return e == _dar_uyum(g, ince)
}

# _kural_uygun_mu ek soyulduktan sonra kalan gövdenin ekin kuralına uyduğunu sınar.
TR_func _kural_uygun_mu(gövde: TR_String, kural: TR_String) -> TR_Bool {
    TR_if gövde.TR_length == 0 { TR_return TR_false }
    TR_return TR_match kural {
        "hepsi" => TR_true
        "ünlü" => _son_ünlü_harf_mi(gövde)
        "ünsüz" => TR_not _son_ünlü_harf_mi(gövde)
        "sert" => _son_sert_mi(gövde)
        "yumuşak" => TR_not _son_sert_mi(gövde)
        "ünsüz_sert" => TR_not _son_ünlü_harf_mi(gövde) TR_and _son_sert_mi(gövde)
        _ => TR_not _son_ünlü_harf_mi(gövde) TR_and TR_not _son_sert_mi(gövde)
    }
}

TR_func _olay_ekle(olaylar: TR_List[TR_String], olay: TR_String) -> TR_List[TR_String] {
    TR_if olaylar.TR_contains(olay) { TR_return olaylar }
    TR_return olaylar + [olay]
}

# _soy zincirin sağından bir ek soyar, önceki ekin uyumunu yeni gövdede sınar; olmazsa yok verir.
TR_func _soy(z: _Zincir, ek: _Ek) -> _Zincir? {
    TR_var g = z.gövde
    TR_var y = ek.yazım
    TR_if g.TR_length <= y.TR_length TR_or TR_not g.TR_ends_with(y) { TR_return TR_none }
    TR_if z.iç_ek != "" TR_and TR_not _uyumlu_mu(g, z.iç_ek, z.iç_uyum) { TR_return TR_none }
    TR_var kalan = g[0..g.TR_length - y.TR_length]
    TR_if TR_not _kural_uygun_mu(kalan, ek.kural) { TR_return TR_none }
    TR_var olaylar = z.olaylar
    TR_if ek.kural == "sert" TR_or ek.kural == "ünsüz_sert" { olaylar = _olay_ekle(olaylar, "benzeşme") }
    TR_var uyum = TR_if _ilk_ünlü(y) == "" { "sabit" } TR_else { ek.uyum }
    TR_return _Zincir(gövde: kalan, iç_ek: y, iç_uyum: uyum, ünlü_eki_aldı: _ünlü_mü(y[0]), ekler_ters: z.ekler_ters + [y], olaylar: olaylar)
}

# _ters zincirin eklerini sözcükteki sırasıyla verir.
TR_func _ters(ekler: TR_List[TR_String]) -> TR_List[TR_String] {
    TR_var n = ekler.TR_length
    TR_return [ekler[n - 1 - i] TR_for i TR_in 0..n]
}

TR_func _uzunluk(ekler: TR_List[TR_String]) -> TR_Int {
    TR_var n = 0
    TR_for e TR_in ekler { n = n + e.TR_length }
    TR_return n
}

# _ki_öncesi_mi `-ki`nin önünde durabilen bulunma ya da tamlayan ekini arar.
TR_func _ki_öncesi_mi(gövde: TR_String) -> TR_Bool {
    TR_for son TR_in ["da", "de", "ta", "te", "ın", "in", "un", "ün", "im", "ım"] {
        TR_if gövde.TR_ends_with(son) { TR_return TR_true }
    }
    TR_return TR_false
}

# _güvenli_fiil_eki_mi bilinmeyen gövdede kesin bir fiil eki arar: `sensör`, `aktör` geniş zaman değildir.
TR_func _güvenli_fiil_eki_mi(ekler: TR_List[TR_String]) -> TR_Bool {
    TR_for e TR_in ekler {
        TR_if e.TR_contains("yor") TR_or e.TR_contains("acak") TR_or e.TR_contains("ecek") { TR_return TR_true }
        TR_for baş TR_in ["malı", "meli", "mış", "miş", "muş", "müş"] {
            TR_if e.TR_starts_with(baş) { TR_return TR_true }
        }
        TR_if ["mak", "mek", "arak", "erek", "yarak", "yerek", "madan", "meden"].TR_contains(e) { TR_return TR_true }
    }
    TR_return TR_false
}

# _önce a'nın b'den iyi olduğunu söyler: öncelik, az yapım eki, uzun kök, az ek, az ses olayı, yazım.
TR_func _önce(a: _Aday, b: _Aday) -> TR_Bool {
    TR_if a.öncelik != b.öncelik { TR_return a.öncelik > b.öncelik }
    TR_if a.yapım != b.yapım { TR_return a.yapım < b.yapım }
    TR_var ak = a.çözüm.TR_lemma
    TR_var bk = b.çözüm.TR_lemma
    TR_if ak.TR_length != bk.TR_length { TR_return ak.TR_length > bk.TR_length }
    TR_if a.çözüm.TR_suffixes.TR_length != b.çözüm.TR_suffixes.TR_length { TR_return a.çözüm.TR_suffixes.TR_length < b.çözüm.TR_suffixes.TR_length }
    TR_if a.olay != b.olay { TR_return a.olay < b.olay }
    TR_return ak < bk
}

# Bir sözcüğün aranması: tablolar, kullanıcının sözlüğü ve toplanan adaylar.
TR_struct _Arama {
    t: _Tablolar
    ek_isimler: TR_Dict[TR_String, TR_Bool]
    ek_fiiller: TR_Dict[TR_String, TR_Bool]
    adaylar: TR_List[_Aday] = []
    TR_func _isim_mi(kök: TR_String) -> TR_Bool { TR_return TR_self.t.isimler.TR_contains(kök) TR_or TR_self.ek_isimler.TR_contains(kök) }
    TR_func _fiil_mi(kök: TR_String) -> TR_Bool { TR_return TR_self.t.fiiller.TR_contains(kök) TR_or TR_self.ek_fiiller.TR_contains(kök) }
    # _kök_uyumu kökün son soyulan ekle uyumunu sınar; ince ek alan sözcük iki uyumla da geçer:
    # aynı yazılışlı öbür girdi (`hal`, `ad`) kalın ek alır.
    TR_func _kök_uyumu(kök: TR_String, ek: TR_String, uyum: TR_String) -> TR_Bool {
        TR_if ek == "" TR_or uyum == "sabit" { TR_return TR_true }
        TR_return _uyumlu_mu(kök, ek, uyum) TR_or (TR_self.t.ince_ek_alanlar.TR_contains(kök) TR_and _uyumlu_mu(kök, ek, uyum, ince: TR_true))
    }
    TR_func _ekle(kök: TR_String, tür: TR_WordKind, ekler: TR_List[TR_String], olaylar: TR_List[TR_String], bilinen: TR_Bool, öncelik: TR_Int, yapım: TR_Int) {
        TR_self.adaylar.TR_append(_Aday(çözüm: TR_WordAnalysis(kök, tür, ekler, bilinen), öncelik: öncelik, yapım: yapım, olay: olaylar.TR_length))
    }
    # _son_küme_uygun_mu sözlük dışı gövdenin Türkçede olabilecek ünsüz çiftiyle bittiğini sınar.
    TR_func _son_küme_uygun_mu(kök: TR_String) -> TR_Bool {
        TR_var n = kök.TR_length
        TR_if n < 2 { TR_return TR_false }
        TR_if _ünsüz_mü(kök[n - 2]) TR_and _ünsüz_mü(kök[n - 1]) { TR_return TR_self.t.son_çiftler.TR_contains(kök[n - 2..n]) }
        TR_return TR_true
    }
    # _sözcük sözcüğün bütün adaylarını toplar: özel çekim, eksiz sözlük, ad zinciri, fiil çekimi.
    TR_func _sözcük(küçük: TR_String) {
        TR_if _ÖZEL_ÇEKİMLER.TR_contains(küçük) {
            TR_self._ekle(_ÖZEL_ÇEKİMLER[küçük], TR_WordKind.TR_Noun, [], [], TR_true, 320, 0)
        }
        TR_if TR_self._isim_mi(küçük) { TR_self._ekle(küçük, TR_WordKind.TR_Noun, [], [], TR_true, 300, 0) }
        TR_if TR_self._fiil_mi(küçük) { TR_self._ekle(küçük, TR_WordKind.TR_Verb, [], [], TR_true, 295, 0) }
        TR_var z = _Zincir(gövde: küçük)
        TR_self._ek_fiil(z)
        TR_self._fiil_çekimi(küçük)
    }
    # Ad zinciri dıştan içe soyulur: ek eylem, `-ki`, durum, iyelik, çoğul.
    TR_func _ek_fiil(z: _Zincir) {
        TR_self._ki(z)
        TR_for ek TR_in TR_self.t.ek_fiil {
            TR_var yeni = _soy(z, ek)
            TR_if yeni != TR_none { TR_self._ki(yeni) }
        }
    }
    TR_func _ki(z: _Zincir) {
        TR_self._durum(z, TR_false)
        TR_var adaylar = [z]
        TR_for ek TR_in TR_self.t.durum + TR_self.t.zamir_n {
            TR_var yeni = _soy(z, ek)
            TR_if yeni != TR_none { adaylar.TR_append(yeni) }
        }
        TR_for a TR_in adaylar {
            TR_var çoğulsuz = a
            TR_var ler = _soy(a, _Ek(yazım: "ler", uyum: "ae", kural: "hepsi"))
            TR_if ler != TR_none { çoğulsuz = ler }
            TR_if çoğulsuz.gövde.TR_ends_with("ki") TR_and çoğulsuz.gövde.TR_length >= 4 {
                TR_var ki = _soy(çoğulsuz, _Ek(yazım: "ki", uyum: "sabit", kural: "hepsi"))
                TR_if ki != TR_none TR_and _ki_öncesi_mi(ki.gövde) { TR_self._durum(ki, TR_true) }
            }
        }
    }
    # _durum durum ekini soyar; `-ki`nin önünde yalnız bulunma ve tamlayan eki durur (`masadaki`, `masat`+`a` değil).
    TR_func _durum(z: _Zincir, ki_önü: TR_Bool) {
        TR_self._iyelik(z, TR_true)
        TR_for ek TR_in TR_self.t.durum {
            TR_var yeni = _soy(z, ek)
            # Üçüncü kişi iyelikten sonra zamir n'si olmadan yalnız vasıta eki gelir.
            TR_if yeni != TR_none TR_and (TR_not ki_önü TR_or TR_self.t.ki_önleri.TR_contains(ek.yazım)) { TR_self._iyelik(yeni, ek.yazım == "yla" TR_or ek.yazım == "yle") }
        }
        TR_for ek TR_in TR_self.t.zamir_n {
            TR_var yeni = _soy(z, ek)
            TR_if yeni != TR_none TR_and (TR_not ki_önü TR_or TR_self.t.ki_önleri.TR_contains(ek.yazım)) {
                # Kalıplaşmış birleşik ad: `buzdolabından`, `havaalanında`.
                TR_if _DAR_ÜNLÜLER.TR_contains(_son_harf(yeni.gövde)) TR_and TR_self._isim_mi(yeni.gövde) { TR_self._kök(yeni) }
                TR_self._üçüncü_iyelik(yeni)
            }
        }
    }
    TR_func _üçüncü_iyelik(z: _Zincir) {
        TR_for ek TR_in TR_self.t.iyelik_3ç {
            TR_var yeni = _soy(z, ek)
            TR_if yeni != TR_none { TR_self._kök(yeni) }
        }
        TR_for ek TR_in TR_self.t.iyelik_3t {
            TR_var yeni = _soy(z, ek)
            TR_if yeni != TR_none { TR_self._çoğul(yeni) }
        }
    }
    TR_func _iyelik(z: _Zincir, üçüncü: TR_Bool) {
        TR_self._çoğul(z)
        TR_if üçüncü { TR_self._üçüncü_iyelik(z) }
        TR_for ek TR_in TR_self.t.iyelik_12 {
            TR_var yeni = _soy(z, ek)
            TR_if yeni != TR_none { TR_self._çoğul(yeni) }
        }
    }
    TR_func _çoğul(z: _Zincir) {
        TR_self._kök(z)
        TR_for ek TR_in TR_self.t.çoğul {
            TR_var yeni = _soy(z, ek)
            TR_if yeni != TR_none { TR_self._kök(yeni) }
        }
    }
    TR_func _kök(z: _Zincir) {
        TR_if z.ekler_ters.TR_length == 0 {
            TR_self._yapım(z, 0)
            TR_self._fiilimsi(z)
            TR_return
        }
        TR_self._ad_bağla(z, 0)
        TR_self._yapım(z, 0)
        TR_self._fiilimsi(z)
        TR_self._bilinmeyen_ad(z)
    }
    # _ad_bağla gövdeyi sözlükteki ada bağlar: doğrudan; ünlü ile başlayan ek önünde yumuşama, ünlü
    # düşmesi ve ikizleşmeyle.
    TR_func _ad_bağla(z: _Zincir, yapım: TR_Int) {
        TR_var g = z.gövde
        TR_if g.TR_length == 0 { TR_return }
        TR_var ekler = _ters(z.ekler_ters)
        # Eşitlik eki zarf fiile yol verir: `gelince` `gelin`+`ce` değil, `gel`+`ince`.
        TR_var öncelik = TR_if z.ekler_ters.TR_length > 0 TR_and ["ca", "ce", "ça", "çe", "nca", "nce"].TR_contains(z.ekler_ters[0]) { 199 } TR_else { 200 }
        TR_if TR_self._isim_mi(g) TR_and TR_self._kök_uyumu(g, z.iç_ek, z.iç_uyum) { TR_self._ekle(g, TR_WordKind.TR_Noun, ekler, z.olaylar, TR_true, öncelik, yapım) }
        TR_if TR_not z.ünlü_eki_aldı { TR_return }
        TR_for kök TR_in _yumuşama_adayları(g) {
            TR_if TR_self._isim_mi(kök) TR_and TR_not TR_self.t.korunanlar.TR_contains(kök) TR_and TR_self._kök_uyumu(kök, z.iç_ek, z.iç_uyum) { TR_self._ekle(kök, TR_WordKind.TR_Noun, ekler, _olay_ekle(z.olaylar, "yumuşama"), TR_true, öncelik, yapım) }
        }
        TR_for kök TR_in _düşme_adayları(g) {
            TR_if TR_self.t.ünlü_düşenler.TR_contains(kök) TR_and TR_self._kök_uyumu(kök, z.iç_ek, z.iç_uyum) { TR_self._ekle(kök, TR_WordKind.TR_Noun, ekler, _olay_ekle(z.olaylar, "ünlü düşmesi"), TR_true, öncelik, yapım) }
        }
        TR_if TR_self.t.ikizler.TR_contains(g) {
            TR_var kök = TR_self.t.ikizler[g]
            TR_if TR_self._kök_uyumu(kök, z.iç_ek, z.iç_uyum) { TR_self._ekle(kök, TR_WordKind.TR_Noun, ekler, _olay_ekle(z.olaylar, "ikizleşme"), TR_true, öncelik, yapım) }
        }
    }
    # _sertleşmiş ünlü önünde `ğ`ye dönmüş gövdeyi `k`li biçimine çevirir; olmazsa yok verir.
    TR_func _sertleşmiş(z: _Zincir) -> _Zincir? {
        TR_if TR_not (z.ünlü_eki_aldı TR_and z.gövde.TR_length >= 4 TR_and z.gövde.TR_ends_with("ğ")) { TR_return TR_none }
        TR_var sert = z.gövde[0..z.gövde.TR_length - 1] + "k"
        TR_if TR_not TR_self._kök_uyumu(sert, z.iç_ek, z.iç_uyum) { TR_return TR_none }
        TR_return _Zincir(gövde: sert, ekler_ters: z.ekler_ters, olaylar: _olay_ekle(z.olaylar, "yumuşama"))
    }
    # _yapım sözlükte olmayan türemiş gövdeden üretken yapım eklerini soyar (`kitaplığım`, `kitaplık`, `kitap`).
    TR_func _yapım(z: _Zincir, derinlik: TR_Int) {
        TR_if derinlik >= _EN_UZUN_YAPIM { TR_return }
        TR_var bakılacak = [z]
        TR_var sert = TR_self._sertleşmiş(z)
        TR_if sert != TR_none { bakılacak.TR_append(sert) }
        TR_for b TR_in bakılacak {
            TR_for ek TR_in TR_self.t.yapım {
                TR_var yeni = _soy(b, ek)
                TR_if yeni != TR_none TR_and yeni.gövde.TR_length >= 2 {
                    TR_self._ad_bağla(yeni, derinlik + 1)
                    TR_self._yapım(yeni, derinlik + 1)
                }
            }
        }
    }
    # _fiilimsi ad çekimi almış fiilimsiyi fiil köküne götürür: `okumaktan`, `gittiğimizde`, `gidenler`.
    TR_func _fiilimsi(z: _Zincir) {
        TR_var bakılacak = [z]
        TR_var sert = TR_self._sertleşmiş(z)
        TR_if sert != TR_none { bakılacak.TR_append(sert) }
        TR_for b TR_in bakılacak {
            TR_for ek TR_in TR_self.t.fiilimsi {
                TR_var yeni = _soy(b, ek)
                TR_if yeni != TR_none { TR_self._fiil_bağla(_fiil(yeni, ek.yazım.TR_starts_with("y"))) }
            }
        }
    }
    TR_func _fiil_çekimi(sözcük: TR_String) {
        TR_for son TR_in TR_self.t.yor_sonları {
            TR_var tam = "yor" + son
            TR_if sözcük.TR_ends_with(tam) TR_and sözcük.TR_length > tam.TR_length + 1 {
                TR_var sonlar: TR_List[TR_String] = TR_if son == "" { [] } TR_else { [son] }
                TR_self._yor(sözcük[0..sözcük.TR_length - tam.TR_length], sonlar)
            }
        }
        TR_for k TR_in TR_self.t.gelecek {
            TR_if sözcük.TR_ends_with(k.yazım) TR_and sözcük.TR_length > k.yazım.TR_length {
                TR_var ön = sözcük[0..sözcük.TR_length - k.yazım.TR_length]
                TR_var y = k.yazım.TR_starts_with("y")
                TR_if y == _son_ünlü_harf_mi(ön) {
                    TR_var ekler: TR_List[TR_String] = TR_if k.kişi == "" { [k.kip] } TR_else { [k.kip, k.kişi] }
                    TR_var olaylar: TR_List[TR_String] = TR_if k.yumuşadı { ["yumuşama"] } TR_else { [] }
                    TR_self._fiil_bağla(_Fiil(gövde: ön, iç_ek: k.kip, iç_uyum: "ae", ünlü_eki_aldı: TR_not y, y_öncesi: y, ekler: ekler, olaylar: olaylar))
                }
            }
        }
        TR_var baş = _Zincir(gövde: sözcük)
        TR_for ek TR_in TR_self.t.kip {
            TR_var yeni = _soy(baş, ek)
            TR_if yeni != TR_none { TR_self._fiil_bağla(_fiil(yeni, ek.yazım.TR_starts_with("y"))) }
        }
    }
    # _yor `-yor`un önünü çözer: yardımcı dar ünlü (`gid-i-yor`), dar ünlüyle biten kök (`oku-yor`),
    # ünlü daralması (`bekli-yor`).
    TR_func _yor(ön: TR_String, sonlar: TR_List[TR_String]) {
        TR_var n = ön.TR_length
        TR_if n == 0 { TR_return }
        TR_var son = ön[n - 1]
        TR_if TR_not _DAR_ÜNLÜLER.TR_contains(son) { TR_return }
        TR_var gövde = ön[0..n - 1]
        TR_if n >= 2 TR_and TR_not _son_ünlü_harf_mi(gövde) {
            TR_self._fiil_bağla(_Fiil(gövde: gövde, iç_ek: son + "yor", iç_uyum: "dar", ünlü_eki_aldı: TR_true, y_öncesi: TR_false, ekler: [son + "yor"] + sonlar, olaylar: []))
        }
        TR_self._fiil_bağla(_Fiil(gövde: ön, iç_ek: "yor", iç_uyum: "sabit", ünlü_eki_aldı: TR_false, y_öncesi: TR_false, ekler: ["yor"] + sonlar, olaylar: []))
        TR_var geniş = TR_if son == "ı" TR_or son == "u" { "a" } TR_else { "e" }
        TR_var dar = TR_if _son_ünlü(gövde) == "" {
            TR_if geniş == "a" { "ı" } TR_else { "i" }
        } TR_else {
            _dar_uyum(_son_ünlü(gövde), TR_false)
        }
        TR_if dar == son {
            TR_self._fiil_bağla(_Fiil(gövde: gövde + geniş, iç_ek: "yor", iç_uyum: "sabit", ünlü_eki_aldı: TR_false, y_öncesi: TR_false, ekler: ["yor"] + sonlar, olaylar: ["ünlü daralması"]))
        }
    }
    # _fiil_bağla gövdeyi sözlükteki fiile bağlar, olmazsa içteki olumsuzluk ve çatı eklerini soyar.
    TR_func _fiil_bağla(f: _Fiil) {
        TR_var g = f.gövde
        TR_if g.TR_length == 0 { TR_return }
        TR_if TR_self._fiil_mi(g) TR_and TR_not (f.ünlü_eki_aldı TR_and TR_self.t.sert_fiiller.TR_contains(g)) TR_and TR_self._kök_uyumu(g, f.iç_ek, f.iç_uyum) { TR_self._ekle(g, TR_WordKind.TR_Verb, f.ekler, f.olaylar, TR_true, 200, f.yapım) }
        TR_if f.ünlü_eki_aldı TR_and TR_self.t.yumuşak_fiiller.TR_contains(g) {
            TR_var sert = TR_self.t.yumuşak_fiiller[g]
            TR_if TR_self._kök_uyumu(sert, f.iç_ek, f.iç_uyum) { TR_self._ekle(sert, TR_WordKind.TR_Verb, f.ekler, _olay_ekle(f.olaylar, "yumuşama"), TR_true, 200, f.yapım) }
        }
        # `de` ve `ye` y önünde daralır: `diyen`, `yiyecek`.
        TR_if f.y_öncesi TR_and (g == "di" TR_or g == "yi") {
            TR_var geniş = TR_if g == "di" { "de" } TR_else { "ye" }
            TR_self._ekle(geniş, TR_WordKind.TR_Verb, f.ekler, _olay_ekle(f.olaylar, "ünlü daralması"), TR_true, 200, f.yapım)
        }
        TR_if _FİİL_ÜNLÜ_DÜŞENLER.TR_contains(g) { TR_self._ekle(_FİİL_ÜNLÜ_DÜŞENLER[g], TR_WordKind.TR_Verb, f.ekler, _olay_ekle(f.olaylar, "ünlü düşmesi"), TR_true, 200, f.yapım) }
        # Sınır üst üste binen eklerde (`amamama`) dallanmayı keser: Türkçe en çok iki iç ek alır.
        TR_if f.iç < _EN_ÇOK_İÇ_EK { TR_self._iç_ekler(f, TR_self.t.olumsuz, f.yapım, 0) }
        TR_if f.yapım == 0 { TR_self._iç_ekler(f, TR_self.t.çatı, 1, 1) }
        TR_self._bilinmeyen_fiil(f)
    }
    # _iç_ekler fiil gövdesinden olumsuzluk, yeterlilik ya da çatı ekini soyup bağlamayı yineler;
    # `fazla` ek boyundan sonra en az kaç harf kalacağıdır.
    TR_func _iç_ekler(f: _Fiil, ekler: TR_List[_Ek], yapım: TR_Int, fazla: TR_Int) {
        TR_var g = f.gövde
        TR_for ek TR_in ekler {
            TR_var y = ek.yazım
            TR_if g.TR_ends_with(y) TR_and g.TR_length > y.TR_length + fazla TR_and TR_self._kök_uyumu(g, f.iç_ek, f.iç_uyum) {
                TR_var alt = g[0..g.TR_length - y.TR_length]
                TR_if _kural_uygun_mu(alt, ek.kural) {
                    TR_var olaylar = TR_if fazla == 1 TR_and y.TR_starts_with("t") { _olay_ekle(f.olaylar, "benzeşme") } TR_else { f.olaylar }
                    TR_self._fiil_bağla(_Fiil(gövde: alt, iç_ek: y, iç_uyum: ek.uyum, ünlü_eki_aldı: _ünlü_mü(y[0]), y_öncesi: fazla == 0 TR_and y.TR_starts_with("y"), ekler: [y] + f.ekler, olaylar: olaylar, yapım: yapım, iç: f.iç + 1))
                }
            }
        }
    }
    # _bilinmeyen_fiil sözlükte olmayan fiili yalnız kesin bir ekle kabul eder: `mırıldanıyorum`.
    TR_func _bilinmeyen_fiil(f: _Fiil) {
        TR_var g = f.gövde
        TR_if f.yapım != 0 TR_or g.TR_length < 2 TR_or _ünlü_sayısı(g) < 1 { TR_return }
        TR_if _güvenli_fiil_eki_mi(f.ekler) TR_and TR_self._son_küme_uygun_mu(g) TR_and TR_self._kök_uyumu(g, f.iç_ek, f.iç_uyum) { TR_self._ekle(g, TR_WordKind.TR_Verb, f.ekler, f.olaylar, TR_false, 95 + _uzunluk(f.ekler), 0) }
    }
    # _bilinmeyen_ad sözlükte olmayan adın yalnız güvenli çekim ekini soyar: `blokzincirde`.
    TR_func _bilinmeyen_ad(z: _Zincir) {
        TR_var g = z.gövde
        TR_if g.TR_length < 2 TR_or _ünlü_sayısı(g) < 1 { TR_return }
        TR_var ekler = _ters(z.ekler_ters)
        TR_var kök = g
        TR_var olaylar = z.olaylar
        # Çok heceli yalın kök `ğ` ile bitmez: `fırıldağım`, `fırıldak`.
        TR_var ğ = z.ünlü_eki_aldı TR_and _ünlü_sayısı(g) >= 2 TR_and g.TR_ends_with("ğ")
        TR_if ğ {
            kök = g[0..g.TR_length - 1] + "k"
            olaylar = _olay_ekle(olaylar, "yumuşama")
        }
        # En iç ek kesin bir çekim eki olmalı: `koala`, `melodi` kırpılmaz.
        TR_var güvenli = ekler.TR_length > 0 TR_and TR_self.t.güvenli_ekler.TR_contains(ekler[0])
        TR_if (ğ TR_or güvenli) TR_and TR_self._son_küme_uygun_mu(kök) TR_and TR_self._kök_uyumu(kök, z.iç_ek, z.iç_uyum) { TR_self._ekle(kök, TR_WordKind.TR_UnknownKind, ekler, olaylar, TR_false, 100 + _uzunluk(ekler), 0) }
    }
}

# _fiil soyulmuş zinciri fiil gövdesine çevirir.
TR_func _fiil(z: _Zincir, y: TR_Bool) -> _Fiil {
    TR_return _Fiil(gövde: z.gövde, iç_ek: z.iç_ek, iç_uyum: z.iç_uyum, ünlü_eki_aldı: z.ünlü_eki_aldı, y_öncesi: y, ekler: _ters(z.ekler_ters), olaylar: z.olaylar)
}

# _yumuşama_adayları yumuşamış olabilecek gövdeden sert kökleri verir: `kitab`, `reng`, `sokağ`, `diyaloğ`.
TR_func _yumuşama_adayları(g: TR_String) -> TR_List[TR_String] {
    TR_var r: TR_List[TR_String] = []
    TR_var n = g.TR_length
    TR_if n < 2 { TR_return r }
    TR_if n >= 3 TR_and g.TR_ends_with("ng") { r.TR_append(g[0..n - 2] + "nk") }
    TR_var ön = g[0..n - 1]
    TR_var sert = TR_match g[n - 1] {
        "b" => "p"
        "c" => "ç"
        "d" => "t"
        "ğ" => "k"
        _ => ""
    }
    TR_if sert != "" { r.TR_append(ön + sert) }
    TR_if g.TR_ends_with("loğ") { r.TR_append(ön + "g") }
    TR_return r
}

# _düşme_adayları orta ünlüsü düşmüş gövdeden kökleri verir: `burn`, `kayb`, `vakt`, `avc`.
TR_func _düşme_adayları(g: TR_String) -> TR_List[TR_String] {
    TR_var r: TR_List[TR_String] = []
    TR_var n = g.TR_length
    TR_if n < 3 TR_or _ünlü_sayısı(g) != 1 { TR_return r }
    TR_var ü1 = g[n - 2]
    TR_var ü2 = g[n - 1]
    TR_if TR_not (_ünsüz_mü(ü1) TR_and _ünsüz_mü(ü2)) { TR_return r }
    TR_var son = _son_ünlü(g)
    TR_var sol = g[0..n - 1]
    TR_var ünlüler: TR_List[TR_String] = [_dar_uyum(son, TR_false)]
    # Alıntılarda uyum dışı dizilişler: `vakit`, `avuç`, `zulüm`.
    TR_if son == "a" { ünlüler = ünlüler + ["i", "u"] }
    TR_if son == "u" { ünlüler.TR_append("ü") }
    TR_var sert = TR_match ü2 {
        "b" => "p"
        "c" => "ç"
        "d" => "t"
        "ğ" => "k"
        _ => ""
    }
    TR_for ü TR_in ünlüler {
        r.TR_append(sol + ü + ü2)
        TR_if sert != "" { r.TR_append(sol + ü + sert) }
    }
    TR_return r
}

# _küme boşlukla ayrılmış sözcükleri kümeye çevirir.
TR_func _küme(yazı: TR_String) -> TR_Dict[TR_String, TR_Bool] {
    TR_var r: TR_Dict[TR_String, TR_Bool] = {}
    TR_for s TR_in yazı.TR_split() { r[s] = TR_true }
    TR_return r
}

# _ekler aynı uyum ve kuraldaki ekleri kurar.
TR_func _ekler(yazı: TR_String, uyum: TR_String, kural: TR_String) -> TR_List[_Ek] {
    TR_return [_Ek(yazım: y, uyum: uyum, kural: kural) TR_for y TR_in yazı.TR_split()]
}

# _gelecek_kalıpları gelecek zamanın sözcük sonlarını kurar; ünlüyle başlayan kişi eki önünde `k` yumuşar.
TR_func _gelecek_kalıpları() -> TR_List[_Gelecek] {
    TR_var r: TR_List[_Gelecek] = []
    TR_for k TR_in [("acak", "acağ", "ım ız", "sın sınız lar tım tık tı mış"), ("ecek", "eceğ", "im iz", "sin siniz ler tim tik ti miş")] {
        TR_for y TR_in ["y", ""] {
            r.TR_append(_Gelecek(yazım: y + k.0, kip: y + k.0, kişi: "", yumuşadı: TR_false))
            TR_for kişi TR_in k.2.TR_split() { r.TR_append(_Gelecek(yazım: y + k.1 + kişi, kip: y + k.0, kişi: kişi, yumuşadı: TR_true)) }
            TR_for kişi TR_in k.3.TR_split() { r.TR_append(_Gelecek(yazım: y + k.0 + kişi, kip: y + k.0, kişi: kişi, yumuşadı: TR_false)) }
        }
    }
    TR_return r
}

# Ek tabloları; sıra sonucu değiştirmez, adaylar _önce ile seçilir.
TR_func _kip_ekleri() -> TR_List[_Ek] {
    TR_return _ekler("dıkça dikçe dukça dükçe", "dar", "yumuşak") + _ekler("tıkça tikçe tukça tükçe", "dar", "sert") + _ekler("madan meden mazken mezken", "ae", "hepsi") +
        _ekler("yarak yerek", "ae", "ünlü") + _ekler("arak erek arken erken", "ae", "ünsüz") + _ekler("yınca yince yunca yünce yıp yip yup yüp", "dar", "ünlü") +
        _ekler("ınca ince unca ünce ıp ip up üp ırken irken urken ürken", "dar", "ünsüz") + _ekler("rken", "sabit", "ünlü") +
        _ekler("dınız diniz dunuz dünüz dılar diler dular düler dım dim dum düm dın din dun dün dık dik duk dük dı di du dü", "dar", "yumuşak") +
        _ekler("tınız tiniz tunuz tünüz tılar tiler tular tüler tım tim tum tüm tın tin tun tün tık tik tuk tük tı ti tu tü", "dar", "sert") +
        _ekler("mışsınız mişsiniz muşsunuz müşsünüz mışsın mişsin muşsun müşsün mışlar mişler muşlar müşler mışım mişim muşum müşüm mışız mişiz muşuz müşüz mıştır miştir muştur müştür mıştı mişti muştu müştü mış miş muş müş", "dar", "hepsi") +
        _ekler("malıydınız meliydiniz malısınız melisiniz malıydım meliydim malıydın meliydin malıydık meliydik malıymış meliymiş malısın melisin malıyım meliyim malıyız meliyiz malılar meliler malıydı meliydi malı meli", "ae", "hepsi") +
        _ekler("sanız seniz salar seler saydım seydim saydık seydik saydı seydi sam sem san sen sak sek sa se", "ae", "hepsi") +
        _ekler("yayım yeyim yalım yelim", "ae", "ünlü") + _ekler("ayım eyim alım elim", "ae", "ünsüz") + _ekler("sınlar sinler sunlar sünler sın sin sun sün", "dar", "hepsi") +
        _ekler("yınız yiniz yunuz yünüz yın yin yun yün", "dar", "ünlü") + _ekler("ınız iniz unuz ünüz ın in un ün", "dar", "ünsüz") +
        _ekler("mazsınız mezsiniz mazsın mezsin mazlar mezler mayız meyiz mazdı mezdi maz mez mam mem", "ae", "hepsi") +
        _ekler("arsınız ersiniz arsın ersin arlar erler arım erim arız eriz ar er", "ae", "ünsüz") +
        _ekler("ırsınız irsiniz ursunuz ürsünüz ırsın irsin ursun ürsün ırlar irler urlar ürler ırım irim urum ürüm ırız iriz uruz ürüz ır ir ur ür", "dar", "ünsüz") +
        _ekler("rsınız rsiniz rsunuz rsünüz rsın rsin rsun rsün rım rim rum rüm rız riz ruz rüz", "dar", "ünlü") + _ekler("rlar rler", "ae", "ünlü") + _ekler("r", "sabit", "ünlü")
}

TR_func _ek_fiil_ekleri() -> TR_List[_Ek] {
    TR_return _ekler("dırlar dirler durlar dürler dır dir dur dür", "dar", "yumuşak") + _ekler("tırlar tirler turlar türler tır tir tur tür", "dar", "sert") + _ekler("sınız siniz sunuz sünüz sın sin sun sün", "dar", "hepsi") +
        _ekler("yım yim yum yüm yız yiz yuz yüz ydım ydim ydum ydüm ydık ydik yduk ydük ydı ydi ydu ydü ymış ymiş ymuş ymüş", "dar", "ünlü") + _ekler("ız iz uz üz mış miş muş müş", "dar", "ünsüz") +
        _ekler("dım dim dum düm dık dik duk dük dı di du dü", "dar", "ünsüz_yumuşak") + _ekler("tım tim tum tüm tık tik tuk tük tı ti tu tü", "dar", "ünsüz_sert") +
        _ekler("ysa yse", "ae", "ünlü") + _ekler("sa se", "ae", "ünsüz") + _ekler("yken", "sabit", "ünlü") + _ekler("ken", "sabit", "ünsüz")
}

TR_func _durum_ekleri() -> TR_List[_Ek] {
    TR_return _ekler("dan den da de ca ce", "ae", "yumuşak") + _ekler("tan ten ta te ça çe", "ae", "sert") + _ekler("nın nin nun nün yı yi yu yü", "dar", "ünlü") + _ekler("ın in un ün ı i u ü", "dar", "ünsüz") +
        _ekler("yla yle ya ye", "ae", "ünlü") + _ekler("la le a e", "ae", "ünsüz")
}

TR_func _yapım_ekleri() -> TR_List[_Ek] {
    TR_return _ekler("lık lik luk lük sız siz suz süz lı li lu lü", "dar", "hepsi") + _ekler("cık cik cuk cük cı ci cu cü", "dar", "yumuşak") + _ekler("çık çik çuk çük çı çi çu çü", "dar", "sert") +
        _ekler("daş deş", "sabit", "yumuşak") + _ekler("taş teş", "sabit", "sert") + _ekler("sal sel", "ae", "hepsi") + _ekler("ıncı inci uncu üncü", "dar", "ünsüz") + _ekler("ncı nci ncu ncü", "dar", "ünlü")
}

TR_func _fiilimsi_ekleri() -> TR_List[_Ek] {
    TR_return _ekler("mak mek ma me", "ae", "hepsi") + _ekler("yış yiş yuş yüş", "dar", "ünlü") + _ekler("ış iş uş üş", "dar", "ünsüz") + _ekler("dık dik duk dük", "dar", "yumuşak") + _ekler("tık tik tuk tük", "dar", "sert") +
        _ekler("yacak yecek yan yen", "ae", "ünlü") + _ekler("acak ecek an en", "ae", "ünsüz")
}

# _tablolar tabloları ilk çağrıda kurar: kitaplığı aktaran ama kullanmayan program bedel ödemez.
TR_func _tablolar() -> _Tablolar {
    TR_var kurulmuş = _tablo
    TR_if kurulmuş != TR_none { TR_return kurulmuş }
    TR_var isimler = _küme(_İSİMLER + " " + _EK_İSİMLER)
    TR_var fiiller = _küme(_FİİLLER + " " + _EK_FİİLLER)
    TR_var sert_fiiller = _küme(_YUMUŞAYAN_FİİLLER + " " + _EK_YUMUŞAYAN_FİİLLER)
    TR_var yumuşak: TR_Dict[TR_String, TR_String] = {}
    TR_for f TR_in sert_fiiller { yumuşak[f[0..f.TR_length - 1] + "d"] = f }
    TR_var ikizler: TR_Dict[TR_String, TR_String] = {}
    TR_var parçalar = _İKİZLEŞENLER.TR_split()
    TR_for i TR_in 0..parçalar.TR_length // 2 { ikizler[parçalar[2 * i]] = parçalar[2 * i + 1] }
    TR_var yeni = _Tablolar(isimler: isimler, fiiller: fiiller, ünlü_düşenler: _küme(_ÜNLÜ_DÜŞENLER), korunanlar: _küme(_KORUNANLAR), ince_ek_alanlar: _küme(_İNCE_EK_ALANLAR),
        sert_fiiller: sert_fiiller, yumuşak_fiiller: yumuşak, ikizler: ikizler,
        çoğul: _ekler("lar ler", "ae", "hepsi"), iyelik_3ç: _ekler("ları leri", "ae", "hepsi"),
        iyelik_3t: _ekler("sı si su sü", "dar", "ünlü") + _ekler("ı i u ü", "dar", "ünsüz"),
        iyelik_12: _ekler("ımız imiz umuz ümüz ınız iniz unuz ünüz ım im um üm ın in un ün", "dar", "ünsüz") + _ekler("mız miz muz müz nız niz nuz nüz", "dar", "ünlü") + _ekler("m n", "sabit", "ünlü"),
        durum: _durum_ekleri(), zamir_n: _ekler("ndan nden nda nde na ne nca nce", "ae", "ünlü") + _ekler("nın nin nun nün nı ni nu nü", "dar", "ünlü"),
        ek_fiil: _ek_fiil_ekleri(), yapım: _yapım_ekleri(), fiilimsi: _fiilimsi_ekleri(), kip: _kip_ekleri(),
        olumsuz: _ekler("yabil yebil yama yeme", "ae", "ünlü") + _ekler("abil ebil ama eme", "ae", "ünsüz") + _ekler("ma me", "ae", "hepsi"),
        çatı: _ekler("dır dir dur dür", "dar", "yumuşak") + _ekler("tır tir tur tür", "dar", "sert") + _ekler("ıl il ul ül ın in un ün", "dar", "ünsüz") + _ekler("l n", "sabit", "ünlü"),
        gelecek: _gelecek_kalıpları(), yor_sonları: _YOR_SONLARI.TR_split() + [""], son_çiftler: _küme(_SON_ÜNSÜZ_ÇİFTLERİ), güvenli_ekler: _küme(_GÜVENLİ_AD_EKLERİ), ki_önleri: _küme(_Kİ_ÖNLERİ))
    _tablo = yeni
    _kurulum = _kurulum + 1
    TR_return yeni
}

# KökBulucu: kendi sözlüğünü kuran kullanıcının bulucusu; yerleşik sözlük paylaşılır.
TR_struct TR_Lemmatizer {
    _isimler: TR_Dict[TR_String, TR_Bool] = {}
    _fiiller: TR_Dict[TR_String, TR_Bool] = {}
    # kök_ekle sözlüğe ad ya da fiil kökü ekler (26.3).
    TR_func TR_add_lemma(TR_word: TR_String, TR_word_kind: TR_WordKind) {
        TR_var temiz = _küçült(_kenar_temizle(TR_word))
        TR_if temiz == "" { TR_throw TR_Message("H7540", TR_word) }
        TR_match TR_word_kind {
            TR_WordKind.TR_Noun => { TR_self._isimler[temiz] = TR_true }
            TR_WordKind.TR_Verb => { TR_self._fiiller[temiz] = TR_true }
            TR_WordKind.TR_UnknownKind => { TR_throw TR_Message("H7541", TR_word) }
        }
    }
    TR_func TR_lemma(TR_word: TR_String) -> TR_String { TR_return TR_self.TR_analyze_word(TR_word).TR_lemma }
    # _kurulum_sayısı tabloların kaç kez kurulduğunu söyler: `_tablo` modülden çıkmaz (26.4).
    TR_func _kurulum_sayısı() -> TR_Int { TR_return _kurulum }
    # sözcük_çözümle en iyi adayı verir, aday yoksa küçültülmüş girdiyi (26.2).
    TR_func TR_analyze_word(TR_word: TR_String) -> TR_WordAnalysis {
        TR_var kırpılmış = _kenar_temizle(TR_word)
        TR_var küçük = _küçült(kırpılmış)
        TR_var yok = TR_WordAnalysis(küçük, TR_WordKind.TR_UnknownKind, [], TR_false)
        TR_if küçük == "" { TR_return yok }
        TR_var a = _Arama(t: _tablolar(), ek_isimler: TR_self._isimler, ek_fiiller: TR_self._fiiller)
        # Kesme işareti ekin yerini söyler: `Ankara'dan`.
        TR_var kesme = _kesme_yeri(küçük)
        TR_if kesme > 0 {
            TR_var sol = küçük[0..kesme]
            TR_return TR_WordAnalysis(sol, TR_WordKind.TR_Noun, [küçük[kesme + 1..küçük.TR_length]], a._isim_mi(sol))
        }
        a._sözcük(küçük)
        TR_if a.adaylar.TR_length == 0 { TR_return yok }
        TR_var en_iyi = a.adaylar[0]
        TR_for aday TR_in a.adaylar {
            TR_if _önce(aday, en_iyi) { en_iyi = aday }
        }
        TR_return en_iyi.çözüm
    }
}

# _varsayılan yerleşik sözlüklü bulucuyu verir.
TR_func _varsayılan() -> TR_Lemmatizer {
    TR_var kurulmuş = _bulucu
    TR_if kurulmuş != TR_none { TR_return kurulmuş }
    TR_var yeni = TR_Lemmatizer()
    _bulucu = yeni
    TR_return yeni
}

# kök_bul sözcüğün sözlük biçimini verir: `kitabı`, `kitap`; `gidiyorum`, `git`.
TR_func TR_lemma(TR_word: TR_String) -> TR_String { TR_return _varsayılan().TR_lemma(TR_word) }

# sözcük_çözümle sözlük biçimini, türü ve ekleri verir.
TR_func TR_analyze_word(TR_word: TR_String) -> TR_WordAnalysis { TR_return _varsayılan().TR_analyze_word(TR_word) }

