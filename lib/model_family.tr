# TR 4
# tr/model_family — hazır modelin sohbet ailesi (15.55, "Sohbet tanımının seçimi"): aile tablosu ve
# yüklenen modele ailenin durma listesini ya da ailesiz kalmasının nedenini yazan iki adım
# (TR_gguf_chat_family, TR_folder_chat_family). İkisi de tr/pretrained'in iç adımıdır; modeli yükleyen
# yol bunları kendisi çağırır.

TR_import "tr/hugging_face"
TR_import "tr/layers"

# Sohbet tanımı (15.55, "Sohbet tanımının seçimi"): aile kimliği, mimari, GGUF'un ön bölme etiketi,
# klasörün işareti (tokenizer_class, Fast'sız; genel sınıfta bos_token'ın adı) ve durma parçalarının
# adları. Adlar parçalayıcının kimliğiyle çözülür.
TR_struct _Sohbet {
    aile: TR_String
    mimari: TR_String
    etiket: TR_String
    işaret: TR_String
    durma: TR_List[TR_String]
}

TR_func _sohbet_tablosu() -> TR_List[_Sohbet] {
    TR_return [
        _Sohbet("llama3", "llama", "llama-bpe", "<|begin_of_text|>", ["<|eot_id|>", "<|eom_id|>", "<|end_of_text|>"]),
        _Sohbet("qwen3", "qwen3", "qwen2", "Qwen2Tokenizer", ["<|im_end|>", "<|endoftext|>"]),
        _Sohbet("gemma3", "gemma3", "default", "GemmaTokenizer", ["<end_of_turn>", "<eos>"]),
        _Sohbet("gemma3", "gemma3_text", "default", "GemmaTokenizer", ["<end_of_turn>", "<eos>"]),
    ]
}

TR_const _GENEL_SINIFLAR = ["PreTrainedTokenizer", "PreTrainedTokenizerFast"]

# _aileyi_kur modele ailenin durma listesini yazar. Ailenin ilk durma adı dağarcıkta olmalıdır; öbür
# adlar dağarcıkta varsa listeye girer, yoksa atlanır (DENETİM 446 Ş1: aynı etiketli eski dağarcık
# <|eom_id|> taşımayabilir). Dosyanın bildirdiği her kimlik listede olmalıdır. İkisinden biri
# tutmazsa dosya aileyle uyuşmuyordur (ör. ChatML'e geçmiş Llama 3 ince ayarı): model kapanmaz,
# ailesiz yüklenir (DENETİM 454 Ş1). s ve p bulunmuştur (çağıranlar ailesizliği önce _ailesiz'le yazar).
TR_func _aileyi_kur(model: TR_GPT, s: _Sohbet?, p: TR_Tokenizer?, bildirilen: TR_List[TR_Int]?) -> TR_GPT {
    TR_var ilk = p.TR_token_id(s.durma[0])
    TR_if ilk == TR_none { TR_return _ailesiz(model, "name", s.aile, "\"\(s.durma[0])\"") }
    TR_var durma: TR_List[TR_Int] = [ilk]
    TR_for ad TR_in s.durma[1..s.durma.TR_length] {
        TR_var k = p.TR_token_id(ad)
        TR_if k != TR_none { durma.TR_append(k) }
    }
    TR_if bildirilen != TR_none {
        TR_for k TR_in bildirilen {
            TR_if TR_not durma.TR_contains(k) {
                TR_var ad = TR_if k >= 0 TR_and k < p.TR_vocab_size { p.TR_decode([k], TR_special_tokens: TR_true) } TR_else { "" }
                TR_return _ailesiz(model, "id", s.aile, "\(k) \"\(ad)\" ∉ \(durma)")
            }
        }
    }
    model._aileyi_yaz(durma)
    TR_return model
}

# _ailesiz modelin neden ailesiz kaldığını modelin _aile'sine yazar; model.TR_eos_tokens()'un H7170'i
# onu okur (lib/layers.tr). neden: marker (klasörde tokenizer_config.json yok), table (ikili tabloda
# yok), name, id (dosya aileyle uyuşmuyor), tokenizer (parçalayıcı yüklenemedi), file (klasörde
# tokenizer_config.json, generation_config.json ya da config.json'un eos_token_id'si okunamadı, GGUF'ta
# eot ya da eom kimlik değil; ayrıntı dosyanın adıdır). Elle kurulan GPT'de neden yoktur (none). hata
# yakalanan hatadır: H7170 onu nedeni olarak taşır (TCB 21:51, 8.2), kullanıcı e.TR_cause ile okur.
TR_func _ailesiz(model: TR_GPT, neden: TR_String, aile: TR_String, ayrıntı: TR_String, hata: TR_Error? = TR_none) -> TR_GPT {
    TR_var aileler: TR_List[TR_String] = []
    TR_for a TR_in _sohbet_tablosu() { TR_if TR_not aileler.TR_contains(a.aile) { aileler.TR_append(a.aile) } }
    model._ailesiz_yaz(neden, aileler.TR_join(", "), aile, ayrıntı, hata)
    TR_return model
}

# TR_gguf_chat_family GGUF'ta aileyi (mimari, p.TR_pretokenizer_tag) ile seçer. Parçalayıcı yüklenemezse
# model ailesizdir; yakalanan hata saklanır, H7170 onu nedeni olarak taşır (e.TR_cause). Dosya okuma
# hatası (H2107) buraya gelmez:
# TR_pretrained_gguf aynı dosyanın üstverisini ve tensörlerini önce okur, okunamayan dosyada o hatayla
# durur. Kod listesine bakılmaz: tanınmayan bir sonraki biçim de modeli kapatmaz. Dosyanın
# bildirdiği kimliklerin hatası (yanlış türde eot, H6681) da ailesiz bırakır, nedeni file'dır:
# parçalayıcı yüklenmiştir; ayrıntı boştur, bozuk anahtarı asıl hata söyler (TCB 22:52).
# tr/pretrained'in iç adımı; modeli yükleyen yol bunları kendisi çağırır.
TR_func TR_gguf_chat_family(model: TR_GPT, yol: TR_String, mimari: TR_String) -> TR_GPT {
    TR_var p: TR_Tokenizer? = TR_none
    TR_var bildirilen: TR_List[TR_Int]? = TR_none
    TR_try { p = TR_load_tokenizer(yol) } TR_catch e {
        TR_return _ailesiz(model, "tokenizer", "", "", e)
    }
    TR_try { bildirilen = p.TR_declared_eos_tokens } TR_catch e {
        TR_return _ailesiz(model, "file", "", "", e)
    }
    TR_var s: _Sohbet? = TR_none
    TR_for a TR_in _sohbet_tablosu() {
        TR_if a.mimari == mimari TR_and a.etiket == p.TR_pretokenizer_tag {
            s = a
            TR_break
        }
    }
    TR_if s == TR_none { TR_return _ailesiz(model, "table", "", "") }
    TR_return _aileyi_kur(model, s, p, bildirilen)
}

# TR_folder_chat_family safetensors klasöründe aileyi (model_type, işaret) ile seçer; işaret
# tokenizer_config.json'dan gelir. Klasörün üç aile dosyası (tokenizer_config.json,
# generation_config.json, tokenizer.json) bu dilimden önce okunmuyordu: biri yoksa ya da okunamazsa
# model ailesizdir, bugün yüklenen klasör kapanmaz (DENETİM 446 Ş2, 456 Ş1). Dosyanın bildirdiği
# kimlik generation_config.json'un, o yoksa config.json'un eos_token_id'sidir (tek sayı ya da liste).
# tr/pretrained'in iç adımı; modeli yükleyen yol bunları kendisi çağırır.
TR_func TR_folder_chat_family(model: TR_GPT, k: TR_Path, ayar: TR_JSON) -> TR_GPT {
    TR_var yapılandırma = TR_Path(k, "tokenizer_config.json")
    TR_if TR_not yapılandırma.TR_exists { TR_return _ailesiz(model, "marker", "", "") }
    TR_var işaret = ""
    TR_try { işaret = _klasör_işareti(yapılandırma) } TR_catch e {
        TR_return _ailesiz(model, "file", "", "tokenizer_config.json", e)
    }
    TR_var mimari = TR_String(TR_config_value(ayar, "model_type", ""))
    TR_var s: _Sohbet? = TR_none
    TR_for a TR_in _sohbet_tablosu() {
        TR_if a.mimari == mimari TR_and a.işaret == işaret {
            s = a
            TR_break
        }
    }
    TR_if s == TR_none { TR_return _ailesiz(model, "table", "", "") }
    TR_var sözlük = TR_Path(k, "tokenizer.json")
    TR_if TR_not sözlük.TR_exists { TR_return _ailesiz(model, "tokenizer", s.aile, "tokenizer.json") }
    TR_var nesil = TR_Path(k, "generation_config.json")
    TR_var kaynak = TR_if nesil.TR_exists { "generation_config.json" } TR_else { "config.json" }
    TR_var bildirilen: TR_List[TR_Int]? = TR_none
    TR_try { bildirilen = _bildirilen(TR_if nesil.TR_exists { TR_json_parse(TR_read_file(nesil)) } TR_else { ayar }) } TR_catch e {
        TR_return _ailesiz(model, "file", s.aile, kaynak, e)
    }
    TR_var p: TR_Tokenizer? = TR_none
    TR_try { p = TR_load_tokenizer(sözlük) } TR_catch e {
        TR_return _ailesiz(model, "tokenizer", s.aile, "tokenizer.json", e)
    }
    TR_return _aileyi_kur(model, s, p, bildirilen)
}

# _klasör_işareti tokenizer_config.json'dan klasörün işaretini okur: tokenizer_class, sondaki Fast eki
# atılarak; genel sınıfta bos_token'ın adı (bos_token nesneyse content'i).
TR_func _klasör_işareti(yapılandırma: TR_Path) -> TR_String {
    TR_var t = TR_json_parse(TR_read_file(yapılandırma))
    TR_var sınıf = TR_String(TR_config_value(t, "tokenizer_class", ""))
    TR_if _GENEL_SINIFLAR.TR_contains(sınıf) {
        TR_var bos = TR_config_value(t, "bos_token", "")
        TR_return TR_if TR_Type(bos) == TR_Dict { TR_String(bos["content"]) } TR_else { TR_String(bos) }
    }
    TR_return TR_if sınıf.TR_ends_with("Fast") { sınıf[0..sınıf.TR_length - 4] } TR_else { sınıf }
}

# _bildirilen ayardaki (generation_config.json ya da config.json) eos_token_id'dir: tek sayı ya da
# liste; anahtar yoksa TR_none.
TR_func _bildirilen(kaynak: TR_JSON) -> TR_List[TR_Int]? {
    TR_var e = TR_config_value(kaynak, "eos_token_id", TR_none)
    TR_if e == TR_none { TR_return TR_none }
    TR_if TR_Type(e) == TR_List { TR_return [TR_Int(x) TR_for x TR_in e] }
    TR_return [TR_Int(e)]
}
