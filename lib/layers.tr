# TR 4
# tr/layers — transformer katmanları ve yalnızca kod çözücülü GPT.
#
# Kullanım:   aktar "tr/layers"                (adlar doğrudan gelir: GPT, Doğrusal, ...)
#             aktar "tr/layers" olarak k       (k.GPT(...), k.Doğrusal(...))
# Her katman sıradan bir yapıdır: ağırlıklar alanlarındadır, ileri hesap `ileri` metodudur,
# `parametreler(model)` bütün ağırlıkları bulur. Bu dosyayı kopyalayıp değiştirebilirsiniz.
#
# Şekiller: girdiler [toplu, uzunluk, boyut] (kısaca [B, T, D]); çarpım `x @ W` biçimindedir,
# bu yüzden Doğrusal'ın ağırlığı [giriş, çıkış] şeklindedir.
# Başlatma: bütün ağırlık matrisleri N(0, 0.02) ile başlar (`std`); artık yola yazan çıkış
# katmanları (dikkatin `çıkış_katmanı`, ileri beslemenin `aşağı`sı) 0.02 / √(2 · katman sayısı) ile
# küçültülür, böylece derin modelde artık yolun varyansı katman sayısıyla büyümez. Norm
# ağırlıkları 1, sapmalar 0 ile başlar. Her ağırlığın kendi sabit tohumu vardır: aynı `tohum`
# aynı modeli verir.

# ağırlık_başlat şekli verilen, N(0, std) ile başlayan, türev izleyen bir ağırlık kurar; tür
# verilirse ağırlık o türde tutulur (ör. "bf16": hazır modellerin saklandığı tür).
TR_func TR_init_weight(TR_shape, TR_init_std, TR_seed, TR_dtype = "float32") {
    TR_return TR_Tensor(TR_no_grad((TR_randn(TR_shape, TR_seed: TR_seed) * TR_init_std).TR_to_dtype(TR_dtype)), TR_requires_grad: TR_true)
}

# Doğrusal: y = x @ ağırlık (+ sapma). ağırlık [giriş, çıkış], sapma [çıkış] ya da yok. tür
# ağırlığın türüdür (sapma float32): float32 x ile 16 bitlik ağırlığın çarpımı float32'dir (15.3),
# GPU'da ağırlık açılmadan okunur (çıkarımda okunan bayt yarıya iner).
# Sapma çarpımın türünde eklenir: karışık_hassasiyet("bf16") bloğunda çıktı bf16 kalır (float32
# sapma toplamı float32'ye yükseltmez). PyTorch'un autocast'i (F.linear sapmayı da bf16 işler) ve
# Flax'ın Dense'i (dtype sapmayı da kapsar) böyledir; sapmanın gradyanı float32 birikir (15.3).
# Hedef modelde float32 ara sonuçları ve geri dönüşümleri kaldırır (221 → 203 ms/adım).
TR_struct TR_Linear {
    TR_weight
    TR_bias
    TR_func TR_init(TR_in_features, TR_out_features, TR_use_bias = TR_false, TR_init_std = 0.02, TR_seed = 1, TR_dtype = "float32") {
        TR_self.TR_weight = TR_init_weight([TR_in_features, TR_out_features], TR_init_std, TR_seed, TR_dtype: TR_dtype)
        TR_self.TR_bias = TR_if TR_use_bias { TR_Tensor(TR_zeros([TR_out_features]), TR_requires_grad: TR_true) } TR_else { TR_none }
    }
    TR_func TR_forward(TR_x) {
        TR_if TR_self.TR_bias == TR_none { TR_return TR_x @ TR_self.TR_weight }
        TR_var y = TR_x @ TR_self.TR_weight
        TR_return y + TR_self.TR_bias.TR_to_dtype(y.TR_dtype)
    }
}

# GömmeKatmanı: parça kimliklerini [dağarcık, boyut] tablosunun satırlarına çevirir
# (`gömme` yerleşiğiyle): [B, T] → [B, T, boyut]. tür tablonun türüdür; float32 olmayan tablonun
# satırları hesap türüne çevrilir (karışık hassasiyet dışında float32: etkinleşmeler 32 bit kalır).
TR_struct TR_Embedding {
    TR_table
    TR_func TR_init(TR_vocab_size, TR_embed_dim, TR_init_std = 0.02, TR_seed = 1, TR_dtype = "float32") {
        TR_self.TR_table = TR_init_weight([TR_vocab_size, TR_embed_dim], TR_init_std, TR_seed, TR_dtype: TR_dtype)
    }
    TR_func TR_forward(TR_token_ids) {
        TR_var e = TR_embedding_lookup(TR_self.TR_table, TR_token_ids)
        TR_if TR_self.TR_table.TR_dtype == "float32" { TR_return e }
        TR_return e.TR_to_dtype(TR_compute_dtype())
    }
}

# RMSNormKatmanı: son eksende karelerin ortalamasının köküne böler, öğrenilen ağırlıkla
# çarpar (`rms_normu` yerleşiği). Ağırlık 1 ile başlar. Hesap float32'dir; çıktı girdinin
# türündedir, çıktı_türü verilirse o türde yazılır. Çıktısını yalnızca çarpımlar okuyorsa
# çağıran çıktı_türü: hesap_türü() verir: karışık hassasiyette normun float32 çıktısı ve onu
# çarpım için bf16'ya çeviren ayrı dönüşüm kalkar (PyTorch'ta torch.compile normu dönüşümle
# kaynaştırır; Flax'ta RMSNorm(dtype=...)). Hedef modelde 167 → 163 ms/adım, kayıplar aynı.
TR_struct TR_RMSNorm {
    TR_weight
    TR_eps = 0.00001
    TR_func TR_init(TR_embed_dim, TR_eps = 0.00001) {
        TR_self.TR_weight = TR_Tensor(TR_ones([TR_embed_dim]), TR_requires_grad: TR_true)
        TR_self.TR_eps = TR_eps
    }
    TR_func TR_forward(TR_x, TR_output_dtype = TR_none) {
        TR_if TR_output_dtype == TR_none { TR_return TR_rms_norm(TR_x, TR_self.TR_weight, TR_eps: TR_self.TR_eps) }
        TR_return TR_rms_norm(TR_x, TR_self.TR_weight, TR_eps: TR_self.TR_eps, TR_dtype: TR_output_dtype)
    }
}

# Döner konum gömmesi (RoPE): bakış vektörünün iki yarısı (a, b) her konumda konuma bağlı bir
# açıyla döndürülür; sorgu ile anahtarın iç çarpımı böylece yalnızca aradaki uzaklığa bağlı
# olur. döner_konum_tablosu [kosinüs, sinüs] verir, ikisi de [bağlam, bakış_boyutu / 2].
# Frekanslar taban^(-2i / bakış_boyutu). Tablolar türev izlemez (öğrenilmez).
TR_func TR_rotary_table(TR_context, TR_head_dim, TR_rope_theta = 10000.0) {
    TR_var yarım = TR_head_dim // 2
    TR_var frekanslar = [TR_rope_theta ** (-2.0 * i / TR_head_dim) TR_for i TR_in 0..yarım]
    TR_var konumlar = TR_Tensor([[t] TR_for t TR_in 0..TR_context]) # [bağlam, 1]
    TR_var açılar = konumlar @ TR_Tensor([frekanslar]) # [bağlam, yarım]
    TR_return [TR_cos(açılar), TR_sin(açılar)]
}

# döner_konum_hesapla x'i ([..., T, bakış, bakış_boyutu]; dikkat'in düzeni) tablonun ilk T satırıyla
# döndürür (bütün bakışlar aynı açıyla); sonuç
# x'in türündedir. Tablolar float32'dir: karışık hassasiyette bf16 x ile çarpım float32'ye
# yükselir, sonucu okuyan `dikkat` onu yine bf16'ya çevirirdi. Dönüşüm burada, kaynaşık
# geçişin sonunda yapılır: değer aynıdır (bir kez yuvarlanır), float32 sonuç ve ayrı dönüşüm
# kalkar. döner_konum_uygula aynı hesabın kaynaşmış biçimidir (kaynaştır, dil tanımı 15.44):
# zincir tek geçişte hesaplanır, ara sonuçlar belleğe yazılmaz; sonuç aynıdır.
TR_func TR_apply_rotary(TR_x, TR_cos_table, TR_sin_table) {
    TR_var T = TR_x.TR_shape[-3]
    TR_var a, b = TR_x.TR_split(2, TR_dim: -1)
    TR_var c = TR_cos_table[0..T].TR_reshape([T, 1, TR_cos_table.TR_shape[-1]])
    TR_var s = TR_sin_table[0..T].TR_reshape([T, 1, TR_sin_table.TR_shape[-1]])
    TR_return TR_concat([a * c - b * s, a * s + b * c], TR_dim: -1).TR_to_dtype(TR_x.TR_dtype)
}
TR_var TR_apply_rotary_fused = TR_fuse(TR_apply_rotary)

# NedenselDikkat: döner konumlu, nedensel çok bakışlı dikkat. Her konum yalnızca kendisine ve
# öncekilere bakar. kv_bakış_sayısı < bakış_sayısı gruplu sorgu dikkatidir (GQA): anahtar ve değer bakışları
# ardışık bakış gruplarınca paylaşılır, anahtar/değer katmanları küçülür. Hesap birleşik
# `dikkat` yerleşiğindedir (T×T puan matrisi tutulmaz).
# Seçenekler (varsayılanlar eski davranıştır):
#   pencere: w > 0 ise yerel dikkat; her konum yalnızca son w konuma (kendisi dahil) bakar
#            (`dikkat(..., pencere: w)`); 0 tam nedensel. Pencere katmanın özelliğidir:
#            yerel/genel katman düzeni, her bloğa kendi penceresi verilerek kurulur.
#   qk_normu: q ve k'ya bakış boyutunda RMS normu (q_norm, k_norm; döner konumdan ÖNCE).
#   birleşik_kv: anahtar ve değer tek `kv_katmanı` ([boyut, 2·kv_boyut], [K | V]) olur ve
#            `.böl(2)` ile ayrılır; Muon K ve V'yi birlikte dikleştirir. Aksi hâlde
#            anahtar_katmanı ve değer_katmanı ayrıdır (kv_katmanı yok'tur; birleşikte tersi).
#   epsilon: qk normlarının epsilon'u.
#   bakış_boyutu: bir bakışın boyutu; yok ise boyut / bakış_sayısı. Verilirse gizli boyuttan bağımsızdır
#            (Hugging Face `head_dim`; Qwen3-0.6B: gizli 1024, 16 bakış × 128): sorgu katmanı
#            [boyut, bakış_sayısı · bakış_boyutu], çıkış katmanı [bakış_sayısı · bakış_boyutu, boyut] olur. Döner konum
#            başı iki yarıya böldüğünden çift olmalıdır.
TR_struct TR_CausalAttention {
    TR_num_heads
    TR_num_kv_heads
    TR_head_dim
    TR_window
    TR_q_proj
    TR_k_proj
    TR_v_proj
    TR_kv_proj
    TR_q_norm
    TR_k_norm
    TR_o_proj
    TR_func TR_init(TR_embed_dim, TR_num_heads, TR_num_kv_heads = TR_none, TR_use_bias = TR_false, TR_init_std = 0.02, TR_output_init_std = 0.02, TR_seed = 1, TR_window = 0, TR_qk_norm = TR_false, TR_merged_kv = TR_false, TR_eps = 0.00001, TR_head_dim = TR_none, TR_weight_dtype = "float32") {
        TR_if TR_num_kv_heads == TR_none { TR_num_kv_heads = TR_num_heads }
        TR_if TR_head_dim == TR_none {
            TR_assert(TR_embed_dim % TR_num_heads == 0, TR_Message("H6900", TR_embed_dim, TR_num_heads))
            TR_head_dim = TR_embed_dim // TR_num_heads
        }
        TR_assert(TR_head_dim > 0 TR_and TR_head_dim % 2 == 0, TR_Message("H6901", TR_head_dim))
        TR_assert(TR_num_heads % TR_num_kv_heads == 0, TR_Message("H6902", TR_num_heads, TR_num_kv_heads))
        TR_assert(TR_window >= 0, TR_Message("H6903", TR_window))
        TR_self.TR_num_heads = TR_num_heads
        TR_self.TR_num_kv_heads = TR_num_kv_heads
        TR_self.TR_head_dim = TR_head_dim
        TR_self.TR_window = TR_window
        TR_var kv_boyut = TR_num_kv_heads * TR_head_dim
        TR_self.TR_q_proj = TR_Linear(TR_embed_dim, TR_num_heads * TR_head_dim, TR_use_bias: TR_use_bias, TR_init_std: TR_init_std, TR_seed: TR_seed, TR_dtype: TR_weight_dtype)
        TR_if TR_merged_kv {
            TR_self.TR_k_proj = TR_none
            TR_self.TR_v_proj = TR_none
            TR_self.TR_kv_proj = TR_Linear(TR_embed_dim, 2 * kv_boyut, TR_use_bias: TR_use_bias, TR_init_std: TR_init_std, TR_seed: TR_seed + 1, TR_dtype: TR_weight_dtype)
        } TR_else {
            TR_self.TR_k_proj = TR_Linear(TR_embed_dim, kv_boyut, TR_use_bias: TR_use_bias, TR_init_std: TR_init_std, TR_seed: TR_seed + 1, TR_dtype: TR_weight_dtype)
            TR_self.TR_v_proj = TR_Linear(TR_embed_dim, kv_boyut, TR_use_bias: TR_use_bias, TR_init_std: TR_init_std, TR_seed: TR_seed + 2, TR_dtype: TR_weight_dtype)
            TR_self.TR_kv_proj = TR_none
        }
        TR_self.TR_q_norm = TR_if TR_qk_norm { TR_RMSNorm(TR_self.TR_head_dim, TR_eps: TR_eps) } TR_else { TR_none }
        TR_self.TR_k_norm = TR_if TR_qk_norm { TR_RMSNorm(TR_self.TR_head_dim, TR_eps: TR_eps) } TR_else { TR_none }
        TR_self.TR_o_proj = TR_Linear(TR_num_heads * TR_head_dim, TR_embed_dim, TR_use_bias: TR_use_bias, TR_init_std: TR_output_init_std, TR_seed: TR_seed + 3, TR_dtype: TR_weight_dtype)
    }
    # x [B, T, D]; cos_tablosu/sin_tablosu döner_konum_tablosu'ndan (önbellekli çağrıda konumdan başlayan
    # satırlar). önbellek verilirse (KVÖnbellek) yeni anahtar ve değerler katman no'ya eklenir ve
    # sorgular önbellekteki bütün konumlara bakar (dikkat'te nedensellik sondan hizalıdır, 15.24).
    TR_func TR_forward(TR_x, TR_cos_table, TR_sin_table, TR_cache = TR_none, TR_layer_idx = 0) {
        TR_var B = TR_x.TR_shape[0]
        TR_var T = TR_x.TR_shape[1]
        TR_var k_ham = TR_none
        TR_var v_ham = TR_none
        TR_if TR_self.TR_kv_proj != TR_none {
            TR_var kv = TR_self.TR_kv_proj.TR_forward(TR_x).TR_split(2, TR_dim: -1) # [K | V]
            k_ham = kv[0]
            v_ham = kv[1]
        } TR_else {
            k_ham = TR_self.TR_k_proj.TR_forward(TR_x)
            v_ham = TR_self.TR_v_proj.TR_forward(TR_x)
        }
        # [B, T, bakış · bakış_boyutu] → [B, T, bakış, bakış_boyutu]: dikkat'in düzeni (dil tanımı 15.24),
        # bakışlar şekillendirmeyle ayrılır, kopya yoktur.
        TR_var q = TR_self.TR_q_proj.TR_forward(TR_x).TR_reshape([B, T, TR_self.TR_num_heads, TR_self.TR_head_dim])
        TR_var k = k_ham.TR_reshape([B, T, TR_self.TR_num_kv_heads, TR_self.TR_head_dim])
        TR_var v = v_ham.TR_reshape([B, T, TR_self.TR_num_kv_heads, TR_self.TR_head_dim])
        TR_if TR_self.TR_q_norm != TR_none {
            q = TR_self.TR_q_norm.TR_forward(q)
            k = TR_self.TR_k_norm.TR_forward(k)
        }
        q = TR_apply_rotary_fused(q, TR_cos_table, TR_sin_table)
        k = TR_apply_rotary_fused(k, TR_cos_table, TR_sin_table)
        TR_var y = TR_none
        TR_if TR_cache != TR_none TR_and TR_cache.TR_step_position != TR_none {
            # Cihaz adımı (GPT.tek_adım): konum cihazdadır, sorgu bütün tampona maskeyle bakar.
            TR_var kv = TR_cache.TR_append(TR_layer_idx, k, v)
            y = TR_attention(q, kv[0], kv[1], TR_causal: TR_false, TR_mask: TR_cache.TR_mask(TR_self.TR_window))
        } TR_else {
            TR_if TR_cache != TR_none {
                TR_var kv = TR_cache.TR_append(TR_layer_idx, k, v)
                k = kv[0]
                v = kv[1]
            }
            y = TR_attention(q, k, v, TR_causal: TR_true, TR_window: TR_self.TR_window) # [B, T, bakış, bakış_boyutu]
        }
        TR_return TR_self.TR_o_proj.TR_forward(y.TR_reshape([B, T, TR_self.TR_num_heads * TR_self.TR_head_dim]))
    }
}

# swiglu_ara_boyutu: SwiGLU'nun ara boyutu için yaygın seçim, 8/3 · boyut, 32'nin katına
# yukarı yuvarlanır (üç matrisli ileri besleme, 4 · boyut'luk iki matrisliyle aynı büyüklükte).
TR_func TR_swiglu_intermediate_dim(TR_embed_dim) {
    TR_return TR_Int(TR_ceil(8.0 * TR_embed_dim / 3.0 / 32.0)) * 32
}

# swiglu_kapısı: SwiGLU'nun kapısı silu(g) · u; birleşik [G | U] çıktısında g ve u yarılardır.
# İkisi de kaynaşmıştır (tek geçiş).
TR_func TR_swiglu_gate(TR_g_swiglu, TR_u) { TR_return TR_silu(TR_g_swiglu) * TR_u }
TR_func TR_swiglu_merged_gate(TR_gu) {
    TR_var g, u = TR_gu.TR_split(2, TR_dim: -1)
    TR_return TR_silu(g) * u
}
TR_var TR_swiglu_gate_fused = TR_fuse(TR_swiglu_gate)
TR_var TR_swiglu_merged_gate_fused = TR_fuse(TR_swiglu_merged_gate)

# SwiGLU: kapılı ileri besleme. aşağı(silu(kapı(x)) * yukarı(x)).
# birleşik: doğru ise kapı ve yukarı tek `kapı_yukarı` katmanıdır ([boyut, 2·ara], [G | U]) ve
# `.böl(2)` ile ayrılır (Muon ikisini birlikte dikleştirir); kapı ve yukarı o zaman yok'tur.
# sapmalı: bütün katmanların sapması (birleşikte kapı_yukarı'nın sapması [2·ara]).
TR_struct TR_SwiGLU {
    TR_gate_proj
    TR_up_proj
    TR_gate_up_proj
    TR_down_proj
    TR_func TR_init(TR_embed_dim, TR_intermediate_dim = TR_none, TR_use_bias = TR_false, TR_init_std = 0.02, TR_output_init_std = 0.02, TR_seed = 1, TR_merged = TR_false, TR_weight_dtype = "float32") {
        TR_if TR_intermediate_dim == TR_none { TR_intermediate_dim = TR_swiglu_intermediate_dim(TR_embed_dim) }
        TR_if TR_merged {
            TR_self.TR_gate_proj = TR_none
            TR_self.TR_up_proj = TR_none
            TR_self.TR_gate_up_proj = TR_Linear(TR_embed_dim, 2 * TR_intermediate_dim, TR_use_bias: TR_use_bias, TR_init_std: TR_init_std, TR_seed: TR_seed, TR_dtype: TR_weight_dtype)
        } TR_else {
            TR_self.TR_gate_proj = TR_Linear(TR_embed_dim, TR_intermediate_dim, TR_use_bias: TR_use_bias, TR_init_std: TR_init_std, TR_seed: TR_seed, TR_dtype: TR_weight_dtype)
            TR_self.TR_up_proj = TR_Linear(TR_embed_dim, TR_intermediate_dim, TR_use_bias: TR_use_bias, TR_init_std: TR_init_std, TR_seed: TR_seed + 1, TR_dtype: TR_weight_dtype)
            TR_self.TR_gate_up_proj = TR_none
        }
        TR_self.TR_down_proj = TR_Linear(TR_intermediate_dim, TR_embed_dim, TR_use_bias: TR_use_bias, TR_init_std: TR_output_init_std, TR_seed: TR_seed + 2, TR_dtype: TR_weight_dtype)
    }
    TR_func TR_forward(TR_x) {
        TR_if TR_self.TR_gate_up_proj != TR_none {
            TR_return TR_self.TR_down_proj.TR_forward(TR_swiglu_merged_gate_fused(TR_self.TR_gate_up_proj.TR_forward(TR_x)))
        }
        TR_return TR_self.TR_down_proj.TR_forward(TR_swiglu_gate_fused(TR_self.TR_gate_proj.TR_forward(TR_x), TR_self.TR_up_proj.TR_forward(TR_x)))
    }
}

# ple_gelu PLE'nin etkinleştirmesidir: tam (erf tabanlı) GELU, hedef modelin F.gelu'su gibi.
TR_func TR_ple_gelu(TR_x) { TR_return TR_gelu(TR_x, TR_approximate: TR_false) }

# ple_karışımı PLE bloğunun eleman bazlı zinciridir: GELU(kapı) ⊙ (bağlam + ölçek · satır) / √2
# (ölçek = √P); ple_karış onun kaynaşmış biçimidir. Sonuç kapının türündedir (karışık
# hassasiyette bf16): float32 tablo satırı zinciri float32'ye yükseltir, sonucu yalnızca
# izdüşüm çarpımı okur; dönüşüm kaynaşık geçişin sonunda yapılır (bkz. döner_konum_hesapla).
TR_func TR_ple_mix(TR_gate, TR_ple_context, TR_row, TR_scale) {
    TR_return (TR_ple_gelu(TR_gate) * ((TR_ple_context + TR_scale * TR_row) / TR_sqrt(2.0))).TR_to_dtype(TR_gate.TR_dtype)
}
TR_var TR_ple_mix_fused = TR_fuse(TR_ple_mix)

# PLEBağlamı: katman başına kelime gömmesinin (PLE, Gemma 3n) modele ortak bağlam yarısı.
# Gömme çıktısı x [B, T, D] tek matrisle [B, T, katman · P]'ye çevrilir, √D'ye bölünür,
# katman başına P'lik parçalara bölünür ve her parça ortak bir RMS normundan geçer:
#   bağlam_i = RMSNorm_P((x @ W_ctx) / √D)_i
# `ileri(x)` katman sayısı kadar [B, T, P] tensörlük bir liste verir; i. eleman i. bloğun
# PLEBloğu.ileri'sine girer. ağırlık_türü W_ctx'in türüdür (GPT'den iletilir).
TR_struct TR_PLEContext {
    TR_embed_dim
    TR_num_layers
    TR_ple_dim
    TR_context_proj
    TR_norm
    TR_func TR_init(TR_embed_dim, TR_num_layers, TR_ple_dim, TR_eps = 0.00001, TR_init_std = 0.02, TR_seed = 1, TR_weight_dtype = "float32") {
        TR_self.TR_embed_dim = TR_embed_dim
        TR_self.TR_num_layers = TR_num_layers
        TR_self.TR_ple_dim = TR_ple_dim
        TR_self.TR_context_proj = TR_Linear(TR_embed_dim, TR_num_layers * TR_ple_dim, TR_init_std: TR_init_std, TR_seed: TR_seed, TR_dtype: TR_weight_dtype)
        TR_self.TR_norm = TR_RMSNorm(TR_ple_dim, TR_eps: TR_eps)
    }
    TR_func TR_forward(TR_x) {
        TR_var h = TR_self.TR_context_proj.TR_forward(TR_x) / TR_sqrt(TR_self.TR_embed_dim)
        TR_return [TR_self.TR_norm.TR_forward(parça) TR_for parça TR_in h.TR_split(TR_self.TR_num_layers, TR_dim: -1)]
    }
}

# PLEBloğu: bir katmanın PLE yarısı (blok sonunda çalışır). Katmanın kendi tablosu
# ([dağarcık, P], N(0, std)) kelime kimliğiyle okunur ve ortak bağlamla karışır:
#   e = (bağlam_i + √P · tablo_i[kelime]) / √2
#   H ← H + RMSNorm_D(W_p · (GELU(W_g · H) ⊙ e))
# W_g (kapı) [D, P], W_p (izdüşüm) [P, D]; izdüşüm artık yola yazar, çıkış_std ile başlar.
# ağırlık_türü tablonun ve iki matrisin türüdür (GPT'den iletilir).
TR_struct TR_PLEBlock {
    TR_ple_dim
    TR_table
    TR_gate_proj
    TR_proj
    TR_norm
    TR_func TR_init(TR_embed_dim, TR_vocab_size, TR_ple_dim, TR_eps = 0.00001, TR_init_std = 0.02, TR_output_init_std = 0.02, TR_seed = 1, TR_weight_dtype = "float32") {
        TR_self.TR_ple_dim = TR_ple_dim
        TR_self.TR_table = TR_init_weight([TR_vocab_size, TR_ple_dim], TR_init_std, TR_seed, TR_weight_dtype)
        TR_self.TR_gate_proj = TR_Linear(TR_embed_dim, TR_ple_dim, TR_init_std: TR_init_std, TR_seed: TR_seed + 1, TR_dtype: TR_weight_dtype)
        TR_self.TR_proj = TR_Linear(TR_ple_dim, TR_embed_dim, TR_init_std: TR_output_init_std, TR_seed: TR_seed + 2, TR_dtype: TR_weight_dtype)
        TR_self.TR_norm = TR_RMSNorm(TR_embed_dim, TR_eps: TR_eps)
    }
    # h [B, T, D]; kimlikler [B, T]; bağlam bu katmanın PLEBağlamı çıktısı [B, T, P].
    TR_func TR_forward(TR_h, TR_token_ids, TR_ple_context) {
        TR_var karışım = TR_ple_mix_fused(TR_self.TR_gate_proj.TR_forward(TR_h), TR_ple_context, TR_embedding_lookup(TR_self.TR_table, TR_token_ids), TR_sqrt(TR_self.TR_ple_dim))
        TR_return TR_h + TR_self.TR_norm.TR_forward(TR_self.TR_proj.TR_forward(karışım))
    }
}

# TransformerBloğu (ön-norm): x + dikkat(norm(x)), ardından x + ileri_besleme(norm(x)); ple_boyutu
# verilirse blok sonunda PLEBloğu'nun katkısı eklenir.
# Seçenekler (varsayılanlar eski davranıştır):
#   epsilon: blok içindeki bütün RMS normlarının (norm1, norm2, qk normları, PLE normu) epsilon'u.
#   pencere, qk_normu, birleşik_kv: NedenselDikkat'e iletilir (katman başına farklı pencere).
#   sapmalı: dikkat katmanlarının sapması; ileri_sapmalı: SwiGLU'nun sapması.
#   birleşik_kapı: SwiGLU'da [G | U] tek matris.
#   ple_boyutu (P) ve dağarcık: PLE için ikisi de verilmeli; yoksa blokta PLE yoktur (ple = yok).
# ileri(x, cos_tablosu, sin_tablosu, kimlikler, bağlam): kimlikler ve bağlam yalnızca PLE varken kullanılır.
TR_struct TR_TransformerBlock {
    TR_input_norm
    TR_attention
    TR_post_attention_norm
    TR_feed_forward
    TR_ple
    TR_func TR_init(TR_embed_dim, TR_num_heads, TR_num_kv_heads = TR_none, TR_intermediate_dim = TR_none, TR_init_std = 0.02, TR_output_init_std = 0.02, TR_seed = 1, TR_eps = 0.00001, TR_window = 0, TR_qk_norm = TR_false, TR_merged_kv = TR_false, TR_use_bias = TR_false, TR_ff_use_bias = TR_false, TR_merged_gate = TR_false, TR_ple_dim = TR_none, TR_vocab_size = TR_none, TR_head_dim = TR_none, TR_weight_dtype = "float32") {
        TR_self.TR_input_norm = TR_RMSNorm(TR_embed_dim, TR_eps: TR_eps)
        TR_self.TR_attention = TR_CausalAttention(TR_embed_dim, TR_num_heads, TR_num_kv_heads: TR_num_kv_heads, TR_use_bias: TR_use_bias, TR_init_std: TR_init_std, TR_output_init_std: TR_output_init_std, TR_seed: TR_seed, TR_window: TR_window, TR_qk_norm: TR_qk_norm, TR_merged_kv: TR_merged_kv, TR_eps: TR_eps, TR_head_dim: TR_head_dim, TR_weight_dtype: TR_weight_dtype)
        TR_self.TR_post_attention_norm = TR_RMSNorm(TR_embed_dim, TR_eps: TR_eps)
        TR_self.TR_feed_forward = TR_SwiGLU(TR_embed_dim, TR_intermediate_dim: TR_intermediate_dim, TR_use_bias: TR_ff_use_bias, TR_init_std: TR_init_std, TR_output_init_std: TR_output_init_std, TR_seed: TR_seed + 10, TR_merged: TR_merged_gate, TR_weight_dtype: TR_weight_dtype)
        TR_if TR_ple_dim != TR_none {
            TR_assert(TR_vocab_size != TR_none, TR_Message("H6904"))
            TR_self.TR_ple = TR_PLEBlock(TR_embed_dim, TR_vocab_size, TR_ple_dim, TR_eps: TR_eps, TR_init_std: TR_init_std, TR_output_init_std: TR_output_init_std, TR_seed: TR_seed + 20, TR_weight_dtype: TR_weight_dtype)
        } TR_else {
            TR_self.TR_ple = TR_none
        }
    }
    TR_func TR_forward(TR_x, TR_cos_table, TR_sin_table, TR_token_ids = TR_none, TR_ple_context = TR_none, TR_cache = TR_none, TR_layer_idx = 0) {
        # Norm çıktılarını yalnızca dikkatin ve ileri beslemenin ilk çarpımları okur.
        TR_var h = TR_x + TR_self.TR_attention.TR_forward(TR_self.TR_input_norm.TR_forward(TR_x, TR_output_dtype: TR_compute_dtype()), TR_cos_table, TR_sin_table, TR_cache: TR_cache, TR_layer_idx: TR_layer_idx)
        h = h + TR_self.TR_feed_forward.TR_forward(TR_self.TR_post_attention_norm.TR_forward(h, TR_output_dtype: TR_compute_dtype()))
        TR_if TR_self.TR_ple != TR_none { TR_return TR_self.TR_ple.TR_forward(h, TR_token_ids, TR_ple_context) }
        TR_return h
    }
}

# katman_pencereleri "YYGYGYYG" gibi bir düzen metninden katman başına pencere listesi kurar:
# G (genel) katman 0 (tam nedensel); Y (yerel) katmanlar `pencereler`i sırayla (döngüyle) alır.
# katman_pencereleri("YYGYGYYG", [32, 64]) → [32, 64, 0, 32, 0, 64, 32, 0]
TR_func TR_layer_windows(TR_layout, TR_windows) {
    TR_var liste = []
    TR_var y = 0
    TR_for harf TR_in TR_layout {
        TR_assert(harf == "Y" TR_or harf == "G", TR_Message("H6905", harf))
        TR_if harf == "G" {
            liste.TR_append(0)
        } TR_else {
            liste.TR_append(TR_windows[y % TR_windows.TR_length])
            y += 1
        }
    }
    TR_return liste
}

# KVÖnbellek: üretimde (çıkarımda) katmanların döner konumlu anahtar ve değerlerini tutar; her
# yeni parçada yalnızca o parça hesaplanır, öncekilerin anahtarları önbellekten okunur. Önbellek
# türev izlemez (çıkarım içindir). İki çeşidi vardır (transformers DynamicCache ve StaticCache gibi):
#   "sabit"   : her katman için [B, en_çok, kv_bakış, bakış_boyutu] tampon ilk yazmada bir kez
#               ayrılır; yeni anahtarlar zaman ekseninde yerine yazılır (gpt-fast, FlashAttention
#               kv önbelleği gibi), dikkat tamponun dolu kısmını görünüm olarak okur.
#   "büyüyen" : her adımda yeni anahtarlar bitiştir ile eklenir; bellek yalnızca kullanılan kadar.
# Düzen [B, T, kv_bakış, bakış_boyutu]: dikkat'in beklediği düzen (FlashAttention'ın kv önbelleği
# gibi), GQA'da kv bakışları çoğaltılmaz. konum önbellekteki parça sayısıdır (sonraki parçanın konumu).
# kırp(n) son parçaları geri alır (ör. reddedilen taslak); sabitte yazılı veri kalır ama okunmaz.
# Cihaz adımı (yalnızca sabit; GPT.tek_adım, tekrar_oynat ile kaydedilen üretim adımı):
# cihaz_adımı(konum) ile konum cihazdaki bir tensör olur ([1]); ekle yeni anahtarları o konuma
# yazar (yerine_yaz) ve bütün tamponu verir, maske(pencere) bakılacak konumları seçer (0/1:
# konum ve öncesi, pencere varsa son pencere kadarı). Kaydedilen adım konakta durum
# değiştirmez: konum sayacını çağıran ilerletir. Sabit boylu tampon ve cihazdaki konum
# transformers'ın sabit önbelleğiyle (cache_position) aynı yoldur.
TR_struct TR_KVCache {
    TR_kind
    TR_capacity
    TR_position
    TR_k_buffers
    TR_v_buffers
    TR_step_position
    TR_positions
    TR_masks
    TR_func TR_init(TR_num_layers, TR_kind = "sabit", TR_capacity = 0) {
        TR_assert(TR_kind == "sabit" TR_or TR_kind == "büyüyen", TR_Message("H6906", TR_kind))
        TR_assert(TR_kind != "sabit" TR_or TR_capacity > 0, TR_Message("H6907", TR_capacity))
        TR_self.TR_kind = TR_kind
        TR_self.TR_capacity = TR_capacity
        TR_self.TR_position = 0
        TR_self.TR_k_buffers = [TR_none TR_for _ TR_in 0..TR_num_layers]
        TR_self.TR_v_buffers = [TR_none TR_for _ TR_in 0..TR_num_layers]
        TR_self.TR_step_position = TR_none
        TR_self.TR_positions = TR_none
        TR_self.TR_masks = {}
    }
    # cihaz_adımı: sonraki ekle'ler konumu (cihazdaki [1] tensörü; yok: konak konumu) kullanır.
    TR_func TR_device_step(TR_position) {
        TR_assert(TR_position == TR_none TR_or TR_self.TR_kind == "sabit", TR_Message("H6908"))
        TR_self.TR_step_position = TR_position
        TR_self.TR_masks = {}
    }
    # maske: cihaz adımında bakılacak konumlar ([en_çok], 0/1); pencere başına adımda bir kez
    # kurulur, aynı pencereli katmanlar paylaşır.
    TR_func TR_mask(TR_window = 0) {
        TR_var anahtar = "\(TR_window)"
        TR_if TR_not TR_self.TR_masks.TR_contains(anahtar) {
            TR_var m = TR_self.TR_positions <= TR_self.TR_step_position
            TR_if TR_window > 0 { m = m * (TR_self.TR_positions > TR_self.TR_step_position - TR_window) }
            TR_self.TR_masks[anahtar] = m
        }
        TR_return TR_self.TR_masks[anahtar]
    }
    # ekle: katman no'nun yeni anahtar ve değerlerini ([B, T, kv_bakış, bakış_boyutu]) konumdan
    # başlayarak ekler; o katmanın 0..konum+T anahtar ve değerlerini verir.
    TR_func TR_append(TR_layer_idx, TR_k, TR_v) {
        TR_var son = TR_self.TR_position + TR_k.TR_shape[1]
        TR_if TR_self.TR_kind == "sabit" TR_and TR_self.TR_step_position == TR_none {
            TR_if son > TR_self.TR_capacity { TR_throw TR_Message("H6909", son, TR_self.TR_capacity) }
            TR_if TR_self.TR_k_buffers[TR_layer_idx] == TR_none TR_and TR_self.TR_positions == TR_none {
                TR_self.TR_positions = TR_Tensor([i * 1.0 TR_for i TR_in 0..TR_self.TR_capacity]).TR_to_device(TR_k.TR_device)
            }
        }
        TR_return [TR_self.TR_append_buffer(TR_self.TR_k_buffers, TR_layer_idx, TR_k, son), TR_self.TR_append_buffer(TR_self.TR_v_buffers, TR_layer_idx, TR_v, son)]
    }
    # tampon_ekle: anahtar ya da değer tamponları listesinde (liste) katman no'nun tamponuna yeni
    # parçayı çeşide göre ekler ve katmanın görünür kısmını verir: büyüyen bitiştirir, cihaz adımında
    # yerine yazar, sabit tamponu ilk kullanımda ayırıp konumdan başlayarak dilime yazar.
    TR_func TR_append_buffer(TR_buffers, TR_layer_idx, TR_new_chunk, TR_end) {
        TR_if TR_self.TR_kind == "büyüyen" {
            TR_if TR_buffers[TR_layer_idx] == TR_none {
                TR_buffers[TR_layer_idx] = TR_new_chunk
            } TR_else {
                TR_buffers[TR_layer_idx] = TR_concat([TR_buffers[TR_layer_idx].TR_slice(1, 0, TR_self.TR_position), TR_new_chunk], TR_dim: 1)
            }
            TR_return TR_buffers[TR_layer_idx]
        }
        TR_if TR_self.TR_step_position != TR_none {
            TR_write_slice(TR_buffers[TR_layer_idx], TR_new_chunk, TR_dim: 1, TR_start: TR_self.TR_step_position[0])
            TR_return TR_buffers[TR_layer_idx]
        }
        TR_if TR_buffers[TR_layer_idx] == TR_none {
            TR_buffers[TR_layer_idx] = TR_zeros([TR_new_chunk.TR_shape[0], TR_self.TR_capacity, TR_new_chunk.TR_shape[2], TR_new_chunk.TR_shape[3]], TR_dtype: TR_new_chunk.TR_dtype).TR_to_device(TR_new_chunk.TR_device)
        }
        TR_buffers[TR_layer_idx].TR_slice(1, TR_self.TR_position, TR_end)[0..TR_new_chunk.TR_shape[0]] = TR_new_chunk
        TR_return TR_buffers[TR_layer_idx].TR_slice(1, 0, TR_end)
    }
    # ilerle: bir ileri hesabın T parçası bütün katmanlara yazıldıktan sonra konumu ilerletir.
    TR_func TR_advance(TR_T) { TR_self.TR_position = TR_self.TR_position + TR_T }
    # kırp: önbelleği ilk n parçaya indirir (n ≤ konum).
    TR_func TR_truncate(TR_n) {
        TR_assert(TR_n >= 0 TR_and TR_n <= TR_self.TR_position, TR_Message("H6910", TR_self.TR_position, TR_n))
        TR_self.TR_position = TR_n
    }
}

# GPT: yalnızca kod çözücülü dil modeli. gömme → katman sayısı kadar blok → son norm →
# dağarcık üzerinde logit. paylaşımlı: doğru ise çıkış katmanı gömme tablosunu kullanır
# (logit = h @ tablo.devrik(); ayrı çıkış ağırlığı yoktur).
# Ayarlar: dağarcık (parça sayısı), bağlam (en uzun dizi), boyut, katman, bakış_sayısı, kv_bakış_sayısı (yok:
# bakış_sayısı ile aynı), ara_boyut (yok: swiglu_ara_boyutu), paylaşımlı, tohum.
# Blok seçenekleri (varsayılanlar eski modeli verir; ayrıntı TransformerBloğu'nda):
#   pencereler: katman başına pencere listesi (uzunluğu katman; 0 = genel, yok = hepsi genel);
#               yerel/genel düzen katman_pencereleri("YYGYGYYG", [32, 64]) ile kurulur.
#   qk_normu, birleşik_kv, birleşik_kapı, ileri_sapmalı, epsilon, bakış_boyutu: her bloğa iletilir
#               (bakış_boyutu döner konum tablolarının da boyudur; yok ise boyut / bakış_sayısı).
#   rope_tabanı: döner konumun frekans tabanı (Hugging Face rope_theta; Llama 2 10000, SmolLM2
#               100000, Qwen3 1000000).
#   ağırlık_türü: matris ağırlıklarının (gömme tablosu ve doğrusal katmanlar) türü; normlar float32
#               kalır, etkinleşmeler hesap türündedir (karışık hassasiyet dışında float32).
#               "bf16" hazır modellerin saklandığı türdür: çıkarımda GPU okunan baytı yarıya indirir.
#   ple_boyutu: verilirse her blokta PLE vardır; modelde ortak PLEBağlamı (`ple_bağlamı`) gömme
#               çıktısından katman başına bağlamı üretir ve i. bloğa i. parçayı verir.
# RGN-512 gibi bir model bu yapıyla tek çağrıdır:
#   GPT(40000, bağlam: 1024, boyut: 512, katman: 8, bakış_sayısı: 8, kv_bakış_sayısı: 4, ara_boyut: 672, paylaşımlı: doğru,
#       pencereler: katman_pencereleri("YYGYGYYG", [32, 64]), qk_normu: doğru, birleşik_kv: doğru,
#       birleşik_kapı: doğru, ileri_sapmalı: doğru, epsilon: 0.000001, ple_boyutu: 512)
# Neden GPT'ye seçenek, ayrı bir model yapısı değil: gömme → bloklar → norm → logit iskeleti,
# başlatma kuralı ve `üret` aynıdır; fark yalnızca blok ayarıdır, bir kopya ikinci bakım yükü olurdu.
TR_struct TR_GPT {
    TR_config
    TR_embedding
    TR_blocks
    TR_final_norm
    TR_logit_layer
    TR_ple_context
    TR_cos_table
    TR_sin_table
    TR_func TR_init(TR_vocab_size, TR_context = 256, TR_embed_dim = 256, TR_num_layers = 4, TR_num_heads = 4, TR_num_kv_heads = TR_none, TR_intermediate_dim = TR_none, TR_tied = TR_false, TR_seed = 1, TR_windows = TR_none, TR_qk_norm = TR_false, TR_merged_kv = TR_false, TR_merged_gate = TR_false, TR_ff_use_bias = TR_false, TR_eps = 0.00001, TR_ple_dim = TR_none, TR_head_dim = TR_none, TR_rope_theta = 10000.0, TR_weight_dtype = "float32") {
        TR_self.TR_config = {"dağarcık": TR_vocab_size, "bağlam": TR_context, "embed_dim": TR_embed_dim, "katman": TR_num_layers, "num_heads": TR_num_heads, "head_dim": TR_head_dim,
            "num_kv_heads": TR_num_kv_heads, "ara_boyut": TR_intermediate_dim, "paylaşımlı": TR_tied, "tohum": TR_seed,
            "pencereler": TR_windows, "qk_normu": TR_qk_norm, "birleşik_kv": TR_merged_kv, "birleşik_kapı": TR_merged_gate,
            "ileri_sapmalı": TR_ff_use_bias, "eps": TR_eps, "ple_dim": TR_ple_dim, "rope_tabanı": TR_rope_theta, "ağırlık_türü": TR_weight_dtype}
        TR_if TR_windows != TR_none {
            TR_assert(TR_windows.TR_length == TR_num_layers, TR_Message("H6911", TR_windows.TR_length, TR_num_layers))
        }
        TR_var std = 0.02
        TR_var çıkış_std = std / TR_sqrt(2 * TR_num_layers)
        TR_self.TR_embedding = TR_Embedding(TR_vocab_size, TR_embed_dim, TR_init_std: std, TR_seed: TR_seed, TR_dtype: TR_weight_dtype)
        TR_self.TR_blocks = []
        TR_for i TR_in 0..TR_num_layers {
            TR_self.TR_blocks.TR_append(TR_TransformerBlock(TR_embed_dim, TR_num_heads, TR_num_kv_heads: TR_num_kv_heads, TR_intermediate_dim: TR_intermediate_dim,
                TR_init_std: std, TR_output_init_std: çıkış_std, TR_seed: TR_seed + 100 * (i + 1), TR_eps: TR_eps,
                TR_window: TR_if TR_windows == TR_none { 0 } TR_else { TR_windows[i] }, TR_qk_norm: TR_qk_norm,
                TR_merged_kv: TR_merged_kv, TR_merged_gate: TR_merged_gate, TR_ff_use_bias: TR_ff_use_bias,
                TR_ple_dim: TR_ple_dim, TR_vocab_size: TR_vocab_size, TR_head_dim: TR_head_dim, TR_weight_dtype: TR_weight_dtype))
        }
        TR_self.TR_final_norm = TR_RMSNorm(TR_embed_dim, TR_eps: TR_eps)
        TR_self.TR_logit_layer = TR_if TR_tied { TR_none } TR_else { TR_Linear(TR_embed_dim, TR_vocab_size, TR_init_std: std, TR_seed: TR_seed + 1, TR_dtype: TR_weight_dtype) }
        TR_self.TR_ple_context = TR_if TR_ple_dim == TR_none { TR_none } TR_else { TR_PLEContext(TR_embed_dim, TR_num_layers, TR_ple_dim, TR_eps: TR_eps, TR_init_std: std, TR_seed: TR_seed + 2, TR_weight_dtype: TR_weight_dtype) }
        TR_var tablolar = TR_rotary_table(TR_context, TR_if TR_head_dim == TR_none { TR_embed_dim // TR_num_heads } TR_else { TR_head_dim }, TR_rope_theta: TR_rope_theta)
        TR_self.TR_cos_table = tablolar[0]
        TR_self.TR_sin_table = tablolar[1]
    }
    # gömülü: kimlikleri gömer; (x, bağlamlar) demetini verir (bağlamlar: katman başına PLE bağlamı ya da yok).
    TR_func TR_embed(TR_token_ids) {
        TR_var x = TR_self.TR_embedding.TR_forward(TR_token_ids)
        TR_return x, TR_if TR_self.TR_ple_context == TR_none { TR_none } TR_else { TR_self.TR_ple_context.TR_forward(x) }
    }
    # blokları_işle: x'i bloklardan sırayla geçirir (gizli_durum ve tek_adım ortak gövdesi).
    TR_func TR_run_blocks(TR_x, TR_ple_contexts, TR_cos_table, TR_sin_table, TR_token_ids, TR_cache) {
        TR_for i, blok TR_in TR_self.TR_blocks {
            TR_x = blok.TR_forward(TR_x, TR_cos_table, TR_sin_table, TR_token_ids, TR_if TR_ple_contexts == TR_none { TR_none } TR_else { TR_ple_contexts[i] }, TR_cache: TR_cache, TR_layer_idx: i)
        }
        TR_return TR_x
    }
    # gizli_durum: kimlikler [B, T] → son normdan geçmiş gizli durum [B, T, boyut]; karışık
    # hassasiyette hesap türünde (çıkış çarpımı için).
    # önbellek verilirse (KVÖnbellek) kimlikler önbellekteki konumdan devam eder: döner konum
    # tabloları o konumdan dilimlenir, anahtar ve değerler önbelleğe eklenir, konum ilerler.
    TR_func TR_hidden_states(TR_token_ids, TR_cache = TR_none) {
        TR_var x, bağlamlar = TR_self.TR_embed(TR_token_ids)
        TR_var cos_tablosu = TR_self.TR_cos_table
        TR_var sin_tablosu = TR_self.TR_sin_table
        TR_var T = x.TR_shape[1]
        TR_if TR_cache != TR_none {
            TR_var baş = TR_cache.TR_position
            TR_assert(baş + T <= TR_self.TR_config["bağlam"], TR_Message("H6912", baş + T, TR_self.TR_config["bağlam"]))
            cos_tablosu = cos_tablosu.TR_slice(0, baş, baş + T)
            sin_tablosu = sin_tablosu.TR_slice(0, baş, baş + T)
        }
        x = TR_self.TR_run_blocks(x, bağlamlar, cos_tablosu, sin_tablosu, TR_token_ids, TR_cache)
        TR_if TR_cache != TR_none { TR_cache.TR_advance(T) }
        # Gizli durumu yalnızca çıkış çarpımı (ya da doğrusal_çapraz_entropi) okur.
        TR_return TR_self.TR_final_norm.TR_forward(x, TR_output_dtype: TR_compute_dtype())
    }
    # tek_adım: bir parçalık üretim adımı, konum cihazdadır: kimlik [1, 1] ve konum [1]
    # tensörleri → son konumun logiti [dağarcık]. Konakta hiçbir şey değiştirmez (önbelleğin
    # konum sayacını çağıran ilerletir); bu yüzden tekrar_oynat ile kaydedilip oynatılabilir
    # (dil tanımı 15.45). Önbellek sabit olmalı ve ilk parçalar gizli_durum ile işlenmiş olmalı.
    TR_func TR_single_step(TR_token_id, TR_position, TR_cache) {
        TR_var gömülü, bağlamlar = TR_self.TR_embed(TR_token_id)
        TR_var cos_tablosu = TR_embedding_lookup(TR_self.TR_cos_table, TR_position)
        TR_var sin_tablosu = TR_embedding_lookup(TR_self.TR_sin_table, TR_position)
        TR_cache.TR_device_step(TR_position)
        TR_var x = TR_self.TR_run_blocks(gömülü, bağlamlar, cos_tablosu, sin_tablosu, TR_token_id, TR_cache)
        TR_cache.TR_device_step(TR_none)
        TR_return TR_self.TR_logits(TR_self.TR_final_norm.TR_forward(x, TR_output_dtype: TR_compute_dtype()))[0][0]
    }
    # kimlikler [B, T] (T ≤ bağlam) → logit [B, T, dağarcık]; önbellek: gizli_durum.
    TR_func TR_forward(TR_token_ids, TR_cache = TR_none) {
        TR_return TR_self.TR_logits(TR_self.TR_hidden_states(TR_token_ids, TR_cache: TR_cache))
    }
    # logit: gizli durumu ([B, T, boyut]) sözlüğe çevirir (paylaşımlı gömmede tablonun devriği).
    TR_func TR_logits(TR_x) {
        TR_if TR_self.TR_logit_layer == TR_none { TR_return TR_x @ TR_self.TR_embedding.TR_table.TR_transpose() }
        TR_return TR_self.TR_logit_layer.TR_forward(TR_x)
    }
    # kayıp: bir sonraki parçayı tahmin etmenin ortalama çapraz entropisi. Çıkış sapmasızsa
    # (paylaşımlı gömme ya da sapmasız Doğrusal) logitler bütün olarak tutulmaz:
    # doğrusal_çapraz_entropi aynı kaybı dilim dilim hesaplar (dil tanımı 15.25).
    TR_func TR_loss(TR_token_ids, TR_targets) {
        TR_if TR_self.TR_logit_layer == TR_none {
            TR_return TR_linear_cross_entropy(TR_self.TR_hidden_states(TR_token_ids), TR_self.TR_embedding.TR_table.TR_transpose(), TR_targets)
        }
        TR_if TR_self.TR_logit_layer.TR_bias == TR_none {
            TR_return TR_linear_cross_entropy(TR_self.TR_hidden_states(TR_token_ids), TR_self.TR_logit_layer.TR_weight, TR_targets)
        }
        TR_return TR_cross_entropy(TR_self.TR_forward(TR_token_ids), TR_targets)
    }
    # önbellek_kur: bu modelin katman sayısında bir KVÖnbellek ("sabit" ya da "büyüyen"); sabit
    # önbellek en_çok konum tutar (verilmezse bağlam).
    TR_func TR_build_cache(TR_kind = "sabit", TR_capacity = TR_none) {
        TR_return TR_KVCache(TR_self.TR_blocks.TR_length, TR_kind: TR_kind, TR_capacity: TR_if TR_capacity == TR_none { TR_self.TR_config["bağlam"] } TR_else { TR_capacity })
    }
    # üret: başlangıç kimliklerinin (liste) ardına adet kadar parça örnekler ve bütün listeyi
    # verir. sıcaklık 0 en olasıyı seçer; tohum verilirse sonuç tekrarlanır. eos verilirse (bir
    # parça kimliği) o parça örneklenince eklenir ve üretim durur (adetten önce). Model
    # bağlamdan uzun diziyi görmez: son `bağlam` parça kullanılır. önbellek_çeşidi: "sabit"
    # (varsayılan) ya da "büyüyen" KV önbelleği; ilk adım başlangıcı bir kez işler, sonraki
    # adımlar yalnızca yeni parçayı. Dizi bağlamı doldurunca son `bağlam` parça yeniden işlenir
    # (konumlar kaydığı için önbellek baştan kurulur). önbellek_çeşidi: yok her parçada bütün diziyi
    # yeniden hesaplar. Sonuç önbellekli ve önbelleksiz aynıdır (float32 yuvarlama düzeyinde).
    # Yalnızca son konumun logiti hesaplanır (transformers generate'in logits_to_keep'i gibi).
    # çizge: doğru (varsayılan) ise GPU'da sabit önbellekle her adım tek_adım'dır ve
    # tekrar_oynat ile kaydedilip oynatılır (kernel başlatmalarının konak yükü kalkar); sonuç
    # kayıtsızla aynı parçalardır. Sabit önbellek en çok başlangıç + adet konum tutar.
    TR_func TR_generate(TR_prompt, TR_max_new_tokens, TR_temperature = 1.0, TR_top_k = 0, TR_seed = TR_none, TR_eos = TR_none, TR_cache_kind = "sabit", TR_cuda_graph = TR_true) {
        TR_var kimlikler = [k TR_for k TR_in TR_prompt]
        TR_var bağlam = TR_self.TR_config["bağlam"]
        TR_var ö = TR_none
        TR_var adım = TR_none
        TR_var cihaz = TR_self.TR_embedding.TR_table.TR_device
        TR_var oynat = TR_cuda_graph TR_and TR_cache_kind == "sabit" TR_and cihaz != "cpu"
        TR_no_grad {
            TR_for i TR_in 0..TR_max_new_tokens {
                TR_var x = TR_none
                TR_var son = TR_none
                TR_if TR_cache_kind == TR_none {
                    TR_var bas = TR_max(0, kimlikler.TR_length - bağlam)
                    x = TR_self.TR_hidden_states([kimlikler[bas..kimlikler.TR_length]])
                } TR_else TR_if ö == TR_none TR_or ö.TR_position >= ö.TR_capacity {
                    # İlk adım ya da önbellek doldu: son `bağlam` parça baştan işlenir.
                    ö = TR_self.TR_build_cache(TR_kind: TR_cache_kind, TR_capacity: TR_min(bağlam, kimlikler.TR_length + TR_max_new_tokens - i))
                    adım = TR_none # yeni önbellek: yeni kayıt
                    TR_var bas = TR_max(0, kimlikler.TR_length - bağlam)
                    x = TR_self.TR_hidden_states([kimlikler[bas..kimlikler.TR_length]], TR_cache: ö)
                } TR_else TR_if oynat {
                    TR_if adım == TR_none {
                        TR_var öö = ö
                        adım = TR_replay((kimlik, konum) => TR_self.TR_single_step(kimlik, konum, öö))
                    }
                    son = adım(TR_Tensor([[kimlikler[-1] * 1.0]]).TR_to_device(cihaz), TR_Tensor([ö.TR_position * 1.0]).TR_to_device(cihaz))
                    ö.TR_advance(1)
                } TR_else {
                    x = TR_self.TR_hidden_states([[kimlikler[-1]]], TR_cache: ö)
                }
                TR_if son == TR_none {
                    TR_var T = x.TR_shape[1]
                    son = TR_self.TR_logits(x.TR_slice(1, T - 1, T))[0][0]
                }
                TR_var t = TR_if TR_seed == TR_none { TR_none } TR_else { TR_seed + i }
                TR_var yeni = TR_sample(son, TR_temperature: TR_temperature, TR_top_k: TR_top_k, TR_seed: t).TR_tolist
                kimlikler.TR_append(yeni)
                TR_if TR_eos != TR_none TR_and yeni == TR_eos { TR_break }
            }
        }
        TR_return kimlikler
    }
}
