# TR 4
# tr/whisper: yayımlanmış bir Whisper modelini Hugging Face biçimindeki klasöründen açar (dil tanımı 25).
#
# Kullanım:   aktar "tr/audio"
#             aktar "tr/whisper"
#             değişken model = hazır_whisper("whisper-tiny")
#             değişken yazı = model.yazıya_çevir(wav_oku("soru.wav"), dil: "tr")
#
# Mimari özgün `whisper/model.py`'dir: kodlayıcı iki evrişim, GELU ve öğrenilmiş konumdan sonra ön-norm
# bloklardan geçer; çözücü aynı bloklara çapraz dikkat ekler, K ve V önbellektedir. Ağırlık adları Hugging Face'indir; K izdüşümünün sapması yoktur. Doğrusal katmanın
# ağırlığı dosyada [çıkış, giriş], TR'nin Doğrusal'ında [giriş, çıkış]'tır: devrilir (lib/README.md).
# Her tensörün adı ve şekli ayardan hesaplanır: dosyada kalan ya da eksik ad hatadır (25.1).
# Çevirme özgün `transcribe`'ı izler: `temperature=0.0`, `beam_size=None`, `fp16=False` (25.2–25.8).

TR_import "tr/audio"
TR_import "tr/layers"
TR_import "tr/pretrained"

TR_const _AYAR = "config.json"
TR_const _ÜRETİM = "generation_config.json"
TR_const _AĞIRLIK = "model.safetensors"
TR_const _PARÇALAYICI = "tokenizer.json"
TR_const _ÖRNEK_HIZI = 16000
TR_const _ADIM = 160 # çerçeve başına örnek
TR_const _DAMGA_SÜRESİ = 0.02 # damga başına saniye
TR_const _DAMGA_ÇERÇEVESİ = 2 # damga başına çerçeve
TR_const _İLK_DAMGA = 50 # ilk damga en çok <|1.00|>
TR_const _DOLGU = 3000 # log-Mel'in sondaki çerçeveleri (23.6)
TR_const _SESSİZLİK = 0.6
TR_const _LOG_OLASILIK = -1.0

# Bir kesit (25.2): başı ve sonu kaydın başına göre saniyedir.
TR_struct TR_Segment {
    TR_start: TR_Float
    TR_end: TR_Float
    TR_text: TR_String
    _parçalar: TR_List[TR_Int]
}

# Çevirinin sonucu (25.2).
TR_struct TR_Transcription {
    TR_text: TR_String
    TR_segments: TR_List[TR_Segment]
    TR_language: TR_String
}

# Kesit ve parçaları: silinen kesitin parçaları sonraki pencerenin bağlamına girmez (25.7).
TR_struct _Ham {
    baş: TR_Float
    son: TR_Float
    parçalar: TR_List[TR_Int]
}

# Bir pencerenin kesitleri ve pencere başının ilerleyeceği çerçeve sayısı.
TR_struct _Bölüm {
    kesitler: TR_List[_Ham]
    ilerleme: TR_Int
}

# Bir pencerenin çözümü: metin sonu hariç parçalar, ortalama log-olasılık, sessizlik olasılığı.
TR_struct _Sonuç {
    parçalar: TR_List[TR_Int]
    ortalama: TR_Float
    sessizlik: TR_Float
}

# _kapat l[baş..son]'u -sonsuz yapar: `t[i] = d` tensörde yoktur (H7042).
TR_func _kapat(l: TR_Tensor, baş: TR_Int, son: TR_Int) -> TR_Tensor {
    TR_var boy = l.TR_shape[0]
    TR_var bitiş = TR_min(son, boy)
    TR_if baş >= bitiş { TR_return l }
    TR_var dolgu = TR_zeros([bitiş - baş]) + TR_Float("-inf")
    TR_return TR_concat([l.TR_slice(0, 0, baş), dolgu, l.TR_slice(0, bitiş, boy)])
}

# _maske verilen kimlikleri -sonsuz, öbürlerini 0 yapan toplanacak tensördür.
TR_func _maske(boy: TR_Int, kimlikler: TR_List[TR_Int]) -> TR_Tensor {
    TR_var b = [0.0 TR_for _ TR_in 0..boy]
    TR_for i TR_in kimlikler { b[i] = TR_Float("-inf") }
    TR_return TR_Tensor(b)
}

# Modelin özel parçaları ve süzgeçleri (25.5). Damgalar `no_timestamps_token_id`'den sonra,
# sessizlik parçası ondan öncedir (25.8).
TR_struct _Süzgeç {
    eot: TR_Int
    sot: TR_Int
    önceki: TR_Int
    görev: TR_Int
    damga: TR_Int
    sessiz: TR_Int
    bastırma: TR_Tensor
    boş: TR_Tensor
    # _süz logitlere 25.5'in süzgeçlerini sırayla uygular; örnek seçilmiş parçalardır.
    TR_func _süz(l: TR_Tensor, örnek: TR_List[TR_Int]) -> TR_Tensor {
        TR_var boy = l.TR_shape[0]
        TR_var n = örnek.TR_length
        TR_var tb = TR_self.damga
        TR_var x = l + TR_self.bastırma
        TR_if n == 0 { x = x + TR_self.boş }
        TR_var son_damga = n >= 1 TR_and örnek[n - 1] >= tb
        TR_var önceki_damga = n < 2 TR_or örnek[n - 2] >= tb
        TR_if son_damga {
            TR_if önceki_damga { x = _kapat(x, tb, boy) } TR_else { x = _kapat(x, 0, TR_self.eot) }
        }
        TR_var en_son = -1
        TR_for t TR_in örnek {
            TR_if t >= tb { en_son = t }
        }
        TR_if en_son >= 0 {
            TR_var sınır = en_son + 1
            TR_if son_damga TR_and TR_not önceki_damga { sınır = en_son }
            x = _kapat(x, tb, sınır)
        }
        TR_if n == 0 { x = _kapat(_kapat(x, 0, tb), tb + _İLK_DAMGA + 1, boy) }
        TR_var lp = TR_log_softmax(x)
        TR_if TR_logsumexp(lp.TR_slice(0, tb, boy)).TR_tolist > TR_max(lp.TR_slice(0, 0, tb)).TR_tolist { x = _kapat(x, 0, tb) }
        TR_return x
    }
    # _böl parçaları kesitlere böler (25.7): seek pencere başı, boy penceredeki kayıt çerçeveleridir.
    TR_func _böl(p: TR_List[TR_Int], seek: TR_Int, boy: TR_Int) -> _Bölüm {
        TR_var tb = TR_self.damga
        TR_var n = p.TR_length
        TR_var kayma = seek * _ADIM / _ÖRNEK_HIZI
        TR_var dilimler = [i + 1 TR_for i TR_in 0..TR_max(n - 1, 0) TR_if p[i] >= tb TR_and p[i + 1] >= tb]
        TR_var kesitler: TR_List[_Ham] = []
        TR_if dilimler.TR_length == 0 {
            TR_var süre = boy * _ADIM / _ÖRNEK_HIZI
            TR_var en_son = -1
            TR_for t TR_in p {
                TR_if t >= tb { en_son = t }
            }
            TR_if en_son >= 0 TR_and en_son != tb { süre = (en_son - tb) * _DAMGA_SÜRESİ }
            kesitler.TR_append(_Ham(baş: kayma, son: kayma + süre, parçalar: p))
            TR_return _Bölüm(kesitler: kesitler, ilerleme: boy)
        }
        TR_var tek_son = n >= 2 TR_and p[n - 2] < tb TR_and p[n - 1] >= tb
        TR_if tek_son { dilimler.TR_append(n) }
        TR_var önceki = 0
        TR_for d TR_in dilimler {
            kesitler.TR_append(_Ham(baş: kayma + (p[önceki] - tb) * _DAMGA_SÜRESİ, son: kayma + (p[d - 1] - tb) * _DAMGA_SÜRESİ, parçalar: p[önceki..d]))
            önceki = d
        }
        TR_if tek_son { TR_return _Bölüm(kesitler: kesitler, ilerleme: boy) }
        TR_return _Bölüm(kesitler: kesitler, ilerleme: (p[önceki - 1] - tb) * _DAMGA_ÇERÇEVESİ)
    }
}

# Klasörün boyutları: hepsi config.json'dan gelir.
TR_struct _Boyutlar {
    boyut: TR_Int
    mel: TR_Int
    dağarcık: TR_Int
    kaynak: TR_Int
    hedef: TR_Int
    kodlayıcı_katman: TR_Int
    kodlayıcı_bakış: TR_Int
    kodlayıcı_ara: TR_Int
    çözücü_katman: TR_Int
    çözücü_bakış: TR_Int
    çözücü_ara: TR_Int
}

# Dosyanın tensörleri: alınmayan ad sonda hatadır.
TR_struct _Alıcı {
    tensörler: TR_Dict[TR_String, TR_Tensor]
    alınan: TR_Dict[TR_String, TR_Bool]
    # _al tensörü denetler ve float32 olarak verir: hesap float32'dedir (25.1).
    TR_func _al(ad: TR_String, şekil: TR_List[TR_Int]) -> TR_Tensor {
        TR_if TR_not TR_self.tensörler.TR_contains(ad) { TR_throw TR_Message("H7093", ad) }
        TR_var t = TR_self.tensörler[ad]
        TR_if TR_not ["float32", "fp16", "bf16"].TR_contains(t.TR_dtype) { TR_throw TR_Message("H7094", ad, t.TR_dtype) }
        TR_if t.TR_shape != şekil { TR_throw TR_Message("H7095", ad, t.TR_shape, şekil) }
        TR_self.alınan[ad] = TR_true
        TR_return t.TR_to_dtype("float32")
    }
    # _bitir dosyada alınmamış tensör bırakmaz.
    TR_func _bitir() {
        TR_for ad, t TR_in TR_self.tensörler {
            TR_if TR_not TR_self.alınan.TR_contains(ad) { TR_throw TR_Message("H7092", ad) }
        }
    }
}

# Katman normu: PyTorch'un `nn.LayerNorm`'u gibi eps 1e-5'tir.
TR_struct _Norm {
    ağırlık: TR_Tensor
    sapma: TR_Tensor
    TR_func _ileri(x: TR_Tensor) -> TR_Tensor { TR_return TR_layer_norm(x, TR_weight: TR_self.ağırlık, TR_bias: TR_self.sapma) }
}

# Çok bakışlı dikkat: özgündeki `MultiHeadAttention`. Ölçek TR_attention'ın 1/√dh'sidir.
TR_struct _Dikkat {
    q: TR_Linear
    k: TR_Linear
    v: TR_Linear
    o: TR_Linear
    bakış: TR_Int
    # _bakışlar [B, T, boyut]'u [B, T, bakış, bakış boyutu]'na ayırır (15.24).
    TR_func _bakışlar(x: TR_Tensor) -> TR_Tensor {
        TR_var ş = x.TR_shape
        TR_return x.TR_reshape([ş[0], ş[1], TR_self.bakış, ş[2] // TR_self.bakış])
    }
    # _öz kodlayıcının özdikkatidir: maske yoktur.
    TR_func _öz(x: TR_Tensor) -> TR_Tensor {
        TR_var q = TR_self._bakışlar(TR_self.q.TR_forward(x))
        TR_var k = TR_self._bakışlar(TR_self.k.TR_forward(x))
        TR_var v = TR_self._bakışlar(TR_self.v.TR_forward(x))
        TR_var y = TR_attention(q, k, v, TR_causal: TR_false)
        TR_return TR_self.o.TR_forward(y.TR_reshape(x.TR_shape))
    }
    # _nedensel çözücünün özdikkatidir: anahtarlar önbelleğe eklenir, sorgu sondan hizalıdır (15.24).
    TR_func _nedensel(x: TR_Tensor, önbellek: TR_KVCache, katman: TR_Int) -> TR_Tensor {
        TR_var q = TR_self._bakışlar(TR_self.q.TR_forward(x))
        TR_var kv = önbellek.TR_append(katman, TR_self._bakışlar(TR_self.k.TR_forward(x)), TR_self._bakışlar(TR_self.v.TR_forward(x)))
        TR_var y = TR_attention(q, kv[0], kv[1], TR_causal: TR_true)
        TR_return TR_self.o.TR_forward(y.TR_reshape(x.TR_shape))
    }
    # _anahtarlar çapraz dikkatin K ve V'sini kurar: kodlayıcı çıktısı değişmez, pencerede bir kez hesaplanır.
    TR_func _anahtarlar(kaynak: TR_Tensor) -> TR_List[TR_Tensor] {
        TR_return [TR_self._bakışlar(TR_self.k.TR_forward(kaynak)), TR_self._bakışlar(TR_self.v.TR_forward(kaynak))]
    }
    # _çapraz sorguyu hazır K ve V'ye bakar.
    TR_func _çapraz(x: TR_Tensor, kv: TR_List[TR_Tensor]) -> TR_Tensor {
        TR_var y = TR_attention(TR_self._bakışlar(TR_self.q.TR_forward(x)), kv[0], kv[1], TR_causal: TR_false)
        TR_return TR_self.o.TR_forward(y.TR_reshape(x.TR_shape))
    }
}

# Blok: x + dikkat(norm(x)), + mlp(norm(x)). Çözücünün bloğunda arada çapraz dikkat vardır.
TR_struct _Blok {
    dikkat_normu: _Norm
    dikkat: _Dikkat
    çapraz_normu: _Norm?
    çapraz: _Dikkat?
    mlp_normu: _Norm
    mlp1: TR_Linear
    mlp2: TR_Linear
    # _mlp özgünün `Linear, GELU, Linear`'ıdır; GELU tam biçimdir (15.17).
    TR_func _mlp(x: TR_Tensor) -> TR_Tensor {
        TR_return TR_self.mlp2.TR_forward(TR_gelu(TR_self.mlp1.TR_forward(TR_self.mlp_normu._ileri(x)), TR_approximate: TR_false))
    }
    TR_func _kodla(x: TR_Tensor) -> TR_Tensor {
        TR_var y = x + TR_self.dikkat._öz(TR_self.dikkat_normu._ileri(x))
        TR_return y + TR_self._mlp(y)
    }
    TR_func _çöz(x: TR_Tensor, önbellek: TR_KVCache, katman: TR_Int, kv: TR_List[TR_Tensor]) -> TR_Tensor {
        TR_var y = x + TR_self.dikkat._nedensel(TR_self.dikkat_normu._ileri(x), önbellek, katman)
        TR_var z = y + TR_self.çapraz._çapraz(TR_self.çapraz_normu._ileri(y), kv)
        TR_return z + TR_self._mlp(z)
    }
}

# Kodlayıcı: özgündeki `AudioEncoder`.
TR_struct _Kodlayıcı {
    evrişim1: TR_Tensor
    sapma1: TR_Tensor
    evrişim2: TR_Tensor
    sapma2: TR_Tensor
    konum: TR_Tensor
    bloklar: TR_List[_Blok]
    norm: _Norm
    # _ileri [B, mel, 2 · kaynak] log-Mel'i [B, kaynak, boyut] duruma çevirir.
    TR_func _ileri(mel: TR_Tensor) -> TR_Tensor {
        TR_var a = TR_gelu(TR_conv1d(mel, TR_self.evrişim1, TR_self.sapma1, TR_padding: 1), TR_approximate: TR_false)
        TR_var b = TR_gelu(TR_conv1d(a, TR_self.evrişim2, TR_self.sapma2, TR_stride: 2, TR_padding: 1), TR_approximate: TR_false)
        TR_var x = b.TR_permute([0, 2, 1]) + TR_self.konum
        TR_for blok TR_in TR_self.bloklar { x = blok._kodla(x) }
        TR_return TR_self.norm._ileri(x)
    }
}

# Bir pencerenin çözme durumu: özdikkatin önbelleği ve blok başına çapraz dikkatin K ve V'si.
TR_struct _Bellek {
    önbellek: TR_KVCache
    çapraz: TR_List[TR_List[TR_Tensor]]
}

# Çözücü: özgündeki `TextDecoder`. Gömme aynı zamanda çıkış katmanıdır (25.1).
TR_struct _Çözücü {
    gömme: TR_Tensor
    çıkış: TR_Tensor
    konum: TR_Tensor
    bloklar: TR_List[_Blok]
    norm: _Norm
    # _başlat bir pencerenin belleğini kodlayıcı çıktısından kurar.
    TR_func _başlat(kodlanmış: TR_Tensor) -> _Bellek {
        TR_return _Bellek(önbellek: TR_KVCache(TR_self.bloklar.TR_length, TR_kind: "büyüyen"), çapraz: [blok.çapraz._anahtarlar(kodlanmış) TR_for blok TR_in TR_self.bloklar])
    }
    # _ileri parçaları önbelleğin konumundan sürdürür ve [1, parça, dağarcık] logit verir.
    TR_func _ileri(parçalar: TR_List[TR_Int], bellek: _Bellek) -> TR_Tensor {
        TR_var baş = bellek.önbellek.TR_position
        TR_var x = TR_embedding_lookup(TR_self.gömme, [parçalar]) + TR_self.konum.TR_slice(0, baş, baş + parçalar.TR_length)
        TR_for i, blok TR_in TR_self.bloklar { x = blok._çöz(x, bellek.önbellek, i, bellek.çapraz[i]) }
        bellek.önbellek.TR_advance(parçalar.TR_length)
        TR_return TR_self.norm._ileri(x) @ TR_self.çıkış
    }
}

# Whisper: açılmış model. Alanları modele özeldir.
TR_struct TR_Whisper {
    _boyutlar: _Boyutlar
    _üretim: TR_JSON
    _parçalayıcı: TR_Tokenizer
    _kodlayıcı: _Kodlayıcı
    _çözücü: _Çözücü
    # _kodla bir pencerenin [mel, 2 · kaynak] log-Mel'ini [1, kaynak, boyut] duruma çevirir.
    TR_func _kodla(mel: TR_Tensor) -> TR_Tensor {
        # Kısa pencere hatasız yanlış verirdi: evrişim tek çerçeve bırakır, konum ona yayınlanır.
        TR_var b = TR_self._boyutlar
        TR_var şekil = [b.mel, 2 * b.kaynak]
        TR_if mel.TR_shape != şekil { TR_throw TR_Message("H7097", mel.TR_shape, şekil) }
        TR_return TR_self._kodlayıcı._ileri(mel.TR_reshape([1, b.mel, 2 * b.kaynak]))
    }
    # _başlat kodlayıcı çıktısından bir pencerenin çözme belleğini kurar.
    TR_func _başlat(kodlanmış: TR_Tensor) -> _Bellek { TR_return TR_self._çözücü._başlat(kodlanmış) }
    # _çöz parçaları bellekten sürdürür ve logitlerini verir.
    TR_func _çöz(parçalar: TR_List[TR_Int], bellek: _Bellek) -> TR_Tensor { TR_return TR_self._çözücü._ileri(parçalar, bellek) }
    # _özel adı verilen özel parçanın kimliğini verir.
    TR_func _özel(ad: TR_String) -> TR_Int {
        TR_var k = TR_self._parçalayıcı.TR_token_id(ad)
        TR_if k == TR_none { TR_throw TR_Message("H7099", ad) }
        TR_return k
    }
    # _süzgeç modelin süzgeçlerini kurar.
    TR_func _süzgeç() -> _Süzgeç {
        TR_var damgasız = TR_Int(TR_self._üretim["no_timestamps_token_id"])
        TR_var eot = TR_self._özel("<|endoftext|>")
        TR_var bastırılan = [TR_Int(k) TR_for k TR_in TR_self._üretim["suppress_tokens"]]
        bastırılan.TR_append(damgasız)
        TR_var boşluk = TR_self._parçalayıcı.TR_encode(" ", TR_special_tokens: TR_false)
        boşluk.TR_append(eot)
        TR_var boy = TR_self._boyutlar.dağarcık
        TR_return _Süzgeç(eot: eot, sot: TR_self._özel("<|startoftranscript|>"), önceki: TR_self._özel("<|startofprev|>"), görev: TR_self._özel("<|transcribe|>"),
            damga: damgasız + 1, sessiz: damgasız - 1, bastırma: _maske(boy, bastırılan), boş: _maske(boy, boşluk))
    }
    # _başlangıç dilin başlangıç dizisini verir (25.3).
    TR_func _başlangıç(dil: TR_String, s: _Süzgeç) -> TR_List[TR_Int] {
        TR_var diller = TR_config_value(TR_self._üretim, "lang_to_id", TR_none)
        TR_if diller == TR_none {
            TR_if dil != "en" { TR_throw TR_Message("H7098", dil, "mono") }
            TR_return [s.sot]
        }
        TR_var k = TR_config_value(diller, "<|\(dil)|>", TR_none)
        TR_if k == TR_none { TR_throw TR_Message("H7098", dil, "unknown") }
        TR_return [s.sot, TR_Int(k), s.görev]
    }
    # _pencere bir pencereyi çözer (25.4–25.6, 25.8): önceki parçalar başa gelir.
    TR_func _pencere(mel: TR_Tensor, başlangıç: TR_List[TR_Int], önceki: TR_List[TR_Int], s: _Süzgeç) -> _Sonuç {
        TR_var bağlam = TR_self._boyutlar.hedef
        TR_var ilk = başlangıç
        TR_var sot_yeri = 0
        TR_if önceki.TR_length > 0 {
            TR_var en_çok = bağlam // 2 - 1
            TR_var alınan = önceki[TR_max(önceki.TR_length - en_çok, 0)..önceki.TR_length]
            ilk = [s.önceki] + alınan + başlangıç
            sot_yeri = alınan.TR_length + 1
        }
        TR_var bellek = TR_self._başlat(TR_self._kodla(mel))
        TR_var boy = TR_self._boyutlar.dağarcık
        TR_var ileri = ilk
        TR_var örnek: TR_List[TR_Int] = []
        TR_var toplam = 0.0
        TR_var sessizlik = 0.0
        TR_for adım TR_in 0..bağlam // 2 {
            TR_var l = TR_self._çöz(ileri, bellek)
            TR_var T = ileri.TR_length
            TR_if adım == 0 {
                sessizlik = TR_softmax(l.TR_slice(1, sot_yeri, sot_yeri + 1).TR_reshape([boy])).TR_tolist[s.sessiz]
            }
            TR_var x = s._süz(l.TR_slice(1, T - 1, T).TR_reshape([boy]), örnek)
            TR_var seçilen = TR_argmax(x).TR_tolist
            toplam = toplam + TR_log_softmax(x).TR_tolist[seçilen]
            TR_if seçilen == s.eot { TR_break }
            örnek.TR_append(seçilen)
            TR_if ilk.TR_length + örnek.TR_length > bağlam { TR_break }
            ileri = [seçilen]
        }
        TR_return _Sonuç(parçalar: örnek, ortalama: toplam / (örnek.TR_length + 1), sessizlik: sessizlik)
    }
    # _metin parçaları çözer; damgalar metne girmez (25.2).
    TR_func _metin(parçalar: TR_List[TR_Int], sınır: TR_Int) -> TR_String {
        TR_return TR_self._parçalayıcı.TR_decode([p TR_for p TR_in parçalar TR_if p < sınır], TR_special_tokens: TR_true)
    }
    # _dilim log-Mel'in pencereye düşen çerçevelerini verir; kısa pencere sıfırla dolar (özgündeki
    # `pad_or_trim`), log-Mel'in kendi dolgusu kullanılmaz.
    TR_func _dilim(log_mel: TR_Tensor, seek: TR_Int, boy: TR_Int) -> TR_Tensor {
        TR_var pencere = 2 * TR_self._boyutlar.kaynak
        TR_var dilim = log_mel.TR_slice(1, seek, seek + boy)
        TR_if boy == pencere { TR_return dilim }
        TR_return TR_concat([dilim, TR_zeros([log_mel.TR_shape[0], pencere - boy])], TR_dim: 1)
    }
    # _işle çözülmüş pencereyi kesitlere ve parçalara ekler, pencere başının yeni yerini verir (25.7, 25.8).
    TR_func _işle(r: TR_List[TR_Int], ortalama: TR_Float, sessizlik: TR_Float, seek: TR_Int, boy: TR_Int, s: _Süzgeç, parçalar: TR_List[TR_Int], kesitler: TR_List[TR_Segment]) -> TR_Int {
        TR_if sessizlik > _SESSİZLİK TR_and ortalama <= _LOG_OLASILIK { TR_return seek + boy }
        TR_var b = s._böl(r, seek, boy)
        TR_for k TR_in b.kesitler {
            TR_var metin = TR_self._metin(k.parçalar, s.eot)
            TR_if k.baş == k.son TR_or metin.TR_strip() == "" {
                kesitler.TR_append(TR_Segment(k.baş, k.son, "", []))
            } TR_else {
                kesitler.TR_append(TR_Segment(k.baş, k.son, metin, k.parçalar))
                TR_for p TR_in k.parçalar { parçalar.TR_append(p) }
            }
        }
        TR_return seek + b.ilerleme
    }
    # _çevir sesi pencere pencere çözer (25.7).
    TR_func _çevir(ses: TR_Sound, dil: TR_String) -> TR_Transcription {
        TR_var s = TR_self._süzgeç()
        TR_var başlangıç = TR_self._başlangıç(dil, s)
        TR_var pencere = 2 * TR_self._boyutlar.kaynak
        TR_var log_mel = TR_whisper_log_mel(ses, TR_n_mels: TR_self._boyutlar.mel)
        TR_var kayıt = log_mel.TR_shape[1] - _DOLGU
        TR_var seek = 0
        TR_var parçalar: TR_List[TR_Int] = []
        TR_var kesitler: TR_List[TR_Segment] = []
        TR_for seek < kayıt {
            TR_var boy = TR_min(pencere, kayıt - seek)
            TR_var r = TR_self._pencere(TR_self._dilim(log_mel, seek, boy), başlangıç, parçalar, s)
            seek = TR_self._işle(r.parçalar, r.ortalama, r.sessizlik, seek, boy, s, parçalar, kesitler)
        }
        TR_return TR_Transcription(TR_self._metin(parçalar, s.damga), kesitler, dil)
    }
    # yazıya_çevir sesi yazıya çevirir (25.2). Dış 16 bit blokta logit yuvarlanır, metin hatasız
    # değişirdi: aynı ses aynı metni versin diye gövde float32 bloğundadır (15.4, 25.4). Alt adımlar
    # çağıranın bloğunu izler.
    TR_func TR_transcribe(ses: TR_Sound, TR_language: TR_String) -> TR_Transcription {
        TR_return TR_mixed_precision("float32") { TR_self._çevir(ses, TR_language) }
    }
}

# _gerekli JSON nesnesinin zorunlu alanını verir.
TR_func _gerekli(ayar: TR_JSON, dosya: TR_String, alan: TR_String) -> TR_JSON {
    TR_var v = TR_config_value(ayar, alan, TR_none)
    TR_if v == TR_none { TR_throw TR_Message("H7088", dosya, alan) }
    TR_return v
}

# _sayı config.json'un zorunlu sayısını verir: sıfır ve eksi boyut model kurmaz.
TR_func _sayı(ayar: TR_JSON, alan: TR_String) -> TR_Int {
    TR_var n = TR_Int(_gerekli(ayar, _AYAR, alan))
    TR_if n <= 0 { TR_throw TR_Message("H7096", alan, n, "positive") }
    TR_return n
}

# _bakış bakış sayısını verir: boyutu bölmeyen sayı bakışlara ayrılamaz.
TR_func _bakış(ayar: TR_JSON, alan: TR_String, boyut: TR_Int) -> TR_Int {
    TR_var n = _sayı(ayar, alan)
    TR_if boyut % n != 0 { TR_throw TR_Message("H7096", alan, n, "heads") }
    TR_return n
}

# _boyutlar config.json'un kapılarından geçer: desteklenmeyen ayar hatasız yüklenir, yanlış metin üretirdi.
TR_func _boyutlar(ayar: TR_JSON) -> _Boyutlar {
    TR_var etkinleşme = TR_String(TR_config_value(ayar, "activation_function", "gelu"))
    TR_if etkinleşme != "gelu" { TR_throw TR_Message("H7096", "activation_function", etkinleşme, "activation") }
    TR_if TR_Bool(TR_config_value(ayar, "scale_embedding", TR_false)) { TR_throw TR_Message("H7096", "scale_embedding", TR_true, "scale") }
    TR_var mel = _sayı(ayar, "num_mel_bins")
    TR_if mel != 80 TR_and mel != 128 { TR_throw TR_Message("H7091", mel) }
    TR_var boyut = _sayı(ayar, "d_model")
    TR_return _Boyutlar(boyut: boyut, mel: mel, dağarcık: _sayı(ayar, "vocab_size"),
        kaynak: _sayı(ayar, "max_source_positions"), hedef: _sayı(ayar, "max_target_positions"),
        kodlayıcı_katman: _sayı(ayar, "encoder_layers"), kodlayıcı_bakış: _bakış(ayar, "encoder_attention_heads", boyut),
        kodlayıcı_ara: _sayı(ayar, "encoder_ffn_dim"), çözücü_katman: _sayı(ayar, "decoder_layers"),
        çözücü_bakış: _bakış(ayar, "decoder_attention_heads", boyut), çözücü_ara: _sayı(ayar, "decoder_ffn_dim"))
}

# _doğrusal Doğrusal'ı dosyanın [çıkış, giriş] ağırlığından kurar.
TR_func _doğrusal(a: _Alıcı, ad: TR_String, çıkış: TR_Int, giriş: TR_Int, sapmalı: TR_Bool = TR_true) -> TR_Linear {
    TR_var k = TR_Linear(1, 1, TR_init_std: 0.0)
    k.TR_weight = a._al("\(ad).weight", [çıkış, giriş]).TR_transpose()
    TR_if sapmalı { k.TR_bias = a._al("\(ad).bias", [çıkış]) }
    TR_return k
}

TR_func _norm(a: _Alıcı, ad: TR_String, boyut: TR_Int) -> _Norm {
    TR_return _Norm(ağırlık: a._al("\(ad).weight", [boyut]), sapma: a._al("\(ad).bias", [boyut]))
}

# _dikkat dört izdüşümü kurar; K'nın sapması yoktur.
TR_func _dikkat(a: _Alıcı, ad: TR_String, boyut: TR_Int, bakış: TR_Int) -> _Dikkat {
    TR_return _Dikkat(q: _doğrusal(a, "\(ad).q_proj", boyut, boyut), k: _doğrusal(a, "\(ad).k_proj", boyut, boyut, sapmalı: TR_false),
        v: _doğrusal(a, "\(ad).v_proj", boyut, boyut), o: _doğrusal(a, "\(ad).out_proj", boyut, boyut), bakış: bakış)
}

# _blok bir bloğu kurar; çözücünün bloğunda çapraz dikkat de vardır.
TR_func _blok(a: _Alıcı, ad: TR_String, boyut: TR_Int, bakış: TR_Int, ara: TR_Int, çözücü: TR_Bool) -> _Blok {
    TR_var çapraz_normu: _Norm? = TR_none
    TR_var çapraz: _Dikkat? = TR_none
    TR_if çözücü {
        çapraz_normu = _norm(a, "\(ad).encoder_attn_layer_norm", boyut)
        çapraz = _dikkat(a, "\(ad).encoder_attn", boyut, bakış)
    }
    TR_return _Blok(dikkat_normu: _norm(a, "\(ad).self_attn_layer_norm", boyut), dikkat: _dikkat(a, "\(ad).self_attn", boyut, bakış),
        çapraz_normu: çapraz_normu, çapraz: çapraz, mlp_normu: _norm(a, "\(ad).final_layer_norm", boyut),
        mlp1: _doğrusal(a, "\(ad).fc1", ara, boyut), mlp2: _doğrusal(a, "\(ad).fc2", boyut, ara))
}

TR_func _kodlayıcı(a: _Alıcı, b: _Boyutlar) -> _Kodlayıcı {
    TR_var ön = "model.encoder"
    TR_var bloklar = [_blok(a, "\(ön).layers.\(i)", b.boyut, b.kodlayıcı_bakış, b.kodlayıcı_ara, TR_false) TR_for i TR_in 0..b.kodlayıcı_katman]
    TR_return _Kodlayıcı(evrişim1: a._al("\(ön).conv1.weight", [b.boyut, b.mel, 3]), sapma1: a._al("\(ön).conv1.bias", [b.boyut]),
        evrişim2: a._al("\(ön).conv2.weight", [b.boyut, b.boyut, 3]), sapma2: a._al("\(ön).conv2.bias", [b.boyut]),
        konum: a._al("\(ön).embed_positions.weight", [b.kaynak, b.boyut]), bloklar: bloklar, norm: _norm(a, "\(ön).layer_norm", b.boyut))
}

TR_func _çözücü(a: _Alıcı, b: _Boyutlar) -> _Çözücü {
    TR_var ön = "model.decoder"
    TR_var bloklar = [_blok(a, "\(ön).layers.\(i)", b.boyut, b.çözücü_bakış, b.çözücü_ara, TR_true) TR_for i TR_in 0..b.çözücü_katman]
    TR_var gömme = a._al("\(ön).embed_tokens.weight", [b.dağarcık, b.boyut])
    TR_return _Çözücü(gömme: gömme, çıkış: gömme.TR_transpose(), konum: a._al("\(ön).embed_positions.weight", [b.hedef, b.boyut]),
        bloklar: bloklar, norm: _norm(a, "\(ön).layer_norm", b.boyut))
}

# _dosya klasörde olması gereken dosyanın yolunu verir.
TR_func _dosya(yol: TR_String, ad: TR_String) -> TR_Path {
    TR_var p = TR_Path(TR_Path(yol), ad)
    TR_if TR_not p.TR_exists { TR_throw TR_Message("H7087", yol, ad) }
    TR_return p
}

# hazır_whisper klasörü açar (25.1). Önce mimari bakılır: başka bir modelin klasörüne eksik dosya
# değil, doğru ad söylenir.
TR_func TR_pretrained_whisper(yol: TR_String) -> TR_Whisper {
    TR_var ayar = TR_json_parse(TR_read_file(_dosya(yol, _AYAR)))
    TR_var mimari = TR_String(_gerekli(ayar, _AYAR, "model_type"))
    TR_if mimari != "whisper" { TR_throw TR_Message("H7089", yol, mimari) }
    TR_var ağırlıklar = _dosya(yol, _AĞIRLIK)
    TR_var parçalayıcı = _dosya(yol, _PARÇALAYICI)
    TR_var üretim = TR_json_parse(TR_read_file(_dosya(yol, _ÜRETİM)))
    _gerekli(üretim, _ÜRETİM, "suppress_tokens")
    _gerekli(üretim, _ÜRETİM, "no_timestamps_token_id")
    TR_var b = _boyutlar(ayar)
    TR_var a = _Alıcı(tensörler: TR_load_tensors(TR_String(ağırlıklar)), alınan: {})
    TR_var kodlayıcı = _kodlayıcı(a, b)
    TR_var çözücü = _çözücü(a, b)
    a._bitir()
    TR_return TR_Whisper(_boyutlar: b, _üretim: üretim, _parçalayıcı: TR_load_tokenizer(TR_String(parçalayıcı)), _kodlayıcı: kodlayıcı, _çözücü: çözücü)
}
