//! tr kodlu 3 dil=tr
// tr/hazir — Hugging Face biçiminde kaydedilmiş hazır modelleri (config.json + model.safetensors)
// TR'nin GPT'sine (tr/katman) yükler.
//
// Kullanım:   aktar "tr/hazir"
//             değişken model = hazır_model("modeller/SmolLM2-135M")
//             değişken p = parçalayıcı_yükle("modeller/SmolLM2-135M/tokenizer.json")
//
// Desteklenen mimariler (model_type): llama (Llama, SmolLM2, TinyLlama ...) ve qwen3. İkisi de TR'nin
// GPT'siyle aynı iskelettir (transformers modeling_llama.py, modeling_qwen3.py): ön-norm blok
// x + dikkat(norm1(x)), + mlp(norm2(x)); RMSNorm; dikkat GQA ve RoPE (yarı döndürme, rotate_half);
// MLP aşağı(silu(kapı(x)) · yukarı(x)); qwen3'te q ve k bakış boyutunda RMS normundan RoPE'dan önce
// geçer (qk_normu). Desteklenmeyen bir ayar (sapmalı katmanlar, RoPE ölçekleme, başka etkinleştirme)
// açık hatadır; sessizce yanlış model kurulmaz.
//
// Ağırlıklar safetensors'tan (tensör_yükle, dil tanımı 15.47) bir ad eşlemesiyle parametrelere
// yazılır (parametreleri_yükle, 20.11). Hugging Face nn.Linear ağırlığı [çıkış, giriş], TR'nin
// Doğrusal'ı [giriş, çıkış] tutar: doğrusal katmanlar devrilir. Eşlenmeyen ya da eksik ad hatadır.
// Model birleşik katmanlarla kurulur: k_proj ile v_proj tek [K | V] katmanı (birleşik_kv),
// gate_proj ile up_proj tek [G | U] katmanı (birleşik_kapı) olur. Sonuç aynıdır, ama bir parçalık
// üretim adımında katman başına iki çarpım (iki kernel) eksilir; vLLM de Llama'yı böyle yükler
// (QKVParallelLinear, MergedColumnParallelLinear).

TR_kw_import "tr/katman"

TR_kw_const DESTEKLENEN_MİMARİLER = ["llama", "qwen3"]

// ayar_değeri sözlükte anahtar varsa ve değeri yok (JSON null) değilse onu, yoksa öntanımlıyı verir.
TR_kw_func ayar_değeri(ayar, anahtar, öntanımlı) {
    TR_kw_if ayar.TR_mem_contains(anahtar) TR_kw_and ayar[anahtar] != TR_kw_none { TR_kw_return ayar[anahtar] }
    TR_kw_return öntanımlı
}

// hazır_model klasördeki config.json'dan modeli kurar ve model.safetensors'ı yükler. ağırlık_türü
// matris ağırlıklarının türüdür ("float32", "bf16", "fp16"); normlar float32, hesap float32 kalır.
// Hugging Face modelleri çoğunlukla bf16 saklanır (config.json torch_dtype): "bf16" ağırlıkları
// olduğu gibi tutar (sonuç float32 ağırlıkla aynı matematiktir), GPU'da okunan bayt yarıya iner.
// Dosyada F32 saklanan ağırlıklar "bf16" ile bf16'ya yuvarlanır (sonuç float32 yüklemeden biraz
// ayrılır); dosyanın türünü korumak için config.json'daki torch_dtype'a uyan tür seçilir.
TR_kw_func hazır_model(klasör, ağırlık_türü = "float32") {
    TR_kw_var k = TR_fn_path(klasör)
    TR_kw_var ayar = TR_fn_json_parse(TR_fn_read_file(TR_fn_path(k, "config.json")))
    TR_kw_var model = hazır_model_kur(ayar, ağırlık_türü: ağırlık_türü)
    TR_kw_var ağırlıklar = TR_fn_load_tensors(TR_fn_path(k, "model.safetensors"))
    TR_fn_load_parameters(model, hugging_face_eşle(ağırlıklar, ayar))
    TR_kw_return model
}

// hazır_model_kur config.json sözlüğünden (ağırlıklar yüklenmeden) GPT'yi kurar.
TR_kw_func hazır_model_kur(ayar, ağırlık_türü = "float32") {
    TR_kw_var mimari = ayar_değeri(ayar, "model_type", "")
    TR_kw_if TR_kw_not DESTEKLENEN_MİMARİLER.TR_mem_contains(mimari) {
        TR_kw_throw "hazır_model: {mimari} mimarisi desteklenmiyor (desteklenenler: {DESTEKLENEN_MİMARİLER})"
    }
    TR_kw_if ayar_değeri(ayar, "attention_bias", TR_kw_false) TR_kw_or ayar_değeri(ayar, "mlp_bias", TR_kw_false) {
        TR_kw_throw "hazır_model: sapmalı dikkat ya da MLP katmanları desteklenmiyor"
    }
    TR_kw_if ayar_değeri(ayar, "hidden_act", "silu") != "silu" {
        TR_kw_throw "hazır_model: {ayar_değeri(ayar, \"hidden_act\", \"\")} etkinleştirmesi desteklenmiyor (silu bekleniyordu)"
    }
    TR_kw_if rope_ölçekleme_var_mı(ayar) {
        TR_kw_throw "hazır_model: RoPE ölçekleme (rope_scaling) desteklenmiyor"
    }
    TR_kw_if ayar_değeri(ayar, "use_sliding_window", TR_kw_false) {
        TR_kw_throw "hazır_model: kayan pencereli dikkat (use_sliding_window) henüz desteklenmiyor"
    }
    TR_kw_var boyut = ayar["hidden_size"]
    TR_kw_var bakış = ayar["num_attention_heads"]
    TR_kw_return GPT(ayar["vocab_size"], bağlam: ayar_değeri(ayar, "max_position_embeddings", 2048), boyut: boyut,
        katman: ayar["num_hidden_layers"], bakış_sayısı: bakış,
        kv_bakış_sayısı: ayar_değeri(ayar, "num_key_value_heads", bakış), ara_boyut: ayar["intermediate_size"],
        paylaşımlı: ayar_değeri(ayar, "tie_word_embeddings", TR_kw_false), epsilon: ayar_değeri(ayar, "rms_norm_eps", 0.000001),
        qk_normu: mimari == "qwen3", bakış_boyutu: ayar_değeri(ayar, "head_dim", TR_fn_int(boyut / bakış)),
        rope_tabanı: rope_tabanı(ayar), birleşik_kv: TR_kw_true, birleşik_kapı: TR_kw_true, ağırlık_türü: ağırlık_türü)
}

// rope_tabanı: üst düzeyde rope_theta (eski transformers) ya da rope_parameters.rope_theta (5.x);
// ikisi de yoksa Llama'nın varsayılanı 10000.
TR_kw_func rope_tabanı(ayar) {
    TR_kw_if ayar.TR_mem_contains("rope_theta") { TR_kw_return TR_fn_float(ayar["rope_theta"]) }
    TR_kw_var p = ayar_değeri(ayar, "rope_parameters", TR_kw_none)
    TR_kw_if p != TR_kw_none TR_kw_and p.TR_mem_contains("rope_theta") { TR_kw_return TR_fn_float(p["rope_theta"]) }
    TR_kw_return 10000.0
}

TR_kw_func rope_ölçekleme_var_mı(ayar) {
    TR_kw_var ölçek = ayar_değeri(ayar, "rope_scaling", TR_kw_none)
    TR_kw_if ölçek != TR_kw_none { TR_kw_return TR_kw_true }
    TR_kw_var p = ayar_değeri(ayar, "rope_parameters", TR_kw_none)
    TR_kw_return p != TR_kw_none TR_kw_and ayar_değeri(p, "rope_type", "default") != "default"
}

// Blok içi Hugging Face adı → [TR adı, devrik mi, birleşik katmandaki parça (-1: tek başına)].
// Parçalı ağırlıklar (devrildikten sonra) son eksende sırayla bitiştirilir: [K | V], [G | U].
TR_kw_const BLOK_ADLARI = {
    "self_attn.q_proj.weight": ["dikkat.sorgu_katmanı.ağırlık", TR_kw_true, -1],
    "self_attn.k_proj.weight": ["dikkat.kv_katmanı.ağırlık", TR_kw_true, 0],
    "self_attn.v_proj.weight": ["dikkat.kv_katmanı.ağırlık", TR_kw_true, 1],
    "self_attn.o_proj.weight": ["dikkat.çıkış_katmanı.ağırlık", TR_kw_true, -1],
    "self_attn.q_norm.weight": ["dikkat.q_norm.ağırlık", TR_kw_false, -1],
    "self_attn.k_norm.weight": ["dikkat.k_norm.ağırlık", TR_kw_false, -1],
    "mlp.gate_proj.weight": ["ileri_besleme.kapı_yukarı.ağırlık", TR_kw_true, 0],
    "mlp.up_proj.weight": ["ileri_besleme.kapı_yukarı.ağırlık", TR_kw_true, 1],
    "mlp.down_proj.weight": ["ileri_besleme.aşağı.ağırlık", TR_kw_true, -1],
    "input_layernorm.weight": ["norm1.ağırlık", TR_kw_false, -1],
    "post_attention_layernorm.weight": ["norm2.ağırlık", TR_kw_false, -1]
}

// hugging_face_eşle Hugging Face adlı ağırlık sözlüğünü TR parametre adlarına çevirir. Paylaşımlı
// gömmede lm_head.weight varsa gömmeyle aynı olmalıdır ve atlanır; dönüş tabloları
// (rotary_emb.inv_freq) hesaplanır, atlanır. Tanınmayan ad hatadır.
TR_kw_func hugging_face_eşle(ağırlıklar, ayar) {
    TR_kw_var paylaşımlı = ayar_değeri(ayar, "tie_word_embeddings", TR_kw_false)
    TR_kw_var sonuç_sözlük = {}
    TR_kw_var parçalı = {} // TR adı → [ilk parça, ikinci parça]
    TR_kw_for ad, t TR_kw_in ağırlıklar {
        TR_kw_if ad.TR_mem_ends_with("rotary_emb.inv_freq") { TR_kw_continue }
        TR_kw_if ad == "model.embed_tokens.weight" {
            sonuç_sözlük["gömme.tablo"] = t
        } TR_kw_else TR_kw_if ad == "model.norm.weight" {
            sonuç_sözlük["son_norm.ağırlık"] = t
        } TR_kw_else TR_kw_if ad == "lm_head.weight" {
            TR_kw_if TR_kw_not paylaşımlı { sonuç_sözlük["çıkış.ağırlık"] = t.TR_mem_transpose() }
        } TR_kw_else TR_kw_if ad.TR_mem_starts_with("model.layers.") {
            TR_kw_var parçalar = ad.TR_mem_split(".")
            TR_kw_var iç = parçalar[3..parçalar.TR_mem_length].TR_mem_join(".")
            TR_kw_if TR_kw_not BLOK_ADLARI.TR_mem_contains(iç) { TR_kw_throw "hazır_model: tanınmayan ağırlık {ad}" }
            TR_kw_var hedef = BLOK_ADLARI[iç]
            TR_kw_var tr_ad = "bloklar.{parçalar[2]}.{hedef[0]}"
            TR_kw_var w = t
            TR_kw_if hedef[1] { w = t.TR_mem_transpose() }
            TR_kw_if hedef[2] < 0 {
                sonuç_sözlük[tr_ad] = w
            } TR_kw_else {
                TR_kw_if TR_kw_not parçalı.TR_mem_contains(tr_ad) { parçalı[tr_ad] = [TR_kw_none, TR_kw_none] }
                parçalı[tr_ad][hedef[2]] = w
            }
        } TR_kw_else {
            TR_kw_throw "hazır_model: tanınmayan ağırlık {ad}"
        }
    }
    TR_kw_for tr_ad, p TR_kw_in parçalı {
        TR_kw_if p[0] == TR_kw_none TR_kw_or p[1] == TR_kw_none { TR_kw_throw "hazır_model: {tr_ad} için iki parçadan biri eksik" }
        sonuç_sözlük[tr_ad] = TR_fn_concat(p, TR_arg_dim: -1)
    }
    TR_kw_return sonuç_sözlük
}
