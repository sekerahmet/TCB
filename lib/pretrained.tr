# TR 4
# tr/pretrained — Hugging Face biçiminde kaydedilmiş hazır modelleri (config.json + model.safetensors)
# ve tek GGUF dosyasını TR'nin GPT'sine (tr/layers) yükler.
#
# Kullanım:   aktar "tr/pretrained"
#             değişken model = hazır_model("modeller/SmolLM2-135M")
#             değişken p = parçalayıcı_yükle("modeller/SmolLM2-135M/tokenizer.json")
#             değişken g = hazır_gguf("modeller/Qwen3-0.6B-Q8_0.gguf")
#             değişken gp = parçalayıcı_yükle("modeller/Qwen3-0.6B-Q8_0.gguf")
#
# Desteklenen mimariler (model_type): llama (Llama, SmolLM2, TinyLlama ...) ve qwen3. İkisi de TR'nin
# GPT'siyle aynı iskelettir (transformers modeling_llama.py, modeling_qwen3.py): ön-norm blok
# x + dikkat(norm1(x)), + mlp(norm2(x)); RMSNorm; dikkat GQA ve RoPE (yarı döndürme, rotate_half);
# MLP aşağı(silu(kapı(x)) · yukarı(x)); qwen3'te q ve k bakış boyutunda RMS normundan RoPE'dan önce
# geçer (qk_normu). Desteklenmeyen bir ayar (sapmalı katmanlar, RoPE ölçekleme, başka etkinleştirme)
# açık hatadır; sessizce yanlış model kurulmaz. GGUF'ta `rope_freqs.weight` bölenleri uygulanır.
#
# Ağırlıklar safetensors'tan (tensör_yükle, dil tanımı 15.47) bir ad eşlemesiyle parametrelere
# yazılır (parametreleri_yükle, 20.11). Hugging Face nn.Linear ağırlığı [çıkış, giriş], TR'nin
# Doğrusal'ı [giriş, çıkış] tutar: doğrusal katmanlar devrilir. Eşlenmeyen ya da eksik ad hatadır.
# Model birleşik katmanlarla kurulur: k_proj ile v_proj tek [K | V] katmanı (birleşik_kv),
# gate_proj ile up_proj tek [G | U] katmanı (birleşik_kapı) olur. Sonuç aynıdır, ama bir parçalık
# üretim adımında katman başına iki çarpım (iki kernel) eksilir; vLLM de Llama'yı böyle yükler
# (QKVParallelLinear, MergedColumnParallelLinear).

TR_import "tr/layers"

TR_const TR_SUPPORTED_ARCHITECTURES = ["llama", "qwen3"]

# ayar_değeri ayarda (config.json'un JSON nesnesi ya da sözlük) anahtar varsa ve değeri yok (JSON null)
# değilse onu, yoksa öntanımlıyı verir. Değer JSON olabilir: çağıran tip çağrısıyla açar (Tam(...), 3.7a).
TR_func TR_config_value(TR_config, TR_key: TR_String, TR_fallback) {
    TR_var v = TR_config.TR_get(TR_key)
    TR_if v == TR_none TR_or TR_Type(v) == TR_NoneType { TR_return TR_fallback }
    TR_return v
}

# hazır_model klasördeki config.json'dan modeli kurar ve model.safetensors'ı yükler. ağırlık_türü
# matris ağırlıklarının türüdür ("float32", "bf16", "fp16"); normlar float32, hesap float32 kalır.
# Hugging Face modelleri çoğunlukla bf16 saklanır (config.json torch_dtype): "bf16" ağırlıkları
# olduğu gibi tutar (sonuç float32 ağırlıkla aynı matematiktir), GPU'da okunan bayt yarıya iner.
# Dosyada F32 saklanan ağırlıklar "bf16" ile bf16'ya yuvarlanır (sonuç float32 yüklemeden biraz
# ayrılır); dosyanın türünü korumak için config.json'daki torch_dtype'a uyan tür seçilir.
TR_func TR_pretrained_model(TR_folder: TR_String, TR_weight_dtype: TR_String = "float32") -> TR_GPT {
    TR_if TR_folder.TR_lower().TR_ends_with(".gguf") { TR_throw TR_Message("H6996", TR_folder) }
    TR_var k = TR_Path(TR_folder)
    TR_var ayar = TR_json_parse(TR_read_file(TR_Path(k, "config.json")))
    TR_if TR_String(TR_config_value(ayar, "model_type", "")) == "whisper" { TR_throw TR_Message("H7090", TR_folder) }
    TR_var model = _kur(ayar, TR_weight_dtype, "\(TR_Path(k, "config.json"))")
    TR_var ağırlıklar = TR_load_tensors(TR_Path(k, "model.safetensors"))
    TR_load_parameters(model, TR_map_hugging_face(ağırlıklar, ayar))
    TR_return model
}

# hazır_model_kur config.json sözlüğünden (ağırlıklar yüklenmeden) GPT'yi kurar. Ağırlıklar sıfırdır
# (başlangıç sapması 0): rastgele ilkleme yüklemenin %40'ıydı ve değerleri yüklemeyle silinirdi.
TR_func TR_build_pretrained_model(TR_config, TR_weight_dtype: TR_String = "float32") -> TR_GPT {
    TR_var mimari = TR_String(TR_config_value(TR_config, "model_type", ""))
    TR_var y = _yapı(mimari, "model")
    _ayar_kapısı(TR_JSON(TR_config), y, "")
    _ayar_değerleri(TR_JSON(TR_config))
    TR_if TR_Bool(TR_config_value(TR_config, "attention_bias", TR_false)) TR_or TR_Bool(TR_config_value(TR_config, "mlp_bias", TR_false)) {
        TR_throw TR_Message("H6941", "model")
    }
    TR_if TR_String(TR_config_value(TR_config, "hidden_act", "silu")) != "silu" {
        TR_throw TR_Message("H6942", "model", TR_String(TR_config_value(TR_config, "hidden_act", "")))
    }
    TR_if TR_has_rope_scaling(TR_config) {
        TR_throw TR_Message("H6943", "model", "rope_scaling")
    }
    TR_if TR_Bool(TR_config_value(TR_config, "use_sliding_window", TR_false)) {
        TR_throw TR_Message("H6944", "model", "use_sliding_window")
    }
    TR_var boyut = TR_Int(TR_config["hidden_size"])
    TR_var bakış = TR_Int(TR_config["num_attention_heads"])
    TR_return TR_GPT(TR_Int(TR_config["vocab_size"]), TR_context: TR_Int(TR_config_value(TR_config, "max_position_embeddings", 2048)), TR_embed_dim: boyut,
        TR_num_layers: TR_Int(TR_config["num_hidden_layers"]), TR_num_heads: bakış,
        TR_num_kv_heads: TR_Int(TR_config_value(TR_config, "num_key_value_heads", bakış)), TR_intermediate_dim: TR_Int(TR_config["intermediate_size"]),
        TR_tied: TR_Bool(TR_config_value(TR_config, "tie_word_embeddings", TR_false)), TR_eps: TR_Float(TR_config_value(TR_config, "rms_norm_eps", 0.000001)),
        TR_qk_norm: y.qk_normu, TR_head_dim: TR_Int(TR_config_value(TR_config, "head_dim", TR_Int(boyut // bakış))),
        TR_rope_theta: TR_rope_theta(TR_config), TR_merged_kv: TR_true, TR_merged_gate: TR_true, TR_weight_dtype: TR_weight_dtype, TR_init_std: 0.0)
}

# rope_tabanı: üst düzeyde rope_theta (eski transformers) ya da rope_parameters.rope_theta (5.x);
# ikisi de yoksa Llama'nın varsayılanı 10000.
TR_func TR_rope_theta(TR_config) -> TR_Float {
    TR_var üst = TR_config_value(TR_config, "rope_theta", TR_none)
    TR_if üst != TR_none { TR_return TR_Float(üst) }
    TR_var p = TR_config_value(TR_config, "rope_parameters", TR_none)
    TR_if p != TR_none TR_and TR_config_value(p, "rope_theta", TR_none) != TR_none { TR_return TR_Float(p["rope_theta"]) }
    TR_return 10000.0
}

TR_func TR_has_rope_scaling(TR_config) -> TR_Bool {
    TR_var ölçek = TR_config_value(TR_config, "rope_scaling", TR_none)
    TR_if ölçek != TR_none { TR_return TR_true }
    TR_var p = TR_config_value(TR_config, "rope_parameters", TR_none)
    TR_return p != TR_none TR_and TR_String(TR_config_value(p, "rope_type", "default")) != "default"
}

# Blok içi Hugging Face adı → [TR adı, devrik mi, birleşik katmandaki parça (-1: tek başına)].
# Parçalı ağırlıklar (devrildikten sonra) son eksende sırayla bitiştirilir: [K | V], [G | U].
TR_const TR_BLOCK_NAMES = {
    "self_attn.q_proj.weight": ["TR_mem_attention.TR_mem_q_proj.TR_mem_weight", TR_true, -1],
    "self_attn.k_proj.weight": ["TR_mem_attention.TR_mem_kv_proj.TR_mem_weight", TR_true, 0],
    "self_attn.v_proj.weight": ["TR_mem_attention.TR_mem_kv_proj.TR_mem_weight", TR_true, 1],
    "self_attn.o_proj.weight": ["TR_mem_attention.TR_mem_o_proj.TR_mem_weight", TR_true, -1],
    "self_attn.q_norm.weight": ["TR_mem_attention.TR_mem_q_norm.TR_mem_weight", TR_false, -1],
    "self_attn.k_norm.weight": ["TR_mem_attention.TR_mem_k_norm.TR_mem_weight", TR_false, -1],
    "mlp.gate_proj.weight": ["TR_mem_feed_forward.TR_mem_gate_up_proj.TR_mem_weight", TR_true, 0],
    "mlp.up_proj.weight": ["TR_mem_feed_forward.TR_mem_gate_up_proj.TR_mem_weight", TR_true, 1],
    "mlp.down_proj.weight": ["TR_mem_feed_forward.TR_mem_down_proj.TR_mem_weight", TR_true, -1],
    "input_layernorm.weight": ["TR_mem_input_norm.TR_mem_weight", TR_false, -1],
    "post_attention_layernorm.weight": ["TR_mem_post_attention_norm.TR_mem_weight", TR_false, -1]
}

# hugging_face_eşle Hugging Face adlı ağırlık sözlüğünü TR parametre adlarına çevirir. Paylaşımlı
# gömmede lm_head.weight varsa gömmeyle aynı olmalıdır ve atlanır; dönüş tabloları
# (rotary_emb.inv_freq) hesaplanır, atlanır. Tanınmayan ad hatadır.
TR_func TR_map_hugging_face(TR_weights: TR_Dict[TR_String, TR_Tensor], TR_config) -> TR_Dict[TR_String, TR_Tensor] {
    TR_var paylaşımlı = TR_Bool(TR_config_value(TR_config, "tie_word_embeddings", TR_false))
    TR_var sonuç_sözlük = {}
    TR_var parçalı = {} # TR adı → [ilk parça, ikinci parça]
    TR_for ad, t TR_in TR_weights {
        TR_if ad.TR_ends_with("rotary_emb.inv_freq") { TR_continue }
        TR_if ad == "model.embed_tokens.weight" {
            sonuç_sözlük["TR_mem_embedding.TR_mem_table"] = t
        } TR_else TR_if ad == "model.norm.weight" {
            sonuç_sözlük["TR_mem_final_norm.TR_mem_weight"] = t
        } TR_else TR_if ad == "lm_head.weight" {
            TR_if TR_not paylaşımlı { sonuç_sözlük["TR_mem_logit_layer.TR_mem_weight"] = t.TR_transpose() }
        } TR_else TR_if ad.TR_starts_with("model.layers.") {
            TR_var parçalar = ad.TR_split(".")
            TR_var iç = parçalar[3..parçalar.TR_length].TR_join(".")
            TR_if TR_not TR_BLOCK_NAMES.TR_contains(iç) { TR_throw TR_Message("H6945", "model", ad) }
            TR_var hedef = TR_BLOCK_NAMES[iç]
            TR_var tr_ad = "TR_mem_blocks.\(parçalar[2]).\(hedef[0])"
            TR_var w = t
            TR_if hedef[1] { w = t.TR_transpose() }
            TR_if hedef[2] < 0 {
                sonuç_sözlük[tr_ad] = w
            } TR_else {
                TR_if TR_not parçalı.TR_contains(tr_ad) { parçalı[tr_ad] = [TR_none, TR_none] }
                parçalı[tr_ad][hedef[2]] = w
            }
        } TR_else {
            TR_throw TR_Message("H6945", "model", ad)
        }
    }
    TR_for tr_ad, p TR_in parçalı {
        TR_if p[0] == TR_none TR_or p[1] == TR_none { TR_throw TR_Message("H6946", "model", tr_ad) }
        sonuç_sözlük[tr_ad] = TR_concat(p, TR_dim: -1)
    }
    TR_return sonuç_sözlük
}

# hazır_gguf modeli tek GGUF dosyasından kurar (dil tanımı 15.55): boyutlar üstveriden gelir, her
# parametrenin türü dosyadaki tensörün türüdür; nicemlenmiş ağırlık [çıkış, giriş] kalır, alan onun
# devriğini tutar: Doğrusal `x @ ağırlık` yazar, çarpım bu görünümü tanır (15.53). Birleşik katman
# kurulmaz: nicemlenmiş `TR_concat` hatadır, Q4_K_M'de attn_k ile attn_v ayrı türde olabilir.
# Model küçük boyutlarla kurulur, alanlar dosyanın tensörleriyle değişir: tam boyutlu sıfırlar hiç
# ayrılmaz; Qwen3-4B'de 16 GB olurdu [hesap]. Türev izlenmez: ağırlıklar yapraktır, türevsizdir.
TR_func TR_pretrained_gguf(yol: TR_String) -> TR_GPT {
    TR_var üst = TR_load_metadata(yol)
    TR_var mimari = TR_String(TR_config_value(üst, "general.architecture", ""))
    # Kapıların sırası (15.55): mimari (H6940), bilinmeyen anahtar (H7160), değerler, tensörler.
    TR_var y = _yapı(mimari, "gguf")
    _gguf_anahtar_kapısı(üst, y, yol)
    _gguf_kapıları(üst, mimari)
    TR_var boyut = TR_Int(_gguf_gerekli(üst, "\(mimari).embedding_length"))
    TR_var bakış = TR_Int(_gguf_gerekli(üst, "\(mimari).attention.head_count"))
    TR_var kv = TR_Int(TR_config_value(üst, "\(mimari).attention.head_count_kv", bakış))
    TR_var bb = TR_Int(TR_config_value(üst, "\(mimari).attention.key_length", TR_Int(boyut // bakış)))
    # RoPE bütün bakış boyutuna uygulanır: dosya daha azını isterse model hatasız kurulur, yanlış metin üretir.
    TR_var dönen = "\(mimari).rope.dimension_count"
    TR_if TR_Int(TR_config_value(üst, dönen, bb)) != bb { TR_throw TR_Message("H6943", "gguf", dönen) }
    TR_var ara = TR_Int(_gguf_gerekli(üst, "\(mimari).feed_forward_length"))
    TR_var eps = TR_Float(_gguf_gerekli(üst, "\(mimari).attention.layer_norm_rms_epsilon"))
    TR_var katman = TR_Int(_gguf_gerekli(üst, "\(mimari).block_count"))
    TR_var tensörler = TR_load_tensors(yol)
    TR_var dağarcık = TR_Int(TR_config_value(üst, "\(mimari).vocab_size", _gguf_tensör(tensörler, "token_embd.weight").TR_shape[0]))
    TR_var alınan: TR_Dict[TR_String, TR_Bool] = {}
    TR_var bağlam = TR_Int(TR_config_value(üst, "\(mimari).context_length", 2048))
    TR_var taban = TR_Float(TR_config_value(üst, "\(mimari).rope.freq_base", 10000.0))
    TR_var model = TR_GPT(1, TR_context: bağlam, TR_embed_dim: 2, TR_num_layers: 1,
        TR_num_heads: bakış, TR_num_kv_heads: kv, TR_intermediate_dim: 2, TR_tied: TR_true, TR_eps: eps, TR_qk_norm: y.qk_normu,
        TR_head_dim: bb, TR_rope_theta: taban, TR_merged_kv: TR_false, TR_merged_gate: TR_false, TR_init_std: 0.0)
    TR_if y.rope_bölenleri TR_and tensörler.TR_contains("rope_freqs.weight") {
        _gguf_rope_bölenleri(model, _gguf_al(tensörler, alınan, "rope_freqs.weight", [bb // 2]), bağlam, bb, taban)
    }
    model.TR_embedding.TR_table = _gguf_al(tensörler, alınan, "token_embd.weight", [dağarcık, boyut])
    model.TR_final_norm.TR_weight = _gguf_al(tensörler, alınan, "output_norm.weight", [boyut])
    TR_var paylaşımlı = TR_not tensörler.TR_contains("output.weight")
    TR_if TR_not paylaşımlı {
        model.TR_logit_layer = TR_Linear(1, 1, TR_init_std: 0.0)
        model.TR_logit_layer.TR_weight = _gguf_al(tensörler, alınan, "output.weight", [dağarcık, boyut]).TR_transpose()
    }
    model.TR_blocks = [_gguf_blok(tensörler, alınan, y, [boyut, bakış, kv, bb, ara], eps, i) TR_for i TR_in 0..katman]
    TR_for ad, t TR_in tensörler {
        TR_if TR_not alınan.TR_contains(ad) { TR_throw TR_Message("H6945", "gguf", ad) }
    }
    model.TR_config["dağarcık"] = dağarcık
    model.TR_config["embed_dim"] = boyut
    model.TR_config["katman"] = katman
    model.TR_config["ara_boyut"] = ara
    model.TR_config["paylaşımlı"] = paylaşımlı
    TR_return model
}

# _gguf_gerekli üstverinin zorunlu anahtarını verir.
TR_func _gguf_gerekli(üst: TR_JSON, anahtar: TR_String) -> TR_JSON {
    TR_var v = TR_config_value(üst, anahtar, TR_none)
    TR_if v == TR_none { TR_throw TR_Message("H6699", anahtar) }
    TR_return v
}

# _gguf_kapıları safetensors yolunun kapılarıdır: config.json'a baktıkları için burada kendiliğinden
# geçmezler. RoPE ölçeği uygulanmazsa model hatasız yüklenir, yanlış metin üretir. Bulunan anahtar
# iletide yazılır; llama.cpp'de ölçek 0 ve 1 etkisizdir. Bağlam yoksa 2048'dir; 0 ve eksi, tabloyu
# boş kurar, hata uzaktaki bir çarpımda çıkardı.
TR_func _gguf_kapıları(üst: TR_JSON, mimari: TR_String) {
    TR_var uzunluk = "\(mimari).context_length"
    TR_var bağlam = TR_Int(TR_config_value(üst, uzunluk, 2048))
    TR_if bağlam < 1 { TR_throw TR_Message("H7155", uzunluk, bağlam) }
    TR_var pencere = "\(mimari).attention.sliding_window"
    TR_if TR_config_value(üst, pencere, TR_none) != TR_none { TR_throw TR_Message("H6944", "gguf", pencere) }
    TR_var çeşit = "\(mimari).rope.scaling.type"
    TR_if TR_String(TR_config_value(üst, çeşit, "none")) != "none" { TR_throw TR_Message("H6943", "gguf", çeşit) }
    TR_for anahtar TR_in ["\(mimari).rope.scaling.factor", "\(mimari).rope.scale_linear"] {
        TR_var ölçek = TR_Float(TR_config_value(üst, anahtar, 1.0))
        TR_if ölçek != 0.0 TR_and ölçek != 1.0 { TR_throw TR_Message("H6943", "gguf", anahtar) }
    }
}

# _gguf_tensör adı dosyada olmayan tensörde hata verir.
TR_func _gguf_tensör(tensörler: TR_Dict[TR_String, TR_Tensor], ad: TR_String) -> TR_Tensor {
    TR_if TR_not tensörler.TR_contains(ad) { TR_throw TR_Message("H6697", ad) }
    TR_return tensörler[ad]
}

# _gguf_al tensörü şekli denetlenerek alır ve alınanlara işler: alınmayan ad sonda hatadır.
TR_func _gguf_al(tensörler: TR_Dict[TR_String, TR_Tensor], alınan: TR_Dict[TR_String, TR_Bool], ad: TR_String, şekil: TR_List[TR_Int]) -> TR_Tensor {
    TR_var t = _gguf_tensör(tensörler, ad)
    TR_if t.TR_shape != şekil { TR_throw TR_Message("H6698", ad, t.TR_shape, şekil) }
    alınan[ad] = TR_true
    TR_return t
}

# _gguf_rope_bölenleri döner konum tablolarını dosyanın frekans bölenleriyle yeniden kurar. Llama 3.1
# ve 3.2'de RoPE ölçeği üstveride değil bu tensördedir; tensör isteğe bağlıdır, yoksa bölen 1'dir
# (llama.cpp `src/models/llama.cpp:66`). Bölen her konumda uygulanır, eşik yoktur: `theta / ff`
# (`ggml/src/ggml-cpu/ops.cpp`, `ggml_rope_cache_init`). Sıfır ya da NaN bölen modeli hatasız kurar,
# açıları sessizce bozardı; bölenin açısı en büyük konumda da float32'ye sığmalıdır.
TR_func _gguf_rope_bölenleri(model: TR_GPT, t: TR_Tensor, bağlam: TR_Int, bb: TR_Int, taban: TR_Float) {
    TR_if TR_not ["float32", "fp16", "bf16"].TR_contains(t.TR_dtype) { TR_throw TR_Message("H7040", "rope_freqs.weight", t.TR_dtype) }
    TR_var bölenler = t.TR_to_dtype("float32").TR_tolist
    TR_var frekanslar = []
    TR_for i, bölen TR_in bölenler {
        TR_var frekans = taban ** (-2.0 * i / bb)
        TR_if TR_not TR_is_finite(bölen) TR_or bölen <= 0.0 TR_or bağlam * frekans / bölen > 3.4e38 {
            TR_throw TR_Message("H7041", "rope_freqs.weight", i, bölen)
        }
        frekanslar.TR_append(frekans / bölen)
    }
    TR_var açılar = TR_Tensor([[p * 1.0] TR_for p TR_in 0..bağlam]) @ TR_Tensor([frekanslar]) # [bağlam, yarım]
    model.TR_cos_table = TR_cos(açılar)
    model.TR_sin_table = TR_sin(açılar)
}

# _gguf_satır_sırası dönüştürücünün `attn_q` ve `attn_k`'da yaptığı sıralamayı geri alan indekstir.
# convert_hf_to_gguf.py bakış içindeki satırları [çift yarı | tek yarı]'dan iç içeye dizer: llama.cpp
# yan yana çiftleri döndürür, TR ve Hugging Face yarıları (rotate_half). Bakış boyutu 8'de dönüştürücü
# [0, 4, 1, 5, 2, 6, 3, 7], bu indeks [0, 2, 4, 6, 1, 3, 5, 7] verir. Yapılmazsa model hatasız
# yüklenir, yanlış metin üretir.
TR_func _gguf_satır_sırası(bakış: TR_Int, bakış_boyutu: TR_Int) -> TR_Tensor[TR_Int] {
    TR_var yarı = bakış_boyutu // 2
    TR_var sıra = []
    TR_for h TR_in 0..bakış {
        TR_for r TR_in 0..bakış_boyutu {
            sıra.TR_append(h * bakış_boyutu + TR_if r < yarı { 2 * r } TR_else { 2 * (r - yarı) + 1 })
        }
    }
    TR_return TR_Tensor[TR_Int](sıra)
}

# _gguf_doğrusal Doğrusal'ın ağırlığını kurar: alan [çıkış, giriş] tensörün devriğidir.
TR_func _gguf_doğrusal(k: TR_Linear, t: TR_Tensor) { k.TR_weight = t.TR_transpose() }

# _gguf_blok N. bloğu dosyanın tensörleriyle kurar. boyutlar: [boyut, bakış, kv, bakış boyutu, ara].
TR_func _gguf_blok(tensörler: TR_Dict[TR_String, TR_Tensor], alınan: TR_Dict[TR_String, TR_Bool], y: _Yapı, boyutlar: TR_List[TR_Int], eps: TR_Float, i: TR_Int) -> TR_TransformerBlock {
    TR_var boyut = boyutlar[0]
    TR_var bakış = boyutlar[1]
    TR_var kv = boyutlar[2]
    TR_var bb = boyutlar[3]
    TR_var ara = boyutlar[4]
    TR_var q_boy = bakış * bb
    TR_var kv_boy = kv * bb
    TR_var b = TR_TransformerBlock(2, bakış, TR_num_kv_heads: kv, TR_intermediate_dim: 2, TR_init_std: 0.0, TR_output_init_std: 0.0,
        TR_eps: eps, TR_qk_norm: y.qk_normu, TR_merged_kv: TR_false, TR_merged_gate: TR_false, TR_head_dim: bb)
    TR_var ön = "blk.\(i)."
    TR_var q = _gguf_al(tensörler, alınan, ön + "attn_q.weight", [q_boy, boyut])
    TR_var k = _gguf_al(tensörler, alınan, ön + "attn_k.weight", [kv_boy, boyut])
    TR_if y.gguf_satır_sırası {
        q = q[_gguf_satır_sırası(bakış, bb)]
        k = k[_gguf_satır_sırası(kv, bb)]
    }
    TR_var dikkat = b.TR_attention
    _gguf_doğrusal(dikkat.TR_q_proj, q)
    _gguf_doğrusal(dikkat.TR_k_proj, k)
    _gguf_doğrusal(dikkat.TR_v_proj, _gguf_al(tensörler, alınan, ön + "attn_v.weight", [kv_boy, boyut]))
    _gguf_doğrusal(dikkat.TR_o_proj, _gguf_al(tensörler, alınan, ön + "attn_output.weight", [boyut, q_boy]))
    TR_if y.qk_normu {
        dikkat.TR_q_norm.TR_weight = _gguf_al(tensörler, alınan, ön + "attn_q_norm.weight", [bb])
        dikkat.TR_k_norm.TR_weight = _gguf_al(tensörler, alınan, ön + "attn_k_norm.weight", [bb])
    }
    TR_var ileri = b.TR_feed_forward
    _gguf_doğrusal(ileri.TR_gate_proj, _gguf_al(tensörler, alınan, ön + "ffn_gate.weight", [ara, boyut]))
    _gguf_doğrusal(ileri.TR_up_proj, _gguf_al(tensörler, alınan, ön + "ffn_up.weight", [ara, boyut]))
    _gguf_doğrusal(ileri.TR_down_proj, _gguf_al(tensörler, alınan, ön + "ffn_down.weight", [boyut, ara]))
    b.TR_input_norm.TR_weight = _gguf_al(tensörler, alınan, ön + "attn_norm.weight", [boyut])
    b.TR_post_attention_norm.TR_weight = _gguf_al(tensörler, alınan, ön + "ffn_norm.weight", [boyut])
    TR_return b
}

# Yapı tanımı (15.55): mimariyle seçilir (config.json'un model_type'ı, GGUF'un general.architecture'ı);
# modelin bilinen anahtarlarını ve kuruluş seçeneklerini verir. Tanımda olmayan anahtar yükleme
# hatasıdır (H7160): okunmayan bir anahtar hesabı değiştirebilir, model hatasız yüklenip yanlış metin
# üretirdi. Sohbet tanımı (durma adları, sohbet biçimi) ayrı bir tablodur.
TR_struct _Yapı {
    mimari: TR_String
    ayar: TR_List[TR_String] # config.json'un bilinen üst düzey anahtarları
    alt: TR_Dict[TR_String, TR_List[TR_String]] # sözlük değerli anahtarların bilinen alt anahtarları
    gguf: TR_List[TR_String] # GGUF'ta "<mimari>." önekinden sonraki bilinen adlar
    qk_normu: TR_Bool # q ve k bakış boyutunda RMS normundan geçer (qwen3)
    gguf_satır_sırası: TR_Bool # dönüştürücü attn_q ile attn_k'nın satırlarını dizmiştir (llama)
    rope_bölenleri: TR_Bool # GGUF'un rope_freqs.weight tensörü okunur (llama)
}

# Okunan config anahtarları (hazır_model_kur ve hugging_face_eşle).
TR_const _AYAR_OKUNUR = ["model_type", "vocab_size", "hidden_size", "intermediate_size", "num_hidden_layers", "num_attention_heads",
    "num_key_value_heads", "head_dim", "max_position_embeddings", "rms_norm_eps", "rope_theta", "rope_parameters", "tie_word_embeddings"]
# Değeri denetlenen anahtarlar: desteklenmeyen değer hatadır (H6941–H6944, H7171).
TR_const _AYAR_DENETLENİR = ["attention_bias", "mlp_bias", "hidden_act", "use_sliding_window", "rope_scaling", "attention_dropout",
    "pretraining_tp", "rope_interleaved"]
# Etkisiz anahtarlar: değeri değişince logitler bit bit aynıdır. architectures, _name_or_path ve
# transformers_version kaydı anlatır; torch_dtype ve dtype transformers'ın yükleme türüdür (TR türü
# safetensors başlığından alır, ayrıca TR_weight_dtype:); use_cache transformers'ın üretim seçeneğidir;
# initializer_range yalnız sıfırdan ilklemededir; pad_token_id ve bos_token_id'yi parçalayıcı ya da
# sohbet biçimi koyar, model değil; is_llama_config, unsloth_fixed ve transformers.js_config dışa
# aktaran aracın işaretidir. eos_token_id durma kimliğinin kaynağıdır, modelin hesabına girmez.
TR_const _AYAR_ETKİSİZ = ["architectures", "_name_or_path", "torch_dtype", "dtype", "transformers_version", "use_cache",
    "initializer_range", "pad_token_id", "bos_token_id", "is_llama_config", "unsloth_fixed", "transformers.js_config", "eos_token_id"]
# RoPE ölçeğinin alt anahtarları; ölçek desteklenmez (H6943), ama anahtarı bilinir: ileti ölçeği söyler.
TR_const _ÖLÇEK_ALT = ["rope_type", "type", "factor", "low_freq_factor", "high_freq_factor", "original_max_position_embeddings"]
# GGUF'un "<mimari>." anahtarları: okunanlar ve değeri denetlenenler (_gguf_kapıları; value_length
# V ağırlığının şekliyle denetlenir, H6698).
TR_const _GGUF_ANAHTARLARI = ["block_count", "embedding_length", "feed_forward_length", "attention.head_count", "attention.head_count_kv",
    "attention.key_length", "attention.value_length", "attention.layer_norm_rms_epsilon", "context_length", "rope.freq_base", "vocab_size",
    "rope.dimension_count", "rope.scaling.type", "rope.scaling.factor", "rope.scale_linear", "rope.scaling.original_context_length",
    "attention.sliding_window"]
# GGUF'un kapıya girmeyen önekleri: üstveri, parçalayıcı (16.1), bölünmüş dosya ve nicemleme kaydı.
TR_const _GGUF_SERBEST = ["general", "tokenizer", "split", "quantize"]

# _yapı mimarinin yapı tanımını verir; tabloda olmayan mimari H6940'tır (yol: "gguf" ya da "model").
TR_func _yapı(mimari: TR_String, yol: TR_String) -> _Yapı {
    TR_var ayar = _AYAR_OKUNUR + _AYAR_DENETLENİR + _AYAR_ETKİSİZ
    TR_var alt = {"rope_scaling": _ÖLÇEK_ALT, "rope_parameters": ["rope_theta"] + _ÖLÇEK_ALT}
    TR_if mimari == "llama" {
        TR_return _Yapı(mimari: mimari, ayar: ayar, alt: alt, gguf: _GGUF_ANAHTARLARI, qk_normu: TR_false, gguf_satır_sırası: TR_true, rope_bölenleri: TR_true)
    }
    TR_if mimari == "qwen3" {
        # sliding_window ve max_window_layers yalnız use_sliding_window doğruyken okunur, o da H6944'tür;
        # layer_types (transformers 5) katman başına dikkat türüdür, yalnız "full_attention" desteklenir.
        TR_return _Yapı(mimari: mimari, ayar: ayar + ["sliding_window", "max_window_layers", "layer_types"], alt: alt, gguf: _GGUF_ANAHTARLARI,
            qk_normu: TR_true, gguf_satır_sırası: TR_false, rope_bölenleri: TR_false)
    }
    TR_throw TR_Message("H6940", yol, mimari, TR_SUPPORTED_ARCHITECTURES)
}

# _ayar_kapısı config.json'un tanımda olmayan anahtarlarını (alt anahtarlar dahil) hepsiyle birlikte
# söyler (H7160) ve bir ayarın iki yolu ayrı değer verirse durur (H7161). dosya iletide yazılır ("" yazılmaz).
TR_func _ayar_kapısı(TR_config: TR_JSON, y: _Yapı, dosya: TR_String) {
    TR_var bilinmeyen: TR_List[TR_String] = []
    TR_for anahtar TR_in TR_config.TR_keys() {
        TR_var ad = TR_String(anahtar)
        TR_if TR_not y.ayar.TR_contains(ad) {
            bilinmeyen.TR_append(ad)
        } TR_else TR_if y.alt.TR_contains(ad) TR_and TR_config_value(TR_config, ad, TR_none) != TR_none {
            TR_for a TR_in TR_config[ad].TR_keys() {
                TR_if TR_not y.alt[ad].TR_contains(TR_String(a)) { bilinmeyen.TR_append("\(ad).\(a)") }
            }
        }
    }
    TR_if bilinmeyen.TR_length > 0 { TR_throw TR_Message("H7160", "model", y.mimari, dosya, bilinmeyen.TR_length, bilinmeyen.TR_join(", ")) }
    TR_var üst = TR_config_value(TR_config, "rope_theta", TR_none)
    TR_var p = TR_config_value(TR_config, "rope_parameters", TR_none)
    TR_if üst != TR_none TR_and p != TR_none TR_and TR_config_value(p, "rope_theta", TR_none) != TR_none {
        TR_if TR_Float(üst) != TR_Float(p["rope_theta"]) {
            TR_throw TR_Message("H7161", "model", "rope_theta", "rope_parameters.rope_theta", TR_Float(üst), TR_Float(p["rope_theta"]))
        }
    }
}

# _gguf_anahtar_kapısı dört serbest önekin dışındaki her GGUF anahtarına bakar: "<mimari>." ile başlayıp
# tanımda olmayan, başka bir mimarinin öneki (qwen3 dosyasında llama.) ve yeni bir önek H7160'tır.
TR_func _gguf_anahtar_kapısı(üst: TR_JSON, y: _Yapı, yol: TR_String) {
    TR_var bilinen = y.gguf.TR_map((s) => "\(y.mimari).\(s)")
    TR_var bilinmeyen: TR_List[TR_String] = []
    TR_for anahtar TR_in üst.TR_keys() {
        TR_var ad = TR_String(anahtar)
        TR_if TR_not _GGUF_SERBEST.TR_contains(ad.TR_split(".")[0]) TR_and TR_not bilinen.TR_contains(ad) { bilinmeyen.TR_append(ad) }
    }
    TR_if bilinmeyen.TR_length > 0 { TR_throw TR_Message("H7160", "gguf", y.mimari, yol, bilinmeyen.TR_length, bilinmeyen.TR_join(", ")) }
}

# _ayar_değerleri transformers'ta hesabı değiştiren ama TR'nin uygulamadığı üç ayarın değerini
# denetler: dikkat bırakması (eğitimde), bölünmüş doğrusal katman (pretraining_tp) ve iç içe RoPE;
# qwen3'ün layer_types'ı (transformers 5) katman başına dikkat türüdür, yalnız "full_attention" desteklenir.
TR_func _ayar_değerleri(TR_config: TR_JSON) {
    TR_for tür TR_in TR_config_value(TR_config, "layer_types", []) {
        TR_if TR_String(tür) != "full_attention" { TR_throw TR_Message("H6944", "model", "layer_types") }
    }
    TR_var bırakma = TR_Float(TR_config_value(TR_config, "attention_dropout", 0.0))
    TR_if bırakma != 0.0 { TR_throw TR_Message("H7171", "attention_dropout", "\(bırakma)", "0.0") }
    TR_var tp = TR_Int(TR_config_value(TR_config, "pretraining_tp", 1))
    TR_if tp != 1 { TR_throw TR_Message("H7171", "pretraining_tp", "\(tp)", "1") }
    TR_if TR_Bool(TR_config_value(TR_config, "rope_interleaved", TR_false)) { TR_throw TR_Message("H7171", "rope_interleaved", "true", "false") }
}

# _kur hazır_model'in kuruluşudur: anahtar kapısı config.json'un yoluyla (iletide yazılır), sonra
# hazır_model_kur.
TR_func _kur(ayar: TR_JSON, tür: TR_String, dosya: TR_String) -> TR_GPT {
    _ayar_kapısı(ayar, _yapı(TR_String(TR_config_value(ayar, "model_type", "")), "model"), dosya)
    TR_return TR_build_pretrained_model(ayar, TR_weight_dtype: tür)
}
