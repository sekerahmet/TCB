# TR 4
# Kodlu saklama (docs/spec/17_kodlar.md): dosya kimliklerle yazılır (2.1, 2.3a), kullanıcının adları
# olduğu gibi. Kodlu modüller: tests/coded/ornek_kodlu.tr, tests/coded/sozluk_anahtari.tr (bir dildeki
# gösterimi: tr show tests/coded/ornek_kodlu.tr --lang tr).
TR_import "coded/ornek_kodlu" TR_as m
TR_import "coded/sozluk_anahtari" TR_as anahtarlı

TR_test "17.1 ilk satırı başlık olan dosya çevrilmeden çalışır" {
    TR_assert_equal([1, 4, 9], m.kareler([1, 2, 3]))
    # Başka bir başlığın ve başlıksızlığın hatası: tests/negative/kodlu_surum.tr, basliksiz.tr
}

TR_test "17.2 dilin sözcükleri kimlikle, kullanıcının adları adıyla yazılır" {
    # Kimlik olmayan her ad kullanıcının adıdır: modüldeki 'eğer' bir değişkendir.
    TR_assert_equal(7, m["eğer"])
    TR_assert_equal("x", m.yakalanan())
}

TR_test "17.3 neyin kodlandığını kapsam belirler; üyeler tanımda ve kullanımda aynı kodla" {
    # Gölgelenen 'toplam' modülde kullanıcının adıdır.
    TR_assert_equal(5, m.golge())
    # Modüldeki yapının TR_append metodu ve TR_length alanı burada da kimlikleriyle çağrılır.
    TR_var s = m.Sayac()
    s.TR_append(2)
    s.TR_append(3)
    TR_assert_equal(5, s.TR_length)
    # Üyenin kimliğiyle yazılan sözlük anahtarı ({TR_step: 3}) kimliğin dilden bağımsız adıyla
    # saklanır ("step") ve üye erişimiyle bulunur; bir dildeki adı ("adım") anahtar değildir.
    TR_assert_equal(3, anahtarlı.ayar["step"])
    TR_assert_equal(3, anahtarlı.ayar["step"])
    TR_assert_equal(TR_false, anahtarlı.ayar.TR_contains("adım"))
    TR_assert_equal(["step", "renk"], anahtarlı.ayar.TR_keys())
}

TR_test "17.4 metinler, ham metin ve yorumlar olduğu gibi kalır; yerleştirmedeki kodlar çalışır" {
    TR_assert_equal("toplam: 6.0, eğer: 7, ham: " + `{TR_fn_sum}`, m.bilgi())
}

TR_test "17.7 hiçbir yazım dili asıl dil değildir: dillerin sözcükleri dosyada kullanıcının adıdır" {
    # İngilizcenin ve Türkçenin sözcükleri (var, print, if, eğer, değişken) sıradan adlardır; dilin
    # sözcükleri yalnız TR_ ile yazılır. '$ad' kaçışı dosyada yoktur: tests/negative/dolar_isareti.tr
    TR_var var = 1
    TR_var print = var + 1
    TR_func if(x) { TR_return x * 2 }
    TR_assert_equal(4, if(print))
    TR_var eğer = 3
    TR_var değişken = eğer + 1
    TR_assert_equal(4, değişken)
}

TR_test "17.8 komut satırı adları kodludur: programın yardım seçeneğinin her dildeki adı ayrılmıştır" {
    # tr komutlarının, seçeneklerin, kabuğun ve hata ayıklayıcının adları Go testleriyle
    # sınanır (dil tanımı 17.8, Sınamalar); programın --yardım'ı (TR_opt_help) her dilde ayrılmıştır.
    TR_assert_equal("H7221", TR_error_code { TR_command_line({"yardım": TR_true}) })
    TR_assert_equal("H7221", TR_error_code { TR_command_line({"help": TR_true}) })
    TR_assert_equal("H7221", TR_error_code { TR_command_line({"h": TR_true}) })
}
