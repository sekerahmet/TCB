//! tr kodlu 3 dil=tr
// Kodlu saklama (docs/spec/17_kodlar.md, 17.1-17.7) ve '$ad' kaçışı (2.11). Kodlu modül:
// tests/coded/ornek_kodlu.tr (Türkçe gösterimi: tr göster tests/coded/ornek_kodlu.tr).

TR_kw_import "yardimci_test_araclari"

TR_ctx_test "17.1 ilk satırı başlık olan dosya kodludur ve çevrilmeden çalışır" {
    TR_kw_import "coded/ornek_kodlu" TR_ctx_as m
    TR_fn_assert_equal([1, 4, 9], m.kareler([1, 2, 3]))
    // Başka bir kodlu biçim sürümü (burada eski sürüm 2) Türkçe kaynak sanılmaz, hatadır.
    TR_kw_var mesaj = ""
    TR_kw_try { TR_kw_import "negative/kodlu_surum" } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("Satır 1, Sütun 1: '//! tr kodlu 2 dil=tr' okunamayan bir kodlu biçim başlığı: bu biçim sürümü okunamıyor"), mesaj)
}

TR_ctx_test "17.2 kodlu dosyada dilin sözcükleri kodla, kullanıcının adları adıyla yazılır" {
    TR_kw_import "coded/ornek_kodlu" TR_ctx_as m
    // Kod olmayan her ad kullanıcının adıdır: modüldeki 'eğer' bir değişkendir.
    TR_fn_assert_equal(7, m["eğer"])
    TR_fn_assert_equal("x", m.yakalanan())
}

TR_ctx_test "17.3 neyin kodlandığını kapsam belirler; üyeler tanımda ve kullanımda aynı kodla" {
    TR_kw_import "coded/ornek_kodlu" TR_ctx_as m
    // Gölgelenen 'toplam' modülde kullanıcının adıdır.
    TR_fn_assert_equal(5, m.golge())
    // Modüldeki yapının .TR_mem_append metodu ve .TR_mem_length alanı burada Türkçe adlarıyla çağrılır.
    TR_kw_var s = m.Sayac()
    s.TR_mem_append(2)
    s.TR_mem_append(3)
    TR_fn_assert_equal(5, s.TR_mem_length)
}

TR_ctx_test "17.4 metinler, ham metin ve yorumlar olduğu gibi kalır; yerleştirmedeki kodlar çalışır" {
    TR_kw_import "coded/ornek_kodlu" TR_ctx_as m
    TR_fn_assert_equal("toplam: 6.0, eğer: 7, ham: " + `{TR_fn_sum}`, m.bilgi())
}

TR_ctx_test "17.5 kodlu dosyada konumlar Türkçe gösterime göredir" {
    TR_kw_var mesaj = ""
    TR_kw_try { TR_kw_import "negative/kodlu_tanimsiz" } TR_kw_catch h { mesaj = h }
    // Gösterim: 'yazdır(a, tanımsız_ad)'; ad 11. sütunda (kodlu dosyada 'TR_fn_print(a, ' 16 karakter).
    TR_fn_assert(mesaj.TR_mem_contains("Satır 3, Sütun 11: Tanımsız ad — 'tanımsız_ad'"), mesaj)
}

TR_ctx_test "17.6 kod listesinde olmayan kimlik hatadır" {
    TR_kw_var mesaj = ""
    TR_kw_try { TR_kw_import "negative/kodlu_bilinmeyen" } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("Satır 2, Sütun 1: 'TR_fn_yok' bilinen bir kimlik değil"), mesaj)
}

TR_ctx_test "17.7 kodsuz dosya Türkçedir; başka yazım dillerinin sözcükleri burada kullanıcının adıdır" {
    // İngilizcenin sözcükleri (var, print, if) Türkçe yazılmış dosyada sıradan adlardır.
    TR_kw_var var = 1
    TR_kw_var print = var + 1
    TR_kw_func if(x) { TR_kw_return x * 2 }
    TR_fn_assert_equal(4, if(print))
    // Kodlu dosyada üyenin adıyla aynı sözlük anahtarı ({TR_mem_step: 3}) Türkçe adıyla okunur.
    TR_kw_import "coded/sozluk_anahtari" TR_ctx_as m
    TR_fn_assert_equal(3, m.ayar.TR_mem_step)
    TR_fn_assert_equal(3, m.ayar["adım"])
    TR_fn_assert_equal(["adım", "renk"], m.ayar.TR_mem_keys())
}

TR_ctx_test "2.11 '$ad' kaçışı: ad dilin bir sözcüğüyle aynı olsa da kullanıcının adıdır" {
    TR_kw_var eğer = 3
    TR_kw_var değişken = eğer + 1
    TR_fn_assert_equal(4, değişken)
    TR_kw_var mesaj = ""
    TR_kw_try { TR_kw_import "negative/kacis_bitisik" } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("Satır 3, Sütun 15: '$' kaçışı bir adın ya da sayının hemen ardından yazılamaz"), mesaj)
}

TR_ctx_test "17.8 komut satırı adları kodludur: programın yardım seçeneğinin her dildeki adı ayrılmıştır" {
    // tr komutlarının, seçeneklerin, kabuğun ve hata ayıklayıcının adları Go testleriyle
    // sınanır (dil tanımı 17.8, Sınamalar); programın --yardım'ı (TR_opt_help) her dilde ayrılmıştır.
    TR_fn_assert(hata_metni(() => TR_fn_command_line({yardım: TR_kw_true})).TR_mem_contains("seçenek adı olamaz"))
    TR_fn_assert(hata_metni(() => TR_fn_command_line({help: TR_kw_true})).TR_mem_contains("seçenek adı olamaz"))
    TR_fn_assert(hata_metni(() => TR_fn_command_line({h: TR_kw_true})).TR_mem_contains("seçenek adı olamaz"))
}
