// Kodlu saklama (docs/spec/17_kodlar.md, 17.1-17.7) ve '$ad' kaçışı (2.11). Kodlu modül:
// tests/coded/ornek_kodlu.tr (Türkçe gösterimi: tr göster tests/coded/ornek_kodlu.tr).

test "17.1 ilk satırı başlık olan dosya kodludur ve çevrilmeden çalışır" {
    aktar "coded/ornek_kodlu" olarak m
    eşit_mi([1, 4, 9], m.kareler([1, 2, 3]))
    // Bu sürümün tanımadığı bir kodlu biçim sürümü Türkçe kaynak sanılmaz, hatadır.
    değişken mesaj = ""
    dene { aktar "negative/kodlu_surum" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("Satır 1, Sütun 1: '//! tr kodlu 2' bu yorumlayıcının tanımadığı bir kodlu biçim başlığı"), mesaj)
}

test "17.2 kodlu dosyada dilin sözcükleri kodla, kullanıcının adları adıyla yazılır" {
    aktar "coded/ornek_kodlu" olarak m
    // Kod olmayan her ad kullanıcının adıdır: modüldeki 'eğer' bir değişkendir.
    eşit_mi(7, m["eğer"])
    eşit_mi("x", m.yakalanan())
}

test "17.3 neyin kodlandığını kapsam belirler; üyeler tanımda ve kullanımda aynı kodla" {
    aktar "coded/ornek_kodlu" olarak m
    // Gölgelenen 'toplam' modülde kullanıcının adıdır.
    eşit_mi(5, m.golge())
    // Modüldeki yapının .Y004 metodu ve .Y001 alanı burada Türkçe adlarıyla çağrılır.
    değişken s = m.Sayac()
    s.ekle(2)
    s.ekle(3)
    eşit_mi(5, s.uzunluk)
}

test "17.4 metinler, ham metin ve yorumlar olduğu gibi kalır; yerleştirmedeki kodlar çalışır" {
    aktar "coded/ornek_kodlu" olarak m
    eşit_mi("toplam: 6.0, eğer: 7, ham: " + `{G400}`, m.bilgi())
}

test "17.5 kodlu dosyada konumlar Türkçe gösterime göredir" {
    değişken mesaj = ""
    dene { aktar "negative/kodlu_tanimsiz" } yakala h { mesaj = h }
    // Gösterim: 'yazdır(a, tanımsız_ad)'; ad 11. sütunda (kodlu dosyada 'G100(a, ' 9 karakter).
    doğrula(mesaj.içerir("Satır 3, Sütun 11: Tanımsız ad — 'tanımsız_ad'"), mesaj)
}

test "17.6 kod listesinde olmayan kod hatadır" {
    değişken mesaj = ""
    dene { aktar "negative/kodlu_bilinmeyen" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("Satır 2, Sütun 1: 'G999' bilinen bir kod değil"), mesaj)
}

test "17.7 kodsuz dosya Türkçedir; başka yazım dillerinin sözcükleri burada kullanıcının adıdır" {
    // İngilizcenin sözcükleri (var, print, if) Türkçe yazılmış dosyada sıradan adlardır.
    değişken var = 1
    değişken print = var + 1
    fonksiyon if(x) { sonuç x * 2 }
    eşit_mi(4, if(print))
    // Kodlu dosyada üyenin adıyla aynı sözlük anahtarı ({Y500: 3}) Türkçe adıyla okunur.
    aktar "coded/sozluk_anahtari" olarak m
    eşit_mi(3, m.ayar.adım)
    eşit_mi(3, m.ayar["adım"])
    eşit_mi(["adım", "renk"], m.ayar.anahtarlar())
}

test "2.11 '$ad' kaçışı: ad dilin bir sözcüğüyle aynı olsa da kullanıcının adıdır" {
    değişken $eğer = 3
    değişken $değişken = $eğer + 1
    eşit_mi(4, $değişken)
    değişken mesaj = ""
    dene { aktar "negative/kacis_bitisik" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("Satır 3, Sütun 15: '$' kaçışı bir adın ya da sayının hemen ardından yazılamaz"), mesaj)
}

test "17.8 komut satırı adları kodludur: programın yardım seçeneğinin her dildeki adı ayrılmıştır" {
    // tr komutlarının, seçeneklerin, kabuğun ve hata ayıklayıcının adları Go testleriyle
    // sınanır (dil tanımı 17.8, Sınamalar); programın --yardım'ı (K106) her dilde ayrılmıştır.
    fonksiyon hata(f) {
        dene { f() } yakala h { sonuç h }
        sonuç ""
    }
    doğrula(hata(() => komut_satırı({yardım: doğru})).içerir("seçenek adı olamaz"))
    doğrula(hata(() => komut_satırı({help: doğru})).içerir("seçenek adı olamaz"))
    doğrula(hata(() => komut_satırı({h: doğru})).içerir("seçenek adı olamaz"))
}
