# TR 4
# TEST 5.4 hedefin zinciri: liste, sözlük ya da yapı hedefinin zincirindeki kopya adımı denetim hatasıdır (kabın öğesini veren üye H2741, tam sayı indeksli liste dilimi H2743, öbürü H2740)
TR_struct Nokta {
    x: TR_Int = 0
    y: TR_Int = 0
    TR_func liste() -> TR_List[TR_Int] { TR_return [7, 8] }
}
TR_var t = TR_Tensor([1, 2])
TR_var l = [1, 2, 3, 4]
TR_var m = [5]
TR_var j = TR_json_parse("[1, 2]")
TR_var p = Nokta()
TR_var d = {"a": [1]}
TR_var ll = [[1], [2]]
TR_var i = 1
TR_func f() -> TR_List[TR_Int] { TR_return l }
[1, 2][0] = 5 # ERROR H2740
(l + m)[0] = 1 # ERROR H2740
TR_List(j)[0] = j[1] # ERROR H2740
Nokta(1, 2).x = 3 # ERROR H2740
l[0..2][0] = 5 # ERROR H2743
f()[0] = 5 # ERROR H2740
p.liste()[0] = 5 # ERROR H2740
d.TR_get("a")[0] = 5 # ERROR H2741
l[0..2][i] = 9 # ERROR H2743
l[0..2][-1] = 9 # ERROR H2740
ll.TR_first[0] = 9 # ERROR H2741
f().TR_append(3) # ERROR H2740
d.TR_get("a").TR_append(3) # ERROR H2741
TR_print(t, l, m, j, p.x, d, ll)
