# TR 4
# TEST 5.3 çoklu atamada bir hedefin yeri solunda atanan bir adın ya da yolun yerine bakıyorsa denetim hatasıdır (yer eski değerle hesaplanır; kap öğesinde indeks fark etmez); sağında atanan adı okumak ve takas serbesttir
TR_struct SıraKutusu {
    b: TR_Int
    iç: TR_List[TR_Int]
}
TR_var l = [1, 2, 3]
TR_var i = 0
TR_var j = 1
TR_var p = [0, 1, 2]
TR_var m = [[0, 0], [0, 0]]
TR_var d = {"k": "k"}
TR_var a = SıraKutusu(1, [0])
i, l[i] = 1, 5 # ERROR H1160
i, l[i + 1] = l[0], i # ERROR H1160
a, a.b = SıraKutusu(2, [0]), 7 # ERROR H1160
a.iç, a.iç[0] = [4], 9 # ERROR H1160
p[i], p[p[j]] = 2, 9 # ERROR H1160
d["k"], d[d["k"]] = "a", "b" # ERROR H1160
l[i], l[j] = l[j], l[i]
m[i][0], m[j][1] = 1, 2
l[i], i = 9, 1
a.b, a.iç = 3, [5]
TR_print(l, i, a.b)
