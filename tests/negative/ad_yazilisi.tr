//! tr kodlu 3 dil=tr
// Bilerek kurala aykırı: 2.3b — yazılış kuralına uymayan adlar uyarıdır, hata değildir; modül
// yüklenir ve adları kullanılır.
TR_kw_var öğrenciSayısı = 3
TR_kw_const en_büyük = 10
TR_kw_struct önbellek_durumu { dolu = TR_kw_false }
TR_kw_func HazırModel() { TR_kw_return öğrenciSayısı * en_büyük }
