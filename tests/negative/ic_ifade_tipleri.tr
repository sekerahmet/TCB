// Bilerek hatalı: 3.13 — denetim her ifadenin içine iner; her satırda bir çağrı tip hatası.
fonksiyon kare(x: Tam): Tam { sonuç x * x }
değişken l = [kare("a")]
değişken s = {"k": kare("b")}
değişken a = 0..kare("c")
değişken m = "değer: {kare(1) + kare("d")}"
değişken ü = [kare("e") döngü x içinde 1..3]
değişken i = l[kare("f")]
değişken u = kare("g").x
l[kare("h")] = 1
yapı A {
    alan = kare("i")
    fonksiyon m() { sonuç kare("j") }
}
değişken e = eşle 1 { kare("k") => 1 }
fonksiyon g(p = kare("l")) { }
