# TR 4
# Bilerek hatalı: 3.13 — denetim her ifadenin içine iner; her satırda bir çağrı tip hatası.
TR_func kare(x: TR_Int): TR_Int { TR_return x * x }
TR_var l = [kare("a")]
TR_var s = {"k": kare("b")}
TR_var a = 0..kare("c")
TR_var m = "değer: \(kare(1) + kare("d"))"
TR_var ü = [kare("e") TR_for x TR_in 1..3]
TR_var i = l[kare("f")]
TR_var u = kare("g").x
l[kare("h")] = 1
TR_struct A {
    alan = kare("i")
    TR_func m() { TR_return kare("j") }
}
TR_var e = TR_match 1 { kare("k") => 1 }
