# TR 4
# Küçük sentetik Whisper açılır, kapılarından geçer, kodlayıcısı Hugging Face'in değerini verir (25.1).
# Ağırlıklar formülden gelir; başvurunun kaynağı ve lisansı: testdata/whisper/KAYNAK.md.

TR_import "tr/pretrained"
TR_import "tr/whisper"

TR_const _BOYUT = 8
TR_const _ARA = 16
TR_const _KAYNAK = 6
TR_const _HEDEF = 4
TR_const _DAĞARCIK = 12

# değerler ağırlığın öğelerini formülden kurar; aynı formül başvuruyu üretti.
TR_func değerler(tohum: TR_Int, n: TR_Int, ölçek: TR_Float) -> TR_List[TR_Float] {
    TR_return [(((i + 1) * 40503 + tohum * 9973) % 65536 - 32768) / 32768.0 * ölçek TR_for i TR_in 0..n]
}

# ölçek Q ve K'yı büyütür: küçük ağırlıkta dikkat düzdür, K ve önbellek yanlışı logitte görünmez.
TR_func ölçek(ad: TR_String) -> TR_Float {
    TR_if ad.TR_ends_with("q_proj.weight") TR_or ad.TR_ends_with("k_proj.weight") { TR_return 1.0 }
    TR_return 0.25
}

# Bir tensörün adı ve şekli.
TR_struct Ad {
    ad: TR_String
    şekil: TR_List[TR_Int]
}

TR_func dikkat(ön: TR_String) -> TR_List[Ad] {
    TR_var b = [_BOYUT, _BOYUT]
    TR_return [Ad(ad: "\(ön).q_proj.weight", şekil: b), Ad(ad: "\(ön).q_proj.bias", şekil: [_BOYUT]), Ad(ad: "\(ön).k_proj.weight", şekil: b),
        Ad(ad: "\(ön).v_proj.weight", şekil: b), Ad(ad: "\(ön).v_proj.bias", şekil: [_BOYUT]),
        Ad(ad: "\(ön).out_proj.weight", şekil: b), Ad(ad: "\(ön).out_proj.bias", şekil: [_BOYUT])]
}

TR_func norm(ön: TR_String) -> TR_List[Ad] { TR_return [Ad(ad: "\(ön).weight", şekil: [_BOYUT]), Ad(ad: "\(ön).bias", şekil: [_BOYUT])] }

TR_func blok(ön: TR_String, çözücü: TR_Bool) -> TR_List[Ad] {
    TR_var r = dikkat("\(ön).self_attn") + norm("\(ön).self_attn_layer_norm")
    TR_if çözücü { r = r + dikkat("\(ön).encoder_attn") + norm("\(ön).encoder_attn_layer_norm") }
    r = r + [Ad(ad: "\(ön).fc1.weight", şekil: [_ARA, _BOYUT]), Ad(ad: "\(ön).fc1.bias", şekil: [_ARA]),
        Ad(ad: "\(ön).fc2.weight", şekil: [_BOYUT, _ARA]), Ad(ad: "\(ön).fc2.bias", şekil: [_BOYUT])]
    TR_return r + norm("\(ön).final_layer_norm")
}

# adlar tensörleri sırayla verir: sıra formülün tohumudur.
TR_func adlar(mel: TR_Int) -> TR_List[Ad] {
    TR_var e = "model.encoder"
    TR_var d = "model.decoder"
    TR_var r = [Ad(ad: "\(e).conv1.weight", şekil: [_BOYUT, mel, 3]), Ad(ad: "\(e).conv1.bias", şekil: [_BOYUT]),
        Ad(ad: "\(e).conv2.weight", şekil: [_BOYUT, _BOYUT, 3]), Ad(ad: "\(e).conv2.bias", şekil: [_BOYUT]),
        Ad(ad: "\(e).embed_positions.weight", şekil: [_KAYNAK, _BOYUT])]
    r = r + blok("\(e).layers.0", TR_false) + blok("\(e).layers.1", TR_false) + norm("\(e).layer_norm")
    r = r + [Ad(ad: "\(d).embed_tokens.weight", şekil: [_DAĞARCIK, _BOYUT]), Ad(ad: "\(d).embed_positions.weight", şekil: [_HEDEF, _BOYUT])]
    TR_return r + blok("\(d).layers.0", TR_true) + norm("\(d).layer_norm")
}

TR_func ağırlıklar(mel: TR_Int = 80) -> TR_Dict[TR_String, TR_Tensor] {
    TR_var sonuç: TR_Dict[TR_String, TR_Tensor] = {}
    TR_for tohum, a TR_in adlar(mel) {
        TR_var n = 1
        TR_for boy TR_in a.şekil { n = n * boy }
        sonuç[a.ad] = TR_Tensor(değerler(tohum, n, ölçek(a.ad))).TR_reshape(a.şekil)
    }
    TR_return sonuç
}

# ayar config.json'un alanlarıdır; değerler JSON metni olarak tutulur.
TR_func ayar() -> TR_Dict[TR_String, TR_String] {
    TR_return {"model_type": `"whisper"`, "d_model": "\(_BOYUT)", "num_mel_bins": "80", "vocab_size": "\(_DAĞARCIK)", "max_source_positions": "\(_KAYNAK)",
        "max_target_positions": "\(_HEDEF)", "encoder_layers": "2", "encoder_attention_heads": "2", "encoder_ffn_dim": "\(_ARA)", "decoder_layers": "1",
        "decoder_attention_heads": "2", "decoder_ffn_dim": "\(_ARA)", "activation_function": `"gelu"`, "scale_embedding": "false"}
}

TR_func üretim() -> TR_Dict[TR_String, TR_String] { TR_return {"suppress_tokens": "[1]", "no_timestamps_token_id": "9"} }

# json_metni alanları JSON nesnesine çevirir.
TR_func json_metni(a: TR_Dict[TR_String, TR_String]) -> TR_String {
    TR_var alanlar: TR_List[TR_String] = []
    TR_for ad, değer TR_in a { alanlar.TR_append("\"\(ad)\": \(değer)") }
    TR_return "{" + alanlar.TR_join(", ") + "}"
}

# klasör verilenlerden Hugging Face biçiminde geçici bir klasör kurar.
TR_func klasör(a: TR_Dict[TR_String, TR_String], ü: TR_Dict[TR_String, TR_String], t: TR_Dict[TR_String, TR_Tensor]) -> TR_String {
    TR_var k = TR_temp_dir()
    TR_write_file(TR_Path(k, "config.json"), json_metni(a))
    TR_write_file(TR_Path(k, "generation_config.json"), json_metni(ü))
    TR_copy("data/tokenizer.json", TR_Path(k, "tokenizer.json"))
    TR_save_tensors(TR_String(TR_Path(k, "model.safetensors")), t)
    TR_return TR_String(k)
}

TR_func aç_ayarla(a: TR_Dict[TR_String, TR_String]) -> TR_String? { TR_return TR_error_code { TR_pretrained_whisper(klasör(a, üretim(), ağırlıklar())) } }

TR_func aç_tensörle(t: TR_Dict[TR_String, TR_Tensor]) -> TR_String? { TR_return TR_error_code { TR_pretrained_whisper(klasör(ayar(), üretim(), t)) } }

# pencere başvurunun log-Mel'inin ilk 2 · kaynak çerçevesidir.
TR_func pencere() -> TR_Tensor {
    TR_var düz = TR_from_bytes[TR_Float](TR_read_bytes("testdata/whisper/whisper_log_mel_80.bin"), TR_dtype: "float32", TR_byte_order: "little")
    TR_return düz.TR_reshape([80, 57]).TR_slice(1, 0, 2 * _KAYNAK)
}

TR_func başvuru() -> TR_Tensor {
    TR_var düz = TR_from_bytes[TR_Float](TR_read_bytes("testdata/whisper/kodlayici_cikti.bin"), TR_dtype: "float32", TR_byte_order: "little")
    TR_return düz.TR_reshape([1, _KAYNAK, _BOYUT])
}

TR_test "25.1 kodlayıcı Hugging Face'in değerini verir" {
    TR_var model = TR_pretrained_whisper(klasör(ayar(), üretim(), ağırlıklar()))
    TR_var y = model._kodla(pencere())
    TR_assert_equal([1, _KAYNAK, _BOYUT], y.TR_shape)
    TR_assert_equal("float32", y.TR_dtype)
    TR_assert(TR_all_close(y, başvuru(), TR_rtol: 1e-5, TR_atol: 1e-5))
}

# logitler başvurunun [dört parça, dağarcık] logitleridir.
TR_func logitler() -> TR_Tensor {
    TR_var düz = TR_from_bytes[TR_Float](TR_read_bytes("testdata/whisper/cozucu_logit.bin"), TR_dtype: "float32", TR_byte_order: "little")
    TR_return düz.TR_reshape([1, _HEDEF, _DAĞARCIK])
}

TR_func yakın(a: TR_Tensor, b: TR_Tensor) -> TR_Bool { TR_return TR_all_close(a, b, TR_rtol: 1e-5, TR_atol: 1e-5) }

TR_test "25.1 çözücü Hugging Face'in logitini verir" {
    TR_var model = TR_pretrained_whisper(klasör(ayar(), üretim(), ağırlıklar()))
    TR_var bellek = model._başlat(model._kodla(pencere()))
    TR_var y = model._çöz([1, 5, 3, 7], bellek)
    TR_assert_equal([1, _HEDEF, _DAĞARCIK], y.TR_shape)
    TR_assert(yakın(y, logitler()))
}

TR_test "25.1 önbellekli adımlar tek geçişle aynı" {
    TR_var model = TR_pretrained_whisper(klasör(ayar(), üretim(), ağırlıklar()))
    TR_var kodlanmış = model._kodla(pencere())
    TR_var bellek = model._başlat(kodlanmış)
    TR_var ilk = model._çöz([1, 5, 3], bellek)
    TR_var son = model._çöz([7], bellek)
    TR_assert_equal([1, 3, _DAĞARCIK], ilk.TR_shape)
    TR_assert_equal([1, 1, _DAĞARCIK], son.TR_shape)
    TR_assert(yakın(TR_concat([ilk, son], TR_dim: 1), logitler()))
    TR_var ayrı = model._başlat(kodlanmış)
    TR_assert_equal(ilk.TR_tolist, model._çöz([1, 5, 3], ayrı).TR_tolist)
}

TR_test "25.1 çözücünün kıyası farkı görür" {
    TR_for ad TR_in ["model.decoder.layers.0.encoder_attn.k_proj.weight", "model.decoder.layers.0.self_attn.k_proj.weight"] {
        TR_var t = ağırlıklar()
        t[ad] = t[ad] * 1.5
        TR_var model = TR_pretrained_whisper(klasör(ayar(), üretim(), t))
        TR_assert(TR_not yakın(model._çöz([1, 5, 3, 7], model._başlat(model._kodla(pencere()))), logitler()))
    }
}

TR_test "25.1 başvuruyla kıyas farkı görür" {
    TR_var t = ağırlıklar()
    t["model.encoder.layers.1.fc2.weight"] = t["model.encoder.layers.1.fc2.weight"] * 1.01
    TR_var y = TR_pretrained_whisper(klasör(ayar(), üretim(), t))._kodla(pencere())
    TR_assert(TR_not TR_all_close(y, başvuru(), TR_rtol: 1e-5, TR_atol: 1e-5))
}

TR_test "25.1 128 Mel açılır" {
    TR_var a = ayar()
    a["num_mel_bins"] = "128"
    TR_var model = TR_pretrained_whisper(klasör(a, üretim(), ağırlıklar(mel: 128)))
    TR_assert_equal([1, _KAYNAK, _BOYUT], model._kodla(TR_zeros([128, 2 * _KAYNAK])).TR_shape)
}

TR_test "25.1 16 bitlik ağırlık float32'ye genişler, sonuç aynı" {
    TR_for tür TR_in ["fp16", "bf16"] {
        TR_var dar: TR_Dict[TR_String, TR_Tensor] = {}
        TR_var geniş: TR_Dict[TR_String, TR_Tensor] = {}
        TR_for ad, t TR_in ağırlıklar() {
            dar[ad] = t.TR_to_dtype(tür)
            geniş[ad] = dar[ad].TR_to_dtype("float32")
        }
        TR_var y = TR_pretrained_whisper(klasör(ayar(), üretim(), dar))._kodla(pencere())
        TR_assert_equal("float32", y.TR_dtype)
        TR_assert_equal(TR_pretrained_whisper(klasör(ayar(), üretim(), geniş))._kodla(pencere()).TR_tolist, y.TR_tolist)
    }
}

TR_test "25.1 eksik dosya hatadır, ileti dosyayı söyler" {
    TR_for ad TR_in ["config.json", "model.safetensors", "tokenizer.json", "generation_config.json"] {
        TR_var k = klasör(ayar(), üretim(), ağırlıklar())
        TR_remove(TR_Path(TR_Path(k), ad))
        TR_assert_equal("H7087", TR_error_code { TR_pretrained_whisper(k) })
    }
    TR_assert_equal("H7087", TR_error_code { TR_pretrained_whisper("data/böyle_bir_klasör_yok") })
}

TR_test "25.1 eksik alan hatadır" {
    TR_for alan TR_in ["model_type", "d_model", "num_mel_bins", "vocab_size", "max_source_positions", "max_target_positions", "encoder_layers",
        "encoder_attention_heads", "encoder_ffn_dim", "decoder_layers", "decoder_attention_heads", "decoder_ffn_dim"] {
            TR_var a = ayar()
            a.TR_remove(alan)
            TR_assert_equal("H7088", aç_ayarla(a))
        }
    TR_for alan TR_in ["suppress_tokens", "no_timestamps_token_id"] {
        TR_var ü = üretim()
        ü.TR_remove(alan)
        TR_assert_equal("H7088", TR_error_code { TR_pretrained_whisper(klasör(ayar(), ü, ağırlıklar())) })
    }
}

TR_test "25.1 başka mimari hatadır, ileti TR_pretrained_model'i önerir" {
    TR_var a = ayar()
    a["model_type"] = `"llama"`
    TR_assert_equal("H7089", aç_ayarla(a))
    TR_assert_equal("H7089", TR_error_code { TR_pretrained_whisper("data/hf_tiny") })
    TR_assert(TR_pretrained_model("data/hf_tiny").TR_blocks.TR_length > 0)
}

TR_test "25.1 TR_pretrained_model'e Whisper klasörü hatadır, ileti bu adı önerir" {
    TR_var k = klasör(ayar(), üretim(), ağırlıklar())
    TR_assert_equal("H7090", TR_error_code { TR_pretrained_model(k) })
    TR_assert_equal([1, _KAYNAK, _BOYUT], TR_pretrained_whisper(k)._kodla(pencere()).TR_shape)
}

TR_test "25.1 num_mel_bins 80 ve 128 dışında hatadır" {
    TR_for mel TR_in [79, 81, 127, 129, 1] {
        TR_var a = ayar()
        a["num_mel_bins"] = "\(mel)"
        TR_assert_equal("H7091", aç_ayarla(a))
    }
}

TR_test "25.1 bilinmeyen tensör hatadır: çıkış katmanı ve K'nın sapması dahil" {
    TR_for ad TR_in ["proj_out.weight", "model.encoder.layers.0.self_attn.k_proj.bias", "model.encoder.layers.2.fc1.bias", "ek"] {
        TR_var t = ağırlıklar()
        t[ad] = TR_zeros([_BOYUT])
        TR_assert_equal("H7092", aç_tensörle(t))
    }
}

TR_test "25.1 eksik tensör hatadır" {
    TR_for a TR_in adlar(80) {
        TR_var t = ağırlıklar()
        t.TR_remove(a.ad)
        TR_assert_equal("H7093", aç_tensörle(t))
    }
}

TR_test "25.1 ondalık olmayan ve 64 bitlik ağırlık hatadır" {
    TR_var ad = "model.decoder.layer_norm.bias"
    TR_var t = ağırlıklar()
    t[ad] = TR_Tensor[TR_Int]([1, 2, 3, 4, 5, 6, 7, 8])
    TR_assert_equal("H7094", aç_tensörle(t))
    t[ad] = t["model.decoder.layer_norm.weight"].TR_to_dtype("float64")
    TR_assert_equal("H7094", aç_tensörle(t))
}

TR_test "25.1 ayara uymayan şekil hatadır" {
    TR_var t = ağırlıklar()
    t["model.encoder.embed_positions.weight"] = TR_zeros([_KAYNAK + 1, _BOYUT])
    TR_assert_equal("H7095", aç_tensörle(t))
    TR_var u = ağırlıklar()
    u["model.decoder.embed_tokens.weight"] = TR_zeros([_DAĞARCIK])
    TR_assert_equal("H7095", aç_tensörle(u))
}

TR_test "25.1 desteklenmeyen ayar ve boyut hatadır" {
    TR_var a = ayar()
    a["activation_function"] = `"relu"`
    TR_assert_equal("H7096", aç_ayarla(a))
    TR_var b = ayar()
    b["scale_embedding"] = "true"
    TR_assert_equal("H7096", aç_ayarla(b))
    TR_var c = ayar()
    c["encoder_attention_heads"] = "3"
    TR_assert_equal("H7096", aç_ayarla(c))
    TR_for alan TR_in ["d_model", "encoder_attention_heads", "encoder_layers", "vocab_size"] {
        TR_for n TR_in [0, -1] {
            TR_var d = ayar()
            d[alan] = "\(n)"
            TR_assert_equal("H7096", aç_ayarla(d))
        }
    }
}
