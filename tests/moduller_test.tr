//! tr kodlu 3 dil=tr
// docs/spec/11_moduller.md §11 — Modüller
TR_kw_var yükleme_kaydı = []
TR_kw_import "yardimci_modul"
TR_kw_import "yardimci_modul.tr" TR_ctx_as ym

TR_ctx_test "11.1 aktar modülün üst düzey adlarını getirir; .tr uzantısı isteğe bağlıdır" {
    TR_fn_assert_equal(9, kare(PI))
}

TR_ctx_test "11.1 modül yolu metin olarak yazılır; tırnaksız yazım hatadır" {
    TR_kw_var mesaj = ""
    TR_kw_try { TR_kw_import "negative/tirnaksiz_aktar" } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("'aktar' modül yolunu metin olarak bekler, ancak 'yardimci_modul' adı bulundu: aktar \"yardimci_modul\" yazın"), mesaj)
}

TR_ctx_test "11.1 göreli aktar önce aktaran dosyanın, sonra programın klasörüne göre çözülür" {
    TR_kw_import "sub/sira_modulu" TR_ctx_as sm
    TR_fn_assert_equal("alt klasör", sm.sıra_kaynağı) // alt/sira_ortak.tr, tests/sira_ortak.tr değil
    TR_kw_import "sira_ortak" TR_ctx_as so
    TR_fn_assert_equal("program klasörü", so.kimden)
}

TR_ctx_test "11.1 çalışma klasörü modül aramasına girmez" {
    TR_kw_var çalışma = TR_fn_path(".").TR_mem_absolute
    TR_kw_var program = TR_fn_path("moduller_test.tr").TR_mem_absolute.TR_mem_parent
    TR_kw_if çalışma != program {
        // Yeni dosya çalışma klasörüne yazılır (13.1); programın yanında öyle bir modül yok.
        TR_fn_write_file("gecici_calisma_modulu.tr", "değişken çalışma_modülü = doğru
")
        TR_kw_defer TR_fn_remove("gecici_calisma_modulu.tr")
        TR_fn_assert(TR_fn_path(çalışma, "gecici_calisma_modulu.tr").TR_mem_exists)
        TR_kw_var mesaj = ""
        TR_kw_try { TR_kw_import "gecici_calisma_modulu" } TR_kw_catch h { mesaj = h }
        TR_fn_assert(mesaj.TR_mem_contains("gecici_calisma_modulu.tr"), mesaj)
        TR_fn_assert(TR_kw_not mesaj.TR_mem_contains(TR_fn_str(TR_fn_path(çalışma, "gecici_calisma_modulu.tr"))), "çalışma klasörüne bakılmamalı: {mesaj}")
    }
}

TR_ctx_test "11.2 olarak ile modül tek bir Sözlük olarak bağlanır" {
    TR_fn_assert_equal(TR_type_Dict, TR_fn_type(ym))
    TR_fn_assert_equal(4, ym.kare(2))
    TR_fn_assert_equal(3, ym["PI"])
}

TR_ctx_test "11.3 modül bir kez çalıştırılır; sonraki aktarımlar aynı değerleri paylaşır" {
    ym.kayıt.TR_mem_append("x")
    TR_fn_assert_equal(["x"], kayıt)
}

TR_ctx_test "11.3 eşzamanlı görevler aynı modülü aktarınca biri ötekinin yüklemesini bekler" {
    TR_kw_var sonuçlar = []
    TR_kw_for i TR_kw_in 0..2 {
        TR_kw_async {
            TR_kw_try {
                TR_kw_import "yardimci_yavas"
                sonuçlar.TR_mem_append(yavaş_hazır)
            } TR_kw_catch h {
                sonuçlar.TR_mem_append(h)
            }
        }
    }
    TR_fn_wait_all()
    TR_fn_assert_equal([TR_kw_true, TR_kw_true], sonuçlar)
    TR_fn_assert_equal(["yüklendi"], yükleme_kaydı)
}

TR_ctx_test "11.4 modül çalışmadan önce denetlenir; hatalıysa hiçbir satırı çalışmaz" {
    TR_kw_var mesaj = ""
    TR_kw_try { TR_kw_import "negative/tip_hatali_modul" } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("\"negative/tip_hatali_modul\" modülü tip denetimi hataları nedeniyle yüklenemedi"), mesaj)
    TR_fn_assert(mesaj.TR_mem_contains("tip_hatali_modul.tr, Satır 3: Tip uyuşmazlığı"), mesaj)
    TR_kw_var tanımlı = TR_kw_true
    TR_kw_try { yarım_kalan } TR_kw_catch { tanımlı = TR_kw_false }
    TR_fn_assert(TR_kw_not tanımlı, "hatalı modülün hiçbir adı gelmemeli")
    mesaj = ""
    TR_kw_try { TR_kw_import "negative/ust_duzey_sonuc" } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("ust_duzey_sonuc.tr, Satır 3, Sütun 1: Sözdizimi hatası — 'sonuç' modülün üst düzeyinde kullanılamaz"), mesaj)
}

TR_ctx_test "11.5 modülün kodu kendi dosyasının bağlamında çalışır" {
    TR_kw_import "sub/yardimci_alt"
    // Göreli yol modülün klasörüne göre de aranır
    TR_fn_assert_equal("alt klasörün verisi", alt_veri())
    // Hata modülün adı ve kendi satırıyla bildirilir
    TR_kw_var mesaj = ""
    TR_kw_try { sıfıra_böl(1) } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("yardimci_alt.tr, Satır 4: Sıfıra bölme hatası"), mesaj)
    // fırlat ile atılan değer olduğu gibi yakalanır
    TR_kw_try { özel_fırlat() } TR_kw_catch h { mesaj = h }
    TR_fn_assert_equal("özel hata", mesaj)
}

TR_ctx_test "11.7 başı _ olan üst düzey adlar modüle özeldir" {
    TR_kw_import "yardimci_ozel" TR_ctx_as m
    TR_fn_assert_equal(7, m.dış_hesap(2))
    TR_fn_assert_equal(1, m.TR_mem_length)
    TR_fn_assert_equal(TR_kw_false, m.TR_mem_contains("_iç_hesap"))
    TR_kw_var mesaj = ""
    TR_kw_try { m._iç_hesap(2) } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("\"_iç_hesap\" \"yardimci_ozel\" modülüne özel bir ad"), mesaj)
    mesaj = ""
    TR_kw_try { TR_fn_print(m["_ÇARPAN"]) } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("\"_ÇARPAN\" \"yardimci_ozel\" modülüne özel bir ad"), mesaj)
}

TR_ctx_test "11.7 takma adsız aktar modüle özel adları getirmez" {
    TR_kw_import "yardimci_ozel"
    TR_fn_assert_equal(7, dış_hesap(2))
    TR_kw_var mesaj = ""
    TR_kw_try { _iç_hesap(2) } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("'_iç_hesap' adında bir değişken ya da fonksiyon yok"), mesaj)
}

TR_ctx_test "11.6 tr/ öneki dilin kitaplığındandır; diskteki tr/ klasörü onu gölgeleyemez" {
    TR_kw_import "tr/katman" TR_ctx_as k
    TR_fn_assert_equal(TR_type_Dict, TR_fn_type(k))
    TR_fn_assert(k.TR_mem_keys().TR_mem_contains("TR_type_GPT") TR_kw_and k.TR_mem_keys().TR_mem_contains("TR_type_Linear"), "kitaplığın katmanları gelmeli")
    TR_fn_assert(TR_kw_not k.TR_mem_keys().TR_mem_contains("disk_katmanı"), "tests/tr/katman.tr yüklenmemeli")
    TR_kw_import "./tr/katman" TR_ctx_as d
    TR_fn_assert_equal(TR_kw_true, d.disk_katmanı)
    TR_fn_assert_equal([4, 3], k.TR_type_Linear(4, 3).TR_mem_weight.TR_mem_shape)
    TR_kw_var mesaj = ""
    TR_kw_try { TR_kw_import "tr/olmayan_modul" } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("\"tr/olmayan_modul\" dilin kitaplığında yok; kitaplıktaki modüller: tr/egitim, tr/hazir, tr/iyilestirici, tr/katman"), mesaj)
    mesaj = ""
    TR_kw_try { TR_kw_import "tr/iyileştirici" } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("Bunu mu demek istediniz: \"tr/iyilestirici\"?"), mesaj)
    mesaj = ""
    TR_kw_try { TR_kw_import "tr/katman_test" } TR_kw_catch h { mesaj = h }
    TR_fn_assert(mesaj.TR_mem_contains("dilin kitaplığında yok"), "test dosyası modül değildir: {mesaj}")
}
