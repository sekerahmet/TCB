// docs/spec/11_moduller.md §11 — Modüller
değişken yükleme_kaydı = []
aktar "yardimci_modul"
aktar "yardimci_modul.tr" olarak ym

test "11.1 aktar modülün üst düzey adlarını getirir; .tr uzantısı isteğe bağlıdır" {
    eşit_mi(9, kare(PI))
}

test "11.1 modül yolu metin olarak yazılır; tırnaksız yazım hatadır" {
    değişken mesaj = ""
    dene { aktar "negative/tirnaksiz_aktar" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("'aktar' modül yolunu metin olarak bekler, ancak 'yardimci_modul' adı bulundu: aktar \"yardimci_modul\" yazın"), mesaj)
}

test "11.1 göreli aktar önce aktaran dosyanın, sonra programın klasörüne göre çözülür" {
    aktar "sub/sira_modulu" olarak sm
    eşit_mi("alt klasör", sm.sıra_kaynağı) // alt/sira_ortak.tr, tests/sira_ortak.tr değil
    aktar "sira_ortak" olarak so
    eşit_mi("program klasörü", so.kimden)
}

test "11.1 çalışma klasörü modül aramasına girmez" {
    değişken çalışma = yol(".").mutlak
    değişken program = yol("moduller_test.tr").mutlak.üst_klasör
    eğer çalışma != program {
        // Yeni dosya çalışma klasörüne yazılır (13.1); programın yanında öyle bir modül yok.
        dosya_yaz("gecici_calisma_modulu.tr", "değişken çalışma_modülü = doğru
")
        ertele sil("gecici_calisma_modulu.tr")
        doğrula(yol(çalışma, "gecici_calisma_modulu.tr").var_mı)
        değişken mesaj = ""
        dene { aktar "gecici_calisma_modulu" } yakala h { mesaj = h }
        doğrula(mesaj.içerir("gecici_calisma_modulu.tr"), mesaj)
        doğrula(değil mesaj.içerir(metin(yol(çalışma, "gecici_calisma_modulu.tr"))), "çalışma klasörüne bakılmamalı: {mesaj}")
    }
}

test "11.2 olarak ile modül tek bir Sözlük olarak bağlanır" {
    eşit_mi(Sözlük, tip(ym))
    eşit_mi(4, ym.kare(2))
    eşit_mi(3, ym["PI"])
}

test "11.3 modül bir kez çalıştırılır; sonraki aktarımlar aynı değerleri paylaşır" {
    ym.kayıt.ekle("x")
    eşit_mi(["x"], kayıt)
}

test "11.3 eşzamanlı görevler aynı modülü aktarınca biri ötekinin yüklemesini bekler" {
    değişken sonuçlar = []
    döngü i içinde 0..2 {
        eşzamanlı {
            dene {
                aktar "yardimci_yavas"
                sonuçlar.ekle(yavaş_hazır)
            } yakala h {
                sonuçlar.ekle(h)
            }
        }
    }
    bekle_hepsi()
    eşit_mi([doğru, doğru], sonuçlar)
    eşit_mi(["yüklendi"], yükleme_kaydı)
}

test "11.4 modül çalışmadan önce denetlenir; hatalıysa hiçbir satırı çalışmaz" {
    değişken mesaj = ""
    dene { aktar "negative/tip_hatali_modul" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("\"negative/tip_hatali_modul\" modülü tip denetimi hataları nedeniyle yüklenemedi"), mesaj)
    doğrula(mesaj.içerir("tip_hatali_modul.tr, Satır 3: Tip uyuşmazlığı"), mesaj)
    değişken tanımlı = doğru
    dene { yarım_kalan } yakala { tanımlı = yanlış }
    doğrula(değil tanımlı, "hatalı modülün hiçbir adı gelmemeli")
    mesaj = ""
    dene { aktar "negative/ust_duzey_sonuc" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("ust_duzey_sonuc.tr, Satır 3, Sütun 1: Sözdizimi hatası — 'sonuç' modülün üst düzeyinde kullanılamaz"), mesaj)
}

test "11.5 modülün kodu kendi dosyasının bağlamında çalışır" {
    aktar "sub/yardimci_alt"
    // Göreli yol modülün klasörüne göre de aranır
    eşit_mi("alt klasörün verisi", alt_veri())
    // Hata modülün adı ve kendi satırıyla bildirilir
    değişken mesaj = ""
    dene { sıfıra_böl(1) } yakala h { mesaj = h }
    doğrula(mesaj.içerir("yardimci_alt.tr, Satır 4: Sıfıra bölme hatası"), mesaj)
    // fırlat ile atılan değer olduğu gibi yakalanır
    dene { özel_fırlat() } yakala h { mesaj = h }
    eşit_mi("özel hata", mesaj)
}

test "11.6 tr/ öneki dilin kitaplığındandır; diskteki tr/ klasörü onu gölgeleyemez" {
    aktar "tr/katman" olarak k
    eşit_mi(Sözlük, tip(k))
    doğrula(k.anahtarlar().içerir("GPT") ve k.anahtarlar().içerir("Doğrusal"), "kitaplığın katmanları gelmeli")
    doğrula(değil k.anahtarlar().içerir("disk_katmanı"), "tests/tr/katman.tr yüklenmemeli")
    aktar "./tr/katman" olarak d
    eşit_mi(doğru, d.disk_katmanı)
    eşit_mi([4, 3], k.Doğrusal(4, 3).ağırlık.şekil)
    değişken mesaj = ""
    dene { aktar "tr/olmayan_modul" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("\"tr/olmayan_modul\" dilin kitaplığında yok; kitaplıktaki modüller: tr/egitim, tr/hazir, tr/iyilestirici, tr/katman"), mesaj)
    mesaj = ""
    dene { aktar "tr/iyileştirici" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("Bunu mu demek istediniz: \"tr/iyilestirici\"?"), mesaj)
    mesaj = ""
    dene { aktar "tr/katman_test" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("dilin kitaplığında yok"), "test dosyası modül değildir: {mesaj}")
}
