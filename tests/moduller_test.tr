# TR 4
# docs/spec/11_moduller.md §11 — Modüller. Aktarmalar dosyanın başındadır (2.1); hatalı modüllerin
# testleri olumsuz fikstürlerdedir (tests/negative/: tirnaksiz_aktar, tip_hatali_modul,
# hatali_modul_aktar, ust_duzey_sonuc, kitaplik_*).
TR_import "yardimci_modul"
TR_import "yardimci_modul.tr" TR_as ym
TR_import "sub/sira_modulu" TR_as sm
TR_import "sira_ortak" TR_as so
TR_import "sub/yardimci_alt"
TR_import "yardimci_ozel" TR_as özel
TR_import "yardimci_ozel"
TR_import "tr/layers" TR_as k
TR_import "./tr/layers" TR_as d

TR_test "11.1 aktar modülün üst düzey adlarını getirir; .tr uzantısı isteğe bağlıdır" {
    TR_assert_equal(9, kare(PI))
}

TR_test "11.1 göreli aktar önce aktaran dosyanın, sonra programın klasörüne göre çözülür" {
    TR_assert_equal("alt klasör", sm.sıra_kaynağı) # sub/sira_ortak.tr, tests/sira_ortak.tr değil
    TR_assert_equal("program klasörü", so.kimden)
}

TR_test "1.1 modülün en dışı yalnız tanımdır: sabit ilk değerler aktarılınca hazırdır, kodu aktaran çağırır" {
    TR_assert_equal(9, ÖLÇÜLER["pi_kare"])
    TR_assert_equal([3, 4], ÖLÇÜLER["kenarlar"])
    TR_assert_equal(16, KARE_AL(4))
}

TR_test "11.2 olarak ile modül tek bir değer olarak bağlanır; adlarına nokta ile erişilir" {
    TR_assert_equal(4, ym.kare(2))
    TR_assert_equal(3, ym.PI)
}

TR_test "11.3 modül bir kez çalıştırılır; sonraki aktarımlar aynı değerleri paylaşır" {
    ym.kayıt.TR_append("x")
    TR_assert_equal(["x"], kayıt)
}

TR_test "11.5 modülün kodu kendi dosyasının bağlamında çalışır" {
    # Göreli yol modülün klasörüne göre de aranır
    TR_assert_equal("alt klasörün verisi", alt_veri())
    # Hata modülün adı ve kendi satırıyla (başlık 1. satır) bildirilir
    TR_assert_equal("H2470", TR_error_code { sıfıra_böl(1) })
    TR_var mesaj = ""
    TR_try { sıfıra_böl(1) } TR_catch h { mesaj = h }
    TR_assert(mesaj.TR_contains("yardimci_alt.tr, ") TR_and mesaj.TR_contains(" 5: "), mesaj)
    # fırlat ile atılan değer olduğu gibi yakalanır
    TR_try { özel_fırlat() } TR_catch h { mesaj = h }
    TR_assert_equal("özel hata", mesaj)
}

TR_test "11.7 başı _ olan üst düzey adlar modüle özeldir" {
    TR_assert_equal(7, özel.dış_hesap(2))
    TR_assert_equal("H2487", TR_error_code { özel._iç_hesap(2) })
}

TR_test "11.7 takma adsız aktar modüle özel adları getirmez" {
    TR_assert_equal(7, dış_hesap(2))
    TR_assert_equal("H1106", TR_error_code { _iç_hesap(2) })
}

TR_test "11.6 tr/ öneki dilin kitaplığındandır; diskteki tr/ klasörü onu gölgeleyemez" {
    TR_assert_equal([4, 3], k.TR_Linear(4, 3).TR_weight.TR_shape) # tests/tr/layers.tr'de Linear yok
    TR_assert_equal(TR_true, d.disk_katmanı)
}
