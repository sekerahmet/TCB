// docs/spec/13_yerlesikler.md §13 — Yerleşik fonksiyonlar ve metotlar (seçki)

test "13.1 genel yerleşikler" {
    eşit_mi(3, [1, 2, 3].uzunluk)
    eşit_mi(6, toplam([1, 2, 3]))
    eşit_mi(1, min([3, 1, 2]))
    eşit_mi(3, max([3, 1, 2]))
    eşit_mi(5, mutlak(-5))
    eşit_mi(3.0, karekök(9))
    eşit_mi([0, 1, 2], aralık(0, 3))
}

test "13.1 min ve max türü korur, Tam'ları tam karşılaştırır, sayı olmayanda hata verir" {
    eşit_mi(2.0, max([2.0, 1.5]))
    eşit_mi(Ondalık, tip(max([2.0, 1.5])))
    eşit_mi(Tam, tip(min([1, 2.5])))
    eşit_mi(9007199254740993, max([9007199254740993, 1]))
    doğrula(max([9007199254740993, 9007199254740992]) != 9007199254740992)
    eşit_mi(Tam, tip(max(9223372036854775807, 1)))
    eşit_mi(-7, min(3, -7, 0.5))
    eşit_mi(yok, max([]))
    değişken hatalar = []
    dene { max([1, "a", 5]) } yakala h { hatalar.ekle(h) }
    dene { min("abc") } yakala h { hatalar.ekle(h) }
    dene { toplam([1, "a", 2]) } yakala h { hatalar.ekle(h) }
    eşit_mi(3, hatalar.uzunluk, metin(hatalar))
    doğrula(hatalar[0].içerir("max(): listenin 2. elemanı Tam ya da Ondalık olmalıdır, Metin (\"a\") verildi"), hatalar[0])
    doğrula(hatalar[1].içerir("min() 1. argüman olarak Tam ya da Ondalık bekler"), hatalar[1])
    // Negatif basamak onlar, yüzler basamağına yuvarlar
    eşit_mi(1200, yuvarla(1234, -2))
    eşit_mi(1240, yuvarla(1235.0, -1))
    eşit_mi(4, yuvarla(3.6))
}

test "13.1 yerleşiklerin argüman hataları tek biçimdedir" {
    değişken m = ""
    dene { aralık("a") } yakala h { m = h }
    doğrula(m.biter("aralık() 1. argüman olarak Tam bekler, Metin (\"a\") verildi"), m)
    dene { aralık(1, 2.5) } yakala h { m = h }
    doğrula(m.biter("aralık() 2. argüman olarak Tam bekler, Ondalık (2.5) verildi"), m)
    dene { [1].filtrele(3) } yakala h { m = h }
    doğrula(m.biter("liste.filtrele() 1. argüman olarak Fonksiyon bekler, Tam (3) verildi"), m)
    dene { toplam() } yakala h { m = h }
    doğrula(m.biter("toplam() 1 argüman bekler, 0 verildi (kullanım: toplam(liste))"), m)
    dene { yuvarla(1.25, "x") } yakala h { m = h }
    doğrula(m.biter("yuvarla() 2. argüman olarak Tam bekler, Metin (\"x\") verildi"), m)
}

test "13.1 dosya_oku ve dosya_yaz hataları Türkçedir; göreli yol önce çalışma klasöründe, sonra programın klasöründe aranır" {
    // Programın klasöründeki dosya, program başka bir klasörden çalıştırılsa da bulunur
    doğrula(dosya_oku("data/tokenizer.json").içerir("model"))
    değişken m = ""
    dene { dosya_oku("data/olmayan_dosya.txt") } yakala h { m = h }
    doğrula(m.içerir("dosya_oku(): \"data/olmayan_dosya.txt\" okunamadı: böyle bir dosya ya da klasör yok"), m)
    doğrula(m.içerir("bakılan yerler: "), m)
    doğrula(değil m.içerir("system cannot"), m)
    dene { dosya_oku("data") } yakala h { m = h }
    doğrula(m.içerir("bu bir klasör, dosya değil"), m)
    dene { dosya_yaz("olmayan_klasör_tr/a.txt", "x") } yakala h { m = h }
    doğrula(m.biter("dosya_yaz(): \"olmayan_klasör_tr/a.txt\" yazılamadı: \"olmayan_klasör_tr\" klasörü yok"), m)
    dene { dosya_oku(5) } yakala h { m = h }
    doğrula(m.biter("dosya_oku() 1. argüman olarak Metin ya da Yol bekler, Tam (5) verildi"), m)
}

test "13.1a yolda sekme ya da satır sonu varsa yol alan yerleşikler ham metni önerir" {
    değişken m = ""
    dene { dosya_oku("C:\tokenizer.json") } yakala h { m = h }
    doğrula(m.içerir("dosya_oku(): dosya yolunda sekme karakteri var"), m)
    doğrula(m.içerir("ham metin kullanın: `C:\\tokenizer.json`"), m)
    dene { dosya_yaz("D:\new\rapor.txt", "x") } yakala h { m = h }
    doğrula(m.içerir("dosya_yaz(): dosya yolunda satır sonu karakteri var"), m)
    doğrula(m.içerir(`D:\new\rapor.txt`), m)
    dene { tensör_yükle("a\tb.trt") } yakala h { m = h }
    doğrula(m.içerir("tensör_yükle: dosya yolunda sekme"), m)
    dene { parçalayıcı_yükle("a\tb.json") } yakala h { m = h }
    doğrula(m.içerir("parçalayıcı_yükle: dosya yolunda sekme"), m)
    dene { veri_kümesi("veri\tsayilar") } yakala h { m = h }
    doğrula(m.içerir("veri_kümesi: dosya yolunda sekme"), m)
}

test "13.2 metin metotları" {
    eşit_mi("İSTANBUL", "istanbul".büyük_harf())
    eşit_mi("ılık", "ILIK".küçük_harf())
    eşit_mi("a", "  a ".kırp())
    eşit_mi(["a", "b"], "a,b".böl(","))
    eşit_mi("axc", "abc".değiştir("b", "x"))
    doğrula("abc".içerir("b") ve "abc".başlar("a") ve "abc".biter("c"))
    eşit_mi("cba", "abc".ters_çevir())
}

test "13.3 liste metotları" {
    değişken l = [3, 1, 2, 2]
    eşit_mi([1, 2, 2, 3], l.sırala())
    eşit_mi([3, 1, 2], l.benzersiz())
    eşit_mi("3-1-2-2", l.birleştir("-"))
    eşit_mi(3, l.ilk)
    eşit_mi(2, l.son)
    eşit_mi(2.0, ortalama(l))
    doğrula(l.içerir(1))
}

test "13.3 sırala sayıları tam, metinleri karakter sırasıyla dizer; karışık tip hatadır" {
    eşit_mi([9007199254740992, 9007199254740993], [9007199254740993, 9007199254740992].sırala())
    eşit_mi([-1, 0.5, 2, 2.5], [2.5, 2, -1, 0.5].sırala())
    eşit_mi(["a", "b", "ç"], ["ç", "b", "a"].sırala())
    değişken hatalar = []
    dene { [2, "10", 10].sırala() } yakala h { hatalar.ekle(h) }
    dene { [10, 2, "10"].sırala() } yakala h { hatalar.ekle(h) }
    dene { [doğru, yanlış].sırala() } yakala h { hatalar.ekle(h) }
    eşit_mi(3, hatalar.uzunluk, metin(hatalar))
    döngü h içinde hatalar { doğrula(h.içerir("yalnızca sayılardan ya da yalnızca metinlerden"), h) }
}

test "13.2 metotlar argüman sayısını ve tipini denetler" {
    değişken hatalar = []
    dene { "abc".içerir() } yakala h { hatalar.ekle(h) }
    dene { "a1".içerir(1) } yakala h { hatalar.ekle(h) }
    dene { "abc".büyük_harf(1) } yakala h { hatalar.ekle(h) }
    dene { "a,b".böl(1) } yakala h { hatalar.ekle(h) }
    dene { "abc".değiştir("a") } yakala h { hatalar.ekle(h) }
    dene { [1, 2].filtrele(3) } yakala h { hatalar.ekle(h) }
    dene { [1].ekle() } yakala h { hatalar.ekle(h) }
    dene { {"a": 1}.anahtarlar(1) } yakala h { hatalar.ekle(h) }
    eşit_mi(8, hatalar.uzunluk, metin(hatalar))
    doğrula(hatalar[0].içerir("metin.içerir() 1 argüman bekler, 0 verildi (kullanım: metin.içerir(alt))"), hatalar[0])
    doğrula(hatalar[1].içerir("metin.içerir() 1. argüman olarak Metin bekler, Tam (1) verildi"), hatalar[1])
    doğrula(hatalar[2].içerir("metin.büyük_harf() 0 argüman bekler, 1 verildi"), hatalar[2])
    doğrula(hatalar[5].içerir("liste.filtrele() 1. argüman olarak Fonksiyon bekler"), hatalar[5])
    // Liste ve sözlük içerir her tipte değer arar
    doğrula(değil [1, 2].içerir("1"))
    doğrula([1, 2].içerir(1.0))
}

test "13.3 boş ya da sayı olmayan listenin ortalaması hatadır" {
    eşit_mi(2.0, ortalama([1, 2, 3]))
    değişken hatalar = []
    dene { ortalama([]) } yakala h { hatalar.ekle(h) }
    dene { ortalama([1, "x", 3]) } yakala h { hatalar.ekle(h) }
    eşit_mi(2, hatalar.uzunluk, metin(hatalar))
    doğrula(hatalar[0].içerir("boş listenin ortalaması yoktur"), hatalar[0])
    doğrula(hatalar[1].içerir("listenin 2. elemanı Tam ya da Ondalık olmalıdır"), hatalar[1])
}

test "13.1 standart_sapma ve ortanca ortalama kadar sıkıdır: boş ve sayı olmayanda hata" {
    eşit_mi(2.0, standart_sapma([2, 4, 4, 4, 5, 5, 7, 9]))
    eşit_mi(0.5, standart_sapma(1, 2))
    eşit_mi(2.5, ortanca([3, 1, 2, 4]))
    eşit_mi(2.0, ortanca(3, 1, 2))
    değişken hatalar = []
    dene { standart_sapma([]) } yakala h { hatalar.ekle(h) }
    dene { ortanca([]) } yakala h { hatalar.ekle(h) }
    dene { standart_sapma([1, "x"]) } yakala h { hatalar.ekle(h) }
    dene { ortanca([1, yok, 3]) } yakala h { hatalar.ekle(h) }
    dene { ortanca() } yakala h { hatalar.ekle(h) }
    eşit_mi(5, hatalar.uzunluk, metin(hatalar))
    doğrula(hatalar[0].içerir("standart_sapma(): boş listenin standart sapması yoktur"), hatalar[0])
    doğrula(hatalar[1].içerir("ortanca(): boş listenin ortancası yoktur"), hatalar[1])
    doğrula(hatalar[2].içerir("standart_sapma(): listenin 2. elemanı Tam ya da Ondalık olmalıdır, Metin (\"x\") verildi"), hatalar[2])
    doğrula(hatalar[3].içerir("ortanca(): listenin 2. elemanı Tam ya da Ondalık olmalıdır"), hatalar[3])
    doğrula(hatalar[4].içerir("ortanca() en az 1 argüman bekler"), hatalar[4])
}

test "13.5 yerleşikler ve metotlar bilinmeyen adlı argümanı reddeder" {
    değişken hatalar = []
    dene { yazdır("a", ayraç: "-") } yakala h { hatalar.ekle(h) }
    dene { "a b".böl(eksen: 1) } yakala h { hatalar.ekle(h) }
    dene { toplam([1, 2], eksn: 0) } yakala h { hatalar.ekle(h) }
    dene { AdamW([tensör([1.0], türev_izle: doğru)], lr: 0.1) } yakala h { hatalar.ekle(h) }
    dene { örnekle(tensör([1.0, 2.0]), tohm: 1) } yakala h { hatalar.ekle(h) }
    eşit_mi(5, hatalar.uzunluk, metin(hatalar))
    doğrula(hatalar[0].içerir("yazdır() 'ayraç' adında bir parametre almaz (adlı argüman almaz)"), hatalar[0])
    doğrula(hatalar[1].içerir("metin.böl() 'eksen' adında bir parametre almaz (adlı argüman almaz)"), hatalar[1])
    doğrula(hatalar[2].içerir("toplam() 'eksn' adında bir parametre almaz. Bunu mu demek istediniz: 'eksen'?"), hatalar[2])
    doğrula(hatalar[3].içerir("AdamW 'lr' adında bir parametre almaz. Bunu mu demek istediniz: 'öğrenme_oranı'?"), hatalar[3])
    doğrula(hatalar[4].içerir("örnekle() 'tohm' adında bir parametre almaz. Bunu mu demek istediniz: 'tohum'?"), hatalar[4])
}

test "13.6 hedef tipin adını taşıyan dönüştürücüler kurucudur ve tip() genel sorudur: ikisi de fonksiyondur" {
    eşit_mi(5, tam("5"))
    eşit_mi(2.5, ondalık("2.5"))
    eşit_mi("[1, 2]", metin([1, 2]))
    eşit_mi(Liste, tip([1]))
    // Yapının 'tip' alanı yerleşik tip() ile çakışmaz
    yapı Ürün { ad, tip }
    değişken ü = Ürün("kalem", "kırtasiye")
    eşit_mi("kırtasiye", ü.tip)
    eşit_mi(Ürün, tip(ü))
}

test "13.6 değeri dönüştüren ya da soran iş metot, matematik ve tensör işi fonksiyondur" {
    değişken l = [3, 1, 2]
    eşit_mi(3, l.uzunluk)
    eşit_mi([1, 2, 3], l.sırala())
    eşit_mi(6, toplam(l))
    eşit_mi(2.0, ortalama(l))
    eşit_mi(6, l.indirge(0, (a, x) => a + x))
    eşit_mi(6, l.indirge((a, x) => a * x))
    eşit_mi(4, l.indirge(10) { birikim - o })
    eşit_mi(yok, [].indirge((a, x) => a + x))
    eşit_mi(7, [].indirge(7, (a, x) => a + x))
    eşit_mi([[1, 2]], tensör([[1], [2]]).devrik().değer)
    // Öbür biçim yoktur: liste.toplam() ve tensör.toplam bir üye değildir.
    değişken hatalar = []
    dene { l.toplam() } yakala h { hatalar.ekle(h) }
    dene { tensör([1.0]).toplam } yakala h { hatalar.ekle(h) }
    dene { l.indirge((a, x) => a + x, 0) } yakala h { hatalar.ekle(h) }
    eşit_mi(3, hatalar.uzunluk, metin(hatalar))
    doğrula(hatalar[0].içerir("\"toplam\""), hatalar[0])
    doğrula(hatalar[2].içerir("liste.indirge(): fonksiyon son argüman olmalı"), hatalar[2])
    // Metot adları genel kapsamda sıradan adlardır
    değişken uzunluk = 5
    fonksiyon sırala(x) { sonuç x }
    eşit_mi([5, 3], [uzunluk, sırala(3)])
}

test "13.4 sözlük metotları" {
    değişken d = {"a": 1, "b": 2}
    eşit_mi(["a", "b"], d.anahtarlar())
    eşit_mi([1, 2], d.değerler())
    doğrula(d.içerir("a"))
}

test "13.8 csv_oku dosya okur, csv_çöz metni ayrıştırır" {
    değişken k = geçici_klasör()
    dosya_yaz(yol(k, "t.csv"), "ad,yaş\nAli,30")
    eşit_mi([["ad", "yaş"], ["Ali", 30]], csv_oku(yol(k, "t.csv")))
    eşit_mi([["ad", "yaş"], ["Ali", 30]], csv_çöz("ad,yaş\nAli,30"))
    eşit_mi([["007", 7]], csv_çöz("007,7"))
    değişken m = ""
    dene { csv_oku("ad,yaş\nAli,30") } yakala h { m = h }
    doğrula(m.içerir("csv_çöz()"), m)
    m = ""
    dene { csv_çöz(5) } yakala h { m = h }
    doğrula(m.içerir("csv_çöz() 1. argüman olarak Metin bekler"), m)
}
