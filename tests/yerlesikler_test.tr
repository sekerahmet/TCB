# TR 4
# docs/spec/13_yerlesikler.md §13 — Yerleşik fonksiyonlar ve metotlar (seçki)

TR_import "yardimci_bos_liste" TR_as boş

TR_test "13.1 genel yerleşikler" {
    TR_assert_equal(3, [1, 2, 3].TR_length)
    TR_assert_equal(6, TR_sum([1, 2, 3]))
    TR_assert_equal(1, TR_min([3, 1, 2]))
    TR_assert_equal(3, TR_max([3, 1, 2]))
    TR_assert_equal(5, TR_abs(-5))
    TR_assert_equal(3.0, TR_sqrt(9))
    TR_assert_equal([0, 1, 2], TR_List(0..3))
}

TR_test "13.1 TR_time_ms Unix zamanıdır, milisaniye sayar" {
    TR_var başla = TR_time_ms()
    # 2020 ile 2100 arası: saniye ya da nanosaniye veren saat bu aralığa düşmez
    TR_assert(başla > 1_577_836_800_000)
    TR_assert(başla < 4_102_444_800_000)
    TR_sleep(0.02)
    # Saat 10-11 ms sıçrayabilir (status 10.2); 20 ms milisaniyede en az 5, saniyede 0 ya da 1 eder
    TR_var fark = TR_time_ms() - başla
    TR_assert(fark >= 5)
    TR_assert(fark < 10_000)
}

TR_test "13.1 TR_monotonic_ns tekdüze saattir: nanosaniye sayar, geri gitmez, argüman almaz" {
    TR_var ilk = TR_monotonic_ns()
    TR_var ikinci = TR_monotonic_ns()
    TR_assert_equal(TR_Int, TR_Type(ilk))
    TR_assert(ikinci - ilk >= 0)
    TR_sleep(0.01)
    # 10 ms nanosaniyede en az 10 000 000 eder; milisaniye ya da mikrosaniye veren saat buna ulaşmaz
    TR_var fark = TR_monotonic_ns() - ikinci
    TR_assert(fark >= 10_000_000)
    TR_assert(fark < 10_000_000_000)
    TR_assert_equal("H2012", TR_error_code { TR_monotonic_ns(1) })
}

TR_test "13.1 min ve max'ın tipi işlecin tipidir, Tam'ları tam karşılaştırır, sayı olmayanda hata verir" {
    TR_assert_equal(2.0, TR_max([2.0, 1.5]))
    TR_assert_equal(TR_Float, TR_Type(TR_max([2.0, 1.5])))
    # [1, 2.5] bir TR_List[TR_Float]'tır (3.6): öğeleri ondalık.
    TR_assert_equal(TR_Float, TR_Type(TR_min([1, 2.5])))
    TR_assert_equal(9007199254740993, TR_max([9007199254740993, 1]))
    TR_assert(TR_max([9007199254740993, 9007199254740992]) != 9007199254740992)
    TR_assert_equal(TR_Int, TR_Type(TR_max(9223372036854775807, 1)))
    # TR_Int ile TR_Float karışırsa sonuç TR_Float (4.2); kazanan kesin karşılaştırmayla seçilir, sonra çevrilir.
    TR_assert_equal("2.0 -7.0", "\(TR_max(2, 1.5)) \(TR_min(3, -7, 0.5))")
    TR_assert_equal(TR_Float, TR_Type(TR_max(2, 1.5)))
    TR_assert_equal(TR_Float, TR_Type(TR_min(3, -7, 0.5)))
    TR_assert_equal("9007199254740992.0", "\(TR_max(9007199254740993, 1.0))")
    TR_var iki = 2
    TR_assert_equal("2.0 1.5", "\(TR_max([iki, 1.5])) \(TR_min([iki, 1.5]))")
    TR_assert_equal("0.0 -0.0", "\(TR_max(0, -0.0)) \(TR_min(0, -0.0))")
    # -0.0 0.0'dan küçük sayılır (13.10'un sıralama sırası), listede de değerlerde de, sıra fark etmez.
    TR_assert_equal("0.0 0.0 0.0", "\(TR_max([-0.0, 0.0])) \(TR_max([0.0, -0.0])) \(TR_max(-0.0, 0.0))")
    TR_assert_equal("-0.0 -0.0 -0.0", "\(TR_min([0.0, -0.0])) \(TR_min([-0.0, 0.0])) \(TR_min(0.0, -0.0))")
    # Boş listede hata (13.1: toplama yapan yerleşik); TR_none dönseydi boş girdinin hatası `?? 0` ile kaybolurdu.
    TR_assert_equal("H2624", TR_error_code { TR_max([]) })
    TR_assert_equal("H2625", TR_error_code { TR_min([]) })
    TR_var boş: TR_List[TR_Float] = []
    TR_assert_equal("H2625", TR_error_code { TR_min(boş) })
    TR_assert_equal("H2486", TR_error_code { TR_max([1, "a", 5]) })
    TR_assert_equal("H2423", TR_error_code { TR_min("abc") })
    TR_assert_equal("H2486", TR_error_code { TR_sum([1, "a", 2]) })
}

TR_test "13.1 TR_round(x) TR_Int verir, TR_round(x, basamak) girdinin tipini verir" {
    TR_assert_equal(4, TR_round(3.6))
    TR_assert_equal(TR_Int, TR_Type(TR_round(3.6)))
    TR_assert_equal("5 4.0 2.57", "\(TR_round(5, 2)) \(TR_round(3.7, 0)) \(TR_round(2.567, 2))")
    TR_assert_equal(TR_Int, TR_Type(TR_round(5, 2)))
    TR_assert_equal(TR_Float, TR_Type(TR_round(3.7, 0)))
    # Eksi basamak onlar, yüzler basamağına yuvarlar; tip yine girdinin tipi.
    TR_assert_equal("1200 1200.0 1240.0", "\(TR_round(1234, -2)) \(TR_round(1234.0, -2)) \(TR_round(1235.0, -1))")
    TR_assert_equal(TR_Int, TR_Type(TR_round(1234, -2)))
    TR_assert_equal(TR_Float, TR_Type(TR_round(1234.0, -2)))
    # TR_Int kesin yuvarlanır (3.1), TR_Float'a çevrilmez; sınırdaki basamaklar.
    TR_assert_equal(1234567890123456800, TR_round(1234567890123456789, -2))
    TR_assert_equal(123456789012345670, TR_round(123456789012345674, -1))
    TR_assert_equal("0 0.0 2.5", "\(TR_round(1234, -400)) \(TR_round(1234.0, -400)) \(TR_round(2.5, 400))")
    TR_assert_equal(0, TR_round(4999999999999999999, -19))
    TR_assert_equal(1e300, TR_round(1e300, 20))
    TR_assert_equal(1e300, TR_round(1e300, 0))
    TR_assert_equal("H2484", TR_error_code { TR_round(9223372036854775807, -1) })
    TR_assert_equal("H2484", TR_error_code { TR_round(-9223372036854775807 - 1, -19) })
    # Sayıda NaN ve sonsuz hatadır; ileti TR_is_finite'ı önerir.
    TR_assert_equal("H2626", TR_error_code { TR_round(TR_nan, 2) })
    TR_assert_equal("H2626", TR_error_code { TR_round(-TR_inf, 0) })
    TR_assert_equal(TR_false, TR_is_finite(TR_nan))
    TR_assert_equal("H2627", TR_error_code { TR_round(1.7e308, -308) })
}

TR_test "13.1 yarım çifte gider; basamaklı yuvarlama yazılan ondalık metne göredir" {
    TR_assert_equal("2 -2 0 4", "\(TR_round(2.5)) \(TR_round(-2.5)) \(TR_round(0.5)) \(TR_round(3.5))")
    TR_assert_equal("2.0 4.0 -2.0", "\(TR_round(2.5, 0)) \(TR_round(3.5, 0)) \(TR_round(-2.5, 0))")
    # Yazılan metinde 0.125 ve 2.675 tam yarımdır: 2 çift (0.12), 7 tek (2.68); Python ikili değere göre 2.67 verir.
    TR_assert_equal("0.12 2.68 0.38 1.0", "\(TR_round(0.125, 2)) \(TR_round(2.675, 2)) \(TR_round(0.375, 2)) \(TR_round(1.005, 2))")
    TR_assert_equal("1200 1400 -1200 1300", "\(TR_round(1250, -2)) \(TR_round(1350, -2)) \(TR_round(-1250, -2)) \(TR_round(1251, -2))")
    TR_assert_equal("1200.0 1400.0 -0.0", "\(TR_round(1250.0, -2)) \(TR_round(1350.0, -2)) \(TR_round(-0.4, 0))")
    TR_assert_equal(0, TR_round(5000000000000000000, -19))
    TR_assert_equal(0, TR_round(-5000000000000000000, -19))
    # Eksi basamakta da yazılan metin: 1e308 / 10^300 * 10^300'ün artığı yok.
    TR_assert_equal("1e+308 -1e+308", "\(TR_round(1e308, -300)) \(TR_round(-1e308, -300))")
    TR_assert_equal("1000.0 10.0 0.0 5e-324", "\(TR_round(999.96, 1)) \(TR_round(9.5, 0)) \(TR_round(5e-324, 323)) \(TR_round(5e-324, 324))")
}

TR_test "13.10 yalnız değer veren yerleşik yeni değer döndürür, alıcısını değiştirmez" {
    TR_var l = [3, 1, 2]
    TR_var s = l.TR_sort()
    TR_assert_equal([3, 1, 2], l)
    TR_assert_equal([1, 2, 3], s)
    l = l.TR_sort()
    TR_assert_equal([1, 2, 3], l)
    TR_var m = " a "
    TR_assert_equal("a", m.TR_strip())
    TR_assert_equal(" a ", m)
}

TR_test "13.11 yerleşiklerin argüman hataları tek biçimdedir" {
    TR_assert_equal("H2423", TR_error_code { TR_sqrt(["a", 1][0]) })
    # tipi denetimde bilinmeyen değer çalışma anına ulaşır; denetim yanı tests/negative/metot_arguman_tipi.tr
    TR_var üç = TR_json_parse("3")
    TR_assert_equal("H2423", TR_error_code { [1].TR_filter(üç) })
    TR_assert_equal("H2011", TR_error_code { TR_sum() })
    TR_assert_equal("H2423", TR_error_code { TR_round(1.25, ["x", 1][0]) })
}

TR_test "13.1 dosya_oku ve dosya_yaz hataları Türkçedir; göreli yol önce çalışma klasöründe, sonra programın klasöründe aranır" {
    # Programın klasöründeki dosya, program başka bir klasörden çalıştırılsa da bulunur
    TR_assert(TR_read_file("data/tokenizer.json").TR_contains("model"))
    TR_assert_equal("H2132", TR_error_code { TR_read_file("data/olmayan_dosya.txt") })
    # Gösterilen ileti dosyanın yolunu söyler, işletim sisteminin kendi metni sızmaz
    # (TestShownErrorKeepsTheMessageText); yakalanan hatanın değeri asıl nedendir (8.3).
    TR_try { TR_read_file("data/olmayan_dosya.txt") } TR_catch h { TR_assert_equal(`Message("H2132")`, TR_String(h)) }
    TR_assert_equal("H2130", TR_error_code { TR_read_file("data") })
    TR_assert_equal("H2131", TR_error_code { TR_write_file("olmayan_klasör_tr/a.txt", "x") })
    TR_assert_equal("H2423", TR_error_code { TR_read_file(5) })
}

TR_test "13.1a yolda sekme ya da satır sonu varsa yol alan yerleşikler ham metni önerir" {
    TR_assert_equal("H2489", TR_error_code { TR_read_file("C:\tokenizer.json") })
    TR_assert_equal("H2489", TR_error_code { TR_write_file("D:\new\rapor.txt", "x") })
    # Önerilen ham metin, iletinin dilinden bağımsız olarak yolun kendisidir.
    TR_var m = ""
    TR_try { TR_read_file("C:\tokenizer.json") } TR_catch h { m = TR_String(h) }
    TR_assert_equal(`Message("H2489", "TR_read_file", "tab", "C:\\tokenizer.json")`, m)
    TR_try { TR_write_file("D:\new\rapor.txt", "x") } TR_catch h { m = TR_String(h) }
    TR_assert_equal(`Message("H2489", "TR_write_file", "newline", "D:\\new\\rapor.txt")`, m)
    TR_assert_equal("H2489", TR_error_code { TR_load_tensors("a\tb.trt") })
    TR_assert_equal("H2489", TR_error_code { TR_load_tokenizer("a\tb.json") })
    TR_assert_equal("H2489", TR_error_code { TR_Dataset("veri\tsayilar") })
}

TR_test "13.1 TR_write_file TR_String'i UTF-8, TR_Bytes'ı bayt bayt yazar; değerin metnini yazmaz" {
    TR_var k = TR_temp_dir()
    TR_write_file(TR_Path(k, "b.bin"), TR_Bytes([0, 255, 128]))
    TR_assert_equal(3, TR_Path(k, "b.bin").TR_size)
    TR_write_file(TR_Path(k, "s.txt"), TR_Bytes("şe"))
    TR_assert_equal("şe", TR_read_file(TR_Path(k, "s.txt")))
    TR_write_file(TR_Path(k, "bos.bin"), TR_Bytes([]))
    TR_assert_equal(0, TR_Path(k, "bos.bin").TR_size)
    # Tipi denetimde bilinmeyen değer: çalışma anının hatası (denetimdeki karşılığı tests/negative'de).
    TR_assert_equal("H2423", TR_error_code { TR_write_file(TR_Path(k, "x.txt"), [5, "a"][0]) })
    TR_assert_equal("H2423", TR_error_code { TR_write_file(TR_Path(k, "x.txt"), [[1, 2], "a"][0]) })
    TR_assert_equal("H2423", TR_error_code { TR_write_file(TR_Path(k, "x.txt"), [TR_none, 1, "a"][0]) })
    TR_assert_equal(TR_false, TR_Path(k, "x.txt").TR_exists)
    # JSON değeri JSON metni olarak yazılır: H2623 TR_json_string(...)'i önerir; öneriyle yazılan
    # dosya okununca aynı metin ve aynı JSON değeri döner (nesnede de, metinde de).
    TR_var j = TR_json_parse("{\"a\": 1, \"b\": [true, null]}")
    TR_assert_equal("H2623", TR_error_code { TR_write_file(TR_Path(k, "j.json"), j) })
    TR_write_file(TR_Path(k, "j.json"), TR_json_string(j))
    TR_assert_equal(TR_json_string(j), TR_read_file(TR_Path(k, "j.json")))
    TR_assert_equal(j, TR_json_parse(TR_read_file(TR_Path(k, "j.json"))))
    TR_var m = TR_json_parse("\"a\"")
    TR_assert_equal("H2623", TR_error_code { TR_write_file(TR_Path(k, "m.json"), m) })
    TR_write_file(TR_Path(k, "m.json"), TR_json_string(m))
    TR_assert_equal(m, TR_json_parse(TR_read_file(TR_Path(k, "m.json"))))
    TR_write_file(TR_Path(k, "x.txt"), TR_String([1, 2]))
    TR_assert_equal("[1, 2]", TR_read_file(TR_Path(k, "x.txt")))
}

TR_test "13.1 TR_read_bytes dosyayı TR_Bytes olarak olduğu gibi okur; .gz açılmaz" {
    TR_var k = TR_temp_dir()
    # Uçtan uca: TR_write_file'ın yazdığı bayt dizisi aynen döner (bütün bayt değerleri).
    TR_var hepsi = TR_Bytes([i TR_for i TR_in 0..256])
    TR_write_file(TR_Path(k, "hepsi.bin"), hepsi)
    TR_assert_equal(hepsi, TR_read_bytes(TR_Path(k, "hepsi.bin")))
    TR_assert_equal(256, TR_read_bytes(TR_String(TR_Path(k, "hepsi.bin"))).TR_length)
    TR_write_file(TR_Path(k, "bos.bin"), TR_Bytes([]))
    TR_assert_equal(TR_Bytes([]), TR_read_bytes(TR_Path(k, "bos.bin")))
    # .gz açılmaz: sıkıştırılmış baytlar gelir (gzip imzası 31, 139); TR_read_file açar (18.12).
    TR_write_file(TR_Path(k, "a.txt.gz"), "merhaba")
    TR_assert_equal(TR_Bytes([31, 139]), TR_read_bytes(TR_Path(k, "a.txt.gz"))[0..2])
    TR_assert_equal("merhaba", TR_read_file(TR_Path(k, "a.txt.gz")))
    # Yol 13.1a'nın okuma sırasıyla çözülür: programın klasöründeki dosya da bulunur.
    TR_assert_equal(TR_Bytes(TR_read_file("data/tokenizer.json")), TR_read_bytes("data/tokenizer.json"))
    TR_assert_equal("H2132", TR_error_code { TR_read_bytes("data/olmayan_dosya.bin") })
    TR_assert_equal("H2130", TR_error_code { TR_read_bytes("data") })
    TR_assert_equal("H2423", TR_error_code { TR_read_bytes([5, "a"][0]) })
}

TR_test "13.1 TR_read_file geçerli UTF-8 olmayan dosyada hatadır; ileti TR_read_bytes'ı önerir" {
    TR_var k = TR_temp_dir()
    TR_write_file(TR_Path(k, "ikili.bin"), TR_Bytes([0, 255, 128]))
    TR_assert_equal("H2621", TR_error_code { TR_read_file(TR_Path(k, "ikili.bin")) })
    # Önerinin yazımı aynı dosyayı okur (iletideki yol testi: TestReadFileInvalidUTF8SuggestsReadBytesWithItsPath).
    TR_assert_equal(TR_Bytes([0, 255, 128]), TR_read_bytes(TR_Path(k, "ikili.bin")))
    # Yarım kalan çok baytlı karakter de geçersizdir.
    TR_write_file(TR_Path(k, "yarim.txt"), TR_Bytes([97, 195]))
    TR_assert_equal("H2621", TR_error_code { TR_read_file(TR_Path(k, "yarim.txt")) })
    # .gz açılır (18.12); açılmış içerik geçersizse TR_read_bytes'ı önermeyen H2622.
    TR_write_file(TR_Path(k, "b.gz"), TR_Bytes([255]))
    TR_assert_equal("H2622", TR_error_code { TR_read_file(TR_Path(k, "b.gz")) })
    # Geçerli UTF-8 (boş dosya, BOM, çok baytlı karakter) aynen okunur.
    TR_write_file(TR_Path(k, "bos.txt"), "")
    TR_assert_equal("", TR_read_file(TR_Path(k, "bos.txt")))
    TR_write_file(TR_Path(k, "bom.txt"), TR_Bytes([239, 187, 191, 197, 159]))
    TR_assert_equal("\u{feff}ş", TR_read_file(TR_Path(k, "bom.txt")))
}

TR_test "13.2 ayırıcısız TR_split Unicode boşluk dizilerine böler, boş öğe vermez" {
    TR_assert_equal(["a", "b"], " a \t b\n".TR_split())
    TR_assert_equal(0, "   ".TR_split().TR_length)
    TR_assert_equal(0, "".TR_split().TR_length)
    TR_assert_equal(["a"], "a".TR_split())
    # TR_strip ile aynı boşluk: U+3000, U+0085, U+00A0
    TR_assert_equal(["a", "b"], "a\u{3000}b".TR_split())
    TR_assert_equal(["a", "b"], "a\u{85}b".TR_split())
    TR_assert_equal(["a", "b"], "a\u{a0}b".TR_split())
    TR_assert_equal("a", "\u{3000}\u{85}a\u{a0}".TR_strip())
    # ayırıcıyla boş öğeler kalır
    TR_assert_equal(["a", "", "b"], "a,,b".TR_split(","))
    TR_assert_equal(["", "a", ""], " a ".TR_split(" "))
}

TR_test "13.2 boş ayırıcı ve değiştirilecek boş alt metin hatadır, öbür boş alt metinler değil" {
    TR_var boş = ""
    TR_assert_equal("H2635", TR_error_code { "ab".TR_split("") })
    TR_assert_equal("H2635", TR_error_code { "ab".TR_split(boş) })
    TR_assert_equal("H2635", TR_error_code { "".TR_split("") })
    TR_assert_equal("H2636", TR_error_code { "ab".TR_replace("", "x") })
    TR_assert_equal("H2636", TR_error_code { "ab".TR_replace(boş, "x") })
    TR_assert_equal("H2636", TR_error_code { "".TR_replace("", "") })
    TR_assert_equal(["a", "b"], [c TR_for c TR_in "ab"])
    TR_assert("ab".TR_contains("") TR_and "ab".TR_starts_with("") TR_and "ab".TR_ends_with(""))
    TR_assert_equal("a", "ab".TR_replace("b", ""))
}

TR_test "13.2 metin metotları" {
    TR_assert_equal("ISTANBUL", "istanbul".TR_upper())
    TR_assert_equal("ilik", "ILIK".TR_lower())
    TR_assert_equal("a", "  a ".TR_strip())
    TR_assert_equal(["a", "b"], "a,b".TR_split(","))
    TR_assert_equal("axc", "abc".TR_replace("b", "x"))
    TR_assert("abc".TR_contains("b") TR_and "abc".TR_starts_with("a") TR_and "abc".TR_ends_with("c"))
    TR_assert_equal("cba", "abc".TR_reverse())
}

TR_test "13.2 TR_lines satır sonunda böler, sondaki satır sonundan boş satır vermez; TR_read_lines ile aynı" {
    TR_assert_equal(["a", "b\rc", ""], "a\r\nb\rc\n\n".TR_lines())
    TR_assert_equal(0, "".TR_lines().TR_length)
    TR_assert_equal([""], "\n".TR_lines())
    TR_assert_equal([""], "\r\n".TR_lines())
    TR_assert_equal(["", ""], "\n\n".TR_lines())
    TR_assert_equal(["a"], "a".TR_lines())
    TR_assert_equal(["a"], "a\n".TR_lines())
    TR_assert_equal(["ğ", "€"], "ğ\n€".TR_lines())
    TR_assert_equal(["\u{feff}a"], "\u{feff}a\n".TR_lines()) # metin değerdir, BOM atılmaz
    TR_var y = TR_Path(TR_temp_dir(), "s.txt")
    TR_for m TR_in ["a\r\nb\rc\n\n", "", "\n", "\r\n", "\n\n", "a", "a\n", "a\r", "\r", "\r\r\n", "a\r\r\nb"] {
        TR_write_file(y, m)
        TR_assert_equal([s TR_for s TR_in TR_read_lines(y)], m.TR_lines())
    }
}

TR_test "13.2 TR_index_of ilk konumu kod noktasıyla verir, bulunamazsa TR_none" {
    TR_assert_equal(1, "ğa".TR_index_of("a"))
    TR_assert_equal(1, "€a".TR_index_of("a"))
    TR_assert_equal(1, "😀a".TR_index_of("a"))
    TR_assert_equal(2, "abcabc".TR_index_of("c"))
    TR_assert_equal(1, "abcabc".TR_index_of("bc"))
    TR_assert_equal(0, "abc".TR_index_of(""))
    TR_assert_equal(0, "".TR_index_of(""))
    TR_assert_equal(99, "abc".TR_index_of("z") ?? 99)
    TR_assert_equal(99, "".TR_index_of("a") ?? 99)
    TR_assert("abc".TR_index_of("z") == TR_none)
}

TR_test "13.3 TR_index_of ilk konumu 4.5'in eşitliğiyle verir, bulunamazsa TR_none" {
    TR_assert_equal(1, [10, 20, 20].TR_index_of(20))
    TR_assert_equal(0, [1.0].TR_index_of(1))
    TR_assert_equal(1, [[1], [2]].TR_index_of([2]))
    TR_assert_equal(0, ["a"].TR_index_of("a"))
    TR_var boş: TR_List[TR_Int] = []
    TR_assert_equal(99, boş.TR_index_of(1) ?? 99)
    TR_assert_equal(99, [1].TR_index_of(2) ?? 99)
    TR_assert_equal(99, [TR_Float("nan")].TR_index_of(TR_Float("nan")) ?? 99)
}

TR_test "13.3 liste metotları" {
    TR_var l = [3, 1, 2, 2]
    TR_assert_equal([1, 2, 2, 3], l.TR_sort())
    TR_assert_equal([3, 1, 2], l.TR_unique())
    TR_assert_equal("3-1-2-2", l.TR_join("-"))
    TR_assert_equal(3, l.TR_first)
    TR_assert_equal(2, l.TR_last)
    TR_assert_equal(2.0, TR_mean(l))
    TR_assert(l.TR_contains(1))
}

TR_test "13.3 sırala sayıları tam, metinleri karakter sırasıyla dizer; karışık tip hatadır" {
    TR_assert_equal([9007199254740992, 9007199254740993], [9007199254740993, 9007199254740992].TR_sort())
    TR_assert_equal([-1, 0.5, 2, 2.5], [2.5, 2, -1, 0.5].TR_sort())
    TR_assert_equal(["a", "b", "ç"], ["ç", "b", "a"].TR_sort())
    TR_assert_equal("H2493", TR_error_code { [2, "10", 10].TR_sort() })
    TR_assert_equal("H2493", TR_error_code { [10, 2, "10"].TR_sort() })
    TR_assert_equal("H2492", TR_error_code { [TR_true, TR_false].TR_sort() })
}

TR_test "13.3 sıralama sırası: -0.0 0.0'dan önce, NaN'lar sonda; anahtarlı ve anahtarsız aynı" {
    TR_assert_equal("[-0.0, 0.0, 0.0, nan, nan]", TR_String([0.0, TR_nan, -0.0, 0.0, TR_nan].TR_sort()))
    TR_assert_equal("[-0.0, 0.0, nan]", TR_String([TR_nan, 0.0, -0.0].TR_sort((x) => x)))
    TR_assert_equal("[(-0.0, 3.0), (0.0, 2.0)]", TR_String([(0.0, 2.0), (-0.0, 3.0)].TR_sort()))
}

TR_test "13.3 anahtarlı sıralama: anahtarın sırası, kararlı, demet anahtar, her öğeye bir kez" {
    TR_assert_equal(["a", "bb", "dd", "ccc"], ["bb", "a", "ccc", "dd"].TR_sort((m) => m.TR_length))
    TR_assert_equal([3, 2, 1], [1, 3, 2].TR_sort((x) => -x))
    TR_assert_equal([(2, "a"), (1, "b"), (3, "b")], [(3, "b"), (1, "b"), (2, "a")].TR_sort((d) => (d.1, d.0)))
    TR_var l = [3, 1, 2]
    TR_var cagri = 0
    TR_func anahtar(x: TR_Int) -> TR_Int {
        cagri += 1
        TR_return x
    }
    TR_assert_equal([1, 2, 3], l.TR_sort(anahtar))
    TR_assert_equal(3, cagri)
    TR_assert_equal([3, 1, 2], l)
}

TR_test "13.3 anahtarlı sıralamanın hataları" {
    TR_assert_equal("H2900", TR_error_code { [3, 1].TR_sort((a, b) => a - b) })
    TR_assert_equal("H2902", TR_error_code { [3, 1].TR_sort((x) => [x]) })
    TR_assert_equal("H2903", TR_error_code { [3, 1].TR_sort((x) => TR_if x > 2 { "a" } TR_else { 1 }) })
    TR_var l = [3, 1]
    TR_func buyut(x: TR_Int) -> TR_Int {
        l.TR_append(x)
        TR_return x
    }
    TR_assert_equal("H2703", TR_error_code { l.TR_sort(buyut) })
}

TR_test "13.2 metotlar argümanın tipini denetler" {
    # tipi denetimde bilinmeyen değer çalışma anına ulaşır; denetim yanı tests/negative/metot_arguman_tipi.tr
    TR_var bir = TR_json_parse("1")
    TR_assert_equal("H2423", TR_error_code { "a1".TR_contains(bir) })
    TR_assert_equal("H2423", TR_error_code { "a,b".TR_split(bir) })
    TR_assert_equal("H2423", TR_error_code { [1, 2].TR_filter(bir) })
    # Liste ve sözlük içerir çalışma anında her tipte değer arar (tipi bilinmeyen değerle)
    TR_assert(TR_not [1, 2].TR_contains(["1", 1][0]))
    TR_assert([1, 2].TR_contains(1.0))
}

TR_test "13.3 boş ya da sayı olmayan listenin ortalaması hatadır" {
    TR_assert_equal(2.0, TR_mean([1, 2, 3]))
    TR_assert_equal("H2477", TR_error_code { TR_mean([]) })
    TR_assert_equal("H2486", TR_error_code { TR_mean([1, "x", 3]) })
}

TR_test "13.1 standart_sapma ve ortanca ortalama kadar sıkıdır: boş ve sayı olmayanda hata" {
    TR_assert_equal(2.5, TR_median([3, 1, 2, 4]))
    TR_assert_equal(2.0, TR_median([3, 1, 2]))
    TR_assert_equal("H2505", TR_error_code { TR_std([]) })
    TR_assert_equal("H2506", TR_error_code { TR_median([]) })
    TR_assert_equal("H2486", TR_error_code { TR_std([1, "x"]) })
    TR_assert_equal("H2486", TR_error_code { TR_median([1, TR_none, 3]) })
    TR_assert_equal("H2011", TR_error_code { TR_median() })
}

TR_test "13.1 tam sayı listesinde TR_mean, TR_std ve TR_median kesin değerin en yakın ondalığıdır" {
    TR_assert_equal(4503599627370497.0, TR_mean([9007199254740993, 1]))
    TR_assert_equal(TR_sqrt(2.0), TR_std([9007199254740993, 9007199254740995]))
    TR_assert_equal(4503599627370497.0, TR_median([9007199254740993, 1]))
    TR_assert_equal(9007199254740994.0, TR_median([9007199254740993, 9007199254740995]))
    # kesin değer iki ondalığın tam ortasındaysa çift olana gider
    TR_assert_equal(9007199254740992.0, TR_mean([9007199254740993, 9007199254740993]))
    TR_assert_equal(9007199254740996.0, TR_mean([9007199254740995, 9007199254740995]))
    # bir kez yuvarlanır: varyansı ondalığa çevirip kök almak son bitte ayrılır
    TR_assert_equal(103305.9772730181, TR_std([453326, 303265, 255301]))
    # ara değer taşmaz
    TR_var en_büyük = 9223372036854775807
    TR_var en_küçük = -9223372036854775807 - 1
    TR_assert_equal(9223372036854775808.0, TR_mean([en_büyük, en_büyük]))
    TR_assert_equal(-9223372036854775808.0, TR_mean([en_küçük, en_küçük]))
    TR_assert_equal(-0.5, TR_mean([en_büyük, en_küçük]))
    TR_assert_equal(9223372036854775808.0, TR_median([en_büyük, en_büyük]))
    TR_assert_equal(-0.5, TR_median([en_küçük, en_büyük]))
    TR_assert_equal(1.3043817825332783e19, TR_std([en_büyük, en_küçük]))
    TR_assert_equal(0.0, TR_std([en_büyük, en_büyük]))
    # sıralama kesindir: ortadaki öğeler ondalıkta eşit görünse de yerleri değişmez
    TR_assert_equal(9007199254740992.0, TR_median([9007199254740993, 9007199254740992, 1]))
    # karışık liste ayrı yoldadır
    TR_assert_equal(1.5, TR_mean([1, 2.0]))
    TR_assert_equal(TR_sqrt(0.5), TR_std([1, 2.0]))
    TR_assert_equal(1.5, TR_median([1, 2.0]))
}

TR_test "13.1 TR_mean, TR_std ve TR_median yalnız liste alır; TR_max ve TR_min bir liste ya da iki değer" {
    TR_assert_equal("H2011", TR_error_code { TR_mean(1, 2) })
    TR_assert_equal("H2011", TR_error_code { TR_std(1, 2) })
    TR_assert_equal("H2011", TR_error_code { TR_median(1, 2) })
    TR_assert_equal("H2011", TR_error_code { TR_max(1) })
    TR_assert_equal("H2011", TR_error_code { TR_min(1.5) })
    TR_assert_equal("H2011", TR_error_code { TR_max((1, 2)) })
    TR_assert_equal(2, TR_max(1, 2))
    TR_assert_equal(1, TR_max([1]))
    TR_assert_equal((1, 2), TR_max([(1, 2)]))
}

TR_test "13.1 toplama yapan yerleşikler listede NaN varsa NaN verir, nerede olursa olsun" {
    TR_for l TR_in [[1.0, 2.0, TR_nan], [1.0, TR_nan, 2.0], [TR_nan, 1.0, 2.0], [TR_inf, TR_nan, -TR_inf]] {
        TR_assert_equal("nan", TR_String(TR_sum(l)))
        TR_assert_equal("nan", TR_String(TR_mean(l)))
        TR_assert_equal("nan", TR_String(TR_std(l)))
        TR_assert_equal("nan", TR_String(TR_median(l)))
        TR_assert_equal("nan", TR_String(TR_min(l)))
        TR_assert_equal("nan", TR_String(TR_max(l)))
    }
    TR_assert_equal("nan", TR_String(TR_min(1.0, TR_nan)))
    TR_assert_equal("nan", TR_String(TR_max(TR_nan, 1.0)))
}

TR_test "13.1 TR_median listede NaN varsa NaN verir, nerede olursa olsun" {
    TR_assert_equal("nan", TR_String(TR_median([1.0, 2.0, TR_nan])))
    TR_assert_equal("nan", TR_String(TR_median([1.0, TR_nan, 2.0])))
    TR_assert_equal("nan", TR_String(TR_median([TR_nan, 1.0, 2.0, 3.0])))
    TR_assert_equal("nan", TR_String(TR_median([TR_nan])))
    TR_assert_equal("nan", TR_String(TR_median([1, TR_nan])))
    TR_assert_equal("inf", TR_String(TR_median([1.0, TR_inf, TR_inf])))
}

TR_test "13.1 TR_std örneklem sapmasıdır: n−1'e böler, iki geçişlidir, iki öğeden azda hatadır" {
    # Beklenenler dil tanımından: ortalama, farkların karelerinin toplamı, n−1'e bölüm, karekök.
    TR_assert_equal(TR_sqrt(32.0 / 7.0), TR_std([2, 4, 4, 4, 5, 5, 7, 9]))
    TR_assert_equal(2.138089935299395, TR_std([2, 4, 4, 4, 5, 5, 7, 9]))
    TR_assert_equal(TR_sqrt(0.5), TR_std([1, 2]))
    TR_assert_equal(TR_sqrt(2.0), TR_std([1.0, 3.0]))
    TR_assert_equal(0.0, TR_std([7, 7]))
    TR_assert_equal(TR_Float, TR_Type(TR_std([1, 2])))
    TR_assert_equal("H2620", TR_error_code { TR_std([1.5]) })
    TR_assert_equal("H2620", TR_error_code { TR_std([5]) })
    TR_assert_equal("H2505", TR_error_code { TR_std([]) })
}

TR_test "13.1 boş TR_List[TR_Float]'ın toplamı TR_Float'tır: 0.0; boş TR_List[TR_Int]'inki 0" {
    TR_var yazılı: TR_List[TR_Float] = []
    TR_assert_equal(TR_Float, TR_Type(TR_sum(yazılı)))
    TR_assert_equal("0.0", TR_String(TR_sum(yazılı)))
    TR_var çıkarılan = [x * 0.5 TR_for x TR_in [1, 2, 3] TR_if x > 5]
    TR_assert_equal("0.0", TR_String(TR_sum(çıkarılan)))
    TR_assert_equal("0.0", boş.boş_ondalıkların_toplamı())
    TR_var tamlar: TR_List[TR_Int] = []
    TR_assert_equal(TR_Int, TR_Type(TR_sum(tamlar)))
    TR_assert_equal("0", TR_String(TR_sum([x TR_for x TR_in [1, 2] TR_if x > 5])))
}

TR_test "13.1 ondalık toplam soldan sağa telafilidir (Neumaier); TR_mean ve TR_std aynı toplamı kullanır" {
    TR_assert_equal(1.0, TR_sum([1e16, 1.0, -1e16]))
    TR_assert_equal(1.0, TR_sum([1.0, 1e16, -1e16]))
    TR_assert_equal(2.0, TR_sum([1, 1e16, 1.0, -1e16]))
    TR_assert_equal(1.0 / 3.0, TR_mean([1e16, 1.0, -1e16]))
    TR_assert_equal(1e16, TR_std([1e16, 1.0, -1e16]))
    # Sonlu olmayan öğede IEEE 754 gibi.
    TR_assert_equal(TR_inf, TR_sum([1.0, TR_inf]))
    TR_assert(TR_not TR_is_finite(TR_sum([TR_inf, -TR_inf])) TR_and TR_sum([TR_inf, -TR_inf]) != TR_sum([TR_inf, -TR_inf]))
    TR_assert(TR_mean([1.0, TR_nan]) != TR_mean([1.0, TR_nan]))
    # Tam sayı listesinin toplamı tamdır, değişmez.
    TR_assert_equal(6, TR_sum([1, 2, 3]))
    TR_assert_equal(0, TR_sum([]))
}

TR_test "13.5 yerleşikler ve metotlar bilinmeyen adlı argümanı reddeder" {
    TR_assert_equal("H2427", TR_error_code { TR_print("a", ayraç: "-") })
    TR_assert_equal("H2427", TR_error_code { "a b".TR_split(TR_dim: 1) })
    TR_assert_equal("H7900", TR_error_code { TR_sum([1, 2], eksn: 0) })
    TR_assert_equal("H7900", TR_error_code { TR_AdamW([TR_Tensor([1.0], TR_requires_grad: TR_true)], lr: 0.1) })
    TR_assert_equal("H7900", TR_error_code { TR_sample(TR_Tensor([1.0, 2.0]), tohm: 1) })
}

TR_test "13.6 hedef tipin adını taşıyan dönüştürücüler kurucudur ve tip() genel sorudur: ikisi de fonksiyondur" {
    TR_assert_equal(5, TR_Int("5"))
    TR_assert_equal(2.5, TR_Float("2.5"))
    TR_assert_equal("[1, 2]", TR_String([1, 2]))
    TR_assert_equal(TR_List, TR_Type([1]))
    # Yapının 'tip' alanı yerleşik tip() ile çakışmaz
    TR_struct Ürün { ad: TR_String, tip: TR_String }
    TR_var ü = Ürün("kalem", "kırtasiye")
    TR_assert_equal("kırtasiye", ü.tip)
    TR_assert_equal(Ürün, TR_Type(ü))
}

TR_test "13.6 değeri dönüştüren ya da soran iş metot, matematik ve tensör işi fonksiyondur" {
    TR_var l = [3, 1, 2]
    TR_assert_equal(3, l.TR_length)
    TR_assert_equal([1, 2, 3], l.TR_sort())
    TR_assert_equal(6, TR_sum(l))
    TR_assert_equal(2.0, TR_mean(l))
    TR_assert_equal(6, l.TR_reduce(0, (a, x) => a + x))
    TR_assert_equal(6, l.TR_reduce((a, x) => a * x))
    TR_assert_equal(4, l.TR_reduce(10, (acc, x) => acc - x))
    TR_assert_equal("H2637", TR_error_code { [].TR_reduce((a, x) => a + x) })
    TR_assert_equal(5, [5].TR_reduce((a, x) => a + x))
    TR_assert_equal(7, [].TR_reduce(7, (a, x) => a + x))
    TR_assert_equal([[1, 2]], TR_Tensor([[1.0], [2.0]]).TR_transpose().TR_tolist)
    # Öbür biçim yoktur: liste.toplam() ve tensör.toplam bir üye değildir.
    TR_assert_equal("H2474", TR_error_code { l.toplam() })
    TR_assert_equal("H6721", TR_error_code { TR_Tensor([1.0]).toplam })
    TR_assert_equal("H2475", TR_error_code { l.TR_reduce((a, x) => a + x, 0) })
    # Metot adları genel kapsamda sıradan adlardır
    TR_var uzunluk = 5
    TR_func sırala(x: TR_Int) -> TR_Int { TR_return x }
    TR_assert_equal([5, 3], [uzunluk, sırala(3)])
}

TR_test "13.4 sözlük metotları" {
    TR_var d = {"a": 1, "b": 2}
    TR_assert_equal(["a", "b"], d.TR_keys())
    TR_assert_equal([1, 2], d.TR_values())
    TR_assert(d.TR_contains("a"))
}

TR_test "13.4 .TR_remove anahtarı yerinde siler ve değerini verir, anahtar yoksa TR_none" {
    TR_var d = {"a": 1, "b": 2, "c": 3}
    TR_var kopya = d
    TR_assert_equal(2, d.TR_remove("b") ?? 0)
    TR_assert_equal(["a", "c"], d.TR_keys())
    TR_assert_equal([1, 3], d.TR_values())
    TR_assert_equal(2, kopya.TR_length)
    TR_assert_equal(TR_false, d.TR_contains("b"))
    TR_assert_equal(TR_none, d.TR_get("b"))
    TR_assert_equal(TR_none, d.TR_remove("b"))
    TR_assert_equal(2, d.TR_length)
    # Silinen anahtar yeniden eklenince sona gelir
    d["b"] = 4
    TR_assert_equal(["a", "c", "b"], d.TR_keys())
    # Metin olmayan anahtar: 1 ile "1" ayrıdır
    TR_var n = {1: "tam", "1": "metin", TR_true: "doğru"}
    TR_assert_equal("tam", n.TR_remove(1) ?? "")
    TR_assert_equal(["1", TR_true], n.TR_keys())
    TR_assert_equal("doğru", n.TR_remove(TR_true) ?? "")
    TR_assert_equal("metin", n.TR_remove("1") ?? "")
    TR_assert_equal(0, n.TR_length)
    TR_assert_equal(TR_none, n.TR_remove("1"))
    # Bulunmayan anahtar da .TR_get gibi denetlenir: ondalık ve liste anahtar olamaz
    TR_assert_equal("H2646", TR_error_code { n.TR_remove(1.5) })
    TR_assert_equal("H2495", TR_error_code { n.TR_remove([1]) })
}

TR_test "13.4 .TR_remove sözlükten siler, aynı adlı dosyaya dokunmaz" {
    TR_var yol = TR_Path(TR_temp_dir(), "anahtar.txt")
    TR_write_file(yol, "değerli")
    TR_var d = {TR_String(yol): 1}
    TR_assert_equal(1, d.TR_remove(TR_String(yol)) ?? 0)
    TR_assert_equal(0, d.TR_length)
    TR_assert_equal("değerli", TR_read_file(yol))
    # Anahtar yoksa da dosya durur
    TR_assert_equal(TR_none, d.TR_remove(TR_String(yol)))
    TR_assert_equal("değerli", TR_read_file(yol))
}

TR_test "13.3 .TR_pop son öğeyi çıkarıp verir, boş listede hatadır" {
    TR_var l = [1, 2, 3]
    TR_var kopya = l
    TR_assert_equal(3, l.TR_pop())
    TR_assert_equal([1, 2], l)
    TR_assert_equal(2, kopya.TR_length)
    TR_assert_equal(2, l.TR_pop())
    TR_assert_equal(1, l.TR_pop())
    TR_assert_equal(0, l.TR_length)
    TR_assert_equal("H2533", TR_error_code { l.TR_pop() })
    # Boşalan liste yeniden dolar; dilim çıkarmadan etkilenmez
    l.TR_append(7, 8)
    TR_var dilim = l[0..2]
    l.TR_pop()
    TR_assert_equal([7], l)
    TR_assert_equal([7, 8], dilim)
    # Çıkan tensör listeyle birlikte gitmez
    TR_var t = [TR_Tensor([1.0]), TR_Tensor([2.0])]
    TR_var son = t.TR_pop()
    t = []
    TR_assert_equal([2.0], son.TR_tolist)
}

TR_test "13.3 .TR_remove_at öğeyi çıkarıp verir, negatif indeks sondan sayar" {
    TR_var l = [10, 20, 30, 40]
    TR_assert_equal(20, l.TR_remove_at(1))
    TR_assert_equal([10, 30, 40], l)
    TR_assert_equal(40, l.TR_remove_at(-1))
    TR_assert_equal(10, l.TR_remove_at(0))
    TR_assert_equal(30, l.TR_remove_at(-1))
    TR_assert_equal(0, l.TR_length)
    TR_var k = [1, 2]
    TR_assert_equal("H2534", TR_error_code { k.TR_remove_at(2) })
    TR_assert_equal("H2534", TR_error_code { k.TR_remove_at(-3) })
    TR_assert_equal("H2534", TR_error_code { [].TR_remove_at(0) })
    TR_assert_equal([1, 2], k)
}

TR_test "13.3 fonksiyonu dolaşılan listeyi değiştiren metotlar hata verir" {
    TR_var a = [1, 2, 3]
    TR_assert_equal("H2703", TR_error_code { a.TR_map((x) => a.TR_pop()) })
    TR_var b = [1, 2, 3]
    TR_func ekle(x: TR_Int) -> TR_Bool {
        b.TR_append(x)
        TR_return TR_true
    }
    TR_assert_equal("H2703", TR_error_code { b.TR_filter(ekle) })
    TR_var c = [1, 2, 3]
    TR_func cikar(t: TR_Int, x: TR_Int) -> TR_Int {
        c.TR_pop()
        TR_return t + x
    }
    TR_assert_equal("H2703", TR_error_code { c.TR_reduce(0, cikar) })
    TR_var e = [1, 2, 3]
    TR_func anahtar(x: TR_Int) -> TR_Int {
        e.TR_pop()
        e.TR_append(9)
        TR_return x
    }
    TR_assert_equal("H2703", TR_error_code { e.TR_sort(anahtar) })
}

TR_test "13.8 ondalık 3.2'nin yazımıyla yazılır, geri okununca yine ondalıktır" {
    TR_assert_equal("[1.0,2.5,1e-07,1e+16,-0.0]", TR_json_string([1.0, 2.5, 1e-7, 1e16, -0.0]))
    TR_assert_equal(TR_Float, TR_Type(TR_json_parse(TR_json_string([1.0]))[0]))
    TR_assert_equal([1.0, 1e16], TR_List(TR_json_parse(TR_json_string([1.0, 1e16]))).TR_map((x) => TR_Float(x)))
    TR_assert_equal("[1.0,2.5]", TR_json_string(TR_Tensor([1.0, 2.5])))
    TR_assert_equal("[1,2]", TR_json_string(TR_Tensor[TR_Int]([1, 2])))
    TR_assert_equal("[1,2.0]", TR_json_string(TR_json_parse("[1,2.0]")))
}

TR_test "13.8 anahtarı metin olmayan sözlük JSON'a yazılmaz; anahtarlar TR_String ile çevrilir" {
    TR_var d = {1: 2.5, 2: 3.5}
    TR_assert_equal("H7012", TR_error_code { TR_json_string(d) })
    TR_assert_equal("H7012", TR_error_code { TR_json_string([{"a": {(1, 2): 1}}]) })
    TR_var m = {}
    TR_for k, v TR_in d { m[TR_String(k)] = v }
    TR_assert_equal(`{"1":2.5,"2":3.5}`, TR_json_string(m))
}

TR_test "13.8 csv_oku dosya okur, csv_çöz metni ayrıştırır" {
    TR_var k = TR_temp_dir()
    TR_write_file(TR_Path(k, "t.csv"), "ad,yaş\nAli,30")
    TR_assert_equal([["ad", "yaş"], ["Ali", "30"]], TR_read_csv(TR_Path(k, "t.csv")))
    TR_assert_equal([["ad", "yaş"], ["Ali", "30"]], TR_parse_csv("ad,yaş\nAli,30"))
    # Hücre hep metindir; sayı tip çağrısıyla çevrilir (3.12).
    TR_var h = TR_parse_csv("007,7,1.5, 2 \n")
    TR_assert_equal([["007", "7", "1.5", "2"]], h)
    TR_assert_equal(TR_String, TR_Type(h[0][1]))
    TR_assert_equal(8, TR_Int(h[0][1]) + 1)
    TR_assert_equal(3.0, TR_Float(h[0][2]) * 2)
    TR_assert_equal("H7006", TR_error_code { TR_read_csv("ad,yaş\nAli,30") })
    TR_assert_equal("H2423", TR_error_code { TR_parse_csv([5, "a"][0]) })
}
