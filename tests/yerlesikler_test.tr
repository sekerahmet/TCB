//! tr kodlu 3 dil=tr
// docs/spec/13_yerlesikler.md §13 — Yerleşik fonksiyonlar ve metotlar (seçki)

TR_ctx_test "13.1 genel yerleşikler" {
    TR_fn_assert_equal(3, [1, 2, 3].TR_mem_length)
    TR_fn_assert_equal(6, TR_fn_sum([1, 2, 3]))
    TR_fn_assert_equal(1, TR_fn_min([3, 1, 2]))
    TR_fn_assert_equal(3, TR_fn_max([3, 1, 2]))
    TR_fn_assert_equal(5, TR_fn_abs(-5))
    TR_fn_assert_equal(3.0, TR_fn_sqrt(9))
    TR_fn_assert_equal([0, 1, 2], TR_fn_range(0, 3))
}

TR_ctx_test "13.1 min ve max türü korur, Tam'ları tam karşılaştırır, sayı olmayanda hata verir" {
    TR_fn_assert_equal(2.0, TR_fn_max([2.0, 1.5]))
    TR_fn_assert_equal(TR_type_Float, TR_fn_type(TR_fn_max([2.0, 1.5])))
    TR_fn_assert_equal(TR_type_Int, TR_fn_type(TR_fn_min([1, 2.5])))
    TR_fn_assert_equal(9007199254740993, TR_fn_max([9007199254740993, 1]))
    TR_fn_assert(TR_fn_max([9007199254740993, 9007199254740992]) != 9007199254740992)
    TR_fn_assert_equal(TR_type_Int, TR_fn_type(TR_fn_max(9223372036854775807, 1)))
    TR_fn_assert_equal(-7, TR_fn_min(3, -7, 0.5))
    TR_fn_assert_equal(TR_kw_none, TR_fn_max([]))
    TR_kw_var hatalar = []
    TR_kw_try { TR_fn_max([1, "a", 5]) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_min("abc") } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_sum([1, "a", 2]) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_fn_assert_equal(3, hatalar.TR_mem_length, TR_fn_str(hatalar))
    TR_fn_assert(hatalar[0].TR_mem_contains("max(): listenin 2. elemanı Tam ya da Ondalık olmalıdır, Metin (\"a\") verildi"), hatalar[0])
    TR_fn_assert(hatalar[1].TR_mem_contains("min() 1. argüman olarak Tam ya da Ondalık bekler"), hatalar[1])
    // Negatif basamak onlar, yüzler basamağına yuvarlar
    TR_fn_assert_equal(1200, TR_fn_round(1234, -2))
    TR_fn_assert_equal(1240, TR_fn_round(1235.0, -1))
    TR_fn_assert_equal(4, TR_fn_round(3.6))
}

TR_ctx_test "13.1 yerleşiklerin argüman hataları tek biçimdedir" {
    TR_kw_var m = ""
    TR_kw_try { TR_fn_range("a") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_ends_with("aralık() 1. argüman olarak Tam bekler, Metin (\"a\") verildi"), m)
    TR_kw_try { TR_fn_range(1, 2.5) } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_ends_with("aralık() 2. argüman olarak Tam bekler, Ondalık (2.5) verildi"), m)
    TR_kw_try { [1].TR_mem_filter(3) } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_ends_with("liste.filtrele() 1. argüman olarak Fonksiyon bekler, Tam (3) verildi"), m)
    TR_kw_try { TR_fn_sum() } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_ends_with("toplam() 1 argüman bekler, 0 verildi (kullanım: toplam(liste))"), m)
    TR_kw_try { TR_fn_round(1.25, "x") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_ends_with("yuvarla() 2. argüman olarak Tam bekler, Metin (\"x\") verildi"), m)
}

TR_ctx_test "13.1 dosya_oku ve dosya_yaz hataları Türkçedir; göreli yol önce çalışma klasöründe, sonra programın klasöründe aranır" {
    // Programın klasöründeki dosya, program başka bir klasörden çalıştırılsa da bulunur
    TR_fn_assert(TR_fn_read_file("data/tokenizer.json").TR_mem_contains("model"))
    TR_kw_var m = ""
    TR_kw_try { TR_fn_read_file("data/olmayan_dosya.txt") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_contains("dosya_oku(): \"data/olmayan_dosya.txt\" okunamadı: böyle bir dosya ya da klasör yok"), m)
    TR_fn_assert(m.TR_mem_contains("bakılan yerler: "), m)
    TR_fn_assert(TR_kw_not m.TR_mem_contains("system cannot"), m)
    TR_kw_try { TR_fn_read_file("data") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_contains("bu bir klasör, dosya değil"), m)
    TR_kw_try { TR_fn_write_file("olmayan_klasör_tr/a.txt", "x") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_ends_with("dosya_yaz(): \"olmayan_klasör_tr/a.txt\" yazılamadı: \"olmayan_klasör_tr\" klasörü yok"), m)
    TR_kw_try { TR_fn_read_file(5) } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_ends_with("dosya_oku() 1. argüman olarak Metin ya da Yol bekler, Tam (5) verildi"), m)
}

TR_ctx_test "13.1a yolda sekme ya da satır sonu varsa yol alan yerleşikler ham metni önerir" {
    TR_kw_var m = ""
    TR_kw_try { TR_fn_read_file("C:\tokenizer.json") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_contains("dosya_oku(): dosya yolunda sekme karakteri var"), m)
    TR_fn_assert(m.TR_mem_contains("ham metin kullanın: `C:\\tokenizer.json`"), m)
    TR_kw_try { TR_fn_write_file("D:\new\rapor.txt", "x") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_contains("dosya_yaz(): dosya yolunda satır sonu karakteri var"), m)
    TR_fn_assert(m.TR_mem_contains(`D:\new\rapor.txt`), m)
    TR_kw_try { TR_fn_load_tensors("a\tb.trt") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_contains("tensör_yükle: dosya yolunda sekme"), m)
    TR_kw_try { TR_fn_load_tokenizer("a\tb.json") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_contains("parçalayıcı_yükle: dosya yolunda sekme"), m)
    TR_kw_try { TR_fn_dataset("veri\tsayilar") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_contains("veri_kümesi: dosya yolunda sekme"), m)
}

TR_ctx_test "13.2 metin metotları" {
    TR_fn_assert_equal("İSTANBUL", "istanbul".TR_mem_upper())
    TR_fn_assert_equal("ılık", "ILIK".TR_mem_lower())
    TR_fn_assert_equal("a", "  a ".TR_mem_strip())
    TR_fn_assert_equal(["a", "b"], "a,b".TR_mem_split(","))
    TR_fn_assert_equal("axc", "abc".TR_mem_replace("b", "x"))
    TR_fn_assert("abc".TR_mem_contains("b") TR_kw_and "abc".TR_mem_starts_with("a") TR_kw_and "abc".TR_mem_ends_with("c"))
    TR_fn_assert_equal("cba", "abc".TR_mem_reverse())
}

TR_ctx_test "13.3 liste metotları" {
    TR_kw_var l = [3, 1, 2, 2]
    TR_fn_assert_equal([1, 2, 2, 3], l.TR_mem_sort())
    TR_fn_assert_equal([3, 1, 2], l.TR_mem_unique())
    TR_fn_assert_equal("3-1-2-2", l.TR_mem_join("-"))
    TR_fn_assert_equal(3, l.TR_mem_first)
    TR_fn_assert_equal(2, l.TR_mem_last)
    TR_fn_assert_equal(2.0, TR_fn_mean(l))
    TR_fn_assert(l.TR_mem_contains(1))
}

TR_ctx_test "13.3 sırala sayıları tam, metinleri karakter sırasıyla dizer; karışık tip hatadır" {
    TR_fn_assert_equal([9007199254740992, 9007199254740993], [9007199254740993, 9007199254740992].TR_mem_sort())
    TR_fn_assert_equal([-1, 0.5, 2, 2.5], [2.5, 2, -1, 0.5].TR_mem_sort())
    TR_fn_assert_equal(["a", "b", "ç"], ["ç", "b", "a"].TR_mem_sort())
    TR_kw_var hatalar = []
    TR_kw_try { [2, "10", 10].TR_mem_sort() } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { [10, 2, "10"].TR_mem_sort() } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { [TR_kw_true, TR_kw_false].TR_mem_sort() } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_fn_assert_equal(3, hatalar.TR_mem_length, TR_fn_str(hatalar))
    TR_kw_for h TR_kw_in hatalar { TR_fn_assert(h.TR_mem_contains("yalnızca sayılardan ya da yalnızca metinlerden"), h) }
}

TR_ctx_test "13.2 metotlar argüman sayısını ve tipini denetler" {
    TR_kw_var hatalar = []
    TR_kw_try { "abc".TR_mem_contains() } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { "a1".TR_mem_contains(1) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { "abc".TR_mem_upper(1) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { "a,b".TR_mem_split(1) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { "abc".TR_mem_replace("a") } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { [1, 2].TR_mem_filter(3) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { [1].TR_mem_append() } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { {"a": 1}.TR_mem_keys(1) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_fn_assert_equal(8, hatalar.TR_mem_length, TR_fn_str(hatalar))
    TR_fn_assert(hatalar[0].TR_mem_contains("metin.içerir() 1 argüman bekler, 0 verildi (kullanım: metin.içerir(alt))"), hatalar[0])
    TR_fn_assert(hatalar[1].TR_mem_contains("metin.içerir() 1. argüman olarak Metin bekler, Tam (1) verildi"), hatalar[1])
    TR_fn_assert(hatalar[2].TR_mem_contains("metin.büyük_harf() 0 argüman bekler, 1 verildi"), hatalar[2])
    TR_fn_assert(hatalar[5].TR_mem_contains("liste.filtrele() 1. argüman olarak Fonksiyon bekler"), hatalar[5])
    // Liste ve sözlük içerir her tipte değer arar
    TR_fn_assert(TR_kw_not [1, 2].TR_mem_contains("1"))
    TR_fn_assert([1, 2].TR_mem_contains(1.0))
}

TR_ctx_test "13.3 boş ya da sayı olmayan listenin ortalaması hatadır" {
    TR_fn_assert_equal(2.0, TR_fn_mean([1, 2, 3]))
    TR_kw_var hatalar = []
    TR_kw_try { TR_fn_mean([]) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_mean([1, "x", 3]) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_fn_assert_equal(2, hatalar.TR_mem_length, TR_fn_str(hatalar))
    TR_fn_assert(hatalar[0].TR_mem_contains("boş listenin ortalaması yoktur"), hatalar[0])
    TR_fn_assert(hatalar[1].TR_mem_contains("listenin 2. elemanı Tam ya da Ondalık olmalıdır"), hatalar[1])
}

TR_ctx_test "13.1 standart_sapma ve ortanca ortalama kadar sıkıdır: boş ve sayı olmayanda hata" {
    TR_fn_assert_equal(2.0, TR_fn_std([2, 4, 4, 4, 5, 5, 7, 9]))
    TR_fn_assert_equal(0.5, TR_fn_std(1, 2))
    TR_fn_assert_equal(2.5, TR_fn_median([3, 1, 2, 4]))
    TR_fn_assert_equal(2.0, TR_fn_median(3, 1, 2))
    TR_kw_var hatalar = []
    TR_kw_try { TR_fn_std([]) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_median([]) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_std([1, "x"]) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_median([1, TR_kw_none, 3]) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_median() } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_fn_assert_equal(5, hatalar.TR_mem_length, TR_fn_str(hatalar))
    TR_fn_assert(hatalar[0].TR_mem_contains("standart_sapma(): boş listenin standart sapması yoktur"), hatalar[0])
    TR_fn_assert(hatalar[1].TR_mem_contains("ortanca(): boş listenin ortancası yoktur"), hatalar[1])
    TR_fn_assert(hatalar[2].TR_mem_contains("standart_sapma(): listenin 2. elemanı Tam ya da Ondalık olmalıdır, Metin (\"x\") verildi"), hatalar[2])
    TR_fn_assert(hatalar[3].TR_mem_contains("ortanca(): listenin 2. elemanı Tam ya da Ondalık olmalıdır"), hatalar[3])
    TR_fn_assert(hatalar[4].TR_mem_contains("ortanca() en az 1 argüman bekler"), hatalar[4])
}

TR_ctx_test "13.5 yerleşikler ve metotlar bilinmeyen adlı argümanı reddeder" {
    TR_kw_var hatalar = []
    TR_kw_try { TR_fn_print("a", ayraç: "-") } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { "a b".TR_mem_split(TR_arg_dim: 1) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_sum([1, 2], eksn: 0) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_AdamW([TR_fn_tensor([1.0], TR_arg_requires_grad: TR_kw_true)], lr: 0.1) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_sample(TR_fn_tensor([1.0, 2.0]), tohm: 1) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_fn_assert_equal(5, hatalar.TR_mem_length, TR_fn_str(hatalar))
    TR_fn_assert(hatalar[0].TR_mem_contains("yazdır() 'ayraç' adında bir parametre almaz (adlı argüman almaz)"), hatalar[0])
    TR_fn_assert(hatalar[1].TR_mem_contains("metin.böl() 'eksen' adında bir parametre almaz (adlı argüman almaz)"), hatalar[1])
    TR_fn_assert(hatalar[2].TR_mem_contains("toplam() 'eksn' adında bir parametre almaz. Bunu mu demek istediniz: 'eksen'?"), hatalar[2])
    TR_fn_assert(hatalar[3].TR_mem_contains("AdamW 'lr' adında bir parametre almaz. Bunu mu demek istediniz: 'öğrenme_oranı'?"), hatalar[3])
    TR_fn_assert(hatalar[4].TR_mem_contains("örnekle() 'tohm' adında bir parametre almaz. Bunu mu demek istediniz: 'tohum'?"), hatalar[4])
}

TR_ctx_test "13.6 hedef tipin adını taşıyan dönüştürücüler kurucudur ve tip() genel sorudur: ikisi de fonksiyondur" {
    TR_fn_assert_equal(5, TR_fn_int("5"))
    TR_fn_assert_equal(2.5, TR_fn_float("2.5"))
    TR_fn_assert_equal("[1, 2]", TR_fn_str([1, 2]))
    TR_fn_assert_equal(TR_type_List, TR_fn_type([1]))
    // Yapının 'tip' alanı yerleşik tip() ile çakışmaz
    TR_kw_struct Ürün { ad, tip }
    TR_kw_var ü = Ürün("kalem", "kırtasiye")
    TR_fn_assert_equal("kırtasiye", ü.tip)
    TR_fn_assert_equal(Ürün, TR_fn_type(ü))
}

TR_ctx_test "13.6 değeri dönüştüren ya da soran iş metot, matematik ve tensör işi fonksiyondur" {
    TR_kw_var l = [3, 1, 2]
    TR_fn_assert_equal(3, l.TR_mem_length)
    TR_fn_assert_equal([1, 2, 3], l.TR_mem_sort())
    TR_fn_assert_equal(6, TR_fn_sum(l))
    TR_fn_assert_equal(2.0, TR_fn_mean(l))
    TR_fn_assert_equal(6, l.TR_mem_reduce(0, (a, x) => a + x))
    TR_fn_assert_equal(6, l.TR_mem_reduce((a, x) => a * x))
    TR_fn_assert_equal(4, l.TR_mem_reduce(10) { TR_ctx_acc - TR_ctx_it })
    TR_fn_assert_equal(TR_kw_none, [].TR_mem_reduce((a, x) => a + x))
    TR_fn_assert_equal(7, [].TR_mem_reduce(7, (a, x) => a + x))
    TR_fn_assert_equal([[1, 2]], TR_fn_tensor([[1], [2]]).TR_mem_transpose().TR_mem_tolist)
    // Öbür biçim yoktur: liste.toplam() ve tensör.toplam bir üye değildir.
    TR_kw_var hatalar = []
    TR_kw_try { l.toplam() } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { TR_fn_tensor([1.0]).toplam } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_kw_try { l.TR_mem_reduce((a, x) => a + x, 0) } TR_kw_catch h { hatalar.TR_mem_append(h) }
    TR_fn_assert_equal(3, hatalar.TR_mem_length, TR_fn_str(hatalar))
    TR_fn_assert(hatalar[0].TR_mem_contains("\"toplam\""), hatalar[0])
    TR_fn_assert(hatalar[2].TR_mem_contains("liste.indirge(): fonksiyon son argüman olmalı"), hatalar[2])
    // Metot adları genel kapsamda sıradan adlardır
    TR_kw_var uzunluk = 5
    TR_kw_func sırala(x) { TR_kw_return x }
    TR_fn_assert_equal([5, 3], [uzunluk, sırala(3)])
}

TR_ctx_test "13.4 sözlük metotları" {
    TR_kw_var d = {"a": 1, "b": 2}
    TR_fn_assert_equal(["a", "b"], d.TR_mem_keys())
    TR_fn_assert_equal([1, 2], d.TR_mem_values())
    TR_fn_assert(d.TR_mem_contains("a"))
}

TR_ctx_test "13.8 csv_oku dosya okur, csv_çöz metni ayrıştırır" {
    TR_kw_var k = TR_fn_temp_dir()
    TR_fn_write_file(TR_fn_path(k, "t.csv"), "ad,yaş\nAli,30")
    TR_fn_assert_equal([["ad", "yaş"], ["Ali", 30]], TR_fn_read_csv(TR_fn_path(k, "t.csv")))
    TR_fn_assert_equal([["ad", "yaş"], ["Ali", 30]], TR_fn_parse_csv("ad,yaş\nAli,30"))
    TR_fn_assert_equal([["007", 7]], TR_fn_parse_csv("007,7"))
    TR_kw_var m = ""
    TR_kw_try { TR_fn_read_csv("ad,yaş\nAli,30") } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_contains("csv_çöz()"), m)
    m = ""
    TR_kw_try { TR_fn_parse_csv(5) } TR_kw_catch h { m = h }
    TR_fn_assert(m.TR_mem_contains("csv_çöz() 1. argüman olarak Metin bekler"), m)
}
