# TR 4
# docs/spec/03_tipler.md §3 — Tipler ve değerler

TR_test "3.1 Tam: 64 bit, taşma hata verir" {
    TR_assert_equal(9223372036854775807, 9223372036854775806 + 1)
    TR_assert_equal("H2473", TR_error_code(() => { TR_var z = 9223372036854775807 + 1 }))
}

TR_test "3.1 yerleşikler de taşmada sarmak yerine hata verir" {
    TR_var büyük = 9223372036854775807
    TR_assert_equal("H2485", TR_error_code(() => { TR_sum([büyük, 1]) }))
    TR_assert_equal("H2485", TR_error_code(() => { TR_sum([büyük, 1]) }))
    TR_assert_equal("H2431", TR_error_code(() => { TR_abs(-büyük - 1) }))
    TR_assert_equal("H2484", TR_error_code(() => { TR_int(1e30) }))
    TR_assert_equal("H2484", TR_error_code(() => { TR_int(-1e30) }))
    TR_assert_equal("H2484", TR_error_code(() => { TR_round(1e30) }))
    TR_assert_equal(büyük, TR_sum([büyük - 1, 1]))
    TR_assert_equal(-büyük - 1, TR_int(TR_float(-büyük - 1)))
}

TR_test "3.2 Ondalık: 64 bit kayan noktalı" {
    TR_assert_equal(0.75, 3 / 4)
    TR_assert_equal("1.0", TR_String(1.0))
    TR_assert_equal("123456.0", TR_String(123456.0))
    TR_assert_equal("-0.0", TR_String(-0.0))
    # Bilimsel gösterim yalnız üs -4'ten küçük ya da 16 ve üstüyken; üs işaretli, en az iki rakam
    TR_assert_equal("1000000.0", TR_String(1e6))
    TR_assert_equal("1234567.0", TR_String(1234567.0))
    TR_assert_equal("16777216.0", TR_String(16777216.0))
    TR_assert_equal("1000000000000000.0", TR_String(1e15))
    TR_assert_equal("1e+16", TR_String(1e16))
    TR_assert_equal("1.2345678901234568e+17", TR_String(123456789012345678.0))
    TR_assert_equal("0.0001", TR_String(0.0001))
    TR_assert_equal("1e-05", TR_String(0.00001))
    TR_assert_equal("0.1", TR_String(0.1))
}

TR_test "3.2 sonsuz ve tanımsız TR_inf ve TR_nan yazılır" {
    TR_assert_equal(TR_Float("inf"), TR_inf)
    TR_assert_equal(TR_Float("-inf"), -TR_inf)
    TR_assert(TR_nan != TR_nan)
    TR_assert_equal(["inf", "-inf", "nan"], [TR_String(TR_inf), TR_String(-TR_inf), TR_String(TR_nan)])
    TR_assert_equal("[inf, nan]", "\([TR_inf, TR_nan])")
}

TR_test "3.3 Metin: karakter (rune) bazında uzunluk ve indeks" {
    TR_assert_equal(5, "şeker".TR_length)
    TR_assert_equal("ş", "şeker"[0])
    TR_assert_equal("r", "şeker"[-1])
    TR_assert_equal("ek", "şeker"[1..3])
    # Sınır dışı okuma hatadır; öğenin olmayabileceği bilinçli durum varsa_al ile yazılır
    TR_assert_equal("H2515", TR_error_code(() => { "abc"[10] }))
    TR_assert_equal(TR_none, "abc".TR_get(10))
    TR_assert_equal("c", "abc".TR_get(-1))
}

TR_test "3.3 dilimde negatif uç indeksteki gibi sondan sayar" {
    TR_assert_equal("ker", "şeker"[-3..5])
    TR_assert_equal("eke", "şeker"[1..-1])
    TR_assert_equal("eker", "şeker"[1..=-1])
    TR_assert_equal("şeker", "şeker"[-10..10])
    TR_assert_equal("", "şeker"[3..1])
}

TR_test "3.4 Mantık: doğru ve yanlış" {
    TR_assert_equal(TR_Bool, TR_type(TR_true))
    TR_assert(TR_true != TR_false)
}

TR_test "3.5 yok: boş değer" {
    TR_assert_equal(TR_None, TR_type(TR_none))
    TR_func hicbir_sey() {}
    TR_assert_equal(TR_none, hicbir_sey())
}

TR_test "3.6 Liste: sıralı, karışık tipli; sınır dışı okuma hatadır, varsa_al yok verir" {
    TR_var l = [1, "iki", 3.0]
    TR_assert_equal(3, l.TR_length)
    TR_assert_equal(1, l[0])
    TR_assert_equal(3.0, l[-1])
    TR_assert_equal("H2515", TR_error_code(() => { l[5] }))
    TR_assert_equal("H2515", TR_error_code(() => { l[-4] }))
    TR_assert_equal(TR_none, l.TR_get(5))
    TR_assert_equal(0, l.TR_get(5) ?? 0)
    TR_assert_equal(3.0, l.TR_get(-1))
    TR_assert_equal([1, "iki"], l[0..2])
    # Dilimde negatif uç sondan sayar; uçlar listenin sınırına kırpılır
    TR_assert_equal([3, 4], [1, 2, 3, 4][-2..4])
    TR_assert_equal([2, 3], [1, 2, 3, 4][1..=-2])
    TR_assert_equal([1, 2, 3], [1, 2, 3][0..=9223372036854775807])
}

TR_test "3.6 Liste: değerler başvuruyla paylaşılır" {
    TR_var a = [1]
    TR_var b = a
    b.TR_append(2)
    TR_assert_equal([1, 2], a)
}

TR_test "3.7 Sözlük: eklenme sırasını korur; anahtar bir ifadedir" {
    TR_var k = "ad"
    TR_var d = {k: "Ali", "yaş": 30, 1: "bir", TR_true: "doğru"}
    TR_assert_equal(["ad", "yaş", 1, TR_true], d.TR_keys())
    TR_assert_equal("Ali", d["ad"])
    TR_assert_equal("bir", d[1])
    TR_assert_equal("doğru", d[TR_true])
    d["yeni"] = TR_true
    TR_assert_equal(5, d.TR_length)
    TR_assert_equal("{\"ad\": \"Ali\", \"yaş\": 30, 1: \"bir\", true: \"doğru\", \"yeni\": true}", TR_String(d))
}

TR_test "3.7 anahtar yalnız köşeli parantezle okunur ve yazılır; olmayan anahtar hatadır, .get yok verir" {
    TR_var d = {"a": 1}
    TR_assert_equal("H2648", TR_error_code(() => { d.a }))
    TR_assert_equal("H2648", TR_error_code(() => { d.TR_step }))
    TR_assert_equal("H2648", TR_error_code(() => { d.a = 2 }))
    TR_assert_equal("H2647", TR_error_code(() => { d["yok"] }))
    TR_assert_equal("H2647", TR_error_code(() => { d["yok"] += 1 }))
    TR_assert_equal(TR_none, d.TR_get("yok"))
    TR_assert_equal(1, d.TR_get("a"))
    TR_assert_equal(0, d.TR_get("yok") ?? 0)
    TR_assert_equal("H2647", TR_error_code(() => { {1: "bir"}["1"] }))
}

TR_test "3.7 anahtar tipi Int, String ya da Bool'dur; ondalık ve öbür değerler anahtar olamaz" {
    TR_var d = {}
    TR_assert_equal("H2646", TR_error_code(() => { d[1.0] = "bir" }))
    TR_assert_equal("H2646", TR_error_code(() => { TR_var e = {0.5: "yarım"} }))
    TR_assert_equal("H2646", TR_error_code(() => { d[TR_none] = 1 }))
    TR_assert_equal("H2646", TR_error_code(() => { d[x => x] = 1 }))
    TR_assert_equal("H2646", TR_error_code(() => { d.TR_contains(1.5) }))
    # NUL ile başlayan bir metin anahtar (JSON'dan gelebilir) 1 sayısının anahtarıyla çakışmaz
    TR_var j = TR_json_parse(`{"\u0000Tam:1": "metin"}`)
    j[1] = "sayı"
    TR_assert_equal(2, j.TR_length)
    TR_assert_equal("sayı", j[1])
    TR_assert_equal("metin", j[j.TR_keys()[0]])
}

TR_test "3.7 içeriği değişebilen değerler (liste, sözlük, yapı nesnesi) anahtar olamaz" {
    TR_assert_equal("H2495", TR_error_code(() => { TR_var a = {[1]: 1} }))
    TR_var d = {}
    TR_assert_equal("H2495", TR_error_code(() => { d[[1]] = 1 }))
    TR_assert_equal("H2495", TR_error_code(() => { TR_var b = d[{}] }))
    TR_assert_equal("H2495", TR_error_code(() => { TR_var c = d.TR_contains([1]) }))
}

TR_test "3.7 sözlük üyeleri noktayla, anahtarlar köşeli parantezle: üye adı da anahtar olabilir" {
    TR_var d = {"anahtarlar": 5, "a": 1}
    TR_assert_equal(5, d["anahtarlar"])
    TR_assert_equal(["anahtarlar", "a"], d.TR_keys())
    TR_assert_equal(2, d.TR_length)
    TR_assert_equal(2, {"x": 1, "y": 2}.TR_length)
    TR_assert_equal(1, d["a"])
    d["b"] = 3
    TR_assert_equal(3, d["b"])
    TR_assert_equal("H2406", TR_error_code(() => { d.TR_keys = 7 }))
}

TR_test "3.8 Aralık: a..b (b hariç), a..=b (b dahil)" {
    TR_assert_equal(TR_Range, TR_type(1..3))
    TR_var t = 0
    TR_for i TR_in 1..4 { t += i }
    TR_assert_equal(6, t)
    t = 0
    TR_for i TR_in 1..=4 { t += i }
    TR_assert_equal(10, t)
}

TR_test "3.8 Aralık: Tam sınırındaki uçlar taşmadan gezilir" {
    TR_var üst = 9223372036854775807
    TR_var sayaç = 0
    TR_for i TR_in (üst - 1)..=üst { sayaç += 1 }
    TR_assert_equal(2, sayaç)
    TR_assert_equal([üst - 1, üst], [x TR_for x TR_in (üst - 1)..=üst])
    TR_var alt = -üst - 1
    TR_assert_equal([alt + 1, alt], [x TR_for x TR_in (alt..= (alt + 1)).TR_reverse()])
    TR_assert_equal([], [x TR_for x TR_in 2..2])
    TR_assert_equal([2], [x TR_for x TR_in 2..=2])
}

TR_test "3.8 başı sonundan büyük aralık boştur; geriye .reverse() sayar" {
    TR_assert_equal([], [x TR_for x TR_in 3..0])
    TR_assert_equal([], [x TR_for x TR_in 3..=2])
    TR_var n = 0
    TR_for i TR_in 0..-5 { n += 1 }
    TR_assert_equal(0, n)
    TR_assert_equal([2, 1, 0], (0..3).TR_reverse())
    TR_assert_equal([3, 2, 1, 0], (0..=3).TR_reverse())
    TR_assert_equal([], (3..0).TR_reverse())
    TR_assert(3..0 != 5..1)
    TR_assert_equal("3..0", TR_String(3..0))
}

TR_test "3.9 fonksiyonlar birinci sınıf değerlerdir" {
    TR_var f = TR_func(x) { TR_return x + 1 }
    TR_var l = [f]
    TR_assert_equal(2, l[0](1))
    TR_assert_equal(TR_Function, TR_type(f))
}

TR_test "3.10 koşul yalnız TR_Bool olur; başka tip çalışma hatasıdır" {
    TR_for d TR_in [TR_none, 0, 0.0, "", "a", [], [0], {}, 1..2] {
        TR_assert_equal("H2600", TR_error_code(() => { TR_if d { TR_print("girmemeli") } }))
        TR_assert_equal("H2600", TR_error_code(() => { TR_if TR_false {} TR_else TR_if d {} }))
        TR_assert_equal("H2600", TR_error_code(() => { TR_for d { TR_break } }))
        TR_assert_equal("H2600", TR_error_code(() => { TR_var l = [x TR_for x TR_in [1] TR_if d] }))
    }
}

TR_test "3.10 boşluk ve yokluk açık sınamayla sorulur" {
    TR_var l = []
    TR_var y = TR_none
    TR_var n = 0
    TR_assert(l.TR_length == 0 TR_and y == TR_none TR_and n == 0)
    TR_var sayaç = 0
    TR_for sayaç < 3 { sayaç += 1 }
    TR_assert_equal(3, sayaç)
    TR_assert_equal([2], [x TR_for x TR_in [1, 2] TR_if x % 2 == 0])
}

TR_test "3.11 tip(x) değerin tipini bir tip değeri olarak verir; tip adlarıyla karşılaştırılır" {
    TR_assert_equal([TR_Int, TR_Float, TR_String, TR_Bool, TR_None, TR_List, TR_Dict],
        [TR_type(1), TR_type(1.5), TR_type("a"), TR_type(TR_true), TR_type(TR_none), TR_type([]), TR_type({})])
    # Ayrı bir matris tipi yoktur: matris 2 boyutlu tensördür.
    TR_assert_equal([TR_Tensor, TR_Tensor], [TR_type(TR_tensor([1])), TR_type(TR_tensor([[1, 2]]))])
    TR_assert(TR_type(42) == TR_Int)
    TR_assert(TR_type(42) != TR_Float)
    # Tip değerinin kendisinin tipi Tip'tir; yazdırılınca ve metne çevrilince adı görünür.
    TR_assert_equal(TR_Type, TR_type(TR_Int))
    TR_assert_equal(TR_str(TR_Int), TR_str(TR_type(42)))
    TR_assert(TR_str(TR_type(42)) != TR_str(TR_type(1.5)))
    TR_assert_equal("tip: " + TR_str(TR_List), "tip: \(TR_type([1]))")
    TR_var t: TR_Type = TR_type(1.5)
    TR_assert_equal(TR_Float, t)
    # Tip değeri eşle desenlerinde de kullanılır.
    TR_assert_equal("sayı", TR_match TR_type(3) { TR_Int, TR_Float => "sayı"; _ => "başka" })
}

TR_test "3.11 tip değeri metinle karşılaştırılamaz: tip(x) == Tam yazılır" {
    TR_var ad = "Tam"
    TR_assert_equal("H1105", TR_error_code(() => { TR_print(TR_type(5) == ad) }))
    TR_assert_equal("H1105", TR_error_code(() => { TR_assert_equal(ad, TR_type(5)) }))
    # Denetleyici tip(...) ile bir metin sabitinin karşılaştırılmasını çalıştırmadan önce bulur.
    # Olumsuz fikstür: tests/negative/tip_metin.tr
}

TR_test "3.12 tip çağrılınca kurar ve çevirir" {
    TR_assert_equal(43, TR_Int("42") + 1)
    TR_assert_equal([3, -3], [TR_Int(3.9), TR_Int(-3.9)])
    TR_assert_equal("12a", TR_String(12) + "a")
    TR_assert_equal(2.0, TR_Float(2))
    TR_assert_equal([0, 1, 2], TR_List(0..3))
    TR_assert_equal([1, 2, 3], TR_List(1..=3))
    TR_var l = [1, 2]
    TR_var kopya = TR_List(l)
    kopya.TR_append(3)
    TR_assert_equal([1, 2], l)
    TR_assert_equal(TR_Float, TR_Type(1.5))
    TR_assert_equal(TR_Type, TR_Type(TR_Int))
    TR_assert_equal(TR_Tensor, TR_Type(TR_Tensor([1, 2])))
    TR_assert_equal("H2645", TR_error_code(() => { TR_Dict() }))
}

TR_test "3.12 metin 2.4 ve 2.5'in yazımıyla, işaretle ve yerel ayarsız okunur" {
    TR_assert_equal([-1000, 7, 0], [TR_Int("-1_000"), TR_Int("+7"), TR_Int("0")])
    TR_assert_equal([3.0, -1.5, 0.002, 1000.5], [TR_Float("3"), TR_Float("-1.5"), TR_Float("2e-3"), TR_Float("1_000.5")])
    TR_assert(TR_Float("inf") > 1e308)
    TR_assert(TR_Float("-inf") < -1e308)
    TR_var n = TR_Float("nan")
    TR_assert(n != n)
    TR_for m TR_in [" 42", "3.5", "0x1F", "1__0", "1_", "", "+"] {
        TR_assert_equal("H2640", TR_error_code(() => { TR_Int(m) }), m)
    }
    TR_assert_equal("H2641", TR_error_code(() => { TR_Int("9223372036854775808") }))
    TR_for m TR_in ["1,5", ".5", "1.", "1e999", "Inf", "infinity", "sonsuz", " 1.0"] {
        TR_assert_equal("H2642", TR_error_code(() => { TR_Float(m) }), m)
    }
    TR_assert_equal("H2484", TR_error_code(() => { TR_Int(TR_Float("nan")) }))
    TR_assert_equal("H2484", TR_error_code(() => { TR_Int(1e30) }))
}

TR_test "3.12 mantık değeri yalnız \"true\" ve \"false\" metninden kurulur" {
    TR_assert_equal([TR_true, TR_false], [TR_Bool("true"), TR_Bool("false")])
    TR_assert_equal("H2643", TR_error_code(() => { TR_Bool("True") }))
    TR_assert_equal("H2643", TR_error_code(() => { TR_Bool("1") }))
    TR_assert_equal("H2643", TR_error_code(() => { TR_Bool("") }))
    TR_for x TR_in [1, 0.0, []] {
        TR_assert_equal("H2644", TR_error_code(() => { TR_Bool(x) }), "\(x)")
    }
    TR_assert_equal("H2423", TR_error_code(() => { TR_Int(TR_true) }))
}

TR_test "3.13 tip açıklamaları tip denetleyicisince denetlenir" {
    TR_var yaş: TR_Int = 25
    TR_func iki_kat(x: TR_Int): TR_Int { TR_return x * 2 }
    TR_assert_equal(50, iki_kat(yaş))
    TR_var r: TR_Range = 0..3
    TR_assert_equal(TR_Range, TR_type(r))
    TR_var f: TR_Function = x => x
    TR_assert_equal(2, f(2))
    # Uyuşmazlık programı çalıştırmadan reddeder (modül de aynı denetimden geçer)
    # Olumsuz fikstür: tests/negative/tip_aciklamasi.tr
}

TR_test "3.13 açıklamasız değişkenin tipi kalıcı değildir" {
    TR_var kayıp = 0
    TR_for i TR_in 1..=4 { kayıp += 0.5 }
    TR_assert_equal(2.0, kayıp)
    TR_var x = 5
    x = "beş"
    TR_assert_equal(TR_String, TR_type(x))
    # '/' Tam / Tam'da tam bölünmezse Ondalık verir; denetleyici de böyle bilir
    TR_var oran: TR_Float = 7 / 2
    TR_assert_equal(3.5, oran)
}

TR_test "3.14 tip adının tek yazımı vardır" {
    TR_var adet: TR_Int = 3
    TR_func kare(x: TR_Float): TR_Float { TR_return x * x }
    TR_assert_equal(2.25, kare(1.5))
    # Büyük/küçük harfi farklı yazım tip adı değildir; program çalıştırılmadan reddedilir
    # Olumsuz fikstür: tests/negative/tip_adi_yazimi.tr
    # Değer olarak okunan küçük harfli ad dönüşüm fonksiyonudur (3.12)
    TR_assert_equal(adet, TR_int("3"))
}

TR_test "8.5 İleti: kodu ve değerleriyle kurulur, metni gösterilirken katalogdan yazılır" {
    TR_var i = TR_message("H6903", -1)
    TR_assert_equal(TR_Message, TR_type(i))
    TR_assert("\(i)".TR_contains("-1"))
}
