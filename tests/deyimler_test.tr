# TR 4
# docs/spec/05_deyimler.md §5 — Deyimler ve kontrol yapıları

TR_test "5.1 değişken ilk değeriyle tanımlanır" {
    TR_var a = 1
    TR_var b = 2
    TR_assert_equal(3, a + b)
    # Kısa tanım (x := 1) ve ilk değersiz tanım sözdizimi hatasıdır
    # Olumsuz fikstür: tests/negative/ilk_deger.tr
}

TR_test "5.2 sabit: tanımlandıktan sonra değiştirilemez" {
    TR_const PI = 3.14
    TR_assert_equal(3.14, PI)
    # Yeniden atama denetleyicide yakalanır: dosyanın hiçbir satırı çalışmaz
    # Olumsuz fikstür: tests/negative/sabit_yeniden.tr
}

TR_test "5.3 çoklu tanım, takas ve listeden açma" {
    TR_var a, b = 1, 2
    a, b = b, a
    TR_assert_equal([2, 1], [a, b])
    TR_var ad, soyad = ["Mustafa", "Kemal"]
    TR_assert_equal("Kemal", soyad)
    TR_var ilk, _ = [1, 2]
    TR_assert_equal(1, ilk)
    # _'ye atama değeri atar
    TR_var çağrı = 0
    TR_func say() -> TR_Int {
        çağrı += 1
        TR_return çağrı
    }
    _ = say()
    _ = 5
    ilk, _ = [7, 8]
    TR_assert_equal([1, 7], [çağrı, ilk])
    # _ okunamaz
    # Olumsuz fikstür: tests/negative/alt_cizgi_okuma.tr
}

TR_test "5.3 öğe sayısı ad sayısını tutmazsa çalışma hatasıdır" {
    TR_assert_equal("H2700", TR_error_code { TR_var p, q = [1, 2, 3] })
    TR_assert_equal("H2700", TR_error_code { TR_var p, q = [1] })
    TR_assert_equal("H2701", TR_error_code { TR_var p, q = 1 })
    TR_var a = 0
    TR_var b = 0
    TR_assert_equal("H2701", TR_error_code { a, b = 1, 2, 3 })
    # İletinin önerisi: baştaki öğeler indeksle alınır
    TR_var l = [1, 2, 3]
    a, b = l[0], l[1]
    TR_assert_equal([1, 2], [a, b])
}

TR_test "5.4 atama ve bileşik atama" {
    TR_var x = 5
    x += 3
    x -= 1
    x *= 2
    x //= 7
    TR_assert_equal(2, x)
    TR_var l = [1, 2]
    l[0] = 9
    TR_assert_equal([9, 2], l)
}

TR_test "5.4 on iki bileşik atama x op= y, x = x op y demektir" {
    TR_var x = 17
    x //= 2
    TR_assert_equal(8, x)
    x %= 5
    TR_assert_equal(3, x)
    x **= 3
    TR_assert_equal(27, x)
    x &= 6
    TR_assert_equal(2, x)
    x |= 1
    TR_assert_equal(3, x)
    x ^= 5
    TR_assert_equal(6, x)
    x <<= 2
    TR_assert_equal(24, x)
    x >>= 1
    TR_assert_equal(12, x)
    TR_var o = 7.0
    o /= 2
    TR_assert_equal(3.5, o)
    TR_var d = {"a": 7}
    d["a"] //= 2
    TR_assert_equal(3, d["a"])
}

TR_test "5.4 listede += ve *= yerindedir, listeyi paylaşan ad da görür" {
    TR_var l = [1]
    TR_var m = l
    l += [2]
    TR_assert_equal([1, 2], m)
    l *= 2
    TR_assert_equal([1, 2, 1, 2], m)
    # sabit olan bağdır: sabit listede de geçerli (5.2)
    TR_const s = [0]
    s += [1]
    TR_assert_equal([0, 1], s)
    # eski anlam (yeni liste) isteniyorsa açıkça yazılır
    TR_var n = l
    l = l + [3]
    TR_assert_equal([1, 2, 1, 2], n)
    # *= 4.10'un yineleme kuralına uyar: boy sınırını aşan liste çalışma hatasıdır, liste değişmez
    TR_var büyük = [0]
    TR_var kod = TR_error_code { [0] * 200000000 }
    TR_assert(kod != TR_none)
    TR_assert_equal(kod, TR_error_code { büyük *= 200000000 })
    TR_assert_equal([0], büyük)
}

TR_test "5.4 bileşik atamanın hedefi bir kez hesaplanır" {
    TR_var çağrı = 0
    TR_func sıra() -> TR_Int {
        çağrı += 1
        TR_return 0
    }
    TR_var l = [5]
    l[sıra()] += 1
    TR_assert_equal(1, çağrı)
    TR_assert_equal([6], l)
}

TR_test "5.4 bileşik atamada önce hedefin yeri, sonra sağ yan hesaplanır" {
    TR_var k = 0
    TR_func sağ(n: TR_Int) -> TR_Int {
        k = 1
        TR_return n
    }
    # sağ yan indeksi değiştirse de ilk hesaplanan öğe yazılır; on iki işlecin hepsi
    TR_var l = [8, 8]
    l[k] += sağ(2)
    TR_assert_equal([10, 8], l)
    TR_var sonuçlar = []
    TR_for i TR_in 0..11 {
        l = [8, 8]
        k = 0
        TR_match i {
            0 => { l[k] -= sağ(2) }
            1 => { l[k] *= sağ(2) }
            2 => { l[k] //= sağ(3) }
            3 => { l[k] %= sağ(3) }
            4 => { l[k] **= sağ(2) }
            5 => { l[k] &= sağ(12) }
            6 => { l[k] |= sağ(1) }
            7 => { l[k] ^= sağ(12) }
            8 => { l[k] <<= sağ(1) }
            9 => { l[k] >>= sağ(2) }
            _ => { l[k] += sağ(1) }
        }
        sonuçlar += [l]
    }
    TR_assert_equal([[6, 8], [16, 8], [2, 8], [2, 8], [64, 8], [8, 8], [9, 8], [4, 8], [16, 8], [2, 8], [9, 8]], sonuçlar)
    TR_var o = [9.0, 9.0]
    k = 0
    TR_func sağ_ondalık(x: TR_Float) -> TR_Float {
        k = 1
        TR_return x
    }
    o[k] /= sağ_ondalık(2.0)
    TR_assert_equal([4.5, 9.0], o)
    # sözlük: anahtar sağ yandan önce
    TR_var d = {"a": 1, "b": 2}
    TR_var ad = "a"
    TR_func sağ_ad() -> TR_Int {
        ad = "b"
        TR_return 10
    }
    d[ad] += sağ_ad()
    TR_assert_equal({"a": 11, "b": 2}, d)
    # alan: alanın sahibi sağ yandan önce
    TR_struct Kutu { x: TR_Int }
    TR_var p = Kutu(x: 1)
    TR_var eski = p
    TR_func sağ_sahip() -> TR_Int {
        p = Kutu(x: 100)
        TR_return 5
    }
    p.x += sağ_sahip()
    TR_assert_equal([6, 100], [eski.x, p.x])
    # birinci istisna: listede += yerindedir, yer yine önce hesaplanır
    TR_var iç = [[1], [2]]
    TR_var ilk = iç[0]
    k = 0
    TR_func sağ_liste() -> TR_List[TR_Int] {
        k = 1
        TR_return [9]
    }
    iç[k] += sağ_liste()
    TR_assert_equal([[1, 9], [2]], [ilk, iç[1]])
    # ikinci istisna: tensörde indeksle += yinelenen indeksin her geçişini biriktirir (15.6d)
    TR_var t = TR_Tensor([0.0, 0.0])
    k = 0
    t[k] += sağ_ondalık(1.0)
    TR_for i TR_in [1, 1, 1] { t[i] += 2.0 }
    TR_assert_equal([1.0, 6.0], t.TR_tolist)
}

TR_test "5.4 düz ='de de önce hedefin yeri, sonra sağ yan: l[f()] = g()'de önce f" {
    TR_var iz: TR_List[TR_String] = []
    TR_func f(ad: TR_String, n: TR_Int) -> TR_Int {
        iz.TR_append(ad)
        TR_return n
    }
    TR_var l = [0, 0, 0]
    l[f("hedef", 0)] = f("sağ", 7)
    TR_assert_equal(["hedef", "sağ"], iz)
    TR_assert_equal([7, 0, 0], l)
    # sağ yan indeksi değiştirse de yazma ilk hesaplanan yere gider (Python sağ yanı önce hesaplar)
    TR_var k = 0
    TR_func sağ(n: TR_Int) -> TR_Int {
        k = 2
        TR_return n
    }
    l[k] = sağ(5)
    TR_assert_equal([5, 0, 0], l)
    # sözlük anahtarı ve alanın sahibi de sağ yandan önce
    TR_var d: TR_Dict[TR_String, TR_Int] = {}
    iz = []
    d[TR_String(f("hedef", 3))] = f("sağ", 4)
    TR_assert_equal(["hedef", "sağ"], iz)
    TR_assert_equal({"3": 4}, d)
    TR_struct Kutu { x: TR_Int }
    TR_var p = Kutu(x: 1)
    TR_var eski = p
    TR_func yeni_kutu() -> TR_Int {
        p = Kutu(x: 100)
        TR_return 5
    }
    p.x = yeni_kutu()
    TR_assert_equal([5, 100], [eski.x, p.x])
}

TR_test "5.3 çoklu atamada önce bütün yerler, sonra bütün sağ yanlar, sonra yazmalar soldan sağa" {
    TR_var iz: TR_List[TR_String] = []
    TR_func f(ad: TR_String, n: TR_Int) -> TR_Int {
        iz.TR_append(ad)
        TR_return n
    }
    TR_var l = [0, 0, 0]
    l[f("h1", 0)], l[f("h2", 2)] = f("s1", 8), f("s2", 9)
    TR_assert_equal(["h1", "h2", "s1", "s2"], iz)
    TR_assert_equal([8, 0, 9], l)
    # takas
    l[0], l[2] = l[2], l[0]
    TR_assert_equal([9, 0, 8], l)
    # sağında atanan adı okumak serbesttir: iki sıra aynı sonucu verir
    TR_var i = 0
    l[i], i = 7, 2
    TR_assert_equal([[7, 0, 8], 2], [l, i])
    # sağ yanın açtığı demet ve liste de yerlerden sonra hesaplanır
    iz = []
    l[f("h", 1)], i = [f("s", 4), 1]
    TR_assert_equal(["h", "s"], iz)
    TR_assert_equal([[7, 4, 8], 1], [l, i])
    # solunda atanan adı ya da yolu okuyan yer: tests/negative/coklu_atama_sirasi.tr
    # İletinin önerisi (H1160) iki atamaya ayırır; Python'un sonucunu verir
    TR_var j = 0
    TR_var m = [0, 0]
    j = 1; m[j] = 5
    TR_assert_equal([0, 5], m)
}

TR_test "5.5 eğer / değilse eğer / değilse bir ifadedir" {
    TR_func sınıflandır(n: TR_Int) -> TR_String {
        TR_return TR_if n < 0 { "negatif" } TR_else TR_if n == 0 { "sıfır" } TR_else { "pozitif" }
    }
    TR_assert_equal("negatif", sınıflandır(-5))
    TR_assert_equal("sıfır", sınıflandır(0))
    TR_assert_equal("pozitif", sınıflandır(7))
    # Değer yerindeki TR_if'in TR_else'i zorunludur; Python'un koşullu ifadesi yoktur
    # Olumsuz fikstür: tests/negative/degersiz_if.tr
}

TR_func yok_ya_da(n: TR_Int?) -> TR_Int {
    TR_return n ?? -1
}

TR_test "5.5 T ile T? dalı T?; hepsi TR_none dallarda tip beklenen tipten gelir" {
    TR_var c = TR_true
    TR_var z = TR_if c { 1 } TR_else { TR_none }
    TR_var z2: TR_Int? = z
    TR_assert_equal(1, z2)
    TR_var y: TR_Int? = TR_if c { TR_none } TR_else { TR_none }
    TR_assert_equal(TR_none, y)
    TR_assert_equal(-1, yok_ya_da(TR_if c { TR_none } TR_else { TR_none }))
    TR_var m: TR_String? = TR_match 1 {
        1 => TR_none
        _ => TR_none
    }
    TR_assert_equal(TR_none, m)
    TR_var f: (TR_Bool) -> TR_Int? = (b) => TR_if b { TR_none } TR_else { TR_none }
    TR_assert_equal(TR_none, f(c))
    # Beklenen tip yoksa ya da her tipi alıyorsa (TR_print'in argümanı): tests/negative/hepsi_yok_dallar.tr
}

TR_test "5.6 eşle: değer, çoklu desen, aralık ve varsayılan" {
    TR_func not_adı(n: TR_Int) -> TR_String {
        TR_return TR_match n {
            100 => "tam puan"
            90..100 => "pekiyi"
            50, 60, 70 => "yuvarlak"
            _ => "diğer"
        }
    }
    TR_assert_equal("tam puan", not_adı(100))
    TR_assert_equal("pekiyi", not_adı(95))
    TR_assert_equal("yuvarlak", not_adı(60))
    TR_assert_equal("diğer", not_adı(3))
    TR_assert_equal("x", TR_match 1 { _ => "x" })
}

TR_test "5.6 hiçbir kolla eşleşmeyen eşleme çalışma hatasıdır" {
    TR_assert_equal("H2702", TR_error_code { TR_var s = TR_match 9 { 1 => "bir" } })
    TR_assert_equal("H2702", TR_error_code {
        TR_match "b" {
            "a" => { TR_print("a") }
        }
    })
    # İletinin önerisi: son kol _ ile her şeyle eşleşir
    TR_assert_equal("diğer", TR_match 9 { 1 => "bir"
        _ => "diğer" })
}

TR_test "5.6 eşle: parantezli desen değeriyle karşılaştırılır (ok fonksiyonu değildir)" {
    TR_var sınır = 10
    TR_var kırmızı = "#f00"
    TR_func tür(x: TR_Int) -> TR_String {
        TR_return TR_match x {
            (sınır) => "sınırda"
            (sınır * 2) => "iki katı"
            _ => "başka"
        }
    }
    TR_func renk(x: TR_String) -> TR_String {
        TR_return TR_match x {
            (kırmızı), "#ff0000" => "kırmızı"
            _ => "başka"
        }
    }
    TR_assert_equal("sınırda", tür(10))
    TR_assert_equal("iki katı", tür(20))
    TR_assert_equal("kırmızı", renk("#f00"))
    TR_assert_equal("kırmızı", renk("#ff0000"))
    TR_assert_equal("başka", tür(3))
    TR_assert_equal("başka", renk("#0f0"))
    # Kolun sonucu bir ok fonksiyonu olabilir
    TR_var f = TR_match 1 { 1 => (y) => y + 1 }
    TR_assert_equal(5, f(4))
}

TR_test "5.7 döngü ... içinde: liste, aralık, sözlük, metin" {
    TR_var birikim = 0
    TR_for x TR_in [1, 2, 3] { birikim += x }
    TR_assert_equal(6, birikim)
    TR_var çiftler = []
    TR_for i, x TR_in ["a", "b"] { çiftler.TR_append("\(i)\(x)") }
    TR_assert_equal(["0a", "1b"], çiftler)
    TR_var anahtarlar = []
    TR_for k, v TR_in {"a": 1, "b": 2} { anahtarlar.TR_append(k + TR_String(v)) }
    TR_assert_equal(["a1", "b2"], anahtarlar)
    TR_var harfler = []
    TR_for h TR_in "çay" { harfler.TR_append(h) }
    TR_assert_equal(["ç", "a", "y"], harfler)
    TR_var geri = []
    TR_for i TR_in (1..=3).TR_reverse() { geri.TR_append(i) }
    TR_assert_equal([3, 2, 1], geri)
}

TR_test "5.7 üretecin yanlış çıkan koşulu dolaşılanı değiştirirse de çalışma hatasıdır" {
    TR_var l = [1, 2, 3, 4]
    TR_func çıkaran(x: TR_Int) -> TR_Bool {
        l.TR_remove_at(0)
        TR_return TR_false
    }
    TR_assert_equal("H2703", TR_error_code { TR_var y = [x TR_for x TR_in l TR_if çıkaran(x)] })
    TR_var e = [1, 2]
    TR_func ekleyen(x: TR_Int) -> TR_Bool {
        e.TR_append(9)
        TR_return TR_false
    }
    TR_assert_equal("H2703", TR_error_code { TR_var y = [x TR_for x TR_in e TR_if ekleyen(x)] })
    TR_var d = {"a": 1, "b": 2, "c": 3}
    TR_func silen(k: TR_String) -> TR_Bool {
        d.TR_remove("b")
        TR_return TR_false
    }
    TR_assert_equal("H2704", TR_error_code { TR_var y = [k TR_for k TR_in d TR_if silen(k)] })
}

TR_test "5.7 dolaşılan liste ya da sözlüğe ekleme ve çıkarma çalışma hatasıdır" {
    TR_var l = [1, 2]
    TR_assert_equal("H2703", TR_error_code {
        TR_for x TR_in l { l.TR_append(x) }
    })
    TR_var k = [1, 2, 3]
    TR_assert_equal("H2703", TR_error_code {
        TR_for x TR_in k { k += [x] }
    })
    TR_var d = {"a": 1}
    TR_assert_equal("H2704", TR_error_code {
        TR_for a TR_in d { d["b"] = 2 }
    })
    TR_var m = [1, 2]
    TR_func ekle(x: TR_Int) -> TR_Int {
        m.TR_append(x)
        TR_return x
    }
    TR_assert_equal("H2703", TR_error_code { TR_var y = [ekle(x) TR_for x TR_in m] })
    TR_var c = [1, 2, 3]
    TR_assert_equal("H2703", TR_error_code {
        TR_for x TR_in c { c.TR_pop() }
    })
    TR_var r = [1, 2, 3]
    TR_assert_equal("H2703", TR_error_code {
        TR_for x TR_in r { r.TR_remove_at(0) }
    })
    TR_var e = {"a": 1, "b": 2}
    TR_assert_equal("H2704", TR_error_code {
        TR_for a TR_in e { e.TR_remove(a) }
    })
    # Son turdaki çıkarma da hatadır: dolaşma biterken görülmeseydi kural yarım kalırdı
    TR_var z = [1, 2]
    TR_assert_equal("H2703", TR_error_code {
        TR_for i, x TR_in z {
            TR_if i == 1 { z.TR_pop() }
        }
    })
    # Aynı turda çıkarıp eklemek boyu değiştirmez, kural yine işler
    TR_var b = [1, 2, 3]
    TR_assert_equal("H2703", TR_error_code {
        TR_for x TR_in b {
            b.TR_pop()
            b.TR_append(9)
        }
    })
    TR_var g = {"a": 1, "b": 2}
    TR_assert_equal("H2704", TR_error_code {
        TR_for a, v TR_in g {
            g.TR_remove("b")
            g["c"] = 3
        }
    })
    TR_var u = [1, 2, 3]
    TR_assert_equal("H2703", TR_error_code { TR_var y = [u.TR_pop() TR_for x TR_in u] })
    # Anahtarların kopyası dolaşılırken sözlükten silmek serbesttir
    TR_var o = {"a": 1, "b": 2}
    TR_for a TR_in o.TR_keys() { o.TR_remove(a) }
    TR_assert_equal(0, o.TR_length)
    # Var olan öğeye ve anahtara atama serbesttir; dolaşma o anki değeri görür
    TR_var s = [1, 2, 3]
    TR_for i, x TR_in s { s[i] = x * 10 }
    TR_assert_equal([10, 20, 30], s)
    TR_var e = {"a": 1, "b": 2}
    TR_for a TR_in e { e[a] = 0 }
    TR_assert_equal({"a": 0, "b": 0}, e)
    # İletinin önerisi: yenileri ayrı toplayıp dolaşmadan sonra eklemek
    TR_var t = [1, 2]
    TR_var yeniler = []
    TR_for x TR_in t { yeniler.TR_append(x * 2) }
    t += yeniler
    TR_assert_equal([1, 2, 2, 4], t)
}

TR_test "5.8 koşullu döngü ve iken" {
    TR_var i = 0
    TR_for i < 3 { i += 1 }
    TR_assert_equal(3, i)
    TR_for i < 5 { i += 1 }
    TR_assert_equal(5, i)
}

TR_test "5.9 sonsuz döngü ve çık" {
    TR_var i = 0
    TR_for {
        i += 1
        TR_if i == 4 { TR_break }
    }
    TR_assert_equal(4, i)
    TR_for x TR_in 1..100 { TR_if x == 2 { TR_break } }
}

TR_test "5.10 devam sonraki turdan sürdürür" {
    TR_var tekler = []
    TR_for i TR_in 1..6 {
        TR_if i % 2 == 0 { TR_continue }
        tekler.TR_append(i)
    }
    TR_assert_equal([1, 3, 5], tekler)
}

TR_test "5.11 liste üreteci" {
    TR_assert_equal([1, 9, 25], [x * x TR_for x TR_in 1..=5 TR_if x % 2 == 1])
    TR_assert_equal([2, 4], [x * 2 TR_for x TR_in [1, 2]])
}

TR_test "5.11 liste üreteci aralıkta da eleman sınırına uyar (bellek tükenmez)" {
    TR_assert_equal("H2462", TR_error_code { TR_var l = [x TR_for x TR_in 0..9000000000000000000] })
}

TR_test "5.12 bloklar kapsam açar; dış değişkenler atanabilir" {
    TR_var dış = 0
    TR_if TR_true {
        TR_var iç = 1
        dış = 5
    }
    TR_assert_equal(5, dış)
    # Blokta tanımlanan ad dışarıda tanımsızdır; denetim bunu çalışmadan önce bulur (5.14).
    # Olumsuz fikstür: tests/negative/tanimsiz_adlar.tr
}

TR_test "5.12 eşle kolu ve eğer dalı kendi kapsamını açar" {
    TR_func f() -> TR_Int { TR_return 1 }
    TR_var s = TR_match 1 {
        1 => {
            TR_func g() -> TR_Int { TR_return 8 }
            g()
        }
        _ => 0
    }
    TR_var t = TR_if TR_true {
        TR_func g() -> TR_Int { TR_return 9 }
        g()
    } TR_else { 0 }
    TR_assert_equal([8, 9, 1], [s, t, f()])
}

TR_test "5.13 çık ve devam yalnızca döngü içinde geçerlidir" {
    TR_var l = []
    TR_for i TR_in 0..5 {
        TR_match i {
            1 => { TR_continue }
            3 => { TR_break }
            _ => {}
        }
        l.TR_append(i)
    }
    TR_assert_equal([0, 2], l)
    # Döngü dışındaki çık/devam (fonksiyon, sondaki blok içinde de) derleme hatasıdır
    # Olumsuz fikstür: tests/negative/dongu_disi_cik.tr
    # Olumsuz fikstür: tests/negative/dongu_disi_devam.tr
}

TR_test "5.14 tanımsız ad çalışmadan önce bulunur; dinamik adlar yanlış alarm vermez" {
    # Olumsuz fikstür: tests/negative/tanimsiz_adlar.tr
    # Bunlar tanımlıdır; denetim yanlış alarm vermez.
    TR_func önce() -> TR_Int { TR_return sonra() + 1 }
    TR_func sonra() -> TR_Int { TR_return 1 }
    TR_assert_equal(2, önce())
    TR_assert_equal([2, 3], [1, 2].TR_map((x) => x + 1))
    TR_var yakalanan = ""
    TR_try { TR_throw "x" } TR_catch h { yakalanan = TR_String(h) }
    TR_assert_equal("x", yakalanan)
    TR_assert_equal([0, 2], [k * 2 TR_for k TR_in 0..2])
    TR_struct Sayaç { n: TR_Int = 0; TR_func artır() { TR_self.n += 1 } }
    TR_var s = Sayaç()
    s.artır()
    TR_assert_equal(1, s.n)
}
