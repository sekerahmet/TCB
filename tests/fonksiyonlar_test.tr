// docs/spec/06_fonksiyonlar.md §6 — Fonksiyonlar

fonksiyon topla(a, b) {
    sonuç a + b
}

test "6.1 isimli fonksiyon tanımı" {
    eşit_mi(4, topla(2, 2))
    fonksiyon çarp(a, b) { sonuç a * b }
    eşit_mi(6, çarp(2, 3))
}

test "6.1 fonksiyonlar tanımlandıkları noktadan sonra kullanılabilir" {
    değişken bulundu = doğru
    dene { sonra_tanımlı() } yakala { bulundu = yanlış }
    doğrula(değil bulundu)
    fonksiyon sonra_tanımlı() { sonuç 1 }
    eşit_mi(1, sonra_tanımlı())
}

test "6.2 sonuç değer döndürür; yoksa son deyimin değeri döner" {
    fonksiyon erken(x) {
        eğer x > 0 { sonuç "pozitif" }
        sonuç "değil"
    }
    eşit_mi("pozitif", erken(1))
    eşit_mi("değil", erken(-1))
    fonksiyon örtük() { 5 }
    eşit_mi(5, örtük())
    fonksiyon boş_dönüş() { sonuç }
    eşit_mi(yok, boş_dönüş())
}

test "6.3 varsayılan parametreler; eksik ya da fazla argüman hata verir" {
    fonksiyon selam(ad, ek = "!") { sonuç "Selam " + ad + ek }
    eşit_mi("Selam Ali!", selam("Ali"))
    eşit_mi("Selam Ali?", selam("Ali", "?"))
    fonksiyon ikinci(a, b) { sonuç b }
    değişken eksik = ""
    dene { ikinci(1) } yakala hata { eksik = hata }
    doğrula(eksik.içerir("2 argüman bekler, 1 verildi (eksik: 'b')"), eksik)
    değişken fazla = ""
    dene { ikinci(1, 2, 3) } yakala hata { fazla = hata }
    doğrula(fazla.içerir("en fazla 2 argüman alır, 3 verildi"), fazla)
}

test "6.3 varsayılan değer önceki parametreleri görür" {
    değişken a = 100
    fonksiyon f(a, b = a * 2) { sonuç b }
    eşit_mi(2, f(1))
    fonksiyon g(x, y = x + 1, z = x + y) { sonuç [x, y, z] }
    eşit_mi([1, 2, 3], g(1))
    eşit_mi([1, 5, 6], g(1, 5))
    eşit_mi([1, 2, 9], g(1, z: 9))
    // Sonraki parametre (ve parametrenin kendisi) henüz tanımlı değildir; dıştaki aynı adlı değişken kullanılmaz
    değişken b = 7
    fonksiyon h(a = b, b = 1) { sonuç a }
    değişken mesaj = ""
    dene { h() } yakala hata { mesaj = hata }
    doğrula(mesaj.içerir("'b' parametresi henüz tanımlanmadı"), mesaj)
    // Varsayılan her çağrıda yeniden hesaplanır
    fonksiyon liste_al(l = []) { l.ekle(1); sonuç l }
    eşit_mi([1], liste_al())
    eşit_mi([1], liste_al())
}

test "6.3a özyineleme derinliği sınırı yakalanabilir hata verir" {
    fonksiyon sonsuz(n) { sonuç sonsuz(n + 1) }
    değişken mesaj = ""
    dene { sonsuz(0) } yakala hata { mesaj = hata }
    doğrula(mesaj.içerir("Özyineleme derinliği sınırı aşıldı"), mesaj)
}

test "6.4 adlı argümanlar" {
    fonksiyon böl(bölünen, bölen = 1) { sonuç bölünen / bölen }
    eşit_mi(5, böl(bölen: 2, bölünen: 10))
    eşit_mi(10, böl(10))
}

test "6.4 aynı parametre hem sırayla hem adıyla verilemez" {
    fonksiyon f(a, b = 10) { sonuç [a, b] }
    eşit_mi([1, 20], f(1, b: 20))
    değişken iki_kez = ""
    dene { f(1, a: 2) } yakala hata { iki_kez = hata }
    doğrula(iki_kez.içerir("'f' fonksiyonu 'a' parametresi hem sırayla (1. argüman) hem adıyla verildi"), iki_kez)
    // adlı argümanlar varken eksik zorunlu parametre adıyla söylenir (6.3)
    değişken eksik = ""
    dene { f(b: 20) } yakala hata { eksik = hata }
    doğrula(eksik.içerir("'f' fonksiyonu için zorunlu 'a' argümanı verilmedi"), eksik)
}

test "6.5 kapanışlar tanımlandıkları ortamı yakalar" {
    fonksiyon sayaç_yap() {
        değişken n = 0
        sonuç fonksiyon() {
            n += 1
            sonuç n
        }
    }
    değişken s = sayaç_yap()
    s()
    eşit_mi(2, s())
    eşit_mi(1, sayaç_yap()())
}

test "6.5 özyineleme" {
    fonksiyon fakt(n) {
        eğer n <= 1 { sonuç 1 }
        sonuç n * fakt(n - 1)
    }
    eşit_mi(3628800, fakt(10))
}

test "6.6 ok fonksiyonları (lambda)" {
    değişken iki_kat = x => x * 2
    değişken topla2 = (a, b) => a + b
    değişken blok = (x) => {
        değişken y = x + 1
        sonuç y * 2
    }
    eşit_mi(6, iki_kat(3))
    eşit_mi(5, topla2(2, 3))
    eşit_mi(8, blok(3))
}

test "6.7 sondaki blok: tek parametresi o olan fonksiyon" {
    değişken sayılar = [1, 2, 3, 4]
    eşit_mi([3, 4], sayılar.filtrele { o > 2 })
    eşit_mi([9, 16], sayılar.filtrele { o > 2 }.haritala { o * o })
    eşit_mi([[10, 20]], [[1, 2]].haritala { o.haritala { o * 10 } })
    fonksiyon uygula(x, f) { sonuç f(x) }
    eşit_mi(10, uygula(5) { o * 2 })
}

test "6.7 indirge'nin sondaki bloğunda birikim önceki sonuç, o elemandır" {
    eşit_mi(10, [1, 2, 3, 4].indirge(0) { birikim + o })
    eşit_mi(24, [1, 2, 3, 4].indirge { birikim * o })
    eşit_mi([3, 2, 1], [1, 2, 3].indirge([]) { [o] + birikim })
    // Elemanlar liste olsa da o elemandır
    eşit_mi(10, [[1, 2], [3, 4]].indirge(0) { birikim + o[0] + o[1] })
    // birikim başka her yerde sıradan bir addır
    değişken birikim = 5
    eşit_mi(5, birikim)
    eşit_mi(2, [1, 2].indirge(birikim) { birikim - o })
    değişken mesaj = ""
    dene { [1, 2].indirge(0, (x) => x) } yakala h { mesaj = h }
    doğrula(mesaj.içerir("liste.indirge(): fonksiyon iki parametre almalı (birikim, eleman), 1 parametreli verildi"), mesaj)
    dene { aktar "negative/eski_indirge" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("liste.indirge metodunun sondaki bloğunda birikim önceki sonuç, o sıradaki elemandır; o[0] ve o[1] yerine birikim ve o yazın"), mesaj)
}

test "6.7 kontrol yapısı başlığında \{ gövdeyi başlatır" {
    değişken l = [1, 5]
    değişken sonuç_ = ""
    eğer (l.filtrele { o > 2 }).uzunluk > 0 { sonuç_ = "var" }
    eşit_mi("var", sonuç_)
}

test "6.8 dönüş tipi : Tip ya da -> Tip ile bildirilir" {
    fonksiyon a(x: Tam): Tam { sonuç x }
    fonksiyon b(x: Tam) -> Metin { sonuç metin(x) }
    eşit_mi("3", b(a(3)))
    // Bildirilen tiple uyuşmayan sonuç değeri programı çalıştırmadan reddeder
    değişken mesaj = ""
    dene { aktar "negative/donus_tipi" } yakala h { mesaj = h }
    doğrula(mesaj.içerir("donus_tipi.tr, Satır 2: Dönüş tipi uyuşmazlığı — fonksiyon \"Tam\" döndürmeli ancak \"Metin\""), mesaj)
    doğrula(mesaj.içerir("donus_tipi.tr, Satır 4: Dönüş tipi uyuşmazlığı — fonksiyon \"Tam\" döndürmeli ancak \"Tam ya da Ondalık\""), mesaj)
}
