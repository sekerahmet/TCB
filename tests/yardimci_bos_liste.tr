# TR 4
# tensor_test.tr'nin 15.18 testinin modülü (kendisi test dosyası değildir): boş listenin toplamı modülün içinde de öğe tipini bilir; modül denetlenmiş ağacıyla çalışır.

TR_func boş_kayıpların_hatası() -> TR_String? {
    TR_var kayıplar = [TR_ones([2]) TR_for x TR_in [1, 2, 3] TR_if x > 5]
    TR_return TR_error_code { TR_sum(kayıplar) }
}
