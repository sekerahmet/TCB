# TR 4
# Sentetik sesin log-Mel'i özgün Whisper'ın değerleriyle aynıdır (23.6). Dosyaların kaynağı ve lisansı:
# testdata/whisper/KAYNAK.md.

TR_import "tr/audio"

TR_const _KESİT = 56

# başvuru özgün uygulamanın ilk çerçeveleri ve son çerçevesidir.
TR_func başvuru(m: TR_Int) -> TR_Tensor {
    TR_var baytlar = TR_read_bytes("testdata/whisper/whisper_log_mel_\(m).bin")
    TR_var düz = TR_from_bytes[TR_Float](baytlar, TR_dtype: "float32", TR_byte_order: "little")
    TR_return düz.TR_reshape([m, _KESİT + 1])
}

# kesit TR'nin sonucundan aynı çerçeveleri alır.
TR_func kesit(mel: TR_Tensor) -> TR_Tensor {
    TR_var son = mel.TR_shape[1]
    TR_return TR_concat([mel.TR_slice(1, 0, _KESİT), mel.TR_slice(1, son - 1, son)], TR_dim: 1)
}

TR_test "23.6 sentetik seste özgün uygulamayla aynı, 80 ve 128 Mel" {
    TR_var ses = TR_read_wav("testdata/whisper/sentetik.wav")
    TR_for m TR_in [80, 128] {
        TR_var mel = TR_whisper_log_mel(ses, TR_n_mels: m)
        TR_assert_equal([m, 3050], mel.TR_shape)
        TR_assert(TR_all_close(kesit(mel), başvuru(m), TR_rtol: 1e-4, TR_atol: 1e-4))
    }
}

# dolgulu kaydın sonuna 480 000 sıfır ekleyip STFT'yi bütün dolguda koşar (kısa STFT'den önceki biçim).
TR_func dolgulu(örnekler: TR_Tensor[TR_Float], m: TR_Int) -> TR_Tensor[TR_Float] {
    TR_var x = TR_concat([örnekler, TR_zeros([480000])])
    TR_var gerçek, sanal = TR_stft(x, 400, TR_hop_length: 160, TR_window: TR_hann_window(400, TR_periodic: TR_true), TR_center: TR_true, TR_pad_mode: "reflect")
    TR_var çerçeve = gerçek.TR_shape[1] - 1
    TR_var güç = gerçek.TR_slice(1, 0, çerçeve) ** 2 + sanal.TR_slice(1, 0, çerçeve) ** 2
    TR_var süzgeç = TR_mel_filterbank(TR_sample_rate: 16000, TR_n_fft: 400, TR_n_mels: m, TR_norm: "slaney", TR_mel_scale: "slaney")
    TR_var log = TR_log10(TR_clamp(süzgeç @ güç, TR_min: 1e-10))
    TR_return (TR_maximum(log, TR_max(log) - 8.0) + 4.0) / 4.0
}

# 120'de (n + 200) 160'a tam bölünür; 479 680, 480 000 ve 480 320 30 saniyenin çevresidir.
TR_test "23.6 log-Mel kısa STFT'yle tam dolgunun bitlerini verir: örnek 1, 120, 159, 160, 161, 16 000, 479 680, 480 000, 480 320" {
    TR_for n TR_in [1, 120, 159, 160, 161, 16000, 479680, 480000, 480320] {
        TR_var örnekler = TR_Tensor([((i * i + 7 * i) % 7919 / 7919.0 - 0.5) * 0.25 TR_for i TR_in 0..n])
        TR_var ses = TR_Sound(TR_samples: örnekler.TR_reshape([1, n]), TR_sample_rate: 16000)
        TR_for m TR_in [80, 128] {
            TR_var kısa = TR_whisper_log_mel(ses, TR_n_mels: m)
            TR_assert_equal(dolgulu(örnekler, m).TR_to_bytes(TR_byte_order: "little"), kısa.TR_to_bytes(TR_byte_order: "little"))
        }
    }
}

TR_test "23.6 başvuruyla kıyas farkı görür" {
    TR_var ses = TR_read_wav("testdata/whisper/sentetik.wav")
    TR_var kaymış = kesit(TR_whisper_log_mel(ses, TR_n_mels: 80)) + 1e-3
    TR_assert(TR_not TR_all_close(kaymış, başvuru(80), TR_rtol: 1e-4, TR_atol: 1e-4))
}
