# TR 4
# Sentetik sesin log-Mel'i özgün Whisper'ın değerleriyle aynıdır (23.6). Dosyaların kaynağı ve lisansı:
# testdata/whisper/KAYNAK.md.

TR_import "tr/audio"

TR_const _KESİT = 56

# başvuru özgün uygulamanın ilk çerçeveleri ve son çerçevesidir.
TR_func başvuru(m: TR_Int) -> TR_Tensor {
    TR_var baytlar = TR_read_bytes("testdata/whisper/whisper_log_mel_\(m).bin")
    TR_var düz = TR_from_bytes[TR_Float](baytlar, TR_dtype: "float32", TR_byte_order: "little")
    TR_return düz.TR_reshape([m, _KESİT + 1])
}

# kesit TR'nin sonucundan aynı çerçeveleri alır.
TR_func kesit(mel: TR_Tensor) -> TR_Tensor {
    TR_var son = mel.TR_shape[1]
    TR_return TR_concat([mel.TR_slice(1, 0, _KESİT), mel.TR_slice(1, son - 1, son)], TR_dim: 1)
}

TR_test "sinyal 23.6: sentetik seste özgün uygulamayla aynı, 80 ve 128 Mel" {
    TR_var ses = TR_read_wav("testdata/whisper/sentetik.wav")
    TR_for m TR_in [80, 128] {
        TR_var mel = TR_whisper_log_mel(ses, TR_n_mels: m)
        TR_assert_equal([m, 3050], mel.TR_shape)
        TR_assert(TR_all_close(kesit(mel), başvuru(m), TR_rtol: 1e-4, TR_atol: 1e-4))
    }
}

TR_test "sinyal 23.6: başvuruyla kıyas farkı görür" {
    TR_var ses = TR_read_wav("testdata/whisper/sentetik.wav")
    TR_var kaymış = kesit(TR_whisper_log_mel(ses, TR_n_mels: 80)) + 1e-3
    TR_assert(TR_not TR_all_close(kaymış, başvuru(80), TR_rtol: 1e-4, TR_atol: 1e-4))
}
