# TR 4

TR_test "15.34 SGD momentum adımları elle hesaplanan değerle uyuşur" {
    TR_var w = TR_Tensor([2.0], TR_requires_grad: TR_true)
    TR_var op = TR_SGD([w], TR_lr: 0.1, TR_momentum: 0.5)
    op.TR_zero_grad()
    TR_backward(TR_sum(w))
    op.TR_step()
    TR_assert_equal([1.9], w.TR_tolist)
    op.TR_zero_grad()
    TR_backward(TR_sum(w))
    op.TR_step()
    TR_assert_equal([1.75], w.TR_tolist)
}

TR_test "15.19 cinsli argmax: tam sayı ve float64 eksenli, eşitlerde ilk ve NaN" {
    TR_var ti = TR_Tensor([[1, 9, 3], [7, 2, 7]])
    TR_assert_equal("int64", ti.TR_dtype)
    TR_assert_equal([1, 0], TR_argmax(ti, TR_dim: -1).TR_tolist)
    TR_assert_equal([1, 0, 1], TR_argmax(ti, TR_dim: 0).TR_tolist)

    TR_var tf = TR_Tensor([[1.5, 9.5, 3.5], [7.5, 2.5, 7.5]], TR_dtype: "float64")
    TR_assert_equal("float64", tf.TR_dtype)
    TR_assert_equal([1, 0], TR_argmax(tf, TR_dim: 1).TR_tolist)
    TR_assert_equal([1, 0, 1], TR_argmax(tf, TR_dim: 0).TR_tolist)

    TR_var tnan = TR_Tensor([[1.0, TR_nan, 9.0, TR_nan], [TR_nan, 5.0, 8.0, 2.0]], TR_dtype: "float64")
    TR_assert_equal([1, 0], TR_argmax(tnan, TR_dim: 1).TR_tolist)
}

TR_test "15.18 ve 15.19 float64'te ±0 sırası: −0.0 0.0'dan küçük, eksensiz ve eksenli" {
    TR_var a = TR_Tensor([-0.0, 0.0], TR_dtype: "float64")
    TR_var b = TR_Tensor([0.0, -0.0], TR_dtype: "float64")
    TR_assert_equal(1, TR_argmax(a).TR_item())
    TR_assert_equal(0, TR_argmax(b).TR_item())
    TR_assert_equal(TR_inf, (1.0 / TR_max(a)).TR_item())
    TR_assert_equal(TR_inf, (1.0 / TR_max(b)).TR_item())
    TR_assert_equal(-TR_inf, (1.0 / TR_min(a)).TR_item())
    TR_assert_equal(-TR_inf, (1.0 / TR_min(b)).TR_item())

    TR_var c = TR_Tensor([[-0.0, 0.0], [0.0, -0.0]], TR_dtype: "float64")
    TR_assert_equal([1, 0], TR_argmax(c, TR_dim: 1).TR_tolist)
    TR_assert_equal([1, 0], TR_argmax(c, TR_dim: 0).TR_tolist)
    TR_assert_equal([TR_inf, TR_inf], (1.0 / TR_max(c, TR_dim: 1)).TR_tolist)
    TR_assert_equal([TR_inf, TR_inf], (1.0 / TR_max(c, TR_dim: 0)).TR_tolist)
    TR_assert_equal([-TR_inf, -TR_inf], (1.0 / TR_min(c, TR_dim: 1)).TR_tolist)
    TR_assert_equal([-TR_inf, -TR_inf], (1.0 / TR_min(c, TR_dim: 0)).TR_tolist)
}
