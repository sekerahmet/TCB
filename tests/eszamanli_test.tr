# TR 4
# docs/spec/10_eszamanlilik.md §10 — Eşzamanlılık ve yorumlayıcı kilidi

TR_test "10.1 eşzamanlı blok ve çağrı biçimi; bekle_hepsi hepsini bekler" {
    TR_var sonuçlar = []
    TR_async { sonuçlar.TR_append("blok") }
    TR_func iş(x) { sonuçlar.TR_append(x) }
    TR_async iş("çağrı")
    TR_wait_all()
    TR_assert_equal(2, sonuçlar.TR_length)
    TR_assert(sonuçlar.TR_contains("blok") TR_and sonuçlar.TR_contains("çağrı"))
}

TR_test "10.2 yorumlayıcı kilidi: paylaşılan sayaç bozulmaz" {
    TR_var birikim = 0
    TR_for i TR_in 1..=200 {
        TR_async { birikim += i }
    }
    TR_wait_all()
    TR_assert_equal(20100, birikim)
}

TR_test "10.3 bekle(sn) kilidi bırakır; görevler iç içe ilerler" {
    # Duvar saatine bakılmaz: ana görev bekle() ile kilidi bırakmazsa görev hiç çalışamaz.
    # Tur sayısı 256'dan azdır, döngünün kilit devrine (10.2) güvenilmez; görevin bayrağı
    # yalnızca bekle() kilidi bıraktığı için görülebilir.
    TR_var görev_çalıştı = TR_false
    TR_async { görev_çalıştı = TR_true }
    TR_var tur = 0
    TR_for TR_not görev_çalıştı TR_and tur < 200 {
        TR_sleep(0.001)
        tur += 1
    }
    TR_assert(görev_çalıştı, "ana görev bekle() ile kilidi bıraktığı hâlde görev çalışamadı")
    # Bekleyen görevler iç içe ilerler: her görev, öbürleri beklerken sırasını alır.
    TR_var iz = []
    TR_for i TR_in 1..=3 {
        TR_async {
            iz.TR_append("başla \(i)")
            TR_sleep(0.01)
            iz.TR_append("bitir \(i)")
        }
    }
    TR_wait_all()
    TR_assert_equal(6, iz.TR_length)
    # Hiçbir görev, bütün görevler başlamadan bitmez
    TR_var ilk_bitiş = 0
    TR_for j, olay TR_in iz { TR_if olay.TR_starts_with("bitir") TR_and ilk_bitiş == 0 { ilk_bitiş = j } }
    TR_assert_equal(3, ilk_bitiş, TR_str(iz))
}

TR_test "10.3 bekle() negatif, sayı olmayan ya da aşırı uzun süreyi reddeder" {
    TR_assert_equal("H2433", TR_error_code(() => { TR_sleep(-5) }))
    TR_assert_equal("H2433", TR_error_code(() => { TR_sleep(TR_float("nan")) }))
    TR_assert_equal("H2434", TR_error_code(() => { TR_sleep(1e300) }))
    TR_assert_equal("H2434", TR_error_code(() => { TR_sleep(9.3e9) }))
    TR_sleep(0)
}

TR_test "10.4 görev değişkenleri döngü turuna aittir" {
    TR_var görülen = []
    TR_for i TR_in 1..=3 {
        TR_async { görülen.TR_append(i) }
    }
    TR_wait_all()
    TR_assert_equal([1, 2, 3], görülen.TR_sort())
}
