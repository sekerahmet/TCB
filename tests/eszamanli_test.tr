# TR 4
# docs/spec/10_eszamanlilik.md §10 — Eşzamanlılık ve yorumlayıcı kilidi

TR_test "10.1 eşzamanlı blok ve çağrı biçimi görev başlatır" {
    TR_var sonuçlar = []
    TR_async { sonuçlar.TR_append("blok") }
    TR_func iş(x: TR_String) { sonuçlar.TR_append(x) }
    TR_async iş("çağrı")
    TR_wait_all()
    TR_assert_equal(2, sonuçlar.TR_length)
    TR_assert(sonuçlar.TR_contains("blok") TR_and sonuçlar.TR_contains("çağrı"))
}

TR_test "10.1 eşzamanlı bir ifadedir ve görev değeri verir; bekle sonucu verir ya da hatayı fırlatır" {
    TR_func kare(x: TR_Int) -> TR_Int {
        TR_sleep(0.01)
        TR_return x * x
    }
    TR_var g: TR_Task[TR_Int] = TR_async kare(3)
    TR_assert_equal(9, g.TR_wait())
    TR_assert(g.TR_done())
    TR_var b = TR_async { kare(2) }
    TR_assert_equal(TR_none, b.TR_wait())
    TR_assert_equal("Task", TR_String(g))
    TR_func böl(x: TR_Int) -> TR_Int { TR_return 10 // x }
    TR_var h = TR_async böl(5)
    TR_assert_equal(2, h.TR_wait())
    # Hatayla biten görevin hatası bekleyende fırlar; yakalanınca testi düşürmez (ertelenen iş de bekleyebilir)
    TR_var s = TR_async böl(0)
    TR_sleep(0.01)
    TR_assert_equal("H2470", TR_error_code { s.TR_wait() })
    TR_var e = TR_async böl(0)
    TR_defer { TR_assert_equal("H2470", TR_error_code { e.TR_wait() }) }
}

TR_test "10.5 bekle_hepsi() başlatılmış bütün görevleri bekler" {
    TR_var bitenler = []
    TR_func iş(x: TR_Int) {
        TR_sleep(0.01)
        bitenler.TR_append(x)
    }
    TR_for i TR_in 0..3 { TR_async iş(i) }
    TR_wait_all()
    TR_assert_equal(3, bitenler.TR_length)
}

TR_test "10.5 bekle_hepsi(görevler) sonuçları verilen sırayla verir; bitme sırası değiştirmez" {
    TR_func iş(x: TR_Int, süre: TR_Float) -> TR_Int {
        TR_sleep(süre)
        TR_return x * 10
    }
    TR_var görevler = [TR_async iş(1, 0.03), TR_async iş(2, 0.0), TR_async iş(3, 0.01)]
    TR_assert_equal([10, 20, 30], TR_wait_all(görevler))
    TR_assert_equal([], TR_wait_all([]))
    TR_assert_equal("H2919", TR_error_code { TR_wait_all([1, 2]) })
}

TR_test "10.5 bekle_hepsi(görevler) verilen sıradaki ilk hatayı fırlatır, öbürleri bastırılanlarına eklenir" {
    TR_func hata(m: TR_String, süre: TR_Float) -> TR_Int {
        TR_sleep(süre)
        TR_throw m
    }
    TR_var görevler = [TR_async hata("ikinci", 0.03), TR_async hata("üçüncü", 0.0)]
    TR_try {
        TR_wait_all(görevler)
        TR_assert(TR_false)
    } TR_catch e {
        TR_assert_equal("ikinci", TR_String(e))
        TR_assert_equal(["üçüncü"], e.TR_suppressed.TR_map((s) => TR_String(s)))
    }
}

TR_test "10.2 yorumlayıcı kilidi: paylaşılan sayaç bozulmaz" {
    TR_var birikim = 0
    TR_for i TR_in 1..=200 {
        TR_async { birikim += i }
    }
    TR_wait_all()
    TR_assert_equal(20100, birikim)
}

TR_test "10.3 uyu(sn) kilidi bırakır; görevler iç içe ilerler" {
    # Duvar saatine bakılmaz: ana görev uyu() ile kilidi bırakmazsa görev hiç çalışamaz.
    # Tur sayısı 256'dan azdır, döngünün kilit devrine (10.2) güvenilmez; görevin bayrağı
    # yalnızca uyu() kilidi bıraktığı için görülebilir.
    TR_var görev_çalıştı = TR_false
    TR_async { görev_çalıştı = TR_true }
    TR_var tur = 0
    TR_for TR_not görev_çalıştı TR_and tur < 200 {
        TR_sleep(0.001)
        tur += 1
    }
    TR_assert(görev_çalıştı, "ana görev uyu() ile kilidi bıraktığı hâlde görev çalışamadı")
    # Bekleyen görevler iç içe ilerler: her görev, öbürleri beklerken sırasını alır.
    TR_var iz = []
    TR_for i TR_in 1..=3 {
        TR_async {
            iz.TR_append("başla \(i)")
            TR_sleep(0.01)
            iz.TR_append("bitir \(i)")
        }
    }
    TR_wait_all()
    TR_assert_equal(6, iz.TR_length)
    # Hiçbir görev, bütün görevler başlamadan bitmez
    TR_var ilk_bitiş = 0
    TR_for j, olay TR_in iz { TR_if olay.TR_starts_with("bitir") TR_and ilk_bitiş == 0 { ilk_bitiş = j } }
    TR_assert_equal(3, ilk_bitiş, TR_String(iz))
}

TR_test "10.3 uyu() negatif, sayı olmayan ya da aşırı uzun süreyi reddeder" {
    TR_assert_equal("H2433", TR_error_code { TR_sleep(-5) })
    TR_assert_equal("H2433", TR_error_code { TR_sleep(TR_Float("nan")) })
    TR_assert_equal("H2434", TR_error_code { TR_sleep(1e300) })
    TR_assert_equal("H2434", TR_error_code { TR_sleep(9.3e9) })
    TR_sleep(0)
}

TR_test "10.4 görev değişkenleri döngü turuna aittir" {
    TR_var görülen = []
    TR_for i TR_in 1..=3 {
        TR_async { görülen.TR_append(i) }
    }
    TR_wait_all()
    TR_assert_equal([1, 2, 3], görülen.TR_sort())
}
