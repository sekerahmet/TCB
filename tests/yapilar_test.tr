# TR 4
# docs/spec/07_yapilar.md §7 — Yapılar

TR_struct Nokta {
    x: TR_Int = 0
    y = 0
    TR_func uzaklık_kare() {
        TR_return TR_self.x ** 2 + TR_self.y ** 2
    }
    TR_func taşı(dx, dy) {
        TR_self.x += dx
        TR_self.y += dy
    }
}

TR_test "7.1 yapı alanları ve varsayılan değerleri" {
    TR_var p = Nokta()
    TR_assert_equal(0, p.x)
    TR_assert_equal(0, p.y)
    TR_struct Satır { a, c, b: TR_Int = 2 }
    TR_var s = Satır(1, 3)
    TR_assert_equal([1, 2, 3], [s.a, s.b, s.c])
}

TR_test "7.1 kalıtım yok: ortak parça alanla kurulur (H0275'in önerdiği yazım)" {
    TR_struct Taban { x = 1 }
    TR_struct A { taban: Taban }
    TR_assert_equal(1, A(Taban()).taban.x)
}

TR_test "7.2 oluşturma: konumlu ve adlı argümanlarla" {
    TR_assert_equal(3, Nokta(3, 4).x)
    TR_assert_equal(4, Nokta(y: 4).y)
    TR_assert_equal(0, Nokta(y: 4).x)
}

TR_test "7.2 fazla konumlu ya da bilinmeyen adlı argüman hatadır" {
    TR_assert_equal("H2419", TR_error_code { Nokta(1, 2, 3) })
    TR_assert_equal("H2418", TR_error_code { Nokta(yy: 9) })
    # kurucu varsa argümanlar kurucunun imzasına göre denetlenir
    TR_struct Hesap {
        bakiye
        TR_func TR_init(b, kat = 2) { TR_self.bakiye = b * kat }
    }
    TR_assert_equal(15, Hesap(5, 3).bakiye)
    TR_assert_equal("H2412", TR_error_code { Hesap(1, 2, 3) })
}

TR_test "7.2 bir alan hem sırayla hem adıyla verilemez" {
    TR_assert_equal("H2420", TR_error_code { Nokta(1, x: 2) })
    TR_assert_equal(2, Nokta(1, y: 2).y)
    TR_struct Hesap {
        bakiye
        TR_func TR_init(b, kat = 2) { TR_self.bakiye = b * kat }
    }
    TR_assert_equal("H2413", TR_error_code { Hesap(1, b: 2) })
}

TR_test "7.3 metotlar kendi ile nesneye erişir" {
    TR_var p = Nokta(3, 4)
    TR_assert_equal(25, p.uzaklık_kare())
    p.taşı(1, 1)
    TR_assert_equal(41, p.uzaklık_kare())
}

TR_test "7.2 varsayılanı olmayan alan verilmezse çalışma hatasıdır" {
    TR_struct N { x, y = 2 }
    TR_assert_equal("H2750", TR_error_code { N() })
    TR_assert_equal("H2750", TR_error_code { N(y: 3) })
    TR_assert_equal([1, 2], [N(1).x, N(1).y])
    TR_assert_equal(1, N(x: 1).x)
}

TR_test "7.4 kurucu varsa nesne yalnız onun imzasıyla kurulur; argüman alana gitmez" {
    TR_struct D {
        n
        k = 10
        TR_func TR_init(a) { TR_self.k = TR_self.k + a }
    }
    TR_var d = D(3)
    TR_assert_equal(TR_none, d.n)
    TR_assert_equal(13, d.k)
    TR_assert_equal("H2410", TR_error_code { D(n: 3) })
}

TR_test "7.4 varsayılanlı alanlar kurucudan önce, tanım sırasıyla değer alır" {
    TR_var sıra = []
    TR_func iz(x) {
        sıra.TR_append(x)
        TR_return x
    }
    TR_struct E {
        a = iz(1)
        b = iz(2)
        TR_func TR_init() { iz(3) }
    }
    E()
    TR_assert_equal([1, 2, 3], sıra)
}

TR_test "7.3 nesnesiz metot ve alan yoktur; ileti nesneyi kurmayı önerir" {
    TR_struct S {
        x = 1
        TR_func m() { TR_return TR_self.x + 1 }
    }
    TR_assert_equal("H2751", TR_error_code { S.m() })
    TR_assert_equal("H2752", TR_error_code { S.x })
    TR_assert_equal("H2468", TR_error_code { S.mm })
    # H2751'in önerdiği yazım: S().m()
    TR_assert_equal(2, S().m())
}

TR_test "7.4 kurucu metodu oluşturmada çağrılır" {
    TR_struct Hesap {
        bakiye
        TR_func TR_init(b) { TR_self.bakiye = b * 2 }
    }
    TR_assert_equal(10, Hesap(5).bakiye)
}

TR_test "7.5 alanlar atanabilir; olmayan alan hata verir" {
    TR_var p = Nokta()
    p.x = 7
    TR_assert_equal(7, p.x)
    TR_assert_equal("H2468", TR_error_code { p.z })
    TR_assert_equal(TR_none, p?.z)
}

TR_test "7.5 tanımda olmayan alana atama hatadır; nesnenin alanları her zaman tanımdakilerdir" {
    TR_var p = Nokta(1, 2)
    TR_assert_equal("H2405", TR_error_code { p.z = 5 })
    TR_assert_equal("H2404", TR_error_code { p.taşı = 5 })
    TR_assert_equal(`Nokta{x: 1, y: 2}`, TR_String(p))
    TR_assert(p == Nokta(1, 2))
}

TR_test "7.6 nesneler içerikle karşılaştırılır; tip() yapının kendisini verir" {
    TR_assert(Nokta(1, 2) == Nokta(1, 2))
    TR_assert_equal(`Nokta{x: 1, y: 2}`, TR_String(Nokta(1, 2)))
    TR_assert_equal(Nokta, TR_Type(Nokta()))
    TR_assert(TR_Type(Nokta()) == Nokta)
    TR_assert_equal("Nokta", TR_String(TR_Type(Nokta())))
    TR_assert_equal(TR_StructType, TR_Type(Nokta))
}
