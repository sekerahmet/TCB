# TR 4
# docs/spec/08_hata_yonetimi.md §8 — Hata yönetimi, §9 — ertele

# 8.2: durumlu tip değeri de fırlatılır.
TR_enum AyarHatası {
    Yok(yol: TR_String)
    Bozuk(satır: TR_Int)
}

TR_test "8.1 dene / yakala; yakalanan hatanın adı yazılır" {
    TR_var yakalanan = ""
    TR_try { TR_throw "a" } TR_catch h { yakalanan = TR_String(h) }
    TR_assert_equal("a", yakalanan)
    TR_try { TR_throw "b" } TR_catch (e) { yakalanan = TR_String(e) }
    TR_assert_equal("b", yakalanan)
}

TR_test "8.1 hata yoksa yakala bloğu çalışmaz" {
    TR_var çalıştı = TR_false
    TR_try { TR_var x = 1 } TR_catch h { çalıştı = TR_true }
    TR_assert(TR_not çalıştı)
}

TR_test "8.2 fırlatılan değer metin, ileti, durumlu tip değeri ya da hatadır; başka tip çalışma hatasıdır" {
    TR_try { TR_throw AyarHatası.Yok("ayar.json") } TR_catch e {
        TR_assert_equal(AyarHatası.Yok("ayar.json"), e.TR_value)
        TR_assert_equal(TR_none, e.TR_code)
    }
    TR_assert_equal("H2911", TR_error_code { TR_throw {"kod": 5} })
    TR_assert_equal("H2911", TR_error_code { TR_throw 5 })
    TR_assert_equal("H2911", TR_error_code { TR_var e = TR_Error([1]) })
}

TR_test "8.2 yakalanan hata TR_throw e ile olduğu gibi yeniden fırlar" {
    TR_try {
        TR_try { TR_throw TR_Message("H6903", -1) } TR_catch e { TR_throw e }
    } TR_catch f {
        TR_assert_equal("H6903", f.TR_code)
        TR_assert_equal(`Message("H6903", -1)`, TR_String(f))
    }
}

TR_test "8.2 yeni hata eskisini neden olarak taşır; kodu, metni ve değeri yeni değerinkidir" {
    TR_try { TR_throw "okunamadı" } TR_catch e {
        TR_try { TR_throw TR_Error(TR_Message("H6903", -1), TR_cause: e) } TR_catch f {
            TR_assert_equal("H6903", f.TR_code)
            TR_assert_equal(`Message("H6903", -1)`, TR_String(f))
            TR_assert_equal("okunamadı", TR_String(f.TR_cause))
            TR_assert_equal(TR_none, f.TR_cause.TR_cause)
        }
    }
    TR_assert_equal("H2912", TR_error_code { TR_var e = TR_Error("x", TR_cause: "y") })
}

TR_test "8.3 çalışma hatası kodu ve iletisiyle yakalanır; hatanın metni iletisidir, okuyana göre değişmez" {
    TR_assert_equal("H2469", TR_error_code { TR_var z = [1] - 1 })
    TR_try { TR_var z = [1] - 1 } TR_catch h {
        TR_assert_equal("H2469", h.TR_code)
        TR_assert_equal(`Message("H2469", "List", "Int", "-")`, TR_String(h))
        TR_assert_equal(TR_Message, TR_Type(h.TR_value))
        TR_assert_equal(TR_Error, TR_Type(h))
        TR_assert_equal(0, h.TR_suppressed.TR_length)
        TR_assert_equal(TR_none, h.TR_cause)
    }
    TR_try { TR_throw "düz" } TR_catch h {
        TR_assert_equal(TR_none, h.TR_code)
        TR_assert_equal("düz", h.TR_value)
    }
    TR_try { TR_assert(TR_false, "olmadı") } TR_catch h { TR_assert_equal("H2456", h.TR_code) }
    # Hata değerinin kendisi karşılaştırılmaz; kodu ya da değeri karşılaştırılır.
    TR_assert_equal("H2913", TR_error_code { TR_try { TR_throw "a" } TR_catch h { TR_var b = h == h } })
    TR_try { TR_throw "a" } TR_catch h {
        TR_try { TR_throw "b" } TR_catch g { TR_assert(h.TR_code == g.TR_code) }
    }
}

TR_test "8.3 hata fonksiyon çağrılarından yukarı yayılır" {
    TR_func iç() { TR_throw "derinde" }
    TR_func dış() { iç() }
    TR_var mesaj = ""
    TR_try { dış() } TR_catch h { mesaj = TR_String(h) }
    TR_assert_equal("derinde", mesaj)
}

TR_test "9.1 ertele fonksiyon bitince ters sırayla çalışır" {
    TR_var iz = []
    TR_func f() {
        TR_defer { iz.TR_append("1. ertele") }
        TR_defer { iz.TR_append("2. ertele") }
        iz.TR_append("gövde")
    }
    f()
    TR_assert_equal(["gövde", "2. ertele", "1. ertele"], iz)
}

TR_test "9.1 ertelenen bloğun kendisi bir kapsamdır: içindeki ertele o bloğun sonunda çalışır" {
    TR_var iz = []
    TR_func f() {
        TR_defer {
            TR_defer { iz.TR_append("iç") }
            iz.TR_append("dış")
        }
        iz.TR_append("gövde")
    }
    f()
    TR_assert_equal(["gövde", "dış", "iç"], iz)
}

TR_test "9.2 ertele erken sonuç ve hata durumunda da çalışır" {
    TR_var iz = []
    TR_func erken() -> TR_Int {
        TR_defer { iz.TR_append("temizlik") }
        TR_return 1
    }
    erken()
    TR_func hatalı() {
        TR_defer { iz.TR_append("hata sonrası temizlik") }
        TR_throw "x"
    }
    TR_try { hatalı() } TR_catch h { iz.TR_append("yakalandı") }
    TR_assert_equal(["temizlik", "hata sonrası temizlik", "yakalandı"], iz)
}

TR_test "9.1 kapsam en yakın bloktur: dal, döngü turu, dene ve yakala bloğu bitince ertele çalışır" {
    TR_var iz = []
    TR_func f() {
        TR_if TR_true {
            TR_defer { iz.TR_append("dal bitti") }
            iz.TR_append("dal")
        }
        TR_for ad TR_in ["a", "b"] {
            TR_defer { iz.TR_append("\(ad) bitti") }
            iz.TR_append("\(ad) başladı")
        }
        TR_try {
            TR_defer { iz.TR_append("dene bitti") }
            TR_throw "x"
        } TR_catch e {
            TR_defer { iz.TR_append("yakala bitti") }
            iz.TR_append("yakalandı")
        }
        iz.TR_append("son")
    }
    f()
    TR_assert_equal(["dal", "dal bitti", "a başladı", "a bitti", "b başladı", "b bitti", "dene bitti", "yakalandı", "yakala bitti", "son"], iz)
}

TR_test "9.4 ertele içindeki hata yutulmaz" {
    TR_var iz = []
    TR_func başarılı() -> TR_Int {
        TR_defer { TR_throw "ertele içinde hata" }
        iz.TR_append("gövde")
        TR_return 1
    }
    TR_var m = ""
    TR_try { başarılı() } TR_catch h { m = TR_String(h) }
    TR_assert_equal("ertele içinde hata", m)
    TR_assert_equal(["gövde"], iz)
    # Fonksiyon zaten hata verdiyse ilk hata korunur, ertelenen işin hatası ona eklenir
    TR_func iki_hata() {
        TR_defer { TR_throw "ilk ertele" }
        TR_defer { TR_print(1 / 0) }
        TR_throw "gövde hatası"
    }
    TR_try { iki_hata() } TR_catch h {
        # İlk hata korunur; ertelenen işlerin hataları çalışma sırasıyla bastırılanlardadır:
        # sıfıra bölme, ilk ertelenen işin hatası.
        TR_assert_equal("gövde hatası", TR_String(h))
        TR_assert_equal(2, h.TR_suppressed.TR_length)
        TR_assert_equal("H2470", h.TR_suppressed[0].TR_code)
        TR_assert_equal("ilk ertele", TR_String(h.TR_suppressed[1]))
    }
    # Ertelenen işler hata verse de hepsi çalışır
    TR_func temizlik() {
        TR_defer { iz.TR_append("ikinci temizlik") }
        TR_defer { TR_throw "bozuk" }
    }
    TR_try { temizlik() } TR_catch h { m = TR_String(h) }
    TR_assert_equal(["gövde", "ikinci temizlik"], iz)
}

TR_test "9.3 ertelenen blok adları kapsam biterkenki değerleriyle okur, kayıt anındakilerle değil" {
    TR_var görülen = []
    TR_func kaydet(x: TR_Int) { görülen.TR_append(x) }
    TR_func f() {
        TR_var x = 1
        TR_defer { kaydet(x) }
        x = 2
    }
    f()
    TR_assert_equal([2], görülen)
}

TR_test "8.4 yakalanan hata metni değişmez; denetim karakterleri yalnızca terminale yazılırken görünür olur" {
    TR_var m = ""
    TR_try { TR_throw "kötü\rveri" } TR_catch h { m = TR_String(h) }
    TR_assert(m.TR_contains("\r"), "yakalanan metin kaçırılmamalı")
    TR_assert_equal("kötü\rveri", m)
}

TR_test "8.5 ileti fırlatılınca hata kendi koduyla çıkar; doğrula iletiyi olduğu gibi fırlatır; hata_kodu kodu verir" {
    TR_assert_equal("H6903", TR_error_code { TR_throw TR_Message("H6903", -1) })
    TR_assert_equal("H6900", TR_error_code { TR_assert(TR_false, TR_Message("H6900", 10, 4)) })
    TR_assert_equal(TR_none, TR_error_code { 1 + 1 })
    # Düz metin hatanın kodu yoktur: hata_kodu koda dönmez, hatayı olduğu gibi yeniden fırlatır.
    TR_var yeniden = ""
    TR_try { TR_error_code { TR_throw "düz metin" } } TR_catch h { yeniden = TR_String(h) }
    TR_assert_equal("düz metin", yeniden)
    TR_try { TR_error_code { TR_throw AyarHatası.Bozuk(3) } } TR_catch h { yeniden = TR_String(h) }
    TR_assert_equal("AyarHatası.Bozuk(satır: 3)", yeniden)
    TR_var yakalanan = ""
    TR_try { TR_throw TR_Message("H6903", -1) } TR_catch h { yakalanan = TR_String(h) }
    TR_assert(yakalanan.TR_contains("-1"), yakalanan)
    TR_try { TR_Message("H6903") } TR_catch h { yakalanan = TR_String(h) }
    TR_assert(yakalanan.TR_contains("H6903"), yakalanan)
}

TR_test "8.5 hata_kodu neden yuvasından iner: sarmalayıcının değil asıl nedenin, modülün denetim hatasında ilk tanının kodu" {
    # İletinin parçaları ("tensörde ve sayıda", "Tam (5)") neden değildir: kod iletinin kendisinindir.
    TR_assert_equal("H2423", TR_error_code { TR_floor("a") })
    TR_assert_equal("H6104", TR_error_code { TR_floor([1.5]) })
    # Nedeni taşıyan yuva ({error}) inilir: dosya hatasının kendi kodu gelir.
    TR_assert_equal("H2132", TR_error_code { TR_load_tensors("bu_dosya_yok_12345.trt") })
    # Tip değeriyle metnin karşılaştırılması (3.11) çalışma anında da kendi koduyla çıkar.
    TR_var ad = "Tam"
    TR_assert_equal("H1105", TR_error_code { TR_print(TR_Type(5) == ad) })
    # Modül yüklenemezse (denetim hatası) hata yeniden fırlatılmaz; ilk tanının kodu gelir.
    # Olumsuz fikstür: tests/negative/test_yerel_adi.tr
}
