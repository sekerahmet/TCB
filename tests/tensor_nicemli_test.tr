# TR 4
# docs/spec/15_tensorler.md 15.51–15.55 — nicemlenmiş tensörler. Dosyadan gelen değerler Go testlerindedir
# (internal/stdlib/ml/load_gguf_test.go): depoya GGUF dosyası girmez.

TR_test "15.51 hassasiyet adı düzeni, şekil mantıksal şekildir" {
    TR_assert_equal("q8", TR_zeros([2, 32], TR_dtype: "q8").TR_dtype)
    TR_assert_equal([2, 32], TR_zeros([2, 32], TR_dtype: "q8").TR_shape)
    TR_assert_equal("H6692", TR_error_code { TR_zeros([31], TR_dtype: "q8") })
    TR_assert_equal("H6810", TR_error_code { TR_zeros([32], TR_dtype: "q9") })
}

TR_test "15.2 TR_zeros float bellek ayırmadan sıfır nicemlenmiş tensör kurar" {
    TR_var q = TR_zeros([2, 64], TR_dtype: "q8")
    TR_assert_equal("q8", q.TR_dtype)
    TR_assert_equal([2, 64], q.TR_shape)
    TR_assert_equal("q4_k", TR_zeros([256], TR_dtype: "q4_k").TR_dtype)
    TR_assert_equal("q6_k", TR_zeros([1, 512], TR_dtype: "q6_k").TR_dtype)
    TR_assert_equal(0.0, TR_sum(q.TR_to_dtype("float32")).TR_item())
    TR_assert_equal("H6692", TR_error_code { TR_zeros([2, 33], TR_dtype: "q8") })
    TR_assert_equal("H6692", TR_error_code { TR_zeros([32], TR_dtype: "q6_k") })
}

TR_test "15.2, 15.52 değerden nicemlenmiş tensör kurulmaz" {
    TR_assert_equal("H6691", TR_error_code { TR_ones([32], TR_dtype: "q8") })
    TR_assert_equal("H6691", TR_error_code { TR_randn([32], TR_dtype: "q8") })
    TR_assert_equal("H6691", TR_error_code { TR_Tensor([1.0], TR_dtype: "q8") })
    TR_assert_equal("H6691", TR_error_code { TR_zeros([32]).TR_to_dtype("q8") })
    TR_assert_equal("H6691", TR_error_code { TR_zeros([256]).TR_to_dtype("q4_k") })
    TR_assert_equal("H6691", TR_error_code { TR_zeros([256], TR_dtype: "q8").TR_to_dtype("q6_k") })
}

TR_test "15.52 açmak hesap hassasiyetlerine ve float64'e" {
    TR_var q = TR_zeros([32], TR_dtype: "q8")
    TR_assert_equal("float32", q.TR_to_dtype("float32").TR_dtype)
    TR_assert_equal("bf16", q.TR_to_dtype("bf16").TR_dtype)
    TR_assert_equal("fp16", q.TR_to_dtype("fp16").TR_dtype)
    TR_assert_equal("float64", q.TR_to_dtype("float64").TR_dtype)
    TR_assert_equal("q8", q.TR_to_dtype("q8").TR_dtype)
}

TR_test "15.53 sayılı görünümler: satır, dilim, devrik, tensörle indeks" {
    TR_var q = TR_zeros([3, 64], TR_dtype: "q8")
    TR_assert_equal([64], q[1].TR_shape)
    TR_assert_equal("q8", q[1].TR_dtype)
    TR_assert_equal([2, 64], q[1..3].TR_shape)
    TR_assert_equal([64, 3], q.TR_transpose().TR_shape)
    TR_assert_equal("q8", q.TR_transpose().TR_dtype)
    TR_assert_equal("cpu", q.TR_transpose().TR_device)
    TR_assert_equal([3, 64], q.TR_transpose().TR_transpose().TR_shape)
    TR_assert_equal([2, 64], q[TR_Tensor[TR_Int]([2, 0])].TR_shape)
    TR_assert_equal("q8", q[TR_Tensor[TR_Int]([2, 0])].TR_dtype)
    TR_assert_equal("H6694", TR_error_code { q[TR_Tensor[TR_Int]([3])] })
    TR_assert_equal("cpu", q.TR_to_device("cpu").TR_device)
}

TR_test "15.53 devrik görünüm yalnız okunur" {
    TR_var v = TR_zeros([2, 64], TR_dtype: "q8").TR_transpose()
    TR_assert_equal("H6688", TR_error_code { v.TR_to_dtype("float32") })
    TR_assert_equal("H6688", TR_error_code { v[0] })
    TR_assert_equal("H6688", TR_error_code { v[0..1] })
    TR_assert_equal("H6688", TR_error_code { v[TR_Tensor[TR_Int]([0])] })
    TR_assert_equal("H6688", TR_error_code { TR_Tensor(v) })
}

TR_test "15.53 tek satırın devriği de devriktir" {
    TR_var s = TR_zeros([1, 64], TR_dtype: "q8").TR_transpose()
    TR_var d = TR_zeros([3, 64], TR_dtype: "q8")[0..1].TR_transpose()
    TR_for v TR_in [s, d] {
        TR_assert_equal("H6688", TR_error_code { v.TR_to_dtype("float32") })
        TR_assert_equal("H6688", TR_error_code { v[3..5] })
        TR_assert_equal("H6688", TR_error_code { v[3] })
        TR_assert_equal("H6688", TR_error_code { v[TR_Tensor[TR_Int]([3, 4])] })
        TR_assert_equal("H6688", TR_error_code { TR_embedding_lookup(v, 3) })
        TR_assert_equal("H6688", TR_error_code { TR_ones([1, 2]) @ v[3..5] })
        TR_assert_equal([1, 1], (TR_ones([1, 64]) @ v).TR_shape)
        TR_assert(TR_String(v).TR_contains("q8"))
    }
}

TR_test "15.53 başka her işlem hatadır, ileti açmayı söyler" {
    TR_var q = TR_zeros([2, 64], TR_dtype: "q8")
    TR_var f = TR_zeros([2, 64])
    TR_assert_equal("H6687", TR_error_code { q + f })
    TR_assert_equal("H6687", TR_error_code { f + q })
    TR_assert_equal("H6687", TR_error_code { q + q })
    TR_assert_equal("H6687", TR_error_code { q * 2.0 })
    TR_assert_equal("H6687", TR_error_code { -q })
    TR_assert_equal("H6687", TR_error_code { q == q })
    TR_assert_equal("H6687", TR_error_code { q > 0.0 })
    TR_assert_equal("H6687", TR_error_code { TR_sum(q) })
    TR_assert_equal("H6687", TR_error_code { TR_mean(q) })
    TR_assert_equal("H6687", TR_error_code { TR_exp(q) })
    TR_assert_equal("H6687", TR_error_code { TR_softmax(q) })
    TR_assert_equal("H6687", TR_error_code { TR_concat([q, q]) })
    TR_assert_equal("H6687", TR_error_code { q @ TR_zeros([64, 2]) })
    TR_assert_equal("H6687", TR_error_code { TR_mixed_precision("bf16") { q @ TR_zeros([64, 2]) } })
    TR_assert_equal("H6687", TR_error_code { q.TR_tolist })
    TR_assert_equal("H6687", TR_error_code { q[0].TR_tolist })
    TR_assert_equal("H6687", TR_error_code { TR_Tensor[TR_Int](q) })
    TR_assert_equal("H6687", TR_error_code { TR_Tensor[TR_Float](q) })
    TR_assert_equal("H6687", TR_error_code { TR_equal(q, f) })
    TR_assert_equal("H6687", TR_error_code { TR_equal(q.TR_transpose(), f) })
    TR_assert_equal("H6687", TR_error_code { TR_equal(f, q.TR_transpose()) })
    TR_assert_equal("H6687", TR_error_code { q.TR_reshape([64, 2]) })
    TR_assert_equal("H6687", TR_error_code { q.TR_permute([1, 0]) })
    TR_assert_equal("H6687", TR_error_code { q.TR_slice(1, 0, 32) })
    TR_assert_equal("H6687", TR_error_code { q[0][1] })
    TR_assert_equal("H6687", TR_error_code { q[0][0..32] })
}

TR_test "15.53 çarpım ve gömme" {
    TR_var q = TR_zeros([3, 64], TR_dtype: "q8")
    TR_var x = TR_ones([2, 64])
    TR_assert_equal([2, 3], (x @ q.TR_transpose()).TR_shape)
    TR_assert_equal("float32", (x @ q.TR_transpose()).TR_dtype)
    TR_assert_equal("bf16", (x.TR_to_dtype("bf16") @ q.TR_transpose()).TR_dtype)
    TR_assert_equal([3], (TR_ones([64]) @ q.TR_transpose()).TR_shape)
    TR_assert_equal(0.0, TR_sum(x @ q.TR_transpose()).TR_item())
    TR_assert_equal([2, 3], (TR_zeros([2, 0]) @ TR_zeros([3, 0], TR_dtype: "q8").TR_transpose()).TR_shape)
    TR_assert_equal(0.0, TR_sum(TR_zeros([1, 0]) @ TR_zeros([3, 0], TR_dtype: "q8").TR_transpose()).TR_item())
    TR_assert_equal("H6695", TR_error_code { x @ q })
    TR_assert_equal("H6695", TR_error_code { TR_ones([2, 3]) @ q })
    TR_assert_equal("H6696", TR_error_code { TR_ones([2, 64], TR_requires_grad: TR_true) @ q.TR_transpose() })
    TR_assert_equal([2, 3], TR_no_grad { TR_ones([2, 64], TR_requires_grad: TR_true) @ q.TR_transpose() }.TR_shape)
    TR_mixed_precision("bf16") {
        TR_assert_equal("bf16", (x @ q.TR_transpose()).TR_dtype)
        TR_assert_equal("bf16", TR_embedding_lookup(q, 0).TR_dtype)
    }
    TR_assert_equal([64], TR_embedding_lookup(q, 2).TR_shape)
    TR_assert_equal("float32", TR_embedding_lookup(q, 2).TR_dtype)
    TR_assert_equal([2, 1, 64], TR_embedding_lookup(q, TR_Tensor[TR_Int]([[0], [1]])).TR_shape)
    TR_assert_equal("H6688", TR_error_code { TR_embedding_lookup(q.TR_transpose(), 0) })
    TR_assert_equal("H6687", TR_error_code { TR_linear_cross_entropy(x, q.TR_transpose(), TR_Tensor[TR_Int]([0, 0])) })
}

TR_test "15.52 nicemlenmiş tensör türev izlemez" {
    TR_assert_equal("H6690", TR_error_code { TR_zeros([32], TR_dtype: "q8", TR_requires_grad: TR_true) })
}

TR_test "15.54 yerinde yazılmaz, kopya yeni bir depodur" {
    TR_var q = TR_zeros([2, 64], TR_dtype: "q8")
    TR_assert_equal("H6957", TR_error_code { q[0] = 1.0 })
    TR_assert_equal("H6957", TR_error_code { q[0..1] = 1.0 })
    TR_assert_equal("H6957", TR_error_code { q += 1.0 })
    TR_assert_equal("H6957", TR_error_code { TR_write_slice(q, TR_ones([1, 64]), TR_dim: 0, TR_start: 0) })
    TR_var c = TR_Tensor(q)
    TR_assert_equal("q8", c.TR_dtype)
    TR_assert_equal([2, 64], c.TR_shape)
}

TR_test "15.55 kaydetme henüz yok, ileti açmayı söyler" {
    TR_var q = TR_zeros([32], TR_dtype: "q8")
    TR_assert_equal("H6687", TR_error_code { TR_save_tensors("q.trt", {"q": q}) })
    TR_assert_equal("H6687", TR_error_code { TR_save_tensors("q.safetensors", {"q": q}) })
}

TR_test "15.53 yazdırma açılmış değerlerle" {
    TR_var q = TR_zeros([32], TR_dtype: "q8")
    TR_assert(TR_String(q).TR_contains("q8"))
    TR_assert(TR_String(q).TR_contains("0.0000"))
}
