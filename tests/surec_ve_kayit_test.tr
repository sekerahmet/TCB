// docs/spec/19_surec_ve_kayit.md §19 — Süreç ve kayıt
// tr test argümansız çalışır: komut_satırı varsayılanları döndürür. Komut satırı yazımı,
// --yardım, çıkış kodları ve terminaldeki çubuk Go testleriyle sınanır
// (internal/stdlib/process, internal/stdlib/logging, cmd/tr/e2e).

aktar "yardimci_test_araclari"

// Günlük dosyaları depo dışında, bu koşunun geçici klasöründe (18.14); program bitince silinir.
sabit KOŞU = geçici_klasör()

// satırlar: günlük dosyasının JSON satırlarını sözlük listesi olarak verir.
fonksiyon satırlar(dosya_yolu) {
    sonuç dosya_oku(dosya_yolu).kırp().böl("\n").haritala { json_çöz(o) }
}

// Programın tek komut_satırı çağrısı (19.2, 19.4 bunu kullanır).
sabit AYAR = komut_satırı({adım: 100, oran: 0.5, veri: "veri/train", katmanlar: [64, 32], hızlı: yanlış, etiket: yok, api_anahtarı: "anahtar-varsayılan-1"},
    açıklama: "Deneme", açıklamalar: {adım: "eğitim adımı"})

test "19.1 ortam_değişkeni değeri Metin olarak, tanımsızsa yok verir" {
    eşit_mi(yok, ortam_değişkeni("TR_BOYLE_BIR_DEGISKEN_YOK_19"))
    eşit_mi("varsayılan", ortam_değişkeni("TR_BOYLE_BIR_DEGISKEN_YOK_19") ?? "varsayılan")
    eşit_mi(Metin, tip(ortam_değişkeni("PATH")))
    doğrula(hata_metni(() => ortam_değişkeni(5)).içerir("1. argüman olarak Metin bekler"))
    doğrula(hata_metni(() => ortam_değişkeni("")).içerir("geçerli bir ortam değişkeni adı değil"))
}

test "19.2 komut_satırı argümansızken varsayılanları yeni bir sözlükte verir" {
    eşit_mi(Sözlük, tip(AYAR))
    eşit_mi(["adım", "oran", "veri", "katmanlar", "hızlı", "etiket", "api_anahtarı"], AYAR.anahtarlar())
    eşit_mi(100, AYAR.adım)
    eşit_mi(0.5, AYAR.oran)
    eşit_mi([64, 32], AYAR.katmanlar)
    eşit_mi(yanlış, AYAR.hızlı)
    eşit_mi(yok, AYAR.etiket)
}

test "19.2 komut_satırı programda bir kez çağrılır" {
    doğrula(hata_metni(() => komut_satırı({adım: 1})).içerir("programda bir kez çağrılır"))
}

test "19.3 seçenek tipleri ve adları kurulumda denetlenir" {
    doğrula(hata_metni(() => komut_satırı({uzunluk: 3})).içerir("\"uzunluk\" seçenek adı olamaz: Sözlük tipinin bir üyesidir"))
    doğrula(hata_metni(() => komut_satırı({içerir: "x"})).içerir("seçenek adı olamaz"))
    doğrula(hata_metni(() => komut_satırı({yardım: doğru})).içerir("--yardım ve -h seçenekleri listeler"))
    doğrula(hata_metni(() => komut_satırı({a: {b: 1}})).içerir("'a' seçeneğinin varsayılanı"))
    doğrula(hata_metni(() => komut_satırı({a: [1, "x"]})).içerir("öğeler aynı tipte olmalı"))
    doğrula(hata_metni(() => komut_satırı({adım: 1}, açıklamalar: {adim: "x"})).içerir("Bunu mu demek istediniz: 'adım'?"))
    doğrula(hata_metni(() => komut_satırı({a: 1}, açklama: "x")).içerir("Bunu mu demek istediniz: 'açıklama'?"))
}

test "19.4 gizli adlı seçeneğin değeri insanın göreceği çıktıda maskelenir, veride değişmez" {
    // Değerin kendisi programda değişmez (yazdır'ın döndürdüğü metin de veridir).
    eşit_mi("anahtar-varsayılan-1", AYAR.api_anahtarı)
    değişken dosya_yolu = "{KOŞU}/gizli.jsonl"
    günlük(dosya_yolu).ekle({anahtar: AYAR.api_anahtarı})
    değişken içerik = dosya_oku(dosya_yolu)
    doğrula(içerik.içerir("\"anahtar\":\"***\""), içerik)
    doğrula(değil içerik.içerir("anahtar-varsayılan-1"))
}

test "19.5 günlük .jsonl dosyasına başlangıç kaydı ve kayıtlar ekler" {
    değişken dosya_yolu = "{KOŞU}/kayit/egitim.jsonl"
    değişken g = günlük(dosya_yolu)
    eşit_mi(Günlük, tip(g))
    eşit_mi(doğru, g.ekle({kayıp: 2.5, adım: 3, nan: ondalık("NaN"), kayıp_t: tensör([0.25])}))
    g.ekle("ilk dönem bitti")
    değişken s = satırlar(dosya_yolu)
    eşit_mi(3, s.uzunluk)
    eşit_mi("başlangıç", s[0].tür)
    eşit_mi(1, s[0].sürüm)
    eşit_mi("surec_ve_kayit_test.tr", s[0].program)
    eşit_mi(100, s[0].ayarlar.adım)
    eşit_mi(2.5, s[1].kayıp)
    eşit_mi(3, s[1].adım)
    eşit_mi("NaN", s[1].nan)
    eşit_mi(0.25, s[1].kayıp_t)
    eşit_mi(Metin, tip(s[1].zaman))
    eşit_mi("ilk dönem bitti", s[2].mesaj)
    // Yeniden açılan günlük sonuna ekler, yeni bir başlangıç kaydıyla.
    günlük(dosya_yolu).ekle({kayıp: 1.0})
    değişken s2 = satırlar(dosya_yolu)
    eşit_mi(5, s2.uzunluk)
    eşit_mi("başlangıç", s2[3].tür)
}

test "19.6 günlük hataları" {
    doğrula(hata_metni(() => günlük("{KOŞU}/a.csv")).içerir("uzantılı olmalı"))
    değişken g = günlük("{KOŞU}/h.jsonl")
    doğrula(hata_metni(() => g.ekle({tür: "x"})).içerir("'tür' adı günlük biçimine ayrılmış"))
    doğrula(hata_metni(() => g.ekle({f: yazdır})).içerir("ölçüsünün değeri"))
    doğrula(hata_metni(() => g.ekle(5)).içerir("Sözlük ya da Metin bekler"))
    doğrula(hata_metni(() => g.eklee({})).içerir("Bunu mu demek istediniz: 'ekle'?"))
}

test "19.7 ilerleme adım sayar, toplama ulaşınca biter" {
    değişken ç = ilerleme(3)
    eşit_mi(İlerleme, tip(ç))
    eşit_mi(doğru, ç.güncelle({kayıp: 0.5}))
    eşit_mi("İlerleme(adım 1/3)", metin(ç))
    ç.güncelle()
    ç.güncelle()
    eşit_mi("İlerleme(adım 3/3, bitti)", metin(ç))
    doğrula(hata_metni(() => ç.güncelle()).içerir("çubuk bitti (adım 3/3)"))
    eşit_mi(yanlış, ç.durdur())
    // adım: kaldığı yerden sürdürür; toplamsız sayaç; elle durdurma
    değişken d = ilerleme(1000)
    d.güncelle(adım: 500)
    d.güncelle()
    eşit_mi("İlerleme(adım 501/1000)", metin(d))
    eşit_mi(doğru, d.durdur())
    değişken s = ilerleme()
    s.güncelle()
    eşit_mi("İlerleme(adım 1)", metin(s))
    s.durdur()
}

test "19.8 ilerleme hataları" {
    doğrula(hata_metni(() => ilerleme(0)).içerir("pozitif olmalı"))
    doğrula(hata_metni(() => ilerleme("çok")).içerir("Tam ya da Yok bekler"))
    doğrula(hata_metni(() => ilerleme(5, günlük: "a.jsonl")).içerir("bir Günlük olmalı"))
    değişken ç = ilerleme(5)
    doğrula(hata_metni(() => ç.güncelle(adım: 9)).içerir("toplam adım sayısından (5) büyük olamaz"))
    doğrula(hata_metni(() => ç.güncelle({adım: 1})).içerir("'adım' adı günlük biçimine ayrılmış"))
    doğrula(hata_metni(() => ç.güncelle(adim: 1)).içerir("Bunu mu demek istediniz: 'adım'?"))
    ç.durdur()
}

test "19.9 günlüğe bağlı çubuk her güncellemeyi ve bitişi yazar" {
    değişken dosya_yolu = "{KOŞU}/cubuk.jsonl"
    değişken g = günlük(dosya_yolu)
    değişken ç = ilerleme(2, günlük: g)
    ç.güncelle({kayıp: 0.9})
    ç.güncelle({kayıp: 0.7})
    değişken s = satırlar(dosya_yolu)
    eşit_mi(4, s.uzunluk)
    eşit_mi(2, s[0].toplam)
    eşit_mi(1, s[1].adım)
    eşit_mi(0.9, s[1].kayıp)
    eşit_mi(0.7, s[2].kayıp)
    eşit_mi("bitiş", s[3].tür)
    eşit_mi(2, s[3].adım)
    doğrula(s[3].süre_sn >= 0)
}
