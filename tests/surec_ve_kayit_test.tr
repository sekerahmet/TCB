# TR 4
# docs/spec/19_surec_ve_kayit.md §19 — Süreç ve kayıt
# trlang test argümansız çalışır: komut_satırı varsayılanları döndürür. Komut satırı yazımı,
# --help, çıkış kodları ve terminaldeki çubuk Go testleriyle sınanır
# (internal/stdlib/process, internal/stdlib/logging, cmd/trlang/e2e).

# Günlük dosyaları depo dışında, testin kendi geçici klasöründedir (18.14); program bitince silinir.

# satırlar: günlük dosyasının JSON satırlarını JSON listesi olarak verir.
TR_func satırlar(dosya_yolu: TR_String) -> TR_List[TR_JSON] {
    TR_return TR_read_file(dosya_yolu).TR_strip().TR_split("\n").TR_map((x) => TR_json_parse(x))
}

# ayar: programın tek komut_satırı çağrısı (19.2: ikinci çağrı hatadır); ilk çağıran test onu yapar,
# sonuç ayar_sonucu'nda kalır ve sonrakiler onu okur (19.2, 19.4). Argümansız koşuda varsayılanlar.
# Sonuç karışık değerli bir sözlüktür (19.2 yapı diyor); ayar onu döndürmez, tipi yazılamaz.
TR_var ayar_sonucu = TR_none

TR_func ayar() {
    TR_if ayar_sonucu == TR_none {
        ayar_sonucu = TR_command_line({"step": 100, "oran": 0.5, "veri": "veri/train", "katmanlar": [64, 32], "hızlı": TR_false, "etiket": TR_none, "api_anahtarı": "anahtar-varsayılan-1"},
            TR_description: "Deneme", TR_descriptions: {"step": "eğitim adımı"})
    }
}

TR_test "19.1 ortam_değişkeni değeri Metin olarak, tanımsızsa yok verir" {
    TR_assert_equal(TR_none, TR_env("TR_BOYLE_BIR_DEGISKEN_YOK_19"))
    TR_assert_equal("varsayılan", TR_env("TR_BOYLE_BIR_DEGISKEN_YOK_19") ?? "varsayılan")
    TR_assert_equal(TR_String, TR_Type(TR_env("PATH")))
    TR_assert_equal("H2423", TR_error_code { TR_env([5, "a"][0]) })
    TR_assert_equal("H7231", TR_error_code { TR_env("") })
}

TR_test "19.2 komut_satırı argümansızken varsayılanları yeni bir değerde verir" {
    ayar()
    TR_var seçenekler = ayar_sonucu
    TR_assert_equal(TR_Dict, TR_Type(seçenekler))
    TR_assert_equal(["step", "oran", "veri", "katmanlar", "hızlı", "etiket", "api_anahtarı"], seçenekler.TR_keys())
    TR_assert_equal(100, seçenekler["step"])
    TR_assert_equal(0.5, seçenekler["oran"])
    TR_assert_equal([64, 32], seçenekler["katmanlar"])
    TR_assert_equal(TR_false, seçenekler["hızlı"])
    TR_assert_equal(TR_none, seçenekler["etiket"])
}

TR_test "19.2 komut_satırı programda bir kez çağrılır" {
    ayar()
    TR_assert_equal("H7218", TR_error_code { TR_command_line({"step": 1}) })
}

TR_test "19.3 seçenek tipleri ve adları kurulumda denetlenir" {
    TR_assert_equal("H7221", TR_error_code { TR_command_line({"help": TR_true}) })
    TR_assert_equal("H7225", TR_error_code { TR_command_line({"a": {"b": 1}}) })
    TR_assert_equal("H7224", TR_error_code { TR_command_line({"a": [1, "x"]}) })
    TR_assert_equal("H7229", TR_error_code { TR_command_line({"step": 1}, TR_descriptions: {"stpe": "x"}) })
    TR_assert_equal("H7900", TR_error_code { TR_command_line({"a": 1}, açklama: "x") })
}

TR_test "19.4 gizli adlı seçeneğin değeri insanın göreceği çıktıda maskelenir, veride değişmez" {
    # Değerin kendisi programda değişmez (yazdır'ın döndürdüğü metin de veridir).
    ayar()
    TR_var seçenekler = ayar_sonucu
    TR_assert_equal("anahtar-varsayılan-1", seçenekler["api_anahtarı"])
    TR_var dosya_yolu = "\(TR_temp_dir())/gizli.jsonl"
    TR_Logger(dosya_yolu).TR_append({"anahtar": seçenekler["api_anahtarı"]})
    TR_var içerik = TR_read_file(dosya_yolu)
    TR_assert(içerik.TR_contains("\"anahtar\":\"***\""), içerik)
    TR_assert(TR_not içerik.TR_contains("anahtar-varsayılan-1"))
}

TR_test "19.4 TR_env: ile dış programa verilen adresin kimlik kısmı maskelenir, veri değişmez" {
    # Değişkenin adı gizli değil; değerdeki iki adresin parolası adresin kuralıyla gizlidir.
    TR_var değer = "http://a:Vekil2026@x,http://b:Baska2026@y"
    TR_run_process("gofmt", ["-tanimsiz"], TR_exit_codes: [2], TR_env: {"KUME": değer})
    TR_var m = TR_mask_stream()
    TR_assert_equal("a:*** b:***", m.TR_step("a:Vekil2026 b:Baska2026") + m.TR_finish())
    TR_assert(değer.TR_contains("Vekil2026"))
}

TR_test "19.4a maskeli akış iki parçaya bölünen gizli değeri maskeler; bittikten sonra adım hatadır" {
    # Gizli değer 19.4'ün seçeneğinden gelir (api_anahtarı); parçalar onu ortasından böler.
    ayar()
    TR_var m = TR_mask_stream()
    TR_assert_equal(TR_MaskStream, TR_Type(m))
    TR_var parçalar = ["anahtar: anahtar-var", "sayılan-1", " bitti"]
    TR_var ilk = m.TR_step(parçalar[0])
    TR_assert_equal("anahtar: ", ilk)
    TR_var gösterilen = ilk + m.TR_step(parçalar[1]) + m.TR_step(parçalar[2]) + m.TR_finish()
    TR_assert_equal("anahtar: *** bitti", gösterilen)
    TR_assert_equal("anahtar-var", parçalar[0].TR_split(": ")[1])
    TR_assert_equal("", m.TR_finish())
    TR_assert_equal("H7634", TR_error_code { m.TR_step("x") })
    TR_assert_equal("H2423", TR_error_code { TR_mask_stream().TR_step(5) })
    TR_assert_equal("H2012", TR_error_code { TR_mask_stream(1) })
}

TR_test "19.5 günlük .jsonl dosyasına başlangıç kaydı ve kayıtlar ekler" {
    ayar()
    TR_var dosya_yolu = "\(TR_temp_dir())/kayit/egitim.jsonl"
    TR_var g = TR_Logger(dosya_yolu)
    TR_assert_equal(TR_Logger, TR_Type(g))
    g.TR_append({"loss": 2.5, "step": 3, "nan": TR_Float("nan"), "kayıp_t": TR_Tensor([0.25])})
    g.TR_append("ilk dönem bitti")
    TR_var s = satırlar(dosya_yolu)
    TR_assert_equal(3, s.TR_length)
    TR_assert_equal("start", TR_String(s[0]["kind"]))
    TR_assert_equal(2, TR_Int(s[0]["version"]))
    TR_assert_equal("surec_ve_kayit_test.tr", TR_String(s[0]["program"]))
    TR_assert_equal(100, TR_Int(s[0]["settings"]["step"]))
    TR_assert_equal(2.5, TR_Float(s[1]["loss"]))
    TR_assert_equal(3, TR_Int(s[1]["step"]))
    TR_assert_equal("NaN", TR_String(s[1]["nan"]))
    TR_assert_equal(0.25, TR_Float(s[1]["kayıp_t"]))
    TR_assert_equal(TR_String, TR_Type(s[1]["time"]))
    TR_assert_equal("ilk dönem bitti", TR_String(s[2]["message"]))
    # Yeniden açılan günlük sonuna ekler, yeni bir başlangıç kaydıyla.
    TR_Logger(dosya_yolu).TR_append({"loss": 1.0})
    TR_var s2 = satırlar(dosya_yolu)
    TR_assert_equal(5, s2.TR_length)
    TR_assert_equal("start", TR_String(s2[3]["kind"]))
}

TR_test "19.5 g.kapat günlüğü program bitmeden kapatır; kapatılmış günlüğe yazmak hatadır" {
    TR_var dosya_yolu = "\(TR_temp_dir())/kapat.jsonl"
    TR_var g = TR_Logger(dosya_yolu)
    g.TR_append({"loss": 1.0})
    TR_assert_equal([TR_true, TR_false], [g.TR_close(), g.TR_close()])
    TR_assert_equal("H2725", TR_error_code { g.TR_append({"loss": 2.0}) })
    TR_assert_equal(2, satırlar(dosya_yolu).TR_length)
    # kayıtsız kapatılan günlüğün de başlangıç kaydı vardır; yeniden açılan günlük sonuna ekler
    TR_var boş_yol = "\(TR_temp_dir())/bos.jsonl"
    TR_Logger(boş_yol).TR_close()
    TR_assert_equal("start", TR_String(satırlar(boş_yol)[0]["kind"]))
    TR_Logger(dosya_yolu).TR_append({"loss": 3.0})
    TR_assert_equal(4, satırlar(dosya_yolu).TR_length)
}

TR_test "19.5 kayıttaki tam değerli adım tam sayı yazılır, ondalık ölçü olduğu gibi kalır" {
    TR_var yol = "\(TR_temp_dir())/adım.jsonl"
    TR_var g = TR_Logger(yol)
    g.TR_append({"step": 3.0, "loss": 2.0})
    TR_var kayıt = TR_json_parse(TR_read_file(yol).TR_strip().TR_split("
")[1])
    TR_assert_equal(3, TR_Int(kayıt["step"]))
    TR_assert_equal(TR_Float, TR_Type(kayıt["loss"]))
}

TR_test "19.6 günlük hataları" {
    TR_var koşu = TR_temp_dir()
    TR_assert_equal("H7319", TR_error_code { TR_Logger("\(koşu)/a.csv") })
    TR_var g = TR_Logger("\(koşu)/h.jsonl")
    TR_assert_equal("H7321", TR_error_code { g.TR_append({"kind": "x"}) })
    TR_assert_equal("H7013", TR_error_code { g.TR_append({"step": 3.5}) })
    TR_assert_equal("H7013", TR_error_code { g.TR_append({"step": TR_nan}) })
    TR_assert_equal("H7013", TR_error_code { g.TR_append({"step": 1e19}) })
    TR_assert_equal("H7300", TR_error_code { g.TR_append({"f": TR_print}) })
    TR_assert_equal("H2423", TR_error_code { g.TR_append(5) })
    TR_assert_equal("H7903", TR_error_code { g.eklee({}) })
}

TR_test "19.7 ilerleme adım sayar, toplama ulaşınca biter" {
    TR_var ç = TR_Progress(3)
    TR_assert_equal(TR_Progress, TR_Type(ç))
    ç.TR_update({"loss": 0.5})
    TR_assert(TR_String(ç).TR_contains(" 1/3)"), TR_String(ç))
    ç.TR_update()
    ç.TR_update()
    TR_assert(TR_String(ç).TR_contains(" 3/3, "), TR_String(ç))
    TR_assert_equal("H7316", TR_error_code { ç.TR_update() })
    TR_assert_equal(TR_false, ç.TR_stop())
    # adım: kaldığı yerden sürdürür; toplamsız sayaç; elle durdurma
    TR_var d = TR_Progress(1000)
    d.TR_update(TR_step: 500)
    d.TR_update()
    TR_assert(TR_String(d).TR_contains(" 501/1000)"), TR_String(d))
    TR_assert_equal(TR_true, d.TR_stop())
    TR_var s = TR_Progress()
    s.TR_update()
    TR_assert(TR_String(s).TR_ends_with(" 1)"), TR_String(s))
    s.TR_stop()
}

TR_test "19.8 ilerleme hataları" {
    TR_assert_equal("H7313", TR_error_code { TR_Progress(0) })
    TR_assert_equal("H2423", TR_error_code { TR_Progress("çok") })
    TR_assert_equal("H7314", TR_error_code { TR_Progress(5, TR_log: "a.jsonl") })
    TR_var ç = TR_Progress(5)
    TR_assert_equal("H7317", TR_error_code { ç.TR_update(TR_step: 9) })
    TR_assert_equal("H7321", TR_error_code { ç.TR_update({"step": 1}) })
    TR_assert_equal("H7900", TR_error_code { ç.TR_update(adim: 1) })
    ç.TR_stop()
}

TR_test "19.9 günlüğe bağlı çubuk her güncellemeyi ve bitişi yazar" {
    TR_var dosya_yolu = "\(TR_temp_dir())/cubuk.jsonl"
    TR_var g = TR_Logger(dosya_yolu)
    TR_var ç = TR_Progress(2, TR_log: g)
    ç.TR_update({"loss": 0.9})
    ç.TR_update({"loss": 0.7})
    TR_var s = satırlar(dosya_yolu)
    TR_assert_equal(4, TR_Int(s.TR_length))
    TR_assert_equal(2, TR_Int(s[0]["total"]))
    TR_assert_equal(1, TR_Int(s[1]["step"]))
    TR_assert_equal(0.9, TR_Float(s[1]["loss"]))
    TR_assert_equal(0.7, TR_Float(s[2]["loss"]))
    TR_assert_equal("end", TR_String(s[3]["kind"]))
    TR_assert_equal(2, TR_Int(s[3]["step"]))
    TR_assert(TR_Float(s[3]["seconds"]) >= 0)
}
