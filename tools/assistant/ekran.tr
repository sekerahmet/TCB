# TR 4
# Asistanın ekranı (contract.md, sürüm 1): sayfayı ve dil dosyalarını sunar, zincirin olaylarını yayar, komutları
# alır. asistan.tr `--ekran <kapı>` ile kurar; ekran_test.tr sahte zincirle sınar.
# - Görüntü (`session` olayı) yalnız olaylardan katlanır (28.7, `katla`); programın başka bir değişkeninden kurulmaz.
# - Komutun kararı ana döngüde verilir (`komutları_işle`): işleyici komutu tek bir `TR_append` ile bırakır, cevabı
#   bekler. İşleyicide "oku, sonra yaz" iki deyim olurdu; 10.2'nin devir noktası arada iki `send_text`'i birden
#   kabul ettirir, aynı `command_id`'yi iki kez işletirdi.
# - Tur bir görevde koşar (`tur_yürüt`); `stop` onu iptal eder (10.9). `turn_end`, `metrics` ve geri alma tek yerde,
#   bekleyen tarafta, `.TR_wait()`'in sonucuna bağlı yazılır: tur kendi `turn_end`'ini yazmaz.

TR_import "zincir"

TR_const _SÜRÜM = 1
TR_const _KAPASİTE = 1024 # sözleşme: en az son 1024 olay
TR_const _NABIZ_MS = 15000 # 28.7
TR_const _METİN_SINIRI = 32768
TR_const _TUTULAN_KOMUT = 1024
# Yeni tur açılırken görüntü bundan büyükse eski turlar düşer. Süren tur en çok ~250 KiB ekler (32 KiB söz JSON
# kaçışıyla en çok 6 katı, artı cevap): görüntü olayın 1 MiB sınırının altında kalır (ekran_test sınar).
TR_const _BÜTÇE = 524288
TR_const _CEVAP_BEKLEMESİ = 0.005 # işleyicinin ana döngünün cevabına bakışı (sn)
TR_const _CSP = "frame-ancestors 'none'; connect-src 'self'"
TR_const _TUR_BAKIŞI = 0.02 # tur sürerken ana döngünün komutlara bakışı (sn)
TR_const _ETİKETLER = ["<think>", "</think>", "<tool_call>", "</tool_call>"]

# Komut: işleyicinin bıraktığı, ana döngünün cevapladığı komut.
TR_struct Komut {
    kimlik: TR_String
    tür: TR_String
    veri: TR_JSON
    cevap: TR_JSON? = TR_none
}

# Ekran: yayıncı, bekleyen komutlar ve ekranın gördüğü durum. Alanları yalnız ana döngü yazar; işleyici yalnız
# `bekleyen`'e ekler ve kendi komutunun `cevap`'ını okur.
TR_struct Ekran {
    yayın: TR_EventBroadcast
    kök: TR_String # index.html'in klasörü
    diller: TR_List[TR_String] # sayfanın listelediği dil dosyaları

    bekleyen: TR_List[Komut] = []
    cevaplar: TR_Dict[TR_String, TR_JSON] = {}
    sıra: TR_List[TR_String] = [] # tutulan kimlikler, eskiden yeniye
    hazır: TR_Bool = TR_false # modeller yüklendi
    mic: TR_Bool = TR_false # mikrofon gerçekten açık (ilk çerçeve okundu)
    mikrofon_istendi: TR_Bool = TR_false
    tur: TR_String = "" # süren ya da açılmak üzere olan tur; yoksa ""
    tur_sayısı: TR_Int = 0
    metin: TR_String? = TR_none # kabul edilmiş, henüz açılmamış metin turu
    metin_turu: TR_String = "" # bekleyen metin turunun kabulde verilen kimliği
    durdur: TR_Bool = TR_false # süren tur için `stop` geldi
    kayıt: TR_Bool = TR_false # sınama: gönderilen olaylar `giden`'e de yazılır
    giden: TR_List[TR_JSON] = []

    TR_func gönder(tür: TR_String, veri: TR_JSON) {
        TR_var olay = TR_JSON({"v": _SÜRÜM, "type": tür, "data": veri})
        TR_self.yayın.TR_send_event(olay)
        TR_if TR_self.kayıt { TR_self.giden.TR_append(olay) }
    }

    TR_func durum(durum: TR_String) { TR_self.gönder("state", TR_JSON({"state": durum, "mic": TR_self.mic})) }

    TR_func boşta() { TR_self.durum(TR_if TR_self.mic { "listening" } TR_else { "idle" }) }

    # yeni_tur: turun kimliğini verir ve onu süren tur yapar.
    TR_func yeni_tur() -> TR_String {
        TR_self.tur_sayısı += 1
        TR_self.tur = "t-\(TR_self.tur_sayısı)"
        TR_return TR_self.tur
    }
}

# ekran_kur: yayıncıyı kurar ve ilk olayı (`state: loading`) yollar. `kök` index.html'in klasörüdür; `katlayıcı`
# yalnız sınamada değişir (screen_demo.tr katlamayı yavaşlatır, abonelik bir gönderime denk gelsin).
TR_func ekran_kur(kök: TR_String, model: TR_String, katlayıcı: (TR_JSON, TR_JSON) -> TR_JSON = katla) -> Ekran {
    TR_var baş = TR_JSON({"v": _SÜRÜM, "type": "session", "data": {"session_id": "s-\(TR_time_ms())", "server_version": "tr-assistant-1",
        "model": model, "tools": [], "heartbeat_ms": _NABIZ_MS, "snapshot": []}})
    TR_var yayın = TR_EventBroadcast(TR_capacity: _KAPASİTE, TR_snapshot: baş, TR_reduce: katlayıcı,
        TR_heartbeat: {"v": _SÜRÜM, "type": "heartbeat"})
    TR_var e = Ekran(yayın: yayın, kök: kök, diller: sayfanın_dilleri(kök))
    e.durum("loading")
    TR_return e
}

# sayfanın_dilleri: index.html'in sonundaki `<script src="lang/<kod>.js"></script>` satırları.
TR_func sayfanın_dilleri(kök: TR_String) -> TR_List[TR_String] {
    TR_var diller: TR_List[TR_String] = []
    TR_var baş = "<script src=\"lang/"
    TR_var son = ".js\"></script>"
    TR_for satır TR_in TR_read_file(TR_Path(kök, "index.html")).TR_lines() {
        TR_var s = satır.TR_strip()
        TR_if s.TR_starts_with(baş) TR_and s.TR_ends_with(son) { diller.TR_append(s[baş.TR_length..s.TR_length - son.TR_length]) }
    }
    TR_return diller
}

# ---------- Katlama (28.7) ----------

# katla: bir olayı görüntünün `snapshot`'ına sözleşmenin sıkıştırma kuralıyla işler ("session"): son `state` başta,
# son `metrics` sonda, bir konuşma parçası tek `turn_text`, kapanan onay düşer. Yeni tur açılırken görüntü bütçeyi
# aşıyorsa eski turlar düşer; açık onay düşmez. Zarf (`v`, `type`) başlangıç değerindedir.
TR_func katla(g: TR_JSON, olay: TR_JSON) -> TR_JSON {
    TR_var tür = TR_String(olay["type"])
    TR_var veri = olay["data"]
    TR_var giriş = TR_JSON({"type": tür, "data": veri})
    TR_var d = TR_Dict(g["data"])
    TR_var l = TR_List(d["snapshot"])
    TR_match tür {
        "state" => {
            TR_if l.TR_length > 0 TR_and TR_String(l[0]["type"]) == "state" { l[0] = giriş } TR_else { l = [giriş] + l }
        }
        "metrics" => {
            TR_var n = l.TR_length
            TR_if n > 0 TR_and TR_String(l[n - 1]["type"]) == "metrics" { l[n - 1] = giriş } TR_else { l.TR_append(giriş) }
        }
        "turn_start" => {
            TR_for TR_Bytes(TR_json_string(TR_JSON(l))).TR_length > _BÜTÇE {
                TR_var kalan = eski_turu_düşür(l)
                TR_if kalan == TR_none { TR_break }
                l = kalan
            }
            l = araya(l, giriş)
        }
        "turn_text" => { l = metni_kat(l, veri) }
        "turn_end", "tool_start", "tool_end", "approval_open" => { l = araya(l, giriş) }
        "approval_close" => {
            TR_var kimlik = TR_String(veri["approval_id"])
            l = [x TR_for x TR_in l TR_if TR_not (TR_String(x["type"]) == "approval_open" TR_and TR_String(x["data"]["approval_id"]) == kimlik)]
        }
        _ => { TR_return g } # error ve bilinmeyen olay görüntüye girmez
    }
    d["snapshot"] = TR_JSON(l)
    TR_return TR_JSON({"v": g["v"], "type": g["type"], "data": TR_JSON(d)})
}

# araya: girişi sondaki `metrics`'ten önce ekler.
TR_func araya(l: TR_List[TR_JSON], giriş: TR_JSON) -> TR_List[TR_JSON] {
    TR_var n = l.TR_length
    TR_if n > 0 TR_and TR_String(l[n - 1]["type"]) == "metrics" { TR_return l[0..n - 1] + [giriş, l[n - 1]] }
    l.TR_append(giriş)
    TR_return l
}

# metni_kat: bir konuşma parçası (tur ve rol) tek `turn_text`'tir, `replace` kipinde, birikmiş metinle.
TR_func metni_kat(l: TR_List[TR_JSON], v: TR_JSON) -> TR_List[TR_JSON] {
    TR_var tur = TR_String(v["turn_id"])
    TR_var rol = TR_String(v["role"])
    TR_var yer = -1
    TR_var i = l.TR_length - 1
    TR_for i >= 0 TR_and yer < 0 {
        TR_var x = l[i]
        TR_var xt = TR_String(x["type"])
        TR_if xt == "turn_start" TR_and TR_String(x["data"]["turn_id"]) == tur { TR_break }
        TR_if xt == "turn_text" TR_and TR_String(x["data"]["turn_id"]) == tur TR_and TR_String(x["data"]["role"]) == rol { yer = i }
        i -= 1
    }
    TR_var metin = TR_String(v["text"])
    TR_if yer >= 0 TR_and TR_String(v["mode"]) == "append" { metin = TR_String(l[yer]["data"]["text"]) + metin }
    TR_var yeni = TR_Dict(v)
    yeni["mode"] = TR_JSON("replace")
    yeni["text"] = TR_JSON(metin)
    TR_var giriş = TR_JSON({"type": "turn_text", "data": TR_JSON(yeni)})
    TR_if yer >= 0 {
        l[yer] = giriş
        TR_return l
    }
    TR_return araya(l, giriş)
}

# eski_turu_düşür: görüntüdeki ilk turun girişlerini (tur, metin, araçları) atar; açık onay kalır. Tur yoksa TR_none.
TR_func eski_turu_düşür(l: TR_List[TR_JSON]) -> TR_List[TR_JSON]? {
    TR_var tur = ""
    TR_for x TR_in l {
        TR_if TR_String(x["type"]) == "turn_start" {
            tur = TR_String(x["data"]["turn_id"])
            TR_break
        }
    }
    TR_if tur == "" { TR_return TR_none }
    TR_var çağrılar: TR_List[TR_String] = []
    TR_var kalan: TR_List[TR_JSON] = []
    TR_for x TR_in l {
        TR_var xt = TR_String(x["type"])
        TR_var v = x["data"]
        TR_var xtur = v.TR_get("turn_id")
        TR_if xt != "approval_open" TR_and xtur != TR_none TR_and TR_String(xtur) == tur {
            TR_if xt == "tool_start" { çağrılar.TR_append(TR_String(v["call_id"])) }
            TR_continue
        }
        TR_if xt == "tool_end" TR_and çağrılar.TR_contains(TR_String(v["call_id"])) { TR_continue }
        kalan.TR_append(x)
    }
    TR_return kalan
}

# ---------- HTTP ----------

# ekran_klasörü: index.html'in klasörü, bu modülün klasörü. Okuyan yerleşikler göreli yolu önce çalışma klasöründe,
# sonra modülün klasöründe arar (13.1a); modülün kendi adı çalışma klasöründe bulunmaz (program proje kökünden ya
# da bu klasörden açılır).
TR_func ekran_klasörü() -> TR_String { TR_return TR_String(TR_Path("ekran.tr").TR_absolute.TR_parent) }

# ekran_aç: sunucuyu 127.0.0.1'de açar. Belirteci sunucu denetler (28.2): sayfa ve dil dosyaları belirteçsizdir
# (`TR_tokenless_paths:`; tarayıcı adres çubuğundan açtığı sayfaya `Authorization` ekleyemez), akış ve komut belirteç ister.
TR_func ekran_aç(e: Ekran, kapı: TR_Int, belirteç: TR_String) -> TR_HTTPServer {
    TR_var açık = ["/"] + ["/lang/" + d + ".js" TR_for d TR_in e.diller]
    TR_func cevapla(istek: TR_Request) -> TR_Response { TR_return ekran_cevabı(e, istek) }
    TR_return TR_serve_http(cevapla, TR_port: kapı, TR_token: belirteç, TR_tokenless_paths: açık, TR_max_body_bytes: 65536)
}

# ekran_adresi: tarayıcıda açılacak adres. Sorgusuzdur: ekranın kaynağı sayfanın kendi köküdür (contract.md, "Kaynak");
# sorgulu istek belirteçsiz yolda da belirteç ister (28.2).
TR_func ekran_adresi(s: TR_HTTPServer) -> TR_String { TR_return "http://127.0.0.1:\(s.TR_port)/" }

# ekran_cevabı: sunucunun işleyicisi; belirteci sunucu denetlemiştir.
TR_func ekran_cevabı(e: Ekran, istek: TR_Request) -> TR_Response {
    TR_var yol = istek.TR_path
    TR_if istek.TR_method == "GET" TR_and yol == "/" { TR_return dosya(e, "/index.html", {"Content-Security-Policy": _CSP}) }
    TR_if istek.TR_method == "GET" TR_and yol.TR_starts_with("/lang/") TR_and yol.TR_ends_with(".js") {
        TR_if e.diller.TR_contains(yol[6..yol.TR_length - 3]) { TR_return dosya(e, yol, {}) }
    }
    TR_var akış = istek.TR_method == "GET" TR_and yol == "/events"
    TR_var komut = istek.TR_method == "POST" TR_and yol == "/command"
    TR_if TR_not akış TR_and TR_not komut { TR_return TR_Response(TR_status: 404, TR_headers: {"Cache-Control": "no-store"}) }
    TR_if akış { TR_return e.yayın.TR_subscribe(istek) }
    TR_return komut_al(e, istek)
}

# dosya: kökteki dosya, `Cache-Control: no-store` ve verilen başlıklarla.
TR_func dosya(e: Ekran, yol: TR_String, ek: TR_Dict[TR_String, TR_String]) -> TR_Response {
    TR_var c = TR_file_response(e.kök, yol)
    TR_var başlıklar = {"Content-Type": c.TR_headers["Content-Type"], "Cache-Control": "no-store"}
    TR_for ad TR_in ek { başlıklar[ad] = ek[ad] }
    TR_return TR_Response(TR_status: c.TR_status, TR_body: c.TR_body, TR_headers: başlıklar)
}

TR_func kabul(kimlik: TR_String) -> TR_JSON { TR_return TR_JSON({"v": _SÜRÜM, "command_id": kimlik, "status": "accepted"}) }

TR_func red(kimlik: TR_String, kod: TR_String, değerler: TR_JSON) -> TR_JSON {
    TR_return TR_JSON({"v": _SÜRÜM, "command_id": kimlik, "status": "rejected", "error": {"code": kod, "values": değerler}})
}

TR_func ret(durum: TR_Int, kimlik: TR_String, kod: TR_String, değerler: TR_JSON) -> TR_Response {
    TR_return TR_Response(TR_status: durum, TR_json: red(kimlik, kod, değerler), TR_headers: {"Cache-Control": "no-store"})
}

# komut_al: `POST /command`. Biçimi işleyici denetler (durum okumaz); kararı ana döngü verir.
TR_func komut_al(e: Ekran, istek: TR_Request) -> TR_Response {
    TR_var tür = istek.TR_headers.TR_get("Content-Type")
    TR_if tür == TR_none TR_or tür.TR_split(";")[0].TR_strip().TR_lower() != "application/json" {
        TR_return ret(415, "", "unsupported_media_type", TR_JSON({}))
    }
    TR_var j = TR_JSON(TR_none)
    TR_try { j = TR_json_parse(TR_String(istek.TR_body)) } TR_catch hata { TR_return ret(400, "", "bad_request", TR_JSON({})) }
    TR_if TR_not nesne(j) { TR_return ret(400, "", "bad_request", TR_JSON({})) }
    TR_var kimlik = j.TR_get("command_id")
    TR_if kimlik == TR_none TR_or TR_Type(kimlik) != TR_String TR_or TR_String(kimlik) == "" TR_or TR_String(kimlik).TR_length > 128 {
        TR_return ret(400, "", "bad_request", TR_JSON({}))
    }
    TR_var k = TR_String(kimlik)
    TR_var v = j.TR_get("v")
    TR_if v == TR_none TR_or TR_Type(v) != TR_Int TR_or TR_Int(v) != _SÜRÜM {
        TR_return ret(400, k, "unsupported_version", TR_JSON({"version": TR_if v == TR_none { "" } TR_else { TR_json_string(v) }}))
    }
    TR_var t = j.TR_get("type")
    TR_var veri = j.TR_get("data")
    TR_if t == TR_none TR_or TR_Type(t) != TR_String { TR_return ret(400, k, "bad_request", TR_JSON({})) }
    TR_var ad = TR_String(t)
    TR_if TR_not ["send_text", "mic_set", "approval_answer", "stop"].TR_contains(ad) {
        TR_return ret(400, k, "unknown_command", TR_JSON({"type": ad}))
    }
    TR_var d = TR_if veri == TR_none { TR_JSON({}) } TR_else { veri }
    TR_if TR_not geçerli(ad, d) { TR_return ret(400, k, "bad_request", TR_JSON({})) }
    TR_var c = Komut(kimlik: k, tür: ad, veri: d)
    e.bekleyen.TR_append(c)
    TR_for c.cevap == TR_none { TR_sleep(_CEVAP_BEKLEMESİ) }
    TR_return TR_Response(TR_json: c.cevap, TR_headers: {"Cache-Control": "no-store"})
}

# geçerli: komutun `data`'sı sözleşmedeki alanları taşıyor mu.
TR_func geçerli(ad: TR_String, d: TR_JSON) -> TR_Bool {
    TR_if TR_not nesne(d) { TR_return TR_false }
    TR_var alan = TR_match ad {
        "send_text" => "text"
        "mic_set" => "on"
        "approval_answer" => "approval_id"
        _ => ""
    }
    TR_if alan == "" { TR_return TR_true }
    TR_var x = d.TR_get(alan)
    TR_if x == TR_none { TR_return TR_false }
    TR_if ad == "mic_set" { TR_return TR_Type(x) == TR_Bool }
    TR_return TR_Type(x) == TR_String
}

# komutları_işle: bekleyen komutları sırayla cevaplar (ana döngü). Aynı `command_id` yeniden gelirse iş yinelenmez,
# ilk cevap döner; son 1024 kimlik tutulur.
TR_func komutları_işle(e: Ekran) {
    TR_for e.bekleyen.TR_length > 0 {
        TR_var k = e.bekleyen.TR_remove_at(0)
        TR_var önceki = e.cevaplar.TR_get(k.kimlik)
        TR_if önceki != TR_none {
            k.cevap = önceki
            TR_continue
        }
        TR_var c = karar(e, k)
        e.cevaplar[k.kimlik] = c
        e.sıra.TR_append(k.kimlik)
        TR_if e.sıra.TR_length > _TUTULAN_KOMUT { e.cevaplar.TR_remove(e.sıra.TR_remove_at(0)) }
        k.cevap = c
    }
}

# karar: bir komutun cevabı ve etkisi. Etkiyi ana döngü uygular: metin turu (`metin`), mikrofon (`mikrofon_istendi`),
# durdurma (`durdur`).
TR_func karar(e: Ekran, k: Komut) -> TR_JSON {
    TR_match k.tür {
        "send_text" => {
            TR_if TR_not e.hazır { TR_return red(k.kimlik, "not_ready", TR_JSON({})) }
            TR_if e.tur != "" { TR_return red(k.kimlik, "turn_busy", TR_JSON({"turn_id": e.tur})) }
            TR_if e.metin != TR_none { TR_return red(k.kimlik, "turn_busy", TR_JSON({"turn_id": e.metin_turu})) }
            TR_var m = TR_String(k.veri["text"])
            TR_if TR_Bytes(m).TR_length > _METİN_SINIRI { TR_return red(k.kimlik, "text_too_long", TR_JSON({"limit_bytes": _METİN_SINIRI})) }
            e.metin_turu = e.yeni_tur()
            e.metin = m
        }
        "mic_set" => { e.mikrofon_istendi = TR_Bool(k.veri["on"]) }
        "stop" => { TR_if e.tur != "" { e.durdur = TR_true } }
        "approval_answer" => { TR_return red(k.kimlik, "unknown_approval", TR_JSON({"approval_id": k.veri["approval_id"]})) }
        _ => { TR_return red(k.kimlik, "unknown_command", TR_JSON({"type": k.tür})) }
    }
    TR_return kabul(k.kimlik)
}

# metni_al: kabul edilmiş, henüz açılmamış metin turunu alır ve kabulde verilen kimliği süren tur yapar; yoksa
# TR_none. Arada aynı çerçevede sesli bir tur açılıp bitmiş olabilir (`e.tur` onunkiydi), metin kendi kimliğiyle koşar.
TR_func metni_al(e: Ekran) -> TR_String? {
    TR_var m = e.metin
    TR_if m != TR_none {
        e.metin = TR_none
        e.tur = e.metin_turu
        e.metin_turu = ""
    }
    TR_return m
}

# ---------- Tur ----------

# TurUçları: ekranlı bir turun zincire bağlandığı yerler. `iş` görevde koşar; öbürleri bekleyen taraftadır.
TR_struct TurUçları {
    iş: (Yazıcı) -> TR_String? # turun kendisi: cevabın içeriği, söz boşsa TR_none
    bitti: () -> TR_NoneType # normal dönüş (ölçü satırı)
    geri_al: () -> TR_NoneType # iptal ya da hata: geçmiş, önbellek
    ölçüler: () -> TR_JSON # `metrics`'in verisi
    çalıyor: () -> TR_Bool # ilk çalma başladı mı
    aralık: () -> ÇalmaAralığı # turun çalma aralığı
    işle: () -> TR_NoneType # ana döngünün komutlara bakışı
    bitiş: (TR_String, TR_String) -> TR_NoneType = (_, _) => {} # `turn_end`'den sonra bir kez, nedeni (done, stopped, error) ve hatanın koduyla (yoksa ""): deneme kaydı
}

# tur_yürüt: süren turu (`e.tur`) bir görevde koşar, beklerken komutları işler; `stop` görevi iptal eder (10.9).
# `turn_end`, `metrics` ve geri alma yalnız burada, görevin sonucuna bağlı yazılır: normal dönüş `done`, iptal
# (H2920) `stopped`, başka hata `error`. Çalma aralığını verir; iptal ya da hatada aralık şimdiye uzar (kesilen
# çalmanın yankısı yeni tur açmaz).
TR_func tur_yürüt(e: Ekran, kaynak: TR_String, u: TurUçları) -> ÇalmaAralığı {
    TR_var tur = e.tur
    e.gönder("turn_start", TR_JSON({"turn_id": tur, "source": kaynak}))
    e.durum("thinking")
    TR_var y = Yazıcı(e: e, tur: tur)
    TR_var g = TR_async u.iş(y)
    TR_var konuşuyor = TR_false
    TR_for TR_not g.TR_done() {
        u.işle()
        TR_if e.durdur { g.TR_cancel() }
        TR_if TR_not konuşuyor TR_and u.çalıyor() {
            konuşuyor = TR_true
            e.durum("speaking")
        }
        TR_sleep(_TUR_BAKIŞI)
    }
    TR_var neden = "done"
    TR_var kod = ""
    TR_var içerik: TR_String? = TR_none
    TR_try {
        içerik = g.TR_wait()
    } TR_catch hata {
        neden = TR_if hata.TR_code == "H2920" { "stopped" } TR_else { "error" }
        TR_if neden == "error" {
            TR_print("TUR HATASI:", hata)
            kod = hata.TR_code
        }
    }
    TR_var a = u.aralık()
    TR_if neden == "done" {
        TR_if içerik != TR_none { y.bitir(içerik) }
        u.bitti()
        e.gönder("turn_end", TR_JSON({"turn_id": tur, "reason": "done"}))
        e.gönder("metrics", u.ölçüler())
    } TR_else {
        u.geri_al()
        TR_var son = TR_JSON({"turn_id": tur, "reason": neden})
        TR_if neden == "error" { son = TR_JSON({"turn_id": tur, "reason": neden, "error": {"code": "internal", "values": {}}}) }
        e.gönder("turn_end", son)
        TR_if a.başı >= 0 { a = ÇalmaAralığı(başı: a.başı, sonu: TR_max(a.sonu, şimdi())) }
    }
    u.bitiş(neden, kod)
    e.tur = ""
    e.durdur = TR_false
    e.boşta()
    TR_return a
}

# Yazıcı: bir turun ekrana giden metni. Cevap her adımda baştan çözülür (16.3a'nın akışlı çözmesi yok): ekrana
# yalnız öncekinin uzantısı olan kısım gider; sondaki yarım karakter (U+FFFD) ve bir düşünce ya da araç etiketinin
# olası başı tutulur, tamamlanmış etiket akışı durdurur. Önce uzantı ham metinde bulunur, sonra maske akışından
# geçer (19.4a). Çözüm öncekinin uzantısı değilse `replace` gider ve maske akışı yeniden kurulur. Turun sonunda
# verilen ham metin içerikten ayrıysa son bir `replace` içeriği yazar: ekrandaki son metin geçmişe yazılan içeriktir.
TR_struct Yazıcı {
    e: Ekran
    tur: TR_String
    ham: TR_String = "" # ekrana verilen ham metin (maskeden önce)
    maske: TR_MaskStream = TR_mask_stream()
    durdu: TR_Bool = TR_false

    TR_func söz(m: TR_String) {
        TR_self.e.gönder("turn_text", TR_JSON({"turn_id": TR_self.tur, "role": "user", "mode": "replace", "text": m, "final": TR_true}))
    }

    TR_func ilerle(metin: TR_String) {
        TR_if TR_self.durdu { TR_return }
        TR_var aday, etiketli = gösterilebilir(metin)
        TR_if etiketli { TR_self.durdu = TR_true }
        TR_if aday.TR_starts_with(TR_self.ham) {
            TR_var ek = aday[TR_self.ham.TR_length..aday.TR_length]
            TR_if ek == "" { TR_return }
            TR_self.ham = aday
            TR_self.gönder("append", TR_self.maske.TR_step(ek))
            TR_return
        }
        TR_self.maske = TR_mask_stream()
        TR_self.ham = aday
        TR_self.e.gönder("turn_text", TR_JSON({"turn_id": TR_self.tur, "role": "assistant", "mode": "replace", "text": TR_self.maske.TR_step(aday)}))
    }

    TR_func gönder(kip: TR_String, parça: TR_String) {
        TR_if parça == "" { TR_return }
        TR_self.e.gönder("turn_text", TR_JSON({"turn_id": TR_self.tur, "role": "assistant", "mode": kip, "text": parça}))
    }

    TR_func bitir(içerik: TR_String) {
        TR_self.gönder("append", TR_self.maske.TR_finish())
        TR_if TR_self.ham != içerik {
            TR_var m = TR_mask_stream()
            TR_var maskeli = m.TR_step(içerik) + m.TR_finish()
            TR_self.e.gönder("turn_text", TR_JSON({"turn_id": TR_self.tur, "role": "assistant", "mode": "replace", "text": maskeli}))
        }
    }
}

# gösterilebilir: baştan çözülmüş metnin ekrana gidebilecek başı ve tamamlanmış bir etiket görülüp görülmediği.
# Etiketin kendisi ve sonrası gitmez; sondaki U+FFFD'ler ve bir etiketin olası başı (`<th`, `<to`, yalnız `<`) tutulur.
TR_func gösterilebilir(metin: TR_String) -> (TR_String, TR_Bool) {
    TR_var m = metin
    TR_var etiketli = TR_false
    TR_for et TR_in _ETİKETLER {
        TR_var i = m.TR_index_of(et)
        TR_if i != TR_none {
            m = m[0..i]
            etiketli = TR_true
        }
    }
    TR_var n = m.TR_length
    TR_for n > 0 TR_and m[n - 1] == "\u{FFFD}" { n -= 1 }
    m = m[0..n]
    TR_var tut = 0
    TR_for et TR_in _ETİKETLER {
        TR_for k TR_in 1..et.TR_length {
            TR_if k > tut TR_and m.TR_ends_with(et[0..k]) { tut = k }
        }
    }
    TR_return m[0..m.TR_length - tut], etiketli
}

# belirteç_yaz: yeni bir belirteç (28.2a) ve onu yalnız sahibinin okuyabileceği dosyaya yazar (18.13); belirtecin
# kendisi hiçbir yere yazılmaz (standart çıktı, günlük, URL), program yalnız dosyanın yolunu söyler.
TR_func belirteç_yaz(dosya: TR_String) -> TR_String {
    TR_var b = TR_secret_token()
    TR_write_file(dosya, b, TR_owner_only: TR_true)
    TR_return b
}

# nesne: JSON değeri bir nesne mi.
TR_func nesne(j: TR_JSON) -> TR_Bool { TR_return TR_Type(j) == TR_Type(TR_JSON({})) }
