# TR 4
# Dost'un ayar dosyası (tek tık kurulumu): yolu, okunması, yazılması ve kurulumun işi (`kur`). Denetim katalog.tr'nin
# `ayar_denetle`'sidir: okunan her ayar ondan geçer. Bu modül katalog.tr'yi aktarır; katalog.tr bunu aktarmaz (döngü
# yok, 11.3). kur.tr komut olarak kullanır, asistan.tr ayarı okur; katalog_test.tr sınar (README, "Kurulum").

TR_import "katalog"

# ayar_yolu: `--ayar` verildiyse o; yoksa %LOCALAPPDATA%\Dost\ayar.json; değişken yoksa H8172 (yer uydurulmaz,
# işletim sistemi sorulmaz). `yer` TR_env("LOCALAPPDATA")'dır; test onu verir.
TR_func ayar_yolu(verilen: TR_String, yer: TR_String?) -> TR_String {
    TR_if verilen != "" { TR_return verilen }
    TR_var y = yer ?? ""
    TR_if y == "" { TR_throw TR_Message("H8172") }
    TR_return TR_String(TR_Path(y, "Dost", "ayar.json"))
}

# ayar_oku: ayar dosyası yoksa ilk kurulumdur (TR_none); varsa bütünü denetlenir (`ayar_denetle`). Kesilmiş bir
# yazmadan kalan `<yol>.tmp` okunmaz.
TR_func ayar_oku(yol: TR_String, k: Katalog) -> Ayar? {
    TR_if TR_not TR_Path(yol).TR_exists { TR_return TR_none }
    TR_return ayar_denetle(yol, dosya_oku(yol, "ayar"), k)
}

# ayar_dosyasına_yaz: ayar dosyasını yazar: geçici adla (`<yol>.tmp`), sonra son adına taşıyarak; ortada kesilen yazma
# eski ayarı bozmaz, kalan `.tmp`'yi sonraki yazma ezer. Klasör yoksa kurulur. JSON'u denetlemez: yazan taraf denetler.
TR_func ayar_dosyasına_yaz(yol: TR_String, j: TR_JSON) {
    TR_var p = TR_Path(yol)
    TR_if TR_not p.TR_parent.TR_exists { TR_make_dir(p.TR_parent) }
    TR_var geçici = "\(yol).tmp"
    TR_write_file(geçici, TR_json_string(j) + "\n")
    TR_move(geçici, yol, TR_overwrite: TR_true)
}

# ayar_yaz: öneriyi ayar olarak yazar (`ayar_dosyasına_yaz`). Var olan ayarın dili, sistem iletisi, bağlamı ve kapısı
# korunur.
TR_func ayar_yaz(yol: TR_String, k: Katalog, ayar: Ayar?, dil_modeli: TR_String, toplam: TR_Int, bağlam: TR_Int) {
    TR_var dil = k.diller[0].kod
    TR_var sistem: TR_JSON = {"source": "catalog"}
    TR_var kapı = ÖNTANIMLI_KAPI
    TR_var a = ayar
    TR_if a != TR_none {
        dil = a.konuşma_dili
        sistem = a.sistem
        kapı = a.kapı
    }
    TR_var j: TR_JSON = {"v": SÜRÜM, "language_model": dil_modeli, "speech_language": dil, "system_prompt": sistem,
        "context": bağlam, "device": "cpu", "port": kapı, "machine": {"memory_bytes": toplam, "memory_source": "option"}}
    ayar_dosyasına_yaz(yol, j)
}

# kur: kur.tr'nin bütün işi; çıktı satırlarını verir (S3'ün biçimi, satırdaki değerler ASCII). `yaz` yoksa ayar
# dosyasına dokunulmaz.
TR_func kur(katalog_yolu: TR_String, ayar_verilen: TR_String, yer: TR_String?, toplam: TR_Int, bağlam_verilen: TR_Int?,
        yaz: TR_Bool) -> TR_List[TR_String] {
    TR_var k = katalog_oku(katalog_yolu)
    TR_var yol = ayar_yolu(ayar_verilen, yer)
    TR_var a = ayar_oku(yol, k)
    TR_var bağlam = bağlam_belirle(k, bağlam_verilen, a)
    TR_var l = uygunluk(k, a, toplam, bağlam)
    TR_var satırlar = ["MAKINE toplam_bayt=\(toplam) kaynak=elle baglam=\(bağlam)"]
    TR_for u TR_in l {
        TR_if u.uyum == "too_long" {
            satırlar.TR_append("UYGUNLUK \(u.kimlik) too_long baglam_siniri=\(u.sınır)")
            TR_continue
        }
        TR_var ölçü = TR_if u.ölçülü { "olculdu" } TR_else { "hesap" }
        satırlar.TR_append("UYGUNLUK \(u.kimlik) \(u.uyum) gereken_bayt=\(u.gereken) esik_bayt=\(u.eşik) olcu=\(ölçü)")
    }
    TR_var ö = öneri(l)
    TR_var sıkı = ""
    TR_for u TR_in l {
        TR_if u.kimlik == ö TR_and u.uyum == "tight" { sıkı = " fit=tight" }
    }
    satırlar.TR_append(TR_if ö == "" { "ONERILEN yok" } TR_else { "ONERILEN \(ö)\(sıkı)" })
    TR_if yaz TR_and ö != "" {
        ayar_yaz(yol, k, a, ö, toplam, bağlam)
        satırlar.TR_append("AYAR_YAZILDI \(yol)")
    }
    TR_return satırlar
}
