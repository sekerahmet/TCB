# TR 4
# Dost'un ayar dosyası (tek tık kurulumu): yolu, okunması, yazılması, bağlamın seçimi ve kurulumun işi (`kur`). Denetim katalog.tr'nin
# `ayar_denetle`'sidir: okunan her ayar ondan geçer. Bu modül katalog.tr'yi aktarır; katalog.tr bunu aktarmaz (döngü
# yok, 11.3). kur.tr komut olarak kullanır, asistan.tr ayarı okur; katalog_test.tr ve ayarlar_test.tr sınar (README, "Kurulum").

TR_import "katalog"

# ayar_yolu: `--ayar` verildiyse o; yoksa %LOCALAPPDATA%\Dost\ayar.json; değişken yoksa H8172 (yer uydurulmaz,
# işletim sistemi sorulmaz). `yer` TR_env("LOCALAPPDATA")'dır; test onu verir.
TR_func ayar_yolu(verilen: TR_String, yer: TR_String?) -> TR_String {
    TR_if verilen != "" { TR_return verilen }
    TR_var y = yer ?? ""
    TR_if y == "" { TR_throw TR_Message("H8172") }
    TR_return TR_String(TR_Path(y, "Dost", "ayar.json"))
}

# ayar_oku: ayar dosyası yoksa ilk kurulumdur (TR_none); varsa bütünü denetlenir (`ayar_denetle`). Kesilmiş bir
# yazmadan kalan `<yol>.tmp` okunmaz.
TR_func ayar_oku(yol: TR_String, k: Katalog) -> Ayar? {
    TR_if TR_not TR_Path(yol).TR_exists { TR_return TR_none }
    TR_return ayar_denetle(yol, dosya_oku(yol, "ayar"), k)
}

# ayar_dosyasına_yaz: ayar dosyasını yazar: geçici adla (`<yol>.tmp`), sonra son adına taşıyarak; ortada kesilen yazma
# eski ayarı bozmaz, kalan `.tmp`'yi sonraki yazma ezer. Klasör yoksa kurulur. JSON'u denetlemez: yazan taraf denetler.
TR_func ayar_dosyasına_yaz(yol: TR_String, j: TR_JSON) {
    TR_var p = TR_Path(yol)
    TR_if TR_not p.TR_parent.TR_exists { TR_make_dir(p.TR_parent) }
    TR_var geçici = "\(yol).tmp"
    TR_write_file(geçici, TR_json_string(j) + "\n")
    TR_move(geçici, yol, TR_overwrite: TR_true)
}

# ayarı_değiştir: ayar dosyasının tek alanını değiştirir (ekranın `settings_set`'i ve kullanıcının `model_load`'u):
# dosya yeniden okunur, yalnız `anahtar` değişir, öbür alanlar olduğu gibi kalır; yeni JSON `ayar_denetle`'den geçer
# (okunamayacak dosya yazılmaz), sonra `ayar_dosyasına_yaz` ile yazılır. Okuma, denetim ya da yazma hatası çağırana
# gider; o zaman dosya değişmemiştir. Yazılan JSON'u verir.
TR_func ayarı_değiştir(yol: TR_String, k: Katalog, anahtar: TR_String, değer: TR_JSON) -> TR_JSON {
    TR_var d = TR_Dict(dosya_oku(yol, "ayar"))
    d[anahtar] = değer
    TR_var j = TR_JSON(d)
    ayar_denetle(yol, j, k)
    ayar_dosyasına_yaz(yol, j)
    TR_return j
}

# kart_özeti: makinenin ilk kartının özeti (`machine.gpu`): adı, belleği, sürücü sürümü (15.37a) ve `@`'nin yolu;
# kart yoksa TR_none. Kitaplığın sürümü TR'de okunamıyor, yazılmaz (tasarım dost-sohbet-gpu, defter 4).
TR_func kart_özeti() -> TR_JSON? {
    TR_if TR_not TR_devices().TR_contains("gpu:0") { TR_return TR_none }
    TR_var b = TR_device_info("gpu:0")
    TR_return TR_JSON({"name": b.TR_name, "memory_bytes": b.TR_memory_total_bytes, "driver_version": b.TR_driver_version, "matmul": "vendor"})
}

# ayar_çakışıyor: `değer` ayar dosyasının (`v`, `ayar_olayı`'nın verisi) öbür alanıyla birlikte geçersiz mi: kart yokken
# `device` `gpu`; ayarda `quantized_activations` `on` iken `device` `gpu`; ayarda `device` `gpu` iken
# `quantized_activations` `on` (nicemli etkinleştirme yalnız işlemcide, 15.53a). İkisi de bir sonraki açılışta geçerlidir.
TR_func ayar_çakışıyor(v: TR_Dict[TR_String, TR_JSON]?, anahtar: TR_String, değer: TR_JSON) -> TR_Bool {
    TR_var nicemli = ""
    TR_var cihaz = ""
    TR_if v != TR_none {
        TR_if v.TR_get("quantized_activations") != TR_none { nicemli = TR_String(v["quantized_activations"]) }
        cihaz = TR_String(v["device"])
    }
    TR_if anahtar == "device" TR_and TR_String(değer) == "gpu" { TR_return kart_özeti() == TR_none TR_or nicemli == "on" }
    TR_return anahtar == "quantized_activations" TR_and TR_String(değer) == "on" TR_and cihaz == "gpu"
}

# kart_belleği: ilk kartın belleği; kart yoksa 0 (`öntanımlı_cihaz`, katalog.tr).
TR_func kart_belleği() -> TR_Int {
    TR_var k = kart_özeti()
    TR_return TR_if k == TR_none { 0 } TR_else { TR_Int(k["memory_bytes"]) }
}

# ayar_yaz: öneriyi ayar olarak yazar (`ayar_dosyasına_yaz`). Var olan ayarın dil modeli, dili, sistem iletisi, kapısı,
# cihazı ve isteğe bağlı alanları (`microphone`, `recording`, `quantized_activations`, `chat_only`, `voices`) korunur: kur.tr'nin
# yeniden koşusu kullanıcının seçimini öntanımlıya ya da öneriye döndürmez (N'nin Bulgu 1'i; dil modeli Dost katalog
# K-1, TCB 22:49). Ayar yoksa dil modeli `dil_modeli` (öneri), cihaz `cihaz`'dır; cihaz `gpu` ise `machine.gpu`
# kartın özetidir (`kart`).
TR_func ayar_yaz(yol: TR_String, k: Katalog, ayar: Ayar?, dil_modeli: TR_String, toplam: TR_Int, bağlam: TR_Int,
    cihaz: TR_String = "cpu", kart: TR_JSON? = TR_none) {
    TR_var lm = dil_modeli
    TR_var dil = k.diller[0].kod
    TR_var sistem: TR_JSON = {"source": "catalog"}
    TR_var kapı = ÖNTANIMLI_KAPI
    TR_var c = cihaz
    TR_var a = ayar
    TR_if a != TR_none {
        lm = a.dil_modeli
        dil = a.konuşma_dili
        sistem = a.sistem
        kapı = a.kapı
        c = a.cihaz
    }
    TR_var makine: TR_Dict[TR_String, TR_JSON] = {"memory_bytes": TR_JSON(toplam), "memory_source": TR_JSON("option")}
    TR_if c == "gpu" TR_and kart != TR_none { makine["gpu"] = kart }
    TR_var d: TR_Dict[TR_String, TR_JSON] = {"v": TR_JSON(SÜRÜM), "language_model": TR_JSON(lm), "speech_language": TR_JSON(dil),
        "system_prompt": sistem, "context": TR_JSON(bağlam), "device": TR_JSON(c), "port": TR_JSON(kapı),
        "machine": TR_JSON(makine)}
    TR_if a != TR_none {
        TR_if a.mikrofon != "" { d["microphone"] = TR_JSON(a.mikrofon) }
        TR_if a.kayıt { d["recording"] = TR_JSON(TR_true) }
        TR_var n = a.nicemli
        TR_if n != TR_none { d["quantized_activations"] = TR_JSON(n) }
        TR_if a.yalnız_sohbet { d["chat_only"] = TR_JSON(TR_true) }
        TR_if a.sesler.TR_length > 0 { d["voices"] = TR_JSON(a.sesler) }
    }
    ayar_dosyasına_yaz(yol, TR_JSON(d))
}

# kur: kur.tr'nin bütün işi; çıktı satırlarını verir (S3'ün biçimi, satırdaki değerler ASCII). `yaz` yoksa ayar
# dosyasına dokunulmaz.
TR_func kur(katalog_yolu: TR_String, ayar_verilen: TR_String, yer: TR_String?, toplam: TR_Int, bağlam_verilen: TR_Int?,
    yaz: TR_Bool) -> TR_List[TR_String] {
        TR_var k = katalog_oku(katalog_yolu)
        TR_var yol = ayar_yolu(ayar_verilen, yer)
        TR_var a = ayar_oku(yol, k)
        TR_var bağlam = bağlam_belirle(k, bağlam_verilen, a)
        TR_var l = uygunluk(k, a, toplam, bağlam)
        TR_var satırlar = ["MAKINE toplam_bayt=\(toplam) kaynak=elle baglam=\(bağlam)"]
        TR_for u TR_in l {
            TR_if u.uyum == "too_long" {
                satırlar.TR_append("UYGUNLUK \(u.kimlik) too_long baglam_siniri=\(u.sınır)")
                TR_continue
            }
            TR_var ölçü = TR_if u.ölçülü { "olculdu" } TR_else { "hesap" }
            satırlar.TR_append("UYGUNLUK \(u.kimlik) \(u.uyum) gereken_bayt=\(u.gereken) esik_bayt=\(u.eşik) olcu=\(ölçü)")
        }
        TR_var ö = öneri(l)
        TR_var sıkı = ""
        TR_for u TR_in l {
            TR_if u.kimlik == ö TR_and u.uyum == "tight" { sıkı = " fit=tight" }
        }
        satırlar.TR_append(TR_if ö == "" { "ONERILEN yok" } TR_else { "ONERILEN \(ö)\(sıkı)" })
        TR_if yaz TR_and ö != "" {
            TR_var kart = kart_özeti()
            TR_var b = TR_if kart == TR_none { 0 } TR_else { TR_Int(kart["memory_bytes"]) }
            ayar_yaz(yol, k, a, ö, toplam, bağlam, öntanımlı_cihaz(k, a, ö, bağlam, b), kart)
            satırlar.TR_append("AYAR_YAZILDI \(yol)")
        }
        TR_return satırlar
    }

# bağlam_oku: komut satırının `--bağlam` metni; sayı değilse H8173.
TR_func bağlam_oku(metin: TR_String) -> TR_Int {
    TR_var n = 0
    TR_try { n = TR_Int(metin) } TR_catch _e { TR_throw TR_Message("H8173", metin) }
    TR_return n
}

# bağlam_seç: `--bağlam` verildiyse o (0 ya da eksi H8173: sessizce 8192 alınmaz), yoksa ayarın `context`'i, yoksa
# 8192. "Verilmedi" yalnız seçeneğin hiç yazılmamasıdır (`TR_none`; tasarımın defteri 58).
TR_func bağlam_seç(verilen: TR_Int?, ayar: Ayar?) -> TR_Int {
    TR_var v = verilen
    TR_if v != TR_none {
        TR_if v <= 0 { TR_throw TR_Message("H8173", "\(v)") }
        TR_return v
    }
    TR_var a = ayar
    TR_if a != TR_none { TR_return a.bağlam }
    TR_return ÖNTANIMLI_BAĞLAM
}

# bağlam_sınırı: dil modelinin `context_max`'ı; model katalogda yoksa (seçili değilse) dil modellerinin en büyüğü;
# katalogda dil modeli yoksa 0 (Dost katalog K-9: ekranın sınırı seçili modelinkidir).
TR_func bağlam_sınırı(k: Katalog, dil_modeli: TR_String) -> TR_Int {
    TR_var en = 0
    TR_for g TR_in k.girdiler {
        TR_if g.tür != "language_model" { TR_continue }
        TR_if g.kimlik == dil_modeli { TR_return g.bağlam_sınırı }
        TR_if g.bağlam_sınırı > en { en = g.bağlam_sınırı }
    }
    TR_return en
}

# bağlam_belirle: bağlam_seç'in değeri, dil modellerinin en büyük `context_max`'ıyla sınırlı (tasarımın defteri 62,
# 63). `--bağlam` ya da ayarın `context`'i bütün sınırları aşarsa H8174 (`source` `option`, `setting`); öntanımlı
# 8192 en büyük sınıra iner, hata vermez. Seçili modelin sınırını aşan bağlam açılışta hata değildir: önbellek
# yüklenen modelin sınırıyla kurulur (yuva.tr, `önbellek_bağlamı`).
TR_func bağlam_belirle(k: Katalog, verilen: TR_Int?, ayar: Ayar?) -> TR_Int {
    TR_var b = bağlam_seç(verilen, ayar)
    TR_var en = bağlam_sınırı(k, "")
    TR_if b <= en { TR_return b }
    TR_if verilen != TR_none { TR_throw TR_Message("H8174", "option", b, en) }
    TR_if ayar != TR_none { TR_throw TR_Message("H8174", "setting", b, en) }
    TR_return en
}
