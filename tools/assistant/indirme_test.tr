# TR 4
# İndirme yöneticisinin modelsiz sınaması (indirme.tr; tek tık D). Dosyalar 127.0.0.1'deki TR sunucusundan iner (28.11'in
# tek http istisnası); adres katalogdan değil, `İndirici`'nin `adres`'inden gelir. Katalog elle kurulur: dosyalar birkaç
# baytlık metin, sha256'ları içeriğinden.
TR_import "katalog"
TR_import "yuva"
TR_import "indirme"
TR_import "ekran"
TR_import "screen_helpers"
TR_import "zincir"
TR_import "oturum"

TR_const _REV = "1111111111111111111111111111111111111111"
TR_const _YENİ_REV = "2222222222222222222222222222222222222222"

# Sunucunun içeriği: yol (katalogun `path`'i) → gövde. `_yavaşlar`daki yol cevaptan önce bekler; `_aralıklar` `Range`'li
# isteklerin sayısıdır.
TR_var _içerik: TR_Dict[TR_String, TR_String] = {}
TR_var _yavaşlar: TR_List[TR_String] = []
TR_var _aralıklar = 0

TR_func cevapla(istek: TR_Request) -> TR_Response {
    TR_var yol = istek.TR_path[1..istek.TR_path.TR_length]
    TR_if _yavaşlar.TR_contains(yol) { TR_sleep(3.0) }
    TR_var m = _içerik.TR_get(yol)
    TR_if m == TR_none { TR_return TR_Response(TR_status: 404) }
    TR_var r = istek.TR_headers.TR_get("Range")
    TR_if r == TR_none { TR_return TR_Response(TR_body: m) }
    _aralıklar += 1
    TR_var baş = TR_Int(r["bytes=".TR_length..r.TR_length - 1])
    TR_return TR_Response(TR_status: 206, TR_headers: {"Content-Range": "bytes \(baş)-\(m.TR_length - 1)/\(m.TR_length)"}, TR_body: m[baş..m.TR_length])
}

TR_func _sha(m: TR_String) -> TR_String { TR_return TR_sha256(TR_Bytes(m)) }

# _değiş: katalogun JSON yazımında `eski`'nin yerine `yeni` (sınamanın değiştirilmiş katalogu).
TR_func _değiş(kj: TR_JSON, eski: TR_String, yeni: TR_String) -> TR_JSON {
    TR_var m = TR_json_string(kj)
    TR_assert(m.TR_contains(eski), "katalogda yok: \(eski)")
    TR_return TR_json_parse(m.TR_replace(eski, yeni))
}

# _dosya: katalogun bir dosyası; içerik sunucuya `<kimlik>/<target>` yolunda konur.
TR_func _dosya(kimlik: TR_String, target: TR_String, içerik: TR_String) -> TR_JSON {
    _içerik["\(kimlik)/\(target)"] = içerik
    TR_return TR_JSON({"path": "\(kimlik)/\(target)", "target": target, "bytes": TR_Bytes(içerik).TR_length, "sha256": _sha(içerik)})
}

TR_func _girdi(kimlik: TR_String, tür: TR_String, dosyalar: TR_List[TR_JSON]) -> TR_JSON {
    TR_return TR_JSON({"id": kimlik, "kind": tür, "name": kimlik, "source": {"host": "huggingface", "repo": "o/\(kimlik)", "revision": _REV, "files": dosyalar}})
}

TR_func _ham_katalog() -> TR_JSON {
    TR_return TR_JSON({"entries": [
        _girdi("dm", "language_model", [_dosya("dm", "dm.gguf", "dil-modeli-verisi")]),
        _girdi("yaz", "transcriber", [_dosya("yaz", "config.json", "{}"), _dosya("yaz", "model.safetensors", "yazıcı")]),
        _girdi("vad", "vad", [_dosya("vad", "vad.safetensors", "v")]),
        _girdi("ses-tr", "voice", [_dosya("ses-tr", "model.safetensors", "ses")]),
        _girdi("ses-en", "voice", [_dosya("ses-en", "model.safetensors", "voice")])],
        "languages": [
            {"code": "tr", "whisper_language": "tr", "transcriber": "yaz", "voice": "ses-tr", "system_prompt": "Türkçe cevap ver."},
            {"code": "en", "whisper_language": "en", "transcriber": "yaz", "voice": "ses-en", "system_prompt": "Answer in English."}]})
}

TR_func _katalog(kj: TR_JSON) -> Katalog {
    TR_var k = Katalog(girdiler: [], diller: [])
    TR_for g TR_in kj["entries"] {
        k.girdiler.TR_append(Girdi(kimlik: TR_String(g["id"]), tür: TR_String(g["kind"]), ağırlık: 0, katman: 0, kv_başlık: 0,
            başlık_boyu: 0, bağlam_sınırı: 0, ölçüler: []))
    }
    TR_return k
}

TR_func _ayar() -> Ayar { TR_return Ayar(dil_modeli: "dm", konuşma_dili: "tr", sistem: TR_JSON({"source": "catalog"}), bağlam: 8192, kapı: 0) }

# Sınama düzeni: sunucu, Dost klasörü, katalog, indirici ve gönderilen olaylar.
TR_struct Düzen {
    s: TR_HTTPServer
    klasör: TR_String
    kj: TR_JSON
    ind: İndirici
    olaylar: TR_List[TR_JSON] = []
    kurulan: TR_Int = 0 # `bitti` çağrıları
}

TR_func _düzen() -> Düzen {
    TR_var s = TR_serve_http(cevapla)
    TR_var kj = _ham_katalog()
    TR_var klasör = TR_String(TR_Path(TR_temp_dir(), "Dost"))
    TR_var d = Düzen(s: s, klasör: klasör, kj: kj, ind: İndirici(kj: kj, klasör: klasör, gönder: (t, v) => {}, bitti: () => {}))
    d.ind = İndirici(kj: kj, klasör: klasör, gönder: (t, v) => { d.olaylar.TR_append(v) }, bitti: () => { d.kurulan += 1 },
        adres: (g, f) => "http://127.0.0.1:\(s.TR_port)/\(TR_String(f["path"]))")
    TR_return d
}

# _koş: işler bitene kadar ana döngünün adımını yineler (en çok 10 sn).
TR_func _koş(ind: İndirici) {
    TR_var son = TR_time_ms() + 10000
    TR_for ind.işler().TR_length > 0 {
        TR_assert(TR_time_ms() < son, "indirme 10 sn'de bitmedi")
        ind.adım()
        TR_sleep(0.01)
    }
}

TR_func _durumlar(olaylar: TR_List[TR_JSON], iş: TR_String) -> TR_List[TR_String] {
    TR_return [TR_String(o["state"]) TR_for o TR_in olaylar TR_if TR_String(o["job_id"]) == iş]
}

TR_func _son(olaylar: TR_List[TR_JSON], iş: TR_String) -> TR_JSON {
    TR_var l = [o TR_for o TR_in olaylar TR_if TR_String(o["job_id"]) == iş]
    TR_return l[l.TR_length - 1]
}

TR_func _yer(d: Düzen, kimlik: TR_String, target: TR_String) -> TR_Path { TR_return TR_Path(girdi_klasörü(d.klasör, kimlik), target) }

TR_test "kayıt: inen girdi modeller/<id>/'e taşınır, kurulu.json revision'ı, boyu, sha256'yı ve taşımadan sonraki zamanı taşır; ara klasör kalmaz" {
    TR_var d = _düzen()
    d.ind.kuyruğa(["yaz"])
    _koş(d.ind)
    TR_var durumlar = _durumlar(d.olaylar, "d1")
    TR_assert_equal("queued", durumlar[0])
    TR_assert_equal("done", durumlar[durumlar.TR_length - 1])
    TR_assert(durumlar.TR_contains("running") TR_and durumlar.TR_contains("verifying"))
    TR_assert_equal(1, d.kurulan)
    TR_assert_equal("yazıcı", TR_read_file(_yer(d, "yaz", "model.safetensors")))
    TR_var k = TR_json_parse(TR_read_file(kayıt_yolu(d.klasör, "yaz")))
    TR_assert_equal(1, TR_Int(k["v"]))
    TR_assert_equal(_REV, TR_String(k["revision"]))
    TR_var r = k["files"][1]
    TR_assert_equal("model.safetensors", TR_String(r["target"]))
    TR_assert_equal(TR_Bytes("yazıcı").TR_length, TR_Int(r["bytes"]))
    TR_assert_equal(_sha("yazıcı"), TR_String(r["sha256"]))
    TR_assert_equal(_yer(d, "yaz", "model.safetensors").TR_modified_ns, TR_Int(r["mtime"]))
    TR_assert(TR_not ara_klasör(d.klasör, "yaz").TR_exists)
    TR_var son = _son(d.olaylar, "d1")
    TR_assert_equal("null", TR_json_string(son["error"]))
    TR_assert_equal(TR_Int(son["files"][1]["total_bytes"]), TR_Int(son["files"][1]["done_bytes"]))
    d.s.TR_close()
}

TR_test "kurulu: kayıt ve disk tutarsa kurulu; revision ilerleyip dosyalar aynıysa kayıt yeniden yazılır (768 N2); sha256 değişince kurulu değil" {
    TR_var d = _düzen()
    d.ind.kuyruğa(["dm"])
    _koş(d.ind)
    TR_assert(kurulu(d.kj, d.klasör, "dm"))
    TR_var yeni = _değiş(d.kj, _REV, _YENİ_REV)
    TR_assert(kurulu(yeni, d.klasör, "dm"))
    TR_assert_equal(_YENİ_REV, TR_String(TR_json_parse(TR_read_file(kayıt_yolu(d.klasör, "dm")))["revision"]))
    TR_assert(TR_not kurulu(_değiş(yeni, _sha("dil-modeli-verisi"), _sha("başka-veri-17bayt")), d.klasör, "dm"))
    TR_assert(TR_not kurulu(d.kj, d.klasör, "olmayan"))
    d.s.TR_close()
}

TR_test "açılış: kaydı olmayan dosyalar bir kez karılır, ekran o sırada verifying görür; tutan girdinin kaydı yazılır, tutmayan ve boyu farklı olan kurulu değil" {
    TR_var d = _düzen()
    TR_assert(TR_not karılacak_var(d.kj, d.klasör))
    TR_var y = TR_make_dir(girdi_klasörü(d.klasör, "dm"))
    TR_write_file(TR_Path(y, "dm.gguf"), "dil-modeli-verisi")
    TR_assert(TR_not TR_Path(kayıt_yolu(d.klasör, "dm")).TR_exists)
    TR_assert(karılacak_var(d.kj, d.klasör))
    TR_assert(kurulu(d.kj, d.klasör, "dm"))
    TR_assert(TR_Path(kayıt_yolu(d.klasör, "dm")).TR_exists)
    TR_assert(TR_not karılacak_var(d.kj, d.klasör))
    TR_var e = ekran()
    e.kayıt = TR_true
    e.doğrulanıyor()
    e.yükleniyor("dm")
    e.durum("loading")
    e.durum("setup")
    TR_assert_equal([TR_true, TR_false, TR_false], [TR_Bool(o["data"]["verifying"]) TR_for o TR_in e.giden[0..3]])
    TR_assert_equal(TR_none, e.giden[3]["data"].TR_get("verifying"))
    TR_write_file(TR_Path(kayıt_yolu(d.klasör, "dm")), "bozuk")
    TR_assert(kurulu(d.kj, d.klasör, "dm"))
    TR_write_file(TR_Path(y, "dm.gguf"), "dil-modeli-verizi")
    TR_assert(TR_not kurulu(d.kj, d.klasör, "dm"))
    TR_assert(TR_not kurulu(d.kj, d.klasör, "dm"))
    TR_write_file(TR_Path(y, "dm.gguf"), "kısa")
    TR_assert(TR_not kurulu(d.kj, d.klasör, "dm"))
    d.s.TR_close()
}

TR_test "yarıda kalan taşıma: ara klasördeki tam dosya katalogla tutarsa kullanılır, tutmazsa silinip yeniden iner" {
    TR_var d = _düzen()
    TR_var ara = TR_make_dir(ara_klasör(d.klasör, "yaz"))
    TR_write_file(TR_Path(ara, "config.json"), "{}")
    TR_write_file(TR_Path(ara, "model.safetensors"), "bozuk!!")
    _içerik.TR_remove("yaz/config.json")
    d.ind.kuyruğa(["yaz"])
    _koş(d.ind)
    _içerik["yaz/config.json"] = "{}"
    TR_assert_equal("done", TR_String(_son(d.olaylar, "d1")["state"]))
    TR_assert_equal("{}", TR_read_file(_yer(d, "yaz", "config.json")))
    TR_assert_equal("yazıcı", TR_read_file(_yer(d, "yaz", "model.safetensors")))
    TR_assert(kurulu(d.kj, d.klasör, "yaz"))
    d.s.TR_close()
}

TR_test "kuyruk: her girdi bir iş, aynı anda tek iş, sıradaki sırasıyla; adres yalnız katalogdan (huggingface, github)" {
    TR_var d = _düzen()
    d.ind.kuyruğa(["vad", "ses-tr"])
    TR_assert_equal(["d1", "d2"], [i.kimlik TR_for i TR_in d.ind.işler()])
    TR_assert(d.ind.sürüyor_mu("vad") TR_and d.ind.sürüyor_mu("ses-tr") TR_and TR_not d.ind.sürüyor_mu("dm"))
    d.ind.adım()
    TR_assert_equal(["vad"], [i.girdi_kimliği() TR_for i TR_in d.ind.işler()][0..1])
    TR_assert_equal(1, d.ind.sıra.TR_length)
    _koş(d.ind)
    TR_assert_equal(["done", "done"], [TR_String(_son(d.olaylar, i)["state"]) TR_for i TR_in ["d1", "d2"]])
    TR_assert_equal(2, d.kurulan)
    TR_var f = TR_JSON({"path": "a/b.gguf"})
    TR_var hf = TR_JSON({"source": {"host": "huggingface", "repo": "Qwen/Q", "revision": _REV}})
    TR_assert_equal("https://huggingface.co/Qwen/Q/resolve/\(_REV)/a/b.gguf", katalog_adresi(hf, f))
    TR_var gh = TR_JSON({"source": {"host": "github", "repo": "s/v", "revision": _REV}})
    TR_assert_equal("https://raw.githubusercontent.com/s/v/\(_REV)/a/b.gguf", katalog_adresi(gh, f))
    d.s.TR_close()
}

TR_test "iptal ve sürdürme: süren iş iptal edilince cancelled, .part kalır; sıradaki iş kalkar; sürdürme .part'tan Range ile sürer" {
    TR_var d = _düzen()
    _yavaşlar.TR_append("dm/dm.gguf")
    d.ind.kuyruğa(["dm", "vad"])
    d.ind.adım()
    TR_sleep(0.2)
    TR_assert_equal("durdu", d.ind.durdur("d1"))
    TR_assert_equal("durdu", d.ind.durdur("d2"))
    _koş(d.ind)
    _yavaşlar.TR_remove_at(0)
    TR_assert_equal("cancelled", TR_String(_son(d.olaylar, "d1")["state"]))
    TR_assert_equal("cancelled", TR_String(_son(d.olaylar, "d2")["state"]))
    TR_assert_equal("bitmiş", d.ind.durdur("d1"))
    TR_assert_equal("yok", d.ind.durdur("d9"))
    TR_assert(TR_not kurulu(d.kj, d.klasör, "dm"))
    TR_write_file(TR_Path(ara_klasör(d.klasör, "dm"), "dm.gguf.part"), "dil-mo")
    TR_var önce = _aralıklar
    d.ind.kuyruğa(["dm"])
    _koş(d.ind)
    TR_assert_equal("done", TR_String(_son(d.olaylar, "d3")["state"]))
    TR_assert_equal(önce + 1, _aralıklar)
    TR_assert_equal("dil-modeli-verisi", TR_read_file(_yer(d, "dm", "dm.gguf")))
    d.s.TR_close()
}

TR_test "hatalar: yanlış sha256 checksum_mismatch, fazla bayt size_exceeded, 404 download_failed, yer yetmezse disk_full; kodların eşlemesi" {
    TR_var d = _düzen()
    _içerik["dm/dm.gguf"] = "dil-modeli-verizi"
    _içerik["vad/vad.safetensors"] = "vv"
    _içerik.TR_remove("ses-tr/model.safetensors")
    d.ind.kuyruğa(["dm", "vad", "ses-tr"])
    _koş(d.ind)
    _içerik["dm/dm.gguf"] = "dil-modeli-verisi"
    _içerik["vad/vad.safetensors"] = "v"
    _içerik["ses-tr/model.safetensors"] = "ses"
    TR_assert_equal("{\"code\":\"checksum_mismatch\",\"values\":{\"file\":\"dm.gguf\"}}", TR_json_string(_son(d.olaylar, "d1")["error"]))
    TR_assert_equal("{\"code\":\"size_exceeded\",\"values\":{\"file\":\"vad.safetensors\",\"limit_bytes\":1}}", TR_json_string(_son(d.olaylar, "d2")["error"]))
    TR_assert_equal("{\"code\":\"download_failed\",\"values\":{\"entry_id\":\"ses-tr\"}}", TR_json_string(_son(d.olaylar, "d3")["error"]))
    TR_assert_equal(["failed", "failed", "failed"], [TR_String(_son(d.olaylar, i)["state"]) TR_for i TR_in ["d1", "d2", "d3"]])
    TR_assert_equal(0, d.kurulan)
    d.ind.kj = _değiş(d.kj, "\"bytes\":5,", "\"bytes\":1000000000000000,")
    d.ind.kuyruğa(["ses-en"])
    _koş(d.ind)
    TR_var h = _son(d.olaylar, "d4")["error"]
    TR_assert_equal("disk_full", TR_String(h["code"]))
    TR_assert(TR_Int(h["values"]["needed_bytes"]) == 1000000000000000 TR_and TR_Int(h["values"]["free_bytes"]) > 0)
    TR_var f = TR_JSON({"target": "a.bin", "bytes": 5})
    TR_var ara = TR_Path(TR_temp_dir())
    TR_assert_equal("download_busy", TR_String(hata_karşılığı("H7722", "dm", f, ara, 5)["code"]))
    TR_assert_equal("download_failed", TR_String(hata_karşılığı("H7728", "dm", f, ara, 5)["code"]))
    TR_assert_equal("disk_full", TR_String(hata_karşılığı("H7728", "dm", f, ara, 1000000000000000)["code"]))
    TR_for kod TR_in ["H7709", "H7714", "H7738", "H7739"] { TR_assert_equal("download_failed", TR_String(hata_karşılığı(kod, "dm", f, ara, 5)["code"])) }
    TR_for kod TR_in ["H7700", "H7723", ""] { TR_assert_equal("internal", TR_String(hata_karşılığı(kod, "dm", f, ara, 5)["code"])) }
    d.s.TR_close()
}

TR_test "katlama: görüntü sıradaki ve süren işlerin son download olayını taşır; biten iş düşer" {
    TR_var g = baş()
    TR_var iş = (durum: TR_String) => zarf("download", TR_JSON({"job_id": "d1", "entry_id": "dm", "state": durum, "files": [], "bytes_per_second": 0, "error": TR_none}))
    g = katla(g, iş("queued"))
    g = katla(g, iş("running"))
    TR_var l = TR_List(g["data"]["snapshot"])
    TR_assert_equal(1, l.TR_length)
    TR_assert_equal("running", TR_String(l[0]["data"]["state"]))
    g = katla(g, iş("done"))
    TR_assert_equal(0, TR_List(g["data"]["snapshot"]).TR_length)
}

TR_func _kur_yok(t: Takım) -> Asistan { TR_throw "sınamada model yüklenmez" }
TR_func _mikrofon_yok(b: TR_Int) -> TR_Process { TR_throw "sınamada mikrofon yok" }
TR_func _tur_yok(a: Asistan, k: TR_Tensor?, s: TR_String?, t0: TR_Int, b: TR_Bool, g: TR_Int, i: () -> TR_NoneType,
    kd: (Tur, TR_String, TR_Int, TR_String, TR_String) -> TR_NoneType) -> ÇalmaAralığı { TR_return ÇalmaAralığı() }

# _oturum: düzenin katalog ve klasörüyle, ayar dosyasız bir oturum; indirme komutları oturumun kararına gider.
TR_func _oturum(d: Düzen) -> Oturum {
    TR_var e = ekran()
    e.kayıt = TR_true
    TR_var k = _katalog(d.kj)
    TR_var o = Oturum(e: e, k: k, kj: d.kj, klasör: d.klasör, etkin: _ayar(), ayar_verisi: TR_none, y: Yuva(), yüklü: Yüklü(),
        en_çok_tur: 0, kuyruk_ms: 0, çerçeve_bayt: 1024, açılış: 0, kur: _kur_yok, mikrofon_aç: _mikrofon_yok, tur: _tur_yok)
    o.indirici = İndirici(kj: d.kj, klasör: d.klasör, gönder: e.gönder, bitti: o.kurulumu_yenile, adres: d.ind.adres)
    e.indirme = o.indirme_kararı
    o.kurulumu_yenile()
    TR_return o
}

TR_func _işler(o: Oturum) -> TR_List[İş] {
    TR_var ind = o.indirici
    TR_return TR_if ind == TR_none { [] } TR_else { ind.işler() }
}

TR_func _karar(o: Oturum, tür: TR_String, veri: TR_JSON) -> TR_String {
    TR_var c = o.indirme_kararı(Komut(kimlik: "c", tür: tür, veri: veri))
    TR_if TR_String(c["status"]) == "accepted" { TR_return "accepted" }
    TR_return TR_String(c["error"]["code"])
}

TR_test "komutlar: model_download dil modelini ve konuşma dilinin kurulu olmayan modellerini sıraya koyar; sıradaki girdi download_busy; bilinmeyen girdi ve iş" {
    TR_var d = _düzen()
    TR_var o = _oturum(d)
    TR_assert_equal("unknown_entry", _karar(o, "model_download", TR_JSON({"entry_id": "yaz"})))
    TR_assert_equal("unknown_entry", _karar(o, "model_delete", TR_JSON({"entry_id": "olmayan"})))
    TR_assert_equal("unknown_job", _karar(o, "download_cancel", TR_JSON({"job_id": "d1"})))
    TR_var y = TR_make_dir(girdi_klasörü(d.klasör, "vad"))
    TR_write_file(TR_Path(y, "vad.safetensors"), "v")
    TR_assert_equal("accepted", _karar(o, "model_download", TR_JSON({"entry_id": "dm"})))
    TR_assert_equal(["dm", "yaz", "ses-tr"], [i.girdi_kimliği() TR_for i TR_in _işler(o)])
    TR_assert_equal("download_busy", _karar(o, "model_download", TR_JSON({"entry_id": "dm"})))
    TR_assert_equal("download_busy", _karar(o, "model_delete", TR_JSON({"entry_id": "dm"})))
    TR_var son = TR_time_ms() + 10000
    TR_for _işler(o).TR_length > 0 TR_and TR_time_ms() < son {
        o.işle()
        TR_sleep(0.01)
    }
    TR_assert_equal(0, TR_Dict(o.e.yüklenebilir["dm"]).TR_length)
    TR_var katalog = [x TR_for x TR_in o.e.giden TR_if TR_String(x["type"]) == "catalog"]
    TR_assert(TR_Bool(katalog[katalog.TR_length - 1]["data"]["entries"][0]["installed"]))
    TR_assert_equal("accepted", _karar(o, "download_cancel", TR_JSON({"job_id": "d1"})))
    d.s.TR_close()
}

TR_test "silme: dosyalar ve kayıt gider, konuşma modelleri kalır; yüklü model önce bırakılır, durum setup, sonraki açılış da setup (768 Ş1); tur sürerken turn_busy; yol parçası değilse diske dokunulmaz (768 N4)" {
    TR_var d = _düzen()
    TR_var o = _oturum(d)
    d.ind.kuyruğa(["dm", "vad"])
    _koş(d.ind)
    TR_write_file(TR_Path(TR_make_dir(ara_klasör(d.klasör, "dm")), "dm.gguf.part"), "yarım")
    o.kurulumu_yenile()
    o.y.takım = Takım(giriş: "dm", dil_modeli: "", yazıcı: "", vad: "", ses: "", dil: "tr", sistem: "")
    o.e.tur = "t-1"
    TR_assert_equal("turn_busy", _karar(o, "model_delete", TR_JSON({"entry_id": "dm"})))
    o.e.tur = ""
    TR_assert_equal("accepted", _karar(o, "model_delete", TR_JSON({"entry_id": "dm"})))
    o.işle()
    TR_assert_equal(TR_none, o.y.takım)
    TR_assert(TR_not o.e.hazır)
    TR_var durumlar = [TR_String(x["data"]["state"]) TR_for x TR_in o.e.giden TR_if TR_String(x["type"]) == "state"]
    TR_assert_equal("setup", durumlar[durumlar.TR_length - 1])
    TR_assert(TR_not TR_Path(girdi_klasörü(d.klasör, "dm")).TR_exists)
    TR_assert(TR_not ara_klasör(d.klasör, "dm").TR_exists)
    TR_assert(kurulu(d.kj, d.klasör, "vad"))
    TR_assert_equal("not_installed", takım_kur(o.k, d.kj, d.klasör, "dm", _ayar()).kod)
    TR_assert_equal("not_installed", TR_String(o.e.yüklenebilir["dm"]["code"]))
    d.ind.kj = _değiş(d.kj, "\"target\":\"vad.safetensors\"", "\"target\":\"../dışarı\"")
    TR_assert(TR_not sil(d.ind.kj, d.klasör, "vad"))
    TR_assert(TR_Path(girdi_klasörü(d.klasör, "vad"), "vad.safetensors").TR_exists)
    TR_assert(TR_not yol_parçası_mı("a/b") TR_and TR_not yol_parçası_mı("..") TR_and TR_not yol_parçası_mı("") TR_and yol_parçası_mı("a.bin"))
    d.ind.kuyruğa(["vad"])
    _koş(d.ind)
    TR_assert_equal("internal", TR_String(_son(d.olaylar, "d3")["error"]["code"]))
    d.s.TR_close()
}
