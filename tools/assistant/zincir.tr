# TR 4
# Sesli yardımcının zinciri, programdan ayrı: tur, üretim, önbellek, cümleler (asistan.tr kullanır, zincir_test.tr sınar).
# Önbellek turdan tura korunur: yeni turun kimlikleri önbellektekilerle ortak önek kadar karşılaştırılır, önbellek o
# kadara kırpılır, yalnız kalan okunur. Önceki turun boş düşünce bloğu yeni dizide yazılmaz (24.2), bu yüzden ortak
# önek önceki asistan başlığının sonunda biter.

TR_import "tr/audio"
TR_import "tr/chat"
TR_import "tr/pretrained"
TR_import "tr/vad"
TR_import "nicemli" # nicemli_hatasını_at (ısıt)

TR_const _ÇERÇEVE = 512
TR_const _SINIR = ".!?…\n" # cümle sınırı (cümleler'in kuralı)
# Kesitleyicinin varsayılan sessizliği: TR_silence 0,6 sn, ceil(0,6 × 16000 / 512) = 19 çerçeve × 32 ms (lib/vad.tr).
# Kesit kullanıcının sözü bittikten bu kadar sonra gelir.
TR_const _SESSİZLİK_MS = 608

# sessizlik_ms: sözün sonundan VAD'ın kararına geçen sabit süre (deneme kaydının özeti için; ad modülün içinde).
TR_func sessizlik_ms() -> TR_Int { TR_return _SESSİZLİK_MS }

# şimdi: zincirin bütün zaman damgalarının saati (ms): 13.1'in tekdüze saati. Geri gitmez, sistem saati düzeltilince
# kaymaz; başlangıcı belirsizdir, yalnız iki değerin farkı anlamlıdır.
TR_func şimdi() -> TR_Int { TR_return TR_monotonic_ns() // 1000000 }

# Tur: bir turun zamanları (kesitin geldiği andan ms), sayıları ve sesi.
TR_struct Tur {
    sıra: TR_Int
    söz_ms: TR_Int
    yazı_ms: TR_Int = -1
    ilk_parça_ms: TR_Int = -1
    ilk_cümle_ms: TR_Int = -1 # ilk cümlenin üretimi bitti: sınırı geldi ya da cevap bitti
    cevap_ms: TR_Int = -1 # cevap bitti; durdurulan turda -1
    ilk_ses_ms: TR_Int = -1
    çalma_ms: TR_Int = -1 # ilk cümle çalınmaya başladı (dosya kipinde çalınmaya verildi)
    bekleme_ms: TR_Int = -1 # kullanıcının beklediği: sözün sonundan çalmanın başlamasına
    geride_ms: TR_Int = 0 # kesit tampondan geç okunduysa (tur sürerken konuşulan söz) geç kalınan süre
    çalma_süresi_ms: TR_Int = 0
    çalma_başı: TR_Int = -1 # çalma aralığı (saat): ilk çalmanın başı, son çalmanın sonu
    çalma_sonu: TR_Int = -1
    çalma_sonrası: TR_Int = 0
    rakam: TR_Int = 0
    önek: TR_Int = 0
    beklenen_önek: TR_Int = 0
    yeniden_okunan: TR_Int = 0
    istem: TR_Int = 0
    üretilen: TR_Int = 0
    yeni_konuşma: TR_Int = 0
    söylenen_fark: TR_Int = 0 # söylenen cümleler cevabın içeriğinin cümleleri değilse 1
    duyulan: TR_String = "" # Whisper'ın metni (metin turunda yazılan)
    giden: TR_String = "" # dil modeline giden kullanıcı iletisi
    cevap: TR_String = "" # cevabın içeriği; durdurulan turda o ana kadar çözülen metin
    düşünce: TR_String = "" # cevabın düşünce alanı (zincir düşünmeden kurulu: boş)
    seslendirilen: TR_List[TR_String] = [] # ses üretimine giden cümleler
}

TR_func olcu_yaz(t: Tur) {
    TR_print("OLCU tur=\(t.sıra) soz_ms=\(t.söz_ms) yazi_ms=\(t.yazı_ms) ilk_parca_ms=\(t.ilk_parça_ms) ilk_cumle_ms=\(t.ilk_cümle_ms) cevap_ms=\(t.cevap_ms) ilk_ses_ms=\(t.ilk_ses_ms) toplam_ms=\(t.çalma_ms) bekleme_ms=\(t.bekleme_ms) geride_ms=\(t.geride_ms) calma_suresi_ms=\(t.çalma_süresi_ms) calma_sonrasi=\(t.çalma_sonrası) soylenen_fark=\(t.söylenen_fark) rakam=\(t.rakam) onek=\(t.önek) beklenen_onek=\(t.beklenen_önek) yeniden_okunan=\(t.yeniden_okunan) istem=\(t.istem) uretilen=\(t.üretilen) yeni_konusma=\(t.yeni_konuşma)")
}

# Zincir: dil modeli, konuşmanın geçmişi ve önbellek (yazıya çeviren ve ses modelleri asistan.tr'de).
TR_struct Zincir {
    p: TR_Tokenizer
    model: TR_GPT
    sistem: TR_String
    en_çok: TR_Int
    bağlam: TR_Int
    önbelleksiz: TR_Bool
    nicemli: TR_Bool = TR_false # --nicemli_etkinleştirme: çağrılar `TR_quantized_activations` bloğunda da (model_çağrısı)
    geçmiş: TR_List[TR_ChatMessage] = []
    önbellek: TR_KVCache? = TR_none
    okunan: TR_List[TR_Int] = [] # önbellekteki kimlikler
    son_asistan: TR_Int = -1 # geçmişte son tamamlanan asistan iletisinin sırası
    ısıtılan: TR_Int = 0 # önbelleğe önceden okunan sistem iletisinin parça sayısı (ısıt)
    tur: TR_Int = 0
    kimlik_satırları: TR_String = ""

    TR_func yeni_konuşma() {
        TR_self.geçmiş = [TR_ChatMessage(TR_role: TR_Role.TR_System, TR_content: TR_self.sistem)]
        TR_self.önbellek = önbellek_kur(TR_self.model, TR_self.bağlam)
        TR_self.okunan = []
        TR_self.son_asistan = -1
        TR_self.ısıtılan = 0
    }
}

# model_çağrısı: dil modelinin her çağrısı (ısıtma, istem, her yeni token) `TR_vendor_matmul` bloğundadır (15.53b):
# GPU'da çarpımlar üreticinin kitaplığıyla; bloğun dışında kendi çekirdek istem okumasını 1,15–1,32 kat yavaşlatıyordu
# (T1 0b, U5 koşu 2); bitler blokta da aynıdır, yalnız kitaplığın sürümüne bağlıdır; işlemcide blok etkisizdir. `nicemli`
# açıkken `TR_quantized_activations` bloğunda da (15.53a): q4_k ve q6_k ağırlıklı çarpımda girdi int8'e nicemlenir.
TR_func model_çağrısı(z: Zincir, f: () -> TR_Tensor) -> TR_Tensor {
    TR_if z.nicemli { TR_return TR_vendor_matmul { TR_quantized_activations { f() } } }
    TR_return TR_vendor_matmul { f() }
}

# istem_oku: `k`'yi önbelleğe okur, son konumun logitini verir; üretimin ve ısıtmanın tek yolu (çıkış katmanı dahil).
TR_func istem_oku(z: Zincir, k: TR_List[TR_Int], ö: TR_KVCache?) -> TR_Tensor {
    TR_return model_çağrısı(z) { z.model.TR_logits(z.model.TR_hidden_states([k], TR_cache: ö).TR_slice(1, k.TR_length - 1, k.TR_length))[0][0] }
}

# ısıt: sistem iletisini konuşmanın başında, ilk sözden önce önbelleğe okur; ilk tur yalnız kullanıcının iletisini
# okur. Sistem iletisinin tek başına biçimi sistem + kullanıcı biçiminin önekidir (24; zincir_test sınar), ortak önek
# onu bulur. Önbelleksiz kipte bir şey yapmaz. Hata olursa (nicemli hata dışında) ısıtma yokmuş gibi sürer: önbellek boşaltılır, ilk tur
# sistem iletisini de okur; sonuç aynı, yalnız yavaş.
TR_func ısıt(z: Zincir) {
    TR_var ö = z.önbellek
    TR_if z.önbelleksiz TR_or ö == TR_none { TR_return }
    TR_var kimlikler = TR_qwen3_format(z.p, [TR_ChatMessage(TR_role: TR_Role.TR_System, TR_content: z.sistem)], TR_add_generation_prompt: TR_false)
    z.okunan = []
    z.ısıtılan = 0
    TR_var başla = şimdi()
    TR_try {
        ö.TR_truncate(0)
        TR_no_grad { istem_oku(z, kimlikler, ö) } # üretimin istem okumasının aynısı; logit atılır
    } TR_catch e {
        TR_if z.nicemli { nicemli_hatasını_at(e) }
        TR_print("ISITMA HATASI:", e)
        ö.TR_truncate(0)
        TR_return
    }
    z.okunan = kimlikler
    z.ısıtılan = kimlikler.TR_length
    TR_print("OLCU_ISITMA ms=\(şimdi() - başla) parca=\(kimlikler.TR_length)")
}

# geri_al: hatalı ya da durdurulan tur: kullanıcı iletisi geçmişten çıkar, önbellek yeniden kurulur, sistem iletisi
# yeniden önceden okunur (hatası programı durdurmaz). Kullanıcı cevabın bir kısmını duymuş olabilir (ilk sürümün
# kabulü). `uzunluk` turdan önceki geçmişin uzunluğudur.
TR_func geri_al(z: Zincir, t: Tur, uzunluk: TR_Int) {
    z.tur = t.sıra
    TR_for z.geçmiş.TR_length > uzunluk { z.geçmiş.TR_pop() }
    TR_if z.son_asistan >= z.geçmiş.TR_length { z.son_asistan = -1 }
    z.okunan = [] # önbellek yarıda kalmış olabilir: sonraki tur baştan okur
    z.önbellek = önbellek_kur(z.model, z.bağlam)
    ısıt(z)
}

# Önbellek zincirin bağlamı kadardır. Kapasitesiz kurulan sabit önbellek modelin bütün bağlamını ayırır:
# Qwen3-4B'de 40960 parça, 36 katmanda 11 520 MiB.
TR_func önbellek_kur(model: TR_GPT, bağlam: TR_Int) -> TR_KVCache { TR_return model.TR_build_cache(TR_capacity: bağlam) }

# beklenen_önek: geçmişin `son_asistan` sıradaki asistan iletisinin başlığının bittiği konum (yoksa 0). Önceki
# turun boş düşünce bloğu yeni dizide yazılmaz; ortak önek en az buraya kadar sürmelidir (B.4).
TR_func beklenen_önek(p: TR_Tokenizer, geçmiş: TR_List[TR_ChatMessage], son_asistan: TR_Int) -> TR_Int {
    TR_if son_asistan < 0 { TR_return 0 }
    TR_var önce = TR_qwen3_format(p, geçmiş[0..son_asistan], TR_add_generation_prompt: TR_false)
    TR_return önce.TR_length + 1 + p.TR_encode("assistant\n", TR_special_tokens: TR_false).TR_length
}

TR_func ortak_önek(a: TR_List[TR_Int], b: TR_List[TR_Int]) -> TR_Int {
    TR_var n = TR_min(a.TR_length, b.TR_length)
    TR_var i = 0
    TR_for i < n TR_and a[i] == b[i] { i += 1 }
    TR_return i
}

# Üretim: açgözlü seçim; `<|im_end|>` ya da `<|endoftext|>`'te ya da en çok parçada durur.
TR_struct Üretim {
    kimlikler: TR_List[TR_Int] = []
    farklar: TR_List[TR_Float] = [] # her adımda en iyi iki logitin farkı
    anlar: TR_List[TR_Int] = [] # her kimliğin seçildiği an
}

TR_func seç(logit: TR_Tensor, ü: Üretim) -> TR_Int {
    TR_var iki = TR_topk(logit, 2)
    TR_var değer = iki[0].TR_tolist
    ü.farklar.TR_append(değer[0] - değer[1])
    TR_return iki[1].TR_tolist[0]
}

# her: durdurucu olmayan her kimlik, seçildiği anla; sonraki kimlik hesaplanmadan önce çağrılır.
TR_func üret(z: Zincir, kimlikler: TR_List[TR_Int], t: Tur, her: (TR_Int, TR_Int) -> TR_NoneType) -> Üretim {
    # En az bir parça okunur: son konumun logiti gerekir.
    TR_var ortak = 0
    TR_if TR_not z.önbelleksiz { ortak = TR_min(ortak_önek(z.okunan, kimlikler), kimlikler.TR_length - 1) }
    # Korunan önbellek varken yenisi kurulmaz (kurulup kullanılmayan önbellek bellek ayırmaz: sabit tampon ilk
    # kullanımda ayrılır, lib/layers.tr; yine de boşuna bir nesnedir).
    TR_var korunan = z.önbellek
    TR_var ö = TR_if z.önbelleksiz TR_or korunan == TR_none { önbellek_kur(z.model, z.bağlam) } TR_else { korunan }
    TR_if TR_not z.önbelleksiz TR_and korunan != TR_none { ö.TR_truncate(ortak) }
    z.önbellek = ö
    z.okunan = kimlikler[0..kimlikler.TR_length]
    t.önek = ortak
    t.yeniden_okunan = kimlikler.TR_length - ortak
    t.istem = kimlikler.TR_length
    TR_var dur = [z.p.TR_token_id("<|im_end|>"), z.p.TR_token_id("<|endoftext|>")]
    TR_var ü = Üretim()
    TR_no_grad { # dil modelinin çağrıları `model_çağrısı`'nda; `her` (sesi kuran geri çağrı) onun dışında
        TR_var kalan = kimlikler[ortak..kimlikler.TR_length]
        TR_var logit = istem_oku(z, kalan, ö)
        TR_for ü.kimlikler.TR_length < z.en_çok {
            TR_var k = seç(logit, ü)
            TR_var an = şimdi()
            ü.anlar.TR_append(an)
            ü.kimlikler.TR_append(k)
            TR_if dur.TR_contains(k) { TR_break }
            her(k, an)
            logit = model_çağrısı(z) { z.model.TR_logits(z.model.TR_hidden_states([[k]], TR_cache: ö))[0][0] }
            z.okunan.TR_append(k)
        }
    }
    TR_return ü
}

# cümleler içeriği nokta, soru, ünlem ve satır sonunda böler; harfi ya da rakamı olmayan parça atılır (sesi olmaz).
TR_func cümleler(m: TR_String) -> TR_List[TR_String] {
    TR_var çıktı: TR_List[TR_String] = []
    TR_var parça = ""
    TR_for h TR_in m + "\n" {
        parça += h
        TR_if _SINIR.TR_contains(h) {
            TR_var s = parça.TR_strip()
            TR_if _sesli(s) { çıktı.TR_append(s) }
            parça = ""
        }
    }
    TR_return çıktı
}

# CümleAkışı: üretilen kimliklerden cümleleri sınırları geldikçe verir, `cümleler`'in kuralıyla. Her adımda bütün
# kimlikler baştan çözülür (16.3a'nın akışlı çözmesi motorda yok). `cümleler` yarım metnin sınırsız son parçasını da
# cümle sayar; bu yüzden son sınırın metindeki yeri (`söylenen`) ayrıca tutulur, sınırsız kuyruk bekler. Sınırdan
# önceki metin yeni kimliklerle değişmez: değişebilen yalnız sondaki yarım UTF-8 dizisinin U+FFFD'leridir.
# Etiket kimliği gelirse (düşünce, araç çağrısı) akış durur; kalanı `bitir` cevabın içeriğinden verir.
TR_struct CümleAkışı {
    p: TR_Tokenizer
    etiketler: TR_List[TR_Int]
    kimlikler: TR_List[TR_Int] = []
    metin: TR_String = ""
    söylenen: TR_Int = 0 # metnin verilen kısmının sonu (karakter)
    verilen: TR_List[TR_String] = []
    durdu: TR_Bool = TR_false

    TR_func ekle(k: TR_Int) -> TR_List[TR_String] {
        TR_if TR_self.durdu TR_or TR_self.etiketler.TR_contains(k) {
            TR_self.durdu = TR_true
            TR_return []
        }
        TR_self.kimlikler.TR_append(k)
        TR_var önceki = TR_self.metin.TR_length
        TR_self.metin = TR_self.p.TR_decode(TR_self.kimlikler)
        # Yarım dizi en çok üç bayttır, her baytı en çok bir U+FFFD: değişen yer önceki metnin son üç karakterindedir.
        TR_var son = -1
        TR_for i TR_in TR_max(TR_self.söylenen, önceki - 3)..TR_self.metin.TR_length {
            TR_if _SINIR.TR_contains(TR_self.metin[i]) { son = i }
        }
        TR_if son < 0 { TR_return [] }
        TR_var yeni = cümleler(TR_self.metin[TR_self.söylenen..son + 1])
        TR_self.söylenen = son + 1
        TR_self.verilen += yeni
        TR_return yeni
    }

    # bitir: cevabın içeriğinin cümlelerinden henüz verilmemiş olanlar. Verilenler o cümlelerin başı değilse TR_none:
    # söylenen metin cevaptan ayrılmıştır, kalan söylenmez.
    TR_func bitir(içerik: TR_String) -> TR_List[TR_String]? {
        TR_var hepsi = cümleler(içerik)
        TR_var n = TR_self.verilen.TR_length
        TR_if n > hepsi.TR_length TR_or hepsi[0..n] != TR_self.verilen { TR_return TR_none }
        TR_var kalan = hepsi[n..hepsi.TR_length]
        TR_self.verilen += kalan
        TR_return kalan
    }
}

TR_func cümle_akışı(p: TR_Tokenizer) -> CümleAkışı {
    TR_return CümleAkışı(p: p, etiketler: [p.TR_token_id(e) TR_for e TR_in ["<think>", "</think>", "<tool_call>", "</tool_call>"]])
}

TR_func _sesli(m: TR_String) -> TR_Bool {
    TR_for h TR_in m {
        TR_if h.TR_lower() != h.TR_upper() TR_or "0123456789".TR_contains(h) { TR_return TR_true }
    }
    TR_return TR_false
}

TR_func rakamlı(m: TR_String) -> TR_Bool {
    TR_for h TR_in m {
        TR_if "0123456789".TR_contains(h) { TR_return TR_true }
    }
    TR_return TR_false
}

# cevapla: sözün yazısından cevabın içeriğine kadar; yazı boşsa TR_none. Cevabın cümleleri üretim sürerken, sınırları
# geldikçe `söyle`'ye verilir (cümle akışı); sınırla bitmeyen son parça cevap bitince. Söylenen cümleler cevabın
# içeriğinin cümlelerinden ayrılırsa kalan söylenmez, fark `OLCU`'ya ve günlüğe yazılır. `aktı` her adımda cümle
# akışının baştan çözülmüş metnini alır (ekran; etiket kimliğinden sonra metin değişmez).
TR_func cevapla(z: Zincir, yazı: TR_String, t0: TR_Int, t: Tur, söyle: (TR_String) -> TR_NoneType, aktı: (TR_String) -> TR_NoneType = (_) => {}) -> TR_String? {
    TR_if yazı.TR_strip() == "" { TR_return TR_none }
    t.giden = yazı.TR_strip()
    TR_var sesle = (c: TR_String) => {
        t.seslendirilen.TR_append(c)
        söyle(c)
    }
    z.geçmiş.TR_append(TR_ChatMessage(TR_role: TR_Role.TR_User, TR_content: yazı.TR_strip()))
    TR_var kimlikler = TR_qwen3_format(z.p, z.geçmiş, TR_add_generation_prompt: TR_true, TR_enable_thinking: TR_false)
    TR_if kimlikler.TR_length + z.en_çok > z.bağlam {
        TR_print("önbellek dolacak (\(kimlikler.TR_length) + \(z.en_çok) > \(z.bağlam)): yeni konuşma başlıyor")
        TR_var soru = z.geçmiş[z.geçmiş.TR_length - 1]
        z.yeni_konuşma()
        z.geçmiş.TR_append(soru)
        t.yeni_konuşma = 1
        kimlikler = TR_qwen3_format(z.p, z.geçmiş, TR_add_generation_prompt: TR_true, TR_enable_thinking: TR_false)
    }
    t.beklenen_önek = beklenen_önek(z.p, z.geçmiş, z.son_asistan)
    TR_if z.son_asistan < 0 { t.beklenen_önek = TR_max(t.beklenen_önek, z.ısıtılan) } # ilk tur: ısıtılan sistem iletisi
    TR_var akış = cümle_akışı(z.p)
    # İlk parçanın anı ve o ana kadarki metin her adımda Tur'a yazılır: durdurulan (iptal edilen) turun kaydında da
    # bulunur. Cevap bitince ikisi cevabın kendisiyle yazılır.
    TR_var ü = üret(z, kimlikler, t, (k, an) => {
        TR_if t.ilk_parça_ms < 0 { t.ilk_parça_ms = an - t0 }
        TR_var yeni = akış.ekle(k)
        t.cevap = akış.metin
        TR_if yeni.TR_length > 0 TR_and t.ilk_cümle_ms < 0 { t.ilk_cümle_ms = an - t0 }
        aktı(akış.metin)
        TR_for c TR_in yeni { sesle(c) }
    })
    t.cevap_ms = şimdi() - t0
    TR_if ü.anlar.TR_length > 0 { t.ilk_parça_ms = ü.anlar[0] - t0 }
    t.üretilen = ü.kimlikler.TR_length
    TR_if TR_not z.önbelleksiz TR_and t.önek < t.beklenen_önek {
        TR_print("ÖNEK_KISA tur=\(t.sıra) önek=\(t.önek) beklenen=\(t.beklenen_önek)")
    }
    z.kimlik_satırları += TR_json_string({"tur": t.sıra, "ids": ü.kimlikler, "farklar": ü.farklar, "anlar_ms": [a - t0 TR_for a TR_in ü.anlar]}) + "\n"
    TR_var gövde = ü.kimlikler
    TR_if gövde.TR_length > 0 TR_and gövde[gövde.TR_length - 1] == z.p.TR_token_id("<|im_end|>") { gövde = gövde[0..gövde.TR_length - 1] }
    TR_var cevap, hatalar = TR_qwen3_reply(z.p, gövde)
    TR_for h TR_in hatalar { TR_print("CEVAP HATASI:", h) }
    TR_var kalan = akış.bitir(cevap.TR_content)
    TR_if t.ilk_cümle_ms < 0 TR_and ü.anlar.TR_length > 0 { t.ilk_cümle_ms = ü.anlar[ü.anlar.TR_length - 1] - t0 }
    z.geçmiş.TR_append(cevap)
    z.son_asistan = z.geçmiş.TR_length - 1
    TR_print("CEVAP:", cevap.TR_content)
    t.cevap = cevap.TR_content
    t.düşünce = TR_if cevap.TR_reasoning == TR_none { "" } TR_else { TR_String(cevap.TR_reasoning) }
    TR_if kalan == TR_none {
        t.söylenen_fark = 1
        TR_print("SÖYLENEN FARKLI tur=\(t.sıra) söylenen=\(akış.verilen.TR_length) cümle=\(cümleler(cevap.TR_content).TR_length)")
    } TR_else {
        TR_for c TR_in kalan { sesle(c) }
    }
    t.rakam = TR_if rakamlı(cevap.TR_content) { 1 } TR_else { 0 }
    TR_return cevap.TR_content
}

# Konuşma: bir turun çalma sırası. Cümlenin sesi çağıranın görevinde hesaplanır ve `hazırla`'ya verilir (canlı kipte
# geçici WAV'a yazılır); çalması ayrı bir görevdir (10.1) ve önceki çalmanın görevini bekler (10.3: bekleme kilidi
# bırakır). Ses ile dil modeli aynı görevde sırayla kalır; örtüşen yalnız çalmanın beklemesi ile sonraki hesaptır.
# Çalmanın hatası son görevin beklenmesinde, `bitir`'de fırlar.
TR_struct Konuşma {
    hazırla: (TR_Sound, TR_Int) -> TR_String # ses, sırası; çalınacak şey (WAV yolu)
    çal: (TR_String) -> TR_NoneType
    t: Tur
    t0: TR_Int
    son: TR_Task[TR_NoneType]? = TR_none
    sayı: TR_Int = 0

    TR_func söyle(s: TR_Sound) {
        TR_var t = TR_self.t
        TR_if t.ilk_ses_ms < 0 { t.ilk_ses_ms = şimdi() - TR_self.t0 }
        TR_var iş = TR_self.hazırla(s, TR_self.sayı)
        TR_self.sayı += 1
        TR_var önceki = TR_self.son
        TR_var t0 = TR_self.t0
        TR_var çal = TR_self.çal
        TR_self.son = TR_async {
            TR_if önceki != TR_none { önceki.TR_wait() }
            TR_var başı = şimdi()
            TR_if t.çalma_başı < 0 {
                t.çalma_başı = başı
                t.çalma_ms = başı - t0
            }
            çal(iş)
            t.çalma_sonu = şimdi()
            t.çalma_süresi_ms = t.çalma_sonu - t.çalma_başı
        }
    }

    # bitir: son çalmayı bekler; çalmanın hatası buradan fırlar. İkinci çağrı bir şey beklemez.
    TR_func bitir() {
        TR_var son = TR_self.son
        TR_self.son = TR_none
        TR_if son != TR_none { son.TR_wait() }
    }
}

# wav_yaz ve wav_çal: canlı kipte cümle klasörde geçici bir WAV'dır; çalınınca hemen silinir (çalma hatayla bitse de).
# Cevabın sesi diskte kalmaz: program kesilirse en çok çalınmayı bekleyen cümleler kalır, klasörü çağıran siler.
TR_func wav_yaz(klasör: TR_Path, s: TR_Sound, i: TR_Int) -> TR_String {
    TR_var yol = TR_String(TR_Path(klasör, "cumle_\(i).wav"))
    TR_write_wav(yol, s)
    TR_return yol
}

# program_mı_yol: --ffmpeg ve --çalıcı'nın programı. Ayırıcılı değer dosyanın kendisidir (TR_Path), ayırıcısız
# değer PATH'te aranan addır (21.3): kullanıcı ikisinden birini verir, ad yol diye reddedilmez.
TR_func program_mı_yol(ad: TR_String) -> TR_Bool { TR_return ad.TR_contains("/") TR_or ad.TR_contains("\\") }

TR_func program_başlat(ad: TR_String, argümanlar: TR_List[TR_String], tampon: TR_Int) -> TR_Process {
    TR_if program_mı_yol(ad) { TR_return TR_spawn_process(TR_Path(ad), argümanlar, TR_buffer_bytes: tampon) }
    TR_return TR_spawn_process(ad, argümanlar, TR_buffer_bytes: tampon)
}

TR_func program_koş(ad: TR_String, argümanlar: TR_List[TR_String]) {
    TR_if program_mı_yol(ad) { TR_run_process(TR_Path(ad), argümanlar) } TR_else { TR_run_process(ad, argümanlar) }
}

TR_func wav_çal(yol: TR_String, çal: (TR_String) -> TR_NoneType) {
    TR_defer { TR_remove(yol) }
    çal(yol)
}

# tur_ölç: turun sonunda hesaplanan ölçüler.
TR_func tur_ölç(t: Tur) {
    TR_if t.çalma_ms >= 0 { t.bekleme_ms = _SESSİZLİK_MS + t.çalma_ms }
}

TR_func birleştir(sesler: TR_List[TR_Sound]) -> TR_Sound {
    TR_return TR_Sound(TR_concat([s.TR_samples TR_for s TR_in sesler], TR_dim: 1), sesler[0].TR_sample_rate)
}

TR_func süre_ms(s: TR_Sound) -> TR_Int { TR_return s.TR_samples.TR_shape[1] * 1000 // s.TR_sample_rate }

# kesitle: bir sesin bütün kesitlerini birleştirip verir; konuşma yoksa TR_none.
TR_func kesitle(kesici: TR_SpeechSplitter, örnekler: TR_Tensor) -> TR_Tensor? {
    TR_var kesitler: TR_List[TR_Tensor] = []
    TR_var n = örnekler.TR_shape[0] // _ÇERÇEVE
    TR_for i TR_in 0..n {
        TR_var k = kesici.TR_push(örnekler.TR_slice(0, i * _ÇERÇEVE, (i + 1) * _ÇERÇEVE))
        TR_if k != TR_none { kesitler.TR_append(k) }
    }
    TR_var son = kesici.TR_flush()
    TR_if son != TR_none { kesitler.TR_append(son) }
    TR_if kesitler.TR_length == 0 { TR_return TR_none }
    TR_return TR_concat(kesitler)
}

# Cihaz geçişleri: kurucular varsayılan cihazda kurar (15.38), kesitleyici yalnız işlemcide çalışır (25.11). Giriş ve
# çıkışı burada açıkça taşınır, kitaplık değişmez. Varsayılan cihaz işlemciyken üçü de boş taşımadır (15.39).
# işlemcide: kesitleyiciye giden örnekler işlemciye.
TR_func işlemcide(örnekler: TR_Tensor) -> TR_Tensor { TR_return örnekler.TR_to_device("cpu") }

# çerçeve_örnekleri: mikrofonun 16 bitlik çerçevesi [-1, 1) örneklere; tam sayılar önce işlemciye alınır, çevirme orada.
TR_func çerçeve_örnekleri(parça: TR_Bytes) -> TR_Tensor {
    TR_var tam = TR_from_bytes[TR_Int](parça, TR_dtype: "int16", TR_byte_order: "little").TR_to_device("cpu")
    TR_return TR_Tensor[TR_Float](tam) / 32768.0
}

# kesit_cihazda: kesitleyicinin kesiti yazıya çevrilmeden önce varsayılan cihaza.
TR_func kesit_cihazda(kesit: TR_Tensor) -> TR_Tensor { TR_return kesit.TR_to_device(TR_default_device()) }

TR_const _ÇERÇEVE_MS = 32 # 512 örnek, 16 kHz

# ÇalmaAralığı: bir turun çalma aralığı (saat, ms): ilk çalmanın başından son çalmanın sonuna; çalma yoksa -1.
TR_struct ÇalmaAralığı {
    başı: TR_Int = -1
    sonu: TR_Int = -1
}

# Çapa: çerçeve ile saati eşler. Mikrofon gerçek zamanlıdır: açılıştan bu yana k. çerçeve `fark + k × 32 ms`'de
# biter. Okuma çerçevenin bitişinden önce olamaz; her okumanın `an − k × 32`'si `fark`'ın bir üst sınırıdır, en küçüğü
# en yakınıdır. Tur sürerken gelen çerçeveler tamponda birikir ve tur bitince hemen okunur: o okumalar geç kalmıştır,
# çapayı bozmamalıdır.
TR_struct Çapa {
    fark: TR_Int? = TR_none # turdan önce kurulan çapa; ilk okumaya kadar yok
    aday: TR_Int? = TR_none # son turdan bu yana okumaların en küçük farkı

    TR_func oku(k: TR_Int, an: TR_Int) {
        TR_var f = an - k * _ÇERÇEVE_MS
        TR_var a = TR_self.aday
        TR_if a == TR_none TR_or f < a { TR_self.aday = f }
        TR_if TR_self.fark == TR_none { TR_self.fark = f }
    }

    # kur: turdan hemen önce. Son turdan bu yana okumaların en küçük farkı eski çapadan en çok bir çerçeve geçse
    # yeni çapadır (ses kartının saati sistemin saatinden kayar). Daha geçse o okumaların hepsi tampondandır (tur
    # sürerken konuşulan sözün kesiti, tur bitince okundu): eski çapa kalır.
    TR_func kur() {
        TR_var a = TR_self.aday
        TR_var f = TR_self.fark
        TR_if a != TR_none TR_and (f == TR_none TR_or a <= f + _ÇERÇEVE_MS) { TR_self.fark = a }
        TR_self.aday = TR_none
    }

    # bitiş: k. çerçevenin bittiği an (saat); çapa yoksa -1.
    TR_func bitiş(k: TR_Int) -> TR_Int {
        TR_var f = TR_self.fark
        TR_if f == TR_none { TR_return -1 }
        TR_return f + k * _ÇERÇEVE_MS
    }
}

# Dinleme: canlı kipin döngüsünün parçaları. Mikrofon, kesitleyici, saat ve tur dışarıdan verilir; zincir_test sahte
# olanlarla sınar.
TR_struct Dinleme {
    oku: () -> TR_Tensor? # sıradaki çerçeve; mikrofon bittiyse TR_none; tampon taşarsa hata (21.2)
    aç: () -> TR_NoneType # mikrofonu yeniden açar
    it: (TR_Tensor) -> TR_Tensor? # kesitleyiciye bir çerçeve; kesit bittiyse kesit
    sıfırla: () -> TR_NoneType # kesitleyicinin kalanını atar, dedektörü sıfırlar
    saat: () -> TR_Int
    tur: (TR_Tensor, TR_Int, TR_Bool, TR_Int) -> ÇalmaAralığı # kesit, geldiği an, çalmanın hemen ardından mı, geride kalınan ms
    sürsün: () -> TR_Bool
    kuyruk_ms: TR_Int # çalmanın sonundan sonra atılan süre (yankı)
    ara: () -> Arada = () => Arada() # her çerçeveden önce: ekranlı kipte komutlar, metin turları, mikrofonun açılması
}

# Arada: çerçeveler arasında olan (ekranlı kip). Metin turunun çalma aralığı sesli turunki gibi atılır; mikrofon
# yeniden açıldıysa çapa ve sayaç yeniden kurulur; `dur` dinlemeyi bitirir.
TR_struct Arada {
    aralık: ÇalmaAralığı = ÇalmaAralığı()
    açıldı: TR_Bool = TR_false
    dur: TR_Bool = TR_false
}

# dinle: mikrofon tur boyunca açık kalır; tur sürerken gelen ses 21.2'nin tamponunda birikir, tur bitince okunur.
# - Çalma aralığına (artı kuyruk) düşen çerçeveler kesitleyiciye verilmez. Aralıktan sonraki ilk çerçevede kesitleyici
#   ve dedektör sıfırlanır: çalma başlarken süren söz atılır (söz kesme yok). Aralığın dışındaki ses kaybolmaz; çalmadan
#   önce, hesap sürerken konuşulan söz sonraki turun sözüdür.
# - Taşma (tur tamponu aştı) okumada gelir: mikrofon yeniden açılır, çapa yeniden kurulur, program sürer.
TR_func dinle(d: Dinleme) {
    TR_var çapa = Çapa()
    TR_var k = 0 # mikrofonun son açılışından bu yana okunan çerçeve
    TR_var aralıklar: TR_List[ÇalmaAralığı] = []
    TR_var atlıyor = TR_false
    TR_var verilen = -1 # son aralıktan sonra kesitleyiciye verilen çerçeve; aralık olmadıysa -1
    TR_for {
        TR_var ara = d.ara()
        TR_if ara.aralık.başı >= 0 { aralıklar.TR_append(ara.aralık) }
        TR_if ara.dur { TR_break }
        TR_if ara.açıldı {
            çapa = Çapa()
            k = 0
            atlıyor = TR_false
            d.sıfırla()
        }
        TR_var çerçeve: TR_Tensor? = TR_none
        TR_try {
            çerçeve = d.oku()
        } TR_catch e {
            TR_print("MİKROFON HATASI:", e)
            d.aç()
            çapa = Çapa()
            k = 0
            atlıyor = TR_false
            d.sıfırla()
            TR_continue
        }
        TR_if çerçeve == TR_none { TR_break }
        k += 1
        çapa.oku(k, d.saat())
        TR_var son = çapa.bitiş(k)
        aralıklar = [a TR_for a TR_in aralıklar TR_if a.sonu + d.kuyruk_ms > son - _ÇERÇEVE_MS]
        TR_if çalmada(aralıklar, son, d.kuyruk_ms) {
            atlıyor = TR_true
            TR_continue
        }
        TR_if atlıyor {
            d.sıfırla()
            atlıyor = TR_false
            verilen = 0
        }
        TR_if verilen >= 0 { verilen += 1 }
        TR_var kesit = d.it(çerçeve)
        TR_if kesit == TR_none { TR_continue }
        çapa.kur()
        TR_var an = d.saat()
        # Kesit aralıktan sonraki ilk çerçevede başladıysa (kesitleyicinin ön payı aralığın sonuna dayandı) çalmanın
        # hemen ardındandır: yankı ya da çalma sırasında başlamış söz.
        TR_var hemen = verilen >= 0 TR_and verilen - kesit.TR_shape[0] // _ÇERÇEVE <= 0
        TR_var a = d.tur(kesit, an, hemen, TR_max(0, an - çapa.bitiş(k)))
        TR_if a.başı >= 0 { aralıklar.TR_append(a) }
        TR_if TR_not d.sürsün() { TR_break }
    }
}

# çalmada: çerçeve (sonu `son`, 32 ms) bir çalma aralığıyla (artı kuyruk) kesişiyor mu.
TR_func çalmada(aralıklar: TR_List[ÇalmaAralığı], son: TR_Int, kuyruk_ms: TR_Int) -> TR_Bool {
    TR_for a TR_in aralıklar {
        TR_if a.başı < son TR_and son - _ÇERÇEVE_MS < a.sonu + kuyruk_ms { TR_return TR_true }
    }
    TR_return TR_false
}

# token_hızı: ilk parçadan sonraki üretimin hızı (parça/sn, bir ondalık); ölçülemezse -1.
TR_func token_hızı(t: Tur) -> TR_Float {
    TR_var süre = t.cevap_ms - t.ilk_parça_ms
    TR_if t.ilk_parça_ms < 0 TR_or t.üretilen <= 1 TR_or süre <= 0 { TR_return -1.0 }
    TR_return TR_round(TR_Float(t.üretilen - 1) * 1000.0 / TR_Float(süre) * 10.0) / 10.0
}
