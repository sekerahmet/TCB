# TR 4
# Yuvanın, kurulu takımın ve yükleme işaretinin modelsiz sınaması (yuva.tr). Katalog elle kurulur: dosyalar birkaç
# baytlık "x"; katalogun sha256'sı bu içerikten. Oturumun ses yolu da bu fikstürle sınanır (DENETİM 911 Ş1). Kaydın ve karmanın ayrıntısı indirme_test.tr'de.
TR_import "katalog"
TR_import "ayarlar"
TR_import "yuva"
TR_import "zincir"
TR_import "ekran"
TR_import "screen_helpers"
TR_import "oturum"

TR_func _dosya(target: TR_String, bayt: TR_Int) -> TR_JSON {
    TR_return TR_JSON({"path": target, "target": target, "bytes": bayt, "sha256": TR_sha256(TR_Bytes("x" * bayt))})
}

TR_func _ham_katalog() -> TR_JSON {
    TR_return TR_JSON({"entries": [
        {"id": "dm", "kind": "language_model", "name": "dm", "source": {"revision": "r", "files": [_dosya("dm.gguf", 4)]}},
        {"id": "dm2", "kind": "language_model", "name": "dm2", "source": {"revision": "r", "files": [_dosya("dm2.gguf", 4)]}},
        {"id": "yaz", "kind": "transcriber", "name": "yaz", "source": {"revision": "r", "files": [_dosya("config.json", 2), _dosya("model.safetensors", 3)]}},
        {"id": "vad", "kind": "vad", "name": "vad", "source": {"revision": "r", "files": [_dosya("vad.safetensors", 1)]}},
        {"id": "ses-tr", "kind": "voice", "name": "ses-tr", "source": {"revision": "r", "files": [_dosya("model.safetensors", 2)]}},
        {"id": "ses-en", "kind": "voice", "name": "ses-en", "source": {"revision": "r", "files": [_dosya("model.safetensors", 2)]}},
        {"id": "piper-tr", "kind": "voice", "name": "piper-tr", "source": {"revision": "r", "files": [_dosya("p.onnx", 3), _dosya("p.onnx.json", 1)]}}],
        "languages": [
            {"code": "tr", "whisper_language": "tr", "transcriber": "yaz", "voices": ["ses-tr", "piper-tr"], "system_prompt": "Türkçe cevap ver."},
            {"code": "en", "whisper_language": "en", "transcriber": "yaz", "voices": ["ses-en"], "system_prompt": "Answer in English."}]})
}

TR_func _katalog() -> Katalog {
    TR_var k = Katalog(girdiler: [], diller: [])
    TR_for g TR_in _ham_katalog()["entries"] {
        k.girdiler.TR_append(Girdi(kimlik: TR_String(g["id"]), tür: TR_String(g["kind"]), ağırlık: 0, katman: 0, kv_başlık: 0,
            başlık_boyu: 0, bağlam_sınırı: 0, ölçüler: []))
    }
    TR_return k
}

TR_func _ayar(dil: TR_String, sistem: TR_JSON) -> Ayar {
    TR_return Ayar(dil_modeli: "dm", konuşma_dili: dil, sistem: sistem, bağlam: 8192, kapı: 0)
}

# _kur: girdinin dosyalarını Dost klasörüne katalogdaki boylarıyla yazar.
TR_func _kur(klasör: TR_String, kimlik: TR_String) {
    TR_for g TR_in _ham_katalog()["entries"] {
        TR_if TR_String(g["id"]) != kimlik { TR_continue }
        TR_var k = girdi_klasörü(klasör, kimlik)
        TR_make_dir(k)
        TR_for f TR_in g["source"]["files"] { TR_write_file(TR_String(TR_Path(k, TR_String(f["target"]))), "x" * TR_Int(f["bytes"])) }
    }
}

TR_func _klasör() -> TR_String { TR_return TR_String(TR_Path(TR_temp_dir(), "Dost")) }

TR_test "kurulu: her dosyası katalogun boyu ve sha256'sıyla duran girdi kurulu; eksik dosya, boyu tutmayan dosya ve katalogda olmayan girdi kurulu değil" {
    TR_var d = _klasör()
    TR_var kj = _ham_katalog()
    TR_assert(TR_not kurulu(kj, d, "yaz"))
    _kur(d, "yaz")
    TR_assert(kurulu(kj, d, "yaz"))
    TR_remove(TR_String(TR_Path(girdi_klasörü(d, "yaz"), "config.json")))
    TR_assert(TR_not kurulu(kj, d, "yaz"))
    _kur(d, "yaz")
    TR_write_file(TR_String(TR_Path(girdi_klasörü(d, "yaz"), "model.safetensors")), "xx")
    TR_assert(TR_not kurulu(kj, d, "yaz"))
    TR_assert(TR_not kurulu(kj, d, "olmayan"))
}

TR_test "takım: katalogda olmayan ya da dil modeli olmayan giriş unknown_entry; eksik girdi not_installed, kimliğiyle" {
    TR_var d = _klasör()
    TR_var k = _katalog()
    TR_var kj = _ham_katalog()
    TR_var a = _ayar("tr", TR_JSON({"source": "catalog"}))
    TR_var c = takım_kur(k, kj, d, "olmayan", a)
    TR_assert_equal("unknown_entry", c.kod)
    TR_assert_equal("olmayan", TR_String(c.değerler["entry_id"]))
    TR_assert_equal("unknown_entry", takım_kur(k, kj, d, "yaz", a).kod)
    _kur(d, "dm")
    _kur(d, "yaz")
    _kur(d, "vad")
    c = takım_kur(k, kj, d, "dm", a)
    TR_assert_equal("not_installed", c.kod)
    TR_assert_equal("ses-tr", TR_String(c.değerler["entry_id"]))
    TR_assert(c.takım == TR_none)
}

TR_test "takım: kurulu takımın yolları Dost klasöründe; sistem iletisi dilin tablosundan ya da kullanıcının" {
    TR_var d = _klasör()
    TR_for kimlik TR_in ["dm", "yaz", "vad", "ses-tr", "ses-en"] { _kur(d, kimlik) }
    TR_var c = takım_kur(_katalog(), _ham_katalog(), d, "dm", _ayar("en", TR_JSON({"source": "catalog"})))
    TR_assert_equal("", c.kod)
    TR_var t = c.takım
    TR_assert_equal("dm", t.giriş)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "dm", "dm.gguf")), t.dil_modeli)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "yaz")), t.yazıcı)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "vad", "vad.safetensors")), t.vad)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "ses-en")), t.ses)
    TR_assert_equal("en", t.dil)
    TR_assert_equal("Answer in English.", t.sistem)
    TR_var u = takım_kur(_katalog(), _ham_katalog(), d, "dm", _ayar("tr", TR_JSON({"source": "user", "text": "Kısa yaz.", "language": "tr"})))
    TR_assert_equal("Kısa yaz.", u.takım.sistem)
}

TR_test "işaret: yazılır ve geçici dosya kalmaz; açılışta okunur ve silinir; yoksa yok" {
    TR_var d = _klasör()
    TR_assert(TR_not işareti_al(d).var)
    işaret_yaz(d, "dm")
    TR_assert(TR_Path(işaret_yolu(d)).TR_exists)
    TR_assert(TR_not TR_Path("\(işaret_yolu(d)).tmp").TR_exists)
    TR_var j = TR_json_parse(TR_read_file(işaret_yolu(d)))
    TR_assert_equal("dm", TR_String(j["entry"]))
    TR_assert(TR_String(j["started_at"]).TR_ends_with("Z"))
    TR_var i = işareti_al(d)
    TR_assert(i.var)
    TR_assert_equal("dm", i.giriş)
    TR_assert(TR_not TR_Path(işaret_yolu(d)).TR_exists)
}

TR_test "işaret: bozuk, JSON olmayan ya da girdisiz işaret yarıda kalmış yüklemedir, girdisizdir, silinir" {
    TR_var d = _klasör()
    TR_make_dir(d)
    TR_for içerik TR_in ["", "{bozuk", "[1, 2]", "{\"entry\": 5}", "{}"] {
        TR_write_file(işaret_yolu(d), içerik)
        TR_var i = işareti_al(d)
        TR_assert(i.var)
        TR_assert(i.giriş == TR_none)
        TR_assert(TR_not TR_Path(işaret_yolu(d)).TR_exists)
    }
}

TR_test "utc_yazısı: RFC 3339, UTC, saniyeye kadar; artık gün ve yüzyıl sonu" {
    TR_assert_equal("1970-01-01T00:00:00Z", utc_yazısı(0))
    TR_assert_equal("2000-02-29T00:00:00Z", utc_yazısı(951782400000))
    TR_assert_equal("2025-11-12T01:02:03Z", utc_yazısı(1762909323999))
    TR_assert_equal("2099-12-31T23:59:59Z", utc_yazısı(4102444799000))
}

# Kutu: programın modeli tuttuğu tek alanın yerine.
TR_struct Kutu {
    içerik: TR_String? = TR_none
}

TR_func _takım(giriş: TR_String) -> Takım {
    TR_return Takım(giriş: giriş, dil_modeli: "", yazıcı: "", vad: "", ses: "", dil: "tr", sistem: "")
}

TR_test "yükle: yuva önce boşalır, işaret yükleme sürerken durur; başarıda sonuç yuvada, işaret yok" {
    TR_var d = _klasör()
    TR_var y = Yuva(takım: _takım("dm"))
    TR_var kutu = Kutu(içerik: "eski")
    TR_var bakış = 0
    TR_var sırasında = ""
    TR_var h = yükle(y, d, _takım("dm2"), () => { kutu.içerik = TR_none }, (t) => {
        sırasında = "\(kutu.içerik == TR_none) \(y.takım == TR_none) \(TR_Path(işaret_yolu(d)).TR_exists)"
        TR_sleep(0.05)
        kutu.içerik = "yeni " + t.giriş
    }) {
        bakış += 1
        TR_sleep(0.005)
    }
    TR_assert(h == TR_none)
    TR_assert_equal("true true true", sırasında)
    TR_assert_equal("yeni dm2", kutu.içerik)
    TR_assert_equal("dm2", y.takım.giriş)
    TR_assert(bakış > 0)
    TR_assert(TR_not TR_Path(işaret_yolu(d)).TR_exists)
}

TR_test "yükle: görevin hatası yakalanır, program sürer; yuva boş, işaret yok, hata döner" {
    TR_var d = _klasör()
    TR_var y = Yuva(takım: _takım("dm"))
    TR_var kutu = Kutu(içerik: "eski")
    TR_var h = yükle(y, d, _takım("dm2"), () => { kutu.içerik = TR_none }, (t) => { TR_throw "dosya okunamadı" }) { TR_sleep(0.005) }
    TR_assert(h != TR_none)
    TR_assert(h.TR_contains("dosya okunamadı"))
    TR_assert(kutu.içerik == TR_none)
    TR_assert(y.takım == TR_none)
    TR_assert(TR_not TR_Path(işaret_yolu(d)).TR_exists)
}

TR_test "dil_cevapları: kullanıcının başka dil için iletisi system_prompt_language; yazıcısı ya da sesi kurulu olmayan dil not_installed" {
    TR_var d = _klasör()
    TR_for kimlik TR_in ["dm", "yaz", "vad", "ses-tr"] { _kur(d, kimlik) }
    TR_var c = dil_cevapları(_ham_katalog(), d, _ayar("tr", TR_JSON({"source": "catalog"})))
    TR_assert_equal(0, TR_Dict(c["tr"]).TR_length)
    TR_assert_equal("not_installed", TR_String(c["en"]["code"]))
    TR_assert_equal("ses-en", TR_String(c["en"]["values"]["entry_id"]))
    TR_var u = dil_cevapları(_ham_katalog(), d, _ayar("tr", TR_JSON({"source": "user", "text": "Kısa yaz.", "language": "tr"})))
    TR_assert_equal(0, TR_Dict(u["tr"]).TR_length)
    TR_assert_equal("setting_invalid", TR_String(u["en"]["code"]))
    TR_assert_equal("system_prompt_language", TR_String(u["en"]["values"]["reason"]))
}

TR_test "dil_takımı: yeni dilin yazıcısı, sesi, Whisper dili ve katalogun iletisi; dil modeli ve VAD aynı" {
    TR_var d = _klasör()
    TR_var t = Takım(giriş: "dm", dil_modeli: "dm.gguf", yazıcı: "eski-yaz", vad: "vad.safetensors", ses: "eski-ses", dil: "tr", sistem: "Türkçe cevap ver.")
    TR_var y = dil_takımı(t, _ham_katalog(), d, _ayar("en", TR_JSON({"source": "catalog"})))
    TR_assert_equal("dm.gguf", y.dil_modeli)
    TR_assert_equal("vad.safetensors", y.vad)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "yaz")), y.yazıcı)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "ses-en")), y.ses)
    TR_assert_equal("en", y.dil)
    TR_assert_equal("Answer in English.", y.sistem)
    TR_assert_equal("Brief.", dil_takımı(t, _ham_katalog(), d, _ayar("en", TR_JSON({"source": "user", "text": "Brief.", "language": "en"}))).sistem)
}

TR_test "dil_değiştir: yeni modeller yüklenemezse hiçbir şey değişmez; yüklenirse uygulanır ve takım yuvaya girer" {
    TR_var y = Yuva(takım: _takım("dm"))
    TR_var uygulandı = 0
    TR_var yeni = Takım(giriş: "dm", dil_modeli: "", yazıcı: "", vad: "", ses: "ses-en", dil: "en", sistem: "")
    TR_var h = dil_değiştir(y, yeni, (t) => { TR_throw "ses okunamadı" }) { uygulandı += 1 }
    TR_assert(h != TR_none)
    TR_assert(h.TR_contains("ses okunamadı"))
    TR_assert_equal(0, uygulandı)
    TR_assert_equal("tr", y.takım.dil)
    TR_assert(dil_değiştir(y, yeni, (t) => {}) { uygulandı += 1 } == TR_none)
    TR_assert_equal(1, uygulandı)
    TR_assert_equal("en", y.takım.dil)
}

TR_test "açılış olayları: istenen gpu kullanılan cpu ise compute_device_unavailable (device gpu); ikisi aynıysa yok; yarıda kalan yükleme model_load_failed, sırası cihazdan sonra" {
    TR_var yok = açılış_olayları(İşaret(), "cpu", "cpu")
    TR_assert_equal(0, yok.TR_length)
    TR_assert_equal(0, açılış_olayları(İşaret(), "gpu", "gpu").TR_length)
    TR_var l = açılış_olayları(İşaret(), "gpu", "cpu")
    TR_assert_equal(1, l.TR_length)
    TR_assert_equal("compute_device_unavailable", TR_String(l[0]["code"]))
    TR_assert_equal("gpu", TR_String(l[0]["values"]["device"]))
    TR_assert(TR_not TR_Bool(l[0]["fatal"]))
    TR_var iki = açılış_olayları(İşaret(var: TR_true, giriş: "qwen3-4b-q4km"), "gpu", "cpu")
    TR_assert_equal(["compute_device_unavailable", "model_load_failed"], [TR_String(iki[0]["code"]), TR_String(iki[1]["code"])])
    TR_assert_equal("qwen3-4b-q4km", TR_String(iki[1]["values"]["model"]))
    TR_var bozuk = açılış_olayları(İşaret(var: TR_true), "cpu", "cpu")
    TR_assert_equal(1, bozuk.TR_length)
    TR_assert(bozuk[0]["values"].TR_get("model") == TR_none)
}

# Dost katalog K-9: önbellek istenenden küçük kurulduysa ölümcül olmayan context_limited; ekranın sınırı seçili modelinki.
TR_test "bağlam_olayı: iniş varsa context_limited (context, limit), yoksa yok; bağlam_sınırı seçili modelin context_max'ı" {
    TR_var o = bağlam_olayı(65536, 40960)
    TR_assert(o != TR_none)
    TR_assert_equal("{\"code\":\"context_limited\",\"values\":{\"context\":65536,\"limit\":40960},\"fatal\":false}", TR_json_string(o))
    TR_assert(bağlam_olayı(8192, 8192) == TR_none TR_and bağlam_olayı(0, 40960) == TR_none)
    TR_var k = katalog_oku("tools/assistant/katalog.json")
    TR_assert_equal([40960, 131072, 40960, 131072, 131072, 131072], [bağlam_sınırı(k, "qwen3-4b-q4km"), bağlam_sınırı(k, "gemma3-4b-q4km"),
        bağlam_sınırı(k, "qwen3-8b-q4km"), bağlam_sınırı(k, "gemma3-12b-q4km"), bağlam_sınırı(k, ""), bağlam_sınırı(k, "yok")])
    TR_assert_equal(0, bağlam_sınırı(Katalog(girdiler: [], diller: []), "qwen3-4b-q4km"))
}

# DENETİM 863 N1: küçük bağlamda gereken (küçükler hariç) modelin ölçülü nokta 1'inin altına inmez (Qwen3-4B, depodaki
# katalog: kv'yle inen doğru bağlam 128'de 4 065 910 784 verirdi, nokta 1 4 275 568 640).
TR_test "gereken: Qwen3-4B'de bağlam 128'de küçükler hariç nokta 1'in altına inmez; 8192'de doğru değişmez" {
    TR_var g = girdi_bul(katalog_oku("tools/assistant/katalog.json"), "qwen3-4b-q4km")
    TR_var hiç = Bellek(bayt: 0, ölçülü: TR_true)
    TR_assert_equal(4275568640, g.ölçüler[0].özel)
    TR_assert(gereken(g, 128, hiç) >= g.ölçüler[0].özel)
    TR_assert_equal(4275568640, gereken(g, 128, hiç))
    TR_assert_equal(5270364160 + 294912 * (8192 - 7981) + 294912 * 8192 + PAY, gereken(g, 8192, hiç))
}

TR_test "ses: kurulu seçim, yoksa ilk kurulu, yoksa ilk; seçili ses silinince öbür kurulu ses, yeniden inince seçim; başka dile geçince o dilin sesi" {
    TR_var d = _klasör()
    TR_var kj = _ham_katalog()
    TR_var a = _ayar("tr", TR_JSON({"source": "catalog"}))
    TR_assert_equal(["ses-tr", "piper-tr"], dilin_sesleri(kj, "tr"))
    TR_assert_equal("ses-tr", dilin_sesi(kj, d, a, "tr")) # hiçbiri kurulu değil: ilki
    a.sesler["tr"] = "piper-tr"
    TR_assert_equal("ses-tr", dilin_sesi(kj, d, a, "tr")) # seçim kurulu değil: yok sayılır
    _kur(d, "piper-tr")
    TR_assert_equal("piper-tr", dilin_sesi(kj, d, a, "tr"))
    TR_assert_equal("piper-tr", dilin_sesi(kj, d, _ayar("tr", TR_JSON({"source": "catalog"})), "tr")) # seçimsiz: ilk kurulu
    _kur(d, "ses-tr")
    TR_assert_equal("ses-tr", dilin_sesi(kj, d, _ayar("tr", TR_JSON({"source": "catalog"})), "tr"))
    TR_assert_equal("piper-tr", dilin_sesi(kj, d, a, "tr"))
    TR_assert_equal("ses-tr", yedek_ses(kj, d, "tr", "piper-tr"))
    TR_assert(yedek_ses(kj, d, "en", "ses-en") == TR_none)
    # Seçili ses silinince öbür kurulu ses; seçim ayarda kalır, ses yeniden inince döner.
    TR_remove(TR_String(TR_Path(girdi_klasörü(d, "piper-tr"), "p.onnx")))
    TR_assert_equal("ses-tr", dilin_sesi(kj, d, a, "tr"))
    TR_assert_equal("piper-tr", a.sesler["tr"])
    TR_assert_equal(0, kurulu_seçimler(kj, d, a).sesler.TR_length)
    _kur(d, "piper-tr")
    TR_assert_equal("piper-tr", dilin_sesi(kj, d, a, "tr"))
    TR_assert_equal(1, kurulu_seçimler(kj, d, a).sesler.TR_length)
    # Başka dile geçince o dilin sesi; dil_takımı ve takım_girdileri de buradan alır.
    _kur(d, "ses-en")
    TR_assert_equal("ses-en", dilin_sesi(kj, d, a, "en"))
    TR_var t = Takım(giriş: "dm", dil_modeli: "dm.gguf", yazıcı: "y", vad: "v", ses: "s", dil: "tr", sistem: "")
    TR_var en = _ayar("en", TR_JSON({"source": "catalog"}))
    en.sesler = a.sesler
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "ses-en")), dil_takımı(t, kj, d, en).ses)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "piper-tr", "p.onnx")), dil_takımı(t, kj, d, a).ses)
    TR_assert_equal("piper-tr", takım_girdileri(_katalog(), kj, d, "dm", a)[3])
    TR_assert_equal("ses-en", takım_girdileri(_katalog(), kj, d, "dm", en)[3])
    # Dilin cevapları seçilen sesi sınar; sesin cevapları kurulu olmayanı not_installed sayar.
    _kur(d, "yaz")
    TR_assert_equal(["{}", "{}"], [TR_json_string(dil_cevapları(kj, d, a)[k]) TR_for k TR_in ["tr", "en"]])
    TR_var c = ses_cevapları(kj, d, "tr")
    TR_assert_equal(["{}", "{}"], [TR_json_string(c["ses-tr"]), TR_json_string(c["piper-tr"])])
    TR_remove(TR_String(TR_Path(girdi_klasörü(d, "ses-tr"), "model.safetensors")))
    TR_assert_equal("not_installed", TR_String(ses_cevapları(kj, d, "tr")["ses-tr"]["values"]["reason"]))
    TR_assert(ses_cevapları(kj, d, "tr").TR_get("ses-en") == TR_none)
}

TR_test "takım: Piper sesinin yolu .onnx dosyası; .onnx.json'u eksik ses kurulu değil" {
    TR_var d = _klasör()
    TR_var kj = _ham_katalog()
    TR_for kimlik TR_in ["dm", "yaz", "vad", "piper-tr"] { _kur(d, kimlik) }
    TR_var a = _ayar("tr", TR_JSON({"source": "catalog"}))
    TR_var c = takım_kur(_katalog(), kj, d, "dm", a)
    TR_assert_equal("", c.kod)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "piper-tr", "p.onnx")), c.takım.ses)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "ses-tr")), ses_yolu(kj, d, "ses-tr"))
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "piper-tr", "p.onnx")), ses_takımı(c.takım, ses_yolu(kj, d, "piper-tr")).ses)
    TR_remove(TR_String(TR_Path(girdi_klasörü(d, "piper-tr"), "p.onnx.json")))
    TR_assert(TR_not kurulu(kj, d, "piper-tr"))
    c = takım_kur(_katalog(), kj, d, "dm", a)
    TR_assert_equal("not_installed", c.kod)
}

TR_func _kur_yok(t: Takım) -> Asistan { TR_throw "sınamada model yüklenmez" }
TR_func _mikrofon_yok(b: TR_Int) -> TR_Process { TR_throw "sınamada mikrofon yok" }
TR_func _tur_yok(a: Asistan, k: TR_Tensor?, s: TR_String?, t0: TR_Int, b: TR_Bool, g: TR_Int, i: () -> TR_NoneType,
    kd: (Tur, TR_String, TR_Int, TR_String, TR_String) -> TR_NoneType) -> ÇalmaAralığı { TR_return ÇalmaAralığı() }

# _sesli_oturum: fikstür katalogla, takımı Dost klasöründe kurulu ve yuvada yüklü bir oturum (ses ses-tr). Ses değişimi
# model yüklemeden yuvanın takımını değiştirir (`ses_değiştirici`; gerçek yol `sesi_uygula`).
TR_func _sesli_oturum(d: TR_String) -> Oturum {
    TR_for kimlik TR_in ["dm", "yaz", "vad", "ses-tr"] { _kur(d, kimlik) }
    TR_var k = _katalog()
    k.diller = [Dil(kod: "tr", yazıcı: "yaz", sesler: ["ses-tr", "piper-tr"]), Dil(kod: "en", yazıcı: "yaz", sesler: ["ses-en"])]
    TR_var kj = _ham_katalog()
    TR_var a = _ayar("tr", TR_JSON({"source": "catalog"}))
    TR_var t = takım_kur(k, kj, d, "dm", a).takım
    TR_var o = Oturum(e: ekran(), k: k, kj: kj, klasör: d, etkin: a, ayar_verisi: TR_none, y: Yuva(takım: t), yüklü: Yüklü(),
        en_çok_tur: 0, kuyruk_ms: 0, çerçeve_bayt: 1024, açılış: 0, kur: _kur_yok, mikrofon_aç: _mikrofon_yok, tur: _tur_yok)
    o.ses_değiştirici = (yt) => (dil_değiştir(o.y, yt, (x) => {}) {})
    o.e.yüklenebilir = yüklenebilirler(k, kj, d, a) # açılıştaki gibi: takım kurulu, iniş yeniden yükletmez
    o.e.kayıt = TR_true # gönderilen olaylar `e.giden`'de
    TR_return o
}

TR_test "oturum: seçili ses inince yüklü ses ona geçer (tur bitince); silinince dilin öbür sesine geçer, setup yok; ayrışma kalmaz; silmeden sonra ikinci yükleme yok" {
    TR_var d = _klasör()
    TR_var o = _sesli_oturum(d)
    TR_var piper = TR_String(TR_Path(d, "modeller", "piper-tr", "p.onnx"))
    TR_var mms = TR_String(TR_Path(d, "modeller", "ses-tr"))
    TR_var yüklenen: TR_List[TR_String] = [] # her ses yüklemesi (DENETİM 913 Not 2)
    o.ses_değiştirici = (yt) => {
        yüklenen.TR_append(yt.ses)
        TR_return (dil_değiştir(o.y, yt, (x) => {}) {})
    }
    o.etkin.sesler["tr"] = "piper-tr" # seçim var, ses inmemiş: yok sayılır
    TR_assert_equal(mms, o.y.takım.ses)
    TR_assert(TR_not o.yüklü_takımda("piper-tr"))
    # Piper iner: tur sürerken ses değişmez, tur bitince geçer.
    _kur(d, "piper-tr")
    o.e.tur = "t-1"
    o.indirme_bitti()
    o.işle()
    TR_assert_equal(mms, o.y.takım.ses)
    # Ayrışma penceresi: dilin sesi Piper, konuşan MMS; Piper yüklü takımda sayılmaz (`[0..3]` sesi almaz).
    TR_assert(TR_not o.yüklü_takımda("piper-tr") TR_and o.yüklü_takımda("ses-tr"))
    TR_assert_equal(0, yüklenen.TR_length)
    o.e.tur = ""
    o.işle()
    TR_assert_equal(piper, o.y.takım.ses)
    TR_assert(o.yüklü_takımda("piper-tr") TR_and TR_not o.yüklü_takımda("ses-tr"))
    TR_assert_equal([piper], yüklenen)
    TR_var son = [g TR_for g TR_in o.e.giden TR_if TR_String(g["type"]) == "catalog"]
    TR_var l = TR_List(son[son.TR_length - 1]["data"]["entries"])
    TR_assert_equal("[\"tr\"]", TR_json_string([x TR_for x TR_in l TR_if TR_String(x["id"]) == "piper-tr"][0]["selected_for"]))
    # Seçili ve yüklü Piper silinir: dilin öbür kurulu sesine geçilir, takım kalır, durum setup olmaz; seçim ayarda kalır.
    o.modeli_sil("piper-tr")
    TR_assert(o.y.takım != TR_none)
    TR_assert_equal(mms, o.y.takım.ses)
    TR_assert(TR_not kurulu(o.kj, d, "piper-tr"))
    TR_assert_equal("piper-tr", o.etkin.sesler["tr"])
    TR_assert_equal(0, [g TR_for g TR_in o.e.giden TR_if TR_String(g["type"]) == "state" TR_and TR_String(g["data"]["state"]) == "setup"].TR_length)
    # Silmeden sonraki eşitleme aynı sese bakar: MMS bir kez yüklenir (yedek_sese_geç), ikinci yükleme olmaz.
    o.işle()
    TR_assert_equal(mms, o.y.takım.ses)
    TR_assert_equal([piper, mms], yüklenen)
    # Yeniden inince seçim döner, yüklü ses de.
    _kur(d, "piper-tr")
    o.indirme_bitti()
    o.işle()
    TR_assert_equal(piper, o.y.takım.ses)
    TR_assert_equal([piper, mms, piper], yüklenen)
}

TR_test "oturum: yüklü olmayan sesi silmek takımı bırakmaz; dilin tek kurulu sesini silmek bırakır" {
    TR_var d = _klasör()
    TR_var o = _sesli_oturum(d)
    _kur(d, "piper-tr") # kurulu, seçili değil (seçimsiz dilde ilk kurulu ses ses-tr)
    TR_assert(TR_not o.yüklü_takımda("piper-tr"))
    o.modeli_sil("piper-tr")
    TR_assert(o.y.takım != TR_none)
    TR_assert_equal(TR_String(TR_Path(d, "modeller", "ses-tr")), o.y.takım.ses)
    TR_assert(o.yüklü_takımda("ses-tr"))
    o.modeli_sil("ses-tr") # dilin başka kurulu sesi yok: takım bırakılır
    TR_assert(o.y.takım == TR_none)
}
