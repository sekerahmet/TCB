# TR 4
# Zincirin gerçek modelsiz parçaları: cümlelere bölme, cümle akışı, rakam, önbelleğin kapasitesi ve ortak öneki (B.4), sistem iletisinin önceden okunması, cümlelerin sırayla çalınması ve çalınan sesin silinmesi, dinleme (çalma aralığı, çapa, taşma).
TR_import "tr/chat"
TR_import "zincir"

TR_func parçalayıcı() -> TR_Tokenizer { TR_return TR_load_tokenizer("../../tests/data/qwen3_chat/tokenizer.json") }

TR_test "cevap cümlelere bölünür: nokta, soru, ünlem ve satır sonunda; boş parça atılır" {
    TR_assert_equal(["Merhaba.", "Nasılsın?", "İyiyim!"], cümleler("Merhaba. Nasılsın? İyiyim!"))
    TR_assert_equal(["bir", "iki"], cümleler("bir\n\niki"))
    TR_assert_equal(["noktasız cümle"], cümleler("  noktasız cümle "))
    TR_assert_equal(0, cümleler("").TR_length)
    TR_assert_equal(0, cümleler(" . \n").TR_length)
}

# Qwen3-4B Q4_K_M'nin on soruya verdiği cevaplar (S1 zincir dilimi, dosya ve sahte mikrofon koşularının
# `--kimlik_dosyası` satırları Qwen3'ün parçalayıcısıyla çözüldü; sorular sentetik ses). Depodaki parçalayıcının
# dağarcığı küçük: metin onunla yeniden kodlanır, Türkçe harfler ve işaretler baytlara bölünür, akışın yarım
# UTF-8 yolu da sınanır.
TR_const _CEVAPLAR = [
    "Merhaba! Bugünkü durumum iyi. Ne hakkında yardımcı olabilirim?",
    "Bir haftada 7 gün vardır.",
    "İstanbul Türkiye'de yer alır.",
    "Kahvaltıda light bir yemek yiyebilirsin. Örneğin, buzdolabında bir çorba veya salata yiyebilirsin.",
    "1 saat 60 dakikadır.",
    "Yağmur yağarken dışarı çıkarsan, bir kablodan veya kablolu bir kıyafet almalısın. Ayrıca, gözlerini korumak için gözlüksüz olmamalısın.",
    "3 vartı 4, 7 eder.",
    "İşte bir şaka: \"Ne zaman bir şeyi yapmak istiyorsun, ama yapamıyorsun, o zaman ne yapmalısın? Yapman gerek.\" 😄",
    "Bir yılda 12 ay vardır.",
    "Teşekkür ederim, iyi geceler. 😊",
    "3 vartı 4 eder.",
    "İşte bir şaka: \"Ne zaman bir şeyi unutursun, onu unutma.\"",
    "Teşekkür ederim. İyi bir gün dilerim."
]

TR_func son_sınır(m: TR_String) -> TR_Int {
    TR_var son = -1
    TR_for i TR_in 0..m.TR_length {
        TR_if ".!?…\n".TR_contains(m[i]) { son = i }
    }
    TR_return son
}

# akıt: kimlikleri akışa sırayla verir; her sınır geldiği kimlikte verilmiş olmalı.
TR_func akıt(a: CümleAkışı, kimlikler: TR_List[TR_Int]) -> TR_List[TR_String] {
    TR_var akan: TR_List[TR_String] = []
    TR_for k TR_in kimlikler {
        akan += a.ekle(k)
        TR_assert_equal(son_sınır(a.metin) + 1, a.söylenen)
    }
    TR_return akan
}

TR_test "akan cümlelerin birleşimi cevabın içeriğinin cümleleridir" {
    TR_var p = parçalayıcı()
    TR_for metin TR_in _CEVAPLAR {
        TR_var kimlikler = p.TR_encode(metin, TR_special_tokens: TR_false)
        TR_var a = cümle_akışı(p)
        TR_var akan = akıt(a, kimlikler)
        TR_var cevap, hatalar = TR_qwen3_reply(p, kimlikler)
        TR_assert_equal(0, hatalar.TR_length)
        TR_var kalan = a.bitir(cevap.TR_content)
        TR_assert(kalan != TR_none)
        TR_assert_equal(cümleler(cevap.TR_content), akan + kalan)
        TR_assert_equal(akan + kalan, a.verilen)
    }
}

# "…" bu parçalayıcıda üç bayt kimliğidir: ilk ikisinden sonra metnin sonu U+FFFD'dir, üçüncüsüyle sınır olur.
TR_test "akış sınırla bitmeyen son parçayı bekletir, cevap bitince verir" {
    TR_var p = parçalayıcı()
    TR_var a = cümle_akışı(p)
    TR_var akan = akıt(a, p.TR_encode("Bir… İki? Üç ve dört", TR_special_tokens: TR_false))
    TR_assert_equal(["Bir…", "İki?"], akan)
    TR_assert_equal(["Üç ve dört"], a.bitir("Bir… İki? Üç ve dört"))
}

TR_test "etiket kimliği akışı durdurur; söylenen cevaptan ayrıldıysa kalan verilmez" {
    TR_var p = parçalayıcı()
    TR_var a = cümle_akışı(p)
    TR_var akan: TR_List[TR_String] = []
    TR_for k TR_in p.TR_encode("Evet. <tool_call>Hayır.", TR_special_tokens: TR_true) { akan += a.ekle(k) }
    TR_assert_equal(["Evet."], akan)
    TR_assert(a.durdu)
    TR_assert_equal(["Hayır."], a.bitir("Evet. Hayır."))
    TR_var b = cümle_akışı(p)
    TR_for k TR_in p.TR_encode("Bir. İki.", TR_special_tokens: TR_false) { b.ekle(k) }
    TR_assert_equal(TR_none, b.bitir("Başka. İki."))
}

TR_test "rakam satırı: içerikte rakam var mı" {
    TR_assert(rakamlı("Saat 5."))
    TR_assert(TR_not rakamlı("Saat beş."))
    TR_assert(TR_not rakamlı(""))
}

TR_test "önbellek modelin bağlamını değil zincirin bağlamını ayırır" {
    TR_var m = TR_GPT(16, TR_context: 64, TR_embed_dim: 8, TR_num_layers: 1, TR_num_heads: 2, TR_seed: 1)
    TR_var ö = önbellek_kur(m, 8)
    TR_assert_equal(8, ö.TR_capacity)
    TR_no_grad { m.TR_hidden_states([[1, 2, 3, 4, 5, 6, 7, 8]], TR_cache: ö) }
    TR_assert_equal(8, ö.TR_position)
    TR_assert_equal("H6909", TR_error_code { TR_no_grad { m.TR_hidden_states([[9]], TR_cache: ö) } })
}

TR_const _SİSTEM = "Kısa ve Türkçe cevap ver."

# küçük_zincir: depodaki parçalayıcı ve rastgele ağırlıklı küçük bir GPT; sesin modelleri gerekmez.
TR_func küçük_zincir(bağlam: TR_Int, önbelleksiz: TR_Bool) -> Zincir {
    TR_var p = parçalayıcı()
    TR_var m = TR_GPT(p.TR_vocab_size, TR_context: 512, TR_embed_dim: 16, TR_num_layers: 2, TR_num_heads: 2, TR_seed: 7)
    TR_var z = Zincir(p: p, model: m, sistem: _SİSTEM, en_çok: 8, bağlam: bağlam, önbelleksiz: önbelleksiz)
    z.yeni_konuşma()
    TR_return z
}

TR_func ilk_tur(z: Zincir, t: Tur) -> TR_List[TR_Int] {
    z.geçmiş.TR_append(TR_ChatMessage(TR_role: TR_Role.TR_User, TR_content: "Merhaba, nasılsın?"))
    TR_var kimlikler = TR_qwen3_format(z.p, z.geçmiş, TR_add_generation_prompt: TR_true, TR_enable_thinking: TR_false)
    TR_return üret(z, kimlikler, t, (_, _) => {}).kimlikler
}

TR_test "sistem iletisinin tek başına biçimi sistem ve kullanıcı biçiminin önekidir" {
    TR_var p = parçalayıcı()
    TR_var s = TR_ChatMessage(TR_role: TR_Role.TR_System, TR_content: _SİSTEM)
    TR_var yalnız = TR_qwen3_format(p, [s], TR_add_generation_prompt: TR_false)
    TR_var hepsi = TR_qwen3_format(p, [s, TR_ChatMessage(TR_role: TR_Role.TR_User, TR_content: "Merhaba")], TR_add_generation_prompt: TR_true, TR_enable_thinking: TR_false)
    TR_assert(yalnız.TR_length < hepsi.TR_length)
    TR_assert_equal(yalnız, hepsi[0..yalnız.TR_length])
}

# Isıtma sistem iletisini ayrı bir ileri geçişte okur: çarpımlar başka şekillidir (bütün istem yerine önce sistem
# iletisi, sonra kalanı). 15.22a aynı bitleri aynı şekilde söz verir, başka şekilde değil; bu yüzden sınanan şey
# üretilen kimliklerin önbelleksiz okumayla aynı olmasıdır.
TR_test "sistem iletisi önceden okununca ilk turun kimlikleri değişmez, ilk tur yalnız kalanı okur" {
    TR_var sıcak = küçük_zincir(256, TR_false)
    ısıt(sıcak)
    TR_assert(sıcak.ısıtılan > 0)
    TR_assert_equal(sıcak.ısıtılan, sıcak.okunan.TR_length)
    TR_var ts = Tur(sıra: 1, söz_ms: 0)
    TR_var soğuk = küçük_zincir(256, TR_false)
    TR_var tc = Tur(sıra: 1, söz_ms: 0)
    TR_var yok = küçük_zincir(256, TR_true)
    ısıt(yok) # önbelleksiz kipte bir şey yapmaz
    TR_assert_equal(0, yok.ısıtılan)
    TR_var ty = Tur(sıra: 1, söz_ms: 0)
    TR_var k = ilk_tur(sıcak, ts)
    TR_assert_equal(8, k.TR_length)
    TR_assert_equal(k, ilk_tur(soğuk, tc))
    TR_assert_equal(k, ilk_tur(yok, ty))
    TR_assert_equal(sıcak.ısıtılan, ts.önek)
    TR_assert_equal(ts.istem - sıcak.ısıtılan, ts.yeniden_okunan)
    TR_assert_equal(0, tc.önek)
}

TR_test "ısıtmanın hatası programı durdurmaz: önbellek boşalır, ilk tur sistem iletisini de okur" {
    TR_var z = küçük_zincir(4, TR_false) # önbellek sistem iletisinden kısa: okuma H6909 ile düşer
    ısıt(z)
    TR_assert_equal(0, z.ısıtılan)
    TR_assert_equal(0, z.okunan.TR_length)
    z.bağlam = 256
    z.önbellek = önbellek_kur(z.model, z.bağlam)
    TR_var t = Tur(sıra: 1, söz_ms: 0)
    TR_var yok = küçük_zincir(256, TR_true)
    TR_assert_equal(ilk_tur(yok, Tur(sıra: 1, söz_ms: 0)), ilk_tur(z, t))
    TR_assert_equal(0, t.önek)
}

# bloklar: model_çağrısı'nın içinde blokların durumu: [nicemli etkinleştirme, üreticinin kitaplığı], 1.0 açık.
TR_func bloklar() -> TR_Tensor {
    TR_var n = TR_if TR_quantized_activations_on() { 1.0 } TR_else { 0.0 }
    TR_var v = TR_if TR_vendor_matmul_on() { 1.0 } TR_else { 0.0 }
    TR_return TR_Tensor([n, v])
}

TR_test "model_çağrısı üreticinin kitaplığının bloğundadır; nicemli açıkken nicemli etkinleştirme bloğunda da" {
    TR_var z = küçük_zincir(256, TR_false)
    TR_assert_equal([0.0, 1.0], model_çağrısı(z) { bloklar() }.TR_tolist)
    z.nicemli = TR_true
    TR_assert_equal([1.0, 1.0], model_çağrısı(z) { bloklar() }.TR_tolist)
    TR_assert_equal(TR_false, TR_quantized_activations_on())
}

# Float ağırlığa blok etkisizdir (15.53a): fark ancak gerçek nicemlenmiş modelde görünür, bu bir duman testidir.
TR_test "nicemli açıkken float ağırlıklı modelde ısıtma ve ilk tur kapalıyla aynı kimlikleri verir" {
    TR_var kapalı = küçük_zincir(256, TR_false)
    ısıt(kapalı)
    TR_var açık = küçük_zincir(256, TR_false)
    açık.nicemli = TR_true
    ısıt(açık)
    TR_assert(açık.ısıtılan > 0)
    TR_assert_equal(kapalı.ısıtılan, açık.ısıtılan)
    TR_assert_equal(ilk_tur(kapalı, Tur(sıra: 1, söz_ms: 0)), ilk_tur(açık, Tur(sıra: 1, söz_ms: 0)))
}

TR_test "nicemli seçeneğin cihaz denetimi: işlemcide hata yok, kartta cihazı söyleyen metin" {
    TR_assert_equal(TR_none, nicemli_hatası("cpu"))
    TR_var h = TR_String(nicemli_hatası("gpu:0"))
    TR_assert(h.TR_contains("--nicemli_etkinleştirme"))
    TR_assert(h.TR_contains("gpu:0"))
}

# çevrilen: hata nicemli_hatasını_at'tan geçince atılanın metni ve nedeninin kodu; atmazsa ["", ""].
TR_func çevrilen(e: TR_Error) -> TR_List[TR_String] {
    TR_try { nicemli_hatasını_at(e) } TR_catch h { TR_return [TR_String(h.TR_value), TR_String(h.TR_cause.TR_code)] }
    TR_return ["", ""]
}

TR_test "nicemli_hatasını_at: H6723 kullanıcının metni olur, nedeni H6723; q4_k çarpımı hata vermez; başka hata dokunulmaz" {
    TR_var w = TR_zeros([2, 32], TR_dtype: "q8")
    TR_var s: TR_List[TR_String] = []
    TR_try { TR_quantized_activations { TR_zeros([1, 32]) @ w.TR_transpose() } } TR_catch e { s = çevrilen(e) }
    TR_assert(s[0].TR_contains("q4_k ve q6_k ağırlıklı bir GGUF verin"))
    TR_assert_equal("H6723", s[1])
    TR_var w4 = TR_zeros([3, 256], TR_dtype: "q4_k")
    TR_assert_equal(TR_none, TR_error_code { TR_quantized_activations { TR_ones([2, 256]) @ w4.TR_transpose() } })
    TR_try { TR_throw TR_Message("H6903", -1) } TR_catch e { s = çevrilen(e) }
    TR_assert_equal(["", ""], s)
    TR_try { TR_throw "x" } TR_catch e { s = çevrilen(e) }
    TR_assert_equal(["", ""], s)
}

# q8_çıkışlı_zincir: gömme 32 (q8'de son eksen 32'nin katı); çıkış katmanı q8 sıfır ağırlık, yükleyicinin biçimiyle
# devrik görünüm (lib/pretrained.tr); bloklar float.
TR_func q8_çıkışlı_zincir(nicemli: TR_Bool) -> Zincir {
    TR_var p = parçalayıcı()
    TR_var m = TR_GPT(p.TR_vocab_size, TR_context: 512, TR_embed_dim: 32, TR_num_layers: 2, TR_num_heads: 2, TR_seed: 7)
    m.TR_logit_layer = TR_Linear(1, 1, TR_init_std: 0.0)
    m.TR_logit_layer.TR_weight = TR_zeros([p.TR_vocab_size, 32], TR_dtype: "q8").TR_transpose()
    TR_var z = Zincir(p: p, model: m, sistem: _SİSTEM, en_çok: 8, bağlam: 256, önbelleksiz: TR_false, nicemli: nicemli)
    z.yeni_konuşma()
    TR_return z
}

# Isıtma çıkış katmanını da koşar: yalnız gizli durumu okuyan ısıtma bu testte geçerdi.
TR_test "çıkış ağırlığı q8 olan modelde nicemli ısıtma kullanıcının metnini atar, nedeni H6723; kapalıyken ısıtma geçer" {
    TR_var s: TR_List[TR_String] = []
    TR_try { ısıt(q8_çıkışlı_zincir(TR_true)) } TR_catch h { s = [TR_String(h.TR_value), TR_String(h.TR_cause.TR_code)] }
    TR_assert_equal(2, s.TR_length)
    TR_assert(s[0].TR_contains("q4_k ve q6_k ağırlıklı bir GGUF verin"))
    TR_assert_equal("H6723", s[1])
    TR_var kapalı = q8_çıkışlı_zincir(TR_false)
    ısıt(kapalı) # hata yutulsaydı ısıtılan 0 kalırdı
    TR_assert(kapalı.ısıtılan > 0)
}

# Konuşma: söyle hemen döner (çalma ayrı görevde); her çalma öncekinin bitmesini bekler. Sahte çalıcı bırakılana
# kadar bekler, böylece sıra zamana bağlı olmadan sınanır.
TR_test "cümleler söylendikçe sırayla çalınır, söyle çalmayı beklemez" {
    TR_var olaylar: TR_List[TR_String] = []
    TR_var bırak = TR_false
    TR_var t = Tur(sıra: 1, söz_ms: 0)
    TR_var k = Konuşma(hazırla: (_, i) => "\(i)", çal: (iş) => {
        olaylar.TR_append("başla " + iş)
        TR_for TR_not bırak { TR_sleep(0.001) }
        olaylar.TR_append("bitti " + iş)
    }, t: t, t0: şimdi())
    TR_for _ TR_in 0..3 { k.söyle(TR_Sound(TR_zeros([1, 160]), 16000)) }
    TR_assert(TR_not olaylar.TR_contains("bitti 0"))
    TR_assert(t.ilk_ses_ms >= 0)
    bırak = TR_true
    k.bitir()
    TR_assert_equal(["başla 0", "bitti 0", "başla 1", "bitti 1", "başla 2", "bitti 2"], olaylar)
    TR_assert(t.çalma_ms >= 0 TR_and t.çalma_başı <= t.çalma_sonu)
    TR_assert_equal(t.çalma_sonu - t.çalma_başı, t.çalma_süresi_ms)
    k.bitir() # ikinci çağrı bir şey beklemez
}

TR_test "çalmanın hatası son çalmanın beklenmesinde fırlar" {
    TR_var k = Konuşma(hazırla: (_, i) => "\(i)", çal: (iş) => {
        TR_if iş == "1" { TR_throw "çalıcı yok" }
    }, t: Tur(sıra: 1, söz_ms: 0), t0: şimdi())
    TR_for _ TR_in 0..3 { k.söyle(TR_Sound(TR_zeros([1, 160]), 16000)) }
    TR_var hata = ""
    TR_try { k.bitir() } TR_catch e { hata = "\(e)" }
    TR_assert(hata.TR_contains("çalıcı yok"))
}

TR_test "cevabın sesi çalınırken diskte, çalındıktan sonra yok" {
    TR_var klasör = TR_temp_dir()
    TR_defer { TR_remove(klasör, TR_recursive: TR_true) }
    TR_var yollar: TR_List[TR_String] = []
    TR_var varken: TR_List[TR_Bool] = []
    TR_var önceki_var: TR_List[TR_Bool] = []
    TR_var k = Konuşma(hazırla: (s, i) => wav_yaz(klasör, s, i), çal: (yol) => wav_çal(yol, (y) => {
        TR_if yollar.TR_length > 0 { önceki_var.TR_append(TR_Path(yollar[yollar.TR_length - 1]).TR_exists) }
        yollar.TR_append(y)
        varken.TR_append(TR_Path(y).TR_exists)
    }), t: Tur(sıra: 1, söz_ms: 0), t0: şimdi())
    k.söyle(TR_Sound(TR_zeros([1, 160]), 16000))
    k.söyle(TR_Sound(TR_zeros([1, 320]), 16000))
    k.bitir()
    TR_assert_equal([TR_true, TR_true], varken)
    TR_assert_equal([TR_false], önceki_var) # çalınan cümle bir sonraki çalınmadan silinmiş
    TR_assert(TR_not TR_Path(yollar[1]).TR_exists)
    TR_var y = wav_yaz(klasör, TR_Sound(TR_zeros([1, 160]), 16000), 9)
    TR_try { wav_çal(y, (_) => { TR_throw "çalıcı yok" }) } TR_catch _ {}
    TR_assert(TR_not TR_Path(y).TR_exists) # hatayla biten çalmada da silinir
}

# Sahte mikrofon: k. çerçeve (değeri k) `gecikme + k × 32` ms'de biter ve ancak o zaman okunabilir; okunmadıkça
# birikir. Sahte tur 1000 ms hesaplar, 2000 ms çalar. Tetik çerçevelerinde kesitleyici 10 çerçevelik bir kesit verir.
TR_struct SahteDinleme {
    sayı: TR_Int
    tetikler: TR_List[TR_Int]
    gecikme: TR_Int = 850
    saat: TR_Int = 0
    k: TR_Int = 0
    hata_k: TR_Int = -1 # bu çerçevede bir kez taşma
    verilen: TR_List[TR_Int] = []
    sıfırlamalar: TR_List[TR_Int] = [] # sıfırlandığında verilmiş çerçeve sayısı
    turlar: TR_List[TR_List[TR_Int]] = [] # [t0, hemen, geride]
    açılış: TR_Int = 0
    en_çok_tur: TR_Int = 0
}

TR_func sahte_dinleme(s: SahteDinleme) -> Dinleme {
    TR_func oku() -> TR_Tensor? {
        TR_if s.k == s.hata_k {
            s.hata_k = -1
            TR_throw "taşma"
        }
        TR_if s.k >= s.sayı { TR_return TR_none }
        s.k += 1
        s.saat = TR_max(s.saat, s.gecikme + s.k * 32)
        TR_return TR_ones([512]) * TR_Float(s.k)
    }
    TR_func it(ç: TR_Tensor) -> TR_Tensor? {
        TR_var k = TR_Int(ç[0].TR_item())
        s.verilen.TR_append(k)
        TR_if s.tetikler.TR_contains(k) { TR_return TR_zeros([5120]) }
        TR_return TR_none
    }
    TR_func tur(kesit: TR_Tensor, t0: TR_Int, hemen: TR_Bool, geride: TR_Int) -> ÇalmaAralığı {
        s.turlar.TR_append([t0, TR_if hemen { 1 } TR_else { 0 }, geride])
        s.saat += 1000
        TR_var a = ÇalmaAralığı(başı: s.saat, sonu: s.saat + 2000)
        s.saat += 2000
        TR_return a
    }
    TR_return Dinleme(oku: oku, aç: () => { s.açılış += 1 }, it: it, sıfırla: () => { s.sıfırlamalar.TR_append(s.verilen.TR_length) },
        saat: () => s.saat, tur: tur, sürsün: () => s.en_çok_tur == 0 TR_or s.turlar.TR_length < s.en_çok_tur, kuyruk_ms: 64)
}

TR_func aralık_listesi(a: TR_Int, b: TR_Int) -> TR_List[TR_Int] { TR_return [i TR_for i TR_in a..=b] }

# Çerçeve k [818 + 32k, 850 + 32k] ms'dir. 1. tur 20. çerçevede (1490 ms): çalma [2490, 4490], kuyrukla 4554'e
# kadar: 52–116 atılır. Tur sürerken (hesap, 1490–2490) konuşulan söz 40. çerçevede biter, tampondan 4490'da
# okunur: çapa değişmez, geride 4490 − 2130 = 2360 ms. 2. turun çalması [5490, 7490]: 146–210 atılır. 211. çerçeve
# aralıktan sonraki ilk çerçevedir; orada başlayan kesit çalmanın hemen ardındandır.
TR_test "çalma aralığına düşen ses kesitleyiciye gitmez, aralığın dışındaki ses kaybolmaz" {
    TR_var s = SahteDinleme(sayı: 230, tetikler: [20, 40, 211])
    dinle(sahte_dinleme(s))
    TR_assert_equal(aralık_listesi(1, 51) + aralık_listesi(117, 145) + aralık_listesi(211, 230), s.verilen)
    TR_assert_equal([51, 80], s.sıfırlamalar)
    TR_assert_equal([[1490, 0, 0], [4490, 0, 2360], [7602, 1, 0]], s.turlar)
    TR_assert_equal(0, s.açılış)
}

TR_test "mikrofonun taşması okumada yakalanır: mikrofon yeniden açılır, dinleme sürer" {
    TR_var s = SahteDinleme(sayı: 40, tetikler: [30], hata_k: 10)
    dinle(sahte_dinleme(s))
    TR_assert_equal(1, s.açılış)
    TR_assert_equal([10], s.sıfırlamalar)
    TR_assert_equal(aralık_listesi(1, 40), s.verilen)
    TR_assert_equal(1, s.turlar.TR_length)
}

TR_test "dinleme sürsün demeyen turdan sonra biter" {
    TR_var s = SahteDinleme(sayı: 100, tetikler: [10, 90], en_çok_tur: 1)
    dinle(sahte_dinleme(s))
    TR_assert_equal(1, s.turlar.TR_length)
    TR_assert_equal(aralık_listesi(1, 10), s.verilen)
}

TR_test "ortak önek iki dizinin baştan aynı kısmıdır" {
    TR_assert_equal(2, ortak_önek([1, 2, 3], [1, 2, 4, 5]))
    TR_assert_equal(0, ortak_önek([], [1]))
    TR_assert_equal(3, ortak_önek([1, 2, 3], [1, 2, 3]))
}

# İkinci tur: önbellekte ilk turun istemi ve üretilen cevap var. Yeni dizide önceki cevabın boş düşünce bloğu
# yazılmaz; ortak önek tam önceki asistan başlığının sonunda biter.
TR_test "önbelleğin ortak öneki önceki asistan başlığının sonunda biter" {
    TR_var p = parçalayıcı()
    TR_var geçmiş = [TR_ChatMessage(TR_role: TR_Role.TR_System, TR_content: "Kısa cevap ver."), TR_ChatMessage(TR_role: TR_Role.TR_User, TR_content: "Merhaba")]
    TR_var istem = TR_qwen3_format(p, geçmiş, TR_add_generation_prompt: TR_true, TR_enable_thinking: TR_false)
    TR_var cevap_kimlikleri = p.TR_encode("Merhaba! Nasıl yardım edebilirim?", TR_special_tokens: TR_false)
    TR_var önbellekte = istem + cevap_kimlikleri
    TR_var cevap, hatalar = TR_qwen3_reply(p, cevap_kimlikleri)
    TR_assert_equal(0, hatalar.TR_length)
    geçmiş.TR_append(cevap)
    geçmiş.TR_append(TR_ChatMessage(TR_role: TR_Role.TR_User, TR_content: "Saat kaç?"))
    TR_var yeni = TR_qwen3_format(p, geçmiş, TR_add_generation_prompt: TR_true, TR_enable_thinking: TR_false)
    TR_var ortak = ortak_önek(önbellekte, yeni)
    TR_assert_equal(beklenen_önek(p, geçmiş, 2), ortak)
    TR_assert(ortak < istem.TR_length)
    TR_assert_equal(p.TR_token_id("<think>"), önbellekte[ortak])
    TR_assert_equal(0, beklenen_önek(p, geçmiş, -1))
}

TR_test "durdurulan ya da hatalı tur geri alınır: geçmiş tur öncesine döner, önbellek yeniden kurulur ve ısıtılır" {
    TR_var z = küçük_zincir(256, TR_false)
    ısıt(z)
    TR_var uzunluk = z.geçmiş.TR_length
    TR_var ilk = ilk_tur(z, Tur(sıra: 1, söz_ms: 0))
    z.geçmiş.TR_append(TR_ChatMessage(TR_role: TR_Role.TR_Assistant, TR_content: "yarım"))
    z.son_asistan = z.geçmiş.TR_length - 1
    geri_al(z, Tur(sıra: 1, söz_ms: 0), uzunluk)
    TR_assert_equal(uzunluk, z.geçmiş.TR_length)
    TR_assert_equal(-1, z.son_asistan)
    TR_assert_equal(1, z.tur)
    TR_assert(z.ısıtılan > 0)
    TR_assert_equal(z.ısıtılan, z.okunan.TR_length)
    # Geri alınan turdan sonra aynı söz aynı cevabı verir: önbellek turun yarısını taşımaz.
    TR_assert_equal(ilk, ilk_tur(z, Tur(sıra: 1, söz_ms: 0)))
}

TR_struct Sayaç {
    n: TR_Int = 0
}

TR_struct Görülen {
    metin: TR_String = ""
}

# Ekran `stop`'ta turun görevini iptal eder; iptal üretimin bir adımında fırlar. Kayıt Tur'dan yazılır.
TR_test "durdurulan turun Tur'unda ilk parçanın anı ve o ana kadarki metin vardır; cevap_ms yoktur" {
    TR_var z = küçük_zincir(256, TR_false)
    ısıt(z)
    TR_var t = Tur(sıra: 1, söz_ms: 0)
    TR_var g = Görülen()
    TR_var ileti = ""
    TR_try {
        cevapla(z, "Merhaba, nasılsın?", şimdi(), t, (_) => {}, (m) => {
            g.metin = m
            TR_throw "durdu"
        })
    } TR_catch h { ileti = TR_String(h) }
    TR_assert(ileti.TR_contains("durdu"))
    TR_assert(t.ilk_parça_ms >= 0)
    TR_assert(g.metin != "")
    TR_assert_equal(g.metin, t.cevap)
    TR_assert_equal(-1, t.cevap_ms)
}

TR_test "kimlik dosyasının satırı her kimliğin seçildiği anı turun başından ms olarak taşır; eski alanlar aynı" {
    TR_var z = küçük_zincir(256, TR_false)
    ısıt(z)
    cevapla(z, "Merhaba, nasılsın?", şimdi(), Tur(sıra: 1, söz_ms: 0), (_) => {})
    TR_var satır = TR_json_parse(z.kimlik_satırları.TR_lines()[0])
    TR_var n = satır["ids"].TR_length
    TR_var anlar = satır["anlar_ms"]
    TR_assert(n > 0)
    TR_assert_equal(n, anlar.TR_length)
    TR_assert_equal(n, satır["farklar"].TR_length)
    TR_assert_equal(1, TR_Int(satır["tur"]))
    TR_assert(TR_Int(anlar[0]) >= 0)
    TR_for i TR_in 1..anlar.TR_length { TR_assert(TR_Int(anlar[i]) >= TR_Int(anlar[i - 1])) }
}

TR_test "ara kancası: metin turunun çalma aralığı atılır, mikrofonun açılışı çapayı kurar, dur dinlemeyi bitirir" {
    TR_var s = SahteDinleme(sayı: 200, tetikler: [])
    TR_var d = sahte_dinleme(s)
    TR_var sayaç = Sayaç()
    d.ara = () => {
        sayaç.n += 1
        TR_var kez = sayaç.n
        TR_if kez == 10 { TR_return Arada(aralık: ÇalmaAralığı(başı: 0, sonu: 850 + 60 * 32), açıldı: TR_false) }
        TR_if kez == 100 { TR_return Arada(açıldı: TR_true) }
        TR_if kez == 150 { TR_return Arada(dur: TR_true) }
        TR_return Arada()
    }
    dinle(d)
    # 10. bakıştan önce 9 çerçeve verildi; aralık 60. çerçeveye kadar: 10–60 atılır.
    TR_assert(TR_not s.verilen.TR_contains(30))
    TR_assert(s.verilen.TR_contains(9))
    TR_assert(s.verilen.TR_contains(70))
    TR_assert_equal(149, s.k) # 150. bakışta durdu
    TR_assert(s.sıfırlamalar.TR_length >= 2) # aralıktan sonra ve açılışta
}

TR_test "--ffmpeg ve --çalıcı: ayırıcılı değer dosyanın yolu, ayırıcısız değer PATH'teki ad" {
    TR_assert(program_mı_yol("araçlar/ffmpeg"))
    TR_assert(program_mı_yol("araçlar\\ffmpeg"))
    TR_assert(TR_not program_mı_yol("ffmpeg"))
    # Ad PATH'te aranır (H7497). Yol dosya diye denetlenir: ad diye reddedilmez (H7494) ve PATH'te aranmaz; kodu
    # işletim sistemine göre değişir (Windows'ta uzantısız yol H7500).
    TR_func kodlar(ad: TR_String) -> TR_List[TR_String] {
        TR_var k: TR_List[TR_String] = []
        TR_try { program_koş(ad, []) } TR_catch h { k.TR_append(h.TR_code) }
        TR_try { program_başlat(ad, [], 1024).TR_cancel() } TR_catch h { k.TR_append(h.TR_code) }
        TR_return k
    }
    TR_assert_equal(["H7497", "H7497"], kodlar("olmayan_program_k395"))
    TR_var yol = kodlar("olmayan_klasor_k395/olmayan_program")
    TR_assert_equal(2, yol.TR_length)
    TR_for c TR_in yol { TR_assert(c != "H7494" TR_and c != "H7497") }
}
