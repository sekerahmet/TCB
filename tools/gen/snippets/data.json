      "loss": "kayıp",
      "loss_label": "kayıp",
      "method": "metod",
      "name": "isim",
      "one": "bir",
      "optimizer": "iyileştirici",
      "other": "diğer",
      "param": "parametre",
      "step": "adım",
      "step_label": "adım",
      "value": "değer",
      "x": "x"
    }
  }
}
