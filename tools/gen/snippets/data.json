{
  "templates": [
    {
      "id": "function",
      "prefix": [
        {
          "code": "TR_kw_func"
        }
      ],
      "source": "# TR 4\nTR_func ph_name(ph_param) {\n\tTR_return ph_return\n}\n",
      "holes": {
        "ph_name": "${1:%name%}",
        "ph_param": "${2:%param%}",
        "ph_return": "${3:${2:%param%}}"
      }
    },
    {
      "id": "if",
      "prefix": [
        {
          "code": "TR_kw_if"
        }
      ],
      "source": "# TR 4\nTR_if ph_condition {\n\tph_then\n} TR_else {\n\tph_else\n}\n",
      "holes": {
        "ph_condition": "${1:%condition%}",
        "ph_else": "${3}",
        "ph_then": "${2}"
      }
    },
    {
      "id": "match",
      "prefix": [
        {
          "code": "TR_kw_match"
        }
      ],
      "source": "# TR 4\nTR_match ph_value {\n\tph_first => ph_first_result\n\tph_second => ph_second_result\n\t_ => ph_default_result\n}\n",
      "holes": {
        "ph_default_result": "${6:\"%other%\"}",
        "ph_first": "${2:1}",
        "ph_first_result": "${3:\"%one%\"}",
        "ph_second": "${4:2..10}",
        "ph_second_result": "${5:\"%few%\"}",
        "ph_value": "${1:%value%}"
      }
    },
    {
      "id": "filter",
      "prefix": [
        {
          "code": "TR_mem_filter"
        }
      ],
      "member": true,
      "source": "# TR 4\nph_list.TR_filter { TR_it > ph_limit }\n",
      "holes": {
        "ph_limit": "${1:2}",
        "ph_list": ""
      }
    },
    {
      "id": "map",
      "prefix": [
        {
          "code": "TR_mem_map"
        }
      ],
      "member": true,
      "source": "# TR 4\nph_list.TR_map { TR_it * ph_factor }\n",
      "holes": {
        "ph_factor": "${1:2}",
        "ph_list": ""
      }
    },
    {
      "id": "reduce",
      "prefix": [
        {
          "code": "TR_mem_reduce"
        }
      ],
      "member": true,
      "source": "# TR 4\nph_list.TR_reduce(ph_start, (ph_acc, ph_x) => ph_body)\n",
      "holes": {
        "ph_acc": "%acc%",
        "ph_body": "${2:%acc% + %x%}",
        "ph_list": "",
        "ph_start": "${1:0}",
        "ph_x": "%x%"
      }
    },
    {
      "id": "for",
      "prefix": [
        {
          "code": "TR_kw_for"
        }
      ],
      "source": "# TR 4\nTR_for ph_item TR_in ph_range {\n\tTR_print(ph_item)\n}\n",
      "holes": {
        "ph_item": "${1:%i%}",
        "ph_range": "${2:1..=10}"
      }
    },
    {
      "id": "list_comprehension",
      "prefix": [
        {
          "code": "",
          "word": "list_comp"
        }
      ],
      "source": "# TR 4\n[ph_result TR_for ph_item TR_in ph_range TR_if ph_filter]\n",
      "holes": {
        "ph_filter": "${4:%x% % 2 == 0}",
        "ph_item": "${2:%x%}",
        "ph_range": "${3:1..=10}",
        "ph_result": "${1:%x% * %x%}"
      }
    },
    {
      "id": "struct",
      "prefix": [
        {
          "code": "TR_kw_struct"
        }
      ],
      "source": "# TR 4\nTR_struct ph_Name {\n\tph_field: TR_String\n\n\tTR_func ph_method() {\n\t\tTR_return TR_self.ph_field\n\t}\n}\n",
      "holes": {
        "ph_Name": "${1:%Name%}",
        "ph_field": "${2:%field%}",
        "ph_method": "${3:%method%}"
      }
    },
    {
      "id": "try",
      "prefix": [
        {
          "code": "TR_kw_try"
        }
      ],
      "source": "# TR 4\nTR_try {\n\tph_body\n} TR_catch ph_error {\n\tTR_print(ph_message)\n}\n",
      "holes": {
        "ph_body": "${1}",
        "ph_error": "%err%",
        "ph_message": "\"%caught% {%err%}\""
      }
    },
    {
      "id": "tensor",
      "prefix": [
        {
          "code": "TR_fn_tensor"
        },
        {
          "code": "",
          "word": "grad"
        }
      ],
      "end": true,
      "source": "# TR 4\nTR_var ph_X = TR_tensor(ph_xs)\nTR_var ph_Y = TR_tensor(ph_ys)\nTR_var ph_w = TR_tensor(TR_no_grad(TR_randn([ph_shape], TR_seed: 1) * 0.1), TR_requires_grad: TR_true)\nTR_var ph_b = TR_tensor([0.0], TR_requires_grad: TR_true)\nTR_var ph_optimizer = TR_AdamW([ph_w, ph_b], TR_lr: ph_rate, TR_weight_decay: 0)\nTR_for ph_step TR_in 0..ph_steps {\n\tph_optimizer.TR_zero_grad()\n\tTR_var ph_loss = TR_mean((ph_X @ ph_w + ph_b - ph_Y) ** 2)\n\tTR_backward(ph_loss)\n\tph_optimizer.TR_step()\n\tTR_if ph_step % 100 == 0 { TR_print(\"ph_step_label \\(ph_step): ph_loss_label = \\(ph_loss.TR_tolist)\") }\n}\nTR_print(TR_no_grad { TR_return ph_X @ ph_w + ph_b })\n",
      "holes": {
        "ph_X": "X",
        "ph_Y": "Y",
        "ph_b": "b",
        "ph_loss": "%loss%",
        "ph_loss_label": "%loss_label%",
        "ph_optimizer": "%optimizer%",
        "ph_rate": "${4:0.1}",
        "ph_shape": "${3:1, 1}",
        "ph_step": "%step%",
        "ph_step_label": "%step_label%",
        "ph_steps": "${5:300}",
        "ph_w": "w",
        "ph_xs": "${1:[[0.0], [1.0], [2.0], [3.0]]}",
        "ph_ys": "${2:[[-1.0], [1.0], [3.0], [5.0]]}"
      }
    }
  ]
}
