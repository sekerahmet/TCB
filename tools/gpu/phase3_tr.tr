# TR 4
# Evre 3 ölçümü, TR tarafı: phase3_torch.py ile aynı model, veri ve iyileştirici.
# Ayarlar aynı klasördeki phase3_config.json'dan (iki taraf aynı dosyayı okur); cihaz ve çıktı
# komut satırından. Her adım sonunda kayıp okunur (GPU eşzamanlanır): PyTorch tarafı da öyle.
# Kullanım: ./tr phase3_tr.tr [--device gpu] [--config phase3_config.json] [--çıktı phase3_tr.json]
# Tepe bellek bu dosyadan değil, `tr profile --json` raporundan (gpu.bellek[].tepe_canlı_bayt) okunur.
# Çıktı (JSON, anahtarlar İngilizce: phase3_torch.py ile aynı): ilk adım, ısınma adımları, ölçülen adımların medyan ve p90 süresi, kayıp eğrisi.

TR_import "measurement_model"

TR_var arg = TR_command_line({"device": "gpu", "config": "phase3_config.json", "çıktı": ""},
    TR_description: "Evre 3 ölçümü, TR tarafı (PyTorch karşılığı: phase3_torch.py)")
TR_default_device(arg["device"])
TR_var c = TR_json_parse(TR_read_file(arg["config"]))
TR_var B = TR_Int(c["B"])
TR_var T = TR_Int(c["T"])
TR_var D = TR_Int(c["D"])
TR_var H = TR_Int(c["H"])
TR_var Dh = D // H
TR_var FF = TR_Int(c["FF"])
TR_const KATMAN = TR_Int(c["LAYERS"])
TR_var V = TR_Int(c["V"])
TR_const HASSASIYET = TR_String(c["precision"])
TR_const ISINMA = TR_Int(c["warmup"])
TR_const ÖLÇÜLEN = TR_Int(c["measured"])
TR_const KAYIP_ADIM = TR_Int(c["loss_steps"])

# Sabit sentetik toplu işler (phase3_torch.py ile aynı formül).
TR_var sentetik = []
TR_for s TR_in 0..8 {
    TR_var satırlar = [[(s * 7919 + i * 104729 + t * 31) % V TR_for t TR_in 0.. (T + 1)] TR_for i TR_in 0..B]
    TR_var tümü = TR_Tensor(satırlar)
    sentetik.TR_append([tümü.TR_slice(1, 0, T), tümü.TR_slice(1, 1, T + 1)])
}

TR_var model = Model()
TR_var ağırlıklar = TR_parameters(model)
TR_var iyileştirici = TR_AdamW(ağırlıklar, TR_lr: TR_Float(c["lr"]), TR_weight_decay: 0.0)

# adım_at: bir eğitim adımı; kaybın değerini döndürür (okumak GPU'yu bekler).
TR_func adım_at(adım: TR_Int) -> TR_Float {
    TR_var xy = sentetik[adım % 8]
    iyileştirici.TR_zero_grad()
    TR_var kayıp = TR_none
    TR_mixed_precision(HASSASIYET) {
        kayıp = TR_cross_entropy(model.TR_forward(xy[0]), xy[1])
    }
    TR_backward(kayıp)
    TR_clip_grad(ağırlıklar, TR_max: 1.0)
    iyileştirici.TR_step()
    TR_return kayıp.TR_tolist
}

# yüzdelik: p. yüzdelik (en yakın sıra yöntemi).
TR_func yüzdelik(değerler: TR_List[TR_Int], p: TR_Int) -> TR_Int {
    TR_var s = değerler.TR_sort()
    TR_return s[TR_max(0, TR_Int(TR_ceil(p / 100 * s.TR_length)) - 1)]
}

TR_var kayıplar = []
TR_var ısınma_ms = []
TR_var ölçülen_ms = []
TR_for adım TR_in 0.. (ISINMA + ÖLÇÜLEN) {
    TR_var t0 = TR_time_ms()
    TR_var v = adım_at(adım)
    TR_var ms = TR_time_ms() - t0
    TR_if adım < ISINMA { ısınma_ms.TR_append(ms) } TR_else { ölçülen_ms.TR_append(ms) }
    TR_if adım < KAYIP_ADIM { kayıplar.TR_append(v) }
}

TR_var sonuç_ = {"tool": "tr", "mode": "tr", "precision": HASSASIYET, "device": TR_default_device(),
    "config": {"B": B, "T": T, "D": D, "H": H, "FF": FF, "LAYERS": KATMAN, "V": V},
    "first_step_ms": ısınma_ms[0], "warmup_ms": ısınma_ms,
    "measured": {"median_ms": TR_median(ölçülen_ms), "p90_ms": yüzdelik(ölçülen_ms, 90), "mean_ms": TR_mean(ölçülen_ms),
        "min_ms": TR_min(ölçülen_ms), "max_ms": TR_max(ölçülen_ms)},
    "loss_curve": kayıplar}
TR_var çıktı_metni = TR_json_string(sonuç_)
TR_if arg["çıktı"] != "" { TR_write_file(arg["çıktı"], çıktı_metni) }
TR_print(çıktı_metni)
