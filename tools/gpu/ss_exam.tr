# TR 4
# SimpleStories sınavı: gpt_training.tr ile eğitilmiş bir modeli, PyTorch kıyas koşularının
# (araştırma deposu rgn/train/evaluate.py: evaluate, probes, samples) ölçüsüyle değerlendirir.
#
#   kayıp, ppl     doğrulama verisinin baştan ardışık, örtüşmeyen bütün pencerelerinde (sıralı okuyucu,
#                  16.6) parça başına ortalama çapraz entropi; logitler float32
#   bpb            kayıp / ln 2 / bayt_parça (doğrulama verisinin UTF-8 bayt / parça oranı)
#   doğruluk       en olası parçanın hedefe eşit olma oranı; bantlar pencere içi konuma göre (0-64,
#                  64-256, 256-512)
#   sondalar       ilk iki istemle açgözlü 48 parça; farklı_4: farklı 4'lü oranı, döngüde: bir 4'lü
#                  en az 3 kez
#   örnekler       dört istemle açgözlü 64 parça
# Sonuç koşu klasörüne results.json olarak yazılır: PyTorch koşularının results.json'u gibi koşunun tek
# özeti (sınav, eğitim adımı ve parça sayısı, parametre sayısı, speed.json'daki hız, eğitim ayarları).
#
# Kullanım (Colab, GPU):
#   ./tr ss_exam.tr --koşu /content/drive/MyDrive/TR_dili/kosular/ss_d512_tf_tr --veri /content/ss_gpt2
# bayt_parça varsayılanı PyTorch koşusunun (ss_d512_transformer) kendi kayıp ve bpb'sinden çıkan orandır
# (1,5196237 / ln 2 / 0,5073415); aynı doğrulama verisi için iki taraf aynı paydayla ölçülür.

TR_import "training_model"

TR_var ayar = TR_command_line({"koşu": "", "veri": "", "device": "gpu", "hassasiyet": "bf16", "toplu": 16,
    "bayt_parça": 4.32125793698609, "sonda_uzunluğu": 48, "örnek_uzunluğu": 64, "eos": 50256},
    TR_description: "gpt_training.tr ile eğitilmiş modeli SimpleStories sınavıyla değerlendirir",
    TR_descriptions: {"koşu": "koşu klasörü (config.json, model.trt)", "veri": "tokenizer.json ve valid.npy klasörü",
        "bayt_parça": "doğrulama verisinin UTF-8 bayt / parça oranı (bpb paydası)",
        "eos": "hikâye sonu parçası (GPT-2: 50256); üretimde görülünce durulur"})

TR_if ayar["koşu"] == "" TR_or ayar["veri"] == "" {
    TR_throw ("koşu ve veri klasörü verilmeli: --koşu <koşu klasörü> --veri <veri klasörü>")
}
TR_default_device(ayar["device"])
TR_var yapılandırma = TR_json_parse(TR_read_file(TR_Path(ayar["koşu"], "config.json")))
TR_var eğitim = yapılandırma["config"]
TR_var p = TR_load_tokenizer(TR_Path(ayar["veri"], "tokenizer.json"))
TR_var model = eğitim_modeli(eğitim, p.TR_vocab_size)
TR_load_parameters(model, TR_load_tensors(TR_Path(ayar["koşu"], "model.trt")))
TR_var T = TR_Int(eğitim["bağlam"])

# --- Kayıp, doğruluk ve bantlar ---
TR_var toplam_kayıp = 0.0
TR_var parça = 0
TR_var doğru_konum = [] # pencere içi konum başına doğru tahmin sayısı
TR_for i TR_in 0..T { doğru_konum.TR_append(0) }
TR_var başla = TR_time_ms()
TR_var okuyucu = TR_Dataset(TR_Path(ayar["veri"], "valid.npy")).TR_sequential(TR_batch_size: ayar["toplu"], TR_context: T)
TR_no_grad {
    TR_for iş TR_in okuyucu {
        TR_var h = TR_none
        TR_mixed_precision(ayar["hassasiyet"]) { h = model.TR_hidden_states(iş[0]) }
        # Logitler float32: gizli durum ve çıkış ağırlığı float32'ye çevrilip çarpılır (evaluate.py ile aynı).
        TR_var w = TR_if model.TR_logit_layer == TR_none { model.TR_embedding.TR_table } TR_else { model.TR_logit_layer.TR_weight.TR_transpose() }
        TR_var logit = h.TR_to_dtype("float32") @ w.TR_to_dtype("float32").TR_transpose()
        TR_var n = iş[0].TR_shape[0] * T
        toplam_kayıp += TR_cross_entropy(logit, iş[1]).TR_tolist * n
        parça += n
        TR_var isabet = TR_abs(TR_argmax(logit, TR_dim: -1) - iş[1]) < 0.5
        TR_var konum = TR_sum(isabet, 0).TR_tolist
        TR_for i TR_in 0..T { doğru_konum[i] += konum[i] }
    }
}
TR_var kayıp = toplam_kayıp / TR_max(parça, 1)
TR_var pencere = parça // T
TR_var bant_sınırları = [[0, 64], [64, 256], [256, 512]]
TR_var bantlar = {}
TR_for b TR_in bant_sınırları {
    TR_if b[0] < T {
        TR_var son = TR_min(b[1], T)
        TR_var d = 0.0
        TR_for i TR_in b[0]..son { d += doğru_konum[i] }
        bantlar["\(b[0])-\(son)"] = d / TR_max(pencere * (son - b[0]), 1)
    }
}
TR_var toplam_doğru = 0.0
TR_for i TR_in 0..T { toplam_doğru += doğru_konum[i] }

# --- Sondalar ve örnekler (açgözlü) ---
# farklı_4: üretilen parçalarda farklı 4'lü oranı; döngüde: bir 4'lü en az 3 kez (evaluate.py distinct4).
TR_func farklı_4(kimlikler: TR_List[TR_Int]) -> (TR_Float, TR_Bool) {
    TR_if kimlikler.TR_length < 4 { TR_return 1.0, TR_false }
    TR_var sayım = {}
    TR_for i TR_in 0..kimlikler.TR_length - 3 {
        TR_var anahtar = "\(kimlikler[i]),\(kimlikler[i + 1]),\(kimlikler[i + 2]),\(kimlikler[i + 3])"
        sayım[anahtar] = TR_if sayım.TR_contains(anahtar) { sayım[anahtar] + 1 } TR_else { 1 }
    }
    TR_var en_çok = 0
    TR_for a, s TR_in sayım { en_çok = TR_max(en_çok, s) }
    TR_return sayım.TR_length / (kimlikler.TR_length - 3), en_çok >= 3
}
TR_var istemler = ["Once upon a time", "The little dog", "One day, a girl named", "In a small village,"]
TR_func açgözlü(istem: TR_String, adet: TR_Int) -> (TR_List[TR_Int], TR_String) {
    TR_var başlangıç = p.TR_encode(istem)
    TR_var kimlikler = TR_none
    TR_mixed_precision(ayar["hassasiyet"]) { kimlikler = model.TR_generate(başlangıç, adet, TR_temperature: 0, TR_eos: ayar["eos"]) }
    TR_var yeni = kimlikler[başlangıç.TR_length..kimlikler.TR_length]
    TR_if yeni.TR_length > 0 TR_and yeni.TR_last == ayar["eos"] { yeni = yeni[0..yeni.TR_length - 1] }
    TR_return yeni, istem + p.TR_decode(yeni)
}
TR_var sondalar = []
TR_for istem TR_in istemler[0..2] {
    TR_var g = açgözlü(istem, ayar["sonda_uzunluğu"])
    TR_var f = farklı_4(g.0)
    sondalar.TR_append({"istem": istem, "metin": g.1, "farklı_4": f.0, "döngüde": f.1})
}
TR_var örnekler = []
TR_for istem TR_in istemler { örnekler.TR_append({"istem": istem, "metin": açgözlü(istem, ayar["örnek_uzunluğu"]).1}) }

TR_var sınav = {"loss": kayıp, "ppl": TR_exp(TR_min(kayıp, 50.0)), "bpb": kayıp / TR_log(2.0) / ayar["bayt_parça"],
    "doğruluk": toplam_doğru / TR_max(parça, 1), "bantlar": bantlar, "parça": parça, "pencere": pencere,
    "sondalar": sondalar, "süre_sn": (TR_time_ms() - başla) / 1000.0, "hassasiyet": ayar["hassasiyet"]}
TR_var hız_yolu = TR_Path(ayar["koşu"], "speed.json")
TR_var sonuç_ = {"ad": TR_Path(ayar["koşu"]).TR_name, "parametre_sayısı": yapılandırma["num_params"], "step": TR_Int(eğitim["step"]),
    "eğitim_parçası": TR_Int(eğitim["step"]) * TR_Int(eğitim["toplu"]) * TR_Int(eğitim["birikim"]) * T, "last": sınav,
    "hız": TR_if hız_yolu.TR_exists { TR_json_parse(TR_read_file(hız_yolu)) } TR_else { TR_none }, "örnekler": örnekler,
    "device": TR_default_device(), "config": eğitim}
TR_write_file(TR_Path(ayar["koşu"], "results.json"), TR_json_string(sonuç_))
TR_print("sınav: kayıp \(TR_round(kayıp, 4)) · ppl \(TR_round(sınav["ppl"], 3)) · bpb \(TR_round(sınav["bpb"], 4)) · doğruluk \(TR_round(sınav["doğruluk"], 4)) · \(parça) parça (\(pencere) pencere)")
TR_for ad, v TR_in bantlar { TR_print("  bant \(ad): \(TR_round(v, 4))") }
TR_for s TR_in sondalar { TR_print("  sonda: farklı_4 \(TR_round(s["farklı_4"], 3)) · döngüde \(s["döngüde"]) · \(s["metin"])") }
TR_for ö TR_in örnekler { TR_print("  örnek: \(ö["metin"])") }
