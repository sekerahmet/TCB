// SimpleStories GPT eğitimi (Colab, GPU): dilin kitaplığındaki GPT, gizli ağırlıklarda Muon
// (ya da NorMuon), öbürlerinde AdamW, ısınma–sabit–azalma (WSD) öğrenme oranı planı.
//
// Veri klasörü (--veri): tokenizer.json, train.npy ve valid.npy (parça kimlikleri, uint16).
// Koşu klasörüne (--koşu) yazılanlar:
//   config.json     ayarlar, parametre sayısı, cihaz
//   metrics.jsonl   günlük_her adımda bir: eğitim kaybı, oran çarpanı, Muon ve AdamW'nin o anki oranları,
//                   kırpma öncesi gradyan normu (kırpma açıksa), aralığın ms/adım ve parça/sn'si;
//                   değerlendir_her adımda bir doğrulama kaybı (başlangıç ve devam kayıtlarını günlük yazar, 19.5)
//   samples.json    her istemin devamı olarak üretilen örnek metinler (örnek_her adımda bir ve sonda)
//   speed.json      ms/adım ve parça/sn (ilk ölçüm_ısınması adım, değerlendirme, örnek üretimi ve
//                   kontrol noktası kaydı hariç)
//   model.trt       son ağırlıklar; kontrol_noktalari/ kaldığı yerden devam için
// Kesilirse aynı komut kaldığı yerden sürer (her_dakika'da bir kayıt).
//
// Kullanım:
//   ./tr gpt_training.tr --veri /content/ss4096 --koşu /content/runs/gpt1
//   ./tr gpt_training.tr --veri /content/ss4096 --toplu 64 --birikim 2      (bellek yetmezse)
//   ./tr gpt_training.tr --yardım
// Model ayarları varsayılan olarak d512, 8 katman, 8 bakış, bağlam 512, toplu 128'dir.

aktar "tr/katman"
aktar "tr/iyilestirici"

değişken ayar = komut_satırı({
        veri: "", koşu: "runs/gpt_ss", cihaz: "gpu", hassasiyet: "float32",
        boyut: 512, katman: 8, bakış_sayısı: 8, kv_bakış_sayısı: 0, bağlam: 512, toplu: 128, birikim: 1,
        adım: 5000, ısınma: 200, azalma: 0.2, muon_oranı: 0.02, adamw_oranı: 0.003,
        ağırlık_çürümesi: 0.0, adamw_çürümesi: 0.0, muon_ölçeği: "oran", ns_türü: "float32", normuon: yanlış, kırp: 1.0, paylaşımlı: doğru,
        dağarcık: 0, ara_boyut: 0, epsilon: 0.00001, qk_normu: yanlış, birleşik_kv: yanlış, birleşik_kapı: yanlış, ileri_sapmalı: yanlış,
        günlük_her: 10, değerlendir_her: 250, değerlendir_toplu: 20, son_değerlendir_toplu: 0, örnek_her: 1000,
        örnek_sayısı: 3, örnek_uzunluğu: 120, istemler: "Once upon a time", ölçüm_ısınması: 10, her_dakika: 15.0, tohum: 1},
    açıklama: "SimpleStories verisiyle GPT eğitir (Muon + AdamW, WSD planı, kontrol noktası)",
    açıklamalar: {veri: "tokenizer.json, train.npy, valid.npy klasörü", koşu: "koşu klasörü",
        cihaz: "gpu ya da cpu", hassasiyet: "float32 ya da bf16 (karışık hassasiyet)",
        kv_bakış_sayısı: "anahtar/değer bakış sayısı (0: bakış_sayısı ile aynı)", birikim: "adım başına toplu iş (gradyan biriktirme)",
        azalma: "son adımların azalan oranlı kesri", normuon: "gizli ağırlıklarda NorMuon",
        kırp: "gradyan normu sınırı (0: kırpma yok)", paylaşımlı: "çıkış katmanı gömme tablosunu kullanır",
        istemler: "örnek metinlerin başlangıçları, | ile ayrılır (her istem için örnek_sayısı metin)",
        ağırlık_çürümesi: "Muon'un (gizli matrisler) ağırlık çürümesi", adamw_çürümesi: "gömmenin ağırlık çürümesi (normlar ve sapmalar çürümesiz)",
        muon_ölçeği: "oran ya da rms (güncellemenin RMS'i AdamW'ninkiyle eşlenir; öğrenme oranı AdamW ölçeğinde)",
        ns_türü: "Newton–Schulz hesap türü: float32 ya da bf16",
        dağarcık: "0: parçalayıcının dağarcığı; büyükse dolgu satırları eklenir (ör. 64'ün katı: çarpım hızlanır)",
        ara_boyut: "SwiGLU ara boyutu (0: 8/3 · boyut, 32'nin katına)", epsilon: "RMS normunun epsilonu",
        qk_normu: "sorgu ve anahtar normu", birleşik_kv: "K ve V tek matris", birleşik_kapı: "SwiGLU kapı ve yukarı tek matris",
        ileri_sapmalı: "SwiGLU katmanları sapmalı",
        son_değerlendir_toplu: "son adımdaki değerlendirmenin toplu işi (0: değerlendir_toplu; büyük sayı: bütün doğrulama verisi)"})

eğer ayar.veri == "" {
    fırlat("veri klasörü verilmedi: --veri /content/ss4096 (tokenizer.json, train.npy, valid.npy)")
}
varsayılan_cihaz(ayar.cihaz)
değişken p = parçalayıcı_yükle(yol(ayar.veri, "tokenizer.json"))
değişken eğitim_verisi = veri_kümesi(yol(ayar.veri, "train.npy"))
değişken ö = eğitim_verisi.örnekleyici(toplu: ayar.toplu, bağlam: ayar.bağlam, tohum: ayar.tohum)

eğer ayar.dağarcık != 0 ve ayar.dağarcık < p.dağarcık_boyutu {
    fırlat("--dağarcık {ayar.dağarcık} parçalayıcının dağarcığından ({p.dağarcık_boyutu}) küçük olamaz")
}
değişken model = GPT(eğer ayar.dağarcık == 0 { p.dağarcık_boyutu } değilse { ayar.dağarcık }, bağlam: ayar.bağlam,
    boyut: ayar.boyut, katman: ayar.katman, bakış_sayısı: ayar.bakış_sayısı,
    kv_bakış_sayısı: eğer ayar.kv_bakış_sayısı == 0 { yok } değilse { ayar.kv_bakış_sayısı },
    ara_boyut: eğer ayar.ara_boyut == 0 { yok } değilse { ayar.ara_boyut }, epsilon: ayar.epsilon,
    qk_normu: ayar.qk_normu, birleşik_kv: ayar.birleşik_kv, birleşik_kapı: ayar.birleşik_kapı, ileri_sapmalı: ayar.ileri_sapmalı,
    paylaşımlı: ayar.paylaşımlı, tohum: ayar.tohum)
değişken op = MuonVeAdamW(model, muon_oranı: ayar.muon_oranı, adamw_oranı: ayar.adamw_oranı,
    ağırlık_çürümesi: ayar.ağırlık_çürümesi, adamw_çürümesi: ayar.adamw_çürümesi, muon_ölçeği: ayar.muon_ölçeği,
    ns_türü: ayar.ns_türü, normuon: ayar.normuon)
değişken ağırlıklar = parametreler(model)
değişken parametre_sayısı = 0
döngü w içinde ağırlıklar { parametre_sayısı += w.şekil.indirge(1) { birikim * o } }
yazdır("model: {yuvarla(parametre_sayısı / 1000000, 2)} M parametre · cihaz {model.gömme.tablo.cihaz} · dağarcık {p.dağarcık_boyutu} (model {model.ayar.dağarcık})")

klasör_oluştur(ayar.koşu)
dosya_yaz(yol(ayar.koşu, "config.json"), json_metin({ayar: ayar, parametre_sayısı: parametre_sayısı,
    cihaz: varsayılan_cihaz(), muon_ağırlıkları: op.muon.ağırlıklar.uzunluk, adamw_ağırlıkları: op.diğer.uzunluk}))
değişken g = günlük(yol(ayar.koşu, "metrics.jsonl"))
değişken izlenen = {en_iyi_doğrulama: 99.0, örnekler: []}
değişken kn = kontrol_noktası(ayar.koşu, {model: model, adamw: op.adamw, muon: op.muon.durum, ö: ö, g: g, izlenen: izlenen},
    her_dakika: ayar.her_dakika)

// doğrulama_kaybı: valid.npy'nin baştan ardışık, örtüşmeyen pencerelerinden ilk toplu_sayısı toplu işin
// parça başına ortalama kaybı (eksik son toplu iş satır sayısıyla ağırlıklanır).
fonksiyon doğrulama_kaybı(toplu_sayısı) {
    değişken okuyucu = veri_kümesi(yol(ayar.veri, "valid.npy")).sıralı(toplu: ayar.toplu, bağlam: ayar.bağlam)
    değişken toplam_kayıp = 0.0
    değişken satır = 0
    değişken sayı = 0
    türevsiz {
        karışık_hassasiyet(ayar.hassasiyet) {
            döngü iş içinde okuyucu {
                değişken n = iş[0].şekil[0]
                toplam_kayıp += model.kayıp(iş[0], iş[1]).değer * n
                satır += n
                sayı += 1
                eğer sayı == toplu_sayısı { çık }
            }
        }
    }
    sonuç toplam_kayıp / maks(satır, 1)
}

// örnek_yaz: her istemin devamı olarak örnek_sayısı metin üretir ve samples.json'a yazar.
fonksiyon örnek_yaz(adım) {
    değişken metinler = []
    karışık_hassasiyet(ayar.hassasiyet) {
        döngü j, istem içinde ayar.istemler.böl("|") {
            değişken başlangıç = p.kodla(istem.kırp())
            döngü i içinde 0..ayar.örnek_sayısı {
                değişken kimlikler = model.üret(başlangıç, ayar.örnek_uzunluğu, sıcaklık: 0.8, en_iyi_k: 50, tohum: 1000 * adım + 100 * j + i)
                metinler.ekle(p.çöz(kimlikler))
            }
        }
    }
    izlenen.örnekler.ekle({adım: adım, metinler: metinler})
    dosya_yaz(yol(ayar.koşu, "samples.json"), json_metin(izlenen.örnekler))
}

değişken ç = ilerleme(ayar.adım, günlük: g)
eğer kn.kaldığı_adım > 0 { ç.güncelle(adım: kn.kaldığı_adım) }
değişken parça_adım = ayar.toplu * ayar.birikim * ayar.bağlam
// Hız ölçümü eğitim adımlarını kapsar: değerlendirme, örnek üretimi ve kontrol noktası kaydının süresi
// (dış) çıkarılır. aralık_*: son günlük kaydından bu yana (ms_adım, parça_sn); ölçüm_*: speed.json.
değişken ölçüm_başı = yok
değişken ölçülen_adım = 0
değişken dış = 0.0
değişken aralık_başı = yok
değişken aralık_adımı = 0
değişken aralık_dış = 0.0
değişken kayıp = yok
// GPU'yu bekletir: ardından okunan zaman kuyruktaki bütün işi kapsar.
fonksiyon bekle_gpu() {
    eğer kayıp != yok { değişken b_ = kayıp.değer }
}
döngü adım içinde kn.kaldığı_adım..ayar.adım {
    eğer adım - kn.kaldığı_adım == ayar.ölçüm_ısınması {
        bekle_gpu() // ısınma adımlarının GPU'da bitmesini bekle
        ölçüm_başı = zaman_ms()
        ölçülen_adım = 0
        dış = 0.0
    }
    değişken çarpan = oran_planı(adım, ayar.adım, ısınma: ayar.ısınma, azalma: ayar.azalma)
    op.çarpan_ayarla(çarpan)
    op.sıfırla()
    döngü b içinde 0..ayar.birikim {
        değişken giriş, hedef = ö.sonraki()
        karışık_hassasiyet(ayar.hassasiyet) {
            kayıp = model.kayıp(giriş, hedef)
            geri_yayılım(kayıp / ayar.birikim)
        }
    }
    değişken norm = yok // kırpma öncesi gradyan normu (0 boyutlu tensör; okununca GPU beklenir)
    eğer ayar.kırp > 0 { norm = gradyan_kırp(ağırlıklar, en_fazla: ayar.kırp) }
    op.adım()
    ölçülen_adım += 1
    // Kaybın değerini okumak GPU'yu bekletir: çubuk ve günlük günlük_her adımda bir güncellenir.
    eğer (adım + 1) % ayar.günlük_her == 0 veya adım + 1 == ayar.adım {
        değişken k = kayıp.değer // GPU'yu bekler: aşağıdaki zaman tamamlanmış adımları kapsar
        değişken şimdi = zaman_ms()
        değişken ölçüler = {kayıp: k, oran_çarpanı: çarpan, muon_oranı: ayar.muon_oranı * çarpan,
            adamw_oranı: ayar.adamw_oranı * çarpan}
        eğer norm != yok { ölçüler["gradyan_normu"] = norm.değer }
        eğer aralık_başı != yok {
            değişken ms = (şimdi - aralık_başı - aralık_dış) / (adım + 1 - aralık_adımı)
            ölçüler["ms_adım"] = ms
            ölçüler["parça_sn"] = parça_adım * 1000.0 / ms
        }
        ç.güncelle(ölçüler, adım: adım + 1)
        aralık_başı = şimdi
        aralık_adımı = adım + 1
        aralık_dış = 0.0
    }
    eğer (adım + 1) % ayar.değerlendir_her == 0 veya adım + 1 == ayar.adım {
        bekle_gpu()
        değişken t0 = zaman_ms()
        değişken son_adım = adım + 1 == ayar.adım ve ayar.son_değerlendir_toplu > 0
        değişken dk = doğrulama_kaybı(eğer son_adım { ayar.son_değerlendir_toplu } değilse { ayar.değerlendir_toplu })
        g.ekle({adım: adım + 1, doğrulama_kaybı: dk})
        eğer dk < izlenen.en_iyi_doğrulama { izlenen.en_iyi_doğrulama = dk }
        dış += zaman_ms() - t0
        aralık_dış += zaman_ms() - t0
    }
    eğer (adım + 1) % ayar.örnek_her == 0 {
        bekle_gpu()
        değişken t0 = zaman_ms()
        örnek_yaz(adım + 1)
        dış += zaman_ms() - t0
        aralık_dış += zaman_ms() - t0
    }
    // Kayıt GPU'daki tensörleri okuduğu için adımın bitmesini de bekler; kayıt yapılan adımda en çok bir
    // adımın süresi dış sayılır (10 dakikada bir, ihmal edilir). Her adımda beklemek eğitimi yavaşlatırdı.
    değişken t_kn = zaman_ms()
    eğer kn.güncelle(adım + 1) {
        dış += zaman_ms() - t_kn
        aralık_dış += zaman_ms() - t_kn
    }
}
eğer kayıp != yok {
    değişken son_kayıp = kayıp.değer // son adımın bitmesini bekler
    eğer ölçüm_başı != yok ve ölçülen_adım > 0 {
        değişken ms = (zaman_ms() - ölçüm_başı - dış) / ölçülen_adım
        dosya_yaz(yol(ayar.koşu, "speed.json"), json_metin({ms_adım: ms,
            parça_sn: parça_adım * 1000.0 / ms, ölçülen_adım: ölçülen_adım, dış_sn: dış / 1000.0,
            cihaz: varsayılan_cihaz(), hassasiyet: ayar.hassasiyet, son_kayıp: son_kayıp}))
        yazdır("hız: {yuvarla(ms, 1)} ms/adım · {yuvarla(parça_adım * 1000.0 / ms, 0)} parça/sn")
    }
    kn.kaydet()
}
// Ağırlıklar örneklerden önce yazılır: üretimde bir hata olsa da eğitimin sonucu kaybolmaz.
tensör_kaydet(yol(ayar.koşu, "model.trt"), parametreler(model, adlarıyla: doğru))
örnek_yaz(ayar.adım)
yazdır("bitti: en iyi doğrulama kaybı {yuvarla(izlenen.en_iyi_doğrulama, 4)} · koşu klasörü {yol(ayar.koşu).mutlak}")
// Her istemin ilk örneği.
döngü i içinde 0..izlenen.örnekler.son.metinler.uzunluk {
    eğer i % ayar.örnek_sayısı == 0 { yazdır(izlenen.örnekler.son.metinler[i]) }
}
