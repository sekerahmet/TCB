# TR 4
# Eğitim modeli: gpt_training.tr ve ss_exam.tr aynı GPT'yi eğitim ayarlarından (gpt_training.tr'nin
# komut satırı sözlüğü ya da koşu klasöründeki config.json'un "config"i) bu tek fonksiyonla kurar; yeni bir
# model seçeneği yalnızca burada eklenir. Kendisi program değildir.

TR_import "tr/katman"

# eğitim_modeli: ayar.dağarcık 0 ise parçalayıcının dağarcığı kullanılır; büyükse dolgu satırları eklenir,
# küçükse hatadır. 0 verilen kv_bakış_sayısı ve ara_boyut kitaplığın varsayılanıdır. Ayar config.json'dan
# geliyorsa değerleri JSON'dur (3.7a): tip çağrısıyla açılır; komut satırı sözlüğünde aynı değeri verir.
TR_func eğitim_modeli(ayar, parçalayıcı_dağarcığı) {
    TR_if TR_Int(ayar["dağarcık"]) != 0 TR_and TR_Int(ayar["dağarcık"]) < parçalayıcı_dağarcığı {
        TR_throw ("--dağarcık \(TR_Int(ayar["dağarcık"])) parçalayıcının dağarcığından (\(parçalayıcı_dağarcığı)) küçük olamaz")
    }
    TR_return TR_GPT(TR_if TR_Int(ayar["dağarcık"]) == 0 { parçalayıcı_dağarcığı } TR_else { TR_Int(ayar["dağarcık"]) }, TR_context: TR_Int(ayar["bağlam"]),
        TR_embed_dim: TR_Int(ayar["embed_dim"]), TR_num_layers: TR_Int(ayar["katman"]), TR_num_heads: TR_Int(ayar["num_heads"]),
        TR_num_kv_heads: TR_if TR_Int(ayar["num_kv_heads"]) == 0 { TR_none } TR_else { TR_Int(ayar["num_kv_heads"]) },
        TR_intermediate_dim: TR_if TR_Int(ayar["ara_boyut"]) == 0 { TR_none } TR_else { TR_Int(ayar["ara_boyut"]) }, TR_eps: TR_Float(ayar["eps"]),
        TR_qk_norm: TR_Bool(ayar["qk_normu"]), TR_merged_kv: TR_Bool(ayar["birleşik_kv"]), TR_merged_gate: TR_Bool(ayar["birleşik_kapı"]),
        TR_ff_use_bias: TR_Bool(ayar["ileri_sapmalı"]), TR_tied: TR_Bool(ayar["paylaşımlı"]), TR_seed: TR_Int(ayar["tohum"]))
}
