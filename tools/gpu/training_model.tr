//! tr kodlu 3 dil=tr
// Eğitim modeli: gpt_training.tr ve ss_exam.tr aynı GPT'yi eğitim ayarlarından (gpt_training.tr'nin
// komut satırı sözlüğü ya da koşu klasöründeki config.json'un "ayar"ı) bu tek fonksiyonla kurar; yeni bir
// model seçeneği yalnızca burada eklenir. Kendisi program değildir.

TR_kw_import "tr/katman"

// eğitim_modeli: ayar.dağarcık 0 ise parçalayıcının dağarcığı kullanılır; büyükse dolgu satırları eklenir,
// küçükse hatadır. 0 verilen kv_bakış_sayısı ve ara_boyut kitaplığın varsayılanıdır.
TR_kw_func eğitim_modeli(ayar, parçalayıcı_dağarcığı) {
    TR_kw_if ayar.dağarcık != 0 TR_kw_and ayar.dağarcık < parçalayıcı_dağarcığı {
        TR_kw_throw ("--dağarcık {ayar.dağarcık} parçalayıcının dağarcığından ({parçalayıcı_dağarcığı}) küçük olamaz")
    }
    TR_kw_return GPT(TR_kw_if ayar.dağarcık == 0 { parçalayıcı_dağarcığı } TR_kw_else { ayar.dağarcık }, bağlam: ayar.bağlam,
        boyut: ayar.boyut, katman: ayar.katman, bakış_sayısı: ayar.bakış_sayısı,
        kv_bakış_sayısı: TR_kw_if ayar.kv_bakış_sayısı == 0 { TR_kw_none } TR_kw_else { ayar.kv_bakış_sayısı },
        ara_boyut: TR_kw_if ayar.ara_boyut == 0 { TR_kw_none } TR_kw_else { ayar.ara_boyut }, epsilon: ayar.epsilon,
        qk_normu: ayar.qk_normu, birleşik_kv: ayar.birleşik_kv, birleşik_kapı: ayar.birleşik_kapı,
        ileri_sapmalı: ayar.ileri_sapmalı, paylaşımlı: ayar.paylaşımlı, tohum: ayar.tohum)
}
