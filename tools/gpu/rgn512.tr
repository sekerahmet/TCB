// Hedef modelin (tools/gpu/rgn512.py) TR karşılığı: aynı mimari ve eğitim tarifi.
//   8 katman YYGYGYYG (Y: son 32 / 64 parçaya bakan yerel katman, G: tam nedensel), GQA ½, QK-norm,
//   RoPE, ön-norm RMSNorm (ε 1e-6), ½ SwiGLU (672, birleşik [G|U], sapmalı), katman başına kelime
//   gömmesi (PLE, P = d), paylaşımlı gömme; Muon (gövde matrisleri) + AdamW (gömme, ple_bağlamı;
//   normlar ve sapmalar çürümesiz) + satır seyrek RMS (PLE tabloları), WSD, gradyan kırpma 1,0, bf16.
// Eksikler (yol haritası Evre 3, "Hedef"): satır seyrek RMS yoğun maskelidir (anlam aynı, maliyet
// O(V·P)); derleme (torch.compile) karşılığı kaynaştırma yoktur. Kayıp logitleri bütün olarak
// tutmaz (model.kayıp → doğrusal_çapraz_entropi, 8192'lik dilimler; hedef de dilimler ama geri
// geçişte yeniden hesaplar).
//
// Kullanım: ./tr rgn512.tr --veri KLASÖR [--adım 120] [--çıktı sonuç.json]
//   veri: uint16 .npy parça dosyalarının klasörü (belge sonu 0), hedefle aynı biçim.
// Doğruluk karşılaştırması (tools/gpu/rgn_reference.py ile): --ağırlık init.trt PyTorch'un başlangıç
// ağırlıklarını yükler, --sıralı doğru toplu işleri sırayla okur (PyTorch tarafı aynı pencereleri
// kurar), --hassasiyet fp32 bf16'yı kapatır, --kayıplar adım başına kaybı ve gradyan normunu yazar.
// Kalite: --doğrulama valid.npy her --değerlendirme adımda ve sonda doğrulama kaybını hedefin yöntemiyle
// ölçer (dosyanın başından --değerlendirme_parça kadar ardışık pencere; rgn512.py evaluate).
// Kararlılık (dil tanımı 15.46, 20.14, 20.15; tr/egitim): her adımın kaybını ve gradyan normunu bir
// sıçrama bekçisi izler (son --bekçi_pencere sağlam adıma göre --bekçi_eşik standart sapma). --koşu
// KLASÖR verilince kontrol noktası kurulur (her --kayıt_dakika dakikada bir; yeniden çalıştırılınca
// kaldığı adımdan sürer): NaN, sonsuz ya da sıçramada son noktaya dönülür ve --atla toplu iş atlanır.
// --koşu yoksa NaN ya da sonsuzda eğitim açık bir hatayla durur, sıçramada uyarı yazılır. Aynı
// noktaya üçüncü kez dönülürse (sorun kalıcı) eğitim açık bir hatayla durur. Bekçi değeri
// adımın sonunda zaten okunan kayıp ve normdan okur: adıma bekleme eklemez. --nan_adımı N (sınama
// için) N. adımın kaybını bir kez NaN yapar.
// Sonuç: --kaydet DOSYA eğitim bitince son ağırlıkları (parametreler, yol adlarıyla) tensör dosyası
// olarak yazar; tools/gpu/rgn_from_tr.py onları PyTorch modeline yükleyip doğrulama kaybını hedefin
// kendi koduyla ölçer ve metin üretir.
// Tersi: --ağırlık DOSYA --adım 0 PyTorch'ta eğitilmiş modeli (rgn_to_tr.py) eğitmeden TR'nin koduyla ölçer.

değişken arg = komut_satırı({veri: "", adım: 120, toplu: 64, mikro: 32, bağlam: 1024, oran: 0.002,
        cihaz: "gpu", tohum: 0, günlük: 50, çıktı: "", ağırlık: "", sıralı: yanlış, hassasiyet: "bf16",
        kayıplar: "", dağarcık: 40000, boyut: 512, katman: 8, bakış_sayısı: 8, kv_bakış_sayısı: 4, ara: 672,
        doğrulama: "", değerlendirme: 1000, değerlendirme_parça: 4194304,
        koşu: "", kayıt_dakika: 15, bekçi_pencere: 128, bekçi_eşik: 6.0, atla: 200, nan_adımı: -1, kaydet: ""},
    açıklama: "Hedef modelin TR karşılığı (PyTorch: rgn512.py)")
doğrula(arg.veri != "", "--veri ile .npy klasörü verilmeli")
varsayılan_cihaz(arg.cihaz)

aktar "tr/katman" olarak katman
aktar "tr/iyilestirici" olarak iyileştirici
aktar "tr/egitim" olarak eğitim

// Boyutlar hedefin varsayılanlarıdır; küçük boyutlar yalnızca hızlı doğruluk testi içindir (8 katman ve
// düzen sabittir, PLE boyutu = boyut).
değişken model = katman.GPT(arg.dağarcık, bağlam: arg.bağlam, boyut: arg.boyut, katman: arg.katman, bakış_sayısı: arg.bakış_sayısı,
    kv_bakış_sayısı: arg.kv_bakış_sayısı, ara_boyut: arg.ara, paylaşımlı: doğru,
    pencereler: katman.katman_pencereleri("YYGYGYYG", [32, 64]), qk_normu: doğru, birleşik_kv: doğru,
    birleşik_kapı: doğru, ileri_sapmalı: doğru, epsilon: 0.000001, ple_boyutu: arg.boyut, tohum: arg.tohum + 1)

değişken op = iyileştirici.MuonVeAdamW(model, muon_oranı: arg.oran, adamw_oranı: arg.oran,
    ağırlık_çürümesi: 0.1, adamw_çürümesi: 0.1, muon_ölçeği: "rms",
    ayrı: ["gömme", "ple_bağlamı"], seyrek: ["ple.tablo"],
    ns_türü: eğer arg.hassasiyet == "fp32" { "float32" } değilse { "bf16" })
eğer arg.ağırlık != "" {
    parametreleri_yükle(model, tensör_yükle(arg.ağırlık))
}
değişken ağırlıklar = parametreler(model)

değişken birikim = arg.toplu / arg.mikro
değişken küme = veri_kümesi(arg.veri)
değişken örnekler = eğer arg.sıralı { küme.sıralı(toplu: arg.mikro, bağlam: arg.bağlam) } değilse {
    küme.örnekleyici(toplu: arg.mikro, bağlam: arg.bağlam, tohum: arg.tohum) }
değişken adım_başına = arg.toplu * arg.bağlam
değişken ısınma = maks(1, tam(arg.adım * 0.01))

// Parametreler hedefin ayrımıyla sayılır: PLE tabloları gömme gibi çalışır (her parçada bir satır),
// modelin boyu gövde + gömmedir.
değişken parametre_sayısı = 0
değişken ple_tablo = 0
döngü ad, p içinde parametreler(model, adlarıyla: doğru) {
    değişken n = 1
    döngü k içinde p.şekil { n *= k }
    parametre_sayısı += n
    eğer iyileştirici.ad_uyar_mı(ad, "ple.tablo") { ple_tablo += n }
}
değişken M = (n) => yuvarla(n / 1000000.0, 1)
yazdır("hedef model (TR) | YYGYGYYG | {M(parametre_sayısı)}M parametre (PLE tabloları {M(ple_tablo)}M, gövde + gömme {M(parametre_sayısı - ple_tablo)}M) | {arg.adım} adım × {adım_başına} parça | cihaz {varsayılan_cihaz()}")

// Doğrulama kaybı: dosyanın başından ardışık pencereler (hedefle aynı), türevsiz, eğitimin hassasiyetiyle.
değişken doğrulama_kümesi = eğer arg.doğrulama == "" { yok } değilse { veri_kümesi(arg.doğrulama) }
fonksiyon değerlendir() {
    değişken s = doğrulama_kümesi.sıralı(toplu: arg.mikro, bağlam: arg.bağlam)
    değişken n = maks(1, arg.değerlendirme_parça / arg.bağlam / arg.mikro)
    değişken kayıp_toplamı = 0.0
    türevsiz {
        döngü i içinde 0..n {
            değişken xy = s.sonraki()
            eğer arg.hassasiyet == "fp32" {
                kayıp_toplamı += model.kayıp(xy[0], xy[1]).değer
            } değilse {
                karışık_hassasiyet(arg.hassasiyet) { kayıp_toplamı += model.kayıp(xy[0], xy[1]).değer }
            }
        }
    }
    sonuç kayıp_toplamı / n
}
değişken doğrulama_kaydı = []

değişken süreler = []
değişken pencere = []
değişken kayıt = []
değişken bekçi = eğitim.SıçramaBekçisi(pencere: arg.bekçi_pencere, eşik: arg.bekçi_eşik)
değişken izlenen = {kayıt: kayıt, doğrulama: doğrulama_kaydı}
değişken kn = yok
eğer arg.koşu != "" {
    değişken nesneler = {model: model, adamw: op.adamw, muon: op.muon.durum, örnekler: örnekler, izlenen: izlenen}
    eğer op.adamw_sönümsüz != yok { nesneler["adamw_sönümsüz"] = op.adamw_sönümsüz }
    eğer op.satır_rms != yok { nesneler["satır_rms"] = op.satır_rms.durum }
    kn = kontrol_noktası(arg.koşu, nesneler, her_dakika: arg.kayıt_dakika)
}
değişken adım = eğer kn == yok { 0 } değilse { kn.kaldığı_adım }
değişken nan_adımı = arg.nan_adımı
değişken son_dönüş = -1 // aynı noktaya art arda dönüşler sayılır: kalıcı bir bozulmada sonsuz döngü olmasın
değişken dönüş_sayısı = 0
döngü adım < arg.adım {
    op.çarpan_ayarla(maks(0.000001, iyileştirici.oran_planı(adım, arg.adım, ısınma: ısınma, azalma: 0.2)))
    değişken t0 = zaman_ms()
    değişken toplam_kayıp = 0.0
    döngü m içinde 0..birikim {
        değişken xy = örnekler.sonraki()
        değişken kayıp = yok
        eğer arg.hassasiyet == "fp32" {
            kayıp = model.kayıp(xy[0], xy[1]) / birikim
        } değilse {
            karışık_hassasiyet(arg.hassasiyet) {
                kayıp = model.kayıp(xy[0], xy[1]) / birikim
            }
        }
        eğer adım + 1 == nan_adımı {
            kayıp = kayıp * ondalık("nan")
            nan_adımı = -1
        }
        geri_yayılım(kayıp)
        toplam_kayıp += kayıp.değer
    }
    değişken norm = gradyan_kırp(ağırlıklar, en_fazla: 1.0)
    op.adım()
    op.sıfırla()
    değişken ms = zaman_ms() - t0
    değişken karar = bekçi.gözle(toplam_kayıp, norm.değer)
    eğer karar != eğitim.TAMAM {
        yazdır("  {karar} adım {adım + 1}: kayıp {toplam_kayıp}, grad {norm.değer}")
        eğer kn != yok {
            adım = kn.geri_dön()
            eğer adım == son_dönüş { dönüş_sayısı += 1 } değilse { son_dönüş = adım; dönüş_sayısı = 1 }
            doğrula(dönüş_sayısı < 3, "aynı kontrol noktasına ({adım}. adım) üç kez dönüldü ve sorun sürüyor; eğitim durduruldu (öğrenme oranını, veriyi ya da --bekçi_eşik'i inceleyin)")
            yazdır("  {adım}. adıma dönüldü, {örnekler.atla(arg.atla)} toplu iş atlandı")
            devam
        }
        doğrula(karar != eğitim.SONLU_DEĞİL, "eğitim bozuldu (NaN ya da sonsuz) ve dönülecek kontrol noktası yok; --koşu KLASÖR ile kontrol noktası kurun")
    }
    süreler.ekle(ms)
    pencere.ekle(ms)
    kayıt.ekle({loss: toplam_kayıp, grad_norm: norm.değer})
    eğer (adım + 1) % arg.günlük == 0 veya adım + 1 == arg.adım {
        değişken ort = ortalama(pencere)
        yazdır("adım {adım + 1} / {arg.adım}  kayıp {yuvarla(toplam_kayıp, 4)}  grad {yuvarla(norm.değer, 3)} | {yuvarla(ort, 0)} ms/adım  {yuvarla(adım_başına / ort * 1000, 0)} parça/sn")
        pencere = []
    }
    eğer doğrulama_kümesi != yok ve ((adım + 1) % arg.değerlendirme == 0 veya adım + 1 == arg.adım) {
        değişken d = değerlendir()
        doğrulama_kaydı.ekle({step: adım + 1, loss: d})
        yazdır("  DEĞERLENDİRME adım {adım + 1}: kayıp {yuvarla(d, 4)}")
    }
    adım += 1
    eğer kn != yok { kn.güncelle(adım) }
}

// Ağırlıklar sonuç dosyalarından önce yazılır: en pahalı sonuç odur, sonraki bir hata onu kaybettirmez.
eğer arg.kaydet != "" {
    tensör_kaydet(arg.kaydet, parametreler(model, adlarıyla: doğru))
}

// --adım 0: eğitmeden yalnızca değerlendirir (ör. --ağırlık ile yüklenen, PyTorch'ta eğitilmiş modelin
// doğrulama kaybı; tools/gpu/rgn_to_tr.py).
eğer arg.adım == 0 ve doğrulama_kümesi != yok {
    yazdır("  DEĞERLENDİRME adım 0: kayıp {yuvarla(değerlendir(), 4)}")
}

eğer arg.çıktı != "" ve süreler.uzunluk > 0 {
    değişken ölçülen = süreler[tam(süreler.uzunluk / 2)..süreler.uzunluk]
    dosya_yaz(arg.çıktı, json_metin({tool: "tr", model: "target", steps: arg.adım, tokens_per_step: adım_başına,
        first_step_ms: süreler[0], measured: {median_ms: ortanca(ölçülen), mean_ms: ortalama(ölçülen)}}))
}

eğer arg.kayıplar != "" {
    dosya_yaz(arg.kayıplar, json_metin({steps: kayıt, valid: doğrulama_kaydı}))
}
