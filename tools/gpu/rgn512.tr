//! tr kodlu 3 dil=tr
// Hedef modelin (tools/gpu/rgn512.py) TR karşılığı: aynı mimari ve eğitim tarifi.
//   8 katman YYGYGYYG (Y: son 32 / 64 parçaya bakan yerel katman, G: tam nedensel), GQA ½, QK-norm,
//   RoPE, ön-norm RMSNorm (ε 1e-6), ½ SwiGLU (672, birleşik [G|U], sapmalı), katman başına kelime
//   gömmesi (PLE, P = d), paylaşımlı gömme; Muon (gövde matrisleri) + AdamW (gömme, ple_bağlamı;
//   normlar ve sapmalar çürümesiz) + satır seyrek RMS (PLE tabloları), WSD, gradyan kırpma 1,0, bf16.
// Eksikler (yol haritası Evre 3, "Hedef"): satır seyrek RMS yoğun maskelidir (anlam aynı, maliyet
// O(V·P)); derleme (torch.compile) karşılığı kaynaştırma yoktur. Kayıp logitleri bütün olarak
// tutmaz (model.kayıp → doğrusal_çapraz_entropi, 8192'lik dilimler; hedef de dilimler ama geri
// geçişte yeniden hesaplar).
//
// Kullanım: ./tr rgn512.tr --veri KLASÖR [--adım 120] [--çıktı sonuç.json]
//   veri: uint16 .npy parça dosyalarının klasörü (belge sonu 0), hedefle aynı biçim.
// Doğruluk karşılaştırması (tools/gpu/rgn_reference.py ile): --ağırlık init.trt PyTorch'un başlangıç
// ağırlıklarını yükler, --sıralı doğru toplu işleri sırayla okur (PyTorch tarafı aynı pencereleri
// kurar), --hassasiyet fp32 bf16'yı kapatır, --kayıplar adım başına kaybı ve gradyan normunu yazar.
// Kalite: --doğrulama valid.npy her --değerlendirme adımda ve sonda doğrulama kaybını hedefin yöntemiyle
// ölçer (dosyanın başından --değerlendirme_parça kadar ardışık pencere; rgn512.py evaluate).
// Kararlılık (dil tanımı 15.36, 20.14, 20.15; tr/egitim): her adımın kaybını ve gradyan normunu bir
// sıçrama bekçisi izler (son --bekçi_pencere sağlam adıma göre --bekçi_eşik standart sapma). --koşu
// KLASÖR verilince kontrol noktası kurulur (her --kayıt_dakika dakikada bir; yeniden çalıştırılınca
// kaldığı adımdan sürer): NaN, sonsuz ya da sıçramada son noktaya dönülür ve --atla toplu iş atlanır.
// --koşu yoksa NaN ya da sonsuzda eğitim açık bir hatayla durur, sıçramada uyarı yazılır. Aynı
// noktaya üçüncü kez dönülürse (sorun kalıcı) eğitim açık bir hatayla durur. Bekçi değeri
// adımın sonunda zaten okunan kayıp ve normdan okur: adıma bekleme eklemez. --nan_adımı N (sınama
// için) N. adımın kaybını bir kez NaN yapar.
// Sonuç: --kaydet DOSYA eğitim bitince son ağırlıkları (parametreler, yol adlarıyla) tensör dosyası
// olarak yazar; tools/gpu/rgn_from_tr.py onları PyTorch modeline yükleyip doğrulama kaybını hedefin
// kendi koduyla ölçer ve metin üretir.
// Tersi: --ağırlık DOSYA --adım 0 PyTorch'ta eğitilmiş modeli (rgn_to_tr.py) eğitmeden TR'nin koduyla ölçer.

TR_kw_var arg = TR_fn_command_line({veri: "", TR_mem_step: 120, toplu: 64, mikro: 32, bağlam: 1024, oran: 0.002,
    TR_mem_device: "gpu", tohum: 0, günlük: 50, çıktı: "", ağırlık: "", TR_mem_sequential: TR_kw_false, hassasiyet: "bf16",
    kayıplar: "", dağarcık: 40000, boyut: 512, katman: 8, bakış_sayısı: 8, kv_bakış_sayısı: 4, ara: 672,
    doğrulama: "", değerlendirme: 1000, değerlendirme_parça: 4194304,
    koşu: "", kayıt_dakika: 15, bekçi_pencere: 128, bekçi_eşik: 6.0, TR_mem_skip: 200, nan_adımı: -1, TR_mem_save: ""},
    TR_arg_description: "Hedef modelin TR karşılığı (PyTorch: rgn512.py)")
TR_fn_assert(arg.veri != "", "--veri ile .npy klasörü verilmeli")
TR_fn_default_device(arg.TR_mem_device)

TR_kw_import "tr/katman" TR_ctx_as katman
TR_kw_import "tr/iyilestirici" TR_ctx_as iyileştirici
TR_kw_import "tr/egitim" TR_ctx_as eğitim

// Boyutlar hedefin varsayılanlarıdır; küçük boyutlar yalnızca hızlı doğruluk testi içindir (8 katman ve
// düzen sabittir, PLE boyutu = boyut).
TR_kw_var model = katman.GPT(arg.dağarcık, bağlam: arg.bağlam, boyut: arg.boyut, katman: arg.katman, bakış_sayısı: arg.bakış_sayısı,
    kv_bakış_sayısı: arg.kv_bakış_sayısı, ara_boyut: arg.ara, paylaşımlı: TR_kw_true,
    pencereler: katman.katman_pencereleri("YYGYGYYG", [32, 64]), qk_normu: TR_kw_true, birleşik_kv: TR_kw_true,
    birleşik_kapı: TR_kw_true, ileri_sapmalı: TR_kw_true, epsilon: 0.000001, ple_boyutu: arg.boyut, tohum: arg.tohum + 1)

TR_kw_var op = iyileştirici.MuonVeAdamW(model, muon_oranı: arg.oran, adamw_oranı: arg.oran,
    ağırlık_çürümesi: 0.1, adamw_çürümesi: 0.1, muon_ölçeği: "rms",
    ayrı: ["gömme", "ple_bağlamı"], seyrek: ["ple.tablo"],
    ns_türü: TR_kw_if arg.hassasiyet == "fp32" { "float32" } TR_kw_else { "bf16" })
TR_kw_if arg.ağırlık != "" {
    TR_fn_load_parameters(model, TR_fn_load_tensors(arg.ağırlık))
}
TR_kw_var ağırlıklar = TR_fn_parameters(model)

TR_kw_var birikim = arg.toplu / arg.mikro
TR_kw_var küme = TR_fn_dataset(arg.veri)
TR_kw_var örnekler = TR_kw_if arg.TR_mem_sequential { küme.TR_mem_sequential(TR_arg_batch_size: arg.mikro, TR_arg_context: arg.bağlam) } TR_kw_else {
    küme.TR_mem_sampler(TR_arg_batch_size: arg.mikro, TR_arg_context: arg.bağlam, TR_arg_seed: arg.tohum) }
TR_kw_var adım_başına = arg.toplu * arg.bağlam
TR_kw_var ısınma = TR_fn_max(1, TR_fn_int(arg.TR_mem_step * 0.01))

// Parametreler hedefin ayrımıyla sayılır: PLE tabloları gömme gibi çalışır (her parçada bir satır),
// modelin boyu gövde + gömmedir.
TR_kw_var parametre_sayısı = 0
TR_kw_var ple_tablo = 0
TR_kw_for ad, p TR_kw_in TR_fn_parameters(model, TR_arg_named: TR_kw_true) {
    TR_kw_var n = 1
    TR_kw_for k TR_kw_in p.TR_mem_shape { n *= k }
    parametre_sayısı += n
    TR_kw_if iyileştirici.ad_uyar_mı(ad, "ple.tablo") { ple_tablo += n }
}
TR_kw_var M = (n) => TR_fn_round(n / 1000000.0, 1)
TR_fn_print("hedef model (TR) | YYGYGYYG | {M(parametre_sayısı)}M parametre (PLE tabloları {M(ple_tablo)}M, gövde + gömme {M(parametre_sayısı - ple_tablo)}M) | {arg.TR_mem_step} adım × {adım_başına} parça | cihaz {TR_fn_default_device()}")

// Doğrulama kaybı: dosyanın başından ardışık pencereler (hedefle aynı), türevsiz, eğitimin hassasiyetiyle.
TR_kw_var doğrulama_kümesi = TR_kw_if arg.doğrulama == "" { TR_kw_none } TR_kw_else { TR_fn_dataset(arg.doğrulama) }
TR_kw_func değerlendir() {
    TR_kw_var s = doğrulama_kümesi.TR_mem_sequential(TR_arg_batch_size: arg.mikro, TR_arg_context: arg.bağlam)
    TR_kw_var n = TR_fn_max(1, arg.değerlendirme_parça / arg.bağlam / arg.mikro)
    TR_kw_var kayıp_toplamı = 0.0
    TR_fn_no_grad {
        TR_kw_for i TR_kw_in 0..n {
            TR_kw_var xy = s.TR_mem_next()
            TR_kw_if arg.hassasiyet == "fp32" {
                kayıp_toplamı += model.kayıp(xy[0], xy[1]).TR_mem_tolist
            } TR_kw_else {
                TR_fn_mixed_precision(arg.hassasiyet) { kayıp_toplamı += model.kayıp(xy[0], xy[1]).TR_mem_tolist }
            }
        }
    }
    TR_kw_return kayıp_toplamı / n
}
TR_kw_var doğrulama_kaydı = []

TR_kw_var süreler = []
TR_kw_var pencere = []
TR_kw_var kayıt = []
TR_kw_var bekçi = eğitim.SıçramaBekçisi(pencere: arg.bekçi_pencere, eşik: arg.bekçi_eşik)
TR_kw_var izlenen = {kayıt: kayıt, doğrulama: doğrulama_kaydı}
TR_kw_var kn = TR_kw_none
TR_kw_if arg.koşu != "" {
    TR_kw_var nesneler = {model: model, adamw: op.adamw, muon: op.muon.TR_mem_state, örnekler: örnekler, izlenen: izlenen}
    TR_kw_if op.adamw_sönümsüz != TR_kw_none { nesneler["adamw_sönümsüz"] = op.adamw_sönümsüz }
    TR_kw_if op.satır_rms != TR_kw_none { nesneler["satır_rms"] = op.satır_rms.TR_mem_state }
    kn = TR_fn_checkpoint(arg.koşu, nesneler, TR_arg_every_minutes: arg.kayıt_dakika)
}
TR_kw_var adım = TR_kw_if kn == TR_kw_none { 0 } TR_kw_else { kn.TR_mem_resume_step }
TR_kw_var nan_adımı = arg.nan_adımı
TR_kw_var son_dönüş = -1 // aynı noktaya art arda dönüşler sayılır: kalıcı bir bozulmada sonsuz döngü olmasın
TR_kw_var dönüş_sayısı = 0
TR_kw_for adım < arg.TR_mem_step {
    op.çarpan_ayarla(TR_fn_max(0.000001, iyileştirici.oran_planı(adım, arg.TR_mem_step, ısınma: ısınma, azalma: 0.2)))
    TR_kw_var t0 = TR_fn_time_ms()
    TR_kw_var toplam_kayıp = 0.0
    TR_kw_for m TR_kw_in 0..birikim {
        TR_kw_var xy = örnekler.TR_mem_next()
        TR_kw_var kayıp = TR_kw_none
        TR_kw_if arg.hassasiyet == "fp32" {
            kayıp = model.kayıp(xy[0], xy[1]) / birikim
        } TR_kw_else {
            TR_fn_mixed_precision(arg.hassasiyet) {
                kayıp = model.kayıp(xy[0], xy[1]) / birikim
            }
        }
        TR_kw_if adım + 1 == nan_adımı {
            kayıp = kayıp * TR_fn_float("nan")
            nan_adımı = -1
        }
        TR_fn_backward(kayıp)
        toplam_kayıp += kayıp.TR_mem_tolist
    }
    TR_kw_var norm = TR_fn_clip_grad(ağırlıklar, TR_arg_max: 1.0)
    op.TR_mem_step()
    op.TR_mem_zero_grad()
    TR_kw_var ms = TR_fn_time_ms() - t0
    TR_kw_var karar = bekçi.gözle(toplam_kayıp, norm.TR_mem_tolist)
    TR_kw_if karar != eğitim.TAMAM {
        TR_fn_print("  {karar} adım {adım + 1}: kayıp {toplam_kayıp}, grad {norm.TR_mem_tolist}")
        TR_kw_if kn != TR_kw_none {
            adım = kn.TR_mem_rollback()
            TR_kw_if adım == son_dönüş { dönüş_sayısı += 1 } TR_kw_else { son_dönüş = adım; dönüş_sayısı = 1 }
            TR_fn_assert(dönüş_sayısı < 3, "aynı kontrol noktasına ({adım}. adım) üç kez dönüldü ve sorun sürüyor; eğitim durduruldu (öğrenme oranını, veriyi ya da --bekçi_eşik'i inceleyin)")
            TR_fn_print("  {adım}. adıma dönüldü, {örnekler.TR_mem_skip(arg.TR_mem_skip)} toplu iş atlandı")
            TR_kw_continue
        }
        TR_fn_assert(karar != eğitim.SONLU_DEĞİL, "eğitim bozuldu (NaN ya da sonsuz) ve dönülecek kontrol noktası yok; --koşu KLASÖR ile kontrol noktası kurun")
    }
    süreler.TR_mem_append(ms)
    pencere.TR_mem_append(ms)
    kayıt.TR_mem_append({loss: toplam_kayıp, grad_norm: norm.TR_mem_tolist})
    TR_kw_if (adım + 1) % arg.günlük == 0 TR_kw_or adım + 1 == arg.TR_mem_step {
        TR_kw_var ort = TR_fn_mean(pencere)
        TR_fn_print("adım {adım + 1} / {arg.TR_mem_step}  kayıp {TR_fn_round(toplam_kayıp, 4)}  grad {TR_fn_round(norm.TR_mem_tolist, 3)} | {TR_fn_round(ort, 0)} ms/adım  {TR_fn_round(adım_başına / ort * 1000, 0)} parça/sn")
        pencere = []
    }
    TR_kw_if doğrulama_kümesi != TR_kw_none TR_kw_and ((adım + 1) % arg.değerlendirme == 0 TR_kw_or adım + 1 == arg.TR_mem_step) {
        TR_kw_var d = değerlendir()
        doğrulama_kaydı.TR_mem_append({step: adım + 1, loss: d})
        TR_fn_print("  DEĞERLENDİRME adım {adım + 1}: kayıp {TR_fn_round(d, 4)}")
        // Kayıp kaydı her değerlendirmede yazılır: koşu sonra bir hatayla biterse ölçülenler kalır.
        TR_kw_if arg.kayıplar != "" { TR_fn_write_file(arg.kayıplar, TR_fn_json_string({steps: kayıt, valid: doğrulama_kaydı})) }
    }
    adım += 1
    TR_kw_if kn != TR_kw_none { kn.TR_mem_update(adım) }
}

// Ağırlıklar sonuç dosyalarından önce yazılır: en pahalı sonuç odur, sonraki bir hata onu kaybettirmez.
TR_kw_if arg.TR_mem_save != "" {
    TR_fn_save_tensors(arg.TR_mem_save, TR_fn_parameters(model, TR_arg_named: TR_kw_true))
}

// --adım 0: eğitmeden yalnızca değerlendirir (ör. --ağırlık ile yüklenen, PyTorch'ta eğitilmiş modelin
// doğrulama kaybı; tools/gpu/rgn_to_tr.py).
TR_kw_if arg.TR_mem_step == 0 TR_kw_and doğrulama_kümesi != TR_kw_none {
    TR_fn_print("  DEĞERLENDİRME adım 0: kayıp {TR_fn_round(değerlendir(), 4)}")
}

TR_kw_if arg.çıktı != "" TR_kw_and süreler.TR_mem_length > 0 {
    TR_kw_var ölçülen = süreler[TR_fn_int(süreler.TR_mem_length / 2)..süreler.TR_mem_length]
    TR_fn_write_file(arg.çıktı, TR_fn_json_string({tool: "tr", model: "target", steps: arg.TR_mem_step, tokens_per_step: adım_başına,
        first_step_ms: süreler[0], measured: {median_ms: TR_fn_median(ölçülen), mean_ms: TR_fn_mean(ölçülen)}}))
}

TR_kw_if arg.kayıplar != "" {
    TR_fn_write_file(arg.kayıplar, TR_fn_json_string({steps: kayıt, valid: doğrulama_kaydı}))
}
