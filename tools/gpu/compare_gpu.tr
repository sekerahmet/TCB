# TR 4
# GPU kıyası: CPU kıyasının (tools/bench) modeli GPU'da. Aynı model ve ayarlar
# compare_gpu.py'de. Ayarlar aynı klasördeki compare_config.json'dan okunur:
#   {"boyut": "kucuk" | "buyuk" | "buyuk_kisa" | "gpt" | "gpt_kisa" | "deneme", "veri": "/content/veri" ya da "", "cihaz": "gpu",
#    "hassasiyet": "float32" (varsayılan) ya da "bf16" (karışık hassasiyet)}
# "buyuk_kisa" büyük modelin kısa koşusudur (profil ve dış profilleyici için). "gpt" GPT-2 küçük
# boyunda (~116 M parametre: D768, 12 katman, bağlam 1024) bir modeldir.
# "veri" boşsa sabit sentetik toplu işler kullanılır (kayıp anlamsız, süre geçerli).
# Çıktı: ısınma hariç ms/adım ve son kayıp.

TR_import "measurement_model"

TR_var ayar = TR_json_parse(TR_read_file("compare_config.json"))
TR_var hassasiyet = "float32"
TR_if ayar.TR_get("hassasiyet") != TR_none { hassasiyet = TR_String(ayar["hassasiyet"]) }
TR_var boyutlar = {
    "kucuk": {"B": 8, "T": 64, "D": 128, "H": 4, "FF": 256, "KATMAN": 2, "ADIM": 220, "ISINMA": 20},
    "buyuk": {"B": 32, "T": 256, "D": 512, "H": 8, "FF": 2048, "KATMAN": 6, "ADIM": 220, "ISINMA": 20},
    "buyuk_kisa": {"B": 32, "T": 256, "D": 512, "H": 8, "FF": 2048, "KATMAN": 6, "ADIM": 40, "ISINMA": 10},
    "gpt": {"B": 16, "T": 1024, "D": 768, "H": 12, "FF": 2048, "KATMAN": 12, "ADIM": 60, "ISINMA": 10},
    "gpt_kisa": {"B": 16, "T": 1024, "D": 768, "H": 12, "FF": 2048, "KATMAN": 12, "ADIM": 20, "ISINMA": 5},
    "deneme": {"B": 2, "T": 8, "D": 16, "H": 2, "FF": 32, "KATMAN": 1, "ADIM": 4, "ISINMA": 1}
}
TR_var b = boyutlar[TR_String(ayar["boyut"])]
TR_var B = b["B"]
TR_var T = b["T"]
TR_var D = b["D"]
TR_var H = b["H"]
TR_var Dh = D // H
TR_var FF = b["FF"]
TR_const KATMAN = b["KATMAN"]
TR_const ADIM = b["ADIM"]
TR_const ISINMA = b["ISINMA"]
TR_var V = 40000
TR_if TR_String(ayar["boyut"]) == "deneme" { V = 200 }

TR_print("cihaz: \(TR_default_device(TR_String(ayar["cihaz"]))) · cihazlar: \(TR_devices())")
TR_print("ayar: \(TR_String(ayar["boyut"])) B=\(B) T=\(T) D=\(D) H=\(H) FF=\(FF) katman=\(KATMAN) V=\(V)")

# Toplu işler: veri kümesinden (varsayılan cihazda) ya da sabit sentetik.
TR_var ö = TR_none
TR_var sentetik = []
TR_if TR_String(ayar["veri"]) != "" {
    ö = TR_Dataset(TR_String(ayar["veri"])).TR_sampler(TR_batch_size: B, TR_context: T, TR_seed: 1)
} TR_else {
    TR_for s TR_in 0..8 {
        TR_var satırlar = [[(s * 7919 + i * 104729 + t * 31) % V TR_for t TR_in 0.. (T + 1)] TR_for i TR_in 0..B]
        TR_var tümü = TR_Tensor(satırlar)
        sentetik.TR_append([tümü.TR_slice(1, 0, T), tümü.TR_slice(1, 1, T + 1)])
    }
}
TR_func toplu_iş(adım) {
    TR_if ö != TR_none { TR_return ö.TR_next() }
    TR_return sentetik[adım % 8]
}

TR_var model = Model()
TR_var ağırlıklar = TR_parameters(model)
TR_var sayı = 0
TR_for w TR_in ağırlıklar { sayı += TR_sum(TR_ones(w.TR_shape)).TR_tolist }
TR_print("parametre: \(TR_round(sayı / 1000000, 2)) M · ağırlıkların cihazı: \(model.E.TR_device)")
TR_var iyileştirici = TR_AdamW(ağırlıklar, TR_lr: 0.003, TR_weight_decay: 0.0)

TR_var başlangıç = 0
TR_var kayıp = TR_none
TR_for adım TR_in 0..ADIM {
    TR_if adım == ISINMA {
        TR_if kayıp != TR_none { TR_var bekle_ = kayıp.TR_tolist } # ısınmanın bitmesini bekle
        başlangıç = TR_time_ms()
    }
    TR_var xy = toplu_iş(adım)
    iyileştirici.TR_zero_grad()
    TR_mixed_precision(hassasiyet) {
        kayıp = TR_cross_entropy(model.TR_forward(xy[0]), xy[1])
    }
    TR_backward(kayıp)
    TR_clip_grad(ağırlıklar, TR_max: 1.0)
    iyileştirici.TR_step()
}
TR_var son = kayıp.TR_tolist # GPU'daki son adımın bitmesini bekler
TR_var süre = TR_time_ms() - başlangıç
TR_print("TR (\(TR_default_device()), \(hassasiyet)): \(TR_round(süre / (ADIM - ISINMA), 2)) ms/adım · son kayıp \(TR_round(son, 4))")
