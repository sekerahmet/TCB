# TR 4
# Ölçüm modeli: compare_gpu.tr ve phase3_tr.tr aynı modeli (RMS normlu, SwiGLU'lu, paylaşımlı çıkışlı
# küçük bir GPT) kurar; PyTorch karşılıkları compare_gpu.py ve phase3_torch.py'dedir. Model kasıtlı
# olarak lib/layers.tr'ye bağlanmaz: ölçüm programı PyTorch dosyasıyla katman katman eşleşir, kitaplık
# değişince ölçüm sessizce değişmesin. Bu dosya aktaranın B, T, D, H, Dh, FF, KATMAN ve V adlarını
# kullanır (aktar'dan önce tanımlı olmalıdır); ağırlık tohumları kurulum sırasına bağlıdır.
# Kendisi program değildir: tr kontrol/çalıştırma aktaran dosyalardan yapılır.

TR_var tohum_sayacı = 0
TR_func ağırlık(şekil, ölçek) {
    tohum_sayacı += 1
    TR_return TR_Tensor(TR_no_grad(TR_randn(şekil, TR_seed: tohum_sayacı) * ölçek), TR_requires_grad: TR_true)
}

TR_struct Blok {
    g1
    g2
    Wq
    Wk
    Wv
    Wo
    Wg
    Wu
    W2
    TR_func TR_init() {
        TR_self.g1 = TR_Tensor(TR_ones([D]), TR_requires_grad: TR_true)
        TR_self.g2 = TR_Tensor(TR_ones([D]), TR_requires_grad: TR_true)
        TR_self.Wq = ağırlık([D, D], 0.02)
        TR_self.Wk = ağırlık([D, D], 0.02)
        TR_self.Wv = ağırlık([D, D], 0.02)
        TR_self.Wo = ağırlık([D, D], 0.01)
        TR_self.Wg = ağırlık([D, FF], 0.02)
        TR_self.Wu = ağırlık([D, FF], 0.02)
        TR_self.W2 = ağırlık([FF, D], 0.01)
    }
    TR_func TR_starts_with(x) { TR_return x.TR_reshape([B, T, H, Dh]) } # dikkat'in düzeni [B, T, H, Dh]
    TR_func TR_forward(x) {
        TR_var h = TR_rms_norm(x, TR_self.g1)
        TR_var y = TR_attention(TR_self.TR_starts_with(h @ TR_self.Wq), TR_self.TR_starts_with(h @ TR_self.Wk), TR_self.TR_starts_with(h @ TR_self.Wv), TR_causal: TR_true)
        TR_var s = x + y.TR_reshape([B, T, D]) @ TR_self.Wo
        TR_var m = TR_rms_norm(s, TR_self.g2)
        TR_return s + (TR_silu(m @ TR_self.Wg) * (m @ TR_self.Wu)) @ TR_self.W2
    }
}

TR_struct Model {
    E
    TR_blocks
    gs
    TR_func TR_init() {
        TR_self.E = ağırlık([V, D], 0.02)
        TR_self.TR_blocks = TR_List(0..KATMAN).TR_map((_) => Blok())
        TR_self.gs = TR_Tensor(TR_ones([D]), TR_requires_grad: TR_true)
    }
    TR_func TR_forward(kimlikler) {
        TR_var x = TR_embedding_lookup(TR_self.E, kimlikler)
        TR_for bl TR_in TR_self.TR_blocks { x = bl.TR_forward(x) }
        TR_return TR_rms_norm(x, TR_self.gs) @ TR_self.E.TR_transpose() # paylaşımlı çıkış
    }
}
