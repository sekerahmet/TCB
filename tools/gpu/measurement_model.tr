//! tr kodlu 3 dil=tr
// Ölçüm modeli: compare_gpu.tr ve phase3_tr.tr aynı modeli (RMS normlu, SwiGLU'lu, paylaşımlı çıkışlı
// küçük bir GPT) kurar; PyTorch karşılıkları compare_gpu.py ve phase3_torch.py'dedir. Model kasıtlı
// olarak lib/katman.tr'ye bağlanmaz: ölçüm programı PyTorch dosyasıyla katman katman eşleşir, kitaplık
// değişince ölçüm sessizce değişmesin. Bu dosya aktaranın B, T, D, H, Dh, FF, KATMAN ve V adlarını
// kullanır (aktar'dan önce tanımlı olmalıdır); ağırlık tohumları kurulum sırasına bağlıdır.
// Kendisi program değildir: tr kontrol/çalıştırma aktaran dosyalardan yapılır.

TR_kw_var tohum_sayacı = 0
TR_kw_func ağırlık(şekil, ölçek) {
    tohum_sayacı += 1
    TR_kw_return TR_fn_tensor(TR_fn_no_grad(TR_fn_randn(şekil, TR_arg_seed: tohum_sayacı) * ölçek), TR_arg_requires_grad: TR_kw_true)
}

TR_kw_struct Blok {
    g1
    g2
    Wq
    Wk
    Wv
    Wo
    Wg
    Wu
    W2
    TR_kw_func TR_ctx_init() {
        TR_kw_self.g1 = TR_fn_tensor(TR_fn_ones([D]), TR_arg_requires_grad: TR_kw_true)
        TR_kw_self.g2 = TR_fn_tensor(TR_fn_ones([D]), TR_arg_requires_grad: TR_kw_true)
        TR_kw_self.Wq = ağırlık([D, D], 0.02)
        TR_kw_self.Wk = ağırlık([D, D], 0.02)
        TR_kw_self.Wv = ağırlık([D, D], 0.02)
        TR_kw_self.Wo = ağırlık([D, D], 0.01)
        TR_kw_self.Wg = ağırlık([D, FF], 0.02)
        TR_kw_self.Wu = ağırlık([D, FF], 0.02)
        TR_kw_self.W2 = ağırlık([FF, D], 0.01)
    }
    TR_kw_func TR_mem_starts_with(x) { TR_kw_return x.TR_mem_reshape([B, T, H, Dh]) } // dikkat'in düzeni [B, T, H, Dh]
    TR_kw_func TR_mem_forward(x) {
        TR_kw_var h = TR_fn_rms_norm(x, TR_kw_self.g1)
        TR_kw_var y = TR_fn_attention(TR_kw_self.TR_mem_starts_with(h @ TR_kw_self.Wq), TR_kw_self.TR_mem_starts_with(h @ TR_kw_self.Wk), TR_kw_self.TR_mem_starts_with(h @ TR_kw_self.Wv), TR_arg_causal: TR_kw_true)
        TR_kw_var s = x + y.TR_mem_reshape([B, T, D]) @ TR_kw_self.Wo
        TR_kw_var m = TR_fn_rms_norm(s, TR_kw_self.g2)
        TR_kw_return s + (TR_fn_silu(m @ TR_kw_self.Wg) * (m @ TR_kw_self.Wu)) @ TR_kw_self.W2
    }
}

TR_kw_struct Model {
    E
    TR_mem_blocks
    gs
    TR_kw_func TR_ctx_init() {
        TR_kw_self.E = ağırlık([V, D], 0.02)
        TR_kw_self.TR_mem_blocks = TR_fn_range(KATMAN).TR_mem_map { Blok() }
        TR_kw_self.gs = TR_fn_tensor(TR_fn_ones([D]), TR_arg_requires_grad: TR_kw_true)
    }
    TR_kw_func TR_mem_forward(kimlikler) {
        TR_kw_var x = TR_fn_embedding(TR_kw_self.E, kimlikler)
        TR_kw_for bl TR_kw_in TR_kw_self.TR_mem_blocks { x = bl.TR_mem_forward(x) }
        TR_kw_return TR_fn_rms_norm(x, TR_kw_self.gs) @ TR_kw_self.E.TR_mem_transpose() // paylaşımlı çıkış
    }
}
