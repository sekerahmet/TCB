# TR 4
# Ölçüm modeli: compare_gpu.tr ve phase3_tr.tr aynı modeli (RMS normlu, SwiGLU'lu, paylaşımlı çıkışlı
# küçük bir GPT) kurar; PyTorch karşılıkları compare_gpu.py ve phase3_torch.py'dedir. Model kasıtlı
# olarak lib/layers.tr'ye bağlanmaz: ölçüm programı PyTorch dosyasıyla katman katman eşleşir, kitaplık
# değişince ölçüm sessizce değişmesin. Boyutları aktaran kurar ve modele verir: Model(Boyutlar(B: ...,
# T: ..., D: ..., H: ..., Dh: ..., FF: ..., katman: ..., V: ...)); modül aktaranın adlarını görmez (5.14).
# Ağırlık tohumları kurulum sırasına bağlıdır. Kendisi program değildir: trlang check/çalıştırma
# aktaran dosyalardan yapılır.

TR_var tohum_sayacı = 0
TR_func ağırlık(şekil: TR_List[TR_Int], ölçek: TR_Float) -> TR_Tensor {
    tohum_sayacı += 1
    TR_return TR_Tensor(TR_no_grad(TR_randn(şekil, TR_seed: tohum_sayacı) * ölçek), TR_requires_grad: TR_true)
}

# Boyutlar modelin boyutlarıdır: toplu iş (B), bağlam (T), genişlik (D), bakış sayısı (H) ve bakışın
# boyutu (Dh), ileri beslemenin genişliği (FF), katman sayısı (katman) ve sözlük (V).
TR_struct Boyutlar {
    B: TR_Int
    T: TR_Int
    D: TR_Int
    H: TR_Int
    Dh: TR_Int
    FF: TR_Int
    katman: TR_Int
    V: TR_Int
}

TR_struct Blok {
    g1: TR_Tensor
    g2: TR_Tensor
    Wq: TR_Tensor
    Wk: TR_Tensor
    Wv: TR_Tensor
    Wo: TR_Tensor
    Wg: TR_Tensor
    Wu: TR_Tensor
    W2: TR_Tensor
    b: Boyutlar
    TR_func TR_init(b: Boyutlar) {
        TR_self.b = b
        TR_var D = b.D
        TR_var FF = b.FF
        TR_self.g1 = TR_Tensor(TR_ones([D]), TR_requires_grad: TR_true)
        TR_self.g2 = TR_Tensor(TR_ones([D]), TR_requires_grad: TR_true)
        TR_self.Wq = ağırlık([D, D], 0.02)
        TR_self.Wk = ağırlık([D, D], 0.02)
        TR_self.Wv = ağırlık([D, D], 0.02)
        TR_self.Wo = ağırlık([D, D], 0.01)
        TR_self.Wg = ağırlık([D, FF], 0.02)
        TR_self.Wu = ağırlık([D, FF], 0.02)
        TR_self.W2 = ağırlık([FF, D], 0.01)
    }
    TR_func düzen(x: TR_Tensor) -> TR_Tensor { TR_return x.TR_reshape([TR_self.b.B, TR_self.b.T, TR_self.b.H, TR_self.b.Dh]) } # dikkat'in düzeni [B, T, H, Dh]
    TR_func ileri(x: TR_Tensor) -> TR_Tensor {
        TR_var h = TR_rms_norm(x, TR_self.g1)
        TR_var y = TR_attention(TR_self.düzen(h @ TR_self.Wq), TR_self.düzen(h @ TR_self.Wk), TR_self.düzen(h @ TR_self.Wv), TR_causal: TR_true)
        TR_var s = x + y.TR_reshape([TR_self.b.B, TR_self.b.T, TR_self.b.D]) @ TR_self.Wo
        TR_var m = TR_rms_norm(s, TR_self.g2)
        TR_return s + (TR_silu(m @ TR_self.Wg) * (m @ TR_self.Wu)) @ TR_self.W2
    }
}

TR_struct Model {
    E: TR_Tensor
    bloklar: TR_List[Blok]
    gs: TR_Tensor
    TR_func TR_init(b: Boyutlar) {
        TR_self.E = ağırlık([b.V, b.D], 0.02)
        TR_self.bloklar = TR_List(0..b.katman).TR_map((_) => Blok(b))
        TR_self.gs = TR_Tensor(TR_ones([b.D]), TR_requires_grad: TR_true)
    }
    TR_func ileri(kimlikler: TR_Tensor[TR_Int]) -> TR_Tensor {
        TR_var x = TR_embedding_lookup(TR_self.E, kimlikler)
        TR_for bl TR_in TR_self.bloklar { x = bl.ileri(x) }
        TR_return TR_rms_norm(x, TR_self.gs) @ TR_self.E.TR_transpose() # paylaşımlı çıkış
    }
}
