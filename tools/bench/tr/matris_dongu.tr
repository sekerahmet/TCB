# TR 4
# n×n tamsayı matris çarpımının izi; --n kenar (öntanımı tools/bench/run.py'nin boyu; S13 büyütür, Go'nun compare'i aynı
# --n'i alır).
TR_var opt = TR_command_line({"n": 120})
TR_var n = TR_Int(opt["n"])
TR_var a = []
TR_var b = []
TR_var i = 0
TR_for i < n {
    TR_var sa = []
    TR_var sb = []
    TR_var j = 0
    TR_for j < n {
        sa.TR_append((i * j) % 7)
        sb.TR_append((i + j) % 5)
        j += 1
    }
    a.TR_append(sa)
    b.TR_append(sb)
    i += 1
}
TR_var bas = TR_time_ms()
TR_var c = []
i = 0
TR_for i < n {
    TR_var satir = []
    TR_var j = 0
    TR_for j < n {
        TR_var t = 0
        TR_var k = 0
        TR_for k < n {
            t += a[i][k] * b[k][j]
            k += 1
        }
        satir.TR_append(t)
        j += 1
    }
    c.TR_append(satir)
    i += 1
}
# Sonuç: iz ve bütün öğelerin toplamı; her iç çarpım sonuca girer (DENETİM 953 Ş2).
TR_var iz = 0
TR_var toplam = 0
i = 0
TR_for i < n {
    iz += c[i][i]
    TR_var j = 0
    TR_for j < n {
        toplam += c[i][j]
        j += 1
    }
    i += 1
}
TR_print("matris_dongu \(iz)/\(toplam) \(TR_time_ms() - bas)")
