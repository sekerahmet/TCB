# TR 4
# 0'dan n-1'e kadar toplam; --n tur sayısı (öntanımı tools/bench/run.py'nin boyu; S13 büyütür, Go'nun compare'i aynı --n'i alır).
TR_var opt = TR_command_line({"n": 3000000})
TR_var n = TR_Int(opt["n"])
TR_var bas = TR_time_ms()
TR_var birikim = 0
TR_var i = 0
TR_for i < n {
    birikim += i
    i += 1
}
TR_print("dongu \(birikim) \(TR_time_ms() - bas)")
