{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "This file is generated from the code list (internal/lang/codes/tr.json); do not edit it by hand: go run ./tools/gen/grammar",
  "name": "TR Dili",
  "scopeName": "source.tr",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#import"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#pronoun"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tr",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tr",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tr",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tr"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tr"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.single.tr",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tr"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tr"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.other.raw.tr",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tr"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tr"
            }
          }
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "constant.character.escape.brace.tr",
          "match": "\\\\[{}]"
        },
        {
          "name": "constant.character.escape.tr",
          "match": "\\\\[ntr\"'\\\\]"
        },
        {
          "name": "invalid.illegal.escape.tr",
          "match": "\\\\."
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.tr",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.tr"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.tr"
        }
      },
      "contentName": "meta.embedded.expression.tr",
      "patterns": [
        {
          "include": "#nested-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "nested-braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.tr"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.tr"
        }
      },
      "patterns": [
        {
          "include": "#nested-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(aktar|import)\\b\\s*(\"[^\"]*\"|'[^']*'|[^\\W\\d][\\w.]*)\\s+(olarak|as)\\b\\s*([^\\W\\d]\\w*)?",
          "captures": {
            "1": {
              "name": "keyword.control.import.tr"
            },
            "2": {
              "name": "string.other.module.tr"
            },
            "3": {
              "name": "keyword.control.import.as.tr"
            },
            "4": {
              "name": "entity.name.namespace.tr"
            }
          }
        },
        {
          "name": "keyword.control.import.tr",
          "match": "\\b(aktar|import)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fonksiyon|func)\\s+([^\\W\\d]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.function.tr"
            },
            "2": {
              "name": "entity.name.function.tr"
            }
          }
        },
        {
          "match": "\\b(yapı|struct)\\s+([^\\W\\d]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.struct.tr"
            },
            "2": {
              "name": "entity.name.type.tr"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tr",
          "match": "\\b(eğer|değilse|eşle|varsayılan|döngü|içinde|iken|çık|devam|sonuç|dene|yakala|fırlat|eşzamanlı|ertele|if|else|match|default|for|in|while|break|continue|return|try|catch|throw|async|defer)\\b"
        },
        {
          "name": "keyword.other.debugger.tr",
          "match": "\\b(kesme_noktası|breakpoint)\\b"
        },
        {
          "name": "storage.type.tr",
          "match": "\\b(değişken|sabit|fonksiyon|yapı|var|const|func|struct)\\b"
        },
        {
          "name": "variable.language.self.tr",
          "match": "\\b(kendi|self)\\b"
        },
        {
          "name": "constant.language.boolean.tr",
          "match": "\\b(doğru|yanlış|true|false)\\b"
        },
        {
          "name": "constant.language.null.tr",
          "match": "\\b(yok|none)\\b"
        },
        {
          "name": "keyword.operator.logical.tr",
          "match": "\\b(ve|veya|değil|and|or|not)\\b"
        }
      ]
    },
    "pronoun": {
      "comment": "Trailing-block (o-lambda) parameter: liste.filtrele { o > 2 }",
      "patterns": [
        {
          "name": "variable.language.pronoun.tr",
          "match": "(?<![\\w.])o(?!\\w)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.tr",
          "match": "\\b(Herhangi|Mantık|YerleşikFonksiyon|KontrolNoktası|VeriKümesi|Sözlük|Ondalık|Fonksiyon|Tam|SatırOkuyucu|Liste|Günlük|Yok|Nesne|İyileştirici|Yol|İlerleme|Aralık|Örnekleyici|SıralıOkuyucu|Metin|YapıTanımı|Tensör|Parçalayıcı|Tip|Any|Bool|BuiltinFunction|Checkpoint|Dataset|Dict|Float|Function|Int|LineReader|List|Logger|None|Object|Optimizer|Path|Progress|Range|Sampler|SequentialReader|String|StructType|Tensor|Tokenizer|Type)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.tr",
          "match": "\\b(AdamW|SGD|mutlak|acos|argmax|sıralama_indeksi|asin|doğrula|eşit_mi|atan|atan2|dikkat|geri_yayılım|tavan|kontrol_noktası|sınırla|gradyan_kırp|komut_satırı|hesap_türü|bitiştir|kopyala|cos|cosh|çapraz_entropi|birikimli_toplam|özel_türev|veri_kümesi|varsayılan_cihaz|cihazlar|gömme|ortam_değişkeni|exp|expm1|birim_matris|ondalık|taban|kaynaştır|gelu|türev_denetle|girdi|tam|sonlu_mu|json_çöz|json_metin|katman_normu|doğrusal_çapraz_entropi|klasörü_listele|parametreleri_yükle|tensör_yükle|parçalayıcı_yükle|log|log10|log1p|log2|log_softmax|günlük|klasör_oluştur|max|ortalama|ortanca|min|karışık_hassasiyet|taşı|türevsiz|birler|parametreler|csv_çöz|yol|yazdır|ilerleme|rastgele_normal|aralık|csv_oku|dosya_oku|dosya_satırları|relu|sil|tekrar_oynat|rms_normu|yuvarla|örnekle|tensör_kaydet|sigmoid|işaret|silu|sin|sinh|bekle|softmax|karekök|standart_sapma|metin|toplam|tan|tanh|geçici_klasör|tensör|zaman_ms|en_büyük_k|tip|bekle_hepsi|koşullu|dosya_yaz|yerine_yaz|sıfırlar|pi|abs|argsort|assert|assert_equal|attention|backward|ceil|checkpoint|clamp|clip_grad|command_line|compute_dtype|concat|copy|cross_entropy|cumsum|custom_grad|dataset|default_device|devices|embedding|env|eye|float|floor|fuse|grad_check|input|int|is_finite|json_parse|json_string|layer_norm|linear_cross_entropy|list_dir|load_parameters|load_tensors|load_tokenizer|logger|make_dir|mean|median|mixed_precision|move|no_grad|ones|parameters|parse_csv|path|print|progress|randn|range|read_csv|read_file|read_lines|remove|replay|rms_norm|round|sample|save_tensors|sign|sleep|sqrt|std|str|sum|temp_dir|tensor|time_ms|topk|type|wait_all|where|write_file|write_slice|zeros)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tr",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.float.tr",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.tr",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.tr",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.pipe.tr",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.null-coalescing.tr",
          "match": "\\?\\?"
        },
        {
          "name": "punctuation.accessor.optional.tr",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.arrow.tr",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.tr",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.tr",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.tr",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.assignment.tr",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.arithmetic.tr",
          "match": "\\*\\*|@|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.ternary.tr",
          "match": "\\?"
        }
      ]
    }
  }
}
