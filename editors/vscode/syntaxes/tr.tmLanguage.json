{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "This file is generated from the code list (internal/lang/codes/tr.json); do not edit it by hand: go run ./tools/gen/grammar",
  "name": "TR Dili",
  "scopeName": "source.tr",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#import"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#pronoun"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tr",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tr",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tr",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tr"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tr"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.single.tr",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tr"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tr"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.other.raw.tr",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.tr"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.tr"
            }
          }
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "constant.character.escape.brace.tr",
          "match": "\\\\[{}]"
        },
        {
          "name": "constant.character.escape.tr",
          "match": "\\\\[ntr\"'\\\\]"
        },
        {
          "name": "invalid.illegal.escape.tr",
          "match": "\\\\."
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.tr",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.tr"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.tr"
        }
      },
      "contentName": "meta.embedded.expression.tr",
      "patterns": [
        {
          "include": "#nested-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "nested-braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.tr"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.tr"
        }
      },
      "patterns": [
        {
          "include": "#nested-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(aktar|import)\\b\\s*(\"[^\"]*\"|'[^']*'|[^\\W\\d][\\w.]*)\\s+(olarak|as)\\b\\s*([^\\W\\d]\\w*)?",
          "captures": {
            "1": {
              "name": "keyword.control.import.tr"
            },
            "2": {
              "name": "string.other.module.tr"
            },
            "3": {
              "name": "keyword.control.import.as.tr"
            },
            "4": {
              "name": "entity.name.namespace.tr"
            }
          }
        },
        {
          "name": "keyword.control.import.tr",
          "match": "\\b(aktar|import)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fonksiyon|func)\\s+([^\\W\\d]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.function.tr"
            },
            "2": {
              "name": "entity.name.function.tr"
            }
          }
        },
        {
          "match": "\\b(yapı|struct)\\s+([^\\W\\d]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.struct.tr"
            },
            "2": {
              "name": "entity.name.type.tr"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tr",
          "match": "\\b(eğer|değilse|eşle|varsayılan|döngü|içinde|iken|çık|devam|sonuç|dene|yakala|fırlat|eşzamanlı|ertele|if|else|match|default|for|in|while|break|continue|return|try|catch|throw|async|defer)\\b"
        },
        {
          "name": "keyword.other.debugger.tr",
          "match": "\\b(kesme_noktası|breakpoint)\\b"
        },
        {
          "name": "storage.type.tr",
          "match": "\\b(değişken|sabit|fonksiyon|yapı|var|const|func|struct)\\b"
        },
        {
          "name": "variable.language.self.tr",
          "match": "\\b(kendi|self)\\b"
        },
        {
          "name": "constant.language.boolean.tr",
          "match": "\\b(doğru|yanlış|true|false)\\b"
        },
        {
          "name": "constant.language.null.tr",
          "match": "\\b(yok|none)\\b"
        },
        {
          "name": "keyword.operator.logical.tr",
          "match": "\\b(ve|veya|değil|and|or|not)\\b"
        }
      ]
    },
    "pronoun": {
      "comment": "Trailing-block (o-lambda) parameter: liste.filtrele { o > 2 }",
      "patterns": [
        {
          "name": "variable.language.pronoun.tr",
          "match": "(?<![\\w.])o(?!\\w)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.tr",
          "match": "\\b(Tam|Ondalık|Metin|Mantık|Yok|Liste|Sözlük|Aralık|Fonksiyon|YerleşikFonksiyon|YapıTanımı|Nesne|Tensör|Herhangi|İyileştirici|Tip|VeriKümesi|Örnekleyici|SıralıOkuyucu|Parçalayıcı|Yol|İlerleme|Günlük|SatırOkuyucu|KontrolNoktası|Int|Float|String|Bool|None|List|Dict|Range|Function|BuiltinFunction|StructType|Object|Tensor|Any|Optimizer|Type|Dataset|Sampler|SequentialReader|Tokenizer|Path|Progress|Logger|LineReader|Checkpoint)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.tr",
          "match": "\\b(yazdır|girdi|dosya_oku|dosya_yaz|dosya_satırları|yol|klasörü_listele|klasör_oluştur|sil|kopyala|taşı|geçici_klasör|tip|tam|ondalık|metin|aralık|toplam|min|maks|mutlak|karekök|yuvarla|taban|tavan|işaret|sınırla|ortalama|standart_sapma|ortanca|pi|sonlu_mu|bekle|bekle_hepsi|zaman_ms|json_çöz|json_metin|csv_oku|csv_çöz|doğrula|eşit_mi|ortam_değişkeni|komut_satırı|günlük|ilerleme|print|input|read_file|write_file|read_lines|path|list_dir|make_dir|remove|copy|move|temp_dir|type|int|float|str|range|sum|max|abs|sqrt|round|floor|ceil|sign|clamp|mean|std|median|is_finite|sleep|wait_all|time_ms|json_parse|json_string|read_csv|parse_csv|assert|assert_equal|env|command_line|logger|progress)\\b"
        },
        {
          "name": "support.function.ai.tr",
          "match": "\\b(tensör|sıfırlar|birler|rastgele_normal|birim_matris|birleştir|relu|sigmoid|tanh|gelu|silu|softmax|log_softmax|üstel|log|sinüs|kosinüs|tanjant|arksinüs|arkkosinüs|arktanjant|arktanjant2|maks_indeks|birikimli_toplam|en_büyük_k|sıralama_indeksi|koşullu|sinh|cosh|log1p|log2|log10|üstel_eksi_bir|geri_yayılım|türevsiz|özel_türev|türev_denetle|kaynaştır|AdamW|SGD|gradyan_kırp|gömme|katman_normu|rms_normu|dikkat|çapraz_entropi|doğrusal_çapraz_entropi|parametreler|örnekle|tensör_kaydet|tensör_yükle|kontrol_noktası|parametreleri_yükle|karışık_hassasiyet|hesap_türü|varsayılan_cihaz|cihazlar|tensor|zeros|ones|randn|eye|concat|exp|sin|cos|tan|asin|acos|atan|atan2|argmax|cumsum|topk|argsort|where|expm1|backward|no_grad|custom_grad|grad_check|fuse|clip_grad|embedding|layer_norm|rms_norm|attention|cross_entropy|linear_cross_entropy|parameters|sample|save_tensors|load_tensors|checkpoint|load_parameters|mixed_precision|compute_dtype|default_device|devices|veri_kümesi|parçalayıcı_yükle|dataset|load_tokenizer)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tr",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.float.tr",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.tr",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.tr",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.pipe.tr",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.null-coalescing.tr",
          "match": "\\?\\?"
        },
        {
          "name": "punctuation.accessor.optional.tr",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.arrow.tr",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.tr",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.tr",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.tr",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.assignment.tr",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.arithmetic.tr",
          "match": "\\*\\*|@|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.ternary.tr",
          "match": "\\?"
        }
      ]
    }
  }
}
