{
  "en": [
    {
      "label": "Define Function",
      "description": "Defines a new TR function",
      "prefix": [
        "func"
      ],
      "body": [
        "TR_func ${1:name}(${2:parameter}: TR_Int) -> TR_Int {",
        "\tTR_return ${3:${2:parameter}}",
        "}"
      ]
    },
    {
      "label": "If - Else",
      "description": "If / else conditional block",
      "prefix": [
        "if"
      ],
      "body": [
        "TR_if ${1:condition} {",
        "\t${2}",
        "} TR_else {",
        "\t${3}",
        "}"
      ]
    },
    {
      "label": "Match (Pattern Matching)",
      "description": "Case and range matching block",
      "prefix": [
        "match"
      ],
      "body": [
        "TR_match ${1:value} {",
        "\t${2:1} => ${3:\"one\"}",
        "\t${4:2..10} => ${5:\"a few\"}",
        "\t_ => ${6:\"other\"}",
        "}"
      ]
    },
    {
      "label": "Filter (it-lambda)",
      "description": "Filtering with a trailing block; it is the current element",
      "prefix": [
        "filter",
        ".filter"
      ],
      "body": [
        ".TR_filter((x) => x > ${1:2})"
      ]
    },
    {
      "label": "Map (it-lambda)",
      "description": "Transforming with a trailing block; it is the current element",
      "prefix": [
        "map",
        ".map"
      ],
      "body": [
        ".TR_map((x) => x * ${1:2})"
      ]
    },
    {
      "label": "Reduce",
      "description": "Reduces a list from left to right to a single value",
      "prefix": [
        "reduce",
        ".reduce"
      ],
      "body": [
        ".TR_reduce(${1:0}, (acc, x) => ${2:acc + x})"
      ]
    },
    {
      "label": "Loop (In)",
      "description": "Loop over a list or a range",
      "prefix": [
        "for"
      ],
      "body": [
        "TR_for ${1:i} TR_in ${2:1..=10} {",
        "\tTR_print(${1:i})",
        "}"
      ]
    },
    {
      "label": "List Comprehension",
      "description": "Conditional list comprehension on one line",
      "prefix": [
        "list_comp"
      ],
      "body": [
        "[${1:x * x} TR_for ${2:x} TR_in ${3:1..=10} TR_if ${4:x % 2 == 0}]"
      ]
    },
    {
      "label": "Define Struct",
      "description": "Defines a new struct and a method",
      "prefix": [
        "struct"
      ],
      "body": [
        "TR_struct ${1:Name} {",
        "\t${2:field}: TR_String",
        "",
        "\tTR_func ${3:method}() {",
        "\t\tTR_return TR_self.${2:field}",
        "\t}",
        "}"
      ]
    },
    {
      "label": "Try - Catch (Error Handling)",
      "description": "Error catching block",
      "prefix": [
        "try"
      ],
      "body": [
        "TR_try {",
        "\t${1}",
        "} TR_catch err {",
        "\tTR_print(\"Caught error: {err}\")",
        "}"
      ]
    },
    {
      "label": "Tensor and Training Loop (Automatic Differentiation)",
      "description": "A small training loop (linear model) with tensors, the AdamW optimizer and backward",
      "prefix": [
        "Tensor",
        "grad"
      ],
      "body": [
        "TR_var X = TR_Tensor(${1:[[0.0], [1.0], [2.0], [3.0]]})",
        "TR_var Y = TR_Tensor(${2:[[-1.0], [1.0], [3.0], [5.0]]})",
        "TR_var w = TR_Tensor(TR_no_grad(TR_randn([${3:1, 1}], TR_seed: 1) * 0.1), TR_requires_grad: TR_true)",
        "TR_var b = TR_Tensor([0.0], TR_requires_grad: TR_true)",
        "TR_var optimizer = TR_AdamW([w, b], TR_lr: ${4:0.1}, TR_weight_decay: 0)",
        "TR_for step TR_in 0..${5:300} {",
        "\toptimizer.TR_zero_grad()",
        "\tTR_var loss = TR_mean((X @ w + b - Y) ** 2)",
        "\tTR_backward(loss)",
        "\toptimizer.TR_step()",
        "\tTR_if step % 100 == 0 { TR_print(\"step \\(step): loss = \\(loss.TR_tolist)\") }",
        "}",
        "TR_print(TR_no_grad { X @ w + b })$0"
      ]
    }
  ],
  "tr": [
    {
      "label": "Fonksiyon Tanımla",
      "description": "Yeni bir TR fonksiyonu tanımlar",
      "prefix": [
        "fonksiyon"
      ],
      "body": [
        "TR_func ${1:isim}(${2:parametre}: TR_Int) -> TR_Int {",
        "\tTR_return ${3:${2:parametre}}",
        "}"
      ]
    },
    {
      "label": "Eğer - Değilse Koşulu",
      "description": "Eğer / değilse koşul bloğu",
      "prefix": [
        "eğer"
      ],
      "body": [
        "TR_if ${1:koşul} {",
        "\t${2}",
        "} TR_else {",
        "\t${3}",
        "}"
      ]
    },
    {
      "label": "Eşle (Pattern Matching)",
      "description": "Durum ve aralık eşleştirme bloğu",
      "prefix": [
        "eşle"
      ],
      "body": [
        "TR_match ${1:değer} {",
        "\t${2:1} => ${3:\"bir\"}",
        "\t${4:2..10} => ${5:\"birkaç\"}",
        "\t_ => ${6:\"diğer\"}",
        "}"
      ]
    },
    {
      "label": "Filtrele (o-lambda)",
      "description": "Sondaki blokla filtreleme; o, o anki elemandır: liste.filtrele { o > 2 }",
      "prefix": [
        "filtrele",
        ".filtrele"
      ],
      "body": [
        ".TR_filter((x) => x > ${1:2})"
      ]
    },
    {
      "label": "Haritala (o-lambda)",
      "description": "Sondaki blokla dönüştürme; o, o anki elemandır: liste.haritala { o * o }",
      "prefix": [
        "haritala",
        ".haritala"
      ],
      "body": [
        ".TR_map((x) => x * ${1:2})"
      ]
    },
    {
      "label": "İndirge",
      "description": "Listeyi soldan sağa tek değere indirger: liste.indirge(0, (birikim, x) => birikim + x)",
      "prefix": [
        "indirge",
        ".indirge"
      ],
      "body": [
        ".TR_reduce(${1:0}, (birikim, x) => ${2:birikim + x})"
      ]
    },
    {
      "label": "Döngü (İçinde)",
      "description": "Liste veya aralık üzerinde döngü",
      "prefix": [
        "döngü"
      ],
      "body": [
        "TR_for ${1:i} TR_in ${2:1..=10} {",
        "\tTR_print(${1:i})",
        "}"
      ]
    },
    {
      "label": "Liste Üreteci (List Comprehension)",
      "description": "Tek satırda koşullu liste üreteci",
      "prefix": [
        "liste_üret"
      ],
      "body": [
        "[${1:x * x} TR_for ${2:x} TR_in ${3:1..=10} TR_if ${4:x % 2 == 0}]"
      ]
    },
    {
      "label": "Yapı Tanımla",
      "description": "Yeni bir yapı ve metot tanımlar",
      "prefix": [
        "yapı"
      ],
      "body": [
        "TR_struct ${1:İsim} {",
        "\t${2:alan}: TR_String",
        "",
        "\tTR_func ${3:metod}() {",
        "\t\tTR_return TR_self.${2:alan}",
        "\t}",
        "}"
      ]
    },
    {
      "label": "Dene - Yakala (Hata Yönetimi)",
      "description": "Hata yakalama bloğu",
      "prefix": [
        "dene"
      ],
      "body": [
        "TR_try {",
        "\t${1}",
        "} TR_catch hata {",
        "\tTR_print(\"Hata yakalandı: {hata}\")",
        "}"
      ]
    },
    {
      "label": "Tensör ve Eğitim Döngüsü (Otomatik Türev)",
      "description": "Tensörler, AdamW iyileştiricisi ve geri_yayılım ile küçük bir eğitim döngüsü (doğrusal model)",
      "prefix": [
        "Tensör",
        "türev"
      ],
      "body": [
        "TR_var X = TR_Tensor(${1:[[0.0], [1.0], [2.0], [3.0]]})",
        "TR_var Y = TR_Tensor(${2:[[-1.0], [1.0], [3.0], [5.0]]})",
        "TR_var w = TR_Tensor(TR_no_grad(TR_randn([${3:1, 1}], TR_seed: 1) * 0.1), TR_requires_grad: TR_true)",
        "TR_var b = TR_Tensor([0.0], TR_requires_grad: TR_true)",
        "TR_var iyileştirici = TR_AdamW([w, b], TR_lr: ${4:0.1}, TR_weight_decay: 0)",
        "TR_for adım TR_in 0..${5:300} {",
        "\tiyileştirici.TR_zero_grad()",
        "\tTR_var kayıp = TR_mean((X @ w + b - Y) ** 2)",
        "\tTR_backward(kayıp)",
        "\tiyileştirici.TR_step()",
        "\tTR_if adım % 100 == 0 { TR_print(\"adım \\(adım): kayıp = \\(kayıp.TR_tolist)\") }",
        "}",
        "TR_print(TR_no_grad { X @ w + b })$0"
      ]
    }
  ]
}
