{
  "en": [
    {
      "label": "Define Function",
      "description": "Defines a new TR function",
      "prefix": [
        "func"
      ],
      "body": [
        "func ${1:name}(${2:parameter}) {",
        "\treturn ${3:${2:parameter}}",
        "}"
      ]
    },
    {
      "label": "If - Else",
      "description": "If / else conditional block",
      "prefix": [
        "if"
      ],
      "body": [
        "if ${1:condition} {",
        "\t${2}",
        "} else {",
        "\t${3}",
        "}"
      ]
    },
    {
      "label": "Match (Pattern Matching)",
      "description": "Case and range matching block",
      "prefix": [
        "match"
      ],
      "body": [
        "match ${1:value} {",
        "\t${2:1} => ${3:\"one\"}",
        "\t${4:2..10} => ${5:\"a few\"}",
        "\tdefault => ${6:\"other\"}",
        "}"
      ]
    },
    {
      "label": "Filter (it-lambda)",
      "description": "Filtering with a trailing block; it is the current element",
      "prefix": [
        "filter",
        ".filter"
      ],
      "body": [
        ".filter { it > ${1:2} }"
      ]
    },
    {
      "label": "Map (it-lambda)",
      "description": "Transforming with a trailing block; it is the current element",
      "prefix": [
        "map",
        ".map"
      ],
      "body": [
        ".map { it * ${1:2} }"
      ]
    },
    {
      "label": "Reduce",
      "description": "Reduces a list from left to right to a single value",
      "prefix": [
        "reduce",
        ".reduce"
      ],
      "body": [
        ".reduce(${1:0}, (acc, x) => ${2:acc + x})"
      ]
    },
    {
      "label": "Loop (In)",
      "description": "Loop over a list or a range",
      "prefix": [
        "for"
      ],
      "body": [
        "for ${1:i} in ${2:1..=10} {",
        "\tprint(${1:i})",
        "}"
      ]
    },
    {
      "label": "List Comprehension",
      "description": "Conditional list comprehension on one line",
      "prefix": [
        "list_comp"
      ],
      "body": [
        "[${1:x * x} for ${2:x} in ${3:1..=10} if ${4:x % 2 == 0}]"
      ]
    },
    {
      "label": "Define Struct",
      "description": "Defines a new struct and a method",
      "prefix": [
        "struct"
      ],
      "body": [
        "struct ${1:Name} {",
        "\t${2:field}: String",
        "",
        "\tfunc ${3:method}() {",
        "\t\treturn self.${2:field}",
        "\t}",
        "}"
      ]
    },
    {
      "label": "Try - Catch (Error Handling)",
      "description": "Error catching block",
      "prefix": [
        "try"
      ],
      "body": [
        "try {",
        "\t${1}",
        "} catch err {",
        "\tprint(\"Caught error: {err}\")",
        "}"
      ]
    },
    {
      "label": "Tensor and Training Loop (Automatic Differentiation)",
      "description": "A small training loop (linear model) with tensors, the AdamW optimizer and backward",
      "prefix": [
        "tensor",
        "grad"
      ],
      "body": [
        "var X = tensor(${1:[[0.0], [1.0], [2.0], [3.0]]})",
        "var Y = tensor(${2:[[-1.0], [1.0], [3.0], [5.0]]})",
        "var w = tensor(no_grad(randn([${3:1, 1}], seed: 1) * 0.1), requires_grad: true)",
        "var b = tensor([0.0], requires_grad: true)",
        "var optimizer = AdamW([w, b], lr: ${4:0.1}, weight_decay: 0)",
        "for step in 0..${5:300} {",
        "\toptimizer.zero_grad()",
        "\tvar loss = mean((X @ w + b - Y) ** 2)",
        "\tbackward(loss)",
        "\toptimizer.step()",
        "\tif step % 100 == 0 { print(\"step {step}: loss = {loss.tolist}\") }",
        "}",
        "print(no_grad { return X @ w + b })$0"
      ]
    }
  ],
  "tr": [
    {
      "label": "Fonksiyon Tanımla",
      "description": "Yeni bir TR fonksiyonu tanımlar",
      "prefix": [
        "fonksiyon"
      ],
      "body": [
        "fonksiyon ${1:isim}(${2:parametre}) {",
        "\tsonuç ${3:${2:parametre}}",
        "}"
      ]
    },
    {
      "label": "Eğer - Değilse Koşulu",
      "description": "Eğer / değilse koşul bloğu",
      "prefix": [
        "eğer"
      ],
      "body": [
        "eğer ${1:koşul} {",
        "\t${2}",
        "} değilse {",
        "\t${3}",
        "}"
      ]
    },
    {
      "label": "Eşle (Pattern Matching)",
      "description": "Durum ve aralık eşleştirme bloğu",
      "prefix": [
        "eşle"
      ],
      "body": [
        "eşle ${1:değer} {",
        "\t${2:1} => ${3:\"bir\"}",
        "\t${4:2..10} => ${5:\"birkaç\"}",
        "\tvarsayılan => ${6:\"diğer\"}",
        "}"
      ]
    },
    {
      "label": "Filtrele (o-lambda)",
      "description": "Sondaki blokla filtreleme; o, o anki elemandır: liste.filtrele { o > 2 }",
      "prefix": [
        "filtrele",
        ".filtrele"
      ],
      "body": [
        ".filtrele { o > ${1:2} }"
      ]
    },
    {
      "label": "Haritala (o-lambda)",
      "description": "Sondaki blokla dönüştürme; o, o anki elemandır: liste.haritala { o * o }",
      "prefix": [
        "haritala",
        ".haritala"
      ],
      "body": [
        ".haritala { o * ${1:2} }"
      ]
    },
    {
      "label": "İndirge",
      "description": "Listeyi soldan sağa tek değere indirger: liste.indirge(0, (birikim, x) => birikim + x)",
      "prefix": [
        "indirge",
        ".indirge"
      ],
      "body": [
        ".indirge(${1:0}, (birikim, x) => ${2:birikim + x})"
      ]
    },
    {
      "label": "Döngü (İçinde)",
      "description": "Liste veya aralık üzerinde döngü",
      "prefix": [
        "döngü"
      ],
      "body": [
        "döngü ${1:i} içinde ${2:1..=10} {",
        "\tyazdır(${1:i})",
        "}"
      ]
    },
    {
      "label": "Liste Üreteci (List Comprehension)",
      "description": "Tek satırda koşullu liste üreteci",
      "prefix": [
        "liste_üret"
      ],
      "body": [
        "[${1:x * x} döngü ${2:x} içinde ${3:1..=10} eğer ${4:x % 2 == 0}]"
      ]
    },
    {
      "label": "Yapı Tanımla",
      "description": "Yeni bir yapı ve metot tanımlar",
      "prefix": [
        "yapı"
      ],
      "body": [
        "yapı ${1:İsim} {",
        "\t${2:alan}: Metin",
        "",
        "\tfonksiyon ${3:metod}() {",
        "\t\tsonuç kendi.${2:alan}",
        "\t}",
        "}"
      ]
    },
    {
      "label": "Dene - Yakala (Hata Yönetimi)",
      "description": "Hata yakalama bloğu",
      "prefix": [
        "dene"
      ],
      "body": [
        "dene {",
        "\t${1}",
        "} yakala hata {",
        "\tyazdır(\"Hata yakalandı: {hata}\")",
        "}"
      ]
    },
    {
      "label": "Tensör ve Eğitim Döngüsü (Otomatik Türev)",
      "description": "Tensörler, AdamW iyileştiricisi ve geri_yayılım ile küçük bir eğitim döngüsü (doğrusal model)",
      "prefix": [
        "tensör",
        "türev"
      ],
      "body": [
        "değişken X = tensör(${1:[[0.0], [1.0], [2.0], [3.0]]})",
        "değişken Y = tensör(${2:[[-1.0], [1.0], [3.0], [5.0]]})",
        "değişken w = tensör(türevsiz(rastgele_normal([${3:1, 1}], tohum: 1) * 0.1), türev_izle: doğru)",
        "değişken b = tensör([0.0], türev_izle: doğru)",
        "değişken iyileştirici = AdamW([w, b], öğrenme_oranı: ${4:0.1}, ağırlık_çürümesi: 0)",
        "döngü adım içinde 0..${5:300} {",
        "\tiyileştirici.sıfırla()",
        "\tdeğişken kayıp = ortalama((X @ w + b - Y) ** 2)",
        "\tgeri_yayılım(kayıp)",
        "\tiyileştirici.adım()",
        "\teğer adım % 100 == 0 { yazdır(\"adım {adım}: kayıp = {kayıp.değer}\") }",
        "}",
        "yazdır(türevsiz { sonuç X @ w + b })$0"
      ]
    }
  ]
}
