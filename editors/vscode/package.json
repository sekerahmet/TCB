{
  "name": "tr-dili-vscode",
  "displayName": "%eklenti.ad%",
  "description": "%eklenti.aciklama%",
  "version": "1.8.0",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tr",
    "onCommand:tr.calistir",
    "onCommand:tr.denetle",
    "onCommand:tr.hataAyikla",
    "onTaskType:tr",
    "onDebugResolve:tr",
    "onDebugInitialConfigurations",
    "onDebugDynamicConfigurations:tr",
    "onCommand:tr.hataAyiklaBaslat",
    "onCommand:tr.tabloGoster",
    "onCommand:tr.izlemeMasasi",
    "onDebug",
    "onFileSystem:tr-kodlu",
    "onFileSystem:tr-ham",
    "onCommand:tr.kodluHaliniGoster"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%guven.kisitliKip%",
      "restrictedConfigurations": [
        "tr.yorumlayiciYolu"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "tr",
        "aliases": [
          "TR Dili",
          "TR",
          "tr"
        ],
        "extensions": [
          ".tr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tr",
        "scopeName": "source.tr",
        "path": "./syntaxes/tr.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tr",
        "path": "./snippets/tr.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "tr.calistir",
        "title": "%komut.calistir%",
        "category": "TR",
        "icon": "$(play)"
      },
      {
        "command": "tr.hataAyiklaBaslat",
        "title": "%komut.hataAyiklaBaslat%",
        "category": "TR",
        "icon": "$(debug-alt)"
      },
      {
        "command": "tr.denetle",
        "title": "%komut.denetle%",
        "category": "TR",
        "icon": "$(check)"
      },
      {
        "command": "tr.hataAyikla",
        "title": "%komut.hataAyikla%",
        "category": "TR",
        "icon": "$(terminal)"
      },
      {
        "command": "tr.tabloGoster",
        "title": "%komut.tabloGoster%",
        "category": "TR",
        "icon": "$(table)"
      },
      {
        "command": "tr.izlemeMasasi",
        "title": "%komut.izlemeMasasi%",
        "category": "TR",
        "icon": "$(table)"
      },
      {
        "command": "tr.kodluHaliniGoster",
        "title": "%komut.kodluHaliniGoster%",
        "category": "TR",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tr.calistir",
          "when": "editorLangId == tr && !inDebugMode && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "tr.hataAyiklaBaslat",
          "when": "editorLangId == tr && !inDebugMode && isWorkspaceTrusted",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "tr.calistir",
          "when": "editorLangId == tr && isWorkspaceTrusted",
          "group": "1_tr@1"
        },
        {
          "command": "tr.hataAyiklaBaslat",
          "when": "editorLangId == tr && isWorkspaceTrusted",
          "group": "1_tr@1"
        },
        {
          "command": "tr.denetle",
          "when": "editorLangId == tr && isWorkspaceTrusted",
          "group": "1_tr@2"
        },
        {
          "command": "tr.hataAyikla",
          "when": "editorLangId == tr && isWorkspaceTrusted",
          "group": "1_tr@3"
        }
      ],
      "commandPalette": [
        {
          "command": "tr.calistir",
          "when": "editorLangId == tr && isWorkspaceTrusted"
        },
        {
          "command": "tr.denetle",
          "when": "editorLangId == tr && isWorkspaceTrusted"
        },
        {
          "command": "tr.hataAyikla",
          "when": "editorLangId == tr && isWorkspaceTrusted"
        },
        {
          "command": "tr.hataAyiklaBaslat",
          "when": "editorLangId == tr && isWorkspaceTrusted"
        },
        {
          "command": "tr.tabloGoster",
          "when": "debugType == 'tr' && inDebugMode"
        },
        {
          "command": "tr.izlemeMasasi",
          "when": "debugType == 'tr'"
        },
        {
          "command": "tr.kodluHaliniGoster",
          "when": "editorLangId == tr"
        }
      ],
      "debug/variables/context": [
        {
          "command": "tr.tabloGoster",
          "when": "debugType == 'tr'",
          "group": "navigation"
        }
      ],
      "debug/watch/context": [
        {
          "command": "tr.tabloGoster",
          "when": "debugType == 'tr'",
          "group": "navigation"
        }
      ],
      "debug/toolBar": [
        {
          "command": "tr.izlemeMasasi",
          "when": "debugType == 'tr'"
        }
      ]
    },
    "configuration": {
      "title": "%ayar.baslik%",
      "properties": {
        "tr.yorumlayiciYolu": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%ayar.yorumlayiciYolu%"
        },
        "tr.izlemeMasasi": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%ayar.izlemeMasasi%"
        },
        "tr.yazimDili": {
          "type": "string",
          "enum": [
            "tr",
            "en"
          ],
          "enumDescriptions": [
            "%ayar.yazimDili.tr%",
            "%ayar.yazimDili.en%"
          ],
          "default": "tr",
          "scope": "application",
          "markdownDescription": "%ayar.yazimDili%"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "tr",
        "required": [
          "komut"
        ],
        "properties": {
          "komut": {
            "type": "string",
            "enum": [
              "tr.calistir",
              "tr.denetle",
              "tr.hataAyikla"
            ],
            "description": "%gorev.komut%"
          },
          "dosya": {
            "type": "string",
            "description": "%gorev.dosya%"
          }
        }
      }
    ],
    "configurationDefaults": {
      "[tr]": {
        "files.encoding": "utf8",
        "editor.unicodeHighlight.nonBasicASCII": false,
        "editor.unicodeHighlight.ambiguousCharacters": true,
        "editor.unicodeHighlight.invisibleCharacters": true,
        "editor.unicodeHighlight.allowedCharacters": {
          "ç": true,
          "Ç": true,
          "ğ": true,
          "Ğ": true,
          "ı": true,
          "İ": true,
          "ö": true,
          "Ö": true,
          "ş": true,
          "Ş": true,
          "ü": true,
          "Ü": true
        }
      }
    },
    "debuggers": [
      {
        "type": "tr",
        "label": "%ayiklayici.etiket%",
        "languages": [
          "tr"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%ayiklayici.program%",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%ayiklayici.args%",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "%ayiklayici.stopOnEntry%",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "%ayiklayici.cwd%",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tr",
            "request": "launch",
            "name": "TR: Hata Ayıkla",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "%ayiklayici.parcacik.etiket%",
            "description": "%ayiklayici.parcacik.aciklama%",
            "body": {
              "type": "tr",
              "request": "launch",
              "name": "TR: Hata Ayıkla",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "tr"
      }
    ]
  }
}
