{
  "name": "tr-dili-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.9.0",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:tr",
    "onCommand:tr.run",
    "onCommand:tr.check",
    "onCommand:tr.debug",
    "onTaskType:tr",
    "onDebugResolve:tr",
    "onDebugInitialConfigurations",
    "onDebugDynamicConfigurations:tr",
    "onCommand:tr.debugStart",
    "onCommand:tr.showTable",
    "onCommand:tr.watchPanel",
    "onDebug",
    "onCommand:tr.showView"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrusted.limited%",
      "restrictedConfigurations": [
        "tr.interpreterPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "tr",
        "aliases": [
          "TR Dili",
          "TR",
          "tr"
        ],
        "extensions": [
          ".tr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tr",
        "scopeName": "source.tr",
        "path": "./syntaxes/tr.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tr.run",
        "title": "%command.run%",
        "category": "TR",
        "icon": "$(play)"
      },
      {
        "command": "tr.debugStart",
        "title": "%command.debugStart%",
        "category": "TR",
        "icon": "$(debug-alt)"
      },
      {
        "command": "tr.check",
        "title": "%command.check%",
        "category": "TR",
        "icon": "$(check)"
      },
      {
        "command": "tr.debug",
        "title": "%command.debug%",
        "category": "TR",
        "icon": "$(terminal)"
      },
      {
        "command": "tr.showTable",
        "title": "%command.showTable%",
        "category": "TR",
        "icon": "$(table)"
      },
      {
        "command": "tr.watchPanel",
        "title": "%command.watchPanel%",
        "category": "TR",
        "icon": "$(table)"
      },
      {
        "command": "tr.showView",
        "title": "%command.showView%",
        "category": "TR",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tr.run",
          "when": "editorLangId == tr && !inDebugMode && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "tr.debugStart",
          "when": "editorLangId == tr && !inDebugMode && isWorkspaceTrusted",
          "group": "navigation@2"
        },
        {
          "command": "tr.showView",
          "when": "editorLangId == tr && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "tr.run",
          "when": "editorLangId == tr && isWorkspaceTrusted",
          "group": "1_tr@1"
        },
        {
          "command": "tr.debugStart",
          "when": "editorLangId == tr && isWorkspaceTrusted",
          "group": "1_tr@1"
        },
        {
          "command": "tr.check",
          "when": "editorLangId == tr && isWorkspaceTrusted",
          "group": "1_tr@2"
        },
        {
          "command": "tr.debug",
          "when": "editorLangId == tr && isWorkspaceTrusted",
          "group": "1_tr@3"
        }
      ],
      "commandPalette": [
        {
          "command": "tr.run",
          "when": "editorLangId == tr && isWorkspaceTrusted"
        },
        {
          "command": "tr.check",
          "when": "editorLangId == tr && isWorkspaceTrusted"
        },
        {
          "command": "tr.debug",
          "when": "editorLangId == tr && isWorkspaceTrusted"
        },
        {
          "command": "tr.debugStart",
          "when": "editorLangId == tr && isWorkspaceTrusted"
        },
        {
          "command": "tr.showTable",
          "when": "debugType == 'tr' && inDebugMode"
        },
        {
          "command": "tr.watchPanel",
          "when": "debugType == 'tr'"
        },
        {
          "command": "tr.showView",
          "when": "editorLangId == tr && isWorkspaceTrusted"
        }
      ],
      "debug/variables/context": [
        {
          "command": "tr.showTable",
          "when": "debugType == 'tr'",
          "group": "navigation"
        }
      ],
      "debug/watch/context": [
        {
          "command": "tr.showTable",
          "when": "debugType == 'tr'",
          "group": "navigation"
        }
      ],
      "debug/toolBar": [
        {
          "command": "tr.watchPanel",
          "when": "debugType == 'tr'"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "tr.interpreterPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.interpreterPath%"
        },
        "tr.autoOpenWatchPanel": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%config.autoOpenWatchPanel%"
        },
        "tr.writingLanguage": {
          "type": "string",
          "enum": [
            "tr",
            "en"
          ],
          "enumDescriptions": [
            "%config.writingLanguage.tr%",
            "%config.writingLanguage.en%"
          ],
          "default": "tr",
          "scope": "application",
          "markdownDescription": "%config.writingLanguage%"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "tr",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "tr.run",
              "tr.check",
              "tr.debug"
            ],
            "description": "%task.command%"
          },
          "file": {
            "type": "string",
            "description": "%task.file%"
          }
        }
      }
    ],
    "configurationDefaults": {
      "[tr]": {
        "files.encoding": "utf8",
        "editor.unicodeHighlight.nonBasicASCII": false,
        "editor.unicodeHighlight.ambiguousCharacters": true,
        "editor.unicodeHighlight.invisibleCharacters": true,
        "editor.unicodeHighlight.allowedCharacters": {
          "ç": true,
          "Ç": true,
          "ğ": true,
          "Ğ": true,
          "ı": true,
          "İ": true,
          "ö": true,
          "Ö": true,
          "ş": true,
          "Ş": true,
          "ü": true,
          "Ü": true
        }
      }
    },
    "debuggers": [
      {
        "type": "tr",
        "label": "%debugger.label%",
        "languages": [
          "tr"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%debugger.program%",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%debugger.args%",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "%debugger.stopOnEntry%",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "%debugger.cwd%",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tr",
            "request": "launch",
            "name": "TR: Debug",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debugger.snippet.label%",
            "description": "%debugger.snippet.description%",
            "body": {
              "type": "tr",
              "request": "launch",
              "name": "TR: Debug",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "tr"
      }
    ]
  }
}
