// 09 — Web ve veritabanı: bir modeli ya da veriyi uygulamaya dönüştürmek.
// Öğrettikleri:
//   1. Yerleşik Türkçe SQL veritabanı (.trdb) ve listeleri tablo gibi sorgulama
//   2. Web sunucusu ve REST API (al/gönder işleyicileri, web_al/web_gönder ile deneme)
//   3. Görsel arayüz (kart, tablo, grafik, form) ve HTML rapor
// Sunucular yalnızca bu bilgisayardan (127.0.0.1) erişilebilir; örnek dış ağa çıkmaz,
// sunucuları kendisi açıp kapatır. Ayrıntılar: KULLANIM_KILAVUZU.md §6.
// Çalıştırma (proje kökünden): tr ornekler/09_web_veritabani.tr
// Ürettiği dosyalar (her çalıştırmada yeniden yazılır, depoya girmez):
//   ornekler/sirket_erp.trdb, ornekler/kurumsal_panel.html

yazdır("=== Veritabanı + web sunucusu + görsel arayüz ===")

// -------------------------------------------------------------------------
// BÖLÜM 1: YERLEŞİK KALICI TÜRKÇE SQL VERİTABANI VE LİSTE SORGULAMA
// -------------------------------------------------------------------------
yazdır("\n[1] Yerleşik Türkçe SQL Veritabanı ('sirket_erp.trdb') Başlatılıyor...")

değişken vt = veritabanı_aç("ornekler/sirket_erp.trdb")
vt.sil("personel") // Temiz başlangıç için önceki kayıtları temizle

vt.ekle("personel", [
    {"id": 101, "ad": "Ayşe Yılmaz", "departman": "Yapay Zeka", "maas": 92000.0, "sehir": "İstanbul"},
    {"id": 102, "ad": "Mehmet Demir", "departman": "Yazılım", "maas": 88000.0, "sehir": "Ankara"},
    {"id": 103, "ad": "Zeynep Kaya", "departman": "Veri Bilimi", "maas": 76000.0, "sehir": "İzmir"},
    {"id": 104, "ad": "Caner Öztürk", "departman": "Bulut Sistem", "maas": 54000.0, "sehir": "Bursa"},
    {"id": 105, "ad": "Elif Çelik", "departman": "Yapay Zeka", "maas": 98000.0, "sehir": "İstanbul"}
])

yazdır("  • Toplam Kayıt Sayısı : {vt.say('personel')}")

// Türkçe SQL Sorgusu (SEÇ ... TABLO ... NEREDE ... SIRALA ... AZALAN)
değişken yuksek_maaslilar = vt.sorgula("SEÇ ad, departman, maas TABLO personel NEREDE maas >= 80000 SIRALA maas AZALAN")
yazdır("  • Türkçe SQL (Maaş >= 80.000 TL, Azalan Sıralı):")
döngü p içinde yuksek_maaslilar {
    yazdır("    -> {p['ad']} | {p['departman']} | {p['maas']} TL")
}

// Canlı Güncelleme (UPDATE)
vt.güncelle("personel", {"maas": 95000.0}, "id == 102")
değişken yazilim_uzmani = vt.sorgula("SEÇ ad, maas TABLO personel NEREDE id = 102")
yazdır("  • Güncelleme Sonrası #102 Maaşı: {yazilim_uzmani[0]['ad']} -> {yazilim_uzmani[0]['maas']} TL")

// Bellekteki listeyi tablo gibi sorgulama (tablo_sorgula)
değişken tum_liste = vt.tablo_al("personel")
değişken istanbul_ekibi = tablo_sorgula(tum_liste, "sehir == 'İstanbul'", sırala: "maas:azalan", alanlar: ["ad", "departman", "maas"])
yazdır("  • Liste Sorgusu (İstanbul Ekibi): {istanbul_ekibi}")

// -------------------------------------------------------------------------
// BÖLÜM 2: WEB SUNUCU VE REST API MOTORU
// -------------------------------------------------------------------------
yazdır("\n[2] Web Sunucu & REST API Motoru Başlatılıyor...")

değişken api = web_sunucu(port: 18088)

// GET /api/personel -> Veritabanından canlı sorgulayıp otomatik JSON döndürür
api.al("/api/personel", fonksiyon(istek) {
    değişken filtre_dep = istek["parametreler"]["departman"]
    eğer filtre_dep != yok {
        // Dışarıdan gelen değeri sorguya metin olarak gömmeyin; '?' parametresi ile bağlayın (SQL enjeksiyonuna karşı)
        sonuç vt.sorgula("SEÇ id, ad, departman, maas TABLO personel NEREDE departman == ? SIRALA maas AZALAN", [filtre_dep])
    }
    sonuç vt.sorgula("SEÇ id, ad, departman, maas TABLO personel SIRALA maas AZALAN")
})

// POST /api/ekle -> JSON gövdesini alıp veritabanına kaydeder
api.gönder("/api/ekle", fonksiyon(istek) {
    değişken yeni_kisi = istek["veri"]
    değişken toplam = vt.ekle("personel", yeni_kisi)
    sonuç {"durum": "başarılı", "mesaj": "{yeni_kisi['ad']} eklendi", "toplam_personel": toplam}
})

değişken sunucu_adresi = api.arka_planda_başlat()
ertele {
    api.durdur()
    yazdır("  🔒 [ertele] Web API sunucusu güvenli şekilde kapatıldı.")
}
yazdır("  • Web API Canlı Adres : {sunucu_adresi}")

// Kendi başlattığımız Web Sunucusunu web_al ve web_gönder ile canlı test edelim!
değişken yz_ekibi_yanit = web_al("{sunucu_adresi}/api/personel?departman=Yapay%20Zeka")
yazdır("  • GET /api/personel?departman=Yapay Zeka Yanıtı: {yz_ekibi_yanit}")

değişken post_yanit = web_gönder("{sunucu_adresi}/api/ekle", {
    "id": 106,
    "ad": "Burak Aydın",
    "departman": "Siber Güvenlik",
    "maas": 84000.0,
    "sehir": "Ankara"
})
yazdır("  • POST /api/ekle Yanıtı: {post_yanit}")

// -------------------------------------------------------------------------
// BÖLÜM 3: GÖRSEL ARAYÜZ MOTORU (Kart, Tablo, Grafik & Form)
// -------------------------------------------------------------------------
yazdır("\n[3] Görsel Arayüz (GUI) Oluşturuluyor...")

değişken guncel_personel = vt.sorgula("SEÇ id, ad, departman, sehir, maas TABLO personel SIRALA maas AZALAN")
değişken maas_listesi = [p["maas"] döngü p içinde guncel_personel]
değişken isim_listesi = [p["ad"] döngü p içinde guncel_personel]

değişken ekran = arayüz_oluştur("TR Kurumsal ERP & İnsan Kaynakları Kokpiti", genişlik: 1100, yükseklik: 780)

// 1. KPI Metrik Kartları
ekran.kart_ekle("Toplam Personel", "{guncel_personel.uzunluk} Kişi", "Aktif Çalışan", "mavi")
ekran.kart_ekle("Ortalama Maaş", "{yuvarla(ortalama(maas_listesi), 0)} TL", "Aylık Net", "yeşil")
ekran.kart_ekle("En Yüksek Maaş", "{maks(maas_listesi)} TL", "Kıdemli Uzman", "mor")
ekran.kart_ekle("Veritabanı Durumu", "ÇEVRİMİÇİ", "sirket_erp.trdb", "sarı")

// 2. Etkileşimli Canlı Grafik
ekran.grafik_ekle("Personel Maaş Dağılım Grafiği (TL)", isim_listesi, maas_listesi, "çubuk")

// 3. Etkileşimli Tablo (Canlı Arama Filtreli)
ekran.tablo_ekle("Personel Tablosu (Canlı Filtreleme Destekli)", guncel_personel)

// 4. Etkileşimli Seçim Ekranı / Form (TR fonksiyonunu canlı tetikler!)
ekran.form_ekle("Hızlı Maaş Simülasyonu & Zam Hesaplayıcı", ["Personel_Adı", "Zam_Yüzdesi"], fonksiyon(form) {
    sonuç "{form['Personel_Adı']} için %{form['Zam_Yüzdesi']} zam simülasyonu başarıyla uygulandı!"
})

// Arayüzü bağımsız etkileşimli HTML raporu olarak kaydet
ekran.html_kaydet("ornekler/kurumsal_panel.html")
yazdır("  • Görsel Arayüz HTML Olarak Kaydedildi : ornekler/kurumsal_panel.html")

// Ayrıca Görsel Arayüz sunucusunu arka planda başlatıp doğrula
değişken gui_adres = ekran.arka_planda_başlat(port: 18095, pencere_aç: yanlış)
ertele {
    ekran.durdur()
}
değişken gui_html = web_al(gui_adres)
yazdır("  • Canlı GUI Sunucusu ({gui_adres}) Yanıt Boyutu: {gui_html.uzunluk} karakter")
yazdır("\nTamamlandı: veritabanı, web API ve arayüz çalıştı.")
