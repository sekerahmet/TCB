// =========================================================================
// 🇹🇷 TR (.tr) Programlama ve Yapay Zeka Dili — Faz 2 Yapay Zeka Testi
// ("İkisi Bir Arada": Hem Düşük Seviye Tensör/Autograd Hem Hazır Sinir Ağı)
// =========================================================================

yazdır("=== 1. DÜŞÜK SEVİYE: Çok Çekirdekli Matris (@) ve Aktivasyonlar ===")
değişken Girdi = matris([[1.0, 2.0], [3.0, 4.0]])
değişken Ağırlık = matris([[0.5, -0.5], [1.0, 2.0]])
değişken KatmanÇıktısı = relu(Girdi @ Ağırlık)
yazdır("ReLU(Girdi @ Ağırlık):\n{KatmanÇıktısı}")
yazdır("Softmax([2.0, 1.0, 0.1]): {[yuvarla(p, 4) döngü p içinde softmax([2.0, 1.0, 0.1])]}")

yazdır("\n=== 2. DÜŞÜK SEVİYE: Otomatik Türev (Autograd / geri_yayılım) ===")
// y = x^2 + 2x + 1 fonksiyonunun x = 3 noktasındaki türevi (dy/dx = 2x + 2 = 8)
değişken x = tensör(3.0, türev_izle: doğru)
değişken y = x * x + 2 * x + 1
geri_yayılım(y)
yazdır("İfade: y = x*x + 2*x + 1  (x = {x.değer})")
yazdır("Hesaplanan y değeri : {y.değer}")
yazdır("Otomatik türev dy/dx: {x.gradyan.değer} (Beklenen: 8.0)")

yazdır("\n=== 3. YÜKSEK SEVİYE: 3 Satırda Yapay Sinir Ağı Eğitimi (XOR Problemi) ===")
değişken X_veri = [[0, 0], [0, 1], [1, 0], [1, 1]]
değişken Y_hedef = [[0], [1], [1], [0]]

değişken model = sinir_ağı([2, 8, 1], aktivasyon: "tanh", tohum: 42)
değişken özet = model.eğit(X_veri, Y_hedef, devir: 800, öğrenme_hızı: 0.15)
yazdır("Eğitim Özeti: {özet}")

değişken tahminler = model.tahmin_et(X_veri)
yazdır("XOR Sinir Ağı Tahminleri (Beklenen: 0, 1, 1, 0):\n{tahminler}")

yazdır("\n=== 4. VERİ BİLİMİ, İSTATİSTİK VE VEKTÖR BENZERLİĞİ ===")
değişken veriler = [10, 20, 30, 40, 50]
yazdır("Veriler        : {veriler}")
yazdır("Ortalama       : {ortalama(veriler)}")
yazdır("Standart Sapma : {yuvarla(standart_sapma(veriler), 4)}")
yazdır("Normalize (0-1): {normalize_et(veriler)}")

değişken vektör_a = [1.0, 2.0, 3.0]
değişken vektör_b = [2.0, 4.0, 6.0]
yazdır("Kosinüs Benzerliği (A, B): {yuvarla(kosinüs_benzerliği(vektör_a, vektör_b), 4)}")

yazdır("\n=== 5. JSON İLE VERİ ALIŞVERİŞİ ===")
değişken istatistik = {"ortalama": ortalama(veriler), "standart_sapma": yuvarla(standart_sapma(veriler), 4)}
değişken json_metni = json_metin(istatistik)
yazdır("JSON metni    : {json_metni}")
yazdır("Geri çözülen  : {json_çöz(json_metni)}")
