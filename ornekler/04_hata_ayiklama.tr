// 04 — Hata ayıklama: koddaki kesme noktasıyla bir hesap hatasını çalışırken bulup düzeltmek.
// ETKİLEŞİMLİDİR: `kesme_noktası eğer ...` satırında program durur ve hata ayıklayıcı
// komut bekler (değişkenleri gösterir; standart giriş boşsa ya da kapalıysa devam eder).
// Öğrettikleri: koşullu kesme noktası, değişkenleri ve tensörleri incelemek, değeri
// çalışırken değiştirmek. Hata ayıklayıcı komutları: KULLANIM_KILAVUZU.md §5.
// Çalıştırma (proje kökünden): tr ornekler/04_hata_ayiklama.tr   (VS Code'da F5)
// Program durduğunda deneyin:
//   tablo siparisler            → sipariş listesini tablo olarak gösterir
//   değiştir vergi_orani = 0.20 → hatalı oranı çalışırken düzeltir
//   devam                       → programı sürdürür (sonuç 102600.0 TL olur)

yazdır("=== Sipariş ve vergi hesabı ===")

değişken siparisler = [
    {"belge_no": "100001", "musteri": "Anadolu Teknoloji", "tutar": 15000.0, "durum": "AÇIK"},
    {"belge_no": "100002", "musteri": "Karadeniz Lojistik", "tutar": 28500.0, "durum": "ONAYLI"},
    {"belge_no": "100003", "musteri": "Ege Enerji A.Ş.", "tutar": 42000.0, "durum": "BEKLEMEDE"}
]

// Tensörler de hata ayıklayıcıda tablo olarak açılır
değişken risk_matrisi = tensör([
    [0.12, 0.85, 0.03],
    [0.45, 0.40, 0.15]
])

fonksiyon net_tutar_hesapla(brut_toplam: Ondalık) -> Ondalık {
    // HATA: vergi oranı %20 yerine yanlışlıkla %80 girilmiş.
    değişken vergi_orani = 0.80

    // Koşullu kesme noktası: yalnızca büyük tutarlarda durur
    kesme_noktası eğer brut_toplam > 50000

    değişken vergi = brut_toplam * vergi_orani
    sonuç brut_toplam + vergi
}

değişken ara_toplam = 0.0
döngü s içinde siparisler {
    ara_toplam += s["tutar"]
}

yazdır("Sipariş ara toplamı : {ara_toplam} TL")
yazdır("Vergi dahil ödenecek: {net_tutar_hesapla(ara_toplam)} TL")
