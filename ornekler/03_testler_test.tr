// 03 — Testler: kodun yanına test yazmak.
// Öğrettikleri: `test "ad" { ... }` blokları, doğrula(koşul, [mesaj]) ve
// eşit_mi(beklenen, gerçek) ile denetim, hatanın fırlatıldığını sınamak (dene/yakala).
// Dosya adı *_test.tr ile biter: `tr test` bir klasörde yalnızca bu adlı dosyaları bulur.
// Çalıştırma (proje kökünden):
//   tr test ornekler/03_testler_test.tr   → testleri çalıştırır, özet yazar
//   tr ornekler/03_testler_test.tr        → dosyayı normal çalıştırır; test blokları atlanır
// Bir test kalırsa `tr test` 1 ile çıkar; CI'da kapı olarak kullanılabilir.

// --- Sınanacak kod ---
fonksiyon topla(a, b) {
    sonuç a + b
}

fonksiyon ortalama_al(liste) {
    eğer liste.uzunluk == 0 { fırlat "boş listenin ortalaması alınamaz" }
    sonuç liste.toplam() / liste.uzunluk
}

yapı Sepet {
    ürünler = []

    fonksiyon ekle(ad, fiyat) {
        kendi.ürünler.ekle({"ad": ad, "fiyat": fiyat})
    }

    fonksiyon tutar() {
        sonuç kendi.ürünler.haritala { o["fiyat"] }.toplam()
    }
}

// Bu satır her iki kipte de çalışır: testlerden önce dosyanın kendisi çalışır.
yazdır("Test blokları yalnızca şu komutla çalışır: tr test ornekler/03_testler_test.tr")

// --- Testler ---
test "toplama" {
    eşit_mi(4, topla(2, 2))
    eşit_mi(0, topla(-1, 1))
}

test "ortalama" {
    eşit_mi(2.5, ortalama_al([1, 2, 3, 4]))
    doğrula(ortalama_al([10]) == 10, "tek elemanın ortalaması kendisidir")
}

test "boş listede hata fırlatılır" {
    değişken mesaj = ""
    dene { ortalama_al([]) } yakala h { mesaj = h }
    doğrula(mesaj.içerir("boş liste"), "beklenen hata gelmedi: {mesaj}")
}

test "sepet tutarı" {
    değişken s = Sepet() // her test yeni bir kapsamda çalışır
    s.ekle("kalem", 15)
    s.ekle("defter", 40)
    eşit_mi(2, s.ürünler.uzunluk)
    eşit_mi(55, s.tutar())
}
