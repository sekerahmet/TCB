// 01 — Merhaba: ilk TR programı.
// Öğrettikleri: değişken tanımlamak, yazdır ile metne değer yerleştirmek ({ad}),
// listeler, sondaki blok ile filtreleme/dönüştürme (o = sıradaki eleman) ve fonksiyon.
// Çalıştırma (proje kökünden): tr ornekler/01_merhaba.tr
// Kendi denemeleriniz için calisma/merhaba.tr dosyasını değiştirebilirsiniz.

değişken ad = "dünya"
yazdır("Merhaba, {ad}!")

değişken sayılar = [1, 2, 3, 4, 5, 6]
yazdır("Çift sayılar: {sayılar.filtrele { o % 2 == 0 }}")
yazdır("Kareleri: {sayılar.haritala { o * o }}")

fonksiyon selamla(isim) {
    sonuç "Hoş geldin, {isim}"
}
yazdır(selamla("TR dili"))
